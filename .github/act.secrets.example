# Copy this file to .github/act.secrets and fill in values
# Usage: act --secret-file .github/act.secrets

# Poe API key (used by agent workflows and PR checks)
POE_API_KEY=
POE_API_TOKEN=

# GitHub App credentials (used by release and agent workflows)
POE_CODE_AGENT_APP_ID=
POE_CODE_AGENT_PRIVATE_KEY=
