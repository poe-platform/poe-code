const trace = [];
async function* values() {
  trace.push('start');
  yield 1;
}
const ticks = Promise.resolve()
  .then(() => trace.push('tick 1'))
  .then(() => trace.push('tick 2'));
const iterator = values();
const first = iterator.next();
const last = iterator.return({ get then() { trace.push('get then'); } });
await ticks;
await first;
await last;
const promise = Promise.resolve();
promise.then = (fulfilled, rejected) => [fulfilled.length, rejected.length];
const handlerLengths = promise.finally(() => {});
return { trace, handlerLengths };
