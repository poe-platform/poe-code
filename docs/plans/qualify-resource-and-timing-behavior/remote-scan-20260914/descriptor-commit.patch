--- /dev/null
+++ b/packages/safe-js/src/interp/measure-symbol-mutation.test.ts
@@ -0,0 +1,76 @@
+import { expect, it } from "vitest";
+import { Budget } from "./budget.js";
+import { createSandboxClosure, measureSandboxData, reconcileCompiledValues } from "./values.js";
+
+it("omits a symbol removed by its descriptor trap without executing getters", () => {
+  const removed = Symbol("removed");
+  const kept = Symbol("kept");
+  let getterCalls = 0;
+  const target = { [removed]: "gone", [kept]: "abc" };
+  Object.defineProperty(target, "getter", { enumerable: true, get() { getterCalls++; } });
+  const value = new Proxy(target, {
+    getOwnPropertyDescriptor(owner, key) {
+      if (key === removed) Reflect.deleteProperty(owner, key);
+      return Reflect.getOwnPropertyDescriptor(owner, key);
+    }
+  });
+  // Object + getter key + kept property + kept symbol + payload.
+  expect(measureSandboxData([value])).toBe(17);
+  expect(getterCalls).toBe(0);
+});
+
+it("captures surviving symbol data before retained callbacks mutate it", () => {
+  const first = Symbol("first");
+  const later = Symbol("later");
+  const target: Record<symbol, unknown> = {};
+  target[first] = createSandboxClosure({ call: () => undefined, retainedValues: () => {
+    target[later] = "changed payload";
+    return [];
+  } });
+  target[later] = "old";
+  // Object + two property slots + two six-unit symbols + closure + old string.
+  expect(measureSandboxData([target])).toBe(19);
+  expect(target[later]).toBe("changed payload");
+  expect(measureSandboxData([target])).toBe(31);
+});
+
+it("preserves descriptor errors and leaves failed reconciliation accounting unchanged", () => {
+  const key = Symbol("key");
+  const failure = new Error("descriptor failure");
+  const value = new Proxy({ [key]: "payload" }, {
+    getOwnPropertyDescriptor() { throw failure; }
+  });
+  const budget = new Budget({ dataSize: 100 });
+  budget.reconcileDataUsage(7);
+  expect(() => reconcileCompiledValues(budget, [value])).toThrow(failure);
+  expect(budget.currentDataSize).toBe(7);
+  expect(budget.peakDataSize).toBe(7);
+});
+
+it("still charges surviving payloads and rolls back an over-limit charge", () => {
+  const removed = Symbol("removed");
+  const kept = Symbol("kept");
+  const value = new Proxy({ [removed]: "gone", [kept]: "abc" }, {
+    getOwnPropertyDescriptor(owner, key) {
+      if (key === removed) Reflect.deleteProperty(owner, key);
+      return Reflect.getOwnPropertyDescriptor(owner, key);
+    }
+  });
+  const budget = new Budget({ dataSize: 9 });
+  budget.reconcileDataUsage(2);
+  expect(() => reconcileCompiledValues(budget, [value])).toThrow(
+    expect.objectContaining({ code: "budgetExceeded", budget: "dataSize", current: 10, limit: 9 })
+  );
+  expect(budget.currentDataSize).toBe(2);
+  expect(budget.peakDataSize).toBe(2);
+  const neighbor = new Budget({ dataSize: 10 });
+  reconcileCompiledValues(neighbor, [value, value]);
+  expect(neighbor.currentDataSize).toBe(10);
+});
+
+it("does not suppress native proxy invariants for a nonconfigurable symbol", () => {
+  const key = Symbol("fixed");
+  const target = Object.defineProperty({}, key, { value: "charged", configurable: false });
+  const value = new Proxy(target, { getOwnPropertyDescriptor() { return undefined; } });
+  expect(() => measureSandboxData([value])).toThrow(TypeError);
+});
