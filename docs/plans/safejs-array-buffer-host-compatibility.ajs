import { S } from "schema";

export const schema = S.Object({ title: S.String() });

export default async (frontmatter) => {
  class Storage extends ArrayBuffer {}
  const buffer = new Storage(8);
  const values = new Float32Array(buffer);
  values.set([1, 2]);
  await 0;
  const result = buffer.slice(4);
  if (!(result instanceof Storage) || new Float32Array(result)[0] !== 2) {
    throw new Error("Fixed buffer compatibility regression");
  }
  new Float32Array(result)[0] = 7;
  if (values[1] !== 2) throw new Error("Copied buffer alias regression");
  return { title: frontmatter.title, ok: true, values: Array.from(values) };
};
