import { S } from "schema";

export const schema = S.Object({ title: S.String() });

export default async (frontmatter) => {
  class Storage extends ArrayBuffer {}
  const buffer = new Storage(12, { maxByteLength: 16 });
  const values = new Float32Array(buffer);
  values.set([1, 2, 3]);
  const result = buffer.slice(4);
  new Float32Array(result)[0] = 7;
  if (!(result instanceof Storage) || result.resizable || values[1] !== 2) {
    throw new Error("Slice identity or copy isolation regression");
  }
  await 0;
  const resized = buffer.slice({ valueOf() { buffer.resize(4); return 0; } });
  const copied = Array.from(new Float32Array(resized));
  if (resized.byteLength !== 12 || copied.join() !== "1,0,0") {
    throw new Error("Slice resize regression");
  }
  return { title: frontmatter.title, ok: true, copied, independent: Array.from(new Float32Array(result)) };
};
