import { S } from "schema";
export const schema = S.Object({ title: S.String() });

export default async (frontmatter) => {
  await 0;
  const source = new ArrayBuffer(4, { maxByteLength: 8 });
  const view = new Float32Array(source);
  view[0] = 7;
  const result = source.transferToFixedLength(12);
  if (!source.detached || view.length !== 0) throw new Error("Source was not detached");
  if (result.resizable || result.maxByteLength !== 12 || result.byteLength !== 12) throw new Error("Fixed output retained source capacity");
  const copied = Array.from(new Float32Array(result));
  if (copied.join() !== "7,0,0") throw new Error("Copy or zero filling failed");
  class Buffer extends ArrayBuffer {
    static get [Symbol.species]() { throw new Error("Unexpected species lookup"); }
  }
  const plain = new Buffer(0).transferToFixedLength();
  if (plain instanceof Buffer || plain.resizable || plain.detached) throw new Error("Wrong intrinsic result");
  return { title: frontmatter.title, ok: true, copied, fixed: !result.resizable, detachedSource: source.detached };
};
