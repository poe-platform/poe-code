import { S } from "schema";
export const schema = S.Object({ title: S.String() });

export default async (frontmatter) => {
  await 0;
  const source = new ArrayBuffer(8);
  const view = new Float32Array(source);
  view.set([1, 2]);
  const result = source.transfer({ valueOf() { return 12; } });
  if (!source.detached || source.byteLength !== 0 || view.length !== 0) throw new Error("Source and views were not detached");
  const copied = Array.from(new Float32Array(result));
  if (copied.join() !== "1,2,0" || result.resizable) throw new Error("Transfer content or kind mismatch");
  class Buffer extends ArrayBuffer {
    static get [Symbol.species]() { throw new Error("Unexpected species lookup"); }
  }
  const derived = new Buffer(0);
  const plain = derived.transfer();
  if (plain instanceof Buffer || !derived.detached || plain.detached) throw new Error("Intrinsic result mismatch");
  return { title: frontmatter.title, ok: true, copied, detachedSource: source.detached, detachedViews: view.length === 0 };
};
