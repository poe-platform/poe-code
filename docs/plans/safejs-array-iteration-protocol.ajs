import { S } from "schema";

export const schema = S.Object({ title: S.String() });

export default async frontmatter => {
  const source = [1, 2];
  source[Symbol.iterator] = function* () { yield 7; yield 8; };
  const seen = [];
  for (const value of source) seen.push(value);
  if (seen.join() !== "7,8") throw new Error("Array iterator was bypassed");
  return { title: frontmatter.title, ok: true, seen };
};
