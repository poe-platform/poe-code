import { S } from "schema";
export const schema = S.Object({ title: S.String() });

export default async (frontmatter) => {
  const signed = new BigInt64Array([-1n, 2n ** 63n, 7n]);
  const unsigned = new BigUint64Array(signed.buffer);
  if (unsigned[0] !== 2n ** 64n - 1n || signed[1] !== -(2n ** 63n))
    throw new Error("BigInt wrapping failed");
  const mapped = signed.map(value => value + 1n);
  if (mapped[0] !== 0n || mapped[2] !== 8n) throw new Error("BigInt map failed");
  const copy = structuredClone({ signed, unsigned });
  await 0;
  if (!(copy.signed instanceof BigInt64Array) || !(copy.unsigned instanceof BigUint64Array) || copy.signed.buffer !== copy.unsigned.buffer)
    throw new Error("BigInt clone identity failed");
  let rejected = false;
  try { signed.fill(1); } catch (error) { rejected = error.name === "TypeError"; }
  if (!rejected) throw new Error("Number element unexpectedly accepted");
  return { title: frontmatter.title, ok: true, values: Array.from(mapped, String) };
};
