import { S } from "schema";

export const schema = S.Object({ title: S.String() });

export default async (frontmatter) => {
  class Samples extends Float32Array {}
  const trace = [];
  const values = new Samples({
    get length() { trace.push("length"); return 2; },
    get 0() { trace.push("0"); return { valueOf() { return 2.5; } }; },
    get 1() { trace.push("1"); return 4; }
  });
  const input = [2, 4];
  input[Symbol.iterator] = function* () { yield 7; };
  const overridden = new Float32Array(input);
  await 0;
  if (!(values instanceof Samples) || values.join(",") !== "2.5,4" ||
      trace.join(",") !== "length,0,1" || overridden.join(",") !== "7") {
    throw new Error("Float32Array constructor input regression");
  }
  return { title: frontmatter.title, ok: true, values: Array.from(values), trace };
};
