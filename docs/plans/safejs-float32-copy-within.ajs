import { S } from "schema";

export const schema = S.Object({ title: S.String() });

export default async (frontmatter) => {
  const buffer = new ArrayBuffer(16, { maxByteLength: 24 });
  const values = new Float32Array(buffer);
  values.set([1, 2, 3, 4]);
  if (values.copyWithin(1, 0, 3) !== values || values.join() !== "1,1,2,3") {
    throw new Error("Overlapping copy regression");
  }
  await 0;
  values.set([1, 2, 3, 4]);
  values.copyWithin({ valueOf() { buffer.resize(12); return 1; } }, 0, 3);
  if (values.join() !== "1,1,2") throw new Error("Resize-aware copy regression");
  return { title: frontmatter.title, ok: true, values: Array.from(values) };
};
