import { S } from "schema";

export const schema = S.Object({ title: S.String() });

export default async (frontmatter) => {
  const buffer = new ArrayBuffer(12, { maxByteLength: 16 });
  const values = new Float32Array(buffer);
  values.set([1, 2, 3]);
  await 0;
  const seen = [];
  const result = values.every((item, index) => {
    seen.push(item);
    if (index === 0) buffer.resize(0);
    return item !== undefined;
  });
  if (result !== false || seen.length !== 2 || seen[0] !== 1 || seen[1] !== undefined) {
    throw new Error("Short-circuit predicate regression");
  }
  return { title: frontmatter.title, ok: true };
};
