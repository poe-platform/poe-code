import { S } from "schema";
export const schema = S.Object({ title: S.String() });
export default async (frontmatter) => {
  const values = new Float32Array([1, 2, 3]);
  await 0;
  const result = values.filter((item, index) => {
    values[index] = 7;
    return item > 1;
  });
  if (result.join() !== "2,3" || values.join() !== "7,7,7" || result === values) {
    throw new Error("Typed-array filter regression");
  }
  return { title: frontmatter.title, ok: true, result: Array.from(result) };
};
