import { S } from "schema";

export const schema = S.Object({ title: S.String() });

export default async (frontmatter) => {
  class Samples extends Float32Array {}
  const trace = [];
  const iterable = {
    *[Symbol.iterator]() {
      trace.push("first");
      yield 2;
      trace.push("second");
      yield 4;
      trace.push("done");
    }
  };
  const samples = Samples.from(iterable, value => {
    trace.push("map");
    return value + 1;
  });
  const fromObject = Float32Array.from({ 0: 7, length: 1 });
  await 0;
  if (!(samples instanceof Samples) || samples.join(",") !== "3,5" ||
      trace.join(",") !== "first,second,done,map,map" || fromObject[0] !== 7 ||
      Float32Array.from !== Object.getPrototypeOf(Float32Array).from) {
    throw new Error("TypedArray.from regression");
  }
  return { title: frontmatter.title, ok: true, values: Array.from(samples), trace };
};
