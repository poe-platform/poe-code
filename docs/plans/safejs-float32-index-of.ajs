import { S } from "schema";

export const schema = S.Object({ title: S.String() });

export default async (frontmatter) => {
  const buffer = new ArrayBuffer(8, { maxByteLength: 16 });
  const values = new Float32Array(buffer);
  values.set([NaN, 2]);
  if (Object.is(new Float32Array([1]).indexOf(1, -0.5), -0)) {
    throw new Error("Negative-zero index regression");
  }
  if (values.indexOf(2) !== 1 || values.indexOf(NaN) !== -1) {
    throw new Error("Index search regression");
  }
  await 0;
  const removed = values.indexOf(undefined, {
    valueOf() { buffer.resize(0); return 0; }
  });
  if (removed !== -1) throw new Error("Absent element search regression");
  return { title: frontmatter.title, ok: true };
};
