import { S } from "schema";
export const schema = S.Object({ title: S.String() });
export default async (frontmatter) => {
  const values = new Float32Array([1, 2, 3]);
  await 0;
  const result = values.map(item => ({ valueOf() { return item * 2; } }));
  if (result.join() !== "2,4,6" || values.join() !== "1,2,3" || result === values) {
    throw new Error("Typed-array map regression");
  }
  return { title: frontmatter.title, ok: true, result: Array.from(result) };
};
