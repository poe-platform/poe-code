import { S } from "schema";

export const schema = S.Object({ title: S.String() });

export default async (frontmatter) => {
  const values = new Float32Array([1.25, 2.5, 3.75]);
  values.extra = { retained: 7 };
  values["01"] = "metadata";
  await 0;
  const sum = values[0] + values[1] + values[2];
  if (sum !== 7.5 || values.extra.retained !== 7 || values["01"] !== "metadata") {
    throw new Error("Float32Array metadata accounting changed observable state");
  }
  return { title: frontmatter.title, ok: true, sum, metadata: values["01"] };
};
