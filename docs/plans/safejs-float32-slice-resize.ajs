import { S } from "schema";

export const schema = S.Object({ title: S.String() });

export default async (frontmatter) => {
  const buffer = new ArrayBuffer(8, { maxByteLength: 16 });
  const tracking = new Float32Array(buffer);
  tracking.set([1, 2]);
  const partial = tracking.slice({ valueOf() { buffer.resize(4); return 0; } });
  if (partial.length !== 2 || partial[0] !== 1 || partial[1] !== 0) {
    throw new Error("Partial shrink slice regression");
  }
  buffer.resize(8);
  const fixed = new Float32Array(buffer, 4, 1);
  let errorName;
  try {
    fixed.slice({ valueOf() { buffer.resize(0); return 0; } });
  } catch (error) {
    errorName = error.name;
  }
  if (errorName !== "TypeError") throw new Error("Slice bounds validation regression");
  buffer.resize(8);
  await 0;
  const empty = fixed.slice({ valueOf() { buffer.resize(0); return 0; } }, 0);
  if (empty.length !== 0) throw new Error("Empty slice regression");
  return { title: frontmatter.title, ok: true, values: Array.from(partial), errorName };
};
