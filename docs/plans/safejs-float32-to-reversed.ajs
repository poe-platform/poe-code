import { S } from "schema";
export const schema = S.Object({ title: S.String() });
export default async (frontmatter) => {
  const values = new Float32Array([1, 2, 3]);
  await 0;
  const result = values.toReversed();
  if (result === values || result.buffer === values.buffer || result.join() !== "3,2,1" || values.join() !== "1,2,3") {
    throw new Error("Typed-array toReversed regression");
  }
  return { title: frontmatter.title, ok: true, result: Array.from(result) };
};
