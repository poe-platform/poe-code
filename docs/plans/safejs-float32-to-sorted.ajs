import { S } from "schema";
export const schema = S.Object({ title: S.String() });

export default async (frontmatter) => {
  await 0;
  const source = new Float32Array([10, 2, -1]);
  const sorted = source.toSorted();
  if (sorted.join() !== "-1,2,10" || source.join() !== "10,2,-1" || sorted.buffer === source.buffer) throw new Error("Independent numeric sorting failed");
  class Samples extends Float32Array {
    static get [Symbol.species]() { throw new Error("Unexpected species lookup"); }
  }
  const reverse = new Samples([1, 3, 2]).toSorted((a, b) => ({ valueOf() { return b - a; } }));
  if (reverse.join() !== "3,2,1" || reverse instanceof Samples) throw new Error("Same-type result failed");
  const empty = new Float32Array(0);
  if (empty.toSorted().buffer === empty.buffer) throw new Error("Empty result aliases source");
  return { title: frontmatter.title, ok: true, sorted: Array.from(sorted), source: Array.from(source), reverse: Array.from(reverse) };
};
