import { S } from "schema";
export const schema = S.Object({ title: S.String() });

export default async (frontmatter) => {
  await 0;
  const source = new Float32Array([1, 2, 3]);
  const replaced = source.with(-1, 7);
  if (source.join() !== "1,2,3" || replaced.join() !== "1,2,7" || source.buffer === replaced.buffer) throw new Error("Independent replacement failed");
  const events = [];
  source.with({ valueOf() { events.push("index"); return 0; } }, { valueOf() { events.push("value"); return 7; } });
  if (events.join() !== "index,value") throw new Error("Conversion order failed");
  class Samples extends Float32Array {
    static get [Symbol.species]() { throw new Error("Unexpected species lookup"); }
  }
  const result = new Samples([1]).with(0, 3);
  if (result instanceof Samples || result[0] !== 3) throw new Error("Same-type result failed");
  return { title: frontmatter.title, ok: true, source: Array.from(source), replaced: Array.from(replaced), events };
};
