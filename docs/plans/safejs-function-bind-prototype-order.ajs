import { S } from "schema";

export const schema = S.Object({ title: S.String() });

export default async (frontmatter) => {
  function add(value) { return this.base + value; }
  const bind = add.bind;
  Object.setPrototypeOf(add, { tag: "original" });
  const trace = [];
  Object.defineProperties(add, {
    length: { get() { trace.push("length"); Object.setPrototypeOf(add, null); return 2; } },
    name: { get() { trace.push("name"); return "renamed"; } }
  });
  const bound = bind.call(add, { base: 2 }, 3);
  function Box(value) { this.value = value; }
  const parent = Object.getPrototypeOf(Box);
  Object.defineProperty(Box, "length", {
    get() { Object.setPrototypeOf(Box, {}); return 1; }
  });
  const BoundBox = Box.bind(null, 7);
  const instance = new BoundBox();
  if (bound.tag !== "original" || bound() !== 5 || bound.name !== "bound renamed" ||
      bound.length !== 1 || trace.join(",") !== "length,name" || instance.value !== 7 ||
      !(instance instanceof Box) || Object.getPrototypeOf(BoundBox) !== parent) {
    throw new Error("Bound function prototype ordering regression");
  }
  return { title: frontmatter.title, ok: true, call: bound(), constructed: instance.value, trace };
};
