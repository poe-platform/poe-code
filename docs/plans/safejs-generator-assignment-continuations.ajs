import { S } from "schema";

export const schema = S.Object({ title: S.String() });

export default async frontmatter => {
  function* values() {
    let count = 0;
    const object = { a: 2, b: 10 };
    const key = { toString() { return ++count === 1 ? "a" : "b"; } };
    object[key] += yield 1;
    return { count, object };
  }
  const iterator = values();
  const first = iterator.next();
  await 0;
  const last = iterator.next(4);
  if (first.value !== 1 || first.done || !last.done || last.value.count !== 1 ||
      last.value.object.a !== 6 || last.value.object.b !== 10) {
    throw new Error("Assignment continuation changed");
  }
  return { title: frontmatter.title, ok: true, result: last.value };
};
