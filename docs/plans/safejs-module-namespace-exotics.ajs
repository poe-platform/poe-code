import * as schemaModule from "schema";
import { S } from "schema";

export const schema = S.Object({ title: S.String() });

export default async (frontmatter) => {
  if (Object.prototype.toString.call(schemaModule) !== "[object Module]" ||
      Object.getPrototypeOf(schemaModule) !== null || Object.isExtensible(schemaModule))
    throw new Error("Namespace metadata mismatch");
  if (schemaModule.S !== S || Reflect.set(schemaModule, "S", S) ||
      !Reflect.defineProperty(schemaModule, "S", { value: S }))
    throw new Error("Namespace export behavior mismatch");
  await 0;
  return { title: frontmatter.title, ok: true, keys: Object.keys(schemaModule) };
};
