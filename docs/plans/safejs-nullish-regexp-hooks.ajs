import { S } from "schema";

export const schema = S.Object({ title: S.String() });

export default async function main(frontmatter) {
  const regex = /a/g;
  regex[Symbol.match] = null;
  regex.lastIndex = 2;
  const match = 'a/a/g'.match(regex);
  if (match[0] !== '/a/g' || match.index !== 1 || regex.lastIndex !== 2)
    throw new Error('Nullish match fallback or cursor isolation failed');
  const all = /a/g;
  all[Symbol.matchAll] = null;
  all.toString = () => 'b';
  const indices = Array.from('ababa'.matchAll(all)).map(item => item.index);
  await 0;
  if (indices.join(',') !== '1,3') throw new Error('Custom pattern coercion failed');
  const search = /a/;
  Object.defineProperty(search, Symbol.search, {
    configurable: true,
    get() { delete search[Symbol.search]; return null; }
  });
  if ('a/a/'.search(search) !== 1) throw new Error('Self-deleting hook fallback failed');
  return { ok: true, title: frontmatter.title, match: match[0], indices, cursor: regex.lastIndex };
}
