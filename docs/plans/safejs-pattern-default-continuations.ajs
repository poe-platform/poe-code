import { S } from "schema";

export const schema = S.Object({ title: S.String() });

export default async frontmatter => {
  function* values() {
    let count = 0;
    function input() { count++; return {}; }
    const { first: { second = yield 1 } = input() } = {};
    return [count, second];
  }
  const iterator = values();
  const first = iterator.next();
  const final = iterator.next(4);
  if (first.value !== 1 || !final.done || final.value.join() !== "1,4")
    throw new Error("Completed default check failed");
  return { title: frontmatter.title, ok: true, result: final.value };
};
