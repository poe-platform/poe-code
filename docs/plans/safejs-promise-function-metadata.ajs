import { S } from "schema";

export const schema = S.Object({ title: S.String() });

export default async (frontmatter) => {
  if (Promise.resolve.length !== 1 || Promise.prototype.then.length !== 2) {
    throw new Error("Promise method argument counts are incorrect");
  }
  const descriptor = Object.getOwnPropertyDescriptor(Promise.resolve, "length");
  if (descriptor.writable || descriptor.enumerable || !descriptor.configurable) {
    throw new Error("Promise method metadata descriptor is incorrect");
  }
  Object.defineProperty(Promise.resolve, "length", { value: 42 });
  const answer = await Promise.resolve(41).then(value => value + 1);
  if (answer !== 42 || Promise.resolve.length !== 42) {
    throw new Error("Metadata redefinition changed Promise behavior");
  }
  return { title: frontmatter.title, ok: true, answer };
};
