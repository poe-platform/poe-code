import { S } from "schema";

export const schema = S.Object({ title: S.String() });

export default async (frontmatter) => {
  const value = Promise.resolve(1);
  const events = [];
  Object.defineProperty(value, "constructor", {
    get() {
      if (this !== value) throw new Error("Wrong constructor getter receiver");
      events.push("constructor");
      return Promise;
    }
  });
  Object.defineProperty(value, "then", {
    get() { events.push("then"); return () => 42; }
  });
  const answer = value.finally(0);
  events.push("after");
  if (answer !== 42 || events.join(",") !== "constructor,then,after") {
    throw new Error("Promise method constructor lookup failed");
  }
  return { title: frontmatter.title, ok: true, answer, events };
};
