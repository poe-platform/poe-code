import { S } from "schema";

export const schema = S.Object({ title: S.String() });

export default async (frontmatter) => {
  class Child extends Promise {}
  async function read() { await 0; return Child.resolve(20); }
  const left = await read();
  const right = await { then(resolve) { resolve(Child.resolve(22)); } };
  async function* values() {
    yield { then(resolve) { resolve(Child.resolve(left + right)); } };
  }
  let answer = 0;
  for await (const value of values()) answer = value;
  if (answer !== 42) throw new Error("Subclass async assimilation failed");
  return { title: frontmatter.title, ok: true, answer };
};
