import { S } from "schema";

export const schema = S.Object({ title: S.String() });

export default async (frontmatter) => {
  class Child extends Promise {}
  const capability = Child.withResolvers();
  capability.resolve({ then(resolve) { resolve(42); } });
  capability.reject(17);
  const answer = await capability.promise;
  if (!(capability.promise instanceof Child) || answer !== 42) {
    throw new Error("Promise.withResolvers capability failed");
  }
  return { title: frontmatter.title, ok: true, answer };
};
