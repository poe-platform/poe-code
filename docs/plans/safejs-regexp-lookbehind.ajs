import { S } from "schema";

export const schema = S.Object({ title: S.String() });

export default async function main(frontmatter) {
  const match = /(?<=([ab]+)([bc]+))$/d.exec('abc');
  if (match[1] !== 'a' || match[2] !== 'bc' || match.indices[2].join('|') !== '1|3')
    throw new Error('Lookbehind lost backward greedy capture order');
  if (!/(?<=(a)(?=b))b/.test('ab')) throw new Error('Nested lookahead used the wrong direction');
  if (/(?<!a)b/.exec('abcb').index !== 3) throw new Error('Negative lookbehind failed');
  await 0;
  return { ok: true, title: frontmatter.title, captures: [match[1], match[2]] };
}
