import { S } from "schema";

export const schema = S.Object({ title: S.String() });

export default async (frontmatter) => {
  async function* values() {
    let count = 0;
    switch (++count) {
      case 1:
        yield count;
        count++;
        yield count;
        return count;
      default:
        throw new Error("Switch selected the wrong case");
    }
  }
  const iterator = values();
  const first = await iterator.next();
  const second = await iterator.next();
  const final = await iterator.next();
  if (first.value !== 1 || first.done || second.value !== 2 || second.done ||
      final.value !== 2 || !final.done) {
    throw new Error("Switch continuation changed progress");
  }
  return { title: frontmatter.title, ok: true, values: [first, second, final] };
};
