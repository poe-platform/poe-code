import { S } from "schema";
export const schema = S.Object({ title: S.String() });

export default async (frontmatter) => {
  const buffer = new ArrayBuffer(8);
  const bytes = new Uint8Array(buffer, 1, 3);
  bytes.set([257, -1, 3.9]);
  const floats = new Float32Array(buffer);
  await 0;
  if (bytes.join() !== "1,255,3" || bytes.byteOffset !== 1 || bytes.byteLength !== 3)
    throw new Error("Byte conversion or view dimensions failed");
  if (floats.buffer !== bytes.buffer || bytes instanceof Float32Array)
    throw new Error("Mixed typed views lost their identities");
  if (Object.getPrototypeOf(Uint8Array) !== Object.getPrototypeOf(Float32Array) ||
      Uint8Array.prototype.map !== Float32Array.prototype.map)
    throw new Error("TypedArray intrinsics are not shared");
  class Bytes extends Uint8Array {
    static get [Symbol.species]() { return Float32Array; }
  }
  const mapped = new Bytes([1, 2]).map(value => value + 0.5);
  if (!(mapped instanceof Float32Array) || mapped.join() !== "1.5,2.5")
    throw new Error("Cross-kind species failed");
  const copy = structuredClone([bytes, buffer]);
  if (copy[0].buffer !== copy[1] || copy[1] === buffer)
    throw new Error("Clone backing aliases failed");
  return { title: frontmatter.title, ok: true, bytes: Array.from(bytes), mapped: Array.from(mapped), sharedStorage: floats.buffer === bytes.buffer };
};
