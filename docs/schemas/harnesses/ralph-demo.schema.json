{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://poe-platform.github.io/poe-code/schemas/harnesses/ralph-demo.schema.json",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "enum": [
        "https://poe-platform.github.io/poe-code/schemas/harnesses/ralph-demo.schema.json"
      ]
    },
    "agent": {
      "type": "object",
      "properties": {
        "agent": {
          "type": "string"
        },
        "mode": {
          "type": "string",
          "enum": [
            "read",
            "edit",
            "yolo"
          ]
        },
        "prompt": {
          "type": "string"
        }
      },
      "required": [
        "agent"
      ],
      "additionalProperties": false
    },
    "goal": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "ralph-demo"
      ]
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "prompt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "prompt"
        ],
        "additionalProperties": false
      }
    },
    "version": {
      "type": "number"
    }
  },
  "required": [
    "$schema",
    "kind",
    "version",
    "agent",
    "steps",
    "goal"
  ],
  "additionalProperties": false
}
