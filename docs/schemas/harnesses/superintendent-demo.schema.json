              "type": "string",
              "enum": [
                "read",
                "edit",
                "yolo"
              ]
            },
            "prompt": {
              "type": "string"
            }
          },
          "required": [
            "agent"
          ]
        },
        "perf": {
          "type": "object",
          "properties": {
            "agent": {
              "type": "string"
            },
            "mode": {
              "type": "string",
              "enum": [
                "read",
                "edit",
                "yolo"
              ]
            },
            "prompt": {
              "type": "string"
            }
          },
          "required": [
            "agent"
          ]
        },
        "security": {
          "type": "object",
          "properties": {
            "agent": {
              "type": "string"
            },
            "mode": {
              "type": "string",
              "enum": [
                "read",
                "edit",
                "yolo"
              ]
            },
            "prompt": {
              "type": "string"
            }
          },
          "required": [
            "agent"
          ]
        },
