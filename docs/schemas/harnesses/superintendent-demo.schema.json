    "kind": {
      "type": "string",
      "enum": [
        "superintendent-demo"
      ]
    },
    "max_rounds": {
      "type": "number",
      "minimum": 1
    },
    "version": {
      "type": "number"
    }
  },
  "required": [
    "$schema",
    "kind",
    "version",
    "agents",
    "max_rounds"
  ]
}
