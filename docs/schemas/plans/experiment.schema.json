{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://poe-platform.github.io/poe-code/schemas/plans/experiment.schema.json",
  "title": "Experiment plan document",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "const": "https://poe-platform.github.io/poe-code/schemas/plans/experiment.schema.json"
    },
    "agent": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      ]
    },
    "baseline": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        }
      ]
    },
    "extends": {
      "type": "boolean"
    },
    "kind": {
      "type": "string",
      "const": "experiment"
    },
    "max_experiments": {
      "type": "integer",
      "minimum": 0
    },
    "metric": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "delta": {
              "type": "number",
              "minimum": 0
            },
            "direction": {
              "type": "string",
              "enum": [
                "minimize",
                "maximize",
                "stable"
              ]
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "script": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "name",
            "script",
            "direction"
          ],
          "additionalProperties": false
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "delta": {
                "type": "number",
                "minimum": 0
              },
              "direction": {
                "type": "string",
                "enum": [
                  "minimize",
                  "maximize",
                  "stable"
                ]
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "script": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "name",
              "script",
              "direction"
            ],
            "additionalProperties": false
          }
        }
      ]
    },
    "metric_timeout": {
      "type": "integer",
      "minimum": 0
    },
    "version": {
      "type": "integer",
      "const": 1
    }
  },
  "required": [],
  "additionalProperties": false
}
