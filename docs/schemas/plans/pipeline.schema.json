{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://poe-platform.github.io/poe-code/schemas/plans/pipeline.schema.json",
  "title": "Pipeline plan document",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "const": "https://poe-platform.github.io/poe-code/schemas/plans/pipeline.schema.json"
    },
    "extends": {
      "type": "string",
      "default": "default",
      "minLength": 1
    },
    "finalization": {
      "description": "Durable finalization progress for resuming teardown and archiving.",
      "type": "string",
      "enum": [
        "pending",
        "teardown_completed",
        "completed"
      ]
    },
    "kind": {
      "type": "string",
      "const": "pipeline"
    },
    "mcp": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "command": {
            "type": "string",
            "minLength": 1
          },
          "env": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "required": [
          "command"
        ],
        "additionalProperties": false
      }
    },
    "name": {
      "type": "string"
    },
    "readiness": {
      "type": "string",
      "enum": [
        "draft",
        "ready"
      ]
    },
    "setup": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "agent": {
              "type": "string",
              "minLength": 1
            },
            "hooks": {
              "type": "object",
              "properties": {
                "from": {
                  "type": "string",
                  "minLength": 1
                },
                "scope": {
                  "type": "string",
                  "enum": [
                    "project",
                    "user",
                    "merged"
                  ]
                },
                "strategy": {
                  "type": "string",
                  "enum": [
                    "auto",
                    "symlink",
                    "transform"
                  ]
                }
              },
              "required": [
                "from"
              ],
              "additionalProperties": false
            },
            "mode": {
              "type": "string",
              "enum": [
                "yolo",
                "auto",
                "edit",
                "read"
              ]
            },
            "model": {
              "type": "string",
              "minLength": 1
            },
            "prompt": {
              "type": "string",
              "minLength": 1
            },
            "skills": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "prompt"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        },
        {
          "const": false
        }
      ]
    },
    "state": {
      "type": "string"
    },
    "steps": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "agent": {
            "type": "string",
            "minLength": 1
          },
          "hooks": {
            "type": "object",
            "properties": {
              "from": {
                "type": "string",
                "minLength": 1
              },
              "scope": {
                "type": "string",
                "enum": [
                  "project",
                  "user",
                  "merged"
                ]
              },
              "strategy": {
                "type": "string",
                "enum": [
                  "auto",
                  "symlink",
                  "transform"
                ]
              }
            },
            "required": [
              "from"
            ],
            "additionalProperties": false
          },
          "mode": {
            "type": "string",
            "enum": [
              "yolo",
              "auto",
              "edit",
              "read"
            ]
          },
          "model": {
            "type": "string",
            "minLength": 1
          },
          "prompt": {
            "type": "string",
            "minLength": 1
          },
          "skills": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "id": {
            "type": "string",
            "minLength": 1
          },
          "prompt": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "open",
                  "done",
                  "failed"
                ]
              },
              {
                "type": "object",
                "additionalProperties": {
                  "type": "string",
                  "enum": [
                    "open",
                    "done",
                    "failed"
                  ]
                }
              }
            ]
          }
        },
        "required": [
          "id",
          "title",
          "prompt",
          "status"
        ],
        "additionalProperties": false
      }
    },
    "teardown": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "agent": {
              "type": "string",
              "minLength": 1
            },
            "hooks": {
              "type": "object",
              "properties": {
                "from": {
                  "type": "string",
                  "minLength": 1
                },
                "scope": {
                  "type": "string",
                  "enum": [
                    "project",
                    "user",
                    "merged"
                  ]
                },
                "strategy": {
                  "type": "string",
                  "enum": [
                    "auto",
                    "symlink",
                    "transform"
                  ]
                }
              },
              "required": [
                "from"
              ],
              "additionalProperties": false
            },
            "mode": {
              "type": "string",
              "enum": [
                "yolo",
                "auto",
                "edit",
                "read"
              ]
            },
            "model": {
              "type": "string",
              "minLength": 1
            },
            "prompt": {
              "type": "string",
              "minLength": 1
            },
            "skills": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "prompt"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        },
        {
          "const": false
        }
      ]
    },
    "vars": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "version": {
      "type": "integer",
      "const": 1
    }
  },
  "required": [
    "kind",
    "version",
    "tasks"
  ],
  "additionalProperties": true
}
