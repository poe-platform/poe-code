{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://poe-platform.github.io/poe-code/schemas/plans/ralph.schema.json",
  "title": "Ralph plan document",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "const": "https://poe-platform.github.io/poe-code/schemas/plans/ralph.schema.json"
    },
    "agent": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      ]
    },
    "extends": {
      "type": "boolean"
    },
    "hooks": {
      "type": "object",
      "properties": {
        "from": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "enum": [
            "project",
            "user",
            "merged"
          ]
        },
        "strategy": {
          "type": "string",
          "enum": [
            "auto",
            "symlink",
            "transform"
          ]
        }
      },
      "required": [
        "from"
      ],
      "additionalProperties": false
    },
    "iterations": {
      "type": "integer",
      "minimum": 1
    },
    "kind": {
      "type": "string",
      "const": "ralph"
    },
    "readiness": {
      "type": "string",
      "enum": [
        "draft",
        "ready"
      ]
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "status": {
      "type": "object",
      "properties": {
        "iteration": {
          "type": "integer",
          "minimum": 0
        },
        "state": {
          "type": "string",
          "enum": [
            "open",
            "in_progress",
            "completed",
            "failed"
          ]
        }
      },
      "required": [
        "state",
        "iteration"
      ],
      "additionalProperties": false
    },
    "version": {
      "type": "integer",
      "const": 1
    }
  },
  "required": [
    "kind",
    "version",
    "status"
  ],
  "additionalProperties": true
}
