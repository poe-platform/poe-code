  "semantics": {
    "authority": "EngineConfig.password.read, propagated unchanged through existing public ssconvertCommands binding. No guest argv/environment/file/ambient-service secret source.",
    "reader": "snapshot method at engine construction; built-in first, at most one host call after valid supported header and duplicate-declaration prepass; frozen format/algorithm/revision/encoding/maxBytes/inputFilename/signal request",
    "encoding": "RC4 exact UTF16LE, including empty/Unicode/NUL; max255code units /510raw bytes, no normalization. XOR explicitly encoded nonempty1..15bytes; no guessed codepage. Bounded owned byte copy before crypto use.",
    "errors": "callback exceptions sanitized without cause/secret; wrong/absent/invalid encoding refuses; cancellation checked before/after await with original cancellation reason",
    "work": "aggregate both verification attempts; fixed800 perRC4 attempt plus admitted excess password bytes over30; XOR verifier charges length+1 perattempt; existing encrypted payload/block work retains admission before copy",
    "publication": "decrypt-only; existing plaintext export semantics and unauthenticated legacy data caveat unchanged"
  },
