    "source": "#include <glib.h>\n#include <stdio.h>\n#include <string.h>\nstatic long find(const char *needle,const char *haystack,int start,int bytes){size_t length=bytes?strlen(haystack):g_utf8_strlen(haystack,-1);if(start<1 || start>=length+1)return -1;const char *from=bytes?(start==1?haystack:g_utf8_find_next_char(haystack+start-2,NULL)):g_utf8_offset_to_pointer(haystack,start-1);const char *p=g_strstr_len(from,strlen(from),needle);if(!p)return -1;return bytes?(p-haystack)+1:g_utf8_pointer_to_offset(from,p)+start;}\nint main(void){for(unsigned lead=0;lead<256;lead++){char source[14]={lead,128,128,128,128,128,0},needle[2]={128,0};printf(\"%02x %ld %ld %ld %ld %ld %ld\\n\",lead,find(needle,source,1,0),find(needle,source,1,1),find(needle,source,2,0),find(needle,source,2,1),find(\"\",source,2,0),find(\"\",source,2,1));}return 0;}\n"
