      "content": "<?xml version='1.0' encoding='utf-8'?>\n<plugin id=\"Gnumeric_OriginalPythonReferenceProbe\"><information><name>Original Python reference probes</name><description>Owned loader qualification fixtures.</description></information><loader type=\"Gnumeric_PythonLoader:python\"><attribute name=\"module_name\" value=\"raw_reference_probe\" /></loader><services><service type=\"function_group\" id=\"reference\"><category>Original reference probes</category><functions><function name=\"probe_array\" /><function name=\"probe_identity\" /><function name=\"probe_reference\" /><function name=\"probe_reference_tuple\" /><function name=\"probe_reference_axes\" /><function name=\"probe_reference_start_sheet\" /><function name=\"probe_reference_end_sheet\" /><function name=\"probe_reference_tuple_axes\" /></functions></service></services></plugin>\n",
