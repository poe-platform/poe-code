      "name": "raw_reference_probe.py",
      "content": "from Gnumeric import *\n\ndef probe_array(*args):\n    \"\"\"@GNM_FUNC_HELP_NAME@PROBE_ARRAY:original native column-oriented array fixture\"\"\"\n    return [[2, 5], [3, 8]]\n\ndef probe_identity(value):\n    \"\"\"@GNM_FUNC_HELP_NAME@PROBE_IDENTITY:original native returned reference fixture\"\"\"\n    return value\n\ndef probe_reference_axes(value):\n    \"\"\"@GNM_FUNC_HELP_NAME@PROBE_REFERENCE_AXES:original native endpoint axes isolation fixture\"\"\"\n    start, end = (value.start, value.end)\n    return [[start.col, start.row, start.col_relative, start.row_relative], [end.col, end.row, end.col_relative, end.row_relative]]\n\ndef probe_reference(value):\n    \"\"\"@GNM_FUNC_HELP_NAME@PROBE_REFERENCE:original native endpoint attribute fixture\"\"\"\n    start, end = (value.start, value.end)\n    return [[start.col, start.row, start.col_relative, start.row_relative, start.sheet is None], [end.col, end.row, end.col_relative, end.row_relative, end.sheet is None]]\n\ndef probe_reference_tuple(value):\n    \"\"\"@GNM_FUNC_HELP_NAME@PROBE_REFERENCE_TUPLE:original native method lookup negative control\"\"\"\n    start, end = value.get_tuple()\n    return [[start.col, start.row, start.col_relative, start.row_relative, start.sheet is None], [end.col, end.row, end.col_relative, end.row_relative, end.sheet is None]]\nreference_functions = {'probe_array': probe_array, 'probe_identity': ('r', 'range', probe_identity), 'probe_reference': ('r', 'range', probe_reference), 'probe_reference_tuple': ('r', 'range', probe_reference_tuple), 'probe_reference_axes': ('r', 'range', probe_reference_axes)}\n",
      "sha256": "aa0e7330303f13d6a7cbb1f1ae4d274ae9d355f66faa0a68a4df46f762b1c0f6"
    }
