      "name": "raw_reference_probe.py",
      "content": "from Gnumeric import *\n\ndef probe_array(*args):\n    '@GNM_FUNC_HELP_NAME@PROBE_ARRAY:original native column-oriented array fixture'\n    return [[2, 5], [3, 8]]\n\ndef probe_identity(value):\n    '@GNM_FUNC_HELP_NAME@PROBE_IDENTITY:original native returned reference fixture'\n    return value\n\ndef probe_reference(value):\n    '@GNM_FUNC_HELP_NAME@PROBE_REFERENCE:original native endpoint attribute fixture'\n    start, end = value.start, value.end\n    return [[start.col, start.row, start.col_relative, start.row_relative, start.sheet is None],\n            [end.col, end.row, end.col_relative, end.row_relative, end.sheet is None]]\n\ndef probe_reference_tuple(value):\n    '@GNM_FUNC_HELP_NAME@PROBE_REFERENCE_TUPLE:original native method lookup negative control'\n    start, end = value.get_tuple()\n    return [[start.col, start.row, start.col_relative, start.row_relative, start.sheet is None],\n            [end.col, end.row, end.col_relative, end.row_relative, end.sheet is None]]\n\nreference_functions = {\n    'probe_array': probe_array,\n    'probe_identity': ('r', 'range', probe_identity),\n    'probe_reference': ('r', 'range', probe_reference),\n    'probe_reference_tuple': ('r', 'range', probe_reference_tuple)\n}\n",
      "sha256": "36c5c0e9e02d8f675ca960a478eb8fe8a54cf762f1da24d974e1a2c74413f074"
    }
