  "scope": "Qualification of existing WK3 coordinate conversion through public model transformations and XML/XLSX replay. No runtime change or native Lotus execution.",
  "authority": {
    "libwps": {
      "commit": "52be0d79c7fe6c1c9df7eb939d33d978c1ddc144",
      "repository": "https://git.code.sf.net/p/libwps/code",
      "member": "src/lib/LotusSpreadsheet.cpp",
      "sha256": "a95effe16c9de49f3044c15f6445f75695ff860393712ee1beb1e0dfc1db98fa",
      "findings": [
        "readCellName:2187-2260 describes range type0 or1, labels type1 user[unkn] and other types unknown; stores first exact name globally. It does not establish local-name scope for type2.",
        "readFormula:3280-3340 converts named tokens to coordinates, omits current-sheet qualifiers and uses relative row/column axes only for opcode7. This is the portable extension's chosen representation.",
        "parseVariable:3046-3100 recognizes external <<File>>Sheet:A1 and <<File>>Sheet:A1..OtherSheet:B2 forms. This fallback is not currently implemented. Its multi-letter column recurrence maps AA to A; that behavior is not assumed to define the format."
      ]
    },
    "libreOffice": {
      "commit": "390583e4ee2077448228e3ea51110131c1901236",
      "files": [
        {
          "path": "out/ssconvert-lotus-local-qualification/lotimpop.cxx",
          "sha256": "171aaaa0b300d66dd75f1d461cb0cc5eb8aa2180e6e8f1f619732be30fba74b5"
        },
        {
          "path": "out/ssconvert-lotus-local-qualification/lotform.cxx",
          "sha256": "1a6b859a76fe0ac7d7485b0b298996125a19ecfc4b170fcbeccd9ca0a00b2794"
        },
        {
          "path": "out/ssconvert-lotus-local-qualification/tool.cxx",
          "sha256": "ee7385baeaf6c04ff755143fa4753eedfa122c2943fb18751978dc0819c574df"
        }
      ],
      "findings": [
        "lotimpop.cxx:157-178 reads USER_RANGE type then ignores it while registering the global range. No local-scope interpretation is present.",
        "lotform.cxx:575-602 handles named and absolute named tokens via lookup, retaining NRREF/ABSNREF text on lookup failure.",
        "tool.cxx:439-524 retains indexed named references; absolute variants have fixed rows/columns and relative sheet flags. This differs from libwps coordinate representation and does not establish full cross-reader edit parity."
      ]
    }
  },
  "behavior": [
    "Cross-sheet copies from the name's own sheet follow the destination sheet; foreign-sheet references retain their explicit sheet.",
    "Opcode7 row/column offsets move during copying; opcode8 keeps absolute coordinates. Qualified two-sheet spans retain both endpoints.",
    "Replacing or removing the separately retained workbook name affects a newly supplied =Value formula but leaves the imported coordinate token intact.",
    "Sheet renaming, including an apostrophe, and physical movement preserve imported formula/name targets.",
    "Unknown range types remain retained with existing diagnostics; no invented local-scope implementation."
  ],
