import { S } from "schema";
import { spawn } from "agent";
import { event } from "log";
import * as harness from "harness";
import * as git from "git";

export const schema = S.Object({
  kind: S.Enum(["fix-bugs"]),
  version: S.Number(),
  agent: S.Object({
    agent: S.String(),
    mode: S.Optional(S.Enum(["read", "edit", "yolo"])),
    model: S.Optional(S.String()),
    prompt: S.Optional(S.String())
  }),
  principles: S.Optional(S.Array(S.String())),
  bugs: S.Array(S.String())
});

export default async (frontmatter) => {
  const meta = import.meta;
  const results = [];

  for (const bugPath of frontmatter.bugs) {
    const headBefore = await git.head();

    const prompt = harness.applyConstraints(
      [
        "Resolve the bug described in " + bugPath + ".",
        "",
        "Two outcomes are allowed: FIX or TRIAGE. Pick exactly one.",
        "",
        "FIX path:",
        "  1. Read the report end to end (Summary, Reproduction, Observed, Expected, Impact).",
        "  2. Reproduce the issue where the report includes a reproduction script.",
        "  3. Implement the fix in the package the bug names; keep the diff scoped to that package.",
        "  4. Add or update a test under the same package that fails before the fix and passes after.",
        "  5. Run the affected package's tests and confirm green.",
        "  6. Commit ONLY the files you changed using Conventional Commits (fix: ...).",
        "     The fix must land in exactly one commit. Do not push. Do not leave anything uncommitted.",
        "",
        "TRIAGE path (use when the bug should not be fixed in this run):",
        "  Valid reasons: duplicate of another bug under docs/bugs, already fixed on main, not reproducible,",
        "  out of scope for this package, report is invalid or under-specified.",
        "  - Make NO source changes. Do NOT commit. Leave the working tree clean.",
        "  - Start your summary with 'TRIAGE: <one-line reason>'.",
        "",
        "Constraints from CLAUDE.md apply: TDD for code changes, no --no-verify on commit, no branches unless asked, no parallel work."
      ].join("\n")
    );

    const result = await spawn(frontmatter.agent, { prompt });

    const headAfter = await git.head();
    const diffText = await git.diff();
    const committed = headAfter !== headBefore;
    const dirty = diffText.length > 0;

    let outcome;
    if (result.exitCode !== 0) {
      outcome = "failed";
    } else if (committed && !dirty) {
      outcome = "fixed";
    } else if (!committed && !dirty) {
      outcome = "triaged";
    } else if (committed && dirty) {
      outcome = "fixed-with-leftover";
    } else {
      outcome = "dirty-no-commit";
    }

    const record = {
      bug: bugPath,
      outcome,
      headBefore,
      headAfter,
      exitCode: result.exitCode,
      summary: result.summary,
      durationMs: result.durationMs
    };
    event("bug.processed", record);
    results.push(record);
  }

  const fixed = results.filter((entry) => entry.outcome === "fixed").length;
  const triaged = results.filter((entry) => entry.outcome === "triaged").length;
  const failed = results.filter((entry) => entry.outcome === "failed").length;
  const dirty = results.filter(
    (entry) => entry.outcome === "dirty-no-commit" || entry.outcome === "fixed-with-leftover"
  ).length;

  return {
    kind: meta.kind,
    filename: meta.filename,
    total: results.length,
    fixed,
    triaged,
    failed,
    dirty,
    results
  };
};
