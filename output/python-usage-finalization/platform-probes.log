{"source":"import os, sys, json, subprocess, socket, threading\nresults = {'tty': [sys.stdin.isatty(), sys.stdout.isatty(), sys.stderr.isatty()], 'os.system': os.system('exit 73')}\nfor name, operation in [('subprocess', lambda: subprocess.run(['python', '-c', 'pass'])), ('fork', os.fork), ('socket', socket.socket), ('thread', lambda: threading.Thread(target=lambda: None).start())]:\n try:\n  value = operation()\n  results[name] = {'returned': str(value)}\n  if name == 'socket': value.close()\n except Exception as error:\n  results[name] = {'type': type(error).__name__, 'message': str(error)}\nprint(json.dumps(results))\n","exitCode":0,"stdout":"{\"tty\": [false, false, false], \"os.system\": -1, \"subprocess\": {\"type\": \"OSError\", \"message\": \"[Errno 138] emscripten does not support processes.\"}, \"fork\": {\"type\": \"OSError\", \"message\": \"[Errno 52] Function not implemented\"}, \"socket\": {\"type\": \"OSError\", \"message\": \"[Errno 52] Function not implemented\"}, \"thread\": {\"type\": \"RuntimeError\", \"message\": \"can't start new thread\"}}\n","stderr":""}
