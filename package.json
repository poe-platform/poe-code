{
  "name": "poe-code",
  "version": "0.0.0-dev",
  "description": "CLI tool to configure Poe API for developer workflows.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./memory": {
      "types": "./packages/memory/dist/index.d.ts",
      "import": "./packages/memory/dist/index.js"
    },
    "./agent": {
      "types": "./dist/agent.d.ts",
      "import": "./dist/agent.js"
    },
    "./credentials": {
      "types": "./dist/credentials.d.ts",
      "import": "./dist/credentials.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    },
    "./config/testing": {
      "types": "./dist/config-testing.d.ts",
      "import": "./dist/config-testing.js"
    },
    "./skills": {
      "types": "./dist/skills.d.ts",
      "import": "./dist/skills.js"
    },
    "./csvkit": {
      "types": "./packages/csvkit/dist/index.d.ts",
      "import": "./packages/csvkit/dist/index.js"
    },
    "./csvkit/codecs/utf8": {
      "types": "./packages/csvkit/dist/codecs/utf8.d.ts",
      "import": "./packages/csvkit/dist/codecs/utf8.js"
    },
    "./csvkit/codecs/python": {
      "types": "./packages/csvkit/dist/codecs/python.d.ts",
      "import": "./packages/csvkit/dist/codecs/python.js"
    },
    "./ssconvert": {
      "types": "./packages/ssconvert/dist/index.d.ts",
      "import": "./packages/ssconvert/dist/index.js"
    },
    "./safe-bash": {
      "types": {
        "workerd": "./packages/safe-bash/dist/core.d.ts",
        "browser": "./packages/safe-bash/dist/core.d.ts",
        "default": "./dist/safe-bash.d.ts"
      },
      "workerd": "./packages/safe-bash/dist/core.browser.js",
      "browser": "./packages/safe-bash/dist/core.browser.js",
      "node": "./dist/safe-bash.js",
      "default": "./dist/safe-bash.js"
    },
    "./safe-bash/commands/media": {
      "types": "./dist/safe-bash-media.d.ts",
      "workerd": "./packages/safe-bash/dist/commands/media/index.browser.js",
      "browser": "./packages/safe-bash/dist/commands/media/index.browser.js",
      "node": "./dist/safe-bash-media.js",
      "default": "./dist/safe-bash-media.js"
    },
    "./media": {
      "types": "./dist/media.d.ts",
      "workerd": "./dist/media.js",
      "browser": "./dist/media.js",
      "node": "./dist/media.js",
      "default": "./dist/media.js"
    },
    "./remote-execution": {
      "types": "./dist/remote-execution.d.ts",
      "workerd": "./dist/remote-execution.js",
      "browser": "./dist/remote-execution.js",
      "node": "./dist/remote-execution.js",
      "default": "./dist/remote-execution.js"
    },
    "./safe-fs/core": {
      "types": {
        "browser": "./packages/safe-fs/dist/core.d.ts",
        "default": "./packages/safe-fs/dist/core.d.ts"
      },
      "browser": "./packages/safe-js/dist/browser/safe-fs-core.js",
      "import": "./packages/safe-js/dist/safe-fs-core.js"
    },
    "./safe-fs": {
      "types": {
        "browser": "./packages/safe-fs/dist/core.d.ts",
        "default": "./packages/safe-fs/dist/index.d.ts"
      },
      "browser": "./packages/safe-js/dist/browser/safe-fs.js",
      "import": "./packages/safe-js/dist/safe-fs.js"
    },
    "./safe-fs/node": {
      "types": {
        "browser": "./packages/safe-fs/dist/node-unavailable.d.ts",
        "default": "./packages/safe-fs/dist/node-host.d.ts"
      },
      "browser": null,
      "import": "./packages/safe-js/dist/safe-fs-node.js"
    },
    "./safe-fs/node/filesystem": {
      "types": {
        "browser": "./packages/safe-fs/dist/node-unavailable.d.ts",
        "default": "./packages/safe-fs/dist/node/filesystem.d.ts"
      },
      "browser": null,
      "import": "./packages/safe-js/dist/safe-fs-bridge.js"
    },
    "./safe-js": {
      "types": {
        "browser": "./packages/safe-fs/dist/node-unavailable.d.ts",
        "default": "./packages/safe-js/dist/index.d.ts"
      },
      "browser": null,
      "import": "./packages/safe-js/dist/index.js"
    },
    "./safe-js/core": {
      "types": {
        "browser": "./packages/safe-fs/dist/node-unavailable.d.ts",
        "default": "./packages/safe-js/dist/core.d.ts"
      },
      "browser": null,
      "import": "./packages/safe-js/dist/core.js"
    },
    "./safe-js/cli": {
      "types": {
        "browser": "./packages/safe-fs/dist/node-unavailable.d.ts",
        "default": "./packages/safe-js/dist/cli.d.ts"
      },
      "browser": null,
      "import": "./packages/safe-js/dist/cli.js"
    },
    "./safejs": {
      "types": {
        "browser": "./packages/safe-fs/dist/node-unavailable.d.ts",
        "default": "./packages/safe-js/dist/index.d.ts"
      },
      "browser": null,
      "import": "./packages/safe-js/dist/index.js"
    },
    "./safejs/core": {
      "types": {
        "browser": "./packages/safe-fs/dist/node-unavailable.d.ts",
        "default": "./packages/safe-js/dist/core.d.ts"
      },
      "browser": null,
      "import": "./packages/safe-js/dist/core.js"
    },
    "./safejs/cli": {
      "types": {
        "browser": "./packages/safe-fs/dist/node-unavailable.d.ts",
        "default": "./packages/safe-js/dist/cli.d.ts"
      },
      "browser": null,
      "import": "./packages/safe-js/dist/cli.js"
    },
    "./safe-playwright": {
      "types": "./packages/safe-playwright/dist/index.d.ts",
      "import": "./packages/safe-playwright/dist/index.js"
    },
    "./safe-playwright/adapter": {
      "types": "./packages/safe-playwright/dist/adapter.d.ts",
      "import": "./packages/safe-playwright/dist/adapter.js"
    },
    "./media/server": {
      "types": {
        "workerd": "./packages/safe-fs/dist/node-unavailable.d.ts",
        "browser": "./packages/safe-fs/dist/node-unavailable.d.ts",
        "node": "./dist/media-server.d.ts",
        "default": "./packages/safe-fs/dist/node-unavailable.d.ts"
      },
      "workerd": null,
      "browser": null,
      "node": "./dist/media-server.js",
      "default": null
    },
    "./remote-execution/server": {
      "types": {
        "workerd": "./packages/safe-fs/dist/node-unavailable.d.ts",
        "browser": "./packages/safe-fs/dist/node-unavailable.d.ts",
        "node": "./dist/remote-execution-server.d.ts",
        "default": "./packages/safe-fs/dist/node-unavailable.d.ts"
      },
      "workerd": null,
      "browser": null,
      "node": "./dist/remote-execution-server.js",
      "default": null
    },
    "./remote-execution/providers/*": {
      "types": "./packages/remote-execution/dist/providers/*.d.ts",
      "workerd": "./packages/remote-execution/dist/providers/*.js",
      "browser": "./packages/remote-execution/dist/providers/*.js",
      "node": "./packages/remote-execution/dist/providers/*.js",
      "default": "./packages/remote-execution/dist/providers/*.js"
    }
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "node scripts/build-workspaces.mjs && npm run codegen:plan-schemas && npm run codegen:harness-schemas && node --input-type=module -e 'import {rm} from \"node:fs/promises\"; import {assertSafeOutputDirectory} from \"./scripts/guard-package-dist.mjs\"; await assertSafeOutputDirectory(process.cwd()); await rm(\"dist\", {recursive:true, force:true});' && tsc -p tsconfig.build.json && node scripts/generate-bin-wrappers.mjs && node scripts/bundle.mjs",
    "build:workspaces": "node scripts/build-workspaces.mjs",
    "build:deps": "node scripts/list-workspace-deps.mjs",
    "codegen:python-types": "tsx scripts/generate-agent-spawn-py-types.ts",
    "codegen:check:python-types": "tsx scripts/generate-agent-spawn-py-types.ts --check",
    "install:py-poe-spawn": "pip install -e packages/py-poe-spawn",
    "predev": "turbo run build --output-logs=errors-only --log-prefix=none --verbosity=0 && node scripts/bundle.mjs",
    "dev": "tsx --import ./scripts/register-template-loader.mjs src/index.ts",
    "start": "node dist/bin.cjs",
    "dev:bundle": "npm run build && node dist/bin.cjs",
    "test": "node scripts/build-workspaces.mjs --test-unit",
    "test:unit": "vitest run --config vitest.root.config.ts",
    "test:unit:shared": "node scripts/test-vitest-workspaces.mjs",
    "test:postinstall-lifecycle": "vitest run --config vitest.postinstall.config.ts",
    "typecheck": "npm run lint:types",
    "check:semver": "node -e \"const semver=require('semver'); const pkg=require('./package.json'); if(!semver.valid(pkg.version)){console.error('Invalid semver version in package.json:', pkg.version); process.exit(1);}\"",
    "lint": "npm run lint:eslint && npm run lint:types && npm run lint:workflows",
    "lint:workflows": "(command -v actionlint > /dev/null || bash scripts/setup-actionlint.sh) && (command -v actionlint > /dev/null && actionlint || ./actionlint)",
    "lint:packages": "tsx packages/package-lint/src/cli.ts",
    "lint:eslint": "node --max-old-space-size=1024 scripts/lint-eslint.mjs",
    "lint:types": "tsc -p tsconfig.build.json --noEmit --incremental --tsBuildInfoFile .turbo/types/root.tsbuildinfo && npm run typecheck:contracts --workspace=@poe-code/safe-js && npm run typecheck:contracts --workspace=tiny-mcp-client",
    "labels:generate": "tsx scripts/generate-labels.ts",
    "screenshot": "tsx scripts/screenshot.ts",
    "screenshot-poe-code": "tsx scripts/screenshot.ts --poe-code",
    "generate:design-docs": "turbo run generate:docs --filter=toolcraft-design",
    "generate:design-docs:all": "npm run generate:design-docs:all -w toolcraft-design",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "watch:diff": "tsx local_scripts/watch-diff.ts",
    "test:integration": "vitest run tests/integration/",
    "test:workflows": "bats .github/workflows/test/workflows.bats",
    "test:workflows:fast": "bats --filter 'dry-run' .github/workflows/test/workflows.bats",
    "test:workflows:all": "bash scripts/test-workflows.sh",
    "test:workflows:ci": "ACT_FULL=1 bash scripts/test-workflows.sh",
    "test:record": "POE_SNAPSHOT_MODE=record npm run test:integration",
    "test-generate": "tsx scripts/test-generate.ts",
    "snapshots": "tsx scripts/snapshots.ts",
    "snapshots:list": "npm run snapshots -- list",
    "snapshots:refresh": "npm run snapshots -- refresh",
    "snapshots:delete": "npm run snapshots -- delete",
    "snapshots:list:stale": "npm run snapshots -- list --stale",
    "snapshots:delete:stale": "npm run snapshots -- delete --stale",
    "e2e": "vitest run --config e2e/vitest.config.ts",
    "e2e:verbose": "E2E_VERBOSE=1 vitest run --config e2e/vitest.config.ts --reporter=verbose",
    "e2e:cleanup": "tsx packages/e2e-test-runner/scripts/cleanup.ts",
    "e2e:cleanup:aggressive": "tsx packages/e2e-test-runner/scripts/cleanup.ts --aggressive",
    "e2e:cache:clear": "rm -rf ~/.cache/poe-e2e",
    "prepack": "npm run build",
    "prepare": "husky",
    "install-local-package": "npm pack --pack-destination /tmp && npm install -g /tmp/poe-code-*.tgz && rm /tmp/poe-code-*.tgz",
    "smoke": "tsx scripts/smoke-test.ts",
    "smoke:verbose": "tsx scripts/smoke-test.ts --verbose",
    "smoke:toolcraft-bundle": "node scripts/verify-toolcraft-cli-bundle.mjs",
    "smoke:toolcraft-entrypoints": "node scripts/verify-toolcraft-entrypoint-bundles.mjs",
    "metric:test_count": "node scripts/metric-test-count.mjs",
    "metric:test_duration": "node scripts/metric-test-duration.mjs",
    "demo:dashboard": "tsx packages/toolcraft-design/src/dashboard/demo.ts",
    "demo:explorer": "tsx packages/toolcraft-design/src/explorer/demo.ts",
    "replay": "tsx packages/agent-spawn/src/acp/replay-cli.ts",
    "codegen:plan-schemas": "tsx scripts/generate-plan-schemas.ts",
    "codegen:harness-schemas": "tsx scripts/generate-harness-schemas.ts",
    "smoke:toolcraft-standalone": "node scripts/verify-toolcraft-standalone.mjs",
    "smoke:toolcraft-sdk-types": "node scripts/verify-toolcraft-published-sdk-types.mjs",
    "sync-skills": "tsx scripts/sync-skills.ts",
    "record:fs-conformance": "tsx scripts/record-fs-conformance.ts",
    "sync:json-schema-test-suite": "node scripts/sync-json-schema-test-suite.mjs",
    "sync:uri-template-test": "node scripts/sync-uri-template-test.mjs",
    "postinstall": "node scripts/postinstall-sync-skills.mjs",
    "test:workspaces": "node scripts/build-workspaces.mjs --test-unit",
    "test:stress:lint": "vitest run --config vitest.lint-stress.config.ts",
    "posttest": "npm run test:stress:lint",
    "test:ci:fresh": "node scripts/build-workspaces.mjs --test-unit --ci-group=fresh",
    "test:ci:cached": "node scripts/build-workspaces.mjs --test-unit --ci-group=cached"
  },
