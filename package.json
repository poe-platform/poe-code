{
  "name": "poe-code",
  "version": "0.0.0-dev",
  "description": "CLI tool to configure Poe API for developer workflows.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./memory": {
      "types": "./packages/memory/dist/index.d.ts",
      "import": "./packages/memory/dist/index.js"
    },
    "./safejs": {
      "types": {
        "browser": "./packages/safe-fs/dist/node-unavailable.d.ts",
        "default": "./packages/safe-js/dist/index.d.ts"
      },
      "browser": null,
      "import": "./packages/safe-js/dist/index.js"
    },
    "./safejs/core": {
      "types": {
        "browser": "./packages/safe-fs/dist/node-unavailable.d.ts",
        "default": "./packages/safe-js/dist/core.d.ts"
      },
      "browser": null,
      "import": "./packages/safe-js/dist/core.js"
    },
    "./safejs/cli": {
      "types": {
        "browser": "./packages/safe-fs/dist/node-unavailable.d.ts",
        "default": "./packages/safe-js/dist/cli.d.ts"
      },
      "browser": null,
      "import": "./packages/safe-js/dist/cli.js"
    },
    "./agent": {
      "types": "./dist/agent.d.ts",
      "import": "./dist/agent.js"
    },
    "./credentials": {
      "types": "./dist/credentials.d.ts",
      "import": "./dist/credentials.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    },
    "./config/testing": {
      "types": "./dist/config-testing.d.ts",
      "import": "./dist/config-testing.js"
    },
    "./skills": {
      "types": "./dist/skills.d.ts",
      "import": "./dist/skills.js"
    },
    "./safe-bash": {
      "types": "./packages/safe-bash/dist/index.d.ts",
      "import": "./packages/safe-bash/dist/index.js"
    },
    "./safe-bash/contracts": {
      "types": "./packages/safe-bash/dist/contracts/index.d.ts",
      "import": "./packages/safe-bash/dist/contracts/index.js"
    },
    "./safe-bash/contracts/*": {
      "types": "./packages/safe-bash/dist/contracts/*.d.ts",
      "import": "./packages/safe-bash/dist/contracts/*.js"
    },
    "./safe-bash/commands/network": {
      "types": "./packages/safe-bash/dist/commands/network/index.d.ts",
      "import": "./packages/safe-bash/dist/commands/network/index.js"
    },
    "./safe-bash/commands/node": {
      "types": "./packages/safe-bash/dist/commands/node/index.d.ts",
      "import": "./packages/safe-bash/dist/commands/node/index.js"
    },
    "./safe-bash/commands/metadata": {
      "types": "./packages/safe-bash/dist/commands/metadata/index.d.ts",
      "import": "./packages/safe-bash/dist/commands/metadata/index.js"
    },
    "./safe-bash/commands/archive": {
      "types": "./packages/safe-bash/dist/commands/archive/index.d.ts",
      "import": "./packages/safe-bash/dist/commands/archive/index.js"
    },
    "./safe-bash/commands/table-text": {
      "types": "./packages/safe-bash/dist/commands/table-text/index.d.ts",
      "import": "./packages/safe-bash/dist/commands/table-text/index.js"
    },
    "./safe-bash/commands/stream-inspection": {
      "types": "./packages/safe-bash/dist/commands/stream-inspection/index.d.ts",
      "import": "./packages/safe-bash/dist/commands/stream-inspection/index.js"
    },
    "./safe-bash/commands/stream-format": {
      "types": "./packages/safe-bash/dist/commands/stream-format/index.d.ts",
      "import": "./packages/safe-bash/dist/commands/stream-format/index.js"
    },
    "./safe-bash/commands/split": {
      "types": "./packages/safe-bash/dist/commands/split/index.d.ts",
      "import": "./packages/safe-bash/dist/commands/split/index.js"
    },
    "./safe-bash/commands/time-env": {
      "types": "./packages/safe-bash/dist/commands/time-env/index.d.ts",
      "import": "./packages/safe-bash/dist/commands/time-env/index.js"
    },
    "./safe-bash/commands/tree": {
      "types": "./packages/safe-bash/dist/commands/tree/index.d.ts",
      "import": "./packages/safe-bash/dist/commands/tree/index.js"
    },
    "./safe-bash/commands/file": {
      "types": "./packages/safe-bash/dist/commands/file/index.d.ts",
      "import": "./packages/safe-bash/dist/commands/file/index.js"
    },
    "./safe-bash/commands/grep-aliases": {
      "types": "./packages/safe-bash/dist/commands/grep-aliases/index.d.ts",
      "import": "./packages/safe-bash/dist/commands/grep-aliases/index.js"
    },
    "./safe-bash/commands/column": {
      "types": "./packages/safe-bash/dist/commands/column/index.d.ts",
