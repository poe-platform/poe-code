{
  "exportName": "codexAgent",
  "definition": {
    "id": "codex",
    "label": "Codex",
    "summary": "OpenAI's coding agent for the terminal.",
    "binaryName": "codex",
    "apiShapes": [
      "openai-responses"
    ],
    "configPath": "~/.codex/config.toml",
    "capabilities": [
      "spawn",
      "configure",
      "install",
      "test",
      "skill",
      "mcp"
    ],
    "branding": {
      "colors": {
        "dark": "#D5D9DF",
        "light": "#7A7F86"
      }
    }
  },
  "argumentTemplates": [
    "-c",
    "otel.trace_exporter={\"otlp-http\"={endpoint=${endpointJson:/v1/traces},protocol=\"json\"}}",
    "-c",
    "otel.exporter={\"otlp-http\"={endpoint=${endpointJson:/v1/logs},protocol=\"json\"}}",
    "-c",
    "otel.log_user_prompt=${content}"
  ]
}
