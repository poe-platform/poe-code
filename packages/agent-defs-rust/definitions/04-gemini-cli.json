{
  "exportName": "geminiCliAgent",
  "definition": {
    "id": "gemini-cli",
    "aliases": [
      "gemini"
    ],
    "label": "Gemini CLI",
    "summary": "Google's open-source AI agent for the terminal.",
    "binaryName": "gemini",
    "configPath": "~/.gemini/settings.json",
    "apiShapes": [
      "google-generations"
    ],
    "capabilities": [
      "spawn",
      "configure",
      "install",
      "test",
      "skill"
    ],
    "branding": {
      "colors": {
        "dark": "#8AB4F8",
        "light": "#1A73E8"
      }
    }
  },
  "skillConfig": {
    "globalSkillDir": "~/.gemini/skills",
    "localSkillDir": ".gemini/skills"
  },
  "acpSpawnConfig": {
    "kind": "acp",
    "env": {
      "GEMINI_SANDBOX": "false"
    },
    "skipAuth": true,
    "argsRecipe": [
      {
        "args": [
          "--acp"
        ]
      },
      {
        "when": "model",
        "args": [
          "--model",
          {
            "option": "model"
          }
        ]
      },
      {
        "whenDefined": "mcpServers",
        "args": [
          "--allowed-mcp-server-names",
          {
            "keysOf": "mcpServers",
            "join": ","
          },
          "--skip-trust"
        ]
      },
      {
        "args": [
          "--approval-mode",
          {
            "mapOf": "mode",
            "default": "auto",
            "values": {
              "yolo": "yolo",
              "auto": "default",
              "edit": "auto_edit",
              "read": "plan"
            }
          }
        ]
      }
    ]
  }
}
