{
  "exportName": "openCodeAgent",
  "definition": {
    "id": "opencode",
    "label": "OpenCode CLI",
    "summary": "Open-source AI coding agent for the terminal.",
    "binaryName": "opencode",
    "apiShapes": [
      "openai-chat-completions"
    ],
    "otelCapture": {
      "env": {
        "OPENCODE_CONFIG_CONTENT": "{\"experimental\":{\"openTelemetry\":true}}"
      }
    },
    "configPath": "~/.config/opencode/opencode.json",
    "capabilities": [
      "spawn",
      "configure",
      "install",
      "test",
      "skill",
      "mcp"
    ],
    "branding": {
      "colors": {
        "dark": "#4A4F55",
        "light": "#2F3338"
      }
    }
  },
  "mcpConfig": {
    "configFile": "~/.config/opencode/opencode.json",
    "configKey": "mcp",
    "format": "json",
    "shape": "opencode"
  },
  "skillConfig": {
    "globalSkillDir": "~/.config/opencode/skills",
    "localSkillDir": ".opencode/skills"
  },
  "spawnConfig": {
    "kind": "cli",
    "adapter": "opencode",
    "promptFlag": "run",
    "modelFlag": "--model",
    "modelStripProviderPrefix": false,
    "defaultArgs": [
      "--format",
      "json"
    ],
    "modes": {
      "yolo": [],
      "edit": [],
      "read": [
        "--agent",
        "plan"
      ]
    },
    "interactive": {
      "defaultArgs": [],
      "promptFlag": "--prompt"
    },
    "order": 4,
    "mcp": {
      "channel": "env",
      "format": "opencode"
    },
    "modelTransforms": [
      {
        "operation": "ensurePrefix",
        "prefix": "poe/"
      }
    ],
    "resume": {
      "argsTemplate": [
        "--session",
        "{{threadId}}"
      ],
      "hintArgsTemplate": [
        "{{cwd}}",
        "--session",
        "{{threadId}}"
      ]
    }
  },
  "acpSpawnConfig": {
    "kind": "acp",
    "skipAuth": true,
    "acpArgs": [
      "acp"
    ],
    "mcp": {
      "channel": "env",
      "format": "opencode"
    }
  }
}
