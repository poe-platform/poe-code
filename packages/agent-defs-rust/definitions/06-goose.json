{
  "exportName": "gooseAgent",
  "definition": {
    "id": "goose",
    "label": "Goose",
    "summary": "Block's open-source AI agent with ACP support.",
    "binaryName": "goose",
    "apiShapes": [
      "openai-chat-completions"
    ],
    "otelCapture": {},
    "configPath": "~/.config/goose/config.yaml",
    "capabilities": [
      "spawn",
      "configure",
      "install",
      "test",
      "skill",
      "mcp"
    ],
    "branding": {
      "colors": {
        "dark": "#FF6B35",
        "light": "#E85D26"
      }
    }
  },
  "mcpConfig": {
    "configFile": "~/.config/goose/config.yaml",
    "configKey": "extensions",
    "format": "yaml",
    "shape": "goose"
  },
  "skillConfig": {
    "globalSkillDir": "~/.agents/skills",
    "localSkillDir": ".agents/skills",
    "dirNote": "Goose discovers skills from the shared .agents/skills convention, not a goose-specific directory."
  },
  "spawnConfig": {
    "kind": "cli",
    "adapter": "native",
    "promptFlag": "--text",
    "modelFlag": "--model",
    "modelStripProviderPrefix": false,
    "defaultArgs": [
      "run",
      "--output-format",
      "stream-json"
    ],
    "defaultArgsPosition": "beforePrompt",
    "mcpArgsPosition": "beforePrompt",
    "modes": {
      "yolo": {
        "env": {
          "GOOSE_DISABLE_KEYRING": "1",
          "GOOSE_MODE": "auto"
        }
      },
      "edit": {
        "env": {
          "GOOSE_DISABLE_KEYRING": "1",
          "GOOSE_MODE": "smart_approve"
        }
      },
      "read": {
        "env": {
          "GOOSE_DISABLE_KEYRING": "1",
          "GOOSE_MODE": "chat"
        }
      }
    },
    "stdinMode": {
      "omitPrompt": true,
      "extraArgs": [
        "--instructions",
        "-"
      ],
      "automaticFallback": false
    },
    "interactive": {
      "defaultArgs": [
        "session"
      ],
      "defaultArgsPosition": "beforePrompt"
    },
    "order": 5,
    "mcp": {
      "channel": "args",
      "format": "goose"
    },
    "resume": {
      "argsTemplate": [
        "--resume",
        "--session-id",
        "{{threadId}}"
      ],
      "hintArgsTemplate": [
        "run",
        "--resume",
        "--session-id",
        "{{threadId}}",
        "--text",
        "continue"
      ]
    }
  },
  "acpSpawnConfig": {
    "kind": "acp",
    "env": {
      "GOOSE_DISABLE_KEYRING": "1"
    },
    "skipAuth": true,
    "acpArgs": [
      "acp"
    ]
  }
}
