{
  "name": "@poe-code/agent-harness-tools",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/guard-package-dist.mjs && tsc",
    "test": "cd ../.. && vitest run packages/agent-harness-tools/src",
    "test:unit": "cd ../.. && vitest run packages/agent-harness-tools/src"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@poe-code/agent-defs": "*",
    "toolcraft-design": "*",
    "@poe-code/poe-code-config": "*",
    "@poe-code/process-runner": "*",
    "@poe-code/task-list": "*",
    "@poe-code/safe-fs": "*",
    "@noble/hashes": "2.4.0"
  },
  "imports": {
    "#harness-tools-filesystem": {
      "types": "./src/default-filesystem.ts",
      "workerd": "./dist/default-filesystem.workerd.js",
      "browser": "./dist/default-filesystem.workerd.js",
      "worker": "./dist/default-filesystem.workerd.js",
      "default": "./dist/default-filesystem.js"
    },
    "#harness-tools-state": {
      "types": "./src/default-state.ts",
      "workerd": "./dist/default-state.workerd.js",
      "browser": "./dist/default-state.workerd.js",
      "worker": "./dist/default-state.workerd.js",
      "default": "./dist/default-state.js"
    },
    "#harness-tools-dashboard": {
      "types": "./src/default-dashboard.ts",
      "workerd": "./dist/default-dashboard.workerd.js",
      "browser": "./dist/default-dashboard.workerd.js",
      "worker": "./dist/default-dashboard.workerd.js",
      "default": "./dist/default-dashboard.js"
    }
  }
}
