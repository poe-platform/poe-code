{
  "name": "agent-kit",
  "version": "0.0.1",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "import": "./dist/mcp.js"
    },
    "./sdk": {
      "types": "./dist/sdk.d.ts",
      "import": "./dist/sdk.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc",
    "test": "cd ../.. && vitest run packages/agent-kit/src/*.test.ts",
    "test:unit": "cd ../.. && vitest run packages/agent-kit/src/*.test.ts",
    "lint": "cd ../.. && eslint packages/agent-kit/src --ext ts && tsc -p packages/agent-kit/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@poe-code/design-system": "^0.0.1",
    "agent-kit-schema": "^0.0.1",
    "commander": "^14.0.3",
    "tiny-stdio-mcp-server": "^0.1.0"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/poe-platform/poe-code.git"
  }
}
