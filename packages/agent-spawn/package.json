{
  "name": "@poe-code/agent-spawn",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "import": "./dist/testing.js",
      "types": "./dist/testing.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "cd ../.. && vitest run packages/agent-spawn/src/*.test.ts packages/agent-spawn/src/**/*.test.ts",
    "test:unit": "cd ../.. && vitest run packages/agent-spawn/src/*.test.ts packages/agent-spawn/src/**/*.test.ts"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@poe-code/agent-defs": "*",
    "@poe-code/agent-harness-tools": "*",
    "@poe-code/design-system": "*",
    "@poe-code/poe-acp-client": "*",
    "@poe-code/poe-code-config": "*",
    "@poe-code/process-runner": "*"
  }
}
