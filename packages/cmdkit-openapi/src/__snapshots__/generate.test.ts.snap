exports[`generate > generates array body params with a repeatable CLI flag, a JSON variant, and MCP array fidelity 1`] = `
[
  {
    "contents": "/**
 * Generated by @poe-code/cmdkit-openapi.
 * spec-sha: spec-sha-123
 * operation-id: setConversationStarters
 */
import { defineCommand, S, UserError } from "@poe-code/cmdkit";
import { requestJson, type OpenApiClientServices } from "@poe-code/cmdkit-openapi";

export const botsSetConversationStartersCommand = defineCommand<OpenApiClientServices>({
  name: "set-conversation-starters",
  description: "Set conversation starters.",
  scope: ["cli", "mcp", "sdk"] as const,
  params: S.Object({
    botHandle: S.String(),
    dryRun: S.Optional(S.Boolean({ description: "Print the HTTP request and exit without sending it.", scope: ["cli", "sdk"] })),
    starters: S.Optional(S.Array(S.String(), { maxItems: 4 })),
    startersJson: S.Optional(S.String({ description: "JSON-encoded value for starters.", scope: ["cli"] })),
    verbose: S.Optional(S.Boolean({ description: "Log the request line to stderr.", short: "v", scope: ["cli", "sdk"] })),
  }),
  handler: async ({ params, baseUrl, tokenSource, fetch }) => {
    if (params.starters !== undefined && params.startersJson !== undefined) {
      throw new UserError("Options \\"--starters\\" and \\"--starters-json\\" are mutually exclusive.");
    }
    let resolvedStarters = params.starters;
    if (params.startersJson !== undefined) {
      let parsedJson: unknown;
      try {
        parsedJson = JSON.parse(params.startersJson);
      } catch (error) {
        throw new UserError("Invalid value for \\"--starters-json\\". Expected valid JSON.");
      }
      if (!Array.isArray(parsedJson)) {
        throw new UserError("Invalid value for \\"--starters-json\\". Expected a JSON array.");
      }
      resolvedStarters = parsedJson;
    }
    if (resolvedStarters === undefined) {
      throw new UserError("Missing required parameter \\"starters\\".");
    }
    return requestJson({
      baseUrl,
      path: "/bots/{botHandle}/actions/set-conversation-starters",
      method: "POST",
      tokenSource,
      fetch,
      dryRun: params.dryRun,
      verbose: params.verbose,
      pathParams: {
        "botHandle": params.botHandle,
      },
      body: {
        "starters": resolvedStarters,
      },
    });
  },
});
",
    "path": "bots/set-conversation-starters.ts",
  },
  {
    "contents": "import { defineGroup } from "@poe-code/cmdkit";
import { botsSetConversationStartersCommand } from "./bots/set-conversation-starters.js";

export const bots = defineGroup({
  name: "bots",
  children: [botsSetConversationStartersCommand],
});
",
    "path": "index.ts",
  },
]
`;

