export const botsSetOfficialCommand = defineCommand<OpenApiClientServices>({
  name: "set-official",
  description: "Mark a bot as official.",
  scope: ["cli", "mcp", "sdk"] as const,
  params: S.Object({
    botHandle: S.String(),
    dryRun: S.Optional(S.Boolean({ description: "Print the HTTP request and exit without sending it.", scope: ["cli", "sdk"] })),
    official: S.Boolean(),
    verbose: S.Optional(S.Boolean({ description: "Log the request line to stderr.", short: "v", scope: ["cli", "sdk"] })),
  }),
  handler: async ({ params, baseUrl, tokenSource, fetch }) => {
    return requestJson({
      baseUrl,
      path: "/bots/{botHandle}/actions/set-official",
      method: "POST",
      tokenSource,
      fetch,
      dryRun: params.dryRun,
      verbose: params.verbose,
      pathParams: {
        "botHandle": params.botHandle,
      },
      body: {
        "official": params.official,
      },
    });
  },
});
",
