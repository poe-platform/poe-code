{
  "name": "@poe-code/config-mutations-rust",
  "version": "0.1.0",
  "private": true,
  "description": "Additive own Rust configuration codecs and file mutations with zero npm runtime dependencies",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./json": {
      "types": "./dist/json.d.ts",
      "import": "./dist/json.js"
    },
    "./toml": {
      "types": "./dist/toml.d.ts",
      "import": "./dist/toml.js"
    },
    "./yaml": {
      "types": "./dist/yaml.d.ts",
      "import": "./dist/yaml.js"
    },
    "./execution": {
      "types": "./dist/execution.d.ts",
      "import": "./dist/execution.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "scripts": {
    "build": "node scripts/prepare-host.mjs && node ../mcp-protocol-rust/scripts/cargo.mjs build",
    "test:unit": "node scripts/prepare-host.mjs && node ../mcp-protocol-rust/scripts/cargo.mjs test && tsc --project tsconfig.types.json && vitest run --config vitest.sdk.config.mjs",
    "lint": "node ../mcp-protocol-rust/scripts/cargo.mjs lint"
  },
  "devDependencies": {
    "@napi-rs/cli": "3.10.4",
    "jsonc-parser": "^3.3.1",
    "mcp-protocol-rust": "*",
    "typescript": "5.9.3",
    "smol-toml": "^1.7.0",
    "yaml": "^2.9.0",
    "memfs": "4.56.10",
    "@poe-code/config-mutations": "*",
    "toolcraft-design-rust": "*",
    "vitest": "4.1.11"
  },
  "files": [
    "dist",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=18.18"
  },
  "napi": {
    "binaryName": "config-mutations-rust"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/poe-platform/poe-code.git",
    "directory": "packages/config-mutations-rust"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts"
}
