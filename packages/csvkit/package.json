{
  "name": "@poe-code/csvkit",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./codecs/utf8": {
      "types": "./dist/codecs/utf8.d.ts",
      "import": "./dist/codecs/utf8.js"
    },
    "./codecs/python": {
      "types": "./dist/codecs/python.d.ts",
      "import": "./dist/codecs/python.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "THIRD_PARTY_NOTICES.txt"
  ],
  "scripts": {
    "build": "node scripts/generate-inventories.mjs && node ../../scripts/guard-package-dist.mjs && tsc",
    "test": "cd ../.. && vitest run packages/csvkit/src",
    "test:unit": "cd ../.. && vitest run packages/csvkit/src",
    "lint": "eslint src && tsc --noEmit && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@e965/xlsx": "0.20.3",
    "@poe-code/office-package": "*",
    "@sqlite.org/sqlite-wasm": "3.50.4-build1",
    "saxes": "6.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/poe-platform/poe-code.git",
    "directory": "packages/csvkit"
  },
  "devDependencies": {
    "@poe-code/safe-python": "*"
  },
  "poeCode": {
    "safeLibraryNotices": {
      "safe-bash": [
        "./THIRD_PARTY_NOTICES.txt"
      ]
    }
  }
}
