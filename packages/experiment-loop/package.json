{
  "name": "@poe-code/experiment-loop",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/guard-package-dist.mjs && tsc",
    "test": "cd ../.. && vitest run --config vitest.config.ts packages/experiment-loop/src",
    "test:unit": "cd ../.. && vitest run --config vitest.config.ts packages/experiment-loop/src"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@poe-code/agent-defs": "*",
    "@poe-code/agent-harness-tools": "*",
    "@poe-code/agent-spawn": "*",
    "@poe-code/config-extends": "*",
    "@poe-code/frontmatter": "*",
    "@poe-code/safe-fs": "*",
    "yaml": "^2.8.1"
  },
  "imports": {
    "#experiment-platform": {
      "types": "./src/platform.ts",
      "workerd": "./dist/platform.workerd.js",
      "browser": "./dist/platform.workerd.js",
      "worker": "./dist/platform.workerd.js",
      "default": "./dist/platform.js"
    }
  }
}
