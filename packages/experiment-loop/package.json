    "test:unit": "cd ../.. && vitest run --config vitest.config.ts packages/experiment-loop/src/**/*.test.ts"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@poe-code/agent-defs": "*",
    "gray-matter": "^4.0.3"
  }
