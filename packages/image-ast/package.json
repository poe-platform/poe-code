{
  "name": "@poe-code/image-ast",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./portable": {
      "types": "./dist/portable.d.ts",
      "import": "./dist/portable.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node ../../scripts/guard-package-dist.mjs && tsc && esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/index.js && esbuild src/portable.ts --bundle --platform=browser --format=esm --target=es2022 --outfile=dist/portable.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "lint": "eslint src && npm run typecheck",
    "test": "cd ../.. && vitest run packages/image-ast",
    "test:unit": "cd ../.. && vitest run packages/image-ast"
  },
  "dependencies": {},
  "devDependencies": {
    "@poe-code/pdf-ast": "*",
    "pako": "3.0.1"
  },
  "poeCode": {
    "safeLibraryExports": {
      "safe-bash": {
        "./image-ast": ".",
        "./sharp": "."
      }
    }
  }
}
