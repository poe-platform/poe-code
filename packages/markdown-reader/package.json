{
  "name": "@poe-code/markdown-reader",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": {
        "workerd": "./dist/portable.d.ts",
        "browser": "./dist/portable.d.ts",
        "worker": "./dist/portable.d.ts",
        "default": "./dist/index.d.ts"
      },
      "workerd": "./dist/portable.js",
      "browser": "./dist/portable.js",
      "worker": "./dist/portable.js",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/guard-package-dist.mjs && tsc",
    "test": "cd ../.. && vitest run packages/markdown-reader/src/ --coverage.enabled --coverage.provider=v8 --coverage.reporter=text-summary --coverage.include='packages/markdown-reader/src/core/*.ts' --coverage.exclude='packages/markdown-reader/src/core/*.test.ts' --coverage.thresholds.lines=90",
    "test:unit": "cd ../.. && vitest run packages/markdown-reader/src/"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@poe-code/frontmatter": "*",
    "toolcraft": "*",
    "toolcraft-schema": "*",
    "toolcraft-design": "*",
    "@poe-code/safe-fs": "*"
  },
  "imports": {
    "#markdown-reader-filesystem": {
      "types": "./src/default-filesystem.ts",
      "workerd": "./dist/default-filesystem.workerd.js",
      "browser": "./dist/default-filesystem.workerd.js",
      "worker": "./dist/default-filesystem.workerd.js",
      "default": "./dist/default-filesystem.js"
    }
  }
}
