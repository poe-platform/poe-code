{
  "name": "mcp-oauth-server-rust",
  "version": "0.1.0",
  "private": true,
  "description": "Independent Rust MCP authorization server with native Node bindings",
  "type": "module",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "scripts": {
    "build": "node ../mcp-protocol-rust/scripts/cargo.mjs build",
    "test:unit": "node ../mcp-protocol-rust/scripts/cargo.mjs test && vitest run --config vitest.reference.config.ts && tsc --project tsconfig.types.json",
    "lint": "node ../mcp-protocol-rust/scripts/cargo.mjs lint"
  },
  "devDependencies": {
    "@napi-rs/cli": "3.10.4",
    "jose": "6.2.3",
    "mcp-oauth-rust": "*",
    "mcp-oauth-server": "*",
    "mcp-protocol-rust": "*",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "files": ["dist", "LICENSE"],
  "engines": { "node": ">=18.18" },
  "napi": { "binaryName": "mcp-oauth-server-rust" },
  "repository": { "type": "git", "url": "git+https://github.com/poe-platform/poe-code.git", "directory": "packages/mcp-oauth-server-rust" }
}
