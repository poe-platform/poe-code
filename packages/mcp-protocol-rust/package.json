{
  "name": "mcp-protocol-rust",
  "version": "0.1.0",
  "private": true,
  "description": "Dependency-free Rust JSON and MCP protocol primitives",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node scripts/cargo.mjs build && cp src/errors.d.ts dist/errors.d.ts",
    "test:unit": "node --test scripts/run-native-tests.test.mjs scripts/cargo-cache.test.mjs && node scripts/cargo.mjs test && cp src/errors.d.ts dist/errors.d.ts",
    "lint": "node scripts/cargo.mjs lint"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/poe-platform/poe-code.git",
    "directory": "packages/mcp-protocol-rust"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@napi-rs/cli": "3.10.4",
    "tiny-stdio-mcp-server": "^0.1.0",
    "memfs": "4.56.10"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "import": "./dist/errors.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.18"
  },
  "napi": {
    "binaryName": "mcp-protocol-rust",
    "dtsHeaderFile": "src/native-types.d.ts"
  }
}
