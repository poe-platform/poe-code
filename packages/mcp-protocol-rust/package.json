{
  "name": "mcp-protocol-rust",
  "version": "0.1.0",
  "private": true,
  "description": "Dependency-free Rust JSON and MCP protocol primitives",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node scripts/cargo.mjs build",
    "test:unit": "node scripts/cargo.mjs test",
    "lint": "node scripts/cargo.mjs lint"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/poe-platform/poe-code.git",
    "directory": "packages/mcp-protocol-rust"
  },
  "devDependencies": {
    "@napi-rs/cli": "3.10.4"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.18"
  },
  "napi": {
    "binaryName": "mcp-protocol-rust"
  }
}
