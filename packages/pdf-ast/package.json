{
  "name": "@poe-code/pdf-ast",
  "version": "0.0.1",
  "private": true,
  "license": "SEE LICENSE IN THIRD_PARTY_NOTICES.md",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "licenses"
  ],
  "scripts": {
    "build": "node ../../scripts/guard-package-dist.mjs && tsc && mkdir -p dist/vendor && cp src/vendor/* dist/vendor/ && esbuild src/index.ts --bundle --minify --platform=browser --conditions=workerd --format=esm --target=es2022 --outfile=dist/index.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "lint": "eslint src && npm run typecheck",
    "test": "cd ../.. && vitest run packages/pdf-ast",
    "test:unit": "cd ../.. && vitest run packages/pdf-ast"
  },
  "dependencies": {},
  "poeCode": {
    "safeLibraryExports": {
      "safe-bash": {
        "./pdf-ast": "."
      }
    },
    "safeLibraryNotices": {
      "safe-bash": [
        "./THIRD_PARTY_NOTICES.md",
        "./licenses/PDFJS-APACHE-2.0.txt",
        "./licenses/PDFIUM-BSD.txt",
        "./licenses/PYPDF-BSD.txt",
        "./licenses/AGG-2.3.txt",
        "./licenses/MIT.txt"
      ]
    }
  },
  "devDependencies": {
    "@poe-code/compression": "*",
    "pako": "3.0.1",
    "@poe-code/safe-fs": "*",
    "@poe-code/json-ast": "*"
  }
}
