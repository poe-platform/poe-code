{
  "name": "@poe-code/pdf",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "OFL.txt"
  ],
  "scripts": {
    "build": "node ../../scripts/guard-package-dist.mjs && tsc",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "lint": "eslint src && npm run typecheck",
    "test": "cd ../.. && vitest run packages/pdf",
    "test:unit": "cd ../.. && vitest run packages/pdf"
  },
  "dependencies": {
    "pdf-lib": "1.17.1",
    "@pdf-lib/fontkit": "1.1.1",
    "pako": "3.0.1"
  }
}
