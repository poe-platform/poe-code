{
  "name": "@poe-code/poe-agent-rust",
  "version": "0.1.0",
  "private": true,
  "description": "Independent Rust agent runtime foundations with native Node bindings",
  "type": "module",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node scripts/prepare-host.mjs && node ../mcp-protocol-rust/scripts/cargo.mjs build",
    "test:unit": "node scripts/prepare-host.mjs && node ../mcp-protocol-rust/scripts/cargo.mjs test && tsc --project tsconfig.types.json && cd ../.. && vitest run --config packages/poe-agent-rust/vitest.sdk.config.mjs",
    "lint": "node ../mcp-protocol-rust/scripts/cargo.mjs lint"
  },
  "devDependencies": {
    "@napi-rs/cli": "3.10.4",
    "@poe-code/agent-spawn-rust": "*",
    "@poe-code/poe-agent": "*",
    "mcp-protocol-rust": "*",
    "memfs": "4.56.10",
    "openai": "6.49.0",
    "tiny-mcp-client-rust": "*",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "files": [
    "dist",
    "LICENSE",
    "UNICODE-LICENSE.txt",
    "MCP-LICENSE.txt"
  ],
  "engines": {
    "node": ">=18.18"
  },
  "napi": {
    "binaryName": "poe-agent-rust"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/poe-platform/poe-code.git",
    "directory": "packages/poe-agent-rust"
  }
}
