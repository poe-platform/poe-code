{
  "name": "@poe-code/poe-agent",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./plugin-config": {
      "types": "./dist/plugin-config.d.ts",
      "import": "./dist/plugin-config.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/guard-package-dist.mjs && tsc && node scripts/embed-prompt.mjs",
    "test:build-smoke": "npm run build && vitest run --config vitest.build-smoke.config.ts",
    "test:unit": "cd ../.. && vitest run packages/poe-agent/src"
  },
  "dependencies": {
    "@poe-code/agent-skill-config": "*",
    "@poe-code/agent-spawn": "*",
    "@poe-code/poe-acp-client": "*",
    "@poe-code/safe-fs": "*",
    "@poe-code/user-error": "*",
    "@poe-platform/safe-bash": "*",
    "auth-store": "*",
    "fast-glob": "^3.3.3",
    "ipaddr.js": "^2.5.0",
    "minimatch": "^10.2.6",
    "openai": "^6.34.0",
    "shell-quote": "^1.10.0",
    "tiny-mcp-client": "*",
    "turndown": "^7.2.4",
    "@mixmark-io/domino": "2.2.0"
  },
  "devDependencies": {
    "@types/shell-quote": "^1.7.5",
    "@types/turndown": "^5.0.6",
    "tiny-stdio-mcp-test-server": "*"
  },
  "files": [
    "dist"
  ],
  "imports": {
    "#agent-platform": {
      "types": "./src/platform.ts",
      "workerd": "./dist/platform.workerd.js",
      "browser": "./dist/platform.workerd.js",
      "worker": "./dist/platform.workerd.js",
      "default": "./dist/platform.js"
    },
    "#agent-system-prompt": {
      "types": "./src/system-prompt-data.d.ts",
      "default": "./dist/system-prompt-data.js"
    }
  }
}
