    "openai": "^6.34.0",
    "shell-quote": "^1.9.0",
    "tiny-mcp-client": "*",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@types/shell-quote": "^1.7.5",
    "@types/turndown": "^5.0.6",
    "tiny-stdio-mcp-test-server": "*"
  },
  "files": [
    "dist"
  ]
