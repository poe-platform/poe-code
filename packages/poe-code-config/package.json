{
  "name": "@poe-code/poe-code-config",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./merge": {
      "types": "./dist/merge.d.ts",
      "import": "./dist/merge.js"
    },
    "./resolve": {
      "types": "./dist/resolve.d.ts",
      "import": "./dist/resolve.js"
    },
    "./memory": {
      "types": "./dist/memory.d.ts",
      "import": "./dist/memory.js"
    },
    "./workflow": {
      "types": "./dist/workflow.d.ts",
      "import": "./dist/workflow.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc",
    "test:unit": "cd ../.. && vitest run packages/poe-code-config/src"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@poe-code/agent-defs": "*",
    "@poe-code/config-extends": "*",
    "@poe-code/config-mutations": "*",
    "@poe-code/providers": "*",
    "toolcraft-schema": "*",
    "ts-morph": "^27.0.2",
    "@poe-code/safe-fs": "*"
  },
  "imports": {
    "#config-filesystem": {
      "types": "./src/default-filesystem.ts",
      "workerd": "./dist/default-filesystem.workerd.js",
      "browser": "./dist/default-filesystem.workerd.js",
      "worker": "./dist/default-filesystem.workerd.js",
      "default": "./dist/default-filesystem.js"
    }
  }
}
