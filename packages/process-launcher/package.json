{
  "name": "@poe-code/process-launcher",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/guard-package-dist.mjs && tsc",
    "test": "cd ../.. && vitest run --config vitest.config.ts packages/process-launcher/src/",
    "test:unit": "cd ../.. && vitest run --config vitest.config.ts packages/process-launcher/src/"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@poe-code/process-runner": "*",
    "@poe-code/user-error": "*",
    "@poe-code/workspace-resolver": "*"
  }
}
