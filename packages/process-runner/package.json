{
  "name": "@poe-code/process-runner",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./docker/build-context": {
      "types": "./dist/docker/build-context.d.ts",
      "import": "./dist/docker/build-context.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/guard-package-dist.mjs && tsc",
    "test": "cd ../.. && vitest run --config vitest.config.ts packages/process-runner/src/",
    "test:unit": "cd ../.. && vitest run --config vitest.config.ts packages/process-runner/src/",
    "lint": "cd ../.. && eslint packages/process-runner/src --ext ts && tsc -p packages/process-runner/tsconfig.json --noEmit"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/poe-platform/poe-code.git",
    "directory": "packages/process-runner"
  },
  "dependencies": {
    "ignore": "^5.3.2"
  }
}
