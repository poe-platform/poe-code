{
  "name": "safe-bash-command-ast-grep",
  "version": "0.0.1",
  "private": true,
  "description": "Virtual structural code search and lossless rewrites",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "workerd": "./dist/index.js",
      "browser": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "node ../../scripts/guard-package-dist.mjs && tsc && esbuild src/index.ts --bundle --platform=browser --conditions=workerd --format=esm --target=es2022 --external:safe-bash-contracts --external:safe-bash-contracts/* --outfile=dist/index.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "lint": "eslint src && npm run typecheck",
    "test": "cd ../.. && vitest run packages/safe-bash-command-ast-grep",
    "test:unit": "cd ../.. && vitest run packages/safe-bash-command-ast-grep"
  },
  "dependencies": {},
  "devDependencies": {
    "safe-bash-contracts": "*",
    "@poe-code/ts-ast": "*",
    "yaml": "2.8.1",
    "picomatch": "^4.0.3",
    "@types/picomatch": "^4.0.2"
  },
  "sideEffects": false
}
