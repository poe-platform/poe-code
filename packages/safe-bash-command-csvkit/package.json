{
  "name": "safe-bash-command-csvkit",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "workerd": "./dist/index.js",
      "browser": "./dist/index.js",
      "import": "./dist/index.js"
    },
    "./codecs/utf8": {
      "types": "./dist/codecs/utf8.d.ts",
      "workerd": "./dist/codecs/utf8.js",
      "browser": "./dist/codecs/utf8.js",
      "import": "./dist/codecs/utf8.js"
    },
    "./codecs/python": {
      "types": "./dist/codecs/python.d.ts",
      "workerd": "./dist/codecs/python.js",
      "browser": "./dist/codecs/python.js",
      "import": "./dist/codecs/python.js"
    },
    "./sync-support": {
      "types": "./dist/sync-support.d.ts",
      "workerd": "./dist/sync-support.js",
      "browser": "./dist/sync-support.js",
      "import": "./dist/sync-support.js"
    },
    "./python-regex": {
      "types": "./dist/python-regex.d.ts",
      "workerd": "./dist/python-regex.js",
      "browser": "./dist/python-regex.js",
      "import": "./dist/python-regex.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "THIRD_PARTY_NOTICES.txt"
  ],
  "scripts": {
    "build": "node scripts/generate-inventories.mjs && node ../../scripts/guard-package-dist.mjs && node scripts/build-python-worker.mjs && tsc",
    "test": "cd ../.. && vitest run packages/safe-bash-command-csvkit/src",
    "test:unit": "cd ../.. && vitest run packages/safe-bash-command-csvkit/src",
    "lint": "eslint src && tsc --noEmit && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@poe-code/office-package": "*",
    "@sqlite.org/sqlite-wasm": "3.50.4-build1",
    "@poe-code/spreadsheet-ast": "*",
    "@poe-code/spreadsheet-format-xls": "*",
    "@poe-code/xlsx-ast": "*"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/poe-platform/poe-code.git",
    "directory": "packages/safe-bash-command-csvkit"
  },
  "poeCode": {
    "safeLibraryNotices": {
      "safe-bash": [
        "./THIRD_PARTY_NOTICES.txt"
      ]
    }
  },
  "devDependencies": {
    "@e965/xlsx": "0.20.3",
    "safe-bash-contracts": "*",
    "@antonz/python-wasi": "3.12.0",
    "@bjorn3/browser_wasi_shim": "0.4.2",
    "binaryen": "123.0.0",
    "fflate": "0.8.2",
    "@poe-code/compression": "*",
    "safe-bash-csv-engine": "*"
  },
  "imports": {
    "#csvpy-worker": {
      "types": "./src/python-worker-browser.ts",
      "workerd": "./dist/python-worker-browser.js",
      "browser": "./dist/python-worker-browser.js",
      "default": "./dist/python-worker-node.js"
    }
  }
}
