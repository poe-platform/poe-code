{
  "name": "safe-bash-command-dd",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./conversions": {
      "types": "./dist/conversions.d.ts",
      "import": "./dist/conversions.js"
    },
    "./creation-mask": {
      "types": "./dist/creation-mask.d.ts",
      "import": "./dist/creation-mask.js"
    },
    "./filesystem-descriptor": {
      "types": "./dist/filesystem-descriptor.d.ts",
      "import": "./dist/filesystem-descriptor.js"
    },
    "./filesystem-output": {
      "types": "./dist/filesystem-output.d.ts",
      "import": "./dist/filesystem-output.js"
    },
    "./index": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./io": {
      "types": "./dist/io.d.ts",
      "import": "./dist/io.js"
    },
    "./options": {
      "types": "./dist/options.d.ts",
      "import": "./dist/options.js"
    },
    "./report": {
      "types": "./dist/report.d.ts",
      "import": "./dist/report.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "node ../../scripts/guard-package-dist.mjs && tsc",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "lint": "eslint src && npm run typecheck",
    "test": "node --import tsx --test src/*.test.ts",
    "test:unit": "node --import tsx --test src/*.test.ts"
  },
  "dependencies": {},
  "devDependencies": {
    "safe-bash-contracts": "*",
    "@poe-code/safe-fs": "*"
  }
}
