{
  "name": "safe-bash-command-ffmpeg",
  "version": "0.0.1",
  "private": true,
  "description": "Pure in-memory ffmpeg and ffprobe commands for safe-bash powered by @poe-code/mp4-ast and pluggable media ASTs",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node ../../scripts/guard-package-dist.mjs && tsc && esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --external:safe-bash-contracts --external:safe-bash-contracts/* --outfile=dist/index.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "lint": "eslint src && npm run typecheck",
    "test": "cd ../.. && vitest run packages/safe-bash-command-ffmpeg",
    "test:unit": "cd ../.. && vitest run packages/safe-bash-command-ffmpeg"
  },
  "dependencies": {},
  "devDependencies": {
    "@poe-code/mp4-ast": "*",
    "@poe-code/image-ast": "*",
    "@poe-code/audio-ast": "*",
    "safe-bash-contracts": "*"
  }
}
