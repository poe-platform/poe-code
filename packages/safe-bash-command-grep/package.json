  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "workerd": "./dist/index.js",
      "browser": "./dist/index.js",
      "import": "./dist/index.js"
    },
    "./index": {
      "types": "./dist/index.d.ts",
      "workerd": "./dist/index.js",
      "browser": "./dist/index.js",
      "import": "./dist/index.js"
    },
    "./grep": {
      "types": "./dist/grep.d.ts",
      "workerd": "./dist/grep.js",
      "browser": "./dist/grep.js",
      "import": "./dist/grep.js"
    },
    "./grep-files": {
      "types": "./dist/grep-files.d.ts",
      "workerd": "./dist/grep-files.js",
      "browser": "./dist/grep-files.js",
      "import": "./dist/grep-files.js"
    },
    "./aliases": {
      "types": "./dist/aliases.d.ts",
      "workerd": "./dist/aliases.js",
      "browser": "./dist/aliases.js",
      "import": "./dist/aliases.js"
    },
    "./alias-options": {
      "types": "./dist/alias-options.d.ts",
      "workerd": "./dist/alias-options.js",
      "browser": "./dist/alias-options.js",
      "import": "./dist/alias-options.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "node ../../scripts/guard-package-dist.mjs && tsc",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "lint": "eslint src && npm run typecheck",
    "test": "node --import tsx --test src/*.test.ts",
    "test:unit": "node --import tsx --test src/*.test.ts"
  },
  "dependencies": {},
  "devDependencies": {
    "safe-bash-contracts": "*",
    "safe-bash-search-engine": "*",
    "safe-bash-regex-engine": "*",
    "@poe-code/safe-fs": "*",
    "safe-bash-io-engine": "*"
  }
