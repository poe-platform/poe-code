{
  "name": "safe-bash-command-imagemagick",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "workerd": "./dist/index.js",
      "browser": "./dist/index.js",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "node ../../scripts/guard-package-dist.mjs && tsc && esbuild src/index.ts --bundle --platform=browser --conditions=workerd --format=esm --target=es2022 --external:safe-bash-contracts --external:safe-bash-contracts/* --outfile=dist/index.js --external:@poe-code/image-ast --external:@poe-code/safe-fs --external:@poe-code/safe-fs/*",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "lint": "eslint src && npm run typecheck",
    "test": "cd ../.. && vitest run packages/safe-bash-command-imagemagick",
    "test:unit": "cd ../.. && vitest run packages/safe-bash-command-imagemagick"
  },
  "dependencies": {},
  "devDependencies": {
    "@poe-code/image-ast": "*",
    "safe-bash-contracts": "*",
    "@poe-code/safe-fs": "*"
  },
  "sideEffects": false
}
