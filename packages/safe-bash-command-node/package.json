{
  "name": "safe-bash-command-node",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "node ../../scripts/guard-package-dist.mjs && tsc",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "lint": "eslint src && npm run typecheck",
    "test": "node --import tsx --test src/*.test.ts",
    "test:unit": "node --import tsx --test src/*.test.ts",
    "test:integration": "node --import tsx --test src/*.integration.ts"
  },
  "dependencies": {
    "quickjs-emscripten": "0.31.0"
  },
  "devDependencies": {
    "@poe-code/safe-fs": "*",
    "safe-bash-contracts": "*"
  },
  "poeCode": {
    "packageLint": {
      "sourceExclude": [
        "src/shell.integration.ts"
      ]
    }
  }
}
