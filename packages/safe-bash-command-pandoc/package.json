{
  "poeCode": {
    "bundle": {
      "prebuilt": true
    }
  },
  "type": "module",
  "devDependencies": {
    "safe-bash-contracts": "*",
    "@poe-code/safe-fs": "*",
    "@poe-code/compression": "*"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "name": "safe-bash-command-pandoc",
  "main": "dist/index.js",
  "scripts": {
    "build": "node ../../scripts/guard-package-dist.mjs && tsc && node scripts/bundle.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json && npm run typecheck:public",
    "lint": "eslint src conformance stress scripts && npm run typecheck",
    "test": "cd ../.. && vitest run packages/safe-bash-command-pandoc",
    "test:unit": "cd ../.. && vitest run packages/safe-bash-command-pandoc",
    "test:stress": "cd ../.. && vitest run --config packages/safe-bash-command-pandoc/stress/vitest.config.mjs",
    "pretest:conformance": "cd ../.. && npm run build:workspaces -- --workspace=safe-bash-command-pandoc",
    "test:conformance": "node conformance/commonmark.mjs",
    "pretest:conformance:rst": "cd ../.. && npm run build:workspaces -- --workspace=safe-bash-command-pandoc",
    "test:conformance:rst": "node conformance/rst.mjs",
    "typecheck:public": "tsc -p tsconfig.public-types.json",
    "pretest:unit": "npm run typecheck:public"
  },
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "workerd": "./dist/index.js",
      "browser": "./dist/index.js",
      "import": "./dist/index.js"
    },
    "./lua-filters": {
      "types": "./dist/lua-filters.d.ts",
      "workerd": "./dist/lua-filters.js",
      "browser": "./dist/lua-filters.js",
      "import": "./dist/lua-filters.js"
    },
    "./citeproc-filters": {
      "types": "./dist/citeproc-filters.d.ts",
      "workerd": "./dist/citeproc-filters.js",
      "browser": "./dist/citeproc-filters.js",
      "import": "./dist/citeproc-filters.js"
    },
    "./command": {
      "types": "./dist/command.d.ts",
      "workerd": "./dist/command.js",
      "browser": "./dist/command.js",
      "import": "./dist/command.js"
    },
    "./options": {
      "types": "./dist/options.d.ts",
      "workerd": "./dist/options.js",
      "browser": "./dist/options.js",
      "import": "./dist/options.js"
    }
  },
  "dependencies": {
    "entities": "^6.0.1",
    "safe-bash-markdown-engine": "*",
    "@poe-code/pdf-ast": "*",
    "saxes": "6.0.0",
    "@poe-code/office-package": "*",
    "safe-bash-pdf-engine": "0.0.1",
    "jsonc-parser": "^3.3.1",
    "safe-bash-docx-engine": "*",
    "sprintf-js": "^1.1.3",
    "yaml": "2.9.0",
    "parse5": "7.3.0",
    "fengari": "^0.1.5",
    "@poe-code/image-ast": "*",
    "citeproc": "2.4.63",
    "safe-bash-presentation-engine": "*",
    "@poe-code/spreadsheet-engine": "*",
    "@poe-code/spreadsheet-format-xlsx": "*",
    "@poe-code/spreadsheet-ast": "*",
    "@noble/hashes": "2.4.0",
    "safe-bash-io-engine": "*",
    "@poe-code/json-ast": "*",
    "@poe-code/office-xml": "*"
  },
  "private": true,
  "types": "dist/index.d.ts",
  "version": "0.0.1",
  "sideEffects": false
}
