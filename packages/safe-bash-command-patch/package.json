{
  "name": "safe-bash-command-patch",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    "./index": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./patch-envelope": {
      "types": "./dist/patch-envelope.d.ts",
      "import": "./dist/patch-envelope.js"
    },
    "./patch-formats": {
      "types": "./dist/patch-formats.d.ts",
      "import": "./dist/patch-formats.js"
    },
    "./patch-gnu-paths": {
      "types": "./dist/patch-gnu-paths.d.ts",
      "import": "./dist/patch-gnu-paths.js"
    },
    "./patch-gnu-reject": {
      "types": "./dist/patch-gnu-reject.d.ts",
      "import": "./dist/patch-gnu-reject.js"
    },
    "./patch-path": {
      "types": "./dist/patch-path.d.ts",
      "import": "./dist/patch-path.js"
    },
    "./patch-publication": {
      "types": "./dist/patch-publication.d.ts",
      "import": "./dist/patch-publication.js"
    },
    "./patch": {
      "types": "./dist/patch.d.ts",
      "import": "./dist/patch.js"
    },
    "./sync": {
      "types": "./dist/sync.d.ts",
      "import": "./dist/sync.js"
    },
    "./unified": {
      "types": "./dist/unified.d.ts",
      "import": "./dist/unified.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "node ../../scripts/guard-package-dist.mjs && tsc",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "lint": "eslint src && npm run typecheck",
    "test": "node --import tsx --test src/*.test.ts",
    "test:unit": "node --import tsx --test src/*.test.ts"
  },
  "dependencies": {},
  "devDependencies": {
    "safe-bash-contracts": "*",
    "@poe-code/safe-fs": "*",
    "safe-bash-diff-engine": "*",
    "safe-bash-io-engine": "*"
  }
}
