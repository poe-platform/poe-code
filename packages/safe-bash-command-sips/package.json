{
  "name": "safe-bash-command-sips",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "node ../../scripts/guard-package-dist.mjs && tsc && esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --external:safe-bash-contracts --external:safe-bash-contracts/* --outfile=dist/index.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "lint": "eslint src && npm run typecheck",
    "test": "cd ../.. && vitest run packages/safe-bash-command-sips",
    "test:unit": "cd ../.. && vitest run packages/safe-bash-command-sips"
  },
  "dependencies": {},
  "devDependencies": {
    "@poe-code/image-ast": "*",
    "safe-bash-contracts": "*"
  }
}
