{
  "name": "safe-bash-command-ssconvert",
  "version": "0.0.1",
  "private": true,
  "license": "GPL-2.0-or-later",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./formats/xlsx": {
      "types": "./dist/formats/xlsx.d.ts",
      "import": "./dist/formats/xlsx.js"
    },
    "./formats/csv": {
      "types": "./dist/formats/csv.d.ts",
      "import": "./dist/formats/csv.js"
    },
    "./formats/ods": {
      "types": "./dist/formats/ods.d.ts",
      "import": "./dist/formats/ods.js"
    },
    "./formats/xls": {
      "types": "./dist/formats/xls.d.ts",
      "import": "./dist/formats/xls.js"
    },
    "./formats/spreadsheetml": {
      "types": "./dist/formats/spreadsheetml.d.ts",
      "import": "./dist/formats/spreadsheetml.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "src/encoding/LGPL-2.1.txt",
    "src/encoding/NOTICE.md",
    "src/encoding/tables.ts",
    "src/encoding/transliteration-tables.ts",
    "src/encoding/target-transliteration-tables.ts",
    "src/encoding/ucs2-transliteration-tables.ts",
    "src/codecs/html-NOTICE.md",
    "src/codecs/legacy-binary-NOTICE.md",
    "src/rendering/print/NOTICE.md",
    "src/rendering/print/font-normalization-NOTICE.md",
    "src/rendering/print/font-normalization.ts",
    "src/rendering/print/font-normalization-data.ts",
    "src/formulas/functions/byte-case-NOTICE.md",
    "src/formulas/functions/byte-case.ts",
    "src/formulas/functions/byte-trim.ts",
    "src/formulas/functions/byte-case-properties.ts",
    "src/formulas/functions/captured-acos-NOTICE.md",
    "src/formulas/functions/captured-acos.ts",
    "src/formulas/functions/captured-acos-profile.ts",
    "src/formulas/functions/captured-pow-NOTICE.md",
    "src/formulas/functions/captured-pow.ts",
    "src/formulas/functions/captured-pow-profile.ts",
    "src/codecs/odf-blowfish-NOTICE.md",
    "src/codecs/odf-blowfish.ts",
    "src/codecs/odf-blowfish-profile.ts",
    "src/rendering/print/harfbuzz",
    "scripts/harfbuzz",
    "src/codecs/glossary-timezones-NOTICE.md",
    "src/codecs/glossary-timezones.ts"
  ],
  "scripts": {
    "build": "node scripts/harfbuzz/verify.mjs && node scripts/generate-providers.mjs && node ../../scripts/guard-package-dist.mjs && tsc && node scripts/bundle.mjs",
    "test:unit": "cd ../.. && vitest run packages/safe-bash-command-ssconvert/src",
    "test": "node --test scripts/harfbuzz/verify.test.mjs && node scripts/harfbuzz/verify.mjs && node scripts/generate-providers.mjs && cd ../.. && vitest run packages/safe-bash-command-ssconvert/src",
    "lint": "node scripts/harfbuzz/verify.mjs && node scripts/generate-providers.mjs && eslint src && tsc --noEmit && tsc -p tsconfig.test.json && tsc -p tsconfig.consumer.json && tsc -p tsconfig.consumer.json --customConditions node --types node"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@noble/ciphers": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@pdf-lib/fontkit": "1.1.1",
    "@poe-code/image-ast": "*",
    "@poe-code/office-package": "*",
    "@poe-code/pdf": "*",
    "@poe-code/safe-fs": "*",
    "htmlparser2": "^10.0.0",
    "pdf-lib": "1.17.1",
    "@poe-code/spreadsheet-ast": "*",
    "@poe-code/spreadsheet-engine": "*",
    "@poe-code/spreadsheet-format-xlsx": "*",
    "@poe-code/spreadsheet-format-csv": "*",
    "@poe-code/spreadsheet-format-ods": "*",
    "@poe-code/spreadsheet-format-xls": "*",
    "@poe-code/spreadsheet-format-spreadsheetml": "*"
  },
  "devDependencies": {
    "safe-bash-contracts": "*",
    "jpeg-js": "0.4.4"
  }
}
