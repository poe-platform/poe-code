{
  "name": "safe-bash-command-xz",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "workerd": "./dist/index.js",
      "browser": "./dist/index.js",
      "import": "./dist/index.js"
    },
    "./options": {
      "types": "./dist/options.d.ts",
      "workerd": "./dist/options.js",
      "browser": "./dist/options.js",
      "import": "./dist/options.js"
    },
    "./xz-list": {
      "types": "./dist/xz-list.d.ts",
      "workerd": "./dist/xz-list.js",
      "browser": "./dist/xz-list.js",
      "import": "./dist/xz-list.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "node ../../scripts/guard-package-dist.mjs && rm -rf dist && tsc",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "lint": "eslint src && npm run typecheck",
    "test": "node --import tsx --test --test-concurrency=1 src/*.test.ts",
    "test:unit": "node --import tsx --test --test-concurrency=1 src/*.test.ts"
  },
  "dependencies": {},
  "devDependencies": {
    "safe-bash-contracts": "*",
    "safe-bash-compression-engine": "*",
    "@poe-code/safe-fs": "*"
  }
}
