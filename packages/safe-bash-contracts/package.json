{
  "name": "safe-bash-contracts",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./command": {
      "types": "./dist/command.d.ts",
      "import": "./dist/command.js"
    },
    "./value": {
      "types": "./dist/value.d.ts",
      "import": "./dist/value.js"
    },
    "./filesystem": {
      "types": "./dist/filesystem.d.ts",
      "import": "./dist/filesystem.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "import": "./dist/errors.js"
    },
    "./io": {
      "types": "./dist/io.d.ts",
      "import": "./dist/io.js"
    },
    "./command-requirements": {
      "types": "./dist/command-requirements.d.ts",
      "import": "./dist/command-requirements.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js"
    },
    "./output": {
      "types": "./dist/output.d.ts",
      "import": "./dist/output.js"
    },
    "./process": {
      "types": "./dist/process.d.ts",
      "import": "./dist/process.js"
    },
    "./public-diagnostic": {
      "types": "./dist/public-diagnostic.d.ts",
      "import": "./dist/public-diagnostic.js"
    },
    "./yield": {
      "types": "./dist/yield.d.ts",
      "import": "./dist/yield.js"
    },
    "./filesystem-output-budget": {
      "types": "./dist/filesystem-output-budget.d.ts",
      "import": "./dist/filesystem-output-budget.js"
    },
    "./diagnostics": {
      "types": "./dist/diagnostics.d.ts",
      "import": "./dist/diagnostics.js"
    },
    "./escaping": {
      "types": "./dist/escaping.d.ts",
      "import": "./dist/escaping.js"
    },
    "./path": {
      "types": "./dist/path.d.ts",
      "import": "./dist/path.js"
    },
    "./filesystem-identity": {
      "types": "./dist/filesystem-identity.d.ts",
      "import": "./dist/filesystem-identity.js"
    },
    "./bytes": {
      "types": "./dist/bytes.d.ts",
      "import": "./dist/bytes.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "node ../../scripts/guard-package-dist.mjs && tsc",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "lint": "eslint src && npm run typecheck",
    "test:unit": "node --import tsx --test src/*.test.ts",
    "test": "node --import tsx --test src/*.test.ts"
  },
  "dependencies": {
    "@poe-code/safe-fs": "*"
  }
}
