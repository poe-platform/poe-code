{
  "name": "safe-bash-docx-engine",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./pandoc-adapter": {
      "types": "./dist/pandoc-adapter.d.ts",
      "import": "./dist/pandoc-adapter.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "THIRD_PARTY_NOTICES.txt"
  ],
  "scripts": {
    "build": "node ../../scripts/guard-package-dist.mjs && tsc",
    "test": "cd ../.. && vitest run packages/safe-bash-docx-engine",
    "test:unit": "cd ../.. && vitest run packages/safe-bash-docx-engine",
    "test:schemas": "cd ../.. && vitest run --config packages/safe-bash-docx-engine/vitest.schema.config.ts",
    "lint": "eslint src tests && tsc --noEmit && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@poe-code/office-package": "*",
    "@poe-code/safe-fs": "*",
    "@poe-code/terminal-text": "*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/poe-platform/poe-code.git",
    "directory": "packages/safe-bash-docx-engine"
  },
  "devDependencies": {
    "memfs": "4.56.10"
  },
  "poeCode": {
    "build": {
      "dependencies": {
        "@poe-code/safe-fs": "build:portable"
      }
    }
  }
}
