{
  "name": "safe-bash-graphviz-engine",
  "version": "0.0.1",
  "private": true,
  "description": "Virtual Graphviz commands and bounded rendering",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "workerd": "./dist/index.js",
      "browser": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "node ../../scripts/guard-package-dist.mjs && tsc && esbuild src/index.ts --bundle --platform=browser --conditions=workerd --format=esm --target=es2022 --packages=external --outfile=dist/index.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "lint": "eslint src && npm run typecheck",
    "test": "cd ../.. && vitest run packages/safe-bash-graphviz-engine",
    "test:unit": "cd ../.. && vitest run packages/safe-bash-graphviz-engine"
  },
  "dependencies": {},
  "devDependencies": {
    "@poe-code/graphviz-ast": "*",
    "@poe-code/image-ast": "*",
    "safe-bash-contracts": "*",
    "safe-bash-svg-engine": "*"
  },
  "sideEffects": false
}
