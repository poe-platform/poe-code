{
  "name": "safe-bash-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP shell execution through safe-bash with pluggable runtimes and filesystems",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": { "safe-bash-mcp": "dist/cli.js" },
  "files": ["dist", "README.md"],
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "node ../../scripts/guard-package-dist.mjs && tsc -p tsconfig.json && node ../../scripts/set-bin-executable.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "cd ../.. && vitest run packages/safe-bash-mcp/src",
    "test:unit": "cd ../.. && vitest run packages/safe-bash-mcp/src"
  },
  "dependencies": {
    "tiny-stdio-mcp-server": "^0.1.0"
  },
  "devDependencies": {
    "@poe-code/safe-fs": "*",
    "poe-code": "file:../..",
    "virtual-bash": "*"
  },
  "peerDependencies": {
    "poe-code": ">=13.0.0"
  }
}
