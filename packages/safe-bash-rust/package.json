{
  "name": "@poe-code/safe-bash-rust",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Zero-dependency Rust and WebAssembly @poe-platform/safe-bash runtime with poe-agent-rust integration",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "workerd": {
        "types": "./dist/index.d.ts",
        "default": "./dist/workerd.js"
      },
      "browser": {
        "types": "./dist/browser.d.ts",
        "default": "./dist/browser.js"
      },
      "types": "./dist/index.d.ts",
      "node": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node ../mcp-protocol-rust/scripts/cargo.mjs build && node scripts/build-wasm.mjs",
    "test": "node ../mcp-protocol-rust/scripts/cargo.mjs test && node --test src/wasm.test.mjs",
    "test:unit": "node ../mcp-protocol-rust/scripts/cargo.mjs test && node --test src/wasm.test.mjs",
    "lint": "cargo clippy --all-targets -- -D warnings",
    "test:workerd": "workerd test tests/workerd/config.capnp",
    "test:browser": "node tests/browser/run.mjs"
  },
  "dependencies": {},
  "peerDependencies": {
    "safe-bash-contracts": "*"
  },
  "peerDependenciesMeta": {
    "safe-bash-contracts": {
      "optional": true
    }
  },
  "devDependencies": {
    "@poe-code/config-mutations-rust": "*",
    "@poe-code/safe-fs": "*",
    "@poe-platform/safe-bash": "*",
    "esbuild": "0.28.1",
    "mcp-protocol-rust": "*",
    "workerd": "1.20260708.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/poe-platform/poe-code.git",
    "directory": "packages/safe-bash-rust"
  },
  "imports": {
    "#wasm-platform": {
      "workerd": "./src/workerd-platform.js",
      "browser": "./src/browser-platform.js",
      "default": "./dist/node-platform.js"
    }
  }
}
