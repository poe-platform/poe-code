      "types": "./dist/zip/lzma.d.ts",
      "import": "./dist/zip/lzma.js"
    },
    "./zip/move": {
      "types": "./dist/zip/move.d.ts",
      "import": "./dist/zip/move.js"
    },
    "./zip/names": {
      "types": "./dist/zip/names.d.ts",
