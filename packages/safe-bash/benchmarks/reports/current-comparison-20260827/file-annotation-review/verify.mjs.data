import assert from 'node:assert/strict';
import { spawnSync } from 'node:child_process';
import { createHash } from 'node:crypto';
import { cpSync, existsSync, lstatSync, mkdirSync, mkdtempSync, readFileSync, readdirSync, realpathSync, rmSync, writeFileSync } from 'node:fs';
import { dirname, join, relative } from 'node:path';
import { pathToFileURL } from 'node:url';

const repository = '/Users/kjopek/Workspace/safe-bash';
const evidence = join(repository, 'benchmarks/reports/current-comparison-20260827/file-annotation-review');
const fixture = 'tests/commands/file/text-bound.test.ts';
const commit = '1a18cb1858f9453f41a20caff0988c578aa9c7e2';
const hash = bytes => createHash('sha256').update(bytes).digest('hex');
const save = (name, bytes) => writeFileSync(join(evidence, name), bytes, { flag: 'wx' });
const json = (name, value) => save(name, `${JSON.stringify(value, null, 2)}\n`);
const calls = [];
const scratch = mkdtempSync('/tmp/safe-bash-file-annotation-review-');
const environment = { PATH: process.env.PATH, HOME: scratch, TMPDIR: join(scratch, 'tmp'), TSX_DISABLE_CACHE: '1', NO_COLOR: '1' };
mkdirSync(environment.TMPDIR);
const run = (name, executable, args, cwd = repository, input) => {
  const result = spawnSync(executable, args, { cwd, input, env: environment, timeout: 60000, killSignal: 'SIGKILL', maxBuffer: 32 * 1024 * 1024 });
  save(`${name}.stdout.log`, result.stdout ?? '');
  save(`${name}.stderr.log`, result.stderr ?? '');
  const record = { name, executable, args, cwd, status: result.status, signal: result.signal, error: result.error?.message ?? null, stdinSha256: input === undefined ? null : hash(input), stdoutSha256: hash(result.stdout ?? ''), stderrSha256: hash(result.stderr ?? '') };
  calls.push(record);
  assert.equal(result.error, undefined, name);
  assert.equal(result.signal, null, name);
  return { ...record, stdout: result.stdout, stderr: result.stderr };
};
const git = (name, args) => {
  const result = run(name, 'git', args);
  assert.equal(result.status, 0, name);
  return result.stdout;
};
const census = (root, base = root) => readdirSync(root, { withFileTypes: true }).flatMap(entry => {
  const path = join(root, entry.name);
  assert.ok(!entry.isSymbolicLink(), path);
  if (entry.isDirectory()) return census(path, base);
  assert.ok(entry.isFile(), path);
  const bytes = readFileSync(path);
  return [{ path: relative(base, path), bytes: bytes.length, sha256: hash(bytes) }];
}).sort((left, right) => left.path.localeCompare(right.path));
const diagnostics = bytes => [...bytes.toString().matchAll(/^(.+?)\((\d+),(\d+)\): error (TS\d+): (.+)$/gm)].map(match => ({ path: match[1], line: Number(match[2]), column: Number(match[3]), code: match[4], message: match[5] }));
const applyPatch = (name, patch) => {
  save(`${name}.patch.data`, patch);
  assert.equal(run(name, 'apply_patch', [], repository, patch).status, 0, name);
};
let completed = false;
try {
  const parent = git('parent', ['rev-parse', `${commit}^`]).toString().trim();
  const initialHead = git('initial-head', ['rev-parse', 'HEAD']).toString().trim();
  git('initial-status', ['status', '--short']);
  git('initial-index', ['diff', '--cached', '--raw']);
  git('commit-metadata', ['show', '--no-patch', '--format=fuller', commit]);
  assert.equal(git('changed-paths', ['diff', '--name-only', parent, commit]).toString(), `${fixture}\n`);
  git('exact-delta', ['diff', parent, commit, '--', fixture]);
  const before = git('parent-fixture', ['show', `${parent}:${fixture}`]);
  const after = git('commit-fixture', ['show', `${commit}:${fixture}`]);
  const initialWorkingFixture = readFileSync(join(repository, fixture));
  assert.equal((before.toString().match(/this: TextEncoder/g) ?? []).length, 3);
  const expected = before.toString().replace('import test from "node:test";\n', 'import test from "node:test";\nimport type { TextEncoder as NodeTextEncoder } from "node:util";\n').replaceAll('this: TextEncoder', 'this: NodeTextEncoder');
  assert.equal(after.toString(), expected);
  const receipt = readFileSync('/tmp/safe-bash-file-types-mkV0z0/SUMMARY.json');
  save('author-summary.json', receipt);
  const author = JSON.parse(receipt);
  const authorBefore = readFileSync('/tmp/safe-bash-file-types-mkV0z0/before.fixture.data');
  const authorAfter = readFileSync('/tmp/safe-bash-file-types-mkV0z0/after.fixture.data');
  assert.ok(before.equals(authorBefore));
  assert.ok(after.equals(authorAfter));
  const toolSource = realpathSync(join(repository, 'node_modules'));
  cpSync(toolSource, join(scratch, 'node_modules'), { recursive: true, dereference: true, preserveTimestamps: true, filter: source => {
    const actual = realpathSync(source);
    assert.ok(actual === toolSource || actual.startsWith(`${toolSource}/`), actual);
    return true;
  } });
  const toolInventory = census(join(scratch, 'node_modules'));
  json('tools.json', toolInventory);
  const typescript = (await import(pathToFileURL(join(scratch, 'node_modules/typescript/lib/typescript.js')).href)).default;
  const compiler = join(scratch, 'node_modules/typescript/bin/tsc');
  const roots = {};
  const results = {};
  const emitted = {};
  for (const [label, revision, bytes] of [['before', parent, before], ['after', commit, after]]) {
    const root = join(scratch, label);
    roots[label] = root;
    mkdirSync(root);
    const archive = git(`${label}-archive`, ['archive', revision, '--', 'src', fixture, 'tests/commands/file/helpers.ts', 'package.json', 'package-lock.json', 'tsconfig.json']);
    assert.equal(run(`${label}-extract`, 'tar', ['-x', '-C', root], repository, archive).status, 0);
    const inventory = census(root);
    json(`${label}-inputs.json`, inventory);
    assert.ok(readFileSync(join(root, fixture)).equals(bytes));
    const lock = JSON.parse(readFileSync(join(root, 'package-lock.json')));
    const versions = {};
    for (const name of ['typescript', 'tsx', '@types/node']) {
      const version = JSON.parse(readFileSync(join(scratch, 'node_modules', name, 'package.json'))).version;
      assert.equal(version, lock.packages[`node_modules/${name}`].version);
      versions[name] = version;
    }
    const config = JSON.stringify({ extends: './tsconfig.json', files: [fixture], include: [], exclude: [] }, null, 2);
    applyPatch(`${label}-scoped-config`, `*** Begin Patch\n*** Add File: ${root}/tsconfig.scoped.json\n${config.split('\n').map(line => `+${line}`).join('\n')}\n*** End Patch\n`);
    const typed = run(`${label}-types`, process.execPath, [compiler, '--noEmit', '-p', 'tsconfig.scoped.json', '--pretty', 'false'], root);
    const errors = diagnostics(typed.stdout);
    assert.equal(typed.status, label === 'before' ? 2 : 0);
    assert.deepEqual(errors.map(error => error.code), label === 'before' ? ['TS2749', 'TS2749', 'TS2749'] : []);
    assert.ok(errors.every(error => error.path === fixture));
    const runtime = run(`${label}-tests`, process.execPath, ['--import', 'tsx', '--test', fixture], root);
    const counts = Object.fromEntries([...runtime.stdout.toString().matchAll(/^# (tests|pass|fail|cancelled|skipped|todo) (\d+)$/gm)].map(match => [match[1], Number(match[2])]));
    assert.equal(runtime.status, 0);
    assert.deepEqual(counts, { tests: 17, pass: 17, fail: 0, cancelled: 0, skipped: 0, todo: 0 });
    const options = typescript.convertCompilerOptionsFromJson(JSON.parse(readFileSync(join(root, 'tsconfig.json'))).compilerOptions, root);
    assert.deepEqual(options.errors, []);
    const output = typescript.transpileModule(bytes.toString(), { fileName: fixture, compilerOptions: options.options, reportDiagnostics: true });
    assert.deepEqual(output.diagnostics, []);
    emitted[label] = Buffer.from(output.outputText);
    save(`${label}.emitted.js.data`, emitted[label]);
    for (const entry of inventory) assert.equal(hash(readFileSync(join(root, entry.path))), entry.sha256);
    results[label] = { revision, archiveSha256: hash(archive), fixtureSha256: hash(bytes), fixtureBytes: bytes.length, versions, typeStatus: typed.status, diagnostics: errors, tests: counts, emittedBytes: emitted[label].length, emittedSha256: hash(emitted[label]), compilerOptions: options.options };
  }
  assert.ok(emitted.before.equals(emitted.after));
  assert.equal(emitted.before.length, 12453);
  assert.equal(hash(emitted.before), 'bfcd49d6bcfc3a7d57dc76dcba07a6b224f9d9001b6c8adca71ca8c8500b5ff2');
  const negativeRoot = join(scratch, 'negative');
  cpSync(roots.after, negativeRoot, { recursive: true });
  assert.ok(lstatSync(join(negativeRoot, fixture)).isFile());
  const patch = `*** Begin Patch\n*** Update File: ${negativeRoot}/${fixture}\n@@\n   assert.equal(result.stderr, \`file: unsupported option '\${option}'\\n\`);\n });\n+\n+new TextEncoder().encode(42);\n*** End Patch\n`;
  applyPatch('negative-injection', patch);
  const negativeBytes = readFileSync(join(negativeRoot, fixture));
  assert.equal(negativeBytes.toString(), `${after.toString()}\nnew TextEncoder().encode(42);\n`);
  save('negative.fixture.ts.data', negativeBytes);
  const negative = run('negative-types', process.execPath, [compiler, '--noEmit', '-p', 'tsconfig.scoped.json', '--pretty', 'false'], negativeRoot);
  const negativeErrors = diagnostics(negative.stdout);
  assert.equal(negative.status, 2);
  assert.deepEqual(negativeErrors.map(error => error.code), ['TS2345']);
  assert.equal(negativeErrors[0].path, fixture);
  assert.match(negativeErrors[0].message, /number.*string/);
  assert.ok(readFileSync(join(roots.after, fixture)).equals(after));
  assert.ok(readFileSync(join(repository, fixture)).equals(initialWorkingFixture));
  assert.deepEqual(census(join(scratch, 'node_modules')), toolInventory);
  const finalHead = git('final-head', ['rev-parse', 'HEAD']).toString().trim();
  git('final-status', ['status', '--short']);
  git('final-index', ['diff', '--cached', '--raw']);
  json('SUMMARY.json', { commit, parent, initialHead, finalHead, scratch, node: process.version, platform: process.platform, arch: process.arch, environment, results, onlyTypeChanges: true, exactDelta: 'One new aliased type-only import; three existing callback this annotations changed; all remaining source bytes untouched.', runtimeJavaScriptByteIdentical: true, negative: { status: negative.status, diagnostics: negativeErrors, fixtureSha256: hash(negativeBytes), regularCopy: true }, workingFixtureSha256: hash(initialWorkingFixture), workingFixtureEqualsCommit: initialWorkingFixture.equals(after), workingFixtureUnchanged: true, authorReceipt: { revision: author.revision, sha256: hash(receipt), beforeFixtureMatchesExactParent: before.equals(authorBefore), afterFixtureMatchesExactCommit: after.equals(authorAfter) }, importBinding: 'Both variants have exact git-archived src/** plus tests/commands/file/helpers.ts, original relative imports and package.json/tsconfig.json/lock. No import rewrites; shared parent node_modules is a regular dereferenced copy of existing locked tools. Negative is a separate regular copy of after. No repository source, config, tests or dependencies are written.' });
  completed = true;
} finally {
  json('commands.json', calls);
  assert.equal(dirname(scratch), '/tmp');
  assert.ok(scratch.startsWith('/tmp/safe-bash-file-annotation-review-'));
  rmSync(scratch, { recursive: true, force: true });
  json('CLEANUP.json', { completed, removedScratch: scratch, scratchAbsent: !existsSync(scratch), ownedChildren: 'All subprocesses synchronous, settled, recorded with status/signal/error. No background workers or watchers launched.', finishedAt: new Date().toISOString() });
}
