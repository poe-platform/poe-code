{
  "name": "virtual-bash",
  "version": "0.0.0",
  "private": true,
  "description": "Extensible virtual shell with pluggable filesystems and streaming commands",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": {
        "workerd": "./dist/core.d.ts",
        "browser": "./dist/core.d.ts",
        "default": "./dist/index.d.ts"
      },
      "workerd": "./dist/core.browser.js",
      "browser": "./dist/core.browser.js",
      "import": "./dist/index.js"
    },
    "./contracts": {
      "types": {
        "browser": "./dist/contracts/index.d.ts",
        "default": "./dist/contracts/node.d.ts"
      },
      "browser": "./dist/contracts/index.js",
      "import": "./dist/contracts/node.js"
    },
    "./contracts/index": {
      "types": {
        "browser": "./dist/contracts/index.d.ts",
        "default": "./dist/contracts/node.d.ts"
      },
      "browser": "./dist/contracts/index.js",
      "import": "./dist/contracts/node.js"
    },
    "./contracts/path": {
      "types": {
        "browser": "./dist/contracts/path.d.ts",
        "default": "./dist/contracts/node-path.d.ts"
      },
      "browser": "./dist/contracts/path.js",
      "import": "./dist/contracts/node-path.js"
    },
    "./contracts/*": {
      "types": "./dist/contracts/*.d.ts",
      "import": "./dist/contracts/*.js"
    },
    "./commands/network": {
      "types": {
        "workerd": "./dist/commands/network/public.d.ts",
        "browser": "./dist/commands/network/public.d.ts",
        "default": "./dist/commands/network/index.d.ts"
      },
      "workerd": "./dist/commands/network/index.browser.js",
      "browser": "./dist/commands/network/index.browser.js",
      "import": "./dist/commands/network/index.js"
    },
    "./commands/node": {
      "types": "./dist/commands/node/index.d.ts",
      "import": "./dist/commands/node/index.js"
    },
    "./commands/metadata": {
      "types": "./dist/commands/metadata/index.d.ts",
      "import": "./dist/commands/metadata/index.js"
    },
    "./commands/archive": {
      "types": "./dist/commands/archive/index.d.ts",
      "import": "./dist/commands/archive/index.js"
    },
    "./commands/table-text": {
      "types": "./dist/commands/table-text/index.d.ts",
      "import": "./dist/commands/table-text/index.js"
    },
    "./commands/stream-inspection": {
      "types": "./dist/commands/stream-inspection/index.d.ts",
      "import": "./dist/commands/stream-inspection/index.js"
    },
    "./commands/stream-format": {
      "types": "./dist/commands/stream-format/index.d.ts",
      "import": "./dist/commands/stream-format/index.js"
    },
    "./commands/split": {
      "types": "./dist/commands/split/index.d.ts",
      "import": "./dist/commands/split/index.js"
    },
    "./commands/csplit": {
      "types": "./dist/commands/csplit/index.d.ts",
      "workerd": "./dist/commands/csplit/index.browser.js",
      "browser": "./dist/commands/csplit/index.browser.js",
      "import": "./dist/commands/csplit/index.js"
    },
    "./commands/pr": {
      "types": "./dist/commands/pr/index.d.ts",
      "workerd": "./dist/commands/pr/index.browser.js",
      "browser": "./dist/commands/pr/index.browser.js",
      "import": "./dist/commands/pr/index.js"
    },
    "./commands/tsort": {
      "types": "./dist/commands/tsort/index.d.ts",
      "workerd": "./dist/commands/tsort/index.browser.js",
      "browser": "./dist/commands/tsort/index.browser.js",
      "import": "./dist/commands/tsort/index.js"
    },
    "./commands/factor": {
      "types": "./dist/commands/factor/index.d.ts",
      "workerd": "./dist/commands/factor/index.browser.js",
      "browser": "./dist/commands/factor/index.browser.js",
      "import": "./dist/commands/factor/index.js"
    },
    "./commands/getopt": {
      "types": "./dist/commands/getopt/index.d.ts",
      "workerd": "./dist/commands/getopt/index.browser.js",
      "browser": "./dist/commands/getopt/index.browser.js",
      "import": "./dist/commands/getopt/index.js"
    },
    "./commands/hexdump": {
      "types": "./dist/commands/hexdump/index.d.ts",
      "workerd": "./dist/commands/hexdump/index.browser.js",
      "browser": "./dist/commands/hexdump/index.browser.js",
      "import": "./dist/commands/hexdump/index.js"
    },
    "./commands/time-env": {
      "types": "./dist/commands/time-env/index.d.ts",
      "import": "./dist/commands/time-env/index.js"
    },
    "./commands/tree": {
      "types": "./dist/commands/tree/index.d.ts",
      "import": "./dist/commands/tree/index.js"
    },
    "./commands/file": {
      "types": "./dist/commands/file/index.d.ts",
      "import": "./dist/commands/file/index.js"
    },
    "./commands/grep-aliases": {
      "types": "./dist/commands/grep-aliases/index.d.ts",
      "import": "./dist/commands/grep-aliases/index.js"
    },
    "./commands/column": {
      "types": "./dist/commands/column/index.d.ts",
      "import": "./dist/commands/column/index.js"
    },
    "./commands/html-to-markdown": {
      "types": "./dist/commands/html-to-markdown/index.d.ts",
      "import": "./dist/commands/html-to-markdown/index.js"
    },
    "./commands/du": {
      "types": "./dist/commands/du/index.d.ts",
      "import": "./dist/commands/du/index.js"
    },
    "./commands/expr": {
      "types": "./dist/commands/expr/index.d.ts",
      "import": "./dist/commands/expr/index.js"
    },
    "./commands/timeout": {
      "types": "./dist/commands/timeout/index.d.ts",
      "import": "./dist/commands/timeout/index.js"
    },
    "./commands/apply-patch": {
      "types": "./dist/commands/apply-patch/index.d.ts",
      "import": "./dist/commands/apply-patch/index.js"
    },
    "./commands/which": {
      "types": "./dist/commands/which/index.d.ts",
      "import": "./dist/commands/which/index.js"
    },
    "./commands/xml": {
      "types": "./dist/commands/xml/index.d.ts",
      "workerd": "./dist/commands/xml/index.browser.js",
      "browser": "./dist/commands/xml/index.browser.js",
      "import": "./dist/commands/xml/index.js"
    },
    "./commands/yq": {
      "types": "./dist/commands/yq/index.d.ts",
      "workerd": "./dist/commands/yq/index.browser.js",
      "browser": "./dist/commands/yq/index.browser.js",
      "import": "./dist/commands/yq/index.js"
    },
    "./fs/s3": {
      "types": "./dist/fs/s3/index.d.ts",
      "import": "./dist/fs/s3/index.js"
    },
    "./fs/s3/http": {
      "types": "./dist/fs/s3/http/index.d.ts",
      "import": "./dist/fs/s3/http/index.js"
    },
    "./fs/webdav": {
      "types": "./dist/fs/webdav/index.d.ts",
      "import": "./dist/fs/webdav/index.js"
    },
    "./fs/readonly": {
      "types": "./dist/fs/readonly/index.d.ts",
      "import": "./dist/fs/readonly/index.js"
    },
    "./fs/mount": {
      "types": "./dist/fs/mount/index.d.ts",
      "import": "./dist/fs/mount/index.js"
    },
    "./fs/overlay": {
      "types": "./dist/fs/overlay/index.d.ts",
      "import": "./dist/fs/overlay/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "browser": null,
      "import": "./dist/node.js"
    },
    "./commands/node/host": {
      "types": {
        "workerd": "./dist/node-unavailable.d.ts",
        "worker": "./dist/node-unavailable.d.ts",
        "browser": "./dist/node-unavailable.d.ts",
        "default": "./dist/commands/node/worker-provider.d.ts"
      },
      "workerd": null,
      "worker": null,
      "browser": null,
      "import": "./dist/commands/node/worker-provider.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "benchmark": "node --import tsx benchmarks/run.ts",
    "build": "node ../../scripts/guard-package-dist.mjs && node scripts/integration-inputs.mjs && node scripts/build.mjs",
    "typecheck": "node scripts/typecheck.mjs",
    "typecheck:all": "node scripts/typecheck.mjs --build",
    "typecheck:consumers": "node scripts/typecheck.mjs --consumers",
    "test": "node scripts/test.mjs",
    "test:contracts": "node --import tsx --test \"tests/contracts/**/*.test.ts\"",
    "verify:stream-public": "node tests/plugins/stream-five-public/verify-public.mjs",
    "verify:release:whole": "node scripts/verify-whole-gate.mjs",
    "test:runner": "node scripts/test-reporting.mjs scripts/integration-inputs.test.mjs scripts/build.test.mjs scripts/test-reporting.test.mjs scripts/historical-type-models.test.mjs",
    "test:unit": "npm run test:runner && node scripts/test.mjs"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "pako": "3.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "memfs": "4.56.10",
    "poe-code": "file:../..",
    "tsx": "^4.23.12",
    "typescript": "5.9",
    "@poe-code/safe-fs": "*"
  },
  "poeCode": {
    "packageLint": {
      "sourceExclude": [
        "src/commands/xan/argv.ts",
        "src/commands/xan/budget.ts",
        "src/commands/xan/commands.ts",
        "src/commands/xan/csv.ts",
        "src/commands/xan/index.ts",
        "src/commands/xan/io.ts",
        "src/commands/xan/options.ts",
        "src/commands/xan/selector.ts",
        "src/commands/xan/sort.ts",
        "src/commands/xan/writer.ts"
      ]
    },
    "integration": {
      "peerProfile": "checkout-root",
      "standalonePeer": {
        "range": ">=13.0.0",
        "developmentVersion": "13.0.0"
      }
    }
  },
  "peerDependencies": {
    "poe-code": ">=13.0.0"
  }
}
