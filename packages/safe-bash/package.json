  "scripts": {
    "benchmark": "node --import tsx benchmarks/run.ts",
    "build": "node ../../scripts/guard-package-dist.mjs && node scripts/integration-inputs.mjs && node scripts/build.mjs && node scripts/copy-compression-assets.mjs",
    "build:optional": "node ../../scripts/guard-package-dist.mjs && tsc -p tsconfig.optional.json",
    "typecheck": "node scripts/typecheck.mjs",
    "typecheck:all": "node scripts/typecheck.mjs --build",
    "typecheck:consumers": "node scripts/typecheck.mjs --consumers",
    "test": "node scripts/test.mjs",
    "test:contracts": "node --import tsx --test \"tests/contracts/**/*.test.ts\"",
    "verify:stream-public": "node tests/plugins/stream-five-public/verify-public.mjs",
    "verify:release:whole": "node scripts/verify-whole-gate.mjs",
    "test:runner": "node scripts/test-reporting.mjs scripts/integration-inputs.test.mjs scripts/build.test.mjs scripts/copy-compression-assets.test.mjs scripts/test-reporting.test.mjs scripts/historical-type-models.test.mjs",
    "test:unit": "npm run test:runner && node scripts/test.mjs",
    "provision:python:integration": "npm --prefix tests/integration/pyodide-runtime ci && npm --prefix tests/integration/pyodide-runtime run provision:public",
    "test:python:integration": "npm --prefix tests/integration/pyodide-runtime run test:public",
    "postbuild": "node scripts/build-optional-cli.mjs"
  },
