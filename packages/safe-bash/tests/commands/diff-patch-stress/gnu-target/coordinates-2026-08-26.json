  "records": [
    {
      "name": "normal-inconsistent-new-coordinates",
      "files": {
        "target": "old\nkeep\nend\n"
      },
      "input": "1c2\n< old\n---\n> new\n",
      "args": [
        "--batch",
        "--fuzz=0",
        "--no-backup-if-mismatch",
        "target"
      ],
      "result": {
        "exitCode": 0,
        "stdout": "patching file target\n",
        "stderr": "",
        "files": {
          "target": "new\nkeep\nend\n"
        }
      }
    },
    {
      "name": "inconsistent-second-hunk",
      "files": {
        "first": "keep\n",
        "target": "old\nmiddle\ntail\n"
      },
      "input": "--- first\n+++ first\n@@ -1 +1 @@\n-keep\n+changed\n--- target\n+++ target\n@@ -1 +1 @@\n-old\n+new\n@@ -3 +4 @@\n-tail\n+end\n",
      "args": [
        "--batch",
        "--fuzz=0",
        "--no-backup-if-mismatch",
        "-p0"
      ],
      "result": {
        "exitCode": 0,
        "stdout": "patching file first\npatching file target\n",
        "stderr": "",
        "files": {
          "first": "changed\n",
          "target": "new\nmiddle\nend\n"
        }
      }
    }
