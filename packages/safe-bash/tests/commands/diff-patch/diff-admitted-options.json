{
  "oracle": "GNU diffutils 3.10, Linux, LC_ALL=C, TZ=UTC; both operands are pipes; fixed labels LEFT/RIGHT",
  "fixtures": [
    {
      "args": [
        "-i"
      ],
      "old": "A\n",
      "next": "a\n",
      "expected": {
        "exitCode": 0,
        "stdout": "",
        "stderr": ""
      }
    },
    {
      "args": [
        "--ignore-case",
        "-u"
      ],
      "old": "A\nold\n",
      "next": "a\nnew\n",
      "expected": {
        "exitCode": 1,
        "stdout": "--- LEFT\n+++ RIGHT\n@@ -1,2 +1,2 @@\n A\n-old\n+new\n",
        "stderr": ""
      }
    },
    {
      "args": [
        "-i"
      ],
      "old": "Ä\n",
      "next": "ä\n",
      "expected": {
        "exitCode": 1,
        "stdout": "1c1\n< Ä\n---\n> ä\n",
        "stderr": ""
      }
    },
    {
      "args": [
        "-i"
      ],
      "old": "A",
      "next": "a\n",
      "expected": {
        "exitCode": 1,
        "stdout": "1c1\n< A\n\\ No newline at end of file\n---\n> a\n",
        "stderr": ""
      }
    },
    {
      "args": [
        "-y"
      ],
      "old": "A\n",
      "next": "a\n",
      "expected": {
        "exitCode": 1,
        "stdout": "A\t\t\t\t\t\t\t      |\ta\n",
        "stderr": ""
      }
    },
    {
      "args": [
        "-y",
        "-W30"
      ],
      "old": "same\nleft\ngone\nend\n",
      "next": "same\nright\nend\nnew\n",
      "expected": {
        "exitCode": 1,
        "stdout": "same\t\tsame\nleft\t      |\tright\ngone\t      <\nend\t\tend\n\t      >\tnew\n",
        "stderr": ""
      }
    },
    {
      "args": [
        "-yi",
        "--width=30"
      ],
      "old": "A\n",
      "next": "a\n",
      "expected": {
        "exitCode": 0,
        "stdout": "A\t\ta\n",
        "stderr": ""
      }
    },
    {
      "args": [
        "--side-by-side",
        "-W",
        "20",
        "--suppress-common-lines"
      ],
      "old": "same\nleft\n",
      "next": "same\nright\n",
      "expected": {
        "exitCode": 1,
        "stdout": "left  |\tright\n",
        "stderr": ""
      }
    },
    {
      "args": [
        "-y",
        "-W20",
        "--left-column"
      ],
      "old": "same\n",
      "next": "same\n",
      "expected": {
        "exitCode": 0,
        "stdout": "same  (\n",
        "stderr": ""
      }
    },
    {
      "args": [
        "-y",
        "-W20"
      ],
      "old": "012345678901234\n\tX\n",
      "next": "short\n    X\n",
      "expected": {
        "exitCode": 1,
        "stdout": "01234 |\tshort\n      |\t    X\n",
        "stderr": ""
      }
    },
    {
      "args": [
        "-y",
        "-W20",
        "-t"
      ],
      "old": "\tX\nold",
      "next": "\tY\nnew\n",
      "expected": {
        "exitCode": 1,
