  const { exprMatchCeilings } = await import('./node_modules/virtual-bash/dist/commands/regex-execution/protocol.js');
  const owner = new RegexExecutor({ maxWorkers: 1, startupTimeoutMs: 500, requestTimeoutMs: 500 });
  const descriptor: ExprMatchDescriptor = { kind: 'expr-match', pattern: new TextEncoder().encode('a'), profile: 'byte', limits: exprMatchCeilings };
  const legacy: GrepDescriptor = { kind: 'grep', patterns: ['a'], fixed: true, extended: false, insensitive: false, whole: false, word: false };
  const rows = [{ bytes: new TextEncoder().encode('a'), all: false, terminated: false }];
  try {
