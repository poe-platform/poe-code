      const { createExprCommand } = await import('./node_modules/virtual-bash/dist/commands/expr/index.js');
      const { MemoryFileSystem } = await import('./node_modules/virtual-bash/dist/fs/memory/index.js');
      const controller = new AbortController();
      const reason = new Error('independent index cancellation');
      const cleanups: InvocationCleanup[] = [];
      const stdout: Uint8Array[] = [], stderr: Uint8Array[] = [];
      let turns = 0, finished = false;
      let scheduled: NodeJS.Immediate | undefined;
      const cancel = (): void => {
        if (finished) return;
        turns++;
        if (turns === 8) controller.abort(reason);
        else scheduled = setImmediate(cancel);
      };
      const args = ['index', payload.positive ? `${'a'.repeat(2047)}z` : 'a'.repeat(2048), payload.positive ? `${'b'.repeat(63)}z` : 'b'.repeat(64)];
      const context: CommandContext = {
        command: 'expr', args, cwd: '/', env: { LC_ALL: 'C' }, fs: new MemoryFileSystem(), signal: controller.signal,
        get stdin(): never { throw new Error('index touched stdin'); }, stdinIsDefault: false,
        stdout: { async write(bytes: Uint8Array): Promise<void> { stdout.push(new Uint8Array(bytes)); } },
        stderr: { async write(bytes: Uint8Array): Promise<void> { stderr.push(new Uint8Array(bytes)); } },
        registerCleanup(cleanup: InvocationCleanup): void { cleanups.push(cleanup); },
      };
      if (payload.cancel) scheduled = setImmediate(cancel);
      const outcome = await settle(() => createExprCommand({ limits: { maxSteps: payload.maxSteps ?? 1_000_000 } }).execute(context));
      finished = true;
      if (scheduled) clearImmediate(scheduled);
      for (const cleanup of cleanups) await cleanup();
      assert.equal(workers.length, 0);
      const output = Buffer.concat(stdout).toString(), diagnostic = Buffer.concat(stderr).toString();
      if (payload.cancel) {
        assert.equal(outcome.state, 'rejected');
        assert(outcome.state === 'rejected' && outcome.reason === reason);
        assert.equal(turns, 8); assert.equal(output, ''); assert.equal(diagnostic, '');
      } else {
        assert.equal(outcome.state, 'fulfilled');
        const expected = payload.positive ? '2048\n' : payload.maxSteps === 399505 ? '' : '0\n';
        assert.equal(output, expected);
        assert.equal(diagnostic, payload.maxSteps === 399505 ? 'expr: evaluation work limit exceeded\n' : '');
        assert.deepEqual(outcome.state === 'fulfilled' && outcome.value, { exitCode: payload.positive ? 0 : payload.maxSteps === 399505 ? 3 : 1 });
      }
