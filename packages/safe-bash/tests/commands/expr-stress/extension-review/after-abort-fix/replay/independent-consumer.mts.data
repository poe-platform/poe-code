class ExplicitSignal extends EventTarget implements AbortSignal {
  aborted = false;
  reason: unknown = undefined;
  onabort: ((this: AbortSignal, event: Event) => unknown) | null = null;
  throwIfAborted(): void { if (this.aborted) throw this.reason; }
