interface Payload { mode: 'synthetic' | 'native-expr' | 'native-legacy' | 'index'; reason?: string; phase?: 'pre' | 'active'; maxSteps?: number; cancel?: boolean; positive?: boolean }
type Outcome = { state: 'fulfilled'; value: unknown } | { state: 'rejected'; reason: unknown };
const settle = async (invoke: () => unknown): Promise<Outcome> => {
  try { return { state: 'fulfilled', value: await invoke() }; }
  catch (reason: unknown) { return { state: 'rejected', reason }; }
};
export async function run(payload: Payload): Promise<unknown> {
  const NativeWorker = threads.Worker;
  const workers: TrackedWorker[] = [];
  const events: { type: string; threadId?: number }[] = [];
