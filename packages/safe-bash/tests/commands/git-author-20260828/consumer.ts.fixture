import { createGitCommand, createGitCommands, gitCommands, type GitCommandsOptions } from 'PACKAGE_LEAF';
const options: GitCommandsOptions = { replace: false, discoveryBoundary: '/repo' };
createGitCommand(options);
createGitCommands(options);
gitCommands(options);
// @ts-expect-error fixed caps have no public override
createGitCommand({ limits: { maxObjectBytes: 1 } });
// @ts-expect-error no ambient host runner injection
gitCommands({ spawn: () => {} });
// @ts-expect-error boundary is text
createGitCommands({ discoveryBoundary: 12 });
// @ts-expect-error replace is boolean
gitCommands({ replace: 'true' });
