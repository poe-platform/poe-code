function acceptEvaluation(label, admitted, result) {
  guard('after-' + label); immutable('after-' + label);
  const loads = auditLoads(label,admitted);
  const output = path.join(scratch,'logs',label,'receipt.json');
  const receiptBytes = readLimited(output,limits.receiptBytesPerChild), receipt = JSON.parse(receiptBytes);
  const rawBytes = readLimited(output+'.raw',limits.receiptBytesPerChild), raw = JSON.parse(rawBytes);
  assert.equal(sha(rawBytes),receipt.rawSha256,'RAW_RECEIPT_BINDING');
  ownRecord(raw.engineOutcome,['settled','thrown','ok','error','stats']);
  delete raw.engineOutcome.stats;
  const normalized = {...receipt}; delete normalized.rawSha256;
  assert.deepEqual(raw,normalized,'RAW_NORMALIZED_RECONCILIATION');
  const terminal = JSON.parse(result.stdout.toString());
  const reconciliation = reconcileReceipt(label,receipt,terminal,result,loads,receiptBytes);
  const observation = {label,classification:receipt.classification,receiptSha256:sha(receiptBytes),rawSha256:sha(rawBytes),counters:receipt.counters,loads,reconciliation};
  evidence.observations.push(observation);
  return observation;
}

try {
  guard('before-materialization');
  if (!fs.existsSync(runsRoot)) fs.mkdirSync(runsRoot, { mode: 0o700 });
  assert.ok(fs.lstatSync(runsRoot).isDirectory()); assert.equal(fs.realpathSync(runsRoot), runsRoot);
  fs.mkdirSync(runRoot, { mode: 0o700 }); fs.mkdirSync(scratch, { mode: 0o700 }); created = true;
  for (const directory of ['logs','tools','home','tmp']) fs.mkdirSync(path.join(scratch,directory), { mode: 0o700 });
  const manifestResult = await child(tools.git.origin, ['--no-replace-objects','-C',repository,'show', executionCommit + ':' + relativeOwn + '/MANIFEST.json'], { role: 'git-read', cwd: repository, timeoutMs: 5000, env: { PATH: '/usr/bin:/bin', LC_ALL: 'C', GIT_OPTIONAL_LOCKS: '0', GIT_NO_LAZY_FETCH: '1', GIT_CONFIG_NOSYSTEM: '1', GIT_CONFIG_GLOBAL: '/dev/null', GIT_TERMINAL_PROMPT: '0' } });
  assert.equal(manifestResult.row.status,0); assert.equal(manifestResult.stderr.length,0); assert.ok(manifestResult.stdout.equals(manifestBytes), 'COMMITTED_MANIFEST_BINDING');
  guard('after-committed-manifest-read');
  const sourceFiles = authenticateArchive();
  copy(tools.node.origin, 'tools/node', tools.node);
  copy(path.join(own,'loader.mjs.data'), 'tools/loader.mjs', manifest.files.find(row => row.path === 'loader.mjs.data'));
  for (const row of tools.compiler.files) copy(row.origin, 'consumer/node_modules/typescript/' + row.relativePath, row);
  write('consumer/package.json', '{"type":"module"}\n');
  for (const row of sources.files) write('consumer/engine/' + row.path, sourceFiles.get(row.path), row.mode);
  for (const [source,destination] of [['child.mjs.data','child.mjs'],['reference-entry.mjs.data','reference-entry.mjs'],['CONTROL.json','CONTROL.json'],['FROZEN-EXPERIMENTS.json','FROZEN-EXPERIMENTS.json']]) copy(path.join(own,source), 'consumer/harness/' + destination, manifest.files.find(row => row.path === source));
  expectedTools = tree(path.join(scratch,'tools')).entries; expectedConsumer = tree(consumer).entries;
  evidence.sourceCopies = 66; evidence.staticRuntimeCandidates = 63; evidence.additionalAuthenticatedSourceOnly = 3;
  guard('ready'); immutable('ready');
  for (const label of control.evaluations) {
    remaining(); guard('before-' + label); immutable('before-' + label);
    fs.mkdirSync(path.join(scratch,'logs',label), { mode: 0o700 });
    const admitted = admit(label);
    const output = path.join(scratch,'logs',label,'receipt.json');
    const env = { PATH: path.join(scratch,'tools'), HOME: path.join(scratch,'home'), TMPDIR: path.join(scratch,'tmp'), LC_ALL: 'C', TZ: 'UTC', NODE_DISABLE_COMPILE_CACHE: '1', C78_SCRATCH: scratch, C78_ADMISSION: admitted.filename, C78_ADMISSION_SHA256: admitted.sha256, C78_CHILD_TOKEN: admitted.value.executionToken, C78_TRACE: path.join(scratch,'logs',label,'loads.jsonl'), C78_CONSUMER: consumer, ABI_CASE: label, ABI_RESULT: output };
    const args = ['--permission','--allow-fs-read=' + scratch,'--allow-fs-write=' + path.dirname(output),'--disallow-code-generation-from-strings','--unhandled-rejections=strict','--import',path.join(scratch,'tools/loader.mjs'),path.join(consumer,'harness/child.mjs')];
    const result = await child(path.join(scratch,'tools/node'),args,{ role:'workflow',label,cwd:consumer,timeoutMs:limits.workflowContainmentMs,env });
    acceptEvaluation(label,admitted,result);
  }
  assert.equal(evidence.observations.length,8); assert.equal(childCount,9);
  evidence.allPass = evidence.observations.every(row => row.classification === 'PASS');
} catch (error) { primaryFailure = { present: true, reason: error }; evidence.safetyStops.push(errorData(error)); evidence.allPass = false; integrity = false; }
finally {
  try { await retireActiveChild(primaryFailure?.present ? primaryFailure.reason : new Error('OUTER_RETIREMENT')); }
  catch (error) { evidence.safetyStops.push(errorData(error)); evidence.allPass = false; integrity = false; }
  if (created) {
    try {
      assert.ok(!activeChild, 'ACTIVE_CHILD_RETAIN_SCRATCH');
      guard('before-archive'); immutable('before-archive');
      const logs = tree(path.join(scratch,'logs'),128,limits.totalEvidenceBytes);
      const payloads = {};
      for (const [relative,row] of Object.entries(logs.entries)) if (row.kind === 'file') payloads[relative] = fs.readFileSync(path.join(scratch,'logs',relative)).toString('base64');
      evidence.originalBefore = originalBaseline; evidence.originalAfter = lastOriginals;
      evidence.finalScratch = tree(scratch); evidence.integrity = integrity;
      evidence.directChildAttempts = childCount; evidence.spawnedDirectChildren = evidence.children.filter(row => Number.isInteger(row.pid)).length; evidence.totalProcessesIncludingSupervisor = evidence.spawnedDirectChildren + 1;
      evidence.payloads = payloads; evidence.elapsedBeforeArchiveMs = Date.now() - started;
      const raw = Buffer.from(JSON.stringify(evidence)); assert.ok(raw.length <= 67108864);
      const compressed = gzipSync(raw); const encoded = Buffer.from(compressed.toString('base64') + '\n');
      assert.ok(encoded.length <= 67108864);
      const archivePath = path.join(runRoot,'RESULT.json.gz.base64'); fs.writeFileSync(archivePath,encoded,{flag:'wx',mode:0o600});
      assert.equal(sha(readLimited(archivePath,67108864)),sha(encoded));
      assert.equal(sha(gunzipSync(compressed,{maxOutputLength:67108864})),sha(raw));
      guard('immediate-precleanup'); immutable('immediate-precleanup');
      assert.equal(fs.realpathSync(scratch),scratch); fs.rmSync(scratch,{recursive:true,force:false});
      assert.ok(!fs.existsSync(scratch)); guard('postcleanup');
      const evaluationChildren = evidence.children.filter(row => row.role === 'workflow' && Number.isInteger(row.pid)).length;
      const observedEvaluations = evidence.observations.reduce((sum,row) => sum + row.counters.engineEntered,0);
      const closure = { schema:'node-abi-closure-v1', executionCommit,manifestSha256,grantSha256,reviewSha256,archiveSha256:sha(encoded),rawSha256:sha(raw),compressedSha256:sha(compressed),originalGuardSha256:sha(JSON.stringify(lastOriginals)),removedScratch:true,integrity,allPass:evidence.allPass && integrity,childCloseObserved:evidence.children.every(row => row.closeObserved === true),naturalChildren:evidence.children.filter(row => row.naturallyReaped).length,expectedNaturalChildren:9,evaluationChildren,authenticatedEvaluationReceipts:evidence.observations.length,actualGuestEvaluations:evidence.observations.length === evaluationChildren ? observedEvaluations : null,elapsedMs:Date.now()-started };
      if (closure.elapsedMs > limits.overallContainmentMs || !closure.childCloseObserved || closure.naturalChildren !== 9 || closure.actualGuestEvaluations !== 8) closure.allPass = false;
      fs.writeFileSync(path.join(runRoot,'CLOSURE.json'),JSON.stringify(closure)+'\n',{flag:'wx',mode:0o600});
      assert.deepEqual(JSON.parse(readLimited(path.join(runRoot,'CLOSURE.json'),32768)),closure);
      if (!integrity) fs.writeFileSync(path.join(runRoot,'STOP.json'),JSON.stringify({executionCommit,reason:'SAFETY_STOP',safetyStops:evidence.safetyStops})+'\n',{flag:'wx',mode:0o600});
      process.stdout.write(JSON.stringify({runId,allPass:closure.allPass,closureSha256:sha(readLimited(path.join(runRoot,'CLOSURE.json'),32768))})+'\n');
      process.exitCode = closure.allPass ? 0 : integrity ? 1 : 2;
    } catch (error) {
      const stop = {executionCommit,manifestSha256,reason:errorData(error),safetyStops:evidence.safetyStops,activeChild:activeChild?.handle?.pid ?? null,scratchRetained:fs.existsSync(scratch)};
      try { fs.writeFileSync(path.join(runRoot,'STOP.json'),JSON.stringify(stop)+'\n',{flag:'wx',mode:0o600}); } catch {}
      process.stderr.write(JSON.stringify(stop)+'\n'); process.exitCode = 2;
    }
  } else process.exitCode = 2;
}
