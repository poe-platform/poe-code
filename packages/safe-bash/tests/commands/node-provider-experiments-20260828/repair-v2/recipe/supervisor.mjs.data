const manifest = JSON.parse(manifestBytes);
for (const row of manifest.files) boundRead(path.join(own, safe(row.path)), row);
const control = JSON.parse(readLimited(path.join(own, 'CONTROL.json'), 262144));
const tools = JSON.parse(readLimited(path.join(own, 'TOOLS.json'), 262144));
const sources = JSON.parse(readLimited(path.join(own, 'SOURCES.json'), 262144));
const inherited = JSON.parse(readLimited(path.join(own, 'INHERITED.json'), 262144));
const limits = control.limits;
const grantPath = path.join(own, 'authorizations', runId + '.json');
const grantBytes = readLimited(grantPath, 32768);
assert.equal(sha(grantBytes), grantSha256);
const grant = JSON.parse(grantBytes);
assert.deepEqual(Object.keys(grant).sort(), ['schema','authorized','executionCommit','manifestSha256','runId','reviewPath','reviewSha256','authorizedAt','evaluations','guestEvaluations','sourceManifestSha256','toolManifestSha256','referenceAbi','limits','privateAccess','retry'].sort());
assert.equal(grant.schema, 'node-abi-root-go-v1'); assert.equal(grant.authorized, true);
assert.equal(grant.executionCommit, executionCommit); assert.equal(grant.manifestSha256, manifestSha256);
assert.equal(grant.runId, runId); assert.equal(grant.reviewSha256, reviewSha256);
assert.deepEqual(grant.evaluations, control.evaluations); assert.equal(grant.guestEvaluations, 8);
assert.equal(grant.sourceManifestSha256, sha(readLimited(path.join(own, 'SOURCES.json'), 262144)));
assert.equal(grant.toolManifestSha256, sha(readLimited(path.join(own, 'TOOLS.json'), 262144)));
assert.deepEqual(grant.limits, limits); assert.equal(grant.privateAccess, false); assert.equal(grant.retry, false);
assert.equal(grant.referenceAbi, control.abi.identity);
const reviewPath = path.join(own, safe(grant.reviewPath));
assert.ok(grant.reviewPath.startsWith('reviews/'));
const reviewBytes = readLimited(reviewPath, 32768);
assert.equal(sha(reviewBytes), reviewSha256);
const review = JSON.parse(reviewBytes);
assert.deepEqual(Object.keys(review).sort(), ['schema','reviewer','disposition','executionCommit','manifestSha256','completedAt','findings'].sort());
assert.ok(Array.isArray(review.findings) && review.findings.length <= 16 && review.findings.every(value => typeof value === 'string' && Buffer.byteLength(value) <= 4096));
assert.equal(review.schema, 'node-abi-raman-review-v1'); assert.equal(review.reviewer, 'Raman');
assert.equal(review.disposition, 'READY_FOR_FRESH_ROOT_GO');
assert.equal(review.executionCommit, executionCommit); assert.equal(review.manifestSha256, manifestSha256);
assert.equal(typeof review.completedAt,'string'); assert.equal(typeof grant.authorizedAt,'string');
assert.ok(Number.isFinite(Date.parse(review.completedAt)) && Date.parse(grant.authorizedAt) > Date.parse(review.completedAt));
assert.equal(process.execPath, tools.node.origin); assert.equal(process.version, tools.node.version);
assert.equal(process.platform, tools.node.platform); assert.equal(process.arch, tools.node.arch);
const externalTools = [tools.node, tools.git, ...tools.compiler.files];
for (const row of externalTools) boundRead(row.origin, row);
const runRoot = path.join(own, 'runs', runId);
const runsRoot = path.join(own, 'runs');
const scratch = path.join(runRoot, 'scratch');
const consumer = path.join(scratch, 'consumer');
assert.ok(!fs.existsSync(runRoot), 'RUN_ID_ALREADY_USED');
let lastChildFailure, primaryFailure;
let childCount = 0, activeChild, created = false, integrity = true, expectedTools, expectedConsumer;
let originalBaseline, lastOriginals;
const evidence = { schema: 'node-abi-execution-raw-v1', phase: 'PRE_CLEANUP_RAW', executionCommit, manifestSha256, grantSha256, reviewSha256, engineCommit: sources.engineCommit, inheritedExecutor: inherited.executorCommit, evaluations: control.evaluations, guestEvaluationsPlanned: 8, children: [], guards: [], observations: [], safetyStops: [], allPass: false, privateAccess: false, installs: 0, productLoads: 0, buildCommands: 0, sourceQualification: control.sourceQualification };
const errorData = error => { try { return { name: typeof error?.name === 'string' ? error.name.slice(0,128) : null, code: typeof error?.code === 'string' ? error.code.slice(0,128) : null, message: String(error?.message ?? error).slice(0,8192) }; } catch { return { name:null,code:null,message:'UNSERIALIZABLE_FAILURE' }; } };
function remaining() { const value = limits.overallContainmentMs - (Date.now() - started); assert.ok(value > limits.cleanupReserveMs, 'EXECUTION_WINDOW_EXHAUSTED'); return value - limits.cleanupReserveMs; }
function originals() {
  const names = fs.readdirSync(own).filter(name => !['runs','reviews','authorizations','VALIDATION.json','RAMAN_HANDOFF.md'].includes(name)).sort();
  assert.deepEqual(names, ['MANIFEST.json', ...manifest.files.map(row => row.path)].sort(), 'APPENDED_PREPARATION_INPUT');
  const files = {};
  for (const row of manifest.files) files[row.path] = sha(boundRead(path.join(own, safe(row.path)), row));
  assert.equal(sha(readLimited(path.join(own, 'MANIFEST.json'), 262144)), manifestSha256);
  const references = {};
  for (const row of inherited.references) {
    const bytes = readLimited(path.join(repository, row.path), row.bytes);
    assert.equal(sha(bytes), row.sha256); assert.equal(objectHash('blob', bytes), row.gitBlob);
    references[row.path] = row.sha256;
  }
  const external = {};
  for (const row of externalTools) {
    boundRead(row.origin, row); const stat = fs.statSync(row.origin);
    external[row.origin] = { bytes: stat.size, mode: stat.mode & 511, sha256: row.sha256, mtimeMs: stat.mtimeMs, ctimeMs: stat.ctimeMs };
  }
  assert.equal(sha(readLimited(grantPath, 32768)), grantSha256);
  assert.equal(sha(readLimited(reviewPath, 32768)), reviewSha256);
  return { files, references, external, grantSha256, reviewSha256 };
}
function guard(label) {
  try {
    const current = originals();
    if (originalBaseline) assert.deepEqual(current, originalBaseline, 'ORIGINAL_GUARD:' + label); else originalBaseline = current;
    lastOriginals = current;
    evidence.guards.push({ label, sha256: sha(JSON.stringify(current)), appendDetection: 'preparation input names except explicit notes/reviews/authorizations/runs; all copied immutable trees; not external-tool siblings or unrelated repository trees' });
  } catch (error) { integrity = false; throw error; }
}
function write(relative, bytes, mode = 0o644) {
  const filename = path.join(scratch, safe(relative)); assert.ok(filename.startsWith(scratch + '/'));
  fs.mkdirSync(path.dirname(filename), { recursive: true, mode: 0o755 });
  fs.writeFileSync(filename, bytes, { flag: 'wx', mode }); fs.chmodSync(filename, mode);
}
function copy(source, relative, expected) { write(relative, boundRead(source, expected), expected.mode); }
function immutable(label) {
  if (expectedTools) assert.deepEqual(tree(path.join(scratch, 'tools')).entries, expectedTools, 'TOOLS_MEMBERSHIP_OR_BYTES:' + label);
  if (expectedConsumer) assert.deepEqual(tree(consumer).entries, expectedConsumer, 'CONSUMER_MEMBERSHIP_OR_BYTES:' + label);
  const current = tree(scratch); evidence.guards.push({ label, scratchEntries: current.count, scratchBytes: current.bytes, censusOnly: true });
}
function authenticateArchive() {
  const encoded = boundRead(path.join(own, sources.archive.path), { ...sources.archive, mode: 0o644 });
  const compressed = Buffer.from(encoded.toString('utf8').trim(), 'base64');
  assert.equal(sha(compressed), sources.archive.gzipSha256);
  const decoded = gunzipSync(compressed, { maxOutputLength: 4194304 });
  assert.equal(decoded.length, sources.archive.decodedBytes); assert.equal(sha(decoded), sources.archive.decodedSha256);
  const archive = JSON.parse(decoded);
  const commit = Buffer.from(archive.proof.commitBase64, 'base64');
  assert.equal(objectHash('commit', commit), sources.engineCommit);
  assert.equal(sha(commit), sources.proof.commitSha256);
  assert.equal(commit.toString().split('\n')[0], 'tree ' + sources.engineTree);
  const trees = new Map();
  for (const row of archive.proof.trees) {
    const raw = Buffer.from(row.rawBase64, 'base64'); assert.equal(objectHash('tree', raw), row.sha);
    const reconstructed = Buffer.concat([...row.entries].sort((left,right) => Buffer.compare(Buffer.from(left.path + (left.type === 'tree' ? '/' : '')), Buffer.from(right.path + (right.type === 'tree' ? '/' : '')))).map(entry => Buffer.concat([Buffer.from(entry.mode.replace(/^0+/u,'') + ' ' + entry.path + '\0'), Buffer.from(entry.sha, 'hex')])));
    assert.ok(raw.equals(reconstructed)); assert.ok(!trees.has(row.sha)); trees.set(row.sha, row.entries);
  }
  const member = (treeId,name) => { const entry = trees.get(treeId)?.find(row => row.path === name); assert.ok(entry, 'MISSING_AUTHENTICATED_TREE_MEMBER'); return entry; };
  const packageTree = member(member(sources.engineTree, 'packages').sha, 'safejs').sha;
  assert.equal(packageTree, sources.packageTree);
  assert.equal(archive.files.length, 66); assert.equal(sources.files.length, 66);
  const files = new Map();
  for (const row of sources.files) {
    const parts = safe(row.path).split('/'); let cursor = packageTree;
    for (const part of parts.slice(0,-1)) cursor = member(cursor,part).sha;
    const entry = member(cursor, parts.at(-1)); assert.equal(entry.sha, row.gitBlob); assert.equal(entry.mode, '100644');
    const payload = archive.files.find(value => value.path === row.path); assert.ok(payload && !files.has(row.path));
    const bytes = Buffer.from(payload.base64, 'base64'); assert.equal(bytes.length, row.bytes); assert.equal(sha(bytes), row.sha256); assert.equal(objectHash('blob', bytes), row.gitBlob);
    files.set(row.path, bytes);
  }
  return files;
}
function admit(label) {
  const files = {};
  for (const [relative,row] of Object.entries(tree(scratch).entries)) {
    if (row.kind !== 'file' || relative.startsWith('logs/') || relative.startsWith('admissions/')) continue;
    let role = 'harness-data';
    if (relative === 'tools/loader.mjs' || relative === 'tools/node' || relative === 'consumer/harness/child.mjs' || relative === 'consumer/harness/reference-entry.mjs') role = 'harness';
    if (relative.startsWith('consumer/node_modules/typescript/')) role = 'compiler';
    if (relative.startsWith('consumer/engine/src/')) {
      const source = sources.files.find(value => relative === 'consumer/engine/' + value.path);
      assert.ok(source);
      if (source.role === 'engine-runtime-candidate') { files[relative] = { ...row, role: 'engine', emittedSha256: source.emittedSha256 }; continue; }
      continue;
    }
    files[relative] = { ...row, role };
  }
  const value = { role: 'workflow', executionToken: executionCommit + ':' + manifestSha256 + ':' + label, files, builtinAllowlist: tools.builtinAllowlist, compiler: 'consumer/node_modules/typescript/lib/typescript.js' };
  const bytes = Buffer.from(JSON.stringify(value)); assert.ok(bytes.length <= 2097152);
  const relative = 'admissions/' + label + '.json'; write(relative, bytes, 0o600);
