import assert from 'node:assert/strict';
import fs from 'node:fs';
import path from 'node:path';
import { createHash } from 'node:crypto';
import { gzipSync, gunzipSync } from 'node:zlib';
import { spawn } from 'node:child_process';

function readLimited(filename, maximum) {
  const stat = fs.lstatSync(filename);
  assert.ok(stat.isFile() && !stat.isSymbolicLink() && stat.size <= maximum, 'READ_BOUND:' + filename);
  assert.equal(fs.realpathSync(filename), filename);
  const bytes = fs.readFileSync(filename); assert.equal(bytes.length, stat.size); return bytes;
}

function safe(relative) {
  assert.ok(relative && !path.isAbsolute(relative) && !relative.includes('\\') && !relative.includes('\0'));
  assert.ok(!relative.split('/').some(part => ['', '.', '..', 'AGENTS.md'].includes(part)), 'UNSAFE_PATH');
  return relative;
}

function boundRead(filename, expected) {
  assert.equal(fs.realpathSync(filename), filename, 'SOURCE_SYMLINK');
  const stat = fs.lstatSync(filename);
  assert.ok(stat.isFile() && !stat.isSymbolicLink());
  assert.equal(stat.mode & 511, expected.mode); assert.equal(stat.size, expected.bytes);
  const bytes = fs.readFileSync(filename); assert.equal(sha(bytes), expected.sha256, filename);
  return bytes;
}

function tree(root, maximumEntries = limits.scratchFiles, maximumBytes = limits.scratchBytes, metadata = false) {
  const result = {}; let entries = 0, bytes = 0;
  function visit(prefix) {
    for (const name of fs.readdirSync(path.join(root, prefix)).sort()) {
      const relative = prefix ? prefix + '/' + name : name; safe(relative);
      const absolute = path.join(root, relative), stat = fs.lstatSync(absolute);
      assert.ok(!stat.isSymbolicLink(), 'TREE_SYMLINK:' + absolute); assert.ok(++entries <= maximumEntries, 'ENTRY_BOUND');
      if (stat.isDirectory()) { result[relative + '/'] = { kind: 'directory', mode: stat.mode & 511, ...(metadata ? { bytes: stat.size, mtimeMs: stat.mtimeMs, ctimeMs: stat.ctimeMs } : {}) }; visit(relative); }
      else {
        assert.ok(stat.isFile()); bytes += stat.size; assert.ok(bytes <= maximumBytes, 'BYTE_BOUND');
        result[relative] = { kind: 'file', bytes: stat.size, mode: stat.mode & 511, sha256: sha(fs.readFileSync(absolute)), ...(metadata ? { mtimeMs: stat.mtimeMs, ctimeMs: stat.ctimeMs } : {}) };
      }
    }
  }
  assert.ok(fs.lstatSync(root).isDirectory()); visit(''); return { entries: result, count: entries, bytes };
}

async function child(executable, args, options) {
  const allowance = Math.min(options.timeoutMs, remaining());
  assert.ok(Number.isFinite(allowance) && allowance > 0);
  assert.ok(!activeChild); assert.ok(++childCount <= control.maximumSpawnedChildren, 'CHILD_BOUND');
  const row = { number: childCount, role: options.role, executable, args, cwd: options.cwd, stdoutBytes: 0, stderrBytes: 0, containment: null, naturallyReaped: false, closeObserved: false, signalsRequested: [] };
  evidence.children.push(row);
  const stdout = [], stderr = [], secondary = [];
  let handle, deadline, grace, forced, settledClose, failedDrain, primaryPresent = false, primaryReason, result;
  const remember = reason => { if (!primaryPresent) { primaryPresent = true; primaryReason = reason; } else if (secondary.length < 16) secondary.push(reason); };
  const done = new Promise((resolve, reject) => { settledClose = resolve; failedDrain = reject; });
  void done.catch(() => {});
  const send = signal => {
    try { row.signalsRequested.push(signal); handle.kill(signal); }
    catch (reason) { remember(reason); }
  };
  const contain = reason => {
    remember(reason);
    if (row.closeObserved || row.containment) return;
    row.containment = 'OWNED_FAILURE';
    send('SIGTERM');
    grace = setTimeout(() => {
      if (row.closeObserved) return;
      send('SIGKILL');
      forced = setTimeout(() => { if (!row.closeObserved) failedDrain(new Error('DIRECT_CHILD_NOT_REAPED')); }, limits.containmentGraceMs);
    }, limits.containmentGraceMs);
  };
  const owner = { row, handle: undefined, wait: done, retire: async reason => { contain(reason); await done; } };
  const onClose = (status, signal) => {
    row.status = status; row.signal = signal; row.closeObserved = true;
    row.naturallyReaped = !row.spawnError && !row.containment && signal === null;
    clearTimeout(deadline); clearTimeout(grace); clearTimeout(forced); settledClose();
  };
  const onError = reason => {
    remember(reason);
    try { row.spawnError = errorData(reason); } catch (secondaryReason) { remember(secondaryReason); }
    contain(reason);
  };
  const capture = (target, key, maximum) => chunk => {
    try {
      row[key] += chunk.length;
      if (row[key] > maximum) throw new Error(key.toUpperCase() + '_BOUND');
      target.push(Buffer.from(chunk));
    } catch (reason) { contain(reason); }
  };
  try {
    handle = spawn(executable, args, { cwd: options.cwd, env: options.env, stdio: ['ignore', 'pipe', 'pipe'] });
    owner.handle = handle; activeChild = owner;
    handle.on('error', onError); handle.once('close', onClose);
    row.pid = handle.pid;
    handle.stdout.on('data', capture(stdout, 'stdoutBytes', limits.stdoutBytesPerChild));
    handle.stderr.on('data', capture(stderr, 'stderrBytes', limits.stderrBytesPerChild));
    if (created && options.role !== 'git-read') write('logs/' + options.label + '.child.json', Buffer.from(JSON.stringify({ pid: row.pid, number: row.number, label: options.label }) + '\n'), 0o600);
    deadline = setTimeout(() => contain(new Error('CHILD_DEADLINE')), Math.min(allowance, remaining()));
    await done;
    if (!row.naturallyReaped) throw new Error('CHILD_CONTAINMENT_OR_SPAWN');
    result = { stdout: Buffer.concat(stdout), stderr: Buffer.concat(stderr) };
    row.stdoutSha256 = sha(result.stdout); row.stderrSha256 = sha(result.stderr);
    if (created && options.role !== 'git-read') { write('logs/' + options.label + '.stdout', result.stdout, 0o600); write('logs/' + options.label + '.stderr', result.stderr, 0o600); }
  } catch (reason) { remember(reason); }
  finally {
    if (handle && !row.closeObserved) {
      try { await owner.retire(primaryPresent ? primaryReason : new Error('UNSETTLED_CHILD')); }
      catch (reason) { remember(reason); }
    }
    if (row.closeObserved) {
      clearTimeout(deadline); clearTimeout(grace); clearTimeout(forced);
      if (activeChild === owner) activeChild = undefined;
    }
  }
  lastChildFailure = { present: primaryPresent, reason: primaryReason, secondary };
  if (primaryPresent) {
    try { row.primaryFailure = errorData(primaryReason); row.secondaryFailures = secondary.map(errorData); }
    catch (reason) { secondary.push(reason); row.failureSerializationIncomplete = true; }
    throw primaryReason;
  }
  return { ...result, row };
}

async function retireActiveChild(reason) {
  const owner = activeChild;
  if (!owner) return;
  try { await owner.retire(reason); }
  finally { if (owner.row.closeObserved && activeChild === owner) activeChild = undefined; }
}

const repository = '/Users/kjopek/Workspace/safe-bash';
const started = Date.now();
const relativeOwn = 'tests/commands/node-provider-experiments-20260828/repair-v2/recipe';
const own = path.join(repository, relativeOwn);
