  const value = { role: 'workflow', executionToken: executionCommit + ':' + manifestSha256 + ':' + label, files, builtinAllowlist: tools.builtinAllowlist, compiler: 'consumer/node_modules/typescript/lib/typescript.js' };
  const bytes = Buffer.from(JSON.stringify(value)); assert.ok(bytes.length <= 2097152);
  const relative = 'admissions/' + label + '.json'; write(relative, bytes, 0o600);
