    if (relative.startsWith('consumer/node_modules/typescript/')) role = 'compiler';
    if (relative.startsWith('consumer/engine/src/')) {
      const source = sources.files.find(value => relative === 'consumer/engine/' + value.path);
      assert.ok(source);
