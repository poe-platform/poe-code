}
function authenticateArchive() {
  const encoded = boundRead(path.join(own, sources.archive.path), { ...sources.archive, mode: 0o644 });
  const compressed = Buffer.from(encoded.toString('utf8').trim(), 'base64');
  assert.equal(sha(compressed), sources.archive.gzipSha256);
  const decoded = gunzipSync(compressed, { maxOutputLength: 4194304 });
  assert.equal(decoded.length, sources.archive.decodedBytes); assert.equal(sha(decoded), sources.archive.decodedSha256);
  const archive = JSON.parse(decoded);
  const commit = Buffer.from(archive.proof.commitBase64, 'base64');
  assert.equal(objectHash('commit', commit), sources.engineCommit);
  assert.equal(sha(commit), sources.proof.commitSha256);
  assert.equal(commit.toString().split('\n')[0], 'tree ' + sources.engineTree);
  const trees = new Map();
  for (const row of archive.proof.trees) {
    const raw = Buffer.from(row.rawBase64, 'base64'); assert.equal(objectHash('tree', raw), row.sha);
    const reconstructed = Buffer.concat([...row.entries].sort((left,right) => Buffer.compare(Buffer.from(left.path + (left.type === 'tree' ? '/' : '')), Buffer.from(right.path + (right.type === 'tree' ? '/' : '')))).map(entry => Buffer.concat([Buffer.from(entry.mode.replace(/^0+/u,'') + ' ' + entry.path + '\0'), Buffer.from(entry.sha, 'hex')])));
    assert.ok(raw.equals(reconstructed)); assert.ok(!trees.has(row.sha)); trees.set(row.sha, row.entries);
  }
  const member = (treeId,name) => { const entry = trees.get(treeId)?.find(row => row.path === name); assert.ok(entry, 'MISSING_AUTHENTICATED_TREE_MEMBER'); return entry; };
  const packageTree = member(member(sources.engineTree, 'packages').sha, 'safejs').sha;
  assert.equal(packageTree, sources.packageTree);
  assert.equal(archive.files.length, 66); assert.equal(sources.files.length, 66);
  const files = new Map();
  for (const row of sources.files) {
    const parts = safe(row.path).split('/'); let cursor = packageTree;
    for (const part of parts.slice(0,-1)) cursor = member(cursor,part).sha;
    const entry = member(cursor, parts.at(-1)); assert.equal(entry.sha, row.gitBlob); assert.equal(entry.mode, '100644');
    const payload = archive.files.find(value => value.path === row.path); assert.ok(payload && !files.has(row.path));
    const bytes = Buffer.from(payload.base64, 'base64'); assert.equal(bytes.length, row.bytes); assert.equal(sha(bytes), row.sha256); assert.equal(objectHash('blob', bytes), row.gitBlob);
