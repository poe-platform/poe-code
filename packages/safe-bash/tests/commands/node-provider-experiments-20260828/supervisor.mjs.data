function originals() {
  const names = fs.readdirSync(own).filter(name => !['runs','reviews','authorizations','VALIDATION.json','RAMAN_HANDOFF.md'].includes(name)).sort();
  assert.deepEqual(names, ['MANIFEST.json', ...manifest.files.map(row => row.path)].sort(), 'APPENDED_PREPARATION_INPUT');
  const files = {};
  for (const row of manifest.files) files[row.path] = sha(boundRead(path.join(own, safe(row.path)), row));
  assert.equal(sha(readLimited(path.join(own, 'MANIFEST.json'), 262144)), manifestSha256);
