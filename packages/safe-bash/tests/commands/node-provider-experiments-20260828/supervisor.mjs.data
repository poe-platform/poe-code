assert.equal(grant.schema, 'node-abi-root-go-v1'); assert.equal(grant.authorized, true);
assert.equal(grant.executionCommit, executionCommit); assert.equal(grant.manifestSha256, manifestSha256);
assert.equal(grant.runId, runId); assert.equal(grant.reviewSha256, reviewSha256);
assert.deepEqual(grant.evaluations, control.evaluations); assert.equal(grant.guestEvaluations, 8);
assert.equal(grant.sourceManifestSha256, sha(readLimited(path.join(own, 'SOURCES.json'), 262144)));
assert.equal(grant.toolManifestSha256, sha(readLimited(path.join(own, 'TOOLS.json'), 262144)));
assert.deepEqual(grant.limits, limits); assert.equal(grant.privateAccess, false); assert.equal(grant.retry, false);
assert.equal(grant.referenceAbi, control.abi.identity);
const reviewPath = path.join(own, safe(grant.reviewPath));
assert.ok(grant.reviewPath.startsWith('reviews/'));
const reviewBytes = readLimited(reviewPath, 32768);
assert.equal(sha(reviewBytes), reviewSha256);
const review = JSON.parse(reviewBytes);
assert.deepEqual(Object.keys(review).sort(), ['schema','reviewer','disposition','executionCommit','manifestSha256','completedAt','findings'].sort());
assert.ok(Array.isArray(review.findings) && review.findings.length <= 16 && review.findings.every(value => typeof value === 'string' && Buffer.byteLength(value) <= 4096));
assert.equal(review.schema, 'node-abi-raman-review-v1'); assert.equal(review.reviewer, 'Raman');
assert.equal(review.disposition, 'READY_FOR_FRESH_ROOT_GO');
assert.equal(review.executionCommit, executionCommit); assert.equal(review.manifestSha256, manifestSha256);
assert.equal(typeof review.completedAt,'string'); assert.equal(typeof grant.authorizedAt,'string');
assert.ok(Number.isFinite(Date.parse(review.completedAt)) && Date.parse(grant.authorizedAt) > Date.parse(review.completedAt));
assert.equal(process.execPath, tools.node.origin); assert.equal(process.version, tools.node.version);
assert.equal(process.platform, tools.node.platform); assert.equal(process.arch, tools.node.arch);
const externalTools = [tools.node, tools.git, ...tools.compiler.files];
for (const row of externalTools) boundRead(row.origin, row);
const runRoot = path.join(own, 'runs', runId);
const runsRoot = path.join(own, 'runs');
const scratch = path.join(runRoot, 'scratch');
