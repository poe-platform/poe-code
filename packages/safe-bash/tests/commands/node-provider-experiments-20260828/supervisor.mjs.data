  } catch (error) { integrity = false; throw error; }
}
function write(relative, bytes, mode = 0o644) {
  const filename = path.join(scratch, safe(relative)); assert.ok(filename.startsWith(scratch + '/'));
  fs.mkdirSync(path.dirname(filename), { recursive: true, mode: 0o755 });
