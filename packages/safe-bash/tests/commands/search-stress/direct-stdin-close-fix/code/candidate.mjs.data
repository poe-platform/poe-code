import assert from 'node:assert/strict';
import { readFileSync, writeFileSync, cpSync, readdirSync } from 'node:fs';
import { createHash } from 'node:crypto';
import { join } from 'node:path';
const task = '/tmp/safe-bash-search-stdin-close-fix-20260827';
const repo = '/Users/kjopek/Workspace/safe-bash';
const path = 'tests/commands/search-stress/direct-stdin-close.test.ts';
const hash = bytes => createHash('sha256').update(bytes).digest('hex');
const qualification = JSON.parse(readFileSync(`${task}/qualification.json`));
const finalTest = readFileSync(`${repo}/${path}`);
writeFileSync(`${task}/final-focused.test.ts.data`, finalTest);
writeFileSync(`${task}/test-freeze-final.json`, JSON.stringify({at:new Date().toISOString(),path,sha256:hash(finalTest), topLevelLogicalTests:14, patchedRunsBeforeFreeze:0, previous:'test-freeze-corrected.json', finalCorrection:'Uint8Array expected constructor; identical bytes'},null,2)+'\n');
cpSync(`${task}/before`, `${task}/after`, {recursive:true});
writeFileSync(`${task}/after/${path}`, finalTest);
cpSync(`${repo}/src/commands/search/rg.ts`, `${task}/after/src/commands/search/rg.ts`);
const files = [...qualification.files.filter(entry => entry.path !== path).map(entry => ({path:entry.path,sha256:hash(readFileSync(join(task,'after',entry.path)))})),{path,sha256:hash(finalTest)}];
const differences = qualification.files.filter(entry => entry.sha256 !== files.find(file => file.path === entry.path).sha256);
assert.deepEqual(differences.map(entry => entry.path),['src/commands/search/rg.ts']);
const manifest = {at:new Date().toISOString(), basis:'qualification.json current task snapshot, not HEAD/frozen whole gate', files, changedSource: differences, sourceTreeSha256:hash(JSON.stringify(files.filter(entry => entry.path.startsWith('src/')))),testSha256:hash(finalTest), unchangedTypedFactoryAndPublicAPI:true};
writeFileSync(`${task}/candidate.json`,JSON.stringify(manifest,null,2)+'\n');
console.log(JSON.stringify({files:files.length, changed:differences.map(entry=>entry.path),sourceTreeSha256:manifest.sourceTreeSha256,testSha256:manifest.testSha256}));
