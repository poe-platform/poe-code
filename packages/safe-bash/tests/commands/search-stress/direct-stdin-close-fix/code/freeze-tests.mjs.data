import { readFileSync, writeFileSync, cpSync } from 'node:fs';
import { createHash } from 'node:crypto';
const task = '/tmp/safe-bash-search-stdin-close-fix-20260827';
const repo = '/Users/kjopek/Workspace/safe-bash';
const path = 'tests/commands/search-stress/direct-stdin-close.test.ts';
const intentPath = 'tests/commands/search-stress/direct-stdin-close-fix/intentions.md';
const hash = path => createHash('sha256').update(readFileSync(path)).digest('hex');
cpSync(`${repo}/${path}`, `${task}/before/${path}`);
cpSync(`${repo}/${path}`, `${task}/frozen-focused.test.ts.data`);
writeFileSync(`${task}/test-freeze.json`, JSON.stringify({ at: new Date().toISOString(), path, sha256:hash(`${repo}/${path}`), intentPath, intentSha256:hash(`${repo}/${intentPath}`), topLevelLogicalTests:14, patchedRunsBeforeFreeze:0 },null,2)+'\n');
writeFileSync(`${task}/before/tsconfig.focused.json`, JSON.stringify({extends:'./tsconfig.json', compilerOptions:{noEmit:true}, include:[path],exclude:[]},null,2)+'\n');
