{
  "source": "/usr/bin/jq jq-1.7.1-apple, Darwin arm64, LC_ALL=C",
  "cases": [
    {
      "filter": "fromdateiso8601",
      "stdin": "\"2020-01-02T03:04:05Z\"\n",
      "expected": {
        "exitCode": 0,
        "stdout": "1577934245\n",
        "stderr": ""
      }
    },
    {
      "filter": "fromdateiso8601",
      "stdin": "\"1970-01-01T00:00:00Z\"\n",
      "expected": {
        "exitCode": 0,
        "stdout": "0\n",
        "stderr": ""
      }
    },
    {
      "filter": "fromdateiso8601",
      "stdin": "\"2020-02-30T00:00:00Z\"\n",
      "expected": {
        "exitCode": 0,
        "stdout": "1583020800\n",
        "stderr": ""
      }
    },
    {
      "filter": "fromdateiso8601",
      "stdin": "\"2020-1-2T3:4:5Z\"\n",
      "expected": {
        "exitCode": 0,
        "stdout": "1577934245\n",
        "stderr": ""
      }
    },
    {
      "filter": "fromdateiso8601",
      "stdin": "\"2020-01-01T00:00:60Z\"\n",
      "expected": {
        "exitCode": 0,
        "stdout": "1577836860\n",
        "stderr": ""
      }
    },
    {
      "filter": "fromdateiso8601",
      "stdin": "\"2020-01-00T00:00:00Z\"\n",
      "expected": {
        "exitCode": 0,
        "stdout": "1577750400\n",
        "stderr": ""
      }
    },
    {
      "filter": "fromdateiso8601",
      "stdin": "\"2020-13-01T00:00:00Z\"\n",
      "expected": {
        "exitCode": 5,
        "stdout": "",
        "stderr": "jq: error (at <stdin>:1): date \"2020-13-01T00:00:00Z\" does not match format \"%Y-%m-%dT%H:%M:%SZ\"\n"
      }
    },
    {
      "filter": "fromdateiso8601",
      "stdin": "\"2020-01-02T03:04:05.1Z\"\n",
      "expected": {
        "exitCode": 5,
        "stdout": "",
        "stderr": "jq: error (at <stdin>:1): date \"2020-01-02T03:04:05.1Z\" does not match format \"%Y-%m-%dT%H:%M:%SZ\"\n"
      }
    },
    {
      "filter": "fromdateiso8601",
      "stdin": "\"2020-01-02T03:04:05+00:00\"\n",
      "expected": {
        "exitCode": 5,
        "stdout": "",
        "stderr": "jq: error (at <stdin>:1): date \"2020-01-02T03:04:05+00:00\" does not match format \"%Y-%m-%dT%H:%M:%SZ\"\n"
      }
    },
    {
      "filter": "fromdateiso8601",
      "stdin": "\"2020-01-02T03:04:05Ztail\"\n",
      "expected": {
        "exitCode": 5,
        "stdout": "",
        "stderr": "jq: error (at <stdin>:1): date \"2020-01-02T03:04:05Ztail\" does not match format \"%Y-%m-%dT%H:%M:%SZ\"\n"
      }
    },
    {
      "filter": "fromdateiso8601",
      "stdin": "\"1899-12-31T00:00:00Z\"\n",
      "expected": {
        "exitCode": 5,
        "stdout": "",
        "stderr": "jq: error (at <stdin>:1): invalid gmtime representation\n"
      }
    },
    {
      "filter": "fromdateiso8601",
      "stdin": "null\n",
      "expected": {
        "exitCode": 5,
        "stdout": "",
        "stderr": "jq: error (at <stdin>:1): strptime/1 requires string inputs and arguments\n"
      }
    },
    {
      "filter": "fromdateiso8601",
      "stdin": "0\n",
      "expected": {
        "exitCode": 5,
        "stdout": "",
        "stderr": "jq: error (at <stdin>:1): strptime/1 requires string inputs and arguments\n"
      }
    },
    {
      "filter": "fromdateiso8601",
      "stdin": "[]\n",
      "expected": {
        "exitCode": 5,
        "stdout": "",
        "stderr": "jq: error (at <stdin>:1): strptime/1 requires string inputs and arguments\n"
      }
    },
    {
      "filter": "todateiso8601",
      "stdin": "0\n",
      "expected": {
        "exitCode": 0,
        "stdout": "\"1970-01-01T00:00:00Z\"\n",
        "stderr": ""
      }
    },
    {
      "filter": "todateiso8601",
      "stdin": "1577934245\n",
      "expected": {
        "exitCode": 0,
        "stdout": "\"2020-01-02T03:04:05Z\"\n",
        "stderr": ""
      }
    },
    {
      "filter": "todateiso8601",
      "stdin": "-1\n",
      "expected": {
        "exitCode": 0,
        "stdout": "\"1969-12-31T23:59:59Z\"\n",
        "stderr": ""
      }
    },
    {
      "filter": "todateiso8601",
      "stdin": "0.9\n",
      "expected": {
        "exitCode": 0,
        "stdout": "\"1970-01-01T00:00:00Z\"\n",
        "stderr": ""
      }
    },
    {
      "filter": "todateiso8601",
      "stdin": "-0.9\n",
      "expected": {
        "exitCode": 0,
        "stdout": "\"1970-01-01T00:00:00Z\"\n",
        "stderr": ""
      }
    },
    {
      "filter": "todateiso8601",
      "stdin": "951782400\n",
      "expected": {
        "exitCode": 0,
        "stdout": "\"2000-02-29T00:00:00Z\"\n",
        "stderr": ""
      }
    },
    {
      "filter": "todateiso8601",
      "stdin": "null\n",
      "expected": {
        "exitCode": 5,
        "stdout": "",
        "stderr": "jq: error (at <stdin>:1): strftime/1 requires parsed datetime inputs\n"
      }
    },
    {
      "filter": "todateiso8601",
      "stdin": "\"0\"\n",
      "expected": {
        "exitCode": 5,
        "stdout": "",
        "stderr": "jq: error (at <stdin>:1): strftime/1 requires parsed datetime inputs\n"
      }
    },
    {
      "filter": "todateiso8601",
      "stdin": "{}\n",
      "expected": {
        "exitCode": 5,
        "stdout": "",
        "stderr": "jq: error (at <stdin>:1): strftime/1 requires parsed datetime inputs\n"
      }
    },
    {
      "filter": "todateiso8601",
      "stdin": "1e+20\n",
      "expected": {
        "exitCode": 5,
        "stdout": "",
        "stderr": "jq: error (at <stdin>:1): error converting number of seconds since epoch to datetime\n"
      }
    },
    {
      "filter": "fromdateiso8601",
      "stdin": "\"2020-01T02:03:04:05Z\"\n",
      "expected": {
        "exitCode": 5,
        "stdout": "",
        "stderr": "jq: error (at <stdin>:1): date \"2020-01T02:03:04:05Z\" does not match format \"%Y-%m-%dT%H:%M:%SZ\"\n"
      }
    }
  ]
}
