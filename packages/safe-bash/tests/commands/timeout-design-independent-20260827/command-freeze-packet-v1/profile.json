  "duration": {
    "asciiGrammar": "(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)[smhd]?",
    "unitSeconds": {
      "": 1,
      "s": 1,
      "m": 60,
      "h": 3600,
      "d": 86400
    },
    "targetUnit": "milliseconds",
    "arithmetic": "exact decimal integer/rational",
    "rounding": "ceil exactly once after scaling",
    "zero": "mathematical zero disables deadline and omits all deadline resources",
    "minimumPositiveMilliseconds": 1,
    "maximumMilliseconds": 9007199254740991,
    "overflowFixture": "duration-overflow",
    "overflowExitCode": 125,
    "semanticDurationCap": null,
    "rejectedForms": [
      "signed",
      "whitespace",
      "exponent",
      "hexadecimal",
      "locale decimal",
      "NaN",
      "Infinity"
    ],
    "work": {
      "validationAndScanPasses": 1,
      "proportionalToAdmittedInputBytes": true,
      "proportionalToNumericMagnitude": false,
      "newArbitraryInputCap": null,
      "trimLeadingZeroesBeforeIntegerMaterialization": true
    }
  },
  "timer": {
    "defaultScheduler": {
      "clockBinding": "node:perf_hooks performance.now",
      "timerBindings": ["node:timers setTimeout", "node:timers clearTimeout"],
      "globalOrAmbientHookDiscovery": false
    },
    "clockUnit": "monotonic milliseconds",
    "clockSample": {
      "type": "number",
      "finite": true,
      "minimum": -9007199254740991,
      "maximum": 9007199254740991,
      "nondecreasing": true,
      "integerRequired": false
    },
    "defaultMaximumChunkMilliseconds": 2147483647,
    "configuredMaximumChunkProperty": "maxTimerMilliseconds",
    "allowedScheduledChunkMilliseconds": {
      "minimum": 1,
      "maximum": 2147483647,
      "integer": true
    },
    "maximumLiveHandles": 1,
    "allReturnedHandlesAreOpaqueAndLiveIncludingFalsy": true,
    "callbackContract": "asynchronous and at most once per handle",
    "remainingDurationNotAbsoluteDeadline": true,
    "freshDeadlineSentinelPerInvocation": true,
    "freshDistinctTimerFailureSentinelPerInvocation": true,
    "cleanupRegisteredSynchronouslyBeforeClockTimerOrChild": true,
    "activeThroughNestedInvokeCleanup": true,
    "retiredBeforeHandlerSettlement": true,
    "outerRootOnlyCleanupInsideDeadline": false,
    "outerRootOnlyCleanupStillAwaited": true,
    "clearOrRetirementFailure": "cleanup failure; never wrapper 124 or 125",
    "hardPreemption": false,
    "boundedSettlementForOpaqueOrNonconformingWork": false
  },
  "sharedState": {
    "budgetCountersReused": ["commands", "iterations", "bytes", "sourceBytes"],
    "depthReused": true,
    "newBudget": false,
    "newCounter": false,
    "counterReset": false,
    "familyLimitsCombinedWithShellBudget": false
  },
  "invoke": {
    "selection": [
      "present callable context.invoke",
      "factory fallback only if context.invoke property is absent",
      "invoke-unavailable status 125"
    ],
    "presentNonFunctionIncludingUndefined": "invoke-unavailable status 125 without fallback",
    "contextReceiver": "current CommandContext",
    "fallbackReceiver": "undefined",
    "capabilityField": null,
    "capabilityProbe": false,
    "fallbackShell": false,
    "ambientHookDiscovery": false,
    "singleDispatch": true,
    "trustedContract": [
      "signal",
      "registered cleanup",
      "shared budget and depth",
      "literal argv",
      "transparent streams",
      "settlement after cooperative child cleanup"
    ],
    "passes": [
      "signal only for positive duration",
      "stdin",
      "stdinIsDefault only when defined",
      "stdout",
      "stderr"
    ],
    "omits": ["cwd", "env", "replaceEnv"],
    "streamPrebuffer": false,
    "borrowedStreamClose": false
  },
  "outcomesAfterChildClosureAndTimerRetirement": [
    {
      "condition": "Object.is(error, ownDeadlineSentinel) and retirement has no failure",
      "exitCode": 124,
      "diagnostic": null
    },
    {
      "condition": "Object.is(error, ownTimerFailureSentinel) and retirement has no failure",
      "exitCode": 125,
