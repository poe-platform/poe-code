    "legacyWholeChildMs": 30000,
    "proposedSemanticMs": 30000,
    "statement": "Finite conservative ceilings, not duration estimates. Preserve30s semantic ceiling and explicitly allocate admission/materialization, growing prefix-integrity/capture and reap headroom. Old setup/semantic split is unknown. Arbitrary cohost stalls can still cause UNRUN coverage; no product bug follows from a time limit."
  },
  "metadataToolBounds": {
    "maximumGitHelpersPerOuterJob": 32768,
    "globalMaximumGitHelpers": 10977280,
    "maximumCompilerInvocations": 12,
    "requirement": "Proposed tool bridge must register exact executable/argv/group and enforce call count plus enclosing absolute deadline. Current helpers do not prove this count bound; no unbounded ambient tool calls are admitted.",
    "scope": "Count ceilings are resource refusals, not predictions or planned extra calls. Each actual call must also match presealed argv templates and be captured in its enclosing job slot.",
    "rationale": "At most4096 bounded manifest entries and at most8 selected-object/look-up passes per outer job =>32768 maximum; tool inventory may lower but never raise without successor preseal. Repeated full guards remain mandatory."
  },
