  "mutants": [
    {
      "id": "M01",
      "path": "dist/shell/conditional.js",
      "pattern": "frame\\.stage === 1 && \\(node\\.kind === \"and\" \\? result : !result\\)",
      "replacement": "frame.stage === 1",
      "script": "novel.mjs",
      "environment": {
        "NOVEL_CASE": "N05"
      },
      "qualification": "Eager valid unsupported RHS activation."
    },
    {
      "id": "M02",
      "path": "dist/shell/conditional.js",
      "pattern": "const left = await context\\.expand\\(node\\.left\\);",
      "replacement": "const left = await context.expand(node.left); if (left === \"||\" || left === \"]]\") unsupported(\"expanded operator\");",
      "script": "novel.mjs",
      "environment": {
        "NOVEL_CASE": "N02"
      },
      "qualification": "Rejects operator-like expanded data; not a full grammar reparser mutant."
    },
    {
      "id": "M03",
      "path": "dist/shell/runtime.js",
      "pattern": "this\\.word\\(word, state, io, false, pattern, false, pattern\\)",
      "replacement": "this.word(word, state, io, false, false, false, false)",
      "script": "novel.mjs",
      "environment": {
        "NOVEL_CASE": "N04"
      },
      "qualification": "Removes pattern quote-fragment escaping."
    },
    {
      "id": "M04",
      "path": "dist/shell/runtime.js",
      "pattern": "io = await this\\.redirect\\(command\\.redirects, state, io, inputs, outputs, command\\.kind === \"subshell\", command\\.kind !== \"subshell\"\\);",
      "replacement": "if (command.kind !== \"conditional\") io = await this.redirect(command.redirects, state, io, inputs, outputs, command.kind === \"subshell\", command.kind !== \"subshell\");",
      "script": "novel.mjs",
      "environment": {
        "NOVEL_CASE": "N10"
      },
      "qualification": "Omits conditional redirect admission, rather than a claim of every late-order mutation."
    },
    {
      "id": "M05",
      "path": "dist/shell/conditional.js",
      "pattern": "if \\(!isFsError\\(error\\)\\)\\s+throw error;",
      "replacement": "if (!isFsError(error)) return false;",
      "script": "conditional.mjs",
      "environment": {
        "CONDITIONAL_CASE": "S12-untyped"
      },
      "qualification": "Unexpected plain-object/Error errno falsely mapped to condition false."
    },
    {
      "id": "M06",
      "path": "dist/shell/shell.js",
      "pattern": "throw selection\\.outcome\\.reason;",
      "replacement": "throw new Error(\"lost caller identity\");",
      "script": "conditional.mjs",
      "environment": {
        "CONDITIONAL_CASE": "H01"
      },
      "qualification": "Inherited public caller-boundary identity guard; not new conditional resource ownership."
    },
    {
      "id": "M07",
      "path": "dist/shell/parser.js",
      "pattern": "this\\.error\\(\"Expected conditional operand\"\\);",
      "replacement": "return { parts: [{ kind: \"literal\", value: \"\", quoted: false }], plain: \"\" };",
      "script": "novel.mjs",
      "environment": {
        "NOVEL_CASE": "N03"
      },
      "qualification": "Malformed skipped RHS silently acquires empty operand."
    },
    {
      "id": "M08",
      "path": "dist/shell/conditional.js",
      "pattern": "if \\(node\\.operator === \"=~\" \\|\\|",
      "replacement": "if (node.operator === \"=~\") return true; if (node.operator === \"=~\" ||",
      "script": "novel.mjs",
      "environment": {
        "NOVEL_CASE": "N09"
      },
      "qualification": "Unsupported regex silently accepted; no actual Worker/native regex."
    },
    {
      "id": "M09",
      "path": "dist/shell/conditional.js",
      "pattern": "if \\(digit < 0 \\|\\| digit >= base\\)\\s+unsupported\\(\"numeric expression or literal\"\\);",
      "replacement": "if (digit < 0 || digit >= base) return 0n;",
      "script": "novel.mjs",
      "environment": {
        "NOVEL_CASE": "N08"
      },
      "qualification": "Invalid expression-text fallback accepted; no injected arithmetic writer/host eval."
    },
    {
      "id": "M10",
      "path": "dist/shell/parser.js",
      "pattern": "if \\(nodes >= 4096\\)",
      "replacement": "if (false)",
      "script": "conditional.mjs",
      "environment": {
        "CONDITIONAL_CASE": "H08"
      },
      "qualification": "Grammar node-cap removal, inputs bounded at4097 nodes."
    }
