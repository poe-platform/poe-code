const result = { cases: rows, pass: rows.filter(row => row.pass).length, fail: rows.filter(row => !row.pass).length, nativeRuns: 0, privateRuns: 0 };
await fs.writeFile(process.env.PUBLIC_RESULT, JSON.stringify(result, null, 2) + '\n');
