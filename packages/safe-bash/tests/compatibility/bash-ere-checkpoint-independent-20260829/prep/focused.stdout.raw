30: export async function admitAscii(text: string, ledger: EreLedger, signal?: AbortSignal): Promise<void> {
31:   for (let offset = 0; offset < text.length; offset++) {
32:     ledger.charge("work", 1, signal);
33:     const code = text.charCodeAt(offset);
34:     if (code === 0 || code > 127) throw new EreUnsupportedError("only non-NUL ASCII in the C/POSIX profile", offset);
35:     await ledger.checkpoint(signal);
36:   }
37: }
38: 
39: async function flatten(input: string | readonly EreFragment[], ledger: EreLedger, signal?: AbortSignal): Promise<{ pattern: string; quoted: readonly boolean[] | null }> {
40:   if (typeof input === "string") {
41:     ledger.admitInput("patternBytes", input.length, signal);
42:     await admitAscii(input, ledger, signal);
43:     return { pattern: input, quoted: null };
44:   }
45:   let size = 0;
46:   for (const fragment of input) {
47:     if (typeof fragment.text !== "string" || typeof fragment.literal !== "boolean") throw new TypeError("invalid ERE fragment");
48:     ledger.charge("work", 1, signal);
49:     ledger.admitInput("patternBytes", fragment.text.length, signal);
50:     await admitAscii(fragment.text, ledger, signal);
51:     if (fragment.text.length > ledger.limits.patternBytes - size) ledger.admitInput("patternBytes", ledger.limits.patternBytes + 1, signal);
52:     size += fragment.text.length;
53:     ledger.admitInput("patternBytes", size, signal);
54:   }
55:   ledger.charge("allocationUnits", size * 2 + input.length + 2, signal);
56:   const output: string[] = [];
57:   const quoted: boolean[] = [];
58:   for (const fragment of input) {
59:     for (let offset = 0; offset < fragment.text.length; offset++) {
60:       ledger.charge("work", 1, signal);
61:       await ledger.checkpoint(signal);
62:       quoted.push(fragment.literal);
63:     }
64:     output.push(fragment.text);
65:     await ledger.checkpoint(signal);
66:   }
67:   return { pattern: output.join(""), quoted: Object.freeze(quoted) };
68: }
