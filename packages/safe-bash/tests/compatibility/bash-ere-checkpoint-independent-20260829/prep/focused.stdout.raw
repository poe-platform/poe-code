5: interface History {
6:   readonly span: EreSpan;
7:   readonly previous: History | null;
8:   readonly count: number;
9: }
10: 
11: type Task =
12:   | { readonly kind: "node"; readonly node: EreNode; readonly next: Task | null }
13:   | { readonly kind: "close"; readonly group: number; readonly start: number; readonly next: Task | null }
14:   | { readonly kind: "repeat"; readonly node: Extract<EreNode, { kind: "repeat" }>; readonly count: number; readonly previous: number; readonly next: Task | null };
15: 
16: interface State {
17:   readonly position: number;
18:   readonly task: Task | null;
19:   readonly captures: readonly (EreSpan | null)[];
20:   readonly histories: readonly (History | null)[];
21: }
22: 
23: function spanOrder(left: EreSpan | null, right: EreSpan | null): number {
24:   if (left === null) return right === null ? 0 : -1;
25:   if (right === null) return 1;
26:   const length = left.end - left.start - (right.end - right.start);
27:   return length === 0 ? right.start - left.start : length;
28: }
29: 
30: async function historyOrder(left: History | null, right: History | null, ledger: EreLedger, signal?: AbortSignal): Promise<number> {
31:   const leftCount = left?.count ?? 0;
32:   const rightCount = right?.count ?? 0;
33:   for (let ordinal = 1; ordinal <= Math.min(leftCount, rightCount); ordinal++) {
34:     ledger.charge("work", 1, signal);
35:     await ledger.checkpoint(signal);
36:     let leftEntry = left!;
37:     let rightEntry = right!;
38:     for (let remaining = leftCount; remaining > ordinal; remaining--) {
39:       ledger.charge("work", 1, signal);
40:       await ledger.checkpoint(signal);
41:       leftEntry = leftEntry.previous!;
42:     }
43:     for (let remaining = rightCount; remaining > ordinal; remaining--) {
44:       ledger.charge("work", 1, signal);
45:       await ledger.checkpoint(signal);
46:       rightEntry = rightEntry.previous!;
47:     }
48:     const compared = spanOrder(leftEntry.span, rightEntry.span);
49:     if (compared !== 0) return compared;
50:   }
51:   return leftCount - rightCount;
52: }
53: 
54: async function preferred(candidate: State, incumbent: State, ledger: EreLedger, signal?: AbortSignal): Promise<boolean> {
55:   if (candidate.position !== incumbent.position) return candidate.position > incumbent.position;
56:   for (let group = 1; group < candidate.captures.length; group++) {
57:     ledger.charge("work", 1, signal);
58:     const compared = await historyOrder(candidate.histories[group]!, incumbent.histories[group]!, ledger, signal);
59:     if (compared !== 0) return compared > 0;
60:   }
61:   return false;
62: }
