1: import { EreSyntaxError, EreUnsupportedError } from "./errors.js";
2: import { EreLedger } from "./limits.js";
3: import type { EreFragment, EreNode, EreProgram } from "./types.js";
4: 
5: const programs = new WeakMap<EreProgram, { root: EreNode; ledger: EreLedger }>();
6: const special = "\\.^$[]()|*+?{}";
7: const classes = new Set(["alnum", "alpha", "blank", "cntrl", "digit", "graph", "lower", "print", "punct", "space", "upper", "xdigit"]);
8: 
9: function classMember(name: string, code: number): boolean {
10:   const upper = code >= 65 && code <= 90;
11:   const lower = code >= 97 && code <= 122;
12:   const digit = code >= 48 && code <= 57;
13:   switch (name) {
14:     case "alnum": return upper || lower || digit;
15:     case "alpha": return upper || lower;
16:     case "blank": return code === 9 || code === 32;
17:     case "cntrl": return code < 32 || code === 127;
18:     case "digit": return digit;
19:     case "graph": return code >= 33 && code <= 126;
20:     case "lower": return lower;
21:     case "print": return code >= 32 && code <= 126;
22:     case "punct": return code >= 33 && code <= 126 && !upper && !lower && !digit;
23:     case "space": return code === 32 || code >= 9 && code <= 13;
24:     case "upper": return upper;
25:     case "xdigit": return digit || code >= 65 && code <= 70 || code >= 97 && code <= 102;
26:     default: return false;
27:   }
28: }
