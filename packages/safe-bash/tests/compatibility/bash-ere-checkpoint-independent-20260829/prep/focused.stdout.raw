66:   const root = resolveEreProgram(program, ledger);
67:   ledger.admitInput("subjectBytes", subject.length, signal);
68:   await admitAscii(subject, ledger, signal);
69:   const width = program.groups + 1;
70:   ledger.charge("allocationUnits", width * 2 + 1, signal);
71:   const emptyCaptures: readonly (EreSpan | null)[] = Object.freeze(new Array<EreSpan | null>(width).fill(null));
72:   const emptyHistories: readonly (History | null)[] = Object.freeze(new Array<History | null>(width).fill(null));
73:   const pending: State[] = [];
74:   const task = (create: () => Task): Task => {
75:     ledger.charge("allocationUnits", 5, signal);
76:     return create();
77:   };
78:   const push = (position: number, next: Task | null, captures: readonly (EreSpan | null)[], histories: readonly (History | null)[]): void => {
79:     ledger.charge("states", 1, signal);
80:     ledger.charge("allocationUnits", 5, signal);
81:     pending.push({ position, task: next, captures, histories });
82:   };
83:   for (let start = 0; start <= subject.length; start++) {
84:     push(start, task(() => ({ kind: "node", node: root, next: null })), emptyCaptures, emptyHistories);
85:     let best: State | undefined;
86:     while (pending.length > 0) {
87:       ledger.charge("work", 1, signal);
88:       await ledger.checkpoint(signal);
89:       const state = pending.pop()!;
90:       const current = state.task;
91:       if (current === null) {
92:         if (!best || await preferred(state, best, ledger, signal)) best = state;
93:         continue;
94:       }
95:       if (current.kind === "close") {
96:         ledger.charge("allocationUnits", width * 2 + 6, signal);
97:         const span = Object.freeze({ start: current.start, end: state.position });
98:         const captures = state.captures.slice();
99:         captures[current.group] = span;
100:         const histories = state.histories.slice();
101:         const previous = histories[current.group]!;
102:         histories[current.group] = { span, previous, count: (previous?.count ?? 0) + 1 };
103:         push(state.position, current.next, captures, histories);
104:         continue;
105:       }
106:       if (current.kind === "repeat") {
107:         const { node, count } = current;
108:         if (count >= node.min) push(state.position, current.next, state.captures, state.histories);
