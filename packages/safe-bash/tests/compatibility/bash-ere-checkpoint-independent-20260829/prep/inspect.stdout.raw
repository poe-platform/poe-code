18: const bounds = { maxExpansionBytes: 1048576, maxExpansionFields: 8192 };
19: class ObservedLedger extends EreLedger {
20:   units = 0; previous = 0; maximum = 0; calls = 0; observer;
21:   charge(resource, amount, signal) { super.charge(resource, amount, signal); if (resource === 'work' && amount === 1) this.units++; }
22:   async checkpoint(signal) {
23:     this.maximum = Math.max(this.maximum, this.units - this.previous);
24:     this.previous = this.units; this.calls++;
25:     this.observer?.();
26:     await super.checkpoint(signal);
27:   }
28:   finish() { this.maximum = Math.max(this.maximum, this.units - this.previous); }
29: }
