9: const own = dirname(fileURLToPath(import.meta.url));
10: const author = dirname(own); const repo = resolve(own, '../../../..');
11: const [mode, label] = process.argv.slice(2);
12: if (!['seal','run'].includes(mode) || !/^[A-Z0-9-]{1,40}$/.test(label ?? '')) throw new Error('explicit mode/unique label required');
13: const started = Date.now(); const deadline = started + (mode === 'seal' ? 10 : 35) * 60000;
14: const output = join(own, label); await mkdir(output);
15: const outer = await open(join(output, 'outer.jsonl'), 'wx');
16: let active = 0, count = 0, peak = 0, captureBytes = 0;
