45:   const chunks = { stdout: [], stderr: [] }; const writes = [];
46:   let failure, timer; let size = 0;
47:   const worker = spawn(process.execPath, args, { cwd, env: { PATH: '/usr/bin:/bin', LANG: 'C', LC_ALL: 'C', HOME: output }, stdio: ['ignore','pipe','pipe'] });
48:   active++; peak = Math.max(peak, active);
49:   const closed = new Promise(resolveClose => {
50:     worker.once('error', error => { failure ??= error; });
51:     worker.once('close', (code, signal) => { active--; clearTimeout(timer); resolveClose({ code, signal }); });
52:   });
53:   for (const [channel, handle] of [['stdout',out],['stderr',err]]) worker[channel].on('data', bytes => {
54:     size += bytes.length; captureBytes += bytes.length;
55:     if (size > 8 * 1024 * 1024 || captureBytes > 128 * 1024 * 1024) { failure ??= new Error('SAFETY capture cap'); worker.kill('SIGKILL'); return; }
56:     chunks[channel].push(bytes); writes.push(handle.write(bytes).catch(error => { failure ??= error; worker.kill('SIGKILL'); }));
57:   });
58:   timer = setTimeout(() => { failure ??= new Error('SAFETY deadline/child timeout'); worker.kill('SIGKILL'); }, Math.min(timeout, Math.max(1, deadline - Date.now())));
59:   try { await event({ event: 'spawn', role, pid: worker.pid ?? null, args, cwd }); } catch (error) { failure ??= error; worker.kill('SIGKILL'); }
60:   const terminal = await closed; await Promise.all(writes); await out.close(); await err.close();
61:   const receipt = { role, pid: worker.pid ?? null, args, ...terminal, size, retired: true }; receipts.push(receipt); await event({ event: 'close', ...receipt });
62:   if (failure || terminal.signal) throw failure ?? new Error('SAFETY unexpected signal'); time();
63:   return { ...receipt, stdout: Buffer.concat(chunks.stdout).toString('utf8'), stderr: Buffer.concat(chunks.stderr).toString('utf8') };
64: }
