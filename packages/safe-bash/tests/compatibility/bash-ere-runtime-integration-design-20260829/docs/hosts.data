{
  "status":"ALL_UNRUN",
  "protocols":[
    {"id":"H01","name":"preabort-before-acquisition","procedure":"Use each bounded falsy/object caller reason; reached regex must preserve identity with no Worker acquisition or BASH_REMATCH publication. Skipped regex must not create a session either."},
    {"id":"H02","name":"abort-owned-worker","procedure":"Gate an admitted actual matcher job, abort caller, observe exact reason and registered job/session retirement before public settlement. Gate/release must not create circular cleanup. No opaque-provider ownership inference."},
    {"id":"H03","name":"grammar-and-logical-limits","procedure":"Preseal exact boundary/one-over group/node/depth/interval fixtures and modest branching work/state exhaustion. Check preallocation refusals, no partial match/capture publication and no parent Budget reset; do not use oversized bombs."},
    {"id":"H04","name":"capture-ledger","procedure":"Preseal sums of nested overlapping captures, target replacement with old snapshots alive, F/metadata/ticket boundaries and retirement failures. Distinguish worker envelope, private array ledger and E_command; no lowered-private-hook result presented as default proof."},
    {"id":"H05","name":"concurrent-stale-and-readonly","procedure":"Gate between post-operand target snapshot and publication; mutate through actual context.invoke to readonly/unrelated epoch/local restoration. Caller wins, then readonly before stale. No retry/state injection as public proof."},
    {"id":"H06","name":"diagnostic-sink-and-cleanup","procedure":"Reject/gate exact redirected diagnostic sink for syntax and readonly routes, combine caller and registered cleanup errors, retain primary reason/backpressure. No false/no-match conversion; no blanket expected status1."},
    {"id":"H07","name":"reply-and-loaded-binding","procedure":"Finite wrong id/operation/group count/span/UTF8 boundary/extra key/late reply controls; actual fixed Worker/package moved-origin denial and different-source hash refusal. Count lifecycle separately from semantic capture proof."},
    {"id":"H08","name":"shared-budget-and-snapshots","procedure":"Two internal conditional descendants/context.invoke share admitted work and array ledger; fresh independent public exec uses established fresh boundary. Verify ordinary local, global and cloned state, recursive calls and byte-exact capture reads. Do not infer cross-exec RSS bounds."}
  ]
}
