{
  "status":"ALL_UNRUN",
  "purpose":"Neutral future reference recipes, not goldens or product passes. Each future run must record stdout/stderr/status/capture presence separately; C profile except explicit locale boundary rows. No executor authorized by this file.",
  "programs":[
    {"id":"R01","script":"LC_ALL=C; re='(ab)([0-9]+)'; [[ xab42y =~ $re ]]; printf '%s:<%s>:<%s>:<%s>\\n' \"$?\" \"${BASH_REMATCH[0]}\" \"${BASH_REMATCH[1]}\" \"${BASH_REMATCH[2]}\"","question":"substring start and every capture"},
    {"id":"R02","script":"LC_ALL=C; re='a|aa'; [[ aa =~ $re ]]; printf '%s:<%s>\\n' \"$?\" \"${BASH_REMATCH[0]}\"","question":"overall longest rather than first alternative"},
    {"id":"R03","script":"LC_ALL=C; re='(a|aa)(a?)'; [[ aa =~ $re ]]; printf '<%s>\\n' \"${BASH_REMATCH[@]}\"","question":"capture tie disambiguation"},
    {"id":"R04","script":"LC_ALL=C; re='(a*)(a*)'; [[ aaa =~ $re ]]; printf '<%s>\\n' \"${BASH_REMATCH[@]}\"","question":"left subexpression priority"},
    {"id":"R05","script":"LC_ALL=C; re='((ab)+)(c?)'; [[ ababc =~ $re ]]; printf '<%s>\\n' \"${BASH_REMATCH[@]}\"","question":"nested repeated captures"},
    {"id":"R06","script":"LC_ALL=C; re='(a(b)?)+'; [[ aba =~ $re ]]; printf '<%s>\\n' \"${BASH_REMATCH[@]}\"","question":"last repetition nested participation"},
    {"id":"R07","script":"LC_ALL=C; re='(a)?(b*)'; [[ '' =~ $re ]]; printf '<%s>\\n' \"${BASH_REMATCH[@]}\"; [[ -v BASH_REMATCH[2] ]]; printf '%s\\n' \"$?\"","question":"unmatched versus empty captures and dense publication"},
    {"id":"R08","script":"LC_ALL=C; re='(a*)*'; [[ b =~ $re ]]; printf '<%s>\\n' \"${BASH_REMATCH[@]}\"","question":"nullable repetition, proposed product exclusion"},
    {"id":"R09","script":"LC_ALL=C; re='^a$'; [[ ba =~ $re ]]; printf '%s\\n' \"$?\"; [[ a =~ $re ]]; printf '%s\\n' \"$?\"","question":"anchors use whole subject boundaries"},
    {"id":"R10","script":"LC_ALL=C; re='(a.b)'; [[ $'a\\nb' =~ $re ]]; printf '%s:<%s>\\n' \"$?\" \"${BASH_REMATCH[1]}\"","question":"no REG_NEWLINE line splitting"},
    {"id":"R11","script":"LC_ALL=C; [[ axb =~ a\".\"b ]]; printf '%s\\n' \"$?\"; [[ a.b =~ a\".\"b ]]; printf '%s\\n' \"$?\"","question":"quoted fragment dot remains literal"},
    {"id":"R12","script":"LC_ALL=C; re='a.b'; [[ axb =~ \"$re\" ]]; printf '%s\\n' \"$?\"; [[ axb =~ $re ]]; printf '%s\\n' \"$?\"","question":"quoted expansion versus unquoted regex"},
    {"id":"R13","script":"LC_ALL=C; [[ '$a{2}' =~ \"$\"a\"{2}\" ]]; printf '%s\\n' \"$?\"","question":"quoted dollar/braces absent from old glob escaping"},
    {"id":"R14","script":"LC_ALL=C; re='[[:alpha:]][[:digit:]]'; [[ A7 =~ $re ]]; printf '%s\\n' \"$?\"","question":"ASCII named classes"},
    {"id":"R15","script":"LC_ALL=C; re='[^a-c]+'; [[ abcXYZ =~ $re ]]; printf '<%s>\\n' \"${BASH_REMATCH[0]}\"","question":"negated bracket range"},
    {"id":"R16","script":"LC_ALL=C; re='([]-]+)'; [[ '--]' =~ $re ]]; printf '<%s>\\n' \"${BASH_REMATCH[@]}\"","question":"bracket initial closing bracket and trailing hyphen"},
    {"id":"R17","script":"LC_ALL=C; re='(ab){2,3}'; [[ abababab =~ $re ]]; printf '<%s>\\n' \"${BASH_REMATCH[@]}\"","question":"interval whole length and final capture"},
    {"id":"R18","script":"LC_ALL=C; re='a{3,2}'; BASH_REMATCH=(old); [[ aa =~ $re ]]; printf '%s:<%s>\\n' \"$?\" \"${BASH_REMATCH[0]}\"","question":"invalid interval status and preservation"},
    {"id":"R19","script":"LC_ALL=C; re='('; BASH_REMATCH=(old); [[ a =~ $re ]]; printf '%s:<%s>\\n' \"$?\" \"${BASH_REMATCH[0]}\"","question":"runtime compile failure status and prior state"},
    {"id":"R20","script":"LC_ALL=C; BASH_REMATCH=(old); [[ yes || a =~ $(printf '(') ]]; printf '<%s>\\n' \"${BASH_REMATCH[0]}\"","question":"skipped expansion and invalid regex never compile"},
    {"id":"R21","script":"LC_ALL=C; [[ yes || a =~ ( ]]; printf 'after\\n'","question":"shell structural syntax is parsed even in skipped branch"},
    {"id":"R22","script":"LC_ALL=C; BASH_REMATCH=(old tail); [[ a =~ z ]]; printf '%s\\n' \"$?\"; printf '<%s>\\n' \"${BASH_REMATCH[@]}\"; [[ -v BASH_REMATCH[0] ]]; printf '%s\\n' \"$?\"","question":"valid nonmatch clears captures"},
    {"id":"R23","script":"LC_ALL=C; re='(a)'; [[ ! a =~ $re ]]; printf '%s:<%s>\\n' \"$?\" \"${BASH_REMATCH[1]}\"","question":"negation affects status not successful capture publication"},
    {"id":"R24","script":"LC_ALL=C; BASH_REMATCH=(global); f(){ local BASH_REMATCH; [[ abc =~ (b) ]]; printf 'in:<%s>\\n' \"${BASH_REMATCH[1]}\"; }; f; printf 'out:<%s>\\n' \"${BASH_REMATCH[0]}\"","question":"5.3 local binding versus manual global claim"},
    {"id":"R25","script":"LC_ALL=C; BASH_REMATCH=(saved); readonly BASH_REMATCH; [[ abc =~ (b) ]]; printf '%s:<%s>\\n' \"$?\" \"${BASH_REMATCH[0]}\"","question":"readonly diagnostic and regex status"},
    {"id":"R26","script":"LC_ALL=C; export BASH_REMATCH=saved; [[ a =~ (a) ]]; printf '%s:<%s>\\n' \"$?\" \"${BASH_REMATCH[1]}\"","question":"exported scalar conversion policy gap"},
    {"id":"R27","script":"LC_ALL=C; BASH_REMATCH=(outer); ( [[ abc =~ (b) ]]; printf 'sub:<%s>\\n' \"${BASH_REMATCH[1]}\" ); printf 'parent:<%s>\\n' \"${BASH_REMATCH[0]}\"","question":"subshell snapshot isolation"},
    {"id":"R28","script":"LC_ALL=C; f(){ if [[ $1 =~ (a+) ]]; then printf '<%s>\\n' \"${BASH_REMATCH[1]}\"; fi; }; f aa; f a; printf 'last:<%s>\\n' \"${BASH_REMATCH[1]}\"","question":"same-state functions overwrite last captures without hidden stack"},
    {"id":"R29","script":"LC_ALL=C; re='(a)\\1'; [[ aa =~ $re ]]; printf '%s:<%s>\\n' \"$?\" \"${BASH_REMATCH[1]}\"","question":"ERE backreference libc extension, proposed refusal"},
    {"id":"R30","script":"LC_ALL=C; re='[[.a.]]'; [[ a =~ $re ]]; printf '%s\\n' \"$?\"","question":"collating-symbol gap"},
    {"id":"R31","script":"LC_ALL=C; re='(.)'; [[ 雪 =~ $re ]]; printf '%s:<%s>\\n' \"$?\" \"${BASH_REMATCH[1]}\"","question":"byte capture split cannot be normalized into JS string"},
    {"id":"R32","script":"LC_ALL=C; n=0; [[ $((n+=1)) =~ ([0-9]) ]]; printf '%s:<%s>\\n' \"$n\" \"${BASH_REMATCH[1]}\"","question":"arithmetic expansion exactly once, no new arithmetic regex parser"}
  ]
}
