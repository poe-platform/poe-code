const result = { status: 'DATA_PREPARED', pid: process.pid, originalDependencies: originals, sourceRoot: repositoryRoot, syntaxChecks: 2, inventory: members, entrySha256: digest(Buffer.from(source)), rootBindingSha256: digest(read(controls + '/root-binding.mjs')), inheritedExecutionSealSha256: inheritedSealSha256, inheritedSealMetadata, productImports: 0, Workers: 0, finishedMs: Date.now() };
