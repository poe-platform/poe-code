import {strict as assert} from 'node:assert';import {registerHooks} from 'node:module';import {writeFileSync,readFileSync,lstatSync} from 'node:fs';import {fileURLToPath,pathToFileURL} from 'node:url';import {join,relative} from 'node:path';import {types as utilTypes} from 'node:util';import {state,joinWorkers} from './bridge-state.mjs';import {read,sha} from './data-support.mjs';
const own=fileURLToPath(new URL('.',import.meta.url));const loads=[];let root,session,owner;const jobs=[];let primary={present:false};let cleanup={present:false};let expectedCleanupFailure=false;let assertions=false;let config;let hooks;
const settle=promise=>Promise.resolve(promise).then(value=>({ok:true,value}),value=>({ok:false,value}));
function summary(value){if(value===null||typeof value!=='object')return{kind:typeof value,present:true,value:typeof value==='string'?value.slice(0,128):typeof value==='number'&&Number.isFinite(value)||typeof value==='boolean'?value:null};if(utilTypes.isProxy(value))return{kind:'proxy',present:true};const output={kind:'object',present:true};for(const key of ['name','message','code','resource']){const descriptor=Object.getOwnPropertyDescriptor(value,key);if(descriptor&&Object.hasOwn(descriptor,'value')&&typeof descriptor.value==='string')output[key]=descriptor.value.slice(0,256);}return output;}
try{
 const bytes=read(join(own,'CASE.json'),65536);if(sha(bytes)!==process.argv[2])throw Error('case binding');config=JSON.parse(bytes);state.mode=config.id;state.expectedURL=pathToFileURL(join(own,'package','ere','transport','worker-entry.js')).href;const rootURL=pathToFileURL(join(own,'package','ere','transport','root.js')).href;const ownerURL=pathToFileURL(join(own,'package','ere','transport','owner.js')).href;
 for(const row of config.modules){const path=join(own,row.path);const actual=read(path,65536);if(actual.length!==row.size||sha(actual)!==row.sha256)throw Error('case module admission');}
 hooks=registerHooks({resolve(specifier,context,next){if(context.parentURL===ownerURL&&specifier==='node:worker_threads')return{url:pathToFileURL(join(own,'worker-bridge.mjs')).href,shortCircuit:true};if(config.id==='L05/reply-then-parent-abort'&&context.parentURL===rootURL&&specifier==='./validation.js')return{url:pathToFileURL(join(own,'validation-observer.mjs')).href,shortCircuit:true};if(specifier.startsWith('node:')){const importer=relative(own,fileURLToPath(context.parentURL));if(!config.builtins[importer]?.includes(specifier))throw Error('parent builtin edge');}return next(specifier,context);},load(url,context,next){if(url.startsWith('node:'))return next(url,context);const path=fileURLToPath(url),name=relative(own,path);const expected=config.modules.find(row=>row.path===name);if(!expected)throw Error('unbound parent load');const data=read(path,65536);if(sha(data)!==expected.sha256)throw Error('load drift');const result=next(url,context);if(sha(Buffer.from(result.source))!==expected.sha256)throw Error('actual parent load mismatch');if(loads.length>=32)throw Error('load census cap');loads.push({name,sha256:expected.sha256});return result;}});
 const {EreTransportRoot}=await import(rootURL);const accounting=await import(pathToFileURL(join(own,'package','ere','transport','accounting.js')).href);const validation=await import(pathToFileURL(join(own,'package','ere','transport','validation.js')).href);const bounds={maxExpansionBytes:4096,maxExpansionFields:config.id==='P08/profile-limit-usage'?0:64};const input=(text='a',subject='a')=>({pattern:[{text,literal:false}],subject});const code=(value,expected)=>assert.equal(value?.code,expected);const execute=(value=input(),signal)=>{const promise=session.execute(value,signal);jobs.push(promise);void promise.catch(()=>{});return promise;};
 if(config.id==='L01/register-throws'){let caught=await settle(Promise.resolve().then(()=>new EreTransportRoot(bounds,()=>{throw false})));assert.equal(caught.ok,false);assert.equal(caught.value,false);assert.equal(state.constructed,0);}
 else if(config.id.startsWith('B03/')){if(config.id.endsWith('/zero'))assert.equal(accounting.add(0,0),0);else if(config.id.endsWith('/exact-boundary'))assert.equal(accounting.add(Number.MAX_SAFE_INTEGER,0),Number.MAX_SAFE_INTEGER);else assert.throws(()=>accounting.add(Number.MAX_SAFE_INTEGER,1));assert.equal(state.constructed,0);}
 else if(config.id.startsWith('P05/')){const engine=new accounting.EngineAccounting(bounds);const request={version:1,operation:'shell-ere',id:1,grantId:1,profile:'ascii-c-posix-v1',bounds,allowance:engine.limits,pattern:[{text:'a',literal:false}],subject:'a'};let observations=0;const frame={version:1,operation:'shell-ere',id:1,grantId:1,kind:'result',result:{matched:false,groupCount:0,spans:[null],steps:1,allocatedUnits:0},usage:{patternBytes:1,subjectBytes:1,work:1,states:0,allocationUnits:0,captureBytes:0,captureSlots:0}};let tested=frame;if(config.id.endsWith('/getter'))Object.defineProperty(frame,'result',{get(){observations++;throw false}});else if(config.id.endsWith('/proxy'))tested=new Proxy(frame,{ownKeys(){observations++;throw false},getOwnPropertyDescriptor(){observations++;throw false}});else frame[Symbol('extra')]=true;assert.throws(()=>validation.validateReply(tested,request,()=>{}));assert.equal(observations,0);assert.equal(state.constructed,0);}
 else if(config.id==='L08/termination-rejects-undefined'){const {EreWorkerOwner}=await import(ownerURL);owner=new EreWorkerOwner(()=>{},new accounting.TransportAccounting(new accounting.EngineAccounting(bounds).limits));await owner.start();const closing=owner.close();const outcome=await settle(closing);assert.equal(outcome.ok,false);assert.equal(outcome.value,undefined);assert.equal(owner.close(),closing);expectedCleanupFailure=true;assert.equal(state.rescues,1);}
 else{
  root=new EreTransportRoot(bounds,()=>{});session=root.openSession(()=>{});
  if(config.id==='L01/closed-before-activation'){await root.close();const outcome=await settle(execute());assert.equal(outcome.ok,false);code(outcome.value,'CLOSED');assert.equal(state.constructed,0);}
  else if(config.id==='L03/queued-abort-false'){const first=execute();await state.firstPost;const control=new AbortController();const queued=[];for(let index=0;index<64;index++)queued.push(execute(input(),index===0?control.signal:undefined));const overflow=await settle(execute());assert.equal(overflow.ok,false);assert.equal(overflow.value.resource,'queueTickets');control.abort(false);const cancelled=await settle(queued[0]);assert.equal(cancelled.ok,false);assert.equal(cancelled.value,false);assert.equal((await first).matched,true);for(const promise of queued.slice(1))assert.equal((await promise).matched,true);assert.equal(state.postCount,64);}
  else if(config.id==='L04/active-abort-zero'||config.id==='L09/instrumented-publication-rejects'){const control=new AbortController();let publication;let publicationSettled=false;if(config.id.startsWith('L09/'))publication=Promise.resolve().then(()=>{throw undefined}).finally(()=>{publicationSettled=true});if(publication)void publication.catch(()=>{});const active=execute(input(),control.signal);await state.firstPost;control.abort(config.id.startsWith('L04/')?0:false);const outcome=await settle(active);assert.equal(outcome.ok,false);assert.equal(outcome.value,control.signal.reason);if(publication){const observed=await settle(publication);assert.equal(observed.ok,false);assert.equal(observed.value,undefined);assert.equal(publicationSettled,true);}}
  else if(config.id==='L05/reply-then-parent-abort'){const control=new AbortController();state.afterValidation=()=>control.abort(false);const outcome=await settle(execute(input(),control.signal));assert.equal(outcome.ok,false);assert.equal(outcome.value,false);const usage=root.usage.engine;assert.ok(usage.work>=259&&usage.work<131072);}
  else if(config.id==='B05/failed-syntax-then-job'){const failed=await settle(execute(input('(')));assert.equal(failed.ok,false);assert.equal(failed.value.category,'syntax');const spent=root.usage.engine.work;assert.ok(spent>=259);assert.equal((await execute()).matched,true);assert.ok(root.usage.engine.work>spent);assert.equal(state.constructed,1);assert.equal(state.postCount,2);}
  else if(config.id==='B06/input-mutation-after-admission'){const value=input();const pending=execute(value);value.pattern[0].text='z';value.pattern.push({text:'z',literal:false});assert.equal((await pending).matched,true);}
  else if(config.id==='P01/matched-vector'){const result=await execute(input('(a)(b)','ab'));assert.deepEqual(result.spans,[{start:0,end:2},{start:0,end:1},{start:1,end:2}]);assert.equal(result.groupCount,2);assert.equal(result.steps,root.usage.engine.work);assert.equal(result.allocatedUnits,root.usage.engine.allocationUnits);}
  else if(config.id==='P02/empty-versus-absent'){assert.deepEqual((await execute(input('a(b)?()','a'))).spans,[{start:0,end:1},null,{start:1,end:1}]);}
  else if(config.id==='P03/no-match-two-groups'){const result=await execute(input('(a)(b)','zz'));assert.equal(result.matched,false);assert.equal(result.groupCount,2);assert.deepEqual(result.spans,[null,null,null]);}
  else if(config.id.startsWith('P08/')){const text=config.id.includes('syntax')?'(':config.id.includes('unsupported')?'\1':'a';const outcome=await settle(execute(input(text)));assert.equal(outcome.ok,false);if(config.id.includes('profile-limit'))assert.equal(outcome.value.resource,'states');else assert.equal(outcome.value.category,config.id.includes('syntax')?'syntax':'unsupported');assert.ok(root.usage.engine.work>=259);}
  else if(config.id==='P09/duplicate'){await execute();await state.replyGate;const outcome=await settle(execute());assert.equal(outcome.ok,false);code(outcome.value,'PROTOCOL');assert.equal(root.usage.engine.work,1);}
  else if(config.id.startsWith('A02/')||config.id.startsWith('A03/')){assert.equal((await execute()).matched,true);assert.equal(state.constructed,1);}
  else{const outcome=await settle(execute(input('a',config.id==='P06/outside-overall'?'ab':'a')));assert.equal(outcome.ok,false);if(config.id.startsWith('L02/'))assert.equal(outcome.value,false);else if(config.id==='L06/startup-timeout')code(outcome.value,'STARTUP_TIMEOUT');else if(config.id==='L06/request-timeout')code(outcome.value,'REQUEST_TIMEOUT');else if(config.id==='L07/unexpected-exit')code(outcome.value,'WORKER_EXIT');else if(config.id==='L07/worker-error'||config.id==='B04/crash-unproved')assert.equal(outcome.value,state.errors[0]);else code(outcome.value,'PROTOCOL');if(config.id.startsWith('B04/')){assert.equal(root.usage.engine.work,131072);const again=await settle(execute());assert.equal(again.ok,false);assert.equal(state.constructed,1);}}
 }
 assertions=true;
}catch(reason){primary={present:true,value:reason};}
finally{
 for(const scope of [session,root,owner])if(scope){try{await scope.close();}catch(reason){if(!cleanup.present)cleanup={present:true,value:reason};}}
 await Promise.allSettled(jobs);try{await joinWorkers();}catch(reason){if(!cleanup.present)cleanup={present:true,value:reason};}
 hooks?.deregister();const retired=state.handles.every(row=>row.closed&&row.stdoutClosed&&row.stderrClosed);const expectedFailure=expectedCleanupFailure&&cleanup.present&&cleanup.value===undefined;let nested=[];if(config?.id==='A03/workerData-env-execArgv'){try{const text=read(join(own,'package','ere','transport','child-loads.jsonl'),65536).toString();nested=text.trim().split('\n').map(line=>JSON.parse(line));if(nested.length!==9||new Set(nested.map(row=>row.name)).size!==9)throw Error('actual child closure cardinality');}catch(reason){if(!primary.present)primary={present:true,value:reason};}}
 const pass=assertions&&!primary.present&&retired&&(!cleanup.present||expectedFailure)&&!state.captureFault&&state.constructed===(config?.Workers??0);const receipt={schema:1,id:config?.id??'UNADMITTED',layout:config?.layout??'UNADMITTED',pass,assertions,primary:primary.present?summary(primary.value):{present:false},cleanup:cleanup.present?summary(cleanup.value):{present:false},expectedCleanupFailure,testOwnerRetired:retired,subjectClean:!cleanup.present,WorkerStarts:state.constructed,WorkerExits:state.handles.filter(row=>row.closed).length,requests:state.postCount,testRescues:state.rescues,loads,nestedLoads:nested,trace:state.records,diagnosticIdentityClaim:false};const bytes=Buffer.from(JSON.stringify(receipt,null,2)+'\n');if(bytes.length>131072)throw Error('receipt cap');writeFileSync(join(own,'RESULT.json'),bytes,{flag:'wx'});console.log(JSON.stringify({id:receipt.id,layout:receipt.layout,pass,retired,Workers:receipt.WorkerStarts}));if(!pass)process.exitCode=retired?1:2;
}
