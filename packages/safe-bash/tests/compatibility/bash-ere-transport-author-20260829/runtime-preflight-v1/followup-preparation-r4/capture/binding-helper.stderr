let reviewEntries=0;const reviewMatches=[];async function findReview(directory,depth){clock();if(depth>4)throw Error('review depth');for(const name of readdirSync(directory).sort()){if(++reviewEntries>512)throw Error('review metadata bound');const file=join(directory,name),stat=lstatSync(file);if(stat.isSymbolicLink())throw Error('review link');if(stat.isDirectory())await findReview(file,depth+1);else if(stat.isFile()&&stat.size===1250&&name.endsWith('.json')){const bytes=read(file,1250);if(digest(bytes)===reviewHash)reviewMatches.push({path:file,size:1250,sha256:reviewHash});}}}
