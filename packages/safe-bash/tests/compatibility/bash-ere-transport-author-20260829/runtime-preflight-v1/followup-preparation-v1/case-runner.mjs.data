import {strict as assert} from 'node:assert';import {registerHooks} from 'node:module';import {readFileSync,lstatSync,writeFileSync} from 'node:fs';import {createHash} from 'node:crypto';import {fileURLToPath,pathToFileURL} from 'node:url';import {join,relative} from 'node:path';import {journal,reason} from './journal.mjs';import {state,event} from './state.mjs';
const home=fileURLToPath(new URL('.',import.meta.url));const hash=bytes=>createHash('sha256').update(bytes).digest('hex');function read(path,max=65536){const stat=lstatSync(path);if(!stat.isFile()||stat.isSymbolicLink()||stat.size>max)throw Error('input');return readFileSync(path);}const settle=promise=>Promise.resolve(promise).then(value=>({present:false,value}),value=>({present:true,value}));const waitTurn=()=>new Promise(resolve=>setImmediate(resolve));let root,session,hooks,config,caseHash;let primary={present:false},cleanup={present:false},assertions=false;const loads=[];const output={};state.journal=journal(join(home,'JOURNAL.jsonl'));event('case-entry');
try{const configBytes=read(join(home,'CASE.json'));caseHash=hash(configBytes);if(caseHash!==process.argv[2])throw Error('case hash');config=JSON.parse(configBytes);state.config={...config,workerURL:pathToFileURL(join(home,config.packageRelative,'ere/transport/worker-entry.js')).href};for(const row of config.modules){const bytes=read(join(home,row.path));if(bytes.length!==row.size||hash(bytes)!==row.sha256)throw Error('module binding');}const ownerURL=pathToFileURL(join(home,config.packageRelative,'ere/transport/owner.js')).href;hooks=registerHooks({resolve(specifier,context,next){if(specifier==='node:worker_threads'&&context.parentURL===ownerURL)return {url:new URL('./worker-bridge.mjs',import.meta.url).href,shortCircuit:true};if(specifier.startsWith('node:')){const parent=relative(home,fileURLToPath(context.parentURL));if(!config.builtins[parent]?.includes(specifier))throw Error('builtin edge');}return next(specifier,context);},load(url,context,next){if(url.startsWith('node:'))return next(url,context);const name=relative(home,fileURLToPath(url));const bound=config.modules.find(row=>row.path===name);if(!bound)throw Error('unbound module');const bytes=read(fileURLToPath(url));if(bytes.length!==bound.size||hash(bytes)!==bound.sha256)throw Error('module drift');if(loads.length>=32)throw Error('loads cap');loads.push({path:name,sha256:bound.sha256});return {format:'module',source:bytes,shortCircuit:true};}});const {EreTransportRoot}=await import(pathToFileURL(join(home,config.packageRelative,'ere/transport/root.js')).href);root=new EreTransportRoot({maxExpansionBytes:4096,maxExpansionFields:64},()=>{});state.roots.push(root);session=root.openSession(()=>{});const result=await settle(session.execute({pattern:[{text:'a',literal:false}],subject:'a'}));event('execute-settled',result.present?'rejected':'fulfilled');if(config.purpose==='normal'){assert.equal(result.present,false);assert.equal(result.value.matched,true);}else{assert.equal(result.present,true);assert.equal(result.value,false);primary={present:true,value:result.value};}const before=root.usage.transport;for(const scope of [session,root]){const closed=await settle(scope.close());event('close-settled',closed.present?'rejected':'fulfilled');if(config.purpose==='normal')assert.equal(closed.present,false);else{assert.equal(closed.present,true);assert.equal(closed.value,false);}}if(config.purpose==='persistent'){assert.equal(root.retirementState,'UNCONFIRMED');const after=root.usage.transport;assert.equal(after.live,before.live);assert.equal(after.reserved,before.reserved);assert(after.live>0);assert.equal(state.termination.present,true);assert.equal(state.termination.route,'promise-rejection');assert.equal(state.termination.value,false);output.retainedCharges=true;event('unconfirmed');}else{assert.equal(root.retirementState,'RETIRED');const until=performance.now()+1000;while(!state.handles.every(row=>row.exit&&row.stdout&&row.stderr)&&performance.now()<until)await waitTurn();assert(state.handles.every(row=>row.exit&&row.stdout&&row.stderr));event('owner-retired');}assert.equal(state.created,config.Workers);assert.equal(state.attempts,1);assertions=true;}catch(value){output.assertionFailure=reason(value);if(!primary.present)primary={present:true,value};}finally{if(root&&root.retirementState!=='UNCONFIRMED'){for(const scope of [session,root])if(scope){const outcome=await settle(scope.close());if(outcome.present&&!(primary.present&&outcome.value===primary.value)&&!cleanup.present)cleanup={present:true,value:outcome.value};}}hooks?.deregister();const retirementState=root?.retirementState??'NOT_ACQUIRED';const uncertain=retirementState==='UNCONFIRMED';let publicationFault={present:false};try{if(uncertain){event('retained-root-and-handles');writeFileSync(join(home,'EMERGENCY.json'),JSON.stringify({schema:1,kind:'UNCONFIRMED',rootRetained:state.roots.includes(root),handlesRetained:state.handles.length,ownerRetired:false,primary:primary.present?reason(primary.value):{present:false},cleanup:state.termination.present?reason(state.termination.value):{present:false},recovery:'NONE_AUTHORIZED',workerExitsObserved:state.handles.filter(row=>row.exit).length})+'\n',{flag:'wx'});}const receipt={schema:1,id:config?.id??'UNADMITTED',purpose:config?.purpose??'UNADMITTED',layout:config?.layout??'UNADMITTED',caseSha256:caseHash??'',packageSha256:config?.packageSha256??'',assertions,passed:assertions&&!uncertain&&!cleanup.present&&!state.fault.present,retirementState,primary:primary.present?reason(primary.value):{present:false},cleanup:cleanup.present?reason(cleanup.value):{present:false},termination:state.termination.present?{...reason(state.termination.value),route:state.termination.route}:{present:false},attempts:state.attempts,Workers:state.created,exits:state.handles.filter(row=>row.exit).length,stdout:state.handles.filter(row=>row.stdout).length,stderr:state.handles.filter(row=>row.stderr).length,rootRetained:state.roots.includes(root),handlesRetained:state.handles.length,retainedCharges:output.retainedCharges===true,captureFault:state.fault.present,loads,trace:state.journal.records,assertionFailure:output.assertionFailure??{present:false},nestedObservation:'NOT_OBSERVED'};event('receipt-publication');writeFileSync(join(home,'RESULT.json'),JSON.stringify(receipt)+'\n',{flag:'wx'});}catch(value){publicationFault={present:true,value};}finally{state.journal.close();}if(publicationFault.present||state.journal.fault.present)process.exitCode=2;else process.exitCode=uncertain?2:assertions&&!cleanup.present&&!state.fault.present?0:1;console.log(JSON.stringify({id:config?.id??'UNADMITTED',assertions,retirementState,publicationFault:publicationFault.present}));}
