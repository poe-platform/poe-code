import {strict as assert} from 'node:assert';
const settle=promise=>Promise.resolve(promise).then(value=>({present:false,value}),value=>({present:true,value}));
async function execute(capability,bounds,pattern,subject){const root=new capability.EreTransportRoot(bounds,capability.registerCleanup);const session=root.openSession(capability.registerCleanup);capability.retainRoot(root);const result=await settle(session.execute({pattern:[{text:pattern,literal:false}],subject}));const sessionClose=await settle(session.close());const rootClose=await settle(root.close());return {root,result,sessionClose,rootClose};}
export async function runMessageError(capability){assert.equal(capability.profile,'L07-owned-messageerror-after-post-v1');const outcome=await execute(capability,{maxExpansionBytes:4096,maxExpansionFields:64},'a','a');assert(outcome.result.present);assert.equal(outcome.result.value,false);assert.equal(outcome.sessionClose.value,false);assert.equal(outcome.rootClose.value,false);assert.equal(capability.observedPosted(),1);assert.equal(capability.observedWorkers(),1);assert.equal(outcome.root.retirementState,'RETIRED');await capability.joinObservedNativeExitAndStreams();return {proof:'injected handler route, NOT native deserialization-event proof'};}
async function capture(capability,fields,pattern,subject,resource){assert.equal(capability.profile,'B07-no-lowered-caps-v1');assert.equal(capability.preemptionProofSha256,capability.approvedPreemptionProofSha256);assert.match(capability.preemptionProofSha256,/^[0-9a-f]{64}$/);const outcome=await execute(capability,{maxExpansionBytes:4096,maxExpansionFields:fields},pattern,subject);if(!outcome.result.present)throw Error('expected profile refusal');const error=outcome.result.value;if(!(error instanceof capability.EreProfileLimitError))throw error;if(error.resource!==resource)return {status:'EARLIER_LIMIT',resource:error.resource,qualified:false};assert.equal(outcome.root.retirementState,'RETIRED');await capability.joinObservedNativeExitAndStreams();return {status:'PASS',resource,qualified:true};}
export function runCaptureBytes(capability){return capture(capability,64,'^([a]+)$','a'.repeat(2049),'captureBytes');}
export function runCaptureSlots(capability){return capture(capability,1,'(a)','a','captureSlots');}
