import {strict as assert} from 'node:assert';
export async function compareExprAndRunSelected(bound){assert.equal(bound.role,'ROOT_SELECTED_ACCEPTED_EXPR_REUSE');assert.equal(bound.sourcePairs.length,3);assert.equal(bound.consumers.length,2);for(const pair of bound.sourcePairs){const before=await bound.readAuthenticated(pair.before);const after=await bound.readAuthenticated(pair.after);assert.deepEqual(after,before);}const results=[];for(const consumer of bound.consumers){assert.equal(consumer.authorized,true);assert.match(consumer.sha256,/^[0-9a-f]{64}$/);const result=await bound.runOwnedAuthenticatedConsumer(consumer);assert.equal(result.closed,true);assert.equal(result.captureComplete,true);assert.equal(result.code,consumer.expectedCode);assert.deepEqual(result.stdout,consumer.expectedStdout);assert.deepEqual(result.stderr,consumer.expectedStderr);results.push(result);}return results;}
export function prepareTypePair(bound){assert.equal(bound.role,'ROOT_SELECTED_PUBLIC_REGEX_DECLARATION_NEGATIVE');assert.equal(bound.baselinePositiveBound,true);assert.match(bound.publicDeclarationSha256,/^[0-9a-f]{64}$/);assert.equal(typeof bound.actualPublicSpecifier,'string');assert.equal(typeof bound.validBaselineFixture,'string');assert.equal(typeof bound.singleFieldNegativeFixture,'string');assert.match(bound.expectedFieldDiagnostic,/^TS(?:2353|2322|2345)$/);assert.notEqual(bound.validBaselineFixture,bound.singleFieldNegativeFixture);return {positive:bound.validBaselineFixture,negative:bound.singleFieldNegativeFixture,expected:bound.expectedFieldDiagnostic,compilerRuns:2,missingImportIsNotPass:true};}
