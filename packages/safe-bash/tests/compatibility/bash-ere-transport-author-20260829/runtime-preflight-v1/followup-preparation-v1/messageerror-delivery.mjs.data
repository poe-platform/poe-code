export function installMessageErrorDelivery(worker,NativeWorker,record){let delivered=false;const original=worker.postMessage;worker.postMessage=function(message,...rest){const result=original.call(this,message,...rest);if(delivered)throw Error('single post required');delivered=true;queueMicrotask(()=>{record('injected-messageerror','false');NativeWorker.prototype.emit.call(worker,'messageerror',false);});return result;};return {restoreAuthority:false,proof:'injected parent handler route only'};}
