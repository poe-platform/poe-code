export class Worker extends NativeWorker{
 constructor(url,options){if(url.href!==state.expectedURL||JSON.stringify(options.workerData)!=='{"operation":"shell-ere","version":1}'||JSON.stringify(options.env)!=='{}'||JSON.stringify(options.execArgv)!=='[]'||options.stdout!==true||options.stderr!==true||options.resourceLimits.maxOldGenerationSizeMb!==128||options.resourceLimits.stackSizeMb!==4||state.constructed>=1)throw Error('unsealed Worker acquisition');state.attempts++;record({kind:'attempt'});super(url,options);let resolveExit;const row={worker:this,online:false,retired:false,closed:false,code:null,stdoutClosed:false,stderrClosed:false,exited:new Promise(resolve=>{resolveExit=resolve})};NativeWorker.prototype.once.call(this,'exit',code=>{row.closed=true;row.code=code;record({kind:'exit',code});resolveExit();});NativeWorker.prototype.on.call(this,'error',reason=>{state.errors.push(reason);record({kind:'error',present:true});});NativeWorker.prototype.once.call(this,'online',()=>{row.online=true;record({kind:'online'});});state.handles.push(row);state.constructed++;record({kind:'constructed',threadId:this.threadId});for(const [name,stream]of [['stdout',this.stdout],['stderr',this.stderr]]){row[name+'Done']=new Promise(resolve=>{stream.once('end',()=>{row[name+'Closed']=true;record({kind:name+'End'});resolve()});stream.once('close',()=>{row[name+'Closed']=true;record({kind:name+'Close'});resolve()});});}NativeWorker.prototype.on.call(this,'message',message=>{state.messages++;record({kind:'message',number:state.messages});if(state.messages>=3)state.resolveReplies();});this.once=(event,listener)=>{if(state.mode==='L02/handler-setup-throws'&&event==='exit')throw false;return NativeWorker.prototype.once.call(this,event,listener);};this.postMessage=(message,...rest)=>{state.postCount++;record({kind:'post',number:state.postCount,id:message.id});if(state.mode==='L02/postMessage-throws')throw false;const result=NativeWorker.prototype.postMessage.call(this,message,...rest);state.resolvePost();return result;};this.ter