  },
  "files": [
    "dist"
  ],
  "scripts": {
    "benchmark": "node --import tsx benchmarks/run.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "node scripts/typecheck.mjs",
    "typecheck:all": "node scripts/typecheck.mjs --build",
    "typecheck:consumers": "node scripts/typecheck.mjs --consumers",
    "test": "node --input-type=module -e \"import { globSync } from 'node:fs'; import { spawnSync } from 'node:child_process'; const files = globSync('tests/**/*.test.ts', { exclude: path => path === 'tests/commands/regex-execution/continuation/artifacts/native' }); if (!files.length) throw new Error('No test files found'); const result = spawnSync(process.execPath, ['--import', 'tsx', '--test', ...process.argv.slice(1), ...files], { stdio: 'inherit' }); process.exit(result.status ?? 1);\" --",
    "test:contracts": "node --import tsx --test \"tests/contracts/**/*.test.ts\"",
    "verify:stream-public": "node tests/plugins/stream-five-public/verify-public.mjs",
    "verify:release:qualified": "node scripts/verify-qualified-release.mjs",
    "verify:release:whole": "node scripts/verify-whole-gate.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsx": "^4.23.12",
    "typescript": "5.9"
  }
}

