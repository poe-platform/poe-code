 await test('N01',()=>{for(const key of ['BASH_ENV','ENV','SHELLOPTS','BASHOPTS','BASH_FUNC_f%%','NODE_OPTIONS']){const rows=requestClone();rows[0].environment[key]='injected';rejects(()=>admission.validateCohort(cohort,rows,runRoot));}});
 await test('N02',()=>{for(const [id,text]of [['F06','/bin/function f'],['F06','"function" f; /bin/true'],['P15','/bin/__surface_missing_command__']]){const rows=requestClone();rows.find(row=>row.id===id).argv[3]=text;rejects(()=>admission.validateCohort(cohort,rows,runRoot));}verify(cohort.cases.find(row=>row.id==='F06').program==='"function" f');verify(cohort.cases.find(row=>row.id==='P15').program==='__surface_missing_command__; printf "<%s>\\n" "${PIPESTATUS[@]}"');});
 await test('N03',()=>{rejects(()=>admission.validateGrant({...goodGrant,issuedEpochMs:now+1,deadlineEpochMs:now+2700001},now));rejects(()=>admission.validateGrant({...goodGrant,issuedEpochMs:NaN},now));rejects(()=>admission.validateGrant({...goodGrant,failedLookupNames:['__surface_missing_command__','function']},now));verify(admission.validateGrant(goodGrant,now));});
 await test('N04',()=>{const before=[{path:'work',type:'directory',mode:448}];for(const length of [0,65536])verify(observation.validateEffects('F05',before,[...before,{path:'work/out',type:'file',mode:420,base64:Buffer.alloc(length,255).toString('base64')}]));for(const base64 of ['?','eA','eA==\n'])rejects(()=>observation.validateEffects('F05',before,[...before,{path:'work/out',type:'file',mode:420,base64}]));rejects(()=>observation.validateEffects('F05',before,[{...before[0],mode:511},{path:'work/out',type:'file',mode:420,base64:''}]));});
 await test('N05',()=>{const bytes=Buffer.from([0,255,13,10]),capture=name=>({name,flush:true,size:true,hash:true,close:true,bytes:bytes.length,base64:bytes.toString('base64'),sha256:hash(bytes)});for(const status of [0,127,255]){const fields=observation.encodeObservation({id:'P15',status,capture:[capture('stderr'),capture('stdout')],filesVerified:true,filesBefore:[],filesAfter:[]}).toString().split('\0');verify(fields[2]===String(status)&&Buffer.from(fields[4],'base64').equals(bytes)&&Buffer.from(fields[6],'base64').equals(bytes));}});
 await test('N06',()=>{for(const entry of [{...seal.files[0]},{...seal.files[0],path:'x/../escape'},{...seal.files[0],path:'GO.json'},{...seal.files[0],path:'/absolute'}]){const bad=structuredClone(seal);bad.files.push(entry);rejects(()=>admission.validateManifest(bad));}});
 await test('N07',()=>{const base=scratch+'/novel-fd';fs.mkdirSync(base,{mode:448});fs.mkdirSync(base+'/outer',{mode:448});const file=base+'/outer/bootstrap.stdout';fs.writeFileSync(file,'AB',{mode:384});const fd=fs.openSync(file,'r+');try{const operations=Object.create(fs);operations.fstatSync=()=>fs.fstatSync(fd);operations.readSync=(_fd,...args)=>fs.readSync(fd,...args);operations.writeSync=(_fd,...args)=>fs.writeSync(fd,...args);verify(admission.validateOuter(base,'stdout',1,operations).ino===fs.fstatSync(fd).ino);const after=Buffer.alloc(1);fs.readSync(fd,after,0,1,null);verify(after.toString()==='A');fs.linkSync(file,base+'/linked');rejects(()=>admission.validateOuter(base,'stdout',1,operations));}finally{fs.closeSync(fd);}});
 await test('N08',()=>{const source=read(executable+'/entry.mjs').toString();verify(source.indexOf('validateCohort(audit,accepted.requests,root)')<source.indexOf('await runManaged('));verify(source.includes("fs.readdirSync(caseRoot+'/empty-path').length===0"));verify(source.includes('stat.uid===process.getuid()'));verify(!fs.existsSync(executable+'/GO.json')&&!fs.existsSync(executable+'/REVIEW-ACCEPTANCE.json'));const resolved=structuredClone(template.parameters);resolved.cmd=resolved.cmd.replace('ROOT_APPROVED_GRANT_SHA256','b'.repeat(64));rejects(()=>admission.resolveApproval(template,{...resolved,sandbox_permissions:'use_default'},'b'.repeat(64)));});
