6995:       add_unwind_protect (uw_restore_parser_state, &ps);
6996:     }
6997:       
6998: #if defined (ARRAY_VARS)
6999:   if (parsing_command == 0)
7000:     {
7001:       psa = save_pipestatus_array ();
7002:       add_unwind_protect (uw_restore_pipestatus_array, psa);
7003:     }
7004: #endif
