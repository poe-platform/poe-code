6957: 
6958:   /* Let's get an anonymous file before we really try anything else. */
6959:   if (valsub == 0)
6960:     {
6961:       afd = anonopen ("sh-nfc", 0, &afn);	/* don't use filename yet */
6962:       if (afd < 0)
6963: 	{
6964: 	  sys_error ("%s", _("function_substitute: cannot open anonymous file for output"));
6965: 	  exp_jump_to_top_level (DISCARD);		/* XXX */
6966: 	}
6967:     }
