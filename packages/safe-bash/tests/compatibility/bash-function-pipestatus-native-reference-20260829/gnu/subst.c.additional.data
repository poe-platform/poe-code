7153:   /* Don't fork () if there is no need to.  In the case of no command to
7154:      run, just return NULL. */
7155:   for (s = string; s && *s && (shellblank (*s) || *s == '\n'); s++)
7156:     ;
7157:   if (s == 0 || *s == 0)
7158:     return ((WORD_DESC *)NULL);
7159: 
7160:   if (*s == '<' && (s[1] != '<' && s[1] != '>' && s[1] != '&'))
7161:     {
7162:       COMMAND *cmd;
7163: 
7164:       cmd = parse_string_to_command (string, 0);	/* XXX - flags */
7165:       if (cmd && can_optimize_cat_file (cmd))
7166: 	{
7167: 	  tflag = 0;
7168: 	  istring = optimize_cat_file (cmd->value.Simple->redirects, quoted, flags, &tflag);
7169: 	  if (istring == &expand_param_error)
7170: 	    {
7171: 	      last_command_subst_status = EXECUTION_FAILURE;
7172: 	      istring = 0;
7173: 	    }
7174: 	  else
7175: 	    last_command_subst_status = EXECUTION_SUCCESS;	/* compat */
7176: 	  last_command_subst_pid = dollar_dollar_pid;
7177: 
7178: 	  if (posixly_correct == 0)	/* POSIX interp 1150 */
7179: 	    last_command_exit_value = last_command_subst_status;	/* XXX */
7180: 
7181: 	  dispose_command (cmd);	  
7182: 	  ret = alloc_word_desc ();
7183: 	  ret->word = istring;
7184: 	  ret->flags = tflag;
7185: 
7186: 	  return ret;
7187: 	}
7188:       dispose_command (cmd);
7189:     }
7190: 
7191:   if (wordexp_only && read_but_dont_execute)
7192:     {
7193:       last_command_exit_value = EX_WEXPCOMSUB;
7194:       jump_to_top_level (EXITPROG);
