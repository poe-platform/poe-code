7197:   /* We're making the assumption here that the command substitution will
7198:      eventually run a command from the file system.  Since we'll run
7199:      maybe_make_export_env in this subshell before executing that command,
7200:      the parent shell and any other shells it starts will have to remake
7201:      the environment.  If we make it before we fork, other shells won't
7202:      have to.  Don't bother if we have any temporary variable assignments,
7203:      though, because the export environment will be remade after this
7204:      command completes anyway, but do it if all the words to be expanded
7205:      are variable assignments. */
7206:   if (subst_assign_varlist == 0 || garglist == 0)
7207:     maybe_make_export_env ();	/* XXX */
