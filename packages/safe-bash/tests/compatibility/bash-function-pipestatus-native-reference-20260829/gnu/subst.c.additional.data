7140: /* Perform command substitution on STRING.  This returns a WORD_DESC * with the
7141:    contained string possibly quoted. */
7142: WORD_DESC *
7143: command_substitute (char *string, int quoted, int flags)
7144: {
7145:   pid_t pid, old_pid, old_pipeline_pgrp, old_async_pid;
