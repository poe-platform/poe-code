const checkTime=()=>assert(Date.now()<=deadline,'PREPARATION_DEADLINE');checkTime();
const hash=bytes=>crypto.createHash('sha256').update(bytes).digest('hex');
const blob=bytes=>crypto.createHash('sha1').update(`blob ${bytes.length}\0`).update(bytes).digest('hex');
const decode=bytes=>new TextDecoder('utf-8',{fatal:true}).decode(bytes);
const read=(filename,maximum=4194304)=>{const stat=fs.lstatSync(filename);assert(stat.isFile()&&!stat.isSymbolicLink()&&stat.size<=maximum);const descriptor=fs.openSync(filename,fs.constants.O_RDONLY|fs.constants.O_NOFOLLOW);try{const first=fs.fstatSync(descriptor);assert.equal(first.ino,stat.ino);assert.equal(first.dev,stat.dev);const bytes=fs.readFileSync(descriptor);const last=fs.fstatSync(descriptor);assert.equal(bytes.length,stat.size);assert.equal(last.mtimeMs,first.mtimeMs);assert.equal(last.size,first.size);return bytes;}finally{fs.closeSync(descriptor);}};
const write=(relative,bytes)=>{checkTime();const filename=root+'/'+relative;fs.mkdirSync(path.dirname(filename),{recursive:true,mode:448});fs.writeFileSync(filename,bytes,{flag:'wx',mode:384});};
const json=(relative,value)=>write(relative,JSON.stringify(value,null,2)+'\n');
const parse=filename=>JSON.parse(decode(read(filename)));
const executable=root+'/materialized',runRoot='/private/tmp/safe-bash-function-pipestatus-observations-20260829-v2';
