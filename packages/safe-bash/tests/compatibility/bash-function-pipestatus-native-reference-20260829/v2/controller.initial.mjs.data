function authenticateSeal(filename){const seal=parse(filename);for(const row of seal.files){const bytes=read(path.dirname(filename)+'/'+row.path);assert.equal(bytes.length,row.bytes);assert.equal(hash(bytes),row.sha256);assert.equal(fs.lstatSync(path.dirname(filename)+'/'+row.path).mode&511,row.mode);}return seal;}
async function tools(){const pins=parse(parent+'/inherited/materialized/TOOLS.json.data');for(const pin of [...pins.toolPins,pins.environmentLauncher,pins.wrapperTool]){const stat=fs.lstatSync(pin.path);assert(stat.isFile()&&stat.size===pin.bytes&&(stat.mode&511)===pin.mode);const digest=crypto.createHash('sha256');let total=0;for await(const chunk of fs.createReadStream(pin.path,{highWaterMark:65536})){digest.update(chunk);total+=chunk.length;}assert.equal(total,pin.bytes);assert.equal(digest.digest('hex'),pin.sha256);}return pins;}
function localSeal(directory,filenames,schema){return{schema,files:filenames.map(name=>{const bytes=read(directory+'/'+name);return{path:name,bytes:bytes.length,mode:fs.lstatSync(directory+'/'+name).mode&511,sha256:hash(bytes)};})};}

