 authenticateSeal(executable+'/PRESEAL.json');await tools();json('CONTROL-RESULT.json',{schema:'function-pipestatus-controls-v2',results,assertionCount,pass:results.filter(row=>row.status==='PASS').length,fail:results.filter(row=>row.status==='FAIL').length,nativeStarts:0,fixtures:2,controllerChildren:2,allKnownFixtureChildrenRetired:true,deadline});console.log(JSON.stringify({phase:'controls',pass:results.filter(row=>row.status==='PASS').length,fail:results.filter(row=>row.status==='FAIL').length,assertionCount}));process.exitCode=results.some(row=>row.status==='FAIL')?1:0;
}else if(process.argv[2]==='seal'){
 authenticateSeal(root+'/CONTROL-PRESEAL.json');authenticateSeal(executable+'/PRESEAL.json');await tools();const result=parse(root+'/CONTROL-RESULT.json');assert.equal(result.pass,12);assert.equal(result.fail,0);const files=[];const walk=(directory,prefix='')=>{for(const name of fs.readdirSync(directory).sort()){const relative=prefix+name,filename=directory+'/'+name,stat=fs.lstatSync(filename);assert(!stat.isSymbolicLink());if(stat.isDirectory())walk(filename,relative+'/');else if(!['raw/seal.stdout','raw/seal.stderr'].includes(relative)){assert(stat.isFile()&&stat.size<=4194304);files.push({path:relative,bytes:stat.size,mode:stat.mode&511,sha256:hash(read(filename))});}}};walk(root);const total=files.reduce((sum,row)=>sum+row.bytes,0);assert(total<=268435456);json('FINAL-SEAL.json',{schema:'function-pipestatus-preexecution-publication-v2',files,bytes:total,nativeStarts:0,all26Unrun:true,remaining:'different review then fresh receipt/GO/slot review/tool approval',deadline});console.log(JSON.stringify({phase:'seal',presealSha256:hash(read(executable+'/PRESEAL.json')),controlSha256:hash(read(root+'/CONTROL-RESULT.json')),finalSealSha256:hash(read(root+'/FINAL-SEAL.json')),files:files.length,bytes:total}));
}else throw Error('EXACT_CONTROLLER_MODE');
