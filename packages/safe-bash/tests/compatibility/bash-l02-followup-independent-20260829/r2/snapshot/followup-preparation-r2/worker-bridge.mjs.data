import {Worker as NativeWorker} from 'node:worker_threads';import {state,event} from './state.mjs';
export class Worker extends NativeWorker{constructor(url,options){const config=state.config;if(url.href!==config.workerURL||JSON.stringify(options.workerData)!=='{"operation":"shell-ere","version":1}'||JSON.stringify(options.env)!=='{}'||JSON.stringify(options.execArgv)!=='[]'||options.stdout!==true||options.stderr!==true||options.resourceLimits.maxOldGenerationSizeMb!==128||options.resourceLimits.stackSizeMb!==4||state.attempts!==0)throw Error('Worker admission');state.attempts++;event('attempt');if(state.fault.present)throw state.fault.value;if(config.purpose==='constructor')throw false;super(url,options);const row={worker:this,exit:false,stdout:false,stderr:false,stdoutClosed:false,stderrClosed:false,online:false};state.handles.push(row);state.created++;event('constructed');NativeWorker.prototype.once.call(this,'exit',code=>{row.exit=true;event('worker-exit',String(code));});NativeWorker.prototype.once.call(this,'online',()=>{row.online=true;event('online');});NativeWorker.prototype.on.call(this,'error',()=>event('worker-error'));for(const [name,stream]of [['stdout',this.stdout],['stderr',this.stderr]]){stream.once('end',()=>{row[name]=true;event(name+'-end');});stream.once('close',()=>{row[name+'Closed']=true;event(name+'-close');if(!row[name]&&!state.fault.present)state.fault={present:true,value:Error('EOF unobserved')};});}let delivered=false;this.once=(kind,callback)=>{if(kind==='exit'&&(config.purpose==='persistent'||config.purpose==='single'&&!delivered)){delivered=true;event('setup-fault','false');throw false;}return NativeWorker.prototype.once.call(this,kind,callback);};this.postMessage=(message,...rest)=>{state.posts++;event('post',String(message.id));if(state.fault.present)throw state.fault.value;if(config.purpose==='post')throw false;const value=NativeWorker.prototype.postMessage.call(this,message,...rest);state.posted++;event('posted',String(message.id));return value;};this.terminate=()=>{event('termination-requested');let result;try{result=NativeWorker.prototype.terminate.call(this);}catch(value){state.termination={present:true,value,route:'sync-throw'};event('termination-sync-throw',typeof value);throw value;}return Promise.resolve(result).then(value=>{event('termination-fulfilled');return value;},value=>{state.termination={present:true,value,route:'promise-rejection'};event('termination-rejected',typeof value);throw value;});};}}
