import fs from 'node:fs';import path from 'node:path';import crypto from 'node:crypto';import assert from 'node:assert/strict';import {pathToFileURL} from 'node:url';
const reviewRoot=path.dirname(new URL(import.meta.url).pathname),root='/Users/kjopek/Workspace/safe-bash/tests/compatibility/bash-pipestatus-typed-native-reference-20260829',materialized=root+'/materialized',actualRoot='/private/tmp/safe-bash-pipestatus-typed-observations-20260829-v1';
const deadline=Date.parse(JSON.parse(fs.readFileSync(reviewRoot+'/ROLE-PLAN.json')).deadline),time=()=>assert(Date.now()<deadline,'REVIEW_DEADLINE');
const hash=bytes=>crypto.createHash('sha256').update(bytes).digest('hex'),blob=bytes=>crypto.createHash('sha1').update('blob '+bytes.length+String.fromCharCode(0)).update(bytes).digest('hex'),decode=bytes=>new TextDecoder('utf-8',{fatal:true}).decode(bytes);
function read(file,max=4194304){time();const stat=fs.lstatSync(file);assert(stat.isFile()&&!stat.isSymbolicLink()&&stat.size<=max);const fd=fs.openSync(file,fs.constants.O_RDONLY|fs.constants.O_NOFOLLOW);try{const first=fs.fstatSync(fd);assert(first.ino===stat.ino&&first.dev===stat.dev);const bytes=fs.readFileSync(fd),last=fs.fstatSync(fd);assert(bytes.length===stat.size&&last.size===first.size&&last.mtimeMs===first.mtimeMs);return bytes;}finally{fs.closeSync(fd);}}
const parse=file=>JSON.parse(decode(read(file)));
function json(name,value){const file=reviewRoot+'/'+name;fs.mkdirSync(path.dirname(file),{recursive:true,mode:448});fs.writeFileSync(file,JSON.stringify(value,null,2)+'\n',{flag:'wx',mode:384});}
const inputs=parse(reviewRoot+'/INPUTS.json');
function authenticate(){for(const pin of inputs.readyFiles){const bytes=read(root+'/'+pin.path);assert.equal(bytes.length,pin.bytes);assert.equal(hash(bytes),pin.sha256);assert.equal(fs.lstatSync(root+'/'+pin.path).mode&511,pin.mode);}const auth=parse(root+'/SOURCE-AUTH.json');for(const pin of auth.parentRows){const bytes=read(inputs.parentRoot+'/'+pin.path);assert.equal(bytes.length,pin.bytes);assert.equal(hash(bytes),pin.sha256);assert.equal(blob(bytes),pin.gitBlob);assert.equal(fs.lstatSync(inputs.parentRoot+'/'+pin.path).mode&511,pin.mode);}return auth;}
async function authenticateTools(){const tools=parse(materialized+'/TOOLS.json');for(const pin of [...tools.toolPins,tools.environmentLauncher,tools.wrapperTool]){const stat=fs.lstatSync(pin.path);assert(stat.isFile()&&!stat.isSymbolicLink()&&stat.size===pin.bytes&&(stat.mode&511)===pin.mode);const fd=fs.openSync(pin.path,fs.constants.O_RDONLY|fs.constants.O_NOFOLLOW);try{const before=fs.fstatSync(fd),buffer=Buffer.alloc(65536),digest=crypto.createHash('sha256');let total=0,count;while((count=fs.readSync(fd,buffer,0,buffer.length,null))>0){total+=count;assert(total<=pin.bytes);digest.update(buffer.subarray(0,count));}assert.equal(total,pin.bytes);assert.equal(digest.digest('hex'),pin.sha256);const after=fs.fstatSync(fd);assert.equal(after.size,before.size);assert.equal(after.mtimeMs,before.mtimeMs);}finally{fs.closeSync(fd);}}}
try{authenticate();await authenticateTools();
