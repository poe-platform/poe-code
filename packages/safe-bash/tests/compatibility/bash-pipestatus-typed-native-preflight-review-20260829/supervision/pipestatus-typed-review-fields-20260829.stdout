  "sourceHead": [
    "import fs from 'node:fs';",
    "import path from 'node:path';",
    "import crypto from 'node:crypto';",
    "import assert from 'node:assert/strict';",
    "import {spawnSync} from 'node:child_process';",
    "import {pathToFileURL} from 'node:url';",
    "",
    "const root=path.dirname(new URL(import.meta.url).pathname);",
    "assert.equal(root,'/Users/kjopek/Workspace/safe-bash/tests/compatibility/bash-pipestatus-typed-native-reference-20260829');",
    "const deadline=fs.statSync(root+'/raw/startup.stdout').birthtimeMs+1200000;",
    "const time=()=>assert(Date.now()<=deadline,'PREPARATION_DEADLINE');time();",
    "const parent='/Users/kjopek/Workspace/safe-bash/tests/compatibility/bash-function-pipestatus-native-reference-20260829/v2';",
    "const materialized=root+'/materialized',actualRoot='/private/tmp/safe-bash-pipestatus-typed-observations-20260829-v1';",
    "const node='/Users/kjopek/.nvm/versions/node/v22.22.2/bin/node';",
    "const hash=bytes=>crypto.createHash('sha256').update(bytes).digest('hex');",
    "const blob=bytes=>crypto.createHash('sha1').update(`blob ${bytes.length}\\0`).update(bytes).digest('hex');",
    "const decode=bytes=>new TextDecoder('utf-8',{fatal:true}).decode(bytes);",
    "const read=(filename,maximum=4194304)=>{time();const stat=fs.lstatSync(filename);assert(stat.isFile()&&!stat.isSymbolicLink()&&stat.size<=maximum&&stat.uid===process.getuid()&&stat.nlink===1);const descriptor=fs.openSync(filename,fs.constants.O_RDONLY|fs.constants.O_NOFOLLOW);try{const before=fs.fstatSync(descriptor);assert.equal(before.ino,stat.ino);assert.equal(before.dev,stat.dev);const bytes=fs.readFileSync(descriptor),after=fs.fstatSync(descriptor);assert.equal(bytes.length,before.size);assert.equal(after.mtimeMs,before.mtimeMs);assert.equal(after.size,before.size);return bytes;}finally{fs.closeSync(descriptor);}};",
    "const write=(relative,value)=>{time();const filename=root+'/'+relative;fs.mkdirSync(path.dirname(filename),{recursive:true,mode:448});const descriptor=fs.openSync(filename,fs.constants.O_WRONLY|fs.constants.O_CREAT|fs.constants.O_EXCL|fs.constants.O_NOFOLLOW,384);try{fs.writeFileSync(descriptor,value);fs.fsyncSync(descriptor);}finally{fs.closeSync(descriptor);}};",
    "const json=(relative,value)=>write(relative,JSON.stringify(value,null,2)+'\\n');",
    "const parse=filename=>JSON.parse(decode(read(filename)));",
    "const replace=(source,before,after)=>{assert.equal(source.split(before).length,2,'EXACT_SINGLE_DELTA');return source.replace(before,after);};",
    "const modules=['admission','entry','observation','capture','lifecycle','group-observer','observer-state','state','storage'];",
    "const seal=(directory,names,schema)=>({schema,files:names.map(name=>{const bytes=read(directory+'/'+name);return{path:name,bytes:bytes.length,sha256:hash(bytes),mode:fs.lstatSync(directory+'/'+name).mode&511};})});",
    "const authenticate=filename=>{const value=parse(filename);for(const row of value.files){const bytes=read(path.dirname(filename)+'/'+row.path);assert.equal(bytes.length,row.bytes);assert.equal(hash(bytes),row.sha256);assert.equal(fs.lstatSync(path.dirname(filename)+'/'+row.path).mode&511,row.mode);}return value;};",
    "async function authenticateTools(pins){const verified=[];for(const pin of [...pins.toolPins,pins.environmentLauncher,pins.wrapperTool]){const before=fs.lstatSync(pin.path);assert(before.isFile()&&before.size===pin.bytes&&(before.mode&511)===pin.mode);const digest=crypto.createHash('sha256');let size=0;for await(const bytes of fs.createReadStream(pin.path,{highWaterMark:65536})){time();size+=bytes.length;assert(size<=pin.bytes);digest.update(bytes);}assert.equal(size,pin.bytes);assert.equal(digest.digest('hex'),pin.sha256);const after=fs.lstatSync(pin.path);assert.equal(after.ino,before.ino);assert.equal(after.mtimeMs,before.mtimeMs);verified.push({path:pin.path,bytes:size,sha256:pin.sha256,mode:pin.mode});}return verified;}"
  ],
  "controlMarkers": [
    {
      "line": 26,
      "text": "async function authenticateTools(pins){const verified=[];for(const pin of [...pins.toolPins,pins.environmentLauncher,pins.wrapperTool]){const before=fs.lstatSync(pin.path);assert(before.isFile()&&before.size===pin.bytes&&(before.mode&511)===pin.mode);const digest=crypto.createHash('sha256');let size=0;for await(const bytes of fs.createReadStream(pin.path,{highWaterMark:65536})){time();size+=bytes.length;assert(size<=pin.bytes);digest.update(bytes);}assert.equal(size,pin.bytes);assert.equal(digest.digest('hex'),pin.sha256);const after=fs.lstatSync(pin.path);assert.equal(after.ino,before.ino);assert.equal(after.mtimeMs,before.mtimeMs);verified.push({path:pin.path,bytes:size,sha256:pin.sha256,mode:pin.mode});}return verified;}"
    },
    {
      "line": 61,
      "text": "}else if(process.argv[2]==='controls'){"
    },
    {
      "line": 72,
      "text": " test('D01',()=>{verify(admission.validateCohort(cohort,requests,actualRoot));verify(requests.length===6&&cohort.fixtures.length===0);for(const row of cohort.cases){verify(hash(read(materialized+'/programs/'+row.id+'.bash.data'))===row.programSha256);verify(row.expectedNative===null);}verify(cohort.cases[0].program==='declare -p PIPESTATUS');});"
    },
    {
      "line": 73,
      "text": " test('D02',()=>{for(const alter of [rows=>rows[0].argv.push('extra'),rows=>rows[0].argv[3]='true; declare -p PIPESTATUS',rows=>rows[0].executable='/bin/sh',rows=>rows[0].stdinBase64='eA==',rows=>rows[0].environment.PATH='/bin',rows=>rows[0].environment.ENV='x',rows=>rows[0].cwd='/tmp',rows=>rows[0].extraProcessReservation=1]){const rows=clone();alter(rows);reject(()=>admission.validateCohort(cohort,rows,actualRoot));}});"
    },
    {
      "line": 74,
      "text": " test('D03',()=>{verify(admission.validateGrant(goodGrant,now));verify(admission.validateReview(goodReview,goodReview));reject(()=>admission.validateGrant({...goodGrant,failedLookupNames:['function']},now));reject(()=>admission.validateGrant({...goodGrant,schema:'function-pipestatus-root-grant-v2'},now));reject(()=>admission.validateReview({...goodReview,profile:'function-pipestatus-reference-v2'},goodReview));for(const value of [null,'123',Infinity,NaN])reject(()=>admission.validateGrant({...goodGrant,issuedEpochMs:value},now));reject(()=>admission.validateGrant(parse(root+'/GO.template.json'),now));});"
    },
    {
      "line": 75,
      "text": " test('D04',()=>{const sha='a'.repeat(64),resolved=structuredClone(template.parameters);resolved.cmd=resolved.cmd.replace('ROOT_APPROVED_GRANT_SHA256',sha);verify(admission.resolveApproval(template,resolved,sha));for(const bad of [{...resolved,cmd:resolved.cmd+' '},{...resolved,login:true},{...resolved,prefix_rule:['node']},{...resolved,sandbox_permissions:'use_default'}])reject(()=>admission.resolveApproval(template,bad,sha));verify(template.parameters.cmd.split('ROOT_APPROVED_GRANT_SHA256').length===2);});"
    },
    {
      "line": 76,
      "text": " test('D05',()=>{const directory=scratch+'/fd';fs.mkdirSync(directory,{mode:448});fs.mkdirSync(directory+'/outer',{mode:448});const filename=directory+'/outer/bootstrap.stdout';fs.writeFileSync(filename,'AB',{mode:384});for(const flag of ['r+','w','r','r+']){const fd=fs.openSync(filename,flag),ops=Object.create(fs);ops.fstatSync=()=>fs.fstatSync(fd);ops.readSync=(_fd,...args)=>fs.readSync(fd,...args);ops.writeSync=(_fd,...args)=>fs.writeSync(fd,...args);try{if(flag==='r+'){if(fs.fstatSync(fd).size===2){const first=Buffer.alloc(1),second=Buffer.alloc(1);fs.readSync(fd,first,0,1,null);verify(first.toString()==='A');verify(admission.validateOuter(directory,'stdout',1,ops));fs.readSync(fd,second,0,1,null);verify(second.toString()==='B');}else verify(admission.validateOuter(directory,'stdout',1,ops));}else reject(()=>admission.validateOuter(directory,'stdout',1,ops));}finally{fs.closeSync(fd);}}});"
    },
    {
      "line": 77,
      "text": " test('D06',()=>{const before=[{path:'work',type:'directory',mode:448}];for(const row of cohort.cases){verify(observation.validateEffects(row.id,before,before));reject(()=>observation.validateEffects(row.id,before,[...before,{path:'work/out',type:'file',mode:420,base64:'eA=='}]));}reject(()=>observation.validateEffects('F05',before,before));});"
    },
    {
      "line": 78,
      "text": " test('D07',()=>{const capture=(name,bytes)=>({name,flush:true,size:true,hash:true,close:true,bytes:bytes.length,sha256:hash(bytes),base64:bytes.toString('base64')});const row={id:'P19',status:1,capture:[capture('stdout',Buffer.from([0,255,10])),capture('stderr',Buffer.alloc(0))],filesVerified:true,filesBefore:[],filesAfter:[]};const frame=observation.encodeObservation(row),fields=frame.toString('ascii').split('\\0');verify(fields.length===9&&fields[1]==='P19'&&fields[2]==='1');verify(Buffer.from(fields[4],'base64').equals(Buffer.from([0,255,10])));reject(()=>observation.encodeObservation({...row,id:'P02'}));reject(()=>observation.encodeObservation({...row,status:256}));const bad=structuredClone(row);bad.capture[0].sha256='0'.repeat(64);reject(()=>observation.encodeObservation(bad));});"
    },
    {
      "line": 79,
      "text": " test('D08',()=>{verify(requests.reduce((sum,row)=>sum+row.extraProcessReservation,0)===4);verify(requests.filter(row=>row.extraProcessReservation).map(row=>row.id).join(',')==='P22,P23');verify(protocol.limits.knownManagedProcessCeiling===7&&protocol.limits.allKnownProcessProposalCeiling===29&&protocol.limits.allKnownPeakProposalCeiling===5);const ledger=new state.ManagedLedger(2,2);ledger.enter('case');ledger.confirm('case');reject(()=>ledger.enter('case'));ledger.retire(true);verify(ledger.active===1&&ledger.activeConfirmed===1);});"
    },
    {
      "line": 80,
      "text": " test('D09',()=>{verify(admission.validateGrant(goodGrant,goodGrant.deadlineEpochMs-600000));reject(()=>admission.validateGrant(goodGrant,goodGrant.deadlineEpochMs-599999));verify(state.deadlineAdmission(0,66000));verify(!state.deadlineAdmission(1,66000));const late=new Storage(scratch,{deadline:10},{now:()=>11});reject(()=>late.terminal({late:true}));verify(!fs.existsSync(scratch+'/TERMINAL-STOP.json'));const fault=new Storage(scratch,{deadline:10},{now:()=>0,terminalOperations:{openSync(){throw 0;}}});let caught='not';try{fault.terminal({zero:true});}catch(reason){caught=reason;}verify(caught===0);});"
    },
