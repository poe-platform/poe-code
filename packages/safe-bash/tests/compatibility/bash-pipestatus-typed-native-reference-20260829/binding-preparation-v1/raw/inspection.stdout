36:  for(const name of ['entry.mjs','admission.mjs','capture.mjs','lifecycle.mjs','group-observer.mjs','observer-state.mjs','state.mjs','storage.mjs','observation.mjs','REQUESTS.json','COHORT.json','PROTOCOL.json','TOOLS.json'])requireValue(names.has(name),'SEAL_MEMBER');
