{"status":"METADATA_ONLY","tools":26,"absent":1,"previousPlanKeys":["sourceCommits","authoritativePrimary","pairs","acquiredArtifacts","authorityArtifacts","closure","node","gpg","gpgv","key","keyringPath","dearmorArgs","output","maxChildren","caseMs","closeGraceMs","streamBytes","controllerMs","network","globalKeyringUsedForVerification","harnessRevision"],"closureKeys":["path","resolved","bytes","mode","sha256"],"authorityKeys":["path","bytes","mode","sha256","role"],"patchManual":{"path":"/usr/share/man/man1/patch.1","resolved":"/usr/share/man/man1/patch.1","bytes":24803,"mode":"644","sha256":"db99ed563bf9300131a64b82b2daf6cb43ebb28ccb07aa2c88cb6024810959de","selected":[{"line":34,"text":".Op Fl B Ar backup-prefix"},{"line":36,"text":".Op Fl d Ar directory"},{"line":38,"text":".Op Fl F Ar max-fuzz"},{"line":41,"text":".Op Fl p Ar strip-count"},{"line":47,"text":".Op Fl z Ar backup-ext"},{"line":49,"text":".Op Fl Fl posix"},{"line":63,"text":"is omitted, or is a hyphen, the patch will be read from the standard input."},{"line":95,"text":".Fl B Ar backup-prefix ,"},{"line":96,"text":".Fl Fl prefix Ar backup-prefix"},{"line":98,"text":"Causes the next argument to be interpreted as a prefix to the backup file"},{"line":103,"text":".It Fl b , Fl Fl backup"},{"line":104,"text":"Save a backup copy of the file before it is modified."},{"line":105,"text":"By default the original file is saved with a backup extension of"},{"line":107,"text":"unless the file already has a numbered backup, in which case a numbered"},{"line":108,"text":"backup is made."},{"line":112,"text":".\\\" .Fl -posix"},{"line":114,"text":".It Fl -backup-if-mismatch"},{"line":115,"text":"Save a backup copy of the file before it is modified, but only if a mismatch"},{"line":117,"text":"Specifically, this will create a backup file if a hunk failed to apply, or if"},{"line":118,"text":"fuzz was required to apply one or more hunks."},{"line":122,"text":".Fl -backup-if-mismatch"},{"line":127,"text":"option when a backup is to be created."},{"line":129,"text":"If backups were otherwise requested with the"},{"line":134,"text":".Fl -posix"},{"line":136,"text":".It Fl -no-backup-if-mismatch"},{"line":138,"text":".Fl -backup-if-mismatch ,"},{"line":139,"text":"creating backups for every file unless backups have been disabled with"},{"line":140,"text":".Fl -posix"},{"line":146,"text":"Forces"},{"line":163,"text":".Fl d Ar directory ,"},{"line":164,"text":".Fl Fl directory Ar directory"},{"line":168,"text":"to interpret the next argument as a directory,"},{"line":169,"text":"and change the working directory to it before doing anything else."},{"line":176,"text":"Forces"},{"line":182,"text":".Fl F Ar max-fuzz ,"},{"line":183,"text":".Fl Fl fuzz Ar max-fuzz"},{"line":185,"text":"Sets the maximum fuzz factor."},{"line":189,"text":"Note that a larger fuzz factor increases the odds of a faulty patch."},{"line":190,"text":"The default fuzz factor is 2, and it may not be set to more than"},{"line":192,"text":".It Fl f , Fl Fl force"},{"line":193,"text":"Forces"},{"line":213,"text":"RCS and Perforce."},{"line":238,"text":"Note that one must be in the root directory of the repository in order for"},{"line":242,"text":"is operating in a Perforce workspace."},{"line":254,"text":".Fl Fl input Ar patchfile"},{"line":256,"text":"Causes the next argument to be interpreted as the input file name"},{"line":261,"text":"spaces have been munged in your input file."},{"line":263,"text":"in the input file."},{"line":265,"text":"Each line of the context must still match a line in the input file."},{"line":273,"text":"Forces"},{"line":282,"text":".Fl p Ar strip-count ,"},{"line":283,"text":".Fl Fl strip Ar strip-count"},{"line":285,"text":"Sets the pathname strip count,"},{"line":287,"text":"in case you keep your files in a different directory than the person who sent"},{"line":289,"text":"The strip count specifies how many slashes are to be stripped from"},{"line":291,"text":"(Any intervening directory names also go away.)"},{"line":319,"text":"Whatever you end up with is looked for either in the current directory,"},{"line":320,"text":"or the directory specified by the"},{"line":399,"text":"option will force"},{"line":407,"text":"context matched the original file with neither fuzz nor offsets."},{"line":411,"text":".It Fl t , Fl Fl batch"},{"line":422,"text":"Forces"},{"line":430,"text":"backup file names."},{"line":431,"text":"The type of backups made can also be given in the"},{"line":439,"text":"making backup file names."},{"line":452,"text":"Always make numbered backups."},{"line":454,"text":"Make numbered backups of files that already have them,"},{"line":455,"text":"simple backups of the others."},{"line":457,"text":"Always make simple backups."},{"line":459,"text":"Do not make backups."}]}}
