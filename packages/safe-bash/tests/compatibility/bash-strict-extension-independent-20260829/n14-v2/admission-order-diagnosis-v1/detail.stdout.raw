/Users/kjopek/.nvm/versions/node/v22.22.2/lib/node_modules/npm/node_modules/libnpmpack/lib/index.js SHA256 1a800b0b7294d89e65e8a334322db2b98569e2c3705630cf274cdb85e245b98d
1: 'use strict'
