4: import { createHash } from 'node:crypto';
5: const binding = JSON.parse(await fs.readFile(process.env.PUBLIC_BINDING));
6: const admitted = new Map(binding.inputs.map(row => [path.join(binding.root, 'dist', row.path), row]));
7: const harness = new Map(binding.harness.map(row => [row.path, row]));
8: export async function load(url, context, next) {
9:   if (url.startsWith('node:')) return next(url, context);
10:   if (!url.startsWith('file:')) throw Error('Non-file module capability denied');
11:   const filename = fileURLToPath(url), metadata = await fs.lstat(filename);
12:   if (!metadata.isFile() || metadata.isSymbolicLink() || await fs.realpath(filename) !== filename || metadata.size > 8388608) throw Error('Module file admission failed');
13:   const row = harness.get(filename) ?? admitted.get(filename);
14:   if (!row) throw Error('package outside authenticated compiled root or package binding missing member');
15:   const data = await fs.readFile(filename), sha256 = createHash('sha256').update(data).digest('hex');
16:   if (sha256 !== row.sha256) throw Error('package hash mismatch');
17:   if (admitted.has(filename)) await fs.appendFile(binding.trace, JSON.stringify({ file: filename, sha256 }) + '\n');
18:   return { format: 'module', source: data, shortCircuit: true };
19: }
