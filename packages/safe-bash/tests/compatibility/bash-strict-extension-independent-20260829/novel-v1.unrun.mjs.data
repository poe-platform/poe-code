import assert from 'node:assert/strict';
import * as api from 'virtual-bash';
const rows=[],shells=new Set(),releases=new Set(),unhandled=[];
process.on('unhandledRejection',reason=>unhandled.push({type:typeof reason,text:String(reason)}));
const capture=promise=>promise.then(value=>({kind:'return',value}),reason=>({kind:'throw',reason}));
const turn=()=>new Promise(resolve=>setImmediate(resolve));
function deferred(){let resolve;const promise=new Promise(done=>{resolve=done;});return{promise,resolve};}
function create(){const owner=new api.Shell({fs:new api.MemoryFileSystem(),cwd:'/'}).use(api.agentCommands());shells.add(owner);return owner;}
async function record(id,body){
 const row={id,role:'INDEPENDENT_RATIFIED_PRODUCT_PROFILE_NOT_NATIVE',pass:false};
 const timer=setTimeout(()=>{console.error('INDEPENDENT_CASE_DEADLINE',id);process.exit(78);},30000);
 try{await body(row);row.pass=true;}catch(reason){row.reasonPresent=true;row.error=String(reason?.stack??reason);}
 finally{for(const release of releases)release();releases.clear();const settled=await Promise.allSettled([...shells].map(owner=>owner.dispose()));row.created=shells.size;row.disposed=settled.filter(item=>item.status==='fulfilled').length;row.cleanupFailure=row.created!==row.disposed;row.cleanupReasons=settled.filter(item=>item.status==='rejected').map(item=>({type:typeof item.reason,text:String(item.reason)}));shells.clear();await turn();clearTimeout(timer);}
 rows.push(row);console.log(JSON.stringify(row));if(row.cleanupFailure||unhandled.length)process.exit(78);
}
function result(row,actual,status,stdout){row.actual=actual;assert.equal(actual.exitCode,status);assert.equal(actual.stdout,stdout);}
function fatal(actual,name){assert.equal(actual.stderr.split(name+': unbound variable').length-1,1);assert.doesNotMatch(actual.stderr,/let:|\(\(:|NounsetFailure|NounsetDiagnosticFailure/);}
await record('N01-write-only-empty',async row=>{const actual=await create().exec('set -u; empty=; (( target = empty + 4 )); printf "%s:%s" "$target" "$((empty))"');result(row,actual,0,'4:0');assert.equal(actual.stderr,'');});
await record('N02-rhs-before-publication',async row=>{const owner=create();const actual=await owner.exec('set -u; (( target = absent + 1 )); printf forbidden');result(row,actual,1,'');fatal(actual,'absent');const after=await owner.exec('printf "%s" "${target-unset}"');row.after=after;assert.equal(after.stdout,'unset');assert.equal(after.exitCode,0);});
await record('N03-compound-lhs-first',async row=>{const owner=create();const actual=await owner.exec('set -u; (( absent += (side = 7) )); printf forbidden');result(row,actual,1,'');fatal(actual,'absent');const after=await owner.exec('printf "%s" "${side-unset}"');row.after=after;assert.equal(after.stdout,'unset');assert.equal(after.exitCode,0);});
await record('N04-lazy-recursive-branches',async row=>{const actual=await create().exec('set -u; empty=; let "answer = (1 || hidden) ? (empty + 4) : absent"; printf "%s" "$answer"');result(row,actual,0,'4');assert.equal(actual.stderr,'');});
await record('N05-inner-recursive-name',async row=>{const actual=await create().exec('set -u; outer=middle; middle=leaf; let outer; printf forbidden');result(row,actual,1,'');fatal(actual,'leaf');assert.doesNotMatch(actual.stderr,/outer: unbound|middle: unbound/);});
await record('N06-function-or-fatal',async row=>{const actual=await create().exec('set -u; f() { (( absent++ )); printf bad; }; f || printf rescued; printf tail');result(row,actual,1,'');fatal(actual,'absent');});
await record('N07-subprocess-boundary',async row=>{const actual=await create().exec('set -u; ( let absent ); printf "status:%s" "$?"');result(row,actual,0,'status:1');fatal(actual,'absent');});
await record('N08-pipefail-boundary',async row=>{const actual=await create().exec('set -uo pipefail; let absent | cat; printf "status:%s" "$?"');result(row,actual,0,'status:1');fatal(actual,'absent');});
await record('N09-substring-length-read',async row=>{const actual=await create().exec('set -u; word=abcdef; printf "%s" "${word:1:absent}"; printf forbidden');result(row,actual,1,'');fatal(actual,'absent');assert.doesNotMatch(actual.stderr,/word: absent/);});
await record('N10-invalid-tail-positionals',async row=>{const actual=await create().exec('set -- one two; set -uz three; printf "tail:%s:%s\n" "$#" "$1"; printf "%s" "$absent"');result(row,actual,1,'tail:2:one\n');fatal(actual,'absent');assert.equal(actual.stderr.split('unsupported shell option').length-1,1);});
await record('N11-errexit-prefix-or',async row=>{const actual=await create().exec('set -ez || printf recovered; false; printf forbidden');result(row,actual,1,'recovered');assert.equal(actual.stderr.split('unsupported shell option').length-1,1);});
await record('N12-listing-replay',async row=>{const owner=create();const first=await owner.exec('set -- "first value" second; set -uo pipefail; set -e; set +o');row.replay=first;assert.equal(first.exitCode,0);assert.equal(first.stdout,'set -o errexit\nset -o nounset\nset -o pipefail\n');assert.equal(first.stderr,'');const receiver=create();const replayed=await receiver.exec(first.stdout+'set -o');result(row,replayed,0,'errexit\ton\nnounset\ton\npipefail\ton\n');assert.equal(replayed.stderr,'');const args=await owner.exec('printf "%s:%s" "$#" "$1"');row.args=args;assert.equal(args.stdout,'2:first value');assert.equal(args.exitCode,0);});
await record('N13-sh-special-unchanged',async row=>{const actual=await create().exec('sh -c \'set -uz; printf forbidden\'; printf "outer:%s" "$?"');result(row,actual,0,'outer:2');assert.equal(actual.stderr.split('unsupported shell option').length-1,1);});
await record('N14-zero-sink-held-cleanup',async row=>{
 const owner=create(),entered=deferred(),gate=deferred();let cleaned=0,settled=false,writes=0;row.events=[];releases.add(gate.resolve);
 owner.commands.register({name:'guard',execute(context){context.registerCleanup(async()=>{row.events.push('cleanup-enter');entered.resolve();await gate.promise;cleaned++;row.events.push('cleanup-finished');throw false;});row.events.push('registered');return context.invoke('f',[]);}});
 const pending=capture(owner.exec('f() { printf "%s" "${absent:?required}"; }; guard',{stderr:{async write(){writes++;row.events.push('diagnostic');throw 0;}}})).then(outcome=>{settled=true;row.events.push('settled');return outcome;});
 try{const first=await Promise.race([entered.promise.then(()=> 'entered'),pending.then(()=> 'premature')]);assert.equal(first,'entered');await turn();assert.equal(settled,false);assert.equal(cleaned,0);}finally{row.events.push('release');gate.resolve();releases.delete(gate.resolve);}
 const outcome=await pending;row.kind=outcome.kind;row.exactZero=outcome.reason===0;row.cleaned=cleaned;row.writes=writes;assert.equal(outcome.kind,'throw');assert.equal(outcome.reason,0);assert.equal(cleaned,1);assert.equal(writes,1);assert(row.events.indexOf('cleanup-finished')<row.events.indexOf('settled'));
});
await record('N15-caller-over-typed-sink',async row=>{const owner=create(),controller=new AbortController(),secondary=new api.ShellLimitError('maxExpansionBytes');let cleaned=0,writes=0;owner.commands.register({name:'guard',execute(context){context.registerCleanup(async()=>{await turn();cleaned++;});return context.invoke('f',[]);}});const outcome=await capture(owner.exec('f() { printf "%s" "${absent:?required}"; }; guard',{signal:controller.signal,stderr:{async write(){writes++;controller.abort(false);throw secondary;}}}));row.kind=outcome.kind;row.exactFalse=outcome.reason===false;row.cleaned=cleaned;row.writes=writes;assert.equal(outcome.kind,'throw');assert.equal(outcome.reason,false);assert.equal(cleaned,1);assert.equal(writes,1);});
await record('N16-no-free-diagnostic',async row=>{row.variants=[];for(const program of ['set -u; (( absent++ ))','printf "%s" "${absent:?required}"']){let writes=0;const outcome=await capture(create().exec(program,{limits:{maxOutputBytes:0},stderr:{async write(){writes++;}}}));row.variants.push({kind:outcome.kind,limit:outcome.reason?.limit,writes});assert.equal(outcome.kind,'throw');assert(outcome.reason instanceof api.ShellLimitError);assert.equal(outcome.reason.limit,'maxOutputBytes');assert.equal(writes,0);}});
console.log(JSON.stringify({summary:{cases:rows.length,pass:rows.filter(row=>row.pass).length,fail:rows.filter(row=>!row.pass).length,native:0,unhandled}}));process.exitCode=rows.every(row=>row.pass)&&unhandled.length===0?0:1;
