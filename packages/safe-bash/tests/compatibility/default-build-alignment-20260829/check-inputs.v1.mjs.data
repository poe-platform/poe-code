import fs from 'node:fs';
import path from 'node:path';
import crypto from 'node:crypto';
import assert from 'node:assert/strict';
import {spawnSync} from 'node:child_process';
const repo=process.cwd(),own=path.dirname(new URL(import.meta.url).pathname),producer=path.join(repo,'tests/compatibility/final-coherent-producer-20260829');
const started=Date.parse('2026-08-29T17:38:35Z'),deadline=started+480000,fileCap=16777216;
const hash=raw=>crypto.createHash('sha256').update(raw).digest('hex');
const read=filename=>{const stat=fs.lstatSync(filename);assert(stat.isFile()&&!stat.isSymbolicLink()&&stat.size<=fileCap,filename);const raw=fs.readFileSync(filename);assert.equal(raw.length,stat.size);return raw;};
const write=(name,value)=>{const raw=Buffer.from(JSON.stringify(value,null,2)+'\n');assert(raw.length<=fileCap);fs.writeFileSync(path.join(own,name),raw,{flag:'wx'});return{path:path.join(own,name),bytes:raw.length,sha256:hash(raw)};};
function filePin(row){const stat=fs.lstatSync(row.path);assert(stat.isFile()&&!stat.isSymbolicLink());assert.equal(stat.size,row.size??row.bytes,row.path);const digest=crypto.createHash('sha256'),buffer=Buffer.alloc(1048576),fd=fs.openSync(row.path,'r');try{let count;while((count=fs.readSync(fd,buffer,0,buffer.length,null))>0)digest.update(buffer.subarray(0,count));}finally{fs.closeSync(fd);}assert.equal(digest.digest('hex'),row.sha256,row.path);}
let compilerInvocations=0;
try{
 const producerRaw=read(path.join(producer,'PRODUCER-RECEIPT.json'));assert.equal(hash(producerRaw),'c5e2b614f775688d72e793fd88fad3044e8217c32a4aac8495d13d00d02f22ce');const receipt=JSON.parse(producerRaw);
 const sourceRaw=read(receipt.sourceSeal.path);assert.equal(hash(sourceRaw),receipt.sourceSeal.sha256);const source=JSON.parse(sourceRaw);
 const data=JSON.parse(read(path.join(producer,'DATA-RECEIPT.json'))),usabilityRaw=read(path.join(producer,'USABILITY.json'));assert.equal(hash(usabilityRaw),data.usability.sha256);const usability=JSON.parse(usabilityRaw);
 const pkgRaw=read(path.join(repo,'package.json')),buildRaw=read(path.join(repo,'tsconfig.build.json')),baseRaw=read(path.join(repo,'tsconfig.json')),beforeRaw=read(path.join(own,'tsconfig.build.before.json'));
 const pkg=JSON.parse(pkgRaw),build=JSON.parse(buildRaw),base=JSON.parse(baseRaw),before=JSON.parse(beforeRaw);
 assert.equal(pkg.scripts.build,'tsc -p tsconfig.build.json');assert.equal(pkg.scripts.prebuild,undefined);assert.equal(pkg.scripts.postbuild,undefined);assert.equal(build.extends,'./tsconfig.json');assert.deepEqual(build.include,['src/**/*.ts']);assert.deepEqual(build.compilerOptions,before.compilerOptions);assert.deepEqual(build.files,before.files);assert.equal(build.references,undefined);assert.equal(base.compilerOptions.strict,true);
 for(const [filename,raw] of [['package.json',pkgRaw],['tsconfig.json',baseRaw]])assert.equal(hash(raw),source.inputs.find(row=>row.path===filename).sha256,'selected configuration differs '+filename);
 const held=usability.exactRows.filter(row=>row.path.startsWith('src/')&&row.path.endsWith('.ts')).map(row=>row.path).sort();assert.equal(held.length,16);assert.equal(usability.excludedCount,40);assert.deepEqual(build.exclude.slice(0,before.exclude.length),before.exclude);assert.deepEqual(build.exclude.slice(before.exclude.length).slice().sort(),held);
 const expected=source.inputs.filter(row=>row.path.startsWith('src/')&&row.path.endsWith('.ts')).map(row=>row.path).sort();
 const found=[],heldMetadata=[];function visit(folder){for(const entry of fs.readdirSync(folder,{withFileTypes:true})){const absolute=path.join(folder,entry.name),relative=path.relative(repo,absolute);assert(!entry.isSymbolicLink(),'source symlink not admitted '+relative);if(entry.isDirectory())visit(absolute);else if(entry.isFile()&&relative.endsWith('.ts'))found.push(relative);}}
 visit(path.join(repo,'src'));const selected=found.filter(filename=>!held.includes(filename)).sort();assert.deepEqual(selected,expected,'normal build root set differs from accepted projection');assert.deepEqual(found.filter(filename=>held.includes(filename)).sort(),held);
 for(const filename of held){const stat=fs.lstatSync(path.join(repo,filename));heldMetadata.push({path:filename,size:stat.size,mtimeMs:stat.mtimeMs,mode:stat.mode&0o777,contentRead:false});}
 const toolsRaw=read(receipt.toolsSeal.path);assert.equal(hash(toolsRaw),receipt.toolsSeal.sha256);const tools=JSON.parse(toolsRaw);filePin(tools.node);for(const row of tools.typescript)filePin(row);for(const row of tools.typedRows)filePin({...row,path:row.origin});
 const executable=tools.node.path,args=['--require',path.join(own,'compiler-read-guard.cjs'),path.join(repo,'node_modules/typescript/lib/tsc.js'),'-p',path.join(repo,'tsconfig.build.json'),'--noEmit','--listFiles'];
 const admission=write('INPUT-ADMISSION.json',{repo,selectedPaths:source.inputs.map(row=>row.path),normalCompilerRootPaths:selected,normalCompilerRootCount:selected.length,heldPaths:held,heldMetadata,exactAddedExclusions:held,packageBuild:pkg.scripts.build,lifecycleHooksAbsent:true,configSha256:hash(buildRaw),baseConfigSha256:hash(baseRaw),packageSha256:hash(pkgRaw),projectionSourceCount:source.sourceCount,projectionTree:source.buildInputProjectionTree,priorCompilerExit:0,priorProducerCommit:'ab46a006a0f324a42c563542e4545ce80de49731',priorRoutingEvidence:'The exact selected root set compiled strictly in an isolated projection where the held files were absent. This check additionally refuses any unselected src content read, including through a new explicit import.',compiler:{executable,args,cwd:repo,normalTypeResolution:true,typeRootsOverride:false,emit:false},beforeCompiler:true,at:new Date().toISOString()});
 assert(Date.now()+90000+180000<deadline,'global time including publication');const stdout=fs.openSync(path.join(own,'compiler.stdout'),'wx'),stderr=fs.openSync(path.join(own,'compiler.stderr'),'wx');let child;try{compilerInvocations++;child=spawnSync(executable,args,{cwd:repo,env:{PATH:path.dirname(executable),HOME:process.env.HOME,TMPDIR:own,LANG:'C',LC_ALL:'C',TZ:'UTC',SAFE_BASH_INPUT_ADMISSION:admission.path},stdio:['ignore',stdout,stderr],timeout:90000});}finally{fs.closeSync(stdout);fs.closeSync(stderr);}
 const compilerOutput=read(path.join(own,'compiler.stdout')),compilerError=read(path.join(own,'compiler.stderr'));const compilerFiles=compilerOutput.toString().split('\n').filter(line=>path.isAbsolute(line.trim())).map(line=>line.trim());const actualSourceFiles=compilerFiles.filter(filename=>filename.startsWith(path.join(repo,'src')+path.sep)).map(filename=>path.relative(repo,filename)).sort();assert.equal(child.status,0,compilerOutput.toString().slice(0,12000)+compilerError.toString());assert.equal(child.signal,null);assert.deepEqual(actualSourceFiles,expected);assert(!compilerFiles.some(filename=>held.includes(path.relative(repo,filename))));
 assert.equal(hash(read(path.join(repo,'tsconfig.build.json'))),hash(buildRaw));assert.equal(hash(read(path.join(repo,'package.json'))),hash(pkgRaw));for(const row of heldMetadata){const stat=fs.lstatSync(path.join(repo,row.path));assert.equal(stat.size,row.size);assert.equal(stat.mtimeMs,row.mtimeMs);assert.equal(stat.mode&0o777,row.mode);}
 const result=write('RESULT.json',{status:'NORMAL_BUILD_CONFIG_NOEMIT_PASS',inputAdmission:admission,compiler:{executable,args,cwd:repo,status:child.status,signal:child.signal,pid:child.pid,invocations:compilerInvocations,stdoutBytes:compilerOutput.length,stderrBytes:compilerError.length},sourceRootCount:expected.length,compilerSourceFiles:actualSourceFiles,compilerListedFiles:compilerFiles.length,heldPathsRead:0,heldFilesMetadataUnchanged:true,heldMetadataQualification:'size/mtime/mode only; held content not opened or hashed',addedExactExclusions:held,packageAndExportsUnchanged:true,strictnessUnchanged:true,normalTypeResolution:true,productionEmit:false,defaultNpmScriptExecuted:false,qualification:'The reviewed normal build script is tsc -p tsconfig.build.json without pre/post hooks. Its config passes guarded noEmit using normal ambient Node types, not isolated typeRoots. No npm, package rebuild, product, smoke, or full-test claim. Frozen 323 producer/archive remains separate and unchanged.',sourceCheckNotWholeCheckoutAcceptance:true,at:new Date().toISOString()});
 console.log(JSON.stringify({result,compilerStatus:child.status,normalSourceRootCount:expected.length,excludedProductionPaths:held.length,normalTypeResolution:true,compilerListedFiles:compilerFiles.length,compilerInvocations},null,2));
}catch(error){write('STOP.json',{error:String(error.stack??error),compilerInvocations,at:new Date().toISOString()});console.error(error);process.exitCode=1;}
