1077: static void Stat(const FunctionCallbackInfo<Value>& args) {
1078:   Realm* realm = Realm::GetCurrent(args);
1079:   BindingData* binding_data = realm->GetBindingData<BindingData>();
1080:   Environment* env = realm->env();
1081: 
1082:   const int argc = args.Length();
1083:   CHECK_GE(argc, 3);
1084: 
1085:   BufferValue path(realm->isolate(), args[0]);
1086:   CHECK_NOT_NULL(*path);
1087:   ToNamespacedPath(env, &path);
1088: 
1089:   bool use_bigint = args[1]->IsTrue();
1090:   if (!args[2]->IsUndefined()) {  // stat(path, use_bigint, req)
1091:     FSReqBase* req_wrap_async = GetReqWrap(args, 2, use_bigint);
1092:     CHECK_NOT_NULL(req_wrap_async);
1093:     ASYNC_THROW_IF_INSUFFICIENT_PERMISSIONS(
1094:         env,
1095:         req_wrap_async,
1096:         permission::PermissionScope::kFileSystemRead,
1097:         path.ToStringView());
1098:     FS_ASYNC_TRACE_BEGIN1(
1099:         UV_FS_STAT, req_wrap_async, "path", TRACE_STR_COPY(*path))
1100:     AsyncCall(env, req_wrap_async, args, "stat", UTF8, AfterStat,
1101:               uv_fs_stat, *path);
1102:   } else {  // stat(path, use_bigint, undefined, do_not_throw_if_no_entry)
1103:     THROW_IF_INSUFFICIENT_PERMISSIONS(
1104:         env, permission::PermissionScope::kFileSystemRead, path.ToStringView());
1105:     bool do_not_throw_if_no_entry = args[3]->IsFalse();
1106:     FSReqWrapSync req_wrap_sync("stat", *path);
1107:     FS_SYNC_TRACE_BEGIN(stat);
1108:     int result;
1109:     if (do_not_throw_if_no_entry) {
1110:       result = SyncCallAndThrowIf(is_uv_error_except_no_entry_dir,
1111:                                   env,
1112:                                   &req_wrap_sync,
1113:                                   uv_fs_stat,
1114:                                   *path);
1115:     } else {
1116:       result = SyncCallAndThrowOnError(env, &req_wrap_sync, uv_fs_stat, *path);
1117:     }
1118:     FS_SYNC_TRACE_END(stat);
1119:     if (is_uv_error(result)) {
1120:       return;
1121:     }
1122:     Local<Value> arr = FillGlobalStatsArray(binding_data, use_bigint,
1123:         static_cast<const uv_stat_t*>(req_wrap_sync.req.ptr));
1124:     args.GetReturnValue().Set(arr);
1125:   }
1126: }
