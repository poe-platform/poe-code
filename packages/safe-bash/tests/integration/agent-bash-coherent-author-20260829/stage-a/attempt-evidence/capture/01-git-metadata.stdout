      || node.kind === "group" && nullable(node.child)
      || node.kind === "repeat" && (node.minimum === 0 || nullable(node.child))
      || node.kind === "sequence" && node.children.every(nullable)
      || node.kind === "alternative" && node.children.some(nullable);
