import type { Session } from "./io.js";
import { GIT_LIMITS, demand } from "./limits.js";

type Token = { kind: "literal"; byte: number } | { kind: "star" | "dirs" | "all" | "any" } | { kind: "class"; bytes: ReadonlySet<number>; negative: boolean };
