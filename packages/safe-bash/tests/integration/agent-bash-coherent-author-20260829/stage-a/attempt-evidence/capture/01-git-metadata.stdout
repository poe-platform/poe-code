import { relativePath } from "../../contracts/index.js";
import { pathspecs, quote, selected, type Arguments } from "./arguments.js";
import { patch, type Side } from "./diff.js";
import { ignored, ignoreFile, type IgnoreRule } from "./ignore.js";
import { objectPath, parent } from "./io.js";
import { GIT_LIMITS, GitFailure, demand } from "./limits.js";
import { Repository, type Entry } from "./repository.js";

function change(before: Pick<Entry, "mode" | "oid"> | undefined, after: Pick<Entry, "mode" | "oid"> | undefined): string {
  if (!before) return after ? "A" : " ";
  if (!after) return "D";
  if ((before.mode & 0o170000) !== (after.mode & 0o170000)) return "T";
  return before.mode !== after.mode || before.oid !== after.oid ? "M" : " ";
}

async function blob(repository: Repository, entry: Entry | undefined): Promise<Side | undefined> {
  if (!entry) return undefined;
  const object = await repository.object(entry.oid);
  demand(object.type === "blob", "Git index/tree leaf is not a blob");
  return { ...entry, bytes: object.bytes };
}

async function attributes(repository: Repository, specs: readonly string[], maps: readonly ReadonlyMap<string, Entry>[], worktree: boolean): Promise<void> {
  const session = repository.session;
