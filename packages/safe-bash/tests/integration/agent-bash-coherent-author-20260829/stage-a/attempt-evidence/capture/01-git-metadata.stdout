    if (format[offset + 1] === "%") { result += "%"; offset += 2; continue; }
    const match = formatPattern.exec(format.slice(offset));
    if (!match) throw new ProgramError(`unsupported format near '${format.slice(offset)}'`);
    offset += match[0].length;
