        offset++;
        node = { type: "repeat", node, minimum: quantifier === "+" ? 1 : 0, maximum: quantifier === "?" ? 1 : Infinity };
      } else if (quantifier === "{") {
        const match = /^\{([0-9]+)(?:,([0-9]*))?\}/u.exec(source.slice(offset));
