    "text": "{\n  \"role\": \"AUTHOR_LITERAL_EXPECTATIONS_NOT_NATIVE_OBSERVATIONS\",\n  \"cases\": [\n    {\"id\":\"R01\",\"script\":\"emit |& cat\",\"stdout\":\"OE\"},\n    {\"id\":\"R02\",\"script\":\"emit | cat\",\"stdout\":\"O\",\"stderr\":\"E\"},\n    {\"id\":\"R03\",\"script\":\"emit 2>err |& cat\",\"stdout\":\"OE\",\"files\":{\"err\":\"\"}},\n    {\"id\":\"R04\",\"script\":\"emit >out |& cat\",\"files\":{\"out\":\"OE\"}},\n    {\"id\":\"R05\",\"script\":\"emit 2>&1 >out |& cat\",\"files\":{\"out\":\"OE\"}},\n    {\"id\":\"R06\",\"script\":\"emit >out 2>&1 |& cat\",\"files\":{\"out\":\"OE\"}},\n    {\"id\":\"R07\",\"script\":\"emit |& cat | cat\",\"stdout\":\"OE\"},\n    {\"id\":\"R08\",\"script\":\"emit |& cat |& cat\",\"stdout\":\"OE\"},\n    {\"id\":\"R09\",\"script\":\"{ emit; } 2>err |& cat\",\"stdout\":\"OE\",\"files\":{\"err\":\"\"}},\n    {\"id\":\"R10\",\"script\":\"( emit ) |& cat\",\"stdout\":\"OE\"},\n    {\"id\":\"R11\",\"script\":\"emit &>out\",\"files\":{\"out\":\"OE\"}},\n    {\"id\":\"R12\",\"script\":\"emit &>first >second\",\"files\":{\"first\":\"E\",\"second\":\"O\"}},\n    {\"id\":\"R13\",\"script\":\"emit >first &>second\",\"files\":{\"first\":\"\",\"second\":\"OE\"}},\n    {\"id\":\"R14\",\"script\":\"emit &>first 2>second\",\"files\":{\"first\":\"O\",\"second\":\"E\"}},\n    {\"id\":\"R15\",\"script\":\"emit 2>first &>second\",\"files\":{\"first\":\"\",\"second\":\"OE\"}},\n    {\"id\":\"R16\",\"script\":\"emit &>out | cat\",\"files\":{\"out\":\"OE\"}},\n    {\"id\":\"R17\",\"script\":\"emit &>out |& cat\",\"files\":{\"out\":\"OE\"}},\n    {\"id\":\"R18\",\"script\":\"( emit ) &>out\",\"files\":{\"out\":\"OE\"}},\n    {\"id\":\"R19\",\"script\":\"if true; then emit; fi &>out\",\"files\":{\"out\":\"OE\"}},\n    {\"id\":\"R20\",\"script\":\"f(){ emit; }; f &>out\",\"files\":{\"out\":\"OE\"}},\n    {\"id\":\"R21\",\"script\":\"f(){ emit |& cat; }; f\",\"stdout\":\"OE\"},\n    {\"id\":\"R22\",\"script\":\"emit &>'space file'\",\"files\":{\"space file\":\"OE\"}},\n    {\"id\":\"R23\",\"script\":\"emit &>$(printf out; printf X >>count)\",\"files\":{\"out\":\"OE\",\"count\":\"X\"}},\n    {\"id\":\"R24\",\"script\":\"printf '%s' '&>' '|&'\",\"stdout\":\"&>|&\"},\n    {\"id\":\"R25\",\"script\":\"emit |&\\ncat\",\"stdout\":\"OE\"},\n    {\"id\":\"R26\",\"script\":\"emit &>out; printf tail\",\"stdout\":\"tail\",\"files\":{\"out\":\"OE\"}},\n    {\"id\":\"R27\",\"script\":\"f(){ emit; return 7; }; f &>out\",\"exitCode\":7,\"files\":{\"out\":\"OE\"}},\n    {\"id\":\"R28\",\"script\":\"set -o pipefail; { emit; false; } |& cat\",\"stdout\":\"OE\",\"exitCode\":1},\n    {\"id\":\"R29\",\"script\":\"set -e; { emit; false; } |& cat; printf tail\",\"stdout\":\"OEtail\"},\n    {\"id\":\"R30\",\"script\":\"&>out\",\"files\":{\"out\":\"\"}},\n    {\"id\":\"R31\",\"script\":\"emit &>first &>second\",\"files\":{\"first\":\"\",\"second\":\"OE\"}},\n    {\"id\":\"R32\",\"script\":\"emit 2>&1 | cat\",\"stdout\":\"OE\"},\n    {\"id\":\"R33\",\"script\":\"emit 2>err | cat\",\"stdout\":\"O\",\"files\":{\"err\":\"E\"}},\n    {\"id\":\"R34\",\"script\":\"{ emit; } 3>&1 1>out 2>&3\",\"stdout\":\"E\",\"files\":{\"out\":\"O\"}},\n    {\"id\":\"R35\",\"script\":\"while false; do emit; done &>out\",\"files\":{\"out\":\"\"}},\n    {\"id\":\"R36\",\"script\":\"{ printf a; printf b >&2; } &>out\",\"files\":{\"out\":\"ab\"}}\n  ]\n}\n"
  },
