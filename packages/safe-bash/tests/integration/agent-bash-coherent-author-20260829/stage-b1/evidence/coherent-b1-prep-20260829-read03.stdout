BINDING {"relative":"tests/integration/agent-bash-coherent-author-20260829/stage-b/dispatch.mjs","bytes":5132,"sha256":"5780dbe8327aa30098c8bb977a82f536c088e2ad47b1e16659674ba71d593e1d"}
1:import fs from 'node:fs';
2:import path from 'node:path';
3:import assert from 'node:assert/strict';
4:import { pathToFileURL } from 'node:url';
5:import { admitFile } from './admission.mjs';
6:import { runWorkflow, engineFreeIds, engineIds } from './workflows.mjs';
7:
8:export async function main(args) {
9:  assert.equal(args.length, 4);
10:  assert.equal(args[0], '--run');
11:  const request = JSON.parse(admitFile(args[1], { bytes: Number(args[3]), sha256: args[2] }, 1048576));
12:  assert.equal(request.action, 'ROOT_RUN_COHERENT_STAGE_B');
13:  assert.equal(request.sourceTree, '3adc676a0ab638c9788ef007e465931d65d2c6fe');
14:  assert.equal(request.packageSha256, '2fe071e2bfac5ef5c81dc7e475e059091f6add65cd7411dfcfbf0ce7f51f2eca');
15:  assert.ok(['engine-free', 'PUBLIC95'].includes(request.profile));
16:  const ids = request.profile === 'engine-free' ? engineFreeIds : engineIds;
17:  assert.deepEqual(request.ids, ids);
18:  assert.ok(['source-built', 'installed', 'physically-moved'].includes(request.layout));
19:  assert.equal(request.independentGrantRequired, true);
20:  assert.ok(typeof request.rootAuthorization === 'string' && request.rootAuthorization.length > 0);
21:  const packageRoot = fs.realpathSync(request.packageRoot);
22:  assert.equal(packageRoot, request.packageRoot);
23:  const membership = JSON.parse(admitFile(request.membership.path, request.membership, 1048576));
24:  assert.equal(membership.length, 1014);
25:  const expected = new Map(membership.map(row => [row.path, row]));
26:  assert.equal(expected.size, 1014);
27:  function verifyMembership() {
28:    const observed = [];
29:    function walk(directory, prefix = '') {
30:      for (const entry of fs.readdirSync(directory, { withFileTypes: true })) {
31:        const relative = prefix ? prefix + '/' + entry.name : entry.name;
32:        const filename = path.join(directory, entry.name);
33:        assert.ok(entry.name !== 'AGENTS.md' && !entry.isSymbolicLink());
34:        if (entry.isDirectory()) walk(filename, relative);
35:        else {
36:          assert.ok(entry.isFile());
37:          const row = expected.get(relative);
38:          assert.ok(row, relative);
39:          admitFile(filename, row, 16777216);
40:          observed.push(relative);
41:        }
42:      }
43:    }
44:    walk(packageRoot);
45:    assert.deepEqual(observed.sort(), [...expected.keys()].sort());
46:  }
47:  verifyMembership();
48:  const metadata = JSON.parse(admitFile(path.join(packageRoot, 'package.json'), expected.get('package.json'), 1048576));
49:  assert.equal(metadata.name, 'virtual-bash');
50:  assert.deepEqual(metadata.dependencies ?? {}, {});
51:  const rootUrl = import.meta.resolve('virtual-bash');
52:  const nodeUrl = import.meta.resolve('virtual-bash/commands/node');
53:  assert.equal(rootUrl, pathToFileURL(path.join(packageRoot, 'dist/index.js')).href);
54:  assert.equal(nodeUrl, pathToFileURL(path.join(packageRoot, 'dist/commands/node/index.js')).href);
55:  await assert.rejects(import('virtual-bash/commands/node/host'));
56:  const fixture = JSON.parse(admitFile(request.fixture.path, request.fixture, 1048576));
57:  const api = await import(rootUrl);
58:  const nodeApi = await import(nodeUrl);
59:  const observations = [];
60:  let engine;
61:  if (request.profile === 'PUBLIC95') {
62:    const receipt = JSON.parse(admitFile(request.engineReceipt.path, request.engineReceipt, 131072));
63:    assert.equal(request.engineReceipt.sha256, 'a4d3614d6d944660aaddc1fd95c8fe6ebef1d92fc0dd8607400578d9a82254de');
64:    assert.equal(receipt.productWorker.sha256, '2ef280342b55c028c8e35e0f6cc98c9bf45c580134c9f0ada078815da1b3820d');
65:    assert.equal(fs.realpathSync(request.adapter.path), request.adapter.path);
66:    assert.equal(request.adapter.sha256, '2108bf2e7eee28ecd16c7e644c0684518cbfd68219c2971d2df67b155bf4e80d');
67:    admitFile(request.adapter.path, request.adapter, 16384);
68:    engine = {
69:      role: 'SEPARATELY_AUTHENTICATED_PUBLIC_ENGINE',
70:      createProvider() {
71:        return nodeApi.createNodeWorkerProvider({
72:          entry: pathToFileURL(request.adapter.path).href,
73:          identity: 'author-public-bb23-node-adapter-v1',
74:          observe(event) { assert.ok(observations.length < 512); observations.push(event); },
75:        });
76:      },
77:    };
78:  } else {
79:    assert.equal(Object.hasOwn(request, 'engineReceipt'), false);
80:    assert.equal(Object.hasOwn(request, 'adapter'), false);
81:  }
82:  const rows = [];
83:  for (const id of ids) {
84:    const timer = setTimeout(() => { console.error('CASE_DEADLINE', id); process.exit(78); }, 30000);
85:    try { rows.push(await runWorkflow(id, { api, nodeApi, fixture, engine })); }
86:    catch (error) {
87:      rows.push({ id, status: 'FAIL', detail: String(error?.stack ?? error), facts: error?.facts });
88:      if (error?.facts?.cleanupFailure) throw error;
89:    } finally { clearTimeout(timer); }
90:  }
91:  assert.equal(rows.length, ids.length);
92:  assert.equal(new Set(rows.map(row => row.id)).size, ids.length);
93:  verifyMembership();
94:  console.log(JSON.stringify({ layout: request.layout, profile: request.profile, rows, observations }));
95:  process.exitCode = rows.some(row => row.status !== 'PASS') ? 1 : 0;
96:}
97:
98:if (process.argv[1] && pathToFileURL(path.resolve(process.argv[1])).href === import.meta.url) await main(process.argv.slice(2));
99:
