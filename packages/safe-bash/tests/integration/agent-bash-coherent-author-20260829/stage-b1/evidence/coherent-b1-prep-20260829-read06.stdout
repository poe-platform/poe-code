1:import assert from 'node:assert/strict';
2:export function exactStrings(value) {
3:  assert.ok(Array.isArray(value), 'argument array required');
4:  const descriptors = Object.getOwnPropertyDescriptors(value);
5:  assert.ok(Object.hasOwn(descriptors.length, 'value'));
6:  const length = descriptors.length.value;
7:  assert.ok(Number.isSafeInteger(length) && length >= 0 && length <= 16);
8:  const keys = ['length', ...Array.from({ length }, (_, index) => String(index))];
9:  assert.deepEqual(Reflect.ownKeys(descriptors).sort(), keys.sort());
10:  return Array.from({ length }, (_, index) => {
11:    const descriptor = descriptors[String(index)];
12:    assert.ok(Object.hasOwn(descriptor, 'value'), 'argument accessor refused');
13:    assert.equal(typeof descriptor.value, 'string');
14:    return descriptor.value;
15:  });
16:}
17:export function internalLoaderArguments(value, paths) {
18:  const args = exactStrings(value);
19:  const expected = ['--test-reporter=tap', ...(args.length === 5 ? ['--test-timeout=30000'] : []), '--loader', paths.loader, paths.consumer];
20:  assert.deepEqual(args, expected, 'exact loader/consumer arguments required');
21:  for (const field of ['root', 'loader', 'bootstrap', 'consumer']) assert.equal(typeof paths[field], 'string');
22:  return ['--experimental-permission', '--allow-fs-read=' + paths.root, '--allow-fs-write=' + paths.root, '--allow-worker', '--import', paths.bootstrap, ...args];
23:}
