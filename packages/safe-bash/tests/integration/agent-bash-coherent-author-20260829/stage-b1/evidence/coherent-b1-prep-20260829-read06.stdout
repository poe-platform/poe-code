12:  if(!(specifier.startsWith('./')||specifier.startsWith('../')||specifier.startsWith('/')||specifier.startsWith('file:')))throw new Error('AUTHOR_LOAD_PACKAGE_FALLBACK');
13:  const url=specifier.startsWith('file:')?new URL(specifier):specifier.startsWith('/')?pathToFileURL(specifier):new URL(specifier,context.parentURL);
