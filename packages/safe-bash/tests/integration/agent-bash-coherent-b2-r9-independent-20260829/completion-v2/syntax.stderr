check('identity-receipts-disjoint-authenticated-payload-links',()=>{const root=path.join(repo,author,'evidence/identities'),identityRows=[];function visit(folder){for(const entry of fs.readdirSync(folder,{withFileTypes:true})){const filename=path.join(folder,entry.name);if(entry.isDirectory())visit(filename);else{const raw=read(filename);identityRows.push({path:path.relative(root,filename),value:JSON.parse(raw),sha256:hash(raw)});}}visit(root);assert.equal(identityRows.length,196);const identities=identityRows.map(row=>new Set(strings(row.value)));for(const [filename,{row}] of payloads){assert(identities.some(values=>values.has(row.sha256)&&(values.has(filename)||values.has(row.source))),filename+' identity linkage');}return{count:identityRows.length,sample:identityRows[0]};});
