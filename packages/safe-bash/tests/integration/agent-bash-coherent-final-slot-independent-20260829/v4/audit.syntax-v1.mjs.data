for(const pin of sources){requireValue(!pin.path.split('/').includes('..')&&!path.isAbsolute(pin.path));read(path.join(producer,'source',pin.path),pin,33554432);}for(const pin of emits){requireValue(!pin.path.split('/').includes('..')&&!path.isAbsolute(pin.path));read(path.join(producer,'source/dist',pin.path),pin,33554432);}
const expectedPaths=[];let links=0,regularTools=0;for(const pin of toolInventory){requireValue(typeof pin.path==='string'&&!path.isAbsolute(pin.path)&&!pin.path.split('/').includes('..'));const file=path.join(producer,'tools',pin.path);expectedPaths.push(pin.path);if(pin.type==='symlink'||Object.hasOwn(pin,'target')){requireValue(fs.lstatSync(file).isSymbolicLink());equal(fs.readlinkSync(file),pin.target);links++;}else{stream(file,pin);regularTools++;}}
const actualPaths=[];function walk(directory,prefix=''){for(const name of fs.readdirSync(directory).sort()){const file=directory+'/'+name,relative=prefix?prefix+'/'+name:name,stat=fs.lstatSync(file);if(stat.isDirectory()&&!stat.isSymbolicLink())walk(file,relative);else actualPaths.push(relative);}}walk(producer+'/tools');equal(actualPaths.sort(),expectedPaths.sort());equal(regularTools,2274);equal(links,12);stream(packet.node.path,packet.node);stream(packet.product.package.path,packet.product.package);equal(packet.product.package.sha256,'2fe071e2bfac5ef5c81dc7e475e059091f6add65cd7411dfcfbf0ce7f51f2eca');
const absent=[];for(const file of packet.absentSlots){requireValue(path.isAbsolute(file)&&path.normalize(file)===file);let missing=false;try{fs.lstatSync(file);}catch(error){if(error?.code==='ENOENT')missing=true;else throw error;}requireValue(missing);absent.push(file);}equal(absent.length,12);
equal(packet.schema,'B1-final-binding-v4');equal(packet.actualAuthority,false);equal(packet.issuedUTC,'2026-08-29T13:45:11.543Z');equal(packet.latestStartUTC,'2026-08-29T14:05:11.543Z');equal(packet.expiresUTC,'2026-08-29T14:35:11.543Z');const now=Date.now();requireValue(now>=Date.parse(packet.issuedUTC)&&now<=Date.parse(packet.latestStartUTC)&&now+1800000<=Date.parse(packet.expiresUTC));
