equal(packet.runtimeCommand,{executable:'/bin/zsh',argv:[base+'/stage-b1-r2/launch.sh',packet.runtimePreseal.path,packet.runtimePreseal.sha256,String(packet.runtimePreseal.bytes)],cwd:repo,login:false,env:{B1_ROOT_GO:'ROOT_B1_PUBLIC15_EXPLICIT_FRESH_AUTHORIZATION'}});
