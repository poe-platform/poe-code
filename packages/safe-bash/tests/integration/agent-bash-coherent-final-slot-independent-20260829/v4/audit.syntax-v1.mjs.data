test('I01-valid-two-records',()=>assert.equal(validateIdentities([first,second]).length,2));test('I02-nested-array',()=>assert.throws(()=>validateIdentities([first,[second]]),/must not be nested/));test('I03-missing-path',()=>assert.throws(()=>validateIdentities([{bytes:1,sha256:first.sha256}]),/keys/));test('I04-duplicate-path',()=>assert.throws(()=>validateIdentities([first,{...first}]),/Duplicate/));
