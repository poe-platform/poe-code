equal(packet.preimportCommand.argv[0],packet.preimportFiles[0].path);equal(packet.preimportCommand.argv[1],author+'/FINAL-PACKET.json');equal(packet.preimportCommand.executable,packet.node.path);equal(packet.preimportCommand.cwd,repo);equal(packet.preimportCommand.login,false);equal(packet.preimportCommand.capture,packet.slots.preimportCapture);equal(packet.publicationCommand.argv.slice(0,6),[base+'/stage-b1-publication-v2/publication.sh','--publish',packet.publisherBinding.path,packet.publisherBinding.sha256,String(packet.publisherBinding.bytes),packet.slots.authorityPath]);equal(packet.publicationCommand.argv.slice(-2).map(row=>row.slot),['authoritySha256','authorityBytes']);
const preparation=read(author+'/prepare.mjs',controlsSeal.files.find(row=>row.path===author+'/prepare.mjs')).toString(),preimport=read(packet.preimportFiles[0].path,packet.preimportFiles[0]).toString();requireValue(preparation.includes('const finalIdentities = [...prior.publisherFiles, ...preimportFiles];'));requireValue(preparation.indexOf('validateIdentities(finalIdentities)')<preparation.indexOf('for (const entry of [...finalIdentities')));
const buggy='for (const entry of [...packet.publisherFiles, packet.preimportFiles]) read(entry.path, entry.sha256, entry.bytes, 131072);';requireValue(preimport.includes(buggy));const nested=[...packet.publisherFiles,packet.preimportFiles];equal(nested.length,6);requireValue(Array.isArray(nested[5]));equal(nested[5].path,undefined);
const finding={id:'F01',severity:'ACTIVATION_HOLD',path:packet.preimportFiles[0].path,sha256:packet.preimportFiles[0].sha256,line:preimport.split('\n').findIndex(line=>line.includes(buggy))+1,source:buggy,exactPacketShape:{publisherRecords:5,preimportFilesArrayLength:1,iterations:6,lastIsArray:true,lastPathPresent:false},cause:'Preparation spread fixed, but the immutable future preimport helper still appends the whole preimportFiles array. Its sixth entry.path/sha256/bytes are undefined. The read helper calls fs.lstatSync(file) before type admission, so a valid future grant/ledger reaches a path-type failure before authority publication.',proof:'source and authenticated DATA composition; real preimport protocol NOT executed',minimumRepair:'Author a separate preimport helper revision using ...packet.preimportFiles plus finite shape validation before subject reads; rebind helper hash/origin, FINAL-PACKET and command slots, then different review. Do not mutate this sealed packet or issue actual GO.'};
const shapeQualification={id:'S02',scope:'source-only validation claim limit',path:author+'/identity.mjs',line:identity.toString().split('\n').findIndex(line=>line.includes('Object.keys(record)'))+1,note:'Object.keys ignores nonenumerable and symbol own keys. Required enumerable own-data fields are checked, but the stronger exact-all-own-keys claim is not established. No extra dynamic probe executed beyond the four authorized groups.'};
