const root=path.dirname(new URL(import.meta.url).pathname),repo='/Users/kjopek/Workspace/safe-bash',base=repo+'/tests/integration/agent-bash-coherent-author-20260829',author=base+'/stage-b1-final-binding-v4';
const hash=bytes=>crypto.createHash('sha256').update(bytes).digest('hex');let checks=0;
const equal=(value,expected)=>{assert.deepEqual(value,expected);checks++;};const requireValue=value=>{assert(value);checks++;};
function read(file,pin,max=8388608){requireValue(typeof file==='string'&&path.isAbsolute(file)&&path.normalize(file)===file&&!file.includes('\0'));const stat=fs.lstatSync(file);requireValue(stat.isFile()&&!stat.isSymbolicLink()&&stat.size<=max);if(pin)equal(stat.size,pin.bytes);const fd=fs.openSync(file,fs.constants.O_RDONLY|fs.constants.O_NOFOLLOW);try{const before=fs.fstatSync(fd);equal([before.dev,before.ino],[stat.dev,stat.ino]);const bytes=fs.readFileSync(fd),after=fs.fstatSync(fd);equal([bytes.length,after.size,after.mtimeMs],[stat.size,before.size,before.mtimeMs]);if(pin)equal(hash(bytes),pin.sha256);return bytes;}finally{fs.closeSync(fd);}}
function stream(file,pin){const stat=fs.lstatSync(file);requireValue(stat.isFile()&&!stat.isSymbolicLink());equal(stat.size,pin.bytes);const fd=fs.openSync(file,fs.constants.O_RDONLY|fs.constants.O_NOFOLLOW);try{const before=fs.fstatSync(fd),buffer=Buffer.alloc(65536),digest=crypto.createHash('sha256');let total=0,count;while((count=fs.readSync(fd,buffer,0,buffer.length,null))>0){total+=count;requireValue(total<=pin.bytes);digest.update(buffer.subarray(0,count));}equal(total,pin.bytes);equal(digest.digest('hex'),pin.sha256);const after=fs.fstatSync(fd);equal([after.dev,after.ino,after.size,after.mtimeMs],[before.dev,before.ino,before.size,before.mtimeMs]);}finally{fs.closeSync(fd);}}
function write(name,value){fs.writeFileSync(root+'/'+name,typeof value==='string'?value:JSON.stringify(value,null,2)+'\n',{flag:'wx',mode:0o600});}
