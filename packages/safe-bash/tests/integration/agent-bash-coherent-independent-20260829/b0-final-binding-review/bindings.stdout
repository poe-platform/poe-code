const work=seal.workRoot,captures=['/private/tmp/coherent-b0-39-20260829-r3.launch.stdout','/private/tmp/coherent-b0-39-20260829-r3.launch.stderr'];for(const name of [work,...captures])assert.equal(fs.existsSync(name),false,'slot already exists '+name);
