import fs from 'node:fs';import path from 'node:path';import crypto from 'node:crypto';import assert from 'node:assert/strict';import {spawnSync} from 'node:child_process';
const scope=import.meta.dirname,repo='/Users/kjopek/Workspace/safe-bash',base=path.dirname(scope),issued=new Date(),sha=body=>crypto.createHash('sha256').update(body).digest('hex');
fs.mkdirSync(path.join(scope,'capture'));let children=0;function git(args,input,limit=1048576){const prefix=path.join(scope,'capture','git-'+children++),out=fs.openSync(prefix+'.stdout','wx'),err=fs.openSync(prefix+'.stderr','wx');let result;try{result=spawnSync('/usr/bin/git',args,{cwd:repo,env:{PATH:'/usr/bin:/bin',GIT_OPTIONAL_LOCKS:'0'},input,stdio:[input?'pipe':'ignore',out,err],timeout:10000});}finally{fs.closeSync(out);fs.closeSync(err);}assert.equal(result.status,0);assert.equal(result.signal,null);const stat=fs.lstatSync(prefix+'.stdout');assert.ok(stat.isFile()&&stat.size<=limit);fs.appendFileSync(path.join(scope,'capture/events.jsonl'),JSON.stringify({pid:result.pid,status:result.status,signal:result.signal,args})+'\n');return fs.readFileSync(prefix+'.stdout');}
git(['status','--porcelain=v1','-z','--untracked-files=normal','--',path.relative(repo,scope)]);git(['diff','--cached','--name-only','-z']);
const review='360b22fba2f180031fe4c4bd1eccda46e6d90b08';const changed=git(['diff-tree','--no-commit-id','--name-only','-z','-r',review],undefined,131072).toString().split('\0').filter(Boolean);console.log(JSON.stringify({issuedAt:issued.toISOString(),reviewPaths:changed}));
const source='8ab0b2875c695c7cf6fbe90080cd083f69ef7146',relative='tests/integration/agent-bash-coherent-author-20260829/stage-b0-r3/';const selected=['PRESEAL.json','launch.sh','bootstrap.mjs','run.mjs'].map(name=>({commit:source,path:relative+name}));
const reviewPaths=changed.filter(name=>name.startsWith('tests/integration/agent-bash-coherent-independent-20260829/')&&(/\.md$|\.json$/.test(name))&&!name.endsWith('/AGENTS.md'));assert.ok(reviewPaths.length>0&&reviewPaths.length<=16);for(const name of reviewPaths)selected.push({commit:review,path:name});const query=selected.map(row=>row.commit+':'+row.path).join('\n')+'\n';const metadata=git(['cat-file','--batch-check=%(objectname) %(objecttype) %(objectsize)'],query,65536).toString().trim().split('\n');assert.equal(metadata.length,selected.length);for(const [index,row]of selected.entries()){const match=/^([0-9a-f]{40}) blob ([0-9]+)$/.exec(metadata[index]);assert.ok(match);row.blob=match[1];row.bytes=Number(match[2]);assert.ok(row.bytes<=1048576);}const total=selected.reduce((sum,row)=>sum+row.bytes+128,0);assert.ok(total<=4194304);const packed=git(['cat-file','--batch'],query,total);let cursor=0;const bodies=new Map();for(const row of selected){const end=packed.indexOf(10,cursor);assert.equal(packed.subarray(cursor,end).toString(),`${row.blob} blob ${row.bytes}`);const body=packed.subarray(end+1,end+1+row.bytes);assert.equal(crypto.createHash('sha1').update(`blob ${body.length}\0`).update(body).digest('hex'),row.blob);row.sha256=sha(body);bodies.set(row.path,body);cursor=end+row.bytes+2;}assert.equal(cursor,packed.length);
const presealRow=selected.find(row=>row.path===relative+'PRESEAL.json');assert.equal(presealRow.bytes,11952);assert.equal(presealRow.sha256,'78e6c945ceadfb54d51d806fbe57399ab5a552ad4571791cb916c085736e27a7');const seal=JSON.parse(bodies.get(presealRow.path));const receipt=selected.find(row=>row.sha256==='d490a5a2d1efe36dfc8b737267cf3762d04d1d273cbcba30b636e0123bf91a35');assert.ok(receipt,'exact ROOT review receipt in review commit');
const launch=bodies.get(relative+'launch.sh').toString();console.log(JSON.stringify({launch,receipt,reviewDocuments:reviewPaths.map(name=>({path:name,text:bodies.get(name).toString()}))}));
function read(filename,expected){const before=fs.lstatSync(filename);assert.ok(before.isFile()&&!before.isSymbolicLink());assert.equal(before.size,expected.bytes);assert.ok(before.size<=4194304);const body=fs.readFileSync(filename);assert.equal(sha(body),expected.sha256);const after=fs.lstatSync(filename);assert.equal(after.ino,before.ino);assert.equal(after.size,before.size);assert.equal(after.mtimeMs,before.mtimeMs);return body;}
for(const row of seal.files)read(path.join(repo,row.path),row);read(path.join(repo,presealRow.path),presealRow);const packagePath=path.join(base,'stage-a-r2/evidence/package/virtual-bash-0.0.0.tgz');read(packagePath,seal.package);const producer='/private/tmp/safe-bash-coherent-stage-a-20260829-r2';const stage=JSON.parse(read(path.join(base,'stage-b0-r2/stageAProducerPreseal.json'),seal.stageAProducerPreseal));const sourceManifest=JSON.parse(read(stage.source.path,stage.source));assert.equal(sourceManifest.inputs.length,309);for(const row of sourceManifest.inputs)read(path.join(producer,'source',row.path),row);const emittedRecord=seal.producerRecords.find(row=>row.path==='EMITTED.json');const emitted=JSON.parse(read(path.join(base,'stage-a-r2/evidence/EMITTED.json'),emittedRecord));assert.equal(emitted.length,1012);for(const row of emitted)read(path.join(producer,'source/dist',row.path),row);
