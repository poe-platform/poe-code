const here=import.meta.dirname,base=path.dirname(here),sha=body=>crypto.createHash('sha256').update(body).digest('hex');function read(filename,row,max=1048576){const stat=fs.lstatSync(filename);assert.ok(stat.isFile()&&!stat.isSymbolicLink()&&stat.size<=max);assert.equal(stat.size,row.bytes);const body=fs.readFileSync(filename);assert.equal(sha(body),row.sha256);return body;}
const bindingIdentity={bytes:10124,sha256:'c2f23cc753e96c6344dd5803792d6a8bb8850c522dc121bcc923de3544532590'};const binding=JSON.parse(read(path.join(here,'BINDING.json'),bindingIdentity));const seal=JSON.parse(read(path.join(base,'stage-b0-r3/PRESEAL.json'),binding.preseal));
async function census(root,rows){const expected=new Map(rows.map(row=>[row.path,row])),seen=[];const dirs=new Set(['']);for(const row of rows){let directory=path.posix.dirname(row.path);while(directory!=='.'){dirs.add(directory);directory=path.posix.dirname(directory);}}async function walk(relative=''){for(const name of fs.readdirSync(path.join(root,relative)).sort()){const filename=path.join(root,relative,name),key=relative?relative+'/'+name:name,stat=fs.lstatSync(filename);if(stat.isDirectory()){assert.ok(dirs.has(key),'unexpected directory '+key);await walk(key);continue;}const row=expected.get(key);assert.ok(row,'unexpected entry '+key);if(stat.isSymbolicLink()){assert.equal(row.type,'symlink');assert.equal(fs.readlinkSync(filename),row.target);}else{assert.ok(stat.isFile());assert.equal(stat.size,row.bytes);assert.equal(stat.mode&511,row.mode);const digest=crypto.createHash('sha256');let total=0;for await(const chunk of fs.createReadStream(filename)){total+=chunk.length;assert.ok(total<=row.bytes);digest.update(chunk);}assert.equal(total,row.bytes);assert.equal(digest.digest('hex'),row.sha256);const after=fs.lstatSync(filename);assert.equal(after.ino,stat.ino);assert.equal(after.mtimeMs,stat.mtimeMs);}seen.push(key);}}await walk();assert.deepEqual(seen.sort(),[...expected.keys()].sort());return{entries:seen.length,regular:rows.filter(row=>row.type!=='symlink').length,links:rows.filter(row=>row.type==='symlink').length,unexpectedEntries:0};}
const producer='/private/tmp/safe-bash-coherent-stage-a-20260829-r2';const records=seal.producerRecords;const tools=JSON.parse(read(path.join(base,'stage-a-r2/evidence/TOOLS-BEFORE.json'),records.find(row=>row.path==='TOOLS-BEFORE.json')));const emits=JSON.parse(read(path.join(base,'stage-a-r2/evidence/EMITTED.json'),records.find(row=>row.path==='EMITTED.json')));const toolCensus=await census(path.join(producer,'tools'),tools),distCensus=await census(path.join(producer,'source/dist'),emits);assert.equal(toolCensus.regular,2274);assert.equal(toolCensus.links,12);assert.equal(distCensus.regular,1012);
for(const filename of [binding.slot.workRoot,...binding.slot.outerCaptures])assert.equal(fs.existsSync(filename),false);const censusValue={checkedAt:new Date().toISOString(),source309:'All309 exact selected file bodies checked by prepare; not a whole-source-directory census because StageA setup outputs coexist',tools:toolCensus,dist:distCensus,slotAbsent:true,bodyExecution:0};fs.writeFileSync(path.join(here,'CENSUS.json'),JSON.stringify(censusValue,null,2)+'\n',{flag:'wx'});const censusBody=fs.readFileSync(path.join(here,'CENSUS.json'));const packet={schema:'b0-final-binding-packet-v1',binding:{path:'BINDING.json',...bindingIdentity},census:{path:'CENSUS.json',bytes:censusBody.length,sha256:sha(censusBody)},candidate:binding.candidate,preseal:binding.preseal,command:binding.command,timeWindow:{issuedAt:binding.issuedAt,latestStartAt:binding.latestStartAt,expiresAt:binding.expiresAt},reviewReceipt:binding.reviewReceipt,rootActivation:false,requiresDifferentFinalReview:true};fs.writeFileSync(path.join(here,'PACKET.json'),JSON.stringify(packet,null,2)+'\n',{flag:'wx'});const packetBody=fs.readFileSync(path.join(here,'PACKET.json'));const finish={finished:new Date().toISOString(),elapsedSeconds:(Date.now()-Date.parse(binding.issuedAt))/1000,explicitKnownStartsIncludingPublication:15,knownPeak:2,fullCensusClaim:false,packet:{bytes:packetBody.length,sha256:sha(packetBody)},productCalls:0,installs:0,workers:0,decodes:0};assert.ok(finish.elapsedSeconds<480);fs.writeFileSync(path.join(here,'PACKET-RECEIPT.json'),JSON.stringify(finish,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({...finish,census:censusValue}));

