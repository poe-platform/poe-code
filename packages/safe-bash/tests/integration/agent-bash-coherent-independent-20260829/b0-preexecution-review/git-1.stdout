421fb67dac779d4238ffafb03720a7610430f0295b7407a5f740abdf911"},{"path":"tests/integration/agent-bash-coherent-author-20260829/v2/SOURCE.json","bytes":137864,"sha256":"ef0b79dbd30cebec3f8b939a98928b9441947ff4be724e5031b2ee03925f26ae"},{"path":"tests/integration/agent-bash-coherent-author-20260829/v2/TOOLS-PREP.json","bytes":371,"sha256":"eb945189a5106a6bd0658b562b15dfad62f177bc006bb9d5e81b7c1004afa989"},{"path":"tests/integration/agent-bash-coherent-author-20260829/v2/TOOLS.json","bytes":558790,"sha256":"ba8c249f94d3ce894754ceff84aaba11d2fcb0f517624f5c2427c8b21da825b2"},{"path":"tests/integration/agent-bash-coherent-author-20260829/v2/TREE-WITNESSES.json","bytes":163171,"sha256":"a51d6e917e43161cc059522e236292ebc5a4d0d2b70c341726d602a6661b23f4"},{"path":"tests/integration/agent-bash-coherent-author-20260829/v2/admission.mjs","bytes":1629,"sha256":"e3e1b120fa4f97c18be4603d731c8c4639789139c8114125038796f7ac89f6a1"},{"path":"tests/integration/agent-bash-coherent-author-20260829/v2/consumer.ts.fixture","bytes":870,"sha256":"6694676de2c93256dc3895a066b0a950aa4b4a6e9a2889fa04dd142995b6b5ab"},{"path":"tests/integration/agent-bash-coherent-author-20260829/v2/negative.ts.fixture","bytes":805,"sha256":"db35c361825e452f0d80b3c5dbb12cf85fe76078cef76238279319b01dabc750"},{"path":"tests/integration/agent-bash-coherent-author-20260829/v2/prepare.mjs","bytes":24171,"sha256":"fbfe05cd3b41abdf8fb49ab3b1b42b4bbd21c11e615a60325fb1b61ff862c86b"},{"path":"tests/integration/agent-bash-coherent-author-20260829/v2/prepare.sh","bytes":388,"sha256":"aa007522f6ee2500678529208870739edf8a02396627c46fbc7dbc6c328ca3e2"},{"path":"tests/integration/agent-bash-coherent-author-20260829/v2/workflow-entry.mjs","bytes":3593,"sha256":"eb66a961ae08b04133c55e591a53b3e82540fe037b3c5d3ff9ca96d3d2fb8e77"},{"path":"tests/integration/agent-bash-coherent-author-20260829/v4/workflows.mjs","bytes":15763,"sha256":"6d8a19854a6e96986013ed3d94ee15dd774e225259dea922bf4749799c60d89b"}]}
{"role":"helper","commit":"4a0268f2561d3b2aabf7511656baad968ee64986","path":"tests/integration/git-public-20260829/resources.mjs","blob":"f57ddbeecc878698bc03a5f265f3f76386107fbb","bytes":1978,"sha256":"ee5d6c8ec02a2784232a04a9ca01e07a232bb8bc36a1d39b8e9f463c0ad49e92","text":"import fs from 'node:fs';\nimport path from 'node:path';\nimport workerThreads from 'node:worker_threads';\nimport { syncBuiltinESMExports } from 'node:module';\nimport { fileURLToPath } from 'node:url';\nimport { createHash } from 'node:crypto';\nimport assert from 'node:assert/strict';\n\nconst destination = process.env.RESOURCE_LOG;\nconst allowance = Number(process.env.RESOURCE_ALLOWANCE);\nassert.ok(destination && Number.isSafeInteger(allowance) && allowance >= 0);\nconst binding = JSON.parse(fs.readFileSync(process.env.PUBLIC_BINDING));\nconst emit = event => fs.appendFileSync(destination, JSON.stringify(event) + '\\n');\nconst NativeWorker = workerThreads.Worker;\nlet created = 0, live = 0;\nemit({ kind: 'bootstrap', pid: process.pid, allowance });\nworkerThreads.Worker = class extends NativeWorker {\n  constructor(filename, options) {\n    assert.ok(created < allowance && live < 2, 'owned worker admission budget');\n    const entry = filename instanceof URL ? fileURLToPath(filename) : filename;\n    const expected = path.join(binding.root, 'dist/commands/regex-execution/worker.js');\n    assert.equal(entry, expected, 'only selected RegexWorker is admitted');\n    const metadata = fs.lstatSync(entry); assert.ok(metadata.isFile() && !metadata.isSymbolicLink());\n    assert.equal(fs.realpathSync(entry), entry);\n    const row = binding.inputs.find(item => item.path === 'commands/regex-execution/worker.js');\n    assert.ok(row); assert.equal(createHash('sha256').update(fs.readFileSync(entry)).digest('hex'), row.sha256);\n    assert.deepEqual(options.execArgv, []);\n    super(filename, options);\n    const id = ++created; live++;\n    emit({ kind: 'worker-create', id, threadId: this.threadId, entry, sha256: row.sha256, live });\n    this.once('exit', code => { live--; emit({ kind: 'worker-exit', id, code, live }); });\n  }\n};\nsyncBuiltinESMExports();\nprocess.once('beforeExit', () => { emit({ kind: 'before-exit', created, live }); if (live !== 0) process.exitCode = 78; });\n"}
{"role":"helper","commit":"4a0268f2561d3b2aabf7511656baad968ee64986","path":"tests/integration/git-public-20260829/loader.mjs","blob":"9d2747828f958687f0ab5c2b93977c3988bf7ed6","bytes":1180,"sha256":"a16e8d37942478cf9dc876e360cf7e7085c590515bdca82bf90be421df7cf6b3","text":"import fs from 'node:fs/promises';\nimport path from 'node:path';\nimport { fileURLToPath } from 'node:url';\nimport { createHash } from 'node:crypto';\nconst binding = JSON.parse(await fs.readFile(process.env.PUBLIC_BINDING));\nconst admitted = new Map(binding.inputs.map(row => [path.join(binding.root, 'dist', row.path), row]));\nconst harness = new Map(binding.harness.map(row => [row.path, row]));\nconst digest = bytes => createHash('sha256').update(bytes).digest('hex');\nexport async function load(url, context, next) {\n  if (!url.startsWith('file:')) return next(url, context);\n  const file = fileURLToPath(url), data = await fs.readFile(file);\n  if (harness.has(file)) {\n    if (digest(data) !== harness.get(file).sha256) throw Error('harness hash mismatch');\n  } else {\n    if (!file.startsWith(binding.root + '/dist/')) throw Error('package outside authenticated compiled root');\n    const row = admitted.get(file); if (!row) throw Error('package binding missing member');\n    if (digest(data) !== row.sha256) throw Error('package hash mismatch');\n    await fs.appendFile(binding.trace, JSON.stringify({ file, sha256: row.sha256 }) + '\\n');\n  }\n  return next(url, context);\n}\n"}
{"role":"scripts","lines":[{"line":1,"text":"import assert from 'node:assert/strict';"},{"line":2,"text":"import { createHash } from 'node:crypto';"},{"line":3,"text":""},{"line":4,"text":"export const defaultNames = Object.freeze(['[','apply_patch','awk','base32','base64','basename','cat','chmod','cksum','column','comm','cp','cut','date','diff','dirname','du','echo','egrep','env','expand','expr','false','fgrep','file','find','fold','git','grep','gunzip','gzip','head','html-to-markdown','join','jq','ln','ls','md5sum','mkdir','mktemp','mv','nl','od','paste','patch','printenv','printf','pwd','readlink','realpath','rev','rg','rm','rmdir','sed','seq','sha1sum','sha256sum','sleep','sort','split','stat','strings','tac','tail','tar','tee','test','timeout','touch','tr','tree','true','unexpand','uniq','wc','which','xargs','xxd','zcat']);"},{"line":5,"text":"export const workflowIds = Object.freeze(Array.from({ length: 18 }, (_, index) => 'C' + String(index + 1).padStart(2, '0')));"},{"line":6,"text":"export const engineIds = Object.freeze(['C10','C11','C15','C16','C18']);"},{"line":7,"text":"export const engineFreeIds = Object.freeze(workflowIds.filter(id => !engineIds.includes(id)));"},{"line":8,"text":"const encode = value => new TextEncoder().encode(value);"},{"line":9,"text":"const text = value => new TextDecoder().decode(value);"},{"line":10,"text":"const outcome = promise => promise.then(value => ({ kind: 'return', value }), reason => ({ kind: 'throw', reason }));"},{"line":11,"text":"const turn = () => new Promise(resolve => setImmediate(resolve));"},{"line":12,"text":"function deferred() { let resolve; const promise = new Promise(accept => { resolve = accept; }); return { promise, resolve }; }"},{"line":13,"text":"function quote(value) { return \"'\" + value.replaceAll(\"'\", \"'\\\\''\") + \"'\"; }"},{"line":14,"text":"const gitBlob = value => { const body = Buffer.from(value); return createHash('sha1').update('blob ' + body.length + '\\0').update(body).digest('hex'); };"},{"line":15,"text":"const expectedDiff = replacement => 'diff --git a/README.md b/README.md\\nindex ' + gitBlob('hello staged\\n').slice(0, 7) + '..' + gitBlob(replacement + '\\n').slice(0, 7) + ' 100644\\n--- a/README.md\\n+++ b/README.md\\n@@ -1 +1 @@\\n-hello staged\\n+' + replacement + '\\n';"},{"line":16,"text":""},{"line":17,"text":"export async function runWorkflow(id, context) {"},{"line":18,"text":"  assert.ok(workflowIds.includes(id));"},{"line":19,"text":"  const { api, nodeApi, fixture } = context;"},{"line":20,"text":"  if (engineIds.includes(id)) assert.equal(context.engine?.role, 'SEPARATELY_AUTHENTICATED_PUBLIC_ENGINE');"},{"line":21,"text":"  const shells = [], releases = new Set(), events = [], memory = new api.MemoryFileSystem();"},{"line":22,"text":"  let prepares = 0, failure, failed = false;"},{"line":23,"text":"  const facts = { id, role: engineIds.includes(id) ? 'PUBLIC_ENGINE_REQUIRED' : 'ENGINE_FREE_PRODUCT_PROFILE', status: 'UNRUN', events };"},{"line":24,"text":"  const inert = { profile: nodeApi.NODE_PROFILE, identity: 'coherent-never-started-provider', prepare() { prepares++; throw new Error('unexpected provider preparation'); } };"},{"line":25,"text":"  const make = (filesystem = memory, cwd = '/') => { const shell = new api.Shell({ fs: filesystem, cwd, env: {} }); shell.use(api.agentCommands()); shells.push(shell); return shell; };"},{"line":26,"text":"  const addNode = (shell, grants = {}, provider = inert, replace = false) => shell.use(nodeApi.nodeCommands({ provider, grants, replace }));"},{"line":27,"text":"  const realProvider = () => {"},{"line":28,"text":"    const provider = context.engine.createProvider();"},{"line":29,"text":"    return { profile: provider.profile, identity: provider.identity, prepare(request, services) { prepares++; facts.requests ??= []; facts.requests.push({ argv: [...request.argv], cwd: request.cwd, filename: request.filename, selector: request.selector }); return provider.prepare(request, services); } };"},{"line":30,"text":"  };"},{"line":31,"text":"  const expect = async (shell, script, stdout, status = 0) => { const result = await shell.exec(script); assert.equal(result.exitCode, status); assert.equal(result.stdout, stdout); assert.equal(result.stderr, ''); return result; };"},{"line":32,"text":"  const fixtureSetup = async () => {"},{"line":33,"text":"    assert.equal(fixture.virtualRoot, '/repo'); assert.equal(fixture.oids.headCommit, '1cec77171d8321d533b3aa50b7a1a9df02b10816');"},{"line":34,"text":"    for (const entry of fixture.files) {"},{"line":35,"text":"      const filename = '/repo/' + entry.path; assert.ok(!entry.path.split('/').includes('..') && !entry.path.startsWith('/'));"},{"line":36,"text":"      await memory.mkdir(filename.slice(0, filename.lastIndexOf('/')), { recursive: true });"},{"line":37,"text":"      if (Object.hasOwn(entry, 'symlink')) await memory.symlink(entry.symlink, filename);"},{"line":38,"text":"      else await memory.writeFile(filename, Object.hasOwn(entry, 'base64') ? new Uint8Array(Buffer.from(entry.base64, 'base64')) : encode(entry.text), { mode: entry.mode });"},{"line":39,"text":"    }"},{"line":40,"text":"  };"},{"line":41,"text":"  const gitSnapshot = async () => Promise.all(fixture.files.filter(entry => entry.path.startsWith('.git/')).map(async entry => [entry.path, Buffer.from(await memory.readFile('/repo/' + entry.path)).toString('base64')]));"},{"line":42,"text":"  const curl = (shell, redirect = false) => {"},{"line":43,"text":"    const authorized = [], requests = [], disposals = [];"},{"line":44,"text":"    shell.use(api.networkCommands({ authorize(request) { authorized.push(request.url); return ['https://one.invalid/start','https://two.invalid/end'].includes(request.url); }, async transport(request) {"},{"line":45,"text":"      requests.push({ url: request.url, headers: request.headers.map(pair => [...pair]) });"},{"line":46,"text":"      const isRedirect = redirect && request.url === 'https://one.invalid/start';"},{"line":47,"text":"      return { status: isRedirect ? 302 : 200, statusText: isRedirect ? 'Found' : 'OK', headers: isRedirect ? [['location','https://two.invalid/end']] : [], body: (async function* () { if (!isRedirect) yield encode('{\"text\":\"hello changed\\\\n\"}\\n'); })(), async dispose() { disposals.push(request.url); } };"},{"line":48,"text":"    } }));"},{"line":49,"text":"    return { authorized, requests, disposals };"},{"line":50,"text":"  };"},{"line":51,"text":"  try {"},{"line":52,"text":"    if (id === 'C01') {"},{"line":53,"text":"      const shell = make(); await expect(shell, 'true', ''); assert.deepEqual(shell.commands.list().map(row => row.name).sort(), defaultNames);"},{"line":54,"text":"      for (const name of ['createNodeCommand','createNodeCommands','nodeCommands','createNodeWorkerProvider','NODE_PROFILE','NODE_ENGINE_ABI','nodeLimits','NodeProfileError','NodeUsageError']) assert.equal(api[name], nodeApi[name], name);"},{"line":55,"text":"      assert.equal(shell.commands.has('node'), false); assert.equal(shell.commands.has('curl'), false); assert.equal(shell.commands.has('safejs'), false);"},{"line":56,"text":"      const optional = make(); addNode(optional); curl(optional); await expect(optional, 'true', ''); assert.equal(optional.commands.list().length, 82); assert.equal(prepares, 0);"},{"line":57,"text":"      assert.throws(() => nodeApi.nodeCommands({}));"},{"line":58,"text":"    } else if (id === 'C02') await expect(make(), 'set -eu -o pipefail; value=\\'a b\\'; [[ \"$value\" == \\'a b\\' && ( x == x || $missing == z ) ]]; printf \\'%s\\\\n\\' \"$value\" | cat', 'a b\\n');"},{"line":59,"text":"    else if (id === 'C03') await expect(make(), \"[[ abc == a* ]]; printf '%s\\\\n' \\\"$?\\\"; [[ abc == 'a*' ]]; printf '%s\\\\n' \\\"$?\\\"\", '0\\n1\\n');"},{"line":60,"text":"    else if (id === 'C04') await expect(make(), 'set -u; a=(zero one); f(){ printf \\'%s\\\\n\\' \"${a[1]}\"; }; f', 'one\\n');"},{"line":61,"text":"    else if (id === 'C05') await expect(make(), 'set -o pipefail; false | cat; printf \\'%s\\\\n\\' \"$?\"', '1\\n');"},{"line":62,"text":"    else if (id === 'C06') { await expect(make(), 'f(){ printf out; printf err >&2; }; f 2>/audit |& cat', 'outerr'); assert.equal(text(await memory.readFile('/audit')), ''); }"},{"line":63,"text":"    else if (id === 'C07') {"},{"line":64,"text":"      await expect(make(), 'f(){ printf out; printf err >&2; }; f &>/both 1>/out', '');"},{"line":65,"text":"      assert.equal(text(await memory.readFile('/both')), 'err'); assert.equal(text(await memory.readFile('/out')), 'out');"},{"line":66,"text":"      facts.writerQualification = 'Effects here; close-count/alias controls remain in authenticated retained48 Unit1 cohort, not inferred from these effects.';"},{"line":67,"text":"    } else if (id === 'C08') { await memory.writeFile('/source.sh', encode(\"let 'n+=3'\")); await expect(make(), 'n=2; . /source.sh; printf \\'%s\\\\n\\' \"$n\"', '5\\n'); }"},{"line":68,"text":"    else if (id === 'C09') {"},{"line":69,"text":"      const shell = make(); addNode(shell); const result = await shell.exec('set -u; printf \\'%s\\' \"$missing\"; node -p \\'1\\'');"},{"line":70,"text":"      assert.equal(result.exitCode, 1); assert.equal(result.stdout, ''); assert.match(result.stderr, /missing/); assert.equal(prepares, 0);"},{"line":71,"text":"      facts.diagnostic = 'name/presence only; exact GNU status/bytes unqualified';"},{"line":72,"text":"    } else if (id === 'C10') {"},{"line":80,"text":"      assert.equal(text(await memory.readFile('/repo/README.md')), 'hello changed\\n');"},{"line":81,"text":"      await expect(make(new api.ReadOnlyFileSystem(memory), '/repo'), 'git diff -- README.md', expectedDiff('hello changed'));"},{"line":82,"text":"      assert.deepEqual(await gitSnapshot(), before); assert.deepEqual(network.authorized, ['https://one.invalid/start']);"},{"line":83,"text":"    } else if (id === 'C12') {"},{"line":84,"text":"      const shell = make(), network = curl(shell, true);"},{"line":85,"text":"      await expect(shell, \"curl -sS -L -H 'Authorization: Bearer synthetic' -o /payload.json https://one.invalid/start\", '');"},{"line":86,"text":"      assert.deepEqual(network.authorized, ['https://one.invalid/start','https://two.invalid/end']); assert.equal(network.requests.length, 2);"},{"line":87,"text":"      assert.equal(network.requests[1].headers.some(([name]) => name.toLowerCase() === 'authorization'), false);"},{"line":88,"text":"      assert.equal(text(await memory.readFile('/payload.json')), '{\"text\":\"hello changed\\\\n\"}\\n'); assert.equal(network.disposals.length, 2);"},{"line":89,"text":"    } else if (id === 'C13') {"},{"line":90,"text":"      await fixtureSetup(); const before = await gitSnapshot(), shell = make(new api.ReadOnlyFileSystem(memory), '/repo');"},{"line":91,"text":"      await expect(shell, 'git status --short', 'M  README.md\\nD  obsolete.txt\\n M src/app.txt\\n?? notes.txt\\n');"},{"line":92,"text":"      await expect(shell, 'git rev-parse HEAD', fixture.oids.headCommit + '\\n'); await expect(shell, 'git ls-files', 'README.md\\nsrc/app.txt\\n');"},{"line":93,"text":"      assert.deepEqual(await gitSnapshot(), before);"},{"line":94,"text":"    } else if (id === 'C14') {"},{"line":95,"text":"      await fixtureSetup(); const before = await gitSnapshot(), shell = make(memory, '/repo');"},{"line":96,"text":"      const patch = '*** Begin Patch\\n*** Update File: /repo/README.md\\n@@\\n-hello staged\\n+hello patched\\n*** End Patch\\n';"},{"line":97,"text":"      await expect(shell, `printf '%s' ${quote(patch)} | apply_patch >/patch.audit; git diff -- README.md`, expectedDiff('hello patched'));"},{"line":98,"text":"      assert.equal(text(await memory.readFile('/repo/README.md')), 'hello patched\\n'); assert.deepEqual(await gitSnapshot(), before);"},{"line":99,"text":"      facts.patchStdout = 'redirected; not an exact diagnostic-format oracle';"},{"line":100,"text":"    } else if (id === 'C15') {"},{"line":116,"text":"    } else if (id === 'C17') {"},{"line":117,"text":"      const entered = deferred(), gate = deferred(), shell = make(); addNode(shell); let writes = 0, settled = false;"},{"line":118,"text":"      const release = () => { events.push('release'); gate.resolve(); }; releases.add(release);"},{"line":119,"text":"      shell.commands.register({ name: 'guard', execute(command) {"},{"line":120,"text":"        command.registerCleanup(async () => { events.push('cleanup-enter'); entered.resolve(); await gate.promise; events.push('cleanup-finished'); throw false; });"},{"line":121,"text":"        events.push('registered'); return command.invoke('f', []);"},{"line":122,"text":"      } });"},{"line":123,"text":"      const pending = outcome(shell.exec('f(){ printf \"%s\" \"${absent:?required}\"; }; guard; node -p \\'1\\'', { stderr: { async write() { writes++; events.push('diagnostic'); throw 0; } } })).then(result => { settled = true; events.push('settled'); return result; });"},{"line":124,"text":"      try { await entered.promise; await turn(); assert.equal(settled, false); } finally { release(); releases.delete(release); }"},{"line":125,"text":"      const result = await pending; assert.equal(result.kind, 'throw'); assert.equal(result.reason, 0); assert.equal(writes, 1); assert.equal(prepares, 0);"},{"line":126,"text":"      assert.ok(events.indexOf('cleanup-finished') < events.indexOf('settled'));"},{"line":127,"text":"    } else if (id === 'C18') {"}]}

