for(const row of prep.tuples)add(path.join(repo,row.path),row);add(path.join(here,'stageAProducerPreseal.json'),prep.tuples[0]);for(const row of [producer.source,producer.tools])add(row.path,row);for(const row of prep.producerRecords.filter(item=>['PACKAGE-MEMBERS.json','EMITTED.json','TOOLS-BEFORE.json'].includes(item.path)))add(path.join(base,'stage-a-r2/evidence',row.path),row);
const stageFiles=[...prep.stageFiles];for(const name of ['runner.mjs','resources.mjs','loader.mjs','denials.mjs']){const row=add(path.join(here,name));stageFiles.push({source:row.path,target:name,bytes:row.bytes,sha256:row.sha256});}for(const row of stageFiles)add(path.join(repo,row.source),row);
const retained=JSON.parse(fs.readFileSync(path.join(base,'stage-b/RETAINED-SOURCES.json')));for(const name of ['resources.mjs','loader.mjs']){const row=retained.find(item=>item.path.endsWith('/'+name));add(path.join(here,name),row);}
