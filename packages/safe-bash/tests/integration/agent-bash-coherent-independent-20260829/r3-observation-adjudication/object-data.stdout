import fs from 'node:fs';import path from 'node:path';import assert from 'node:assert/strict';import {pathToFileURL} from 'node:url';import {gunzipSync} from 'node:zlib';
import {read,sha,streamed,inventory,json,supervisor,safe,reasonRecord} from './owner.mjs';
const here=import.meta.dirname,base=path.dirname(here),repo='/Users/kjopek/Workspace/safe-bash';
const node='/Users/kjopek/.nvm/versions/node/v22.22.2/bin/node';
function closure(root,members){const expected=new Map(members.map(row=>[row.path,row]));const dirs=new Set(['']);for(const row of members){let name=path.posix.dirname(row.path);while(name!=='.'){dirs.add(name);name=path.posix.dirname(name);}}const observed=inventory(root);assert.deepEqual(observed,members.slice().sort((left,right)=>Buffer.compare(Buffer.from(left.path),Buffer.from(right.path))));function directories(relative=''){for(const item of fs.readdirSync(path.join(root,relative),{withFileTypes:true})){const name=relative?relative+'/'+item.name:item.name;if(item.isDirectory()){assert.ok(dirs.has(name),'added directory '+name);directories(name);}else assert.ok(expected.has(name));}}directories();}
function unpackVerified(raw,members){const result=gunzipSync(raw,{maxOutputLength:67108864,info:true});assert.equal(result.engine.bytesWritten,raw.length);const tar=result.buffer;assert.ok(raw.length+tar.length+16777216<=100663296);const expected=new Map(members.map(row=>[row.path,row])),seen=new Set();let cursor=0,pax={},ended=false;const text=body=>body.subarray(0,body.indexOf(0)<0?body.length:body.indexOf(0)).toString();const oct=body=>{const value=text(body).trim();assert.match(value,/^[0-7]*$/);return parseInt(value||'0',8);};while(cursor+512<=tar.length){const header=tar.subarray(cursor,cursor+512);if(header.every(value=>value===0)){assert.ok(tar.subarray(cursor).every(value=>value===0));ended=true;break;}let sum=0;for(let index=0;index<512;index++)sum+=index>=148&&index<156?32:header[index];assert.equal(oct(header.subarray(148,156)),sum);const size=oct(header.subarray(124,136));assert.ok(size<=16777216);const start=cursor+512,end=start+size;assert.ok(end<=tar.length);const body=tar.subarray(start,end);cursor=start+Math.ceil(size/512)*512;if(header[156]===120){let offset=0;pax={};while(offset<body.length){const space=body.indexOf(32,offset);assert.ok(space>offset);const length=Number(body.subarray(offset,space).toString());assert.ok(Number.isSafeInteger(length)&&length>0&&offset+length<=body.length);const entry=body.subarray(space+1,offset+length-1).toString();assert.equal(body[offset+length-1],10);const equal=entry.indexOf('=');assert.ok(equal>0);pax[entry.slice(0,equal)]=entry.slice(equal+1);offset+=length;}continue;}assert.ok(header[156]===0||header[156]===48);assert.equal(text(header.subarray(157,257)),'');assert.ok(Object.keys(pax).every(key=>['path','mtime','atime','ctime','size','uid','gid','uname','gname'].includes(key)));const prefix=text(header.subarray(345,500));let name=pax.path??((prefix?prefix+'/':'')+text(header.subarray(0,100)));if(pax.size)assert.equal(Number(pax.size),size);pax={};assert.ok(name.startsWith('package/'));name=safe(name.slice(8));assert.ok(!seen.has(name));seen.add(name);const row=expected.get(name);assert.ok(row);assert.equal(size,row.bytes);assert.equal(sha(body),row.sha256);assert.equal(oct(header.subarray(100,108))&511,row.mode);}assert.ok(ended);assert.deepEqual([...seen].sort(),[...expected.keys()].sort());}
export async function main(args,started=performance.now()){assert.equal(args.length,4);assert.equal(args[0],'--run');const seal=JSON.parse(read(args[1],1048576,{sha256:args[2],bytes:Number(args[3])}));assert.equal(seal.schema,'coherent-b0-executable-preseal-v1');assert.equal(process.env.B0_ROOT_GO,'ROOT_B0_39_EXPLICIT_FRESH_AUTHORIZATION');assert.equal(seal.productSha256,'2fe071e2bfac5ef5c81dc7e475e059091f6add65cd7411dfcfbf0ce7f51f2eca');
