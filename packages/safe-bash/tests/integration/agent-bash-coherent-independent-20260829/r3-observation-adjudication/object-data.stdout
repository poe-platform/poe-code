 const report=JSON.parse(read(result.stdout,8388608));assert.equal(report.schema,'coherent-b0-result-v1');assert.deepEqual(report.rows.map(row=>row.id),seal.ids);assert.equal(report.layout,layout);assert.equal(report.rows.length,13);const events=read(resourceLog,1048576).toString().trim().split('\n').map(line=>JSON.parse(line));const created=events.filter(row=>row.kind==='worker-create'),exited=events.filter(row=>row.kind==='worker-exit');assert.ok(created.length<=2);assert.deepEqual(created.map(row=>row.id).sort(),exited.map(row=>row.id).sort());assert.ok(events.some(row=>row.kind==='before-exit'&&row.live===0));closure(packageRoot,members);for(const row of harness)read(row.path,4194304,row);aggregate.push({layout,report,regexWorkers:created.length,internalLoaderAdmissions:1,pid:result.pid});}
 verifyRetained();assert.deepEqual(inventory(path.join(producer,'tools'),toolLinks),toolExpected);read(archive,1048576,seal.package);for(const row of seal.files)read(path.join(repo,row.path),4194304,row);const workBytes=inventory(work).reduce((sum,row)=>sum+row.bytes,0);assert.ok(workBytes<=805306368);const retirement=manager.finish();manager.publish(path.join(work,'RESULT.json'),{status:aggregate.some(row=>row.report.failed)?'ASSERTION_FAILURE':'PASS',sourceTree:seal.sourceTree,package:seal.package,aggregate,retirement,workBytes,stageBRemaining:'UNRUN',coherentAcceptance:false});process.exitCode=aggregate.some(row=>row.report.failed)?1:0;
 }catch(error){failure=error;const retirement=manager.abort(error);try{manager.publish(path.join(work,'STOP.json'),{primaryPresent:true,primary:reasonRecord(error),retirement,automaticRetry:false,productSourceChanged:false});}catch(publicationError){console.error(JSON.stringify({terminalPersistence:false,primary:reasonRecord(error),publication:reasonRecord(publicationError)}));}process.exitCode=78;throw failure;}}
