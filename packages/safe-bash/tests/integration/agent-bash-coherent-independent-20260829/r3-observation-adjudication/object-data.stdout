 const commonEnv={PATH:path.dirname(node),HOME:path.join(work,'home'),TMPDIR:work,TMP:work,TEMP:work,LANG:'C',LC_ALL:'C',TZ:'UTC',NODE_OPTIONS:'',NPM_CONFIG_USERCONFIG:path.join(work,'home/user.npmrc'),NPM_CONFIG_GLOBALCONFIG:path.join(work,'home/global.npmrc'),NPM_CONFIG_OFFLINE:'true',NPM_CONFIG_AUDIT:'false',NPM_CONFIG_FUND:'false',NPM_CONFIG_UPDATE_NOTIFIER:'false'};
 const install=path.join(work,'installed');fs.mkdirSync(install);fs.writeFileSync(path.join(install,'package.json'),'{"private":true,"type":"module"}\n');const npm=path.join(producer,'tools/npm/bin/npm-cli.js');await manager.run('offline-install',node,['--experimental-permission','--allow-fs-read='+work,'--allow-fs-read='+path.join(producer,'tools'),'--allow-fs-read='+node,'--allow-fs-write='+install,'--allow-fs-write='+path.join(work,'cache'),'--allow-fs-write='+path.join(work,'home'),npm,'install','--offline','--ignore-scripts','--no-audit','--no-fund','--package-lock=false','--cache',path.join(work,'cache'),'--prefix',install,archive],{cwd:install,env:commonEnv,seconds:120});closure(path.join(install,'node_modules/virtual-bash'),members);
 const aggregate=[];for(const layout of ['source-built','installed','physically-moved']){manager.remaining();let consumer=path.join(work,layout);if(layout==='physically-moved')fs.renameSync(install,consumer);const packageRoot=path.join(consumer,'node_modules/virtual-bash');closure(packageRoot,members);const scripts=path.join(consumer,'b0');if(!fs.existsSync(scripts))fs.mkdirSync(scripts);for(const row of seal.stageFiles){const body=read(path.join(repo,row.source),4194304,row);fs.writeFileSync(path.join(scripts,row.target),body);}const resourceLog=path.join(consumer,'resources-'+layout+'.jsonl'),trace=path.join(consumer,'loads-'+layout+'.jsonl');const harness=seal.stageFiles.map(row=>({path:path.join(scripts,row.target),bytes:row.bytes,sha256:row.sha256}));const binding={root:packageRoot,inputs:members.filter(row=>row.path.startsWith('dist/')).map(row=>({...row,path:row.path.slice(5)})),harness,trace};json(path.join(consumer,'binding-'+layout+'.json'),binding);json(path.join(consumer,'request-'+layout+'.json'),{action:'B0_ENGINE_FREE_13',sourceTree:seal.sourceTree,layout,ids:seal.ids});
