const serialized = error => ({ name: error?.name, code: error?.code, message: String(error?.message ?? error).slice(0,4096) });
const report = {
  schema: 'coherent78-safejs-execution-v1', case: row.id, layout: process.env.C78_LAYOUT,
  classification: 'RUNNING', events: [], assertions: [], counters: { shellsCreated: 0, shellsDisposed: 0, publicExecs: 0, wrapperEntered: 0, wrapperSettled: 0, actualRunInvoked: 0, actualRunSettled: 0, guestEntries: 0, bridgeEntered: 0, literalInvokes: 0, bridgeSettled: 0, invocationCleanupEntered: 0, invocationCleanupDone: 0 },
  sourceSha256: sha(guestBytes), outerSha256: sha(row.outer), dispatch: [], unhandled: [],
