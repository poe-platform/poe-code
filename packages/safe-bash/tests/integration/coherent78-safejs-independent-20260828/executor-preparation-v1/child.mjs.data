const fixtures = JSON.parse(readBound('harness/CASES.json'));
const limits = JSON.parse(readBound('harness/RECIPE.json')).bounds;
const row = fixtures.cases.find(value => value.id === process.env.C78_CASE);
assert.ok(row && ['installed', 'moved'].includes(process.env.C78_LAYOUT));
const guestBytes = readBound('harness/' + row.guestFile);
const guestSource = guestBytes.toString('utf8');
const bridgeSource = row.id === 'G01' ? fixtures.filesystem.files['/work/flow.sh'] : row.id === 'G02'
