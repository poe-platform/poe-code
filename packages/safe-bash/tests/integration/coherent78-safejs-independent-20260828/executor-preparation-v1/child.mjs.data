      const modules = { ...options.modules, stdio: { ...options.modules.stdio, write: declareHostOperation(async text => {
        if (text === row.id + ':enter\n') {
          assert.equal(report.counters.actualRunInvoked, 1); report.counters.guestEntries++;
          mark('actual-guest-hostcall', { module: 'stdio', operation: 'write', sourceSha256: sha(source), text });
        }
        if (text === 'G02:forbidden-after-abort\n') mark('forbidden-after-abort');
