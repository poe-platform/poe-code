  report.finalResources = { pendingActualEnginePromises: pendingEngine.size, pendingBridgePromises: pendingBridge.size, pendingBodyNext: traffic.nextPending, outstandingIteratorReturn: traffic.returnPending, outstandingResponseDisposal: traffic.disposed - traffic.disposalDone, outstandingRegisteredCleanup: traffic.cleanup - traffic.cleanupDone, outstandingInvocationCleanup: report.counters.invocationCleanupEntered - report.counters.invocationCleanupDone, liveControlledClockHandles: clock.live.size, ownedTimers: ownedTimers.size, ownedSignalListeners: traffic.ownedListeners, unhandledRejections: report.unhandled.length, undisposedShells: report.counters.shellsCreated - report.counters.shellsDisposed };
