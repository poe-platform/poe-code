  }
  for (const name of ['clearTimeout', 'clearInterval']) globalThis[name] = handle => { ownedTimers.delete(handle); return originalTimers[name](handle); };
  const memory = new MemoryFileSystem();
  const seedSignal = new AbortController().signal;
  for (const directory of fixtures.filesystem.directories) await memory.mkdir(directory, { recursive: true, signal: seedSignal });
  for (const [filename, text] of Object.entries(fixtures.filesystem.files)) await memory.writeFile(filename, Buffer.from(text), { signal: seedSignal });
  await memory.writeFile(row.guestPath, guestBytes, { signal: seedSignal });
