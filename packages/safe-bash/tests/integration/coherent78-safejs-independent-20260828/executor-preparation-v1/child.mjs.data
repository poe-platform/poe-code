assert.ok(output.startsWith(root + '/logs/') && !fs.existsSync(output));
const persist = () => {
  const bytes = JSON.stringify(report) + '\n';
  assert.ok(Buffer.byteLength(bytes) <= limits.receiptBytesPerChild, 'RECEIPT_BOUND');
  fs.writeFileSync(output, bytes, { mode: 0o600 });
};
const mark = (event, detail = {}) => {
  assert.ok(report.events.length < limits.eventsPerChild, 'EVENT_BOUND');
  report.events.push({ ordinal: report.events.length + 1, event, ...detail });
  persist();
};
const check = (name, action) => {
  try { action(); report.assertions.push({ name, pass: true }); }
  catch (error) { report.assertions.push({ name, pass: false, error: serialized(error) }); }
};
const gate = () => {
  let release;
  const promise = new Promise(resolve => { release = resolve; });
  return { promise, release };
};
const turns = async () => { for (let index = 0; index < limits.microtaskCheckpointTurns; index++) await Promise.resolve(); };
const unhandled = error => { assert.ok(report.unhandled.length < 32); report.unhandled.push(serialized(error)); };
process.on('unhandledRejection', unhandled);
const pendingEngine = new Set();
const pendingBridge = new Set();
const ownedTimers = new Set();
const originalTimers = { setTimeout, clearTimeout, setInterval, clearInterval };
let shell, filesystem, activeContext, runtimeCleanup;
let invocationOpen = true;
const caller = new AbortController();
const bodyGate = gate(), disposalGate = gate(), releaseGate = gate();
const traffic = { authorization: [], requests: [], acquired: 0, next: 0, nextPending: 0, returned: 0, returnPending: 0, disposed: 0, disposalDone: 0, cleanup: 0, cleanupDone: 0, requestAborts: 0, ownedListeners: 0 };
const clock = { nowValue: 0, rows: [], live: new Set() };
const scheduler = {
  now() { assert.equal(this, scheduler); return clock.nowValue; },
  setTimeout(callback, milliseconds) {
    assert.equal(this, scheduler); assert.equal(milliseconds, 10); assert.equal(clock.rows.length, 0);
    const handle = { index: 0 };
    clock.rows.push({ handle, callback, milliseconds, fired: false, cleared: false }); clock.live.add(handle);
    mark('timer-arm', { milliseconds }); return handle;
  },
  clearTimeout(handle) {
    assert.equal(this, scheduler); const timer = clock.rows.find(value => value.handle === handle);
    assert.ok(timer && !timer.cleared); timer.cleared = true; clock.live.delete(handle); mark('timer-clear');
  },
};
const ownListener = (signal, callback) => {
  let attached = true;
  const detach = () => { if (attached) { attached = false; signal.removeEventListener('abort', callback); traffic.ownedListeners--; } };
  traffic.ownedListeners++; signal.addEventListener('abort', callback, { once: true });
  return detach;
};
let detachRequest = () => {};
async function snapshot(filesystemToRead) {
  const records = {};
  let bytes = 0;
  async function visit(directory) {
    for (const entry of (await filesystemToRead.readdir(directory, { signal: new AbortController().signal })).sort((left, right) => left.name.localeCompare(right.name, 'en'))) {
