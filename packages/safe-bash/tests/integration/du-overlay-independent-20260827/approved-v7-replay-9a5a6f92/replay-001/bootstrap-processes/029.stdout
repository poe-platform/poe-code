{
  "schema": 1,
  "fixture": {
    "name": "env-size-1500.bin",
    "length": 1500,
    "fillByte": 97,
    "sha256": "b935f6b7a9c56a15e7b99c8d6d4b5e918f5a68fafc4490544a446b2ae47bf809"
  },
  "sanitizedEnvironment": {
    "LC_ALL": "C",
    "LANG": "C"
  },
  "removedAmbientKeys": [
    "DU_BLOCK_SIZE", "BLOCK_SIZE", "BLOCKSIZE", "POSIXLY_CORRECT", "LANGUAGE",
    "LC_NUMERIC", "LC_MESSAGES", "DF_BLOCK_SIZE", "LS_BLOCK_SIZE"
  ],
  "cases": [
    { "id": "no-env-default", "selected": null, "args": ["--apparent-size"], "env": {}, "expect": { "statusClass": "success", "units": 2, "stderr": "" } },

    { "id": "du-block-size-valid-selected", "selected": "DU_BLOCK_SIZE", "args": ["--apparent-size"], "env": { "DU_BLOCK_SIZE": "3072", "BLOCK_SIZE": "512", "BLOCKSIZE": "256" }, "expect": { "statusClass": "success", "units": 1, "stderr": "" } },
    { "id": "du-block-size-invalid-fallback-default", "selected": "DU_BLOCK_SIZE", "args": ["--apparent-size"], "env": { "DU_BLOCK_SIZE": "invalid-value", "BLOCK_SIZE": "3072", "BLOCKSIZE": "512" }, "expect": { "statusClass": "success", "units": 2, "stderr": "" } },
    { "id": "du-block-size-empty-fallback-default", "selected": "DU_BLOCK_SIZE", "args": ["--apparent-size"], "env": { "DU_BLOCK_SIZE": "", "BLOCK_SIZE": "3072", "BLOCKSIZE": "512" }, "expect": { "statusClass": "success", "units": 2, "stderr": "" } },
    { "id": "du-block-size-explicit-valid-overrides", "selected": "DU_BLOCK_SIZE", "args": ["--apparent-size", "-B3072"], "env": { "DU_BLOCK_SIZE": "invalid-value", "BLOCK_SIZE": "512" }, "expect": { "statusClass": "success", "units": 1, "stderr": "" } },
    { "id": "du-block-size-explicit-invalid-strict", "selected": "DU_BLOCK_SIZE", "args": ["--apparent-size", "-B", "invalid-value"], "env": { "DU_BLOCK_SIZE": "3072", "BLOCK_SIZE": "512" }, "expect": { "statusClass": "failure", "stdout": "", "stderrClass": "invalid-block-size", "filesystemCalls": 0 } },

    { "id": "block-size-valid-selected", "selected": "BLOCK_SIZE", "args": ["--apparent-size"], "env": { "BLOCK_SIZE": "3072", "BLOCKSIZE": "512" }, "expect": { "statusClass": "success", "units": 1, "stderr": "" } },
    { "id": "block-size-invalid-fallback-default", "selected": "BLOCK_SIZE", "args": ["--apparent-size"], "env": { "BLOCK_SIZE": "invalid-value", "BLOCKSIZE": "3072" }, "expect": { "statusClass": "success", "units": 2, "stderr": "" } },
    { "id": "block-size-empty-fallback-default", "selected": "BLOCK_SIZE", "args": ["--apparent-size"], "env": { "BLOCK_SIZE": "", "BLOCKSIZE": "3072" }, "expect": { "statusClass": "success", "units": 2, "stderr": "" } },
    { "id": "block-size-explicit-valid-overrides", "selected": "BLOCK_SIZE", "args": ["--apparent-size", "-B3072"], "env": { "BLOCK_SIZE": "invalid-value", "BLOCKSIZE": "512" }, "expect": { "statusClass": "success", "units": 1, "stderr": "" } },
    { "id": "block-size-explicit-invalid-strict", "selected": "BLOCK_SIZE", "args": ["--apparent-size", "-B", "invalid-value"], "env": { "BLOCK_SIZE": "3072", "BLOCKSIZE": "512" }, "expect": { "statusClass": "failure", "stdout": "", "stderrClass": "invalid-block-size", "filesystemCalls": 0 } },

    { "id": "blocksize-valid-selected", "selected": "BLOCKSIZE", "args": ["--apparent-size"], "env": { "BLOCKSIZE": "3072" }, "expect": { "statusClass": "success", "units": 1, "stderr": "" } },
    { "id": "blocksize-invalid-fallback-default", "selected": "BLOCKSIZE", "args": ["--apparent-size"], "env": { "BLOCKSIZE": "invalid-value" }, "expect": { "statusClass": "success", "units": 2, "stderr": "" } },
    { "id": "blocksize-empty-fallback-default", "selected": "BLOCKSIZE", "args": ["--apparent-size"], "env": { "BLOCKSIZE": "" }, "expect": { "statusClass": "success", "units": 2, "stderr": "" } },
    { "id": "blocksize-explicit-valid-overrides", "selected": "BLOCKSIZE", "args": ["--apparent-size", "-B3072"], "env": { "BLOCKSIZE": "invalid-value" }, "expect": { "statusClass": "success", "units": 1, "stderr": "" } },
    { "id": "blocksize-explicit-invalid-strict", "selected": "BLOCKSIZE", "args": ["--apparent-size", "-B", "invalid-value"], "env": { "BLOCKSIZE": "3072" }, "expect": { "statusClass": "failure", "stdout": "", "stderrClass": "invalid-block-size", "filesystemCalls": 0 } }
  ]
}
