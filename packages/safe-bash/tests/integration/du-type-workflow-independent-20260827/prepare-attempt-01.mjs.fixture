    const boundaryConfig = structuredClone(config); boundaryConfig.compilerOptions.typeRoots = [join(state.root, "node_modules/@types")]; json(join(policy, "tsconfig.json"), boundaryConfig); json(join(policy, "package.json"), { type: "module", private: true });
    for (const entry of staged.entries) { const target = join(policy, entry.path); mkdirSync(dirname(target), { recursive: true }); writeFileSync(target, "RAW_DU_STAGING_DATA\n"); }
    const neighbors = ["src/review-boundary.ts", "tests/canonical/review-boundary.ts", ...staged.entries.filter(entry => entry.role === "versioned-template").map(entry => join(dirname(entry.path), "neighbor.ts"))];
    for (const path of neighbors) { const target = join(policy, path); mkdirSync(dirname(target), { recursive: true }); writeFileSync(target, "export const retained: number = 'invalid';\n"); }
    const boundary = execute("exact-du-exclusion-boundary", node22, [compiler, "--noEmit", "--pretty", "false", "-p", join(policy, "tsconfig.json")], policy, 2);
    check("seven neighbors fail while fourteen exact data paths stay excluded", () => { const diagnostics = boundary.stdout.split("\n").filter(line => line.includes("error TS")); assert.equal(diagnostics.length, 7); for (const path of neighbors) assert.ok(diagnostics.some(line => line.startsWith(path + "(") && line.includes("TS2322")), path); });
    check("candidate package complete inventory unchanged after execution", () => assert.deepEqual(manifest(packageRoot), binding.package.before));
    check("selected Git inputs unchanged and no new selected-tree files", () => {
      const current = manifest(state.root).filter(entry => !entry.path.startsWith("node_modules/"));
      assert.deepEqual(current, authentication.selectedInputs.map(({ path, bytes, sha256 }) => ({ path, bytes, sha256 })));
    });
    check("development tool inventory unchanged", () => assert.deepEqual(manifest(join(state.root, "node_modules")), authentication.developmentDependencies));
    report.observations.push("Known-role swaps pass the structural typecheck verifier but fail the separately pinned canonical policy fixture. No claim of structural per-role immutability.");
    report.finishedAt = new Date().toISOString();
  } catch (error) { report.failures.push({ name: "reviewer supervisor", error: error.stack }); }
  save(); console.log(JSON.stringify({ checks: report.checks.length, failures: report.failures, commands: report.commands.map(({ name, status }) => ({ name, status })) }));
  process.exitCode = report.failures.length ? 1 : 0;
} else throw new Error("usage: review.mjs prepare|run [new-receipts-directory]");
