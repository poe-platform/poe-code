{
  "name": "tests/integration/git-public-20260829/m1a-public-v2.mjs",
  "line": [
    "await record('PUBLIC-REGISTERED', 'authorized root export and exact public subpath retain zero dependencies', async () => { const api = await import(leaf('index.js')); assert.equal('gitCommands' in api, true); const packageJson = JSON.parse(await hostFs.readFile(path.join(root, 'package.json'))); assert.equal(Object.keys(packageJson.dependencies ?? {}).length, 0); assert.equal(Object.keys(packageJson.optionalDependencies ?? {}).length, 0); assert.deepEqual(packageJson.exports['./commands/git'], { types: './dist/commands/git/index.d.ts', import: './dist/commands/git/index.js' }); });"
  ]
