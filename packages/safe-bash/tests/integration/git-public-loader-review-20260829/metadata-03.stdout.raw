    for (;;) {
      const count = fs.readSync(descriptor, buffer, 0, buffer.length, null); readCalls++;
      if (count === 0) break;
      bytesRead += count; largestRead = Math.max(largestRead, count);
      assert.ok(bytesRead <= before.size); digest.update(buffer.subarray(0, count));
