const bootstrap = "import { parentPort } from \"node:worker_threads\";\nawait import(\"file:///private/tmp/safe-bash-owned-output-built-legacy-a_x4yi9h/candidate/dist/commands/regex-execution/worker.js\");\nparentPort.postMessage({ authorPrerequisite: \"import-complete\", workerUrl: \"file:///private/tmp/safe-bash-owned-output-built-legacy-a_x4yi9h/candidate/dist/commands/regex-execution/worker.js\" });\nparentPort.close();\n";
const worker = new Worker(bootstrap, { eval: true });
