    },
    {
      "id": "M05",
      "mutation": "result status256",
      "reject": "finite valid exit status"
    },
    {
      "id": "M06",
      "mutation": "drop stage exit status",
      "reject": "argv/status cardinality"
    },
    {
      "id": "M07",
      "mutation": "add unrecognized case key",
      "reject": "exact case schema"
    },
    {
      "id": "M08",
      "mutation": "replace one script byte while keeping manifest",
      "reject": "artifact digest binding"
    }
  ],
  "syntheticScope": "Eight in-memory malformed-data controls only. No source mutants, subject imports, current full gate or product pass count."
}

