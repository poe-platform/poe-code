  },
  "workflows": [
    {
      "id": "P01",
      "title": "Number actionable rows within a release-note slice",
      "classification": "STATIC_UNEXECUTED",
      "script": "sed -n '2,4p' notes | rg -n -F TODO | nl -ba -w 1 -s ':'",
      "argv": [
        [
          "sed",
          "-n",
          "2,4p",
          "notes"
        ],
        [
          "rg",
          "-n",
          "-F",
          "TODO"
        ],
        [
          "nl",
          "-ba",
          "-w",
          "1",
          "-s",
          ":"
        ]
      ],
      "expected": {
        "kind": "result",
        "exitCode": 0,
        "stdoutBase64": "MToxOlRPRE8gYWxwaGEKMjozOlRPRE8gYmV0YQo=",
        "stderrBase64": "",
        "stageExitCodes": [
          0,
          0,
          0
        ],
        "changedFiles": {},
        "absent": [
          "unexpected"
        ]
      },
      "reason": "sed emits source rows2-4; rg numbers that three-row stream1,3; nl numbers the two matches independently.",
