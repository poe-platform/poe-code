+def historical_schema(snapshot):
+    def metadata(entry):
+        projected = {key: value for key, value in entry.items() if key not in ['mtimeNs', 'ctimeNs']}
+        for field in ['mtime', 'ctime']:
+            seconds, nanoseconds = divmod(entry[field + 'Ns'], 1000000000)
+            projected[field + 'Ms'] = seconds * 1000 + nanoseconds / 1000000
+        return projected
+    return {
+        **{key: snapshot[key] for key in ['head', 'tree', 'status', 'staged']},
+        'index': metadata(snapshot['index']),
+        'metadata': {path: metadata(entry) for path, entry in snapshot['metadata'].items()},
+        'engine': [metadata(entry) for entry in snapshot['engine']],
+    }
+
 def private_identity(snapshot):
     pins = load(REPOSITORY / 'tests/integration/safejs-owned-output-prototype-review/lifecycle/SOURCE-PINS.json')['privateExpectedAtRelease']
+    expected_ns = load(HERE / 'expected-private-ns.json.data')
+    assert snapshot == expected_ns, 'Exact expected raw NS private state drift'
+    expected_ms = load(Path(BINDINGS['statusAuthorRoot']) / 'expected-private.json.data')
+    assert historical_schema(snapshot) == expected_ms, 'Historical whole metadata profile drift'
+    assert pins['status'] == load(Path(BINDINGS['statusAuthorRoot']) / 'PRIVATE-STATUS.json')['historicalStatus']
+    pins = {**pins, 'status': expected_ms['status']}
     for key in ['head', 'tree', 'status', 'staged']:
         assert snapshot[key] == pins[key], key
     assert snapshot['index']['sha256'] == pins['index']['sha256']
