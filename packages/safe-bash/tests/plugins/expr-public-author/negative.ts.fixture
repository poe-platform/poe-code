import { createExprCommands, type AgentCommandsOptions, type ExprCommandsOptions } from "virtual-bash";
import { exprCommands } from "virtual-bash/commands/expr";
const nestedReplace: AgentCommandsOptions = { expr: { replace: true } };
const nestedRegex: AgentCommandsOptions = { expr: { regex: { maxWorkers: 1 } } };
