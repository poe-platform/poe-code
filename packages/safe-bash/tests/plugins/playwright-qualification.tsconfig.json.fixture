{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": { "buffer": ["./node_modules/@types/node/buffer.d.ts"] },
    "noEmit": true
  },
  "files": ["consumer.ts"]
}
