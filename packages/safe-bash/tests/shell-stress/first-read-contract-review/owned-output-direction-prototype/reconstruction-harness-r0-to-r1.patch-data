 import { spawnSync, execFileSync } from 'node:child_process';
@@ -54,7 +54,11 @@
 run(process.execPath, [compiler, '-p', 'tsconfig.build.json']);
 assert.equal(hash(JSON.stringify(inventory('dist'))), handoff.compiledManifestSha256, 'Exact v2 compilation');
 const compilerOutput = run(process.execPath, [compiler, '--noEmit', '--listFiles', '-p', 'tsconfig.json']);
-const normalize = (path, base) => path.startsWith(base + '/') ? 'CANDIDATE/' + relative(base, path) : path;
+const normalize = (path, base) => {
+  const actualPath = realpathSync(path);
