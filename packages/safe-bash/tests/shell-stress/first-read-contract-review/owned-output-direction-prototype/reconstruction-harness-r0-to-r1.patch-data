--- a/restore-v2.mjs
+++ b/restore-v2.mjs
@@ -1,5 +1,5 @@
 import assert from 'node:assert/strict';
-import { readFileSync, readdirSync, mkdtempSync, mkdirSync, symlinkSync, chmodSync } from 'node:fs';
+import { readFileSync, readdirSync, mkdtempSync, mkdirSync, symlinkSync, chmodSync, realpathSync } from 'node:fs';
