    else if (index === 2) check('selected ShellLimitError identity', result.error === selected);
    else {check('public aggregate type', result.error instanceof AggregateError); check('both child identities present', cleanupErrors.map(error => containsIdentity(result.error, error)), [true, true]);}
    if (index >= 2) {check('opaque still unresolved after public settlement', shared.state.active, 1); shared.release.reject(lateError); const actual = await within(readOutcome, 'late opaque rejection observed'); check('exact late read rejection', actual.error === lateError);}
    check('each child cleanup awaited once', cleanups, [1, 1]);
    const survivor = await take(shell, shared); check('owner bytes after failed invocation', survivor, input.survivorBytes); borrowedChecks(shared);
    log('failure.subrun', {name: input.subruns[index], error: shape(result.error), cleanups, survivor, active: shared.state.active, failuresSoFar: failures.length});
  } finally {shared.release.resolve(); cleanupGate.resolve(); start.resolve(); await readOutcome; caller.abort(new Error('fixture teardown')); await outcome(within(shell.dispose(), 'error dispose'));}
}
async function main() {
  if (id === 'D01') await networkCase(false);
  else if (id === 'D02') await opaqueCase();
  else if (id === 'D03') await transferredCase();
  else if (id === 'D04') await parentCase();
  else if (id === 'D05') await childCase();
  else if (id === 'D06') await networkCase(true);
  else if (id === 'D07') {for (let index = 0; index < inputs.failureReasons.subruns.length; index++) {const before = failures.length; try {await failureSubrun(index);} catch (error) {failures.push({subrun: inputs.failureReasons.subruns[index], error: shape(error)});} log('subrun.result', {name: inputs.failureReasons.subruns[index], pass: failures.length === before});}}
  else throw new Error(`unknown case ${id}`);
}
try {await main();} catch (error) {failures.push({uncaught: shape(error)});}
await turn(); await turn(); check('no unhandled rejections', unhandled, []);
console.log(JSON.stringify({id, passed: failures.length === 0, records, failures, unhandled}));
process.exitCode = failures.length ? 1 : 0;
