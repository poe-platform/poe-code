    } finally {await parent.close();}
  }});
  try {const work = outcome(shell.exec(input.pipeline, {signal: caller.signal})); await within(ready.promise, 'child ready'); start.resolve(); await within(outputClosed.promise, 'child output closure'); const result = await within(work, 'child-isolation execution'); resultChecks(result.value, input.stderr); for (const [path, expected] of [[input.parentFile, input.parentBytes], [input.siblingFile, input.siblingBytes]]) check(`exact ${path}`, decode(await fs.readFile(path)), expected); log('child.effects', {parent: decode(await fs.readFile(input.parentFile)), sibling: decode(await fs.readFile(input.siblingFile)), stderr: result.value.stderr});}
