    },
    async return() {state.returns++; log('borrowed.return.callsite', {active: state.active, reads: state.next, callsite: new Error().stack.split('\n')[2]?.trim().replace(owned, 'OWNED')}); return {done: true};},
    cancel() {state.cancel++;},
    close() {state.close++;},
  };
  return {source, state, entered, release};
}
async function base() {
  const fs = new MemoryFileSystem(); await fs.mkdir('/direction', {recursive: true});
  const shell = new Shell({fs}); shell.use(agentCommands());
  shell.register({name: 'direction-take', async execute(context) {const item = await context.stdin[Symbol.asyncIterator]().next(); if (!item.done) await writeBytes(context.stdout, item.value, context.signal); return {exitCode: 0};}});
  const caller = new AbortController(), start = gate(), outputClosed = gate();
  const observation = {writes: 0, stages: [], producerStatuses: []};
  shell.use(async (context, next) => {
    if (context.command === 'head') await start.promise;
    if (context.command === 'curl' || context.command.startsWith('direction-') && context.command !== 'direction-take') {
      observation.stages.push(context.signal);
      const sink = context.stdout;
      const write = sink.write.bind(sink); sink.write = async chunk => {observation.writes++; await write(chunk);};
      if (sink.ownedOutput) {
        const capability = sink.ownedOutput, ownedWrite = capability.write.bind(capability);
        capability.write = async chunk => {observation.writes++; await ownedWrite(chunk);};
        capability.consumerClosed.addEventListener('abort', () => {outputClosed.resolve(capability.consumerClosed.reason); log('stdout.closed', {stageAborted: context.signal.aborted, callerAborted: caller.signal.aborted, writes: observation.writes});}, {once: true});
      }
      const result = await next(); observation.producerStatuses.push(result.exitCode); return result;
    }
    return next();
  });
  return {fs, shell, caller, start, outputClosed, observation};
}
async function take(shell, shared) {const result = await within(shell.exec('direction-take', {stdin: shared.source}), 'next owner'); return result.stdout;}
function borrowedChecks(shared) {check('borrowed return/cancel/close', [shared.state.returns, shared.state.cancel, shared.state.close], [0, 0, 0]); check('no concurrent underlying next', shared.state.maxActive, 1);}
function resultChecks(result, stderr = '') {check('shell status', result.exitCode, 0); check('shell stdout', result.stdout, ''); check('shell stderr', result.stderr, stderr);}
async function loopback(body, mixed = false) {
  const sockets = new Set(), requests = [], wire = [], finished = gate();
  const server = createServer(async (request, response) => {
    const parts = []; for await (const chunk of request) parts.push(chunk);
    requests.push({url: request.url, body: Buffer.concat(parts).toString()});
    response.sendDate = false; response.setHeader('Content-Length', Buffer.byteLength(body));
    if (mixed) response.setHeader('X-Direction', 'mixed');
    response.setHeader('Connection', 'close'); response.end(body);
    response.once('finish', () => finished.resolve());
  });
  server.on('connection', socket => {
    sockets.add(socket); socket.once('close', () => sockets.delete(socket));
    const write = socket.write.bind(socket);
    socket.write = (chunk, ...args) => {wire.push(Buffer.from(chunk)); return write(chunk, ...args);};
  });
  server.listen(0, '127.0.0.1'); await once(server, 'listening');
  const origin = `http://127.0.0.1:${server.address().port}`;
  return {origin, requests, wire, sockets, finished, async cleanup() {const done = new Promise(resolve => server.close(resolve)); server.closeAllConnections(); for (const socket of sockets) socket.destroy(); await done; await turn(); log('server.cleanup', {sockets: sockets.size});}};
}
async function networkCase(mixed) {
  const fixture = await base(), {shell, fs, caller, start, outputClosed, observation} = fixture;
  const input = mixed ? inputs.mixedCurl : inputs.borrowedCurl;
  const shared = cursor(mixed ? input.borrowedChunks : input.chunks, input.pendingChunkIndex);
  const server = await loopback(mixed ? input.responseBody : input.serverBody, mixed);
  shell.use(networkCommands({authorize: request => request.url === server.origin + (mixed ? '/mixed' : '/borrowed') && request.method === 'POST'}));
  if (mixed) shell.use(async (context, next) => {if (context.command !== 'curl') return next(); try {return await next();} finally {await fs.writeFile(input.independentFile, encode(input.independentBytes), {signal: context.signal}); await writeBytes(context.stderr, encode(input.independentStderr), context.signal);}});
  let execution;
  try {
    const command = input.argv.map(value => value.replace('${LOOPBACK_ORIGIN}', server.origin)).map(value => `'${value.replaceAll("'", "'\\''")}'`).join(' ') + input.pipelineSuffix;
    execution = outcome(shell.exec(command, {stdin: shared.source, signal: caller.signal}));
    await within(shared.entered.promise, 'curl active second next');
    check('exactly prefix and pending read before close', shared.state.next, 2); check('no request before bounded prebuffer completes', server.requests.length, 0);
    start.resolve(); await within(outputClosed.promise, 'actual downstream closure');
    check('closure before stdout write', observation.writes, 0); check('stage/caller live at close', [observation.stages[0].aborted, caller.signal.aborted], [false, false]);
    check('opaque read still active at closure', shared.state.active, 1);
    log('pending.snapshot', {next: shared.state.next, active: shared.state.active, requests: server.requests.length});
    shared.release.resolve();
    const settled = await within(execution, 'curl completion');
    check('curl public result exists', Object.hasOwn(settled, 'value'));
    if (settled.value) resultChecks(settled.value, mixed ? input.independentStderr : '');
    await turn(); await turn();
    log('curl.result', {result: settled.value ? {exitCode: settled.value.exitCode, stdout: settled.value.stdout, stderr: settled.value.stderr} : shape(settled.error), statuses: observation.producerStatuses, reads: shared.state.next, requests: server.requests.length});
    if (mixed) {
      check('one committed mixed request', server.requests.length, 1); check('exact mixed upload', server.requests[0]?.body, input.uploadBytes);
      const effects = {};
      for (const [path, expected] of [['/direction/body', input.responseBody], ['/direction/headers', input.responseWireHeaders], [input.independentFile, input.independentBytes]]) {const read = await outcome(fs.readFile(path)); effects[path] = read.value ? decode(read.value) : shape(read.error); check(`exact VFS ${path}`, effects[path], expected);}
      log('vfs.effects', effects);
      const actualWire = Buffer.concat(server.wire).toString(); check('exact response wire', actualWire, input.responseWireHeaders + input.responseBody);
      log('wire', {value: actualWire});
    } else {
      const curlDelivered = [...shared.state.delivered];
      const sibling = await take(shell, shared), owner = await take(shell, shared);
      check('exact positive sibling remainder', sibling, input.chunks[input.siblingChunkIndex]); check('exact positive owner remainder', owner, input.chunks[input.ownerChunkIndex]);
      check('no curl theft of suffix', curlDelivered, [0, 1]);
      const committed = server.requests.map(request => request.body).join('');
      check('prefix and late committed or public handback', committed, input.chunks[0] + input.chunks[1]);
      log('cursor.accounting', {delivered: shared.state.delivered, curlDelivered, committed, sibling, owner, handbackApi: false});
    }
    borrowedChecks(shared);
    for (let index = 0; index < 10 && server.sockets.size; index++) await turn();
    check('owned sockets closed before teardown', server.sockets.size, 0);
    log('network.before-teardown', {requests: server.requests, sockets: server.sockets.size, borrowed: shared.state});
  } finally {shared.release.resolve(); start.resolve(); caller.abort(new Error('fixture teardown')); if (execution) await within(execution, 'network teardown'); await within(shell.dispose(), 'shell dispose'); await server.cleanup();}
}
async function opaqueCase() {
  const {shell, fs, caller, start, outputClosed, observation} = await base(); const input = inputs.opaqueRead;
  const shared = cursor(input.chunks, input.pendingChunkIndex); let actualRead, commit, operation, operationDone = false;
  shell.register({name: 'direction-opaque', async execute(context) {
    operation = createOutputOperation(context, context.stdout);
    actualRead = shared.source.next();
    commit = actualRead.then(async item => {if (!item.done) await context.fs.writeFile(input.recordPath, item.value, {signal: context.signal});});
    void commit.catch(() => {});
    try {await operation.acquire(() => actualRead, async () => {});} catch (error) {if (error !== operation.signal.reason) throw error;} finally {await operation.close(); operationDone = true;}
    return {exitCode: 0};
  }});
  let execution;
  try {
    execution = outcome(shell.exec(input.pipeline, {stdin: shared.source, signal: caller.signal}));
    await within(shared.entered.promise, 'opaque next entry'); start.resolve(); await within(outputClosed.promise, 'opaque output closure');
    await within(execution, 'opaque public settlement excluding unregistered work');
    log('opaque.pending', {operationDone, active: shared.state.active, next: shared.state.next});
    check('opaque actual read remains pending', shared.state.active, 1); check('stage/caller live', [observation.stages[0].aborted, caller.signal.aborted], [false, false]);
    shared.release.resolve(); await within(commit, 'actual independent late VFS commit');
    const record = decode(await fs.readFile(input.recordPath)), sibling = await take(shell, shared), owner = await take(shell, shared);
    check('exact committed late chunk', record, input.chunks[0]); check('opaque sibling bytes', sibling, input.chunks[1]); check('opaque owner bytes', owner, input.chunks[2]);
    borrowedChecks(shared); resultChecks((await execution).value); log('opaque.effects', {record, sibling, owner, state: shared.state});
  } finally {shared.release.resolve(); start.resolve(); await commit?.catch(() => {}); caller.abort(new Error('fixture teardown')); await within(shell.dispose(), 'opaque dispose');}
}
async function transferredCase() {
  const {shell, fs, caller, start, outputClosed, observation} = await base(); const input = inputs.transferredRead;
  const cleanupGate = gate(), entered = gate(); const borrowed = cursor([input.unrelatedBorrowedBytes]);
  let operation, contextRef, cleanup, returns = 0, active = 0, reads = 0, work;
  shell.register({name: 'direction-transferred', async execute(context) {
    contextRef = context; operation = createOutputOperation(context, context.stdout); let completion;
    cleanup = () => completion ??= (async () => {await cleanupGate.promise; returns++; active = 0;})();
    operation.registerCleanup(cleanup);
    log(input.ownershipEvent);
    try {await operation.acquire(signal => {reads++; active++; entered.resolve(); return closed(signal).then(() => ({bytes: encode(input.ownedPendingBytes)}));}, cleanup);} catch (error) {if (error !== operation.signal.reason) throw error;} finally {await operation.close();}
