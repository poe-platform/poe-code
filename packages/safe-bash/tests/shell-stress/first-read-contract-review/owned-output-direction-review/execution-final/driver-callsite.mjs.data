    check('no late admission callback', lateStarted, 0); check('same selected reason at three levels', reasons, [true, true, true]);
    const closeOne = parent.close(), closeTwo = parent.close(); check('shared parent drain', closeOne === closeTwo); await pending(closeOne, 'parent awaits admitted acquisition');
    acquisitionGate.resolve(); await within(admitted, 'cooperative acquisition settles'); await pending(closeOne, 'parent still awaits gated grandchild');
    await fs.writeFile(input.postCloseFile, encode(input.postCloseBytes), {signal: contextRef.signal}); await writeBytes(contextRef.stderr, encode(input.postCloseStderr), contextRef.signal);
    check('outside-tree exact file', decode(await fs.readFile(input.postCloseFile)), input.postCloseBytes); check('outside stage/caller live', [contextRef.signal.aborted, caller.signal.aborted], [false, false]);
    const disposeOne = shell.dispose(), disposeTwo = shell.dispose(); await pending(disposeOne, 'public dispose awaits transitive cleanup');
    childGate.resolve(); await pending(closeOne, 'grandchild remains in parent drain after child done'); grandGate.resolve();
    await within(Promise.allSettled([closeOne, closeTwo, work, disposeOne, disposeTwo]), 'tree drains'); check('owned releases once each', releases, {child: 1, grandchild: 1});
    const resource = await outcome(fs.stat('/direction/admitted-resource')); check('owned VFS resource released', resource.error?.code, 'ENOENT');
    check('outside-tree exact stderr', stderr.join(''), input.postCloseStderr);
    log('tree.effects', {releases, lateStarted, reasons, file: decode(await fs.readFile(input.postCloseFile)), stderr: stderr.join(''), work: shape((await work).error)});
  } finally {acquisitionGate.resolve(); childGate.resolve(); grandGate.resolve(); start.resolve(); caller.abort(new Error('fixture teardown')); await within(shell.dispose(), 'tree final dispose');}
}
async function childCase() {
  const {shell, fs, caller, start, outputClosed} = await base(); const input = inputs.childIsolation; const ready = gate();
  let parent, child, sibling, stage; const destination = {async write() {}};
  shell.register({name: 'direction-child', async execute(context) {
    stage = context.signal; parent = createOutputOperation(context, destination); child = parent.child(context.stdout); sibling = parent.child(destination); ready.resolve();
    try {
      await closed(child.signal); await child.close();
      check('child abort isolates parent/sibling/stage/caller', [child.signal.aborted, parent.signal.aborted, sibling.signal.aborted, stage.aborted, caller.signal.aborted], [true, false, false, false, false]);
      await parent.acquire(async signal => {await fs.writeFile(input.parentFile, encode(input.parentBytes), {signal}); return input.parentFile;}, async () => {});
      await sibling.acquire(async signal => {await fs.writeFile(input.siblingFile, encode(input.siblingBytes), {signal}); return input.siblingFile;}, async () => {});
      await writeBytes(context.stderr, encode(input.stderr), context.signal);
