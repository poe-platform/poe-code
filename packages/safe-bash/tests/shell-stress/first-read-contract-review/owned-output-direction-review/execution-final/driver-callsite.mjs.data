function containsIdentity(error, expected) {return error === expected || error instanceof AggregateError && error.errors.some(child => containsIdentity(child, expected));}
async function failureSubrun(index) {
  const {shell, caller, start, outputClosed} = await base(); const input = inputs.failureReasons;
  const shared = cursor(['controlled-pending\n', input.survivorBytes], 0), cleanupGate = gate(), ready = gate();
  const cleanupErrors = input.cleanupErrorMessages.map(message => new Error(message)), lateError = new Error(input.lateReadErrorMessage);
  const selected = new ShellLimitError('maxCommands'); selected.message = input.executionErrorMessage;
  const callerReason = index === 0 ? input.callerObject : input.callerPrimitive;
  let readOutcome, parent, cleanups = [0, 0];
  shell.register({name: 'direction-failure', execute() {return {exitCode: 0};}});
  shell.use(async (context, next) => {
    if (context.command !== 'direction-failure') return next();
    parent = createOutputOperation(context, context.stdout);
    for (const childIndex of [0, 1]) {const child = parent.child({async write() {}}); let completion; child.registerCleanup(() => completion ??= (async () => {await cleanupGate.promise; cleanups[childIndex]++; throw cleanupErrors[childIndex];})());}
    readOutcome = outcome(shared.source.next()); ready.resolve();
    try {await closed(parent.signal); if (index === 2) throw selected; return {exitCode: 0};} finally {void parent.close().catch(() => {});}
  });
