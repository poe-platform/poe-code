    work = outcome(shell.exec(input.pipeline, {signal: caller.signal})); await within(entered.promise, 'owned read starts'); start.resolve(); await within(outputClosed.promise, 'transferred close');
    const closeOne = operation.close(), closeTwo = operation.close(); check('operation close shares promise', closeOne === closeTwo);
    await pending(work, 'public work waits for cooperative cleanup');
    await fs.writeFile(input.postCloseFile, encode(input.postCloseBytes), {signal: contextRef.signal});
    const survivor = await take(shell, borrowed); check('unrelated borrowed survives', survivor, input.unrelatedBorrowedBytes); borrowedChecks(borrowed);
    check('transfer file effect', decode(await fs.readFile(input.postCloseFile)), input.postCloseBytes);
    check('stage/caller before disposal', [contextRef.signal.aborted, caller.signal.aborted], [false, false]);
    const disposeOne = shell.dispose(), disposeTwo = shell.dispose(); check('dispose shares promise', disposeOne === disposeTwo); await pending(disposeOne, 'dispose waits cleanup');
    cleanupGate.resolve(); await within(Promise.allSettled([work, closeOne, closeTwo, disposeOne, disposeTwo]), 'all owned cleanup completion');
    check('one owned release', returns, 1); check('one started read', reads, 1); check('no active owned read', active, 0); check('no first write', observation.writes, 0);
    log('transfer.effects', {reads, returns, active, survivor, file: decode(await fs.readFile(input.postCloseFile)), result: shape((await work).error)});
  } finally {cleanupGate.resolve(); start.resolve(); caller.abort(new Error('fixture teardown')); await within(shell.dispose(), 'transfer final dispose');}
}
async function parentCase() {
  const {shell, fs, caller, start, outputClosed} = await base(); const input = inputs.parentTree;
  const ready = gate(), acquisitionGate = gate(), childGate = gate(), grandGate = gate();
  const releases = {child: 0, grandchild: 0}; let parent, child, grandchild, contextRef, admitted, work; const stderr = [];
  const destination = {async write() {}};
  shell.register({name: 'direction-parent', async execute(context) {
    contextRef = context; parent = createOutputOperation(context, context.stdout); child = parent.child(destination); grandchild = child.child(destination);
    let childCompletion, grandCompletion;
    child.registerCleanup(() => childCompletion ??= (async () => {await childGate.promise; releases.child++;})());
    const releaseResource = async path => {await grandGate.promise; await fs.rm(path, {force: true}); releases.grandchild++;};
    let resourceRelease; const onceRelease = path => resourceRelease ??= releaseResource(path);
    grandchild.registerCleanup(() => grandCompletion ??= (async () => {const path = await admitted; await onceRelease(path);})());
    admitted = acquisitionGate.promise.then(async () => {const path = '/direction/admitted-resource'; await fs.writeFile(path, encode('cooperative-resource\n')); return path;});
