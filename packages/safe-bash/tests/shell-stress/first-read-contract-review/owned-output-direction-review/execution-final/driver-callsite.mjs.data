import assert from 'node:assert/strict';
import {readFileSync} from 'node:fs';
import {createServer} from 'node:http';
import {once} from 'node:events';
import {setImmediate as turn} from 'node:timers/promises';
import {Shell, ShellLimitError, MemoryFileSystem, agentCommands, networkCommands, createOutputOperation, writeBytes} from './candidate/dist/index.js';

const inputs = JSON.parse(readFileSync(new URL('./inputs.json', import.meta.url)));
const id = process.argv[2];
const encode = value => new TextEncoder().encode(value);
const decode = value => new TextDecoder().decode(value);
const records = [];
const failures = [];
const unhandled = [];
process.on('unhandledRejection', reason => unhandled.push(String(reason)));
const gate = () => { let resolve, reject; const promise = new Promise((accept, fail) => {resolve = accept; reject = fail;}); return {promise, resolve, reject}; };
const outcome = promise => Promise.resolve(promise).then(value => ({value}), error => ({error}));
const shape = value => value instanceof Error ? {name: value.name, message: value.message, code: value.code, errors: value.errors?.map(shape)} : value;
const log = (event, detail = {}) => { const entry = {event, ...detail}; assert.ok(records.length < inputs.bounds.maxEvents); assert.ok(Buffer.byteLength(JSON.stringify(entry)) <= inputs.bounds.maxEventBytes); records.push(entry); };
const check = (label, actual, expected = true) => { try {assert.deepEqual(actual, expected);} catch {failures.push({label, actual, expected});} };
async function within(promise, label) { let timer; try {return await Promise.race([promise, new Promise((_, reject) => {timer = setTimeout(() => reject(new Error(`1200ms guard: ${label}`)), inputs.bounds.cooperativePhaseMs);})]);} finally {clearTimeout(timer);} }
const closed = signal => signal.aborted ? Promise.resolve() : new Promise(resolve => signal.addEventListener('abort', resolve, {once: true}));
async function pending(promise, label) {let settled = false; void promise.then(() => {settled = true;}, () => {settled = true;}); await turn(); await turn(); check(label, settled, false);}
function cursor(chunks, heldIndex = -1) {
  const entered = gate(), release = gate(); let index = 0;
  const state = {next: 0, returns: 0, cancel: 0, close: 0, active: 0, maxActive: 0, delivered: []};
  const source = {
    [Symbol.asyncIterator]() {return this;},
    async next() {
      state.next++; state.active++; state.maxActive = Math.max(state.maxActive, state.active);
      const current = index++;
