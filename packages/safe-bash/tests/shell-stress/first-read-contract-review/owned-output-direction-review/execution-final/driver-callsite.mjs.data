    execution = outcome(shell.exec(input.pipeline, {stdin: shared.source, signal: caller.signal})); await within(ready.promise, 'error case ready'); await within(shared.entered.promise, 'error opaque read entered'); start.resolve(); await within(outputClosed.promise, 'error stdout closure');
    await pending(execution, 'public settlement awaits registered child cleanup');
    if (index < 2) {caller.abort(callerReason); shared.release.resolve(); await within(readOutcome, 'caller variant read completion');}
    cleanupGate.resolve(); const result = await within(execution, 'selected public error');
