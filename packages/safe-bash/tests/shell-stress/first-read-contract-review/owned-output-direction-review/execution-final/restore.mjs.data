import assert from 'node:assert/strict';
import { readFileSync, readdirSync, mkdtempSync, mkdirSync, symlinkSync, chmodSync, realpathSync } from 'node:fs';
import { createHash } from 'node:crypto';
import { resolve, relative } from 'node:path';
import { spawnSync, execFileSync } from 'node:child_process';
const root = '/Users/kjopek/Workspace/safe-bash';
assert.equal(process.cwd(), root);
const owned = resolve(root, 'tests/shell-stress/first-read-contract-review/owned-output-direction-prototype');
const old = resolve(root, 'tests/shell-stress/first-read-contract-review/owned-output-prototype');
const hash = bytes => createHash('sha256').update(bytes).digest('hex');
const handoff = JSON.parse(readFileSync(resolve(owned, 'handoff.json')));
assert.equal(hash(readFileSync(resolve(old, 'handoff.json'))), handoff.baselineHandoffSha256);
const v1 = JSON.parse(readFileSync(resolve(old, 'handoff.json')));
const baseline = JSON.parse(readFileSync(resolve(old, 'reconstruction.json')));
for (const [path, expected] of [[resolve(old, 'baseline.tar.gz.data'), handoff.baselineArchiveSha256], [resolve(old, 'source-r1.patch-data'), handoff.baselinePatchSha256], [resolve(owned, handoff.sourcePatch), handoff.sourcePatchSha256], [resolve(owned, handoff.authorFixture), handoff.authorFixtureSha256]]) assert.equal(hash(readFileSync(path)), expected, path);
assert.equal(hash(readFileSync(process.execPath)), handoff.tools.node.sha256);
for (const tool of handoff.tools.development) assert.equal(hash(readFileSync(resolve(root, tool.path))), tool.sha256);
for (const tool of handoff.compilerInputs.filter(entry => entry.classification === 'authenticated-existing-dev-tooling')) assert.equal(hash(readFileSync(tool.path)), tool.sha256);
const temp = mkdtempSync('/tmp/safe-bash-owned-output-direction-review-final-replay-');
const candidate = resolve(temp, 'candidate'); mkdirSync(candidate);
const children = [];
const run = (command, args, cwd = candidate) => {
  const result = spawnSync(command, args, { cwd, encoding: 'utf8', timeout: 30000, maxBuffer: 8 * 1024 * 1024 });
  assert.equal(result.error, undefined); assert.equal(result.status, 0, result.stdout + result.stderr);
  let alive = false; try { process.kill(result.pid, 0); alive = true; } catch (error) { assert.equal(error.code, 'ESRCH'); }
  assert.equal(alive, false);
  children.push({ command, args, pid: result.pid, status: result.status, signal: result.signal, aliveAfterReap: alive });
  return result.stdout;
};
const put = (path, bytes) => {
  const input = `*** Begin Patch\n*** Add File: ${path}\n${bytes.replace(/\n$/, '').split('\n').map(line => '+' + line).join('\n')}\n*** End Patch\n`;
  execFileSync('apply_patch', [], { cwd: root, encoding: 'utf8', input, timeout: 5000 });
};
const archive = resolve(old, 'baseline.tar.gz.data');
const names = run('/usr/bin/tar', ['-tzf', archive]).split('\n').filter(Boolean);
assert.ok(names.every(name => !name.startsWith('/') && !name.split('/').includes('..')));
run('/usr/bin/tar', ['-xzf', archive, '-C', candidate]);
for (const entry of baseline.files) assert.equal(hash(readFileSync(resolve(candidate, entry.path))), entry.sha256);
run('/usr/bin/git', ['apply', '--check', resolve(old, 'source-r1.patch-data')]);
run('/usr/bin/git', ['apply', resolve(old, 'source-r1.patch-data')]);
for (const name of ['owned-output-author.test.ts', 'adapted-first-read-probe.ts', 'adapted-remote-close.test.ts']) put(resolve(candidate, 'tests/shell', name), readFileSync(resolve(old, `${name}.data`), 'utf8'));
for (const entry of [...v1.source, ...v1.tests]) assert.equal(hash(readFileSync(resolve(candidate, entry.path))), entry.sha256);
symlinkSync(resolve(root, 'node_modules'), resolve(candidate, 'node_modules'), 'dir');
const compiler = resolve(root, 'node_modules/typescript/bin/tsc');
run(process.execPath, [compiler, '-p', 'tsconfig.build.json']);
const walk = directory => readdirSync(directory, { withFileTypes: true }).flatMap(entry => entry.isDirectory() ? walk(resolve(directory, entry.name)) : entry.isFile() ? [resolve(directory, entry.name)] : []).sort();
const inventory = directory => walk(resolve(candidate, directory)).map(path => ({ path: relative(candidate, path), bytes: readFileSync(path).length, sha256: hash(readFileSync(path)) }));
assert.equal(hash(JSON.stringify(inventory('dist'))), v1.compiledManifestSha256, 'Exact v1 compilation before v2 delta');
run('/usr/bin/git', ['apply', '--check', resolve(owned, handoff.sourcePatch)]);
run('/usr/bin/git', ['apply', resolve(owned, handoff.sourcePatch)]);
put(resolve(candidate, 'tests/shell/owned-output-direction-author.test.ts'), readFileSync(resolve(owned, handoff.authorFixture), 'utf8'));
assert.equal(hash(JSON.stringify(inventory('src'))), handoff.sourceManifestSha256);
assert.equal(hash(JSON.stringify(inventory('tests'))), handoff.testManifestSha256);
run(process.execPath, [compiler, '-p', 'tsconfig.build.json']);
assert.equal(hash(JSON.stringify(inventory('dist'))), handoff.compiledManifestSha256, 'Exact v2 compilation');
const compilerOutput = run(process.execPath, [compiler, '--noEmit', '--listFiles', '-p', 'tsconfig.json']);
const normalize = (path, base) => {
  const actualPath = realpathSync(path);
  const actualBase = realpathSync(base);
  return actualPath.startsWith(actualBase + '/') ? 'CANDIDATE/' + relative(actualBase, actualPath) : actualPath;
};
const actualInputs = compilerOutput.trim().split('\n').map(path => ({ path: normalize(path, candidate), sha256: hash(readFileSync(path)) }));
const expectedInputs = handoff.compilerInputs.map(entry => ({ path: normalize(entry.path, handoff.candidate), sha256: entry.sha256 }));
assert.deepEqual(actualInputs, expectedInputs);
for (const name of ['supervisor.mjs', 'run-prototype.mjs', 'run-direction.mjs', 'controls.mjs']) put(resolve(temp, name), readFileSync(resolve(owned, `${name}.data`), 'utf8').replaceAll(handoff.temp, temp));
mkdirSync(resolve(temp, 'evidence/runs'), { recursive: true }); mkdirSync(resolve(temp, '.scratch'));
const readonly = directory => { for (const entry of readdirSync(directory, { withFileTypes: true })) { const path = resolve(directory, entry.name); if (entry.isDirectory()) readonly(path); else if (entry.isFile()) chmodSync(path, 0o444); } chmodSync(directory, 0o555); };

const proof = { completedAt: new Date().toISOString(), temp, candidate, exactV1SourceTestsCompiled: true, exactV2SourceTestsCompiled: true, compilerInputsMatched: actualInputs.length, sourceManifestSha256: handoff.sourceManifestSha256, testManifestSha256: handoff.testManifestSha256, compiledManifestSha256: handoff.compiledManifestSha256, candidateReadonly: false, sourceFallback: false, liveProductReads: false, existingHashedDevToolsOnly: true, children, replayAuthor: `node ${resolve(temp, 'run-direction.mjs')} replay`, note: 'Readonly candidate: run-prototype build steps are not a supported postseal mutation; original checks already recorded before seal. Tests may execute against read-only source.' };
put(resolve(temp, 'reconstruction-proof.json'), JSON.stringify(proof, null, 2) + '\n');
console.log(JSON.stringify(proof, null, 2));
