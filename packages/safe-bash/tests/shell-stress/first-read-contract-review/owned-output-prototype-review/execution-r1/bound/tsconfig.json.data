{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "typeRoots": [
      "/Users/kjopek/Workspace/safe-bash/node_modules/@types"
    ]
  },
  "include": [
    "tests/**/*.ts"
  ]
}
