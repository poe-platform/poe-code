import assert from 'node:assert/strict';
import { readFileSync, writeFileSync, readdirSync, realpathSync, chmodSync } from 'node:fs';
import { createHash } from 'node:crypto';
import { resolve, relative } from 'node:path';
import { spawnSync } from 'node:child_process';
const task = '/tmp/safe-bash-owned-output-qualified-prototype-C5XVrA';
const root = '/Users/kjopek/Workspace/safe-bash';
const hash = bytes => createHash('sha256').update(bytes).digest('hex');
const snapshot = JSON.parse(readFileSync(resolve(task, 'baseline-snapshot.json')));
const walk = directory => readdirSync(directory, { withFileTypes: true }).flatMap(entry => entry.isDirectory() ? walk(resolve(directory, entry.name)) : entry.isFile() ? [resolve(directory, entry.name)] : []).sort();
const inventory = (base, directory) => walk(resolve(base, directory)).map(path => ({ path: relative(base, path), bytes: readFileSync(path).length, sha256: hash(readFileSync(path)) }));
assert.equal(hash(readFileSync(process.execPath)), snapshot.tooling.node.sha256);
for (const entry of snapshot.tooling.compiler) assert.equal(hash(readFileSync(entry.path)), entry.sha256);
const compiler = resolve(root, 'node_modules/typescript/bin/tsc');
const records = [];
for (const name of ['original-preoperation', 'current-capture', 'candidate']) {
  const base = resolve(task, name);
  const sourceBefore = inventory(base, 'src');
  const testsBefore = name === 'current-capture' ? [] : inventory(base, 'tests');
  const children = [];
  const run = args => {
    const result = spawnSync(process.execPath, [compiler, ...args], { cwd: base, encoding: 'utf8', timeout: 60000, maxBuffer: 16 * 1024 * 1024 });
    children.push({ pid: result.pid, args, status: result.status, signal: result.signal, stdout: result.stdout, stderr: result.stderr });
    writeFileSync(resolve(task, `build-${name}.json`), JSON.stringify(children, null, 2) + '\n');
    assert.equal(result.error, undefined); assert.equal(result.status, 0, result.stdout + result.stderr);
    assert.throws(() => process.kill(result.pid, 0), { code: 'ESRCH' });
    return result.stdout;
  };
  run(['-p', 'tsconfig.build.json']);
  const listing = run(['--noEmit', '--listFiles', '-p', name === 'candidate' ? 'tsconfig.json' : 'tsconfig.build.json']);
  const inputs = listing.trim().split('\n').map(path => ({ path: realpathSync(path), sha256: hash(readFileSync(path)) }));
  assert.deepEqual(inventory(base, 'src'), sourceBefore);
  if (name !== 'current-capture') assert.deepEqual(inventory(base, 'tests'), testsBefore);
  const compiled = inventory(base, 'dist');
  if (name === 'candidate') assert.equal(hash(JSON.stringify(compiled)), snapshot.authenticatedS1.compiled);
  records.push({ name, source: sourceBefore, tests: testsBefore, compiled, sourceId: hash(JSON.stringify(sourceBefore)), testId: hash(JSON.stringify(testsBefore)), compiledId: hash(JSON.stringify(compiled)), inputs, children });
}
writeFileSync(resolve(task, 'build-identities.json'), JSON.stringify({ completedAt: new Date().toISOString(), records }, null, 2) + '\n');
console.log(records.map(record => ({ name: record.name, sourceId: record.sourceId, compiledId: record.compiledId, inputCount: record.inputs.length })));
