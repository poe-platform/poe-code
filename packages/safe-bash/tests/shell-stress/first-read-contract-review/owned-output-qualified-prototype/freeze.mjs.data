const files = ['prepare.mjs', 'build.mjs', 'controls.mjs', 'native-helper.mjs', 'baseline-snapshot.json', 'build-identities.json'].map(name => ({ path: resolve(task, name), sha256: hash(readFileSync(resolve(task, name))) }));
