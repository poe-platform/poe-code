const frozen = { frozenAt: new Date().toISOString(), sourceChanges: 0, apiSha256: hash(readFileSync(api)), files, contract, tools, logicalControls: 4, curlProfiles: 8, separateCurlCohorts: ['original-preoperation', 'current-capture', 'candidate', 'native'], focusedPrecedenceParameters: 12, nativeLibraryQualification: 'Actual curl --version and otool runtime-library metadata pinned. System dyld shared-cache library contents not separately hashed; no universal binary/library equivalence.', callerProfile: 'Native AbortController only; no synthetic reasonundefined', executionEnvironment: env };
