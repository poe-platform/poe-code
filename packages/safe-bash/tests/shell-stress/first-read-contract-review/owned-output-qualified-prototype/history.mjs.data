import assert from 'node:assert/strict';
import { spawn } from 'node:child_process';
import { mkdirSync, writeFileSync, readFileSync, copyFileSync } from 'node:fs';
import { resolve } from 'node:path';
import { createHash } from 'node:crypto';
const root = '/Users/kjopek/Workspace/safe-bash';
const task = '/tmp/safe-bash-owned-output-qualified-prototype-C5XVrA';
const candidate = resolve(task, 'candidate');
const historical = resolve(root, 'tests/shell-stress/first-read-contract-review/owned-output-streaming-prototype');
const env = { PATH: '/usr/bin:/bin', LANG: 'C', LC_ALL: 'C', TZ: 'UTC', HOME: task, TMPDIR: task, TMP: task, TEMP: task, TSX_DISABLE_CACHE: '1', TSX_CACHE_DIR: resolve(task, 'tsx-cache-disabled') };
const records = []; mkdirSync(resolve(task, 'history'), { recursive: true });
const capture = async (label, args, cwd = candidate) => {
  const child = spawn(process.execPath, args, { cwd, env, detached: true, stdio: ['ignore', 'pipe', 'pipe'] });
  const stdout = []; const stderr = []; let size = 0; let killed = false;
  const kill = () => { if (!killed) { killed = true; try { process.kill(-child.pid, 'SIGKILL'); } catch (error) { if (error.code !== 'ESRCH') throw error; } } };
  for (const [stream, chunks] of [[child.stdout, stdout], [child.stderr, stderr]]) stream.on('data', chunk => { size += chunk.length; if (size > 4 * 1024 * 1024) kill(); else chunks.push(Buffer.from(chunk)); });
  const timer = setTimeout(kill, 25000);
  const result = await new Promise((resolve, reject) => { child.on('error', reject); child.on('close', (status, signal) => resolve({ status, signal })); }).finally(() => clearTimeout(timer));
  assert.throws(() => process.kill(child.pid, 0), { code: 'ESRCH' }); assert.throws(() => process.kill(-child.pid, 0), { code: 'ESRCH' });
  const record = { label, args, cwd, env, pid: child.pid, ...result, killed, reaped: true, groupAbsent: true, stdout: Buffer.concat(stdout).toString(), stderr: Buffer.concat(stderr).toString() };
  records.push(record); writeFileSync(resolve(task, 'history', label + '.json'), JSON.stringify(record, null, 2) + '\n');
  console.log(JSON.stringify({ label, status: result.status, killed, tests: record.stdout.match(/# (?:tests|pass|fail|skipped) \d+/g) }));
  assert.equal(killed, false); assert.equal(result.signal, null);
  return record;
};
