writeFileSync(resolve(task, 'history-summary.json'), JSON.stringify({ completedAt: new Date().toISOString(), environment: env, unchangedHistoricalControlSha256: createHash('sha256').update(readFileSync(oldControl)).digest('hex'), records: records.map(({ stdout, stderr, ...record }) => record) }, null, 2) + '\n');
