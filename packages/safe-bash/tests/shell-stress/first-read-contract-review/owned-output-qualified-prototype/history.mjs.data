await capture('new-consumer-typecheck', [compiler, '--noEmit', '--listFiles', '--strict', '--target', 'ES2023', '--module', 'NodeNext', '--moduleResolution', 'NodeNext', '--types', 'node', '--typeRoots', resolve(root, 'node_modules/@types'), resolve(task, 'consumer.mts')], task);
