export function createOwnedUndefinedController() {
    const backing = new AbortController();
    const signal = backing.signal;
    const reasonGetter = () => undefined;
    const throwIfAborted = function () {
        if (signal.aborted)
            throw signal.reason;
    };
    Object.defineProperty(signal, 'reason', { configurable: false, get: reasonGetter });
    Object.defineProperty(signal, 'throwIfAborted', { configurable: false, value: throwIfAborted });
    return { signal, abort() { backing.abort(); } };
}
export function declaredConsumer(shell, caller) {
    const options = { signal: caller.signal };
    return shell.exec('qualified-lifetime', options);
}
