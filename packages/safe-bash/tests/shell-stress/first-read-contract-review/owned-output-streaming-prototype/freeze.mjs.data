import assert from 'node:assert/strict';
import { readFileSync, readdirSync } from 'node:fs';
import { createHash } from 'node:crypto';
import { resolve, relative } from 'node:path';
import { execFileSync, spawnSync } from 'node:child_process';
const root = '/Users/kjopek/Workspace/safe-bash';
const temp = '/tmp/safe-bash-owned-output-streaming-prototype-work-C7rt0j';
const candidate = resolve(temp, 'candidate');
const owned = resolve(root, 'tests/shell-stress/first-read-contract-review/owned-output-streaming-prototype');
const round = process.argv[2] ?? 'r0';
const hash = bytes => createHash('sha256').update(bytes).digest('hex');
const put = (path, text) => execFileSync('apply_patch', [], {input:`*** Begin Patch\n*** Add File: ${path}\n${text.replace(/\n$/, '').split('\n').map(line=>'+'+line).join('\n')}\n*** End Patch\n`,encoding:'utf8'});
const walk = directory => readdirSync(directory,{withFileTypes:true}).flatMap(entry=>entry.isDirectory()?walk(resolve(directory,entry.name)):entry.isFile()?[resolve(directory,entry.name)]:[]).sort();
const inventory = directory => walk(resolve(candidate,directory)).map(path=>({path:relative(candidate,path),bytes:readFileSync(path).length,sha256:hash(readFileSync(path))}));
const source = inventory('src'); const tests = inventory('tests');
const diff = spawnSync('/usr/bin/git',['diff','--no-index','--',resolve(temp,'baseline/src'),resolve(candidate,'src')],{encoding:'utf8',maxBuffer:8*1024*1024});
assert.ok([0,1].includes(diff.status)); assert.equal(diff.signal,null);
const patch = diff.stdout.replaceAll(`a${temp}/baseline/`,'a/').replaceAll(`b${candidate}/`,'b/');
put(resolve(owned,`source-S1-${round}.patch-data`),patch);
put(resolve(owned,`author-${round}.test.ts.data`),readFileSync(resolve(candidate,'tests/shell/owned-output-streaming-author.test.ts'),'utf8'));
const baseline = JSON.parse(readFileSync(resolve(owned,'baseline-manifest.json')));
for (const entry of baseline.tests) assert.equal(hash(readFileSync(resolve(candidate,entry.path))),entry.sha256,`Unchanged test ${entry.path}`);
const freeze = {frozenAt:new Date().toISOString(),round,temp,candidate,api:'S1',apiSha256:hash(readFileSync(resolve(owned,'API-S1.txt.data'))),contractSha256:hash(readFileSync(resolve(owned,'CONTRACT.md'))),sourceManifestSha256:hash(JSON.stringify(source)),testManifestSha256:hash(JSON.stringify(tests)),source,tests,authorLogicalCases:6,authorIds:['S1','S2','S3','S4','S5','S6'],authorSha256:hash(readFileSync(resolve(candidate,'tests/shell/owned-output-streaming-author.test.ts'))),originalAndAdaptedFixturesUnchanged:true,old57plus9:'Same frozen test inputs/selectors and controls.mjs; relocation only',historicalNotAcceptance:['v2 author8','historical new7=3/7','D01 handback/framing','independent 688c4623'],controlsSha256:hash(readFileSync(resolve(temp,'controls.mjs'))),patchSha256:hash(patch),tools:[process.execPath,resolve(root,'node_modules/typescript/lib/_tsc.js'),resolve(root,'node_modules/typescript/package.json'),resolve(root,'node_modules/tsx/package.json')].map(path=>({path,sha256:hash(readFileSync(path))})),sourceDiffChild:{pid:diff.pid,status:diff.status,signal:diff.signal}};
put(resolve(owned,`freeze-${round}.json`),JSON.stringify(freeze,null,2)+'\n');
console.log(JSON.stringify({round,sourceManifestSha256:freeze.sourceManifestSha256,authorSha256:freeze.authorSha256,authorCases:6}));
