import assert from 'node:assert/strict';
import { readFileSync, readdirSync, mkdtempSync, mkdirSync, symlinkSync } from 'node:fs';
import { createHash } from 'node:crypto';
import { resolve, relative } from 'node:path';
import { execFileSync, spawnSync } from 'node:child_process';
const root = '/Users/kjopek/Workspace/safe-bash';
assert.equal(process.cwd(), root);
const owned = resolve(root, 'tests/shell-stress/first-read-contract-review/owned-output-streaming-prototype');
const old = resolve(root, 'tests/shell-stress/first-read-contract-review/owned-output-prototype');
const direction = resolve(root, 'tests/shell-stress/first-read-contract-review/owned-output-direction-prototype');
const hash = bytes => createHash('sha256').update(bytes).digest('hex');
const put = (path, text) => execFileSync('apply_patch', [], { input: `*** Begin Patch\n*** Add File: ${path}\n${text.replace(/\n$/, '').split('\n').map(line => '+' + line).join('\n')}\n*** End Patch\n`, encoding: 'utf8' });
const json = (path, value) => put(path, JSON.stringify(value, null, 2) + '\n');
const handoff = JSON.parse(readFileSync(resolve(old, 'handoff.json')));
const baseline = JSON.parse(readFileSync(resolve(old, 'reconstruction.json')));
for (const [directory, commit] of [[old, '1ff82cb748c60145740dba354610ac7ed7a7f15f'], [direction, '9b65787d4d6805aa182ff138996bf4ab7bacd764']]) {
  for (const name of ['handoff.json', 'ARTIFACTS.json']) assert.equal(hash(readFileSync(resolve(directory, name))), hash(execFileSync('git', ['show', `${commit}:${relative(root, resolve(directory, name))}`], {maxBuffer: 8 * 1024 * 1024})));
}
const temp = mkdtempSync('/tmp/safe-bash-owned-output-streaming-prototype-work-');
const candidate = resolve(temp, 'candidate'); mkdirSync(candidate);
const children = [];
const run = (command, args) => {
  const result = spawnSync(command, args, { cwd: candidate, encoding: 'utf8', timeout: 30000, maxBuffer: 8 * 1024 * 1024 });
  assert.equal(result.error, undefined); assert.equal(result.status, 0, result.stdout + result.stderr);
  assert.throws(() => process.kill(result.pid, 0), {code: 'ESRCH'});
  children.push({command, args, pid: result.pid, status: result.status, signal: result.signal, reaped: true});
  return result.stdout;
};
const archive = resolve(old, 'baseline.tar.gz.data');
assert.ok(run('/usr/bin/tar', ['-tzf', archive]).split('\n').filter(Boolean).every(name => !name.startsWith('/') && !name.split('/').includes('..')));
run('/usr/bin/tar', ['-xzf', archive, '-C', candidate]);
for (const entry of baseline.files) assert.equal(hash(readFileSync(resolve(candidate, entry.path))), entry.sha256);
run('/usr/bin/git', ['apply', resolve(old, 'source-r1.patch-data')]);
for (const name of ['owned-output-author.test.ts', 'adapted-first-read-probe.ts', 'adapted-remote-close.test.ts']) put(resolve(candidate, 'tests/shell', name), readFileSync(resolve(old, `${name}.data`), 'utf8'));
for (const entry of [...handoff.source, ...handoff.tests]) assert.equal(hash(readFileSync(resolve(candidate, entry.path))), entry.sha256);
const paths = ['src/commands/internal.ts', 'src/commands/streams.ts', 'src/commands/network/body.ts', 'src/commands/structured/jq.ts'];
const delta = execFileSync('git', ['diff', 'c9b96263d1204bdf54e89324cc0c7d1ef6bd3f79', '3b33f9a8e10ca5c697b7eb23727e1cc173b1672c', '--', ...paths], {encoding:'utf8'});
put(resolve(owned, 'baseline-current-retention.patch-data'), delta);
run('/usr/bin/git', ['apply', resolve(owned, 'baseline-current-retention.patch-data')]);
symlinkSync(resolve(root, 'node_modules'), resolve(candidate, 'node_modules'), 'dir');
const walk = directory => readdirSync(directory, {withFileTypes:true}).flatMap(entry => entry.isDirectory() ? walk(resolve(directory, entry.name)) : entry.isFile() ? [resolve(directory, entry.name)] : []).sort();
const inventory = directory => walk(resolve(candidate, directory)).map(path => ({path:relative(candidate,path),bytes:readFileSync(path).length,sha256:hash(readFileSync(path))}));
const snapshot = [...inventory('src'), ...inventory('tests')];
for (const entry of inventory('src')) put(resolve(temp, 'baseline', entry.path), readFileSync(resolve(candidate, entry.path),'utf8'));
for (const name of ['supervisor.mjs', 'run-prototype.mjs', 'controls.mjs']) put(resolve(temp, name), readFileSync(resolve(direction, `${name}.data`),'utf8').replaceAll(JSON.parse(readFileSync(resolve(direction,'handoff.json'))).temp, temp));
mkdirSync(resolve(temp, 'evidence/runs'),{recursive:true}); mkdirSync(resolve(temp,'.scratch'));
put(resolve(owned,'API-S1.txt.data'),readFileSync('/tmp/safe-bash-owned-output-streaming-prototype-api.txt','utf8'));
put(resolve(owned,'authenticate.mjs.data'),readFileSync('/tmp/safe-bash-owned-output-streaming-prototype-authenticate.mjs','utf8'));
put(resolve(owned,'authentication.json'),readFileSync('/tmp/safe-bash-owned-output-streaming-prototype-auth-xlHOAP/reconstruction-proof.json','utf8'));
put(resolve(owned,'prepare.mjs.data'),readFileSync('/tmp/safe-bash-owned-output-streaming-prototype-prepare.mjs','utf8'));
json(resolve(owned,'baseline-manifest.json'),{createdAt:new Date().toISOString(),temp,candidate,chosen:'v1 plus frozen four-file retention fixes before S1 design edits',source:snapshot.filter(entry=>entry.path.startsWith('src/')),tests:snapshot.filter(entry=>entry.path.startsWith('tests/')),sourceManifestSha256:hash(JSON.stringify(inventory('src'))),v1SourceManifestSha256:handoff.sourceManifestSha256,retentionPatchSha256:hash(delta),currentFrozenHead:'3b33f9a8e10ca5c697b7eb23727e1cc173b1672c',children});
console.log(JSON.stringify({temp,candidate,baselineSourceManifestSha256:hash(JSON.stringify(inventory('src')))}));
