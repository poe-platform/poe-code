import assert from 'node:assert/strict';
import { readFileSync, readdirSync, mkdtempSync, mkdirSync, symlinkSync, chmodSync, realpathSync } from 'node:fs';
import { createHash } from 'node:crypto';
import { resolve, relative } from 'node:path';
import { execFileSync, spawnSync } from 'node:child_process';
const root = '/Users/kjopek/Workspace/safe-bash';
assert.equal(process.cwd(),root);
const owned = resolve(root,'tests/shell-stress/first-read-contract-review/owned-output-streaming-prototype');
const old = resolve(root,'tests/shell-stress/first-read-contract-review/owned-output-prototype');
const manifest = JSON.parse(readFileSync(resolve(owned,'tested-manifest.json')));
const hash = bytes => createHash('sha256').update(bytes).digest('hex');
const put = (path,text) => execFileSync('apply_patch',[],{input:`*** Begin Patch\n*** Add File: ${path}\n${text.replace(/\n$/,'').split('\n').map(line=>'+'+line).join('\n')}\n*** End Patch\n`,encoding:'utf8',timeout:5000});
for(const entry of [...manifest.restoreInputs,...manifest.tooling]) assert.equal(hash(readFileSync(resolve(root,entry.path))),entry.sha256,entry.path);
assert.equal(hash(readFileSync(process.execPath)),manifest.tools.node.sha256);
for(const entry of manifest.tools.compiler) assert.equal(hash(readFileSync(entry.path)),entry.sha256);
for(const entry of manifest.compilerInputs.filter(entry=>entry.classification==='existing-authenticated-development-tooling')) assert.equal(hash(readFileSync(entry.path)),entry.sha256);
const temp = mkdtempSync('/tmp/safe-bash-owned-output-streaming-execution-restore-');
const candidate = resolve(temp,'candidate'); mkdirSync(candidate);
const children = [];
const run = (command,args) => {
  const result = spawnSync(command,args,{cwd:candidate,encoding:'utf8',timeout:30000,maxBuffer:8*1024*1024});
  assert.equal(result.error,undefined); assert.equal(result.status,0,result.stdout+result.stderr);
  assert.throws(()=>process.kill(result.pid,0),{code:'ESRCH'});
  children.push({command,args,pid:result.pid,status:result.status,signal:result.signal,reaped:true});
  return result.stdout;
};
const archive = resolve(old,'baseline.tar.gz.data');
const names = run('/usr/bin/tar',['-tzf',archive]).split('\n').filter(Boolean);
assert.ok(names.every(name=>!name.startsWith('/')&&!name.split('/').includes('..')));
run('/usr/bin/tar',['-xzf',archive,'-C',candidate]);
const baseline = JSON.parse(readFileSync(resolve(old,'reconstruction.json')));
for(const entry of baseline.files) assert.equal(hash(readFileSync(resolve(candidate,entry.path))),entry.sha256);
run('/usr/bin/git',['apply',resolve(old,'source-r1.patch-data')]);
for(const name of ['owned-output-author.test.ts','adapted-first-read-probe.ts','adapted-remote-close.test.ts']) put(resolve(candidate,'tests/shell',name),readFileSync(resolve(old,`${name}.data`),'utf8'));
const v1 = JSON.parse(readFileSync(resolve(old,'handoff.json')));
for(const entry of [...v1.source,...v1.tests]) assert.equal(hash(readFileSync(resolve(candidate,entry.path))),entry.sha256);
run('/usr/bin/git',['apply',resolve(owned,'baseline-current-retention.patch-data')]);
run('/usr/bin/git',['apply',resolve(owned,'source-S1-r0.patch-data')]);
put(resolve(candidate,'tests/shell/owned-output-streaming-author.test.ts'),readFileSync(resolve(owned,'author-r1.test.ts.data'),'utf8'));
const walk = directory => readdirSync(directory,{withFileTypes:true}).flatMap(entry=>entry.isDirectory()?walk(resolve(directory,entry.name)):entry.isFile()?[resolve(directory,entry.name)]:[]).sort();
const inventory = directory => walk(resolve(candidate,directory)).map(path=>({path:relative(candidate,path),bytes:readFileSync(path).length,sha256:hash(readFileSync(path))}));
assert.equal(hash(JSON.stringify(inventory('src'))),manifest.sourceManifestSha256);
assert.equal(hash(JSON.stringify(inventory('tests'))),manifest.testManifestSha256);
for(const entry of manifest.config) assert.equal(hash(readFileSync(resolve(candidate,entry.path))),entry.sha256);
symlinkSync(resolve(root,'node_modules'),resolve(candidate,'node_modules'),'dir');
const compiler = resolve(root,'node_modules/typescript/bin/tsc');
run(process.execPath,[compiler,'-p','tsconfig.build.json']);
assert.equal(hash(JSON.stringify(inventory('dist'))),manifest.compiledManifestSha256);
const compilerOutput = run(process.execPath,[compiler,'--noEmit','--listFiles','-p','tsconfig.json']);
const canonical = realpathSync(candidate);
const actualInputs = compilerOutput.trim().split('\n').map(path=>({normalizedPath:realpathSync(path).startsWith(canonical+'/')?'CANDIDATE/'+relative(canonical,realpathSync(path)):realpathSync(path),sha256:hash(readFileSync(path))}));
assert.deepEqual(actualInputs,manifest.compilerInputs.map(({normalizedPath,sha256})=>({normalizedPath,sha256})));
for(const name of ['supervisor.mjs','controls.mjs','consumer.mts','consumer-runtime.mjs']) put(resolve(temp,name),readFileSync(resolve(owned,`${name}.data`),'utf8').replaceAll(manifest.temp,temp));
mkdirSync(resolve(temp,'evidence/runs'),{recursive:true});
const readonly = directory => { for(const entry of readdirSync(directory,{withFileTypes:true})) { const path=resolve(directory,entry.name); if(entry.isDirectory())readonly(path);else if(entry.isFile())chmodSync(path,0o444); } chmodSync(directory,0o555); };
readonly(candidate);
const proof = {completedAt:new Date().toISOString(),temp,candidate,sourceManifestSha256:manifest.sourceManifestSha256,testManifestSha256:manifest.testManifestSha256,compiledManifestSha256:manifest.compiledManifestSha256,compilerInputsMatched:actualInputs.length,sourceAfterBuildAuthenticated:hash(JSON.stringify(inventory('src')))===manifest.sourceManifestSha256,candidateReadonly:true,liveSourceFallback:false,children,importPath:resolve(candidate,'dist/index.js'),declarationPath:resolve(candidate,'dist/contracts/output.d.ts'),replayAuthor:`cd ${candidate} && node --unhandled-rejections=strict --import tsx --test --test-concurrency=1 tests/shell/owned-output-streaming-author.test.ts`,restriction:'No postseal build/source mutation. Root must separately observe actual author CLOSED before independent execution.'};
put(resolve(temp,'reconstruction-proof.json'),JSON.stringify(proof,null,2)+'\n');
console.log(JSON.stringify(proof,null,2));
