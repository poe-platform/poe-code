import assert from 'node:assert/strict';
import { readFileSync, mkdirSync, copyFileSync, realpathSync, readdirSync } from 'node:fs';
import { resolve, dirname, join } from 'node:path';
import { createHash } from 'node:crypto';
import { execFileSync } from 'node:child_process';
const root = process.cwd();
const temp = realpathSync(process.argv[2]);
assert.match(temp, /^\/(?:private\/)?tmp\/safe-bash-owned-output-streaming-fixture-replay-[^/]+$/);
assert.equal(process.env.TSX_DISABLE_CACHE, '1');
assert.equal(realpathSync(process.env.TMPDIR), temp + '/tmp');
const review = root + '/tests/shell-stress/first-read-contract-review/owned-output-streaming-review';
const owned = review + '/fixture-replay-s1';
const first = review + '/execution-s1';
const binding = review + '/binding-s1';
const author = root + '/tests/shell-stress/first-read-contract-review/owned-output-streaming-prototype';
const candidate = '/tmp/safe-bash-owned-output-streaming-execution-restore-J93UJO/candidate';
const hash = content => createHash('sha256').update(content).digest('hex');
const artifact = path => ({ path, sha256: hash(readFileSync(path)) });
const check = (path, expected) => assert.equal(artifact(path).sha256, expected, path);
const put = (path, content) => {
  mkdirSync(dirname(path), { recursive: true });
  execFileSync('apply_patch', [], { input: `*** Begin Patch\n*** Add File: ${path}\n${content.replace(/\n$/, '').split('\n').map(line => '+' + line).join('\n')}\n*** End Patch\n` });
};
const json = (path, value) => put(path, JSON.stringify(value, null, 2) + '\n');
const readJson = path => JSON.parse(readFileSync(path));
const frozenCommits = ['c1985fd5ef365312a098148528cee517064cfaa9', 'c8178bb482e49d824cc96cccc781b81ef4be9014', '722c62f8a8e0795dc2c72509cc012a6017217c0d', '9d29cf908efabb7d8d840c62e969ef7bae14bcdb', 'b3d09429de0af798663a5a18839e8b15f132a1f8'];
for (const commit of frozenCommits) execFileSync('git', ['cat-file', '-e', commit + '^{commit}']);
check('/tmp/safe-bash-owned-output-streaming-prototype.ready', 'f016214887c9827af40f54e74b3100026565dd070de4f63b9657e887db2bdb4d');
check('/tmp/safe-bash-owned-output-streaming-prototype-final-result.txt', '5f002910c2b1b653c9c6422e5618f8dc3a827144894d4a02644c120a8b4305e1');
check(first + '/FINAL-SEAL.json', '7c5389c271e756a6f509369bbfb29feb864adb4e14bed17f2ce9a67bb33f90d0');
check(binding + '/driver.mjs.data', 'f57b423ac3aa5ff210e3a389f4c4df3c01740f0329f66194012ae551068c8b21');
check(binding + '/binding-map.json', '2fb108c178225e3381c693fb796a13b53389a2db74607158c608af9c3b4eb3f2');
check(binding + '/expected-observations.json', 'cfbaf336e5ba3dc31cc43384718c608cfebf4df8b4b3744c10b6a2c090b4ec25');
for (const entry of readJson(first + '/FINAL-SEAL.json').files) check(first + '/' + entry.path, entry.sha256);
for (const entry of readJson(binding + '/SHA256SUMS.json').files) check(binding + '/' + entry.path, entry.sha256);
const manifest = readJson(author + '/tested-manifest.json');
const candidateFiles = [];
for (const [section, key, expectedCount] of [['source', 'sourceManifestSha256', 213], ['tests', 'testManifestSha256', 15], ['compiled', 'compiledManifestSha256', 708]]) {
  assert.equal(manifest[section].length, expectedCount);
  assert.equal(hash(JSON.stringify(manifest[section])), manifest[key]);
  for (const entry of manifest[section]) { check(candidate + '/' + entry.path, entry.sha256); candidateFiles.push(artifact(candidate + '/' + entry.path)); }
}
for (const entry of manifest.config) { check(candidate + '/' + entry.path, entry.sha256); candidateFiles.push(artifact(candidate + '/' + entry.path)); }
const immutableFiles = [...manifest.restoreInputs, ...manifest.tooling].map(entry => ({ path: resolve(root, entry.path), sha256: entry.sha256 }));
immutableFiles.push(...manifest.compilerInputs, ...manifest.tools.compiler, { path: process.execPath, sha256: manifest.tools.node.sha256 });
for (const entry of immutableFiles) check(entry.path, entry.sha256);
assert.equal(manifest.compilerInputs.length, 358);
check(author + '/CONTRACT.md', manifest.contractSha256);
const walk = directory => readdirSync(directory, { withFileTypes: true }).flatMap(entry => entry.isDirectory() ? walk(join(directory, entry.name)) : [join(directory, entry.name)]);
const protectedFiles = [first, binding, author].flatMap(walk).map(artifact);
const liveFiles = walk(root + '/src').concat(['package.json', 'package-lock.json', 'tsconfig.json', 'tsconfig.build.json', 'AGENTS.md'].map(path => root + '/' + path)).map(artifact);
json(temp + '/authentication-before.json', { at: new Date().toISOString(), frozenCommits, candidate, source: 213, tests: 15, compiled: 708, compilerInputs: 358, candidateFiles, immutableFiles, protectedFiles, liveFiles, node: process.version, noCandidateImportYet: true });
const history = readJson(binding + '/historical-inputs.json');
for (const entry of history.manifest) {
  const from = binding + '/historical/' + entry.path + '.data';
  const target = temp + '/historical/' + entry.path;
  check(from, entry.sha256);
  mkdirSync(dirname(target), { recursive: true });
  copyFileSync(from, target);
  check(target, entry.sha256);
}
put(temp + '/historical/package.json', '{"type":"module"}\n');
put(temp + '/historical/src/index.ts', `export * from '${candidate}/dist/index.js';\n`);
put(temp + '/historical/src/fs/webdav/resource-id.ts', `export * from '${candidate}/dist/fs/webdav/resource-id.js';\n`);
copyFileSync(binding + '/binding-map.json', temp + '/binding-map.json');
copyFileSync(first + '/artifacts/public-profiles.json', temp + '/public-profiles.json');
copyFileSync(first + '/artifacts/driver-r1.mjs.data', temp + '/driver-original.mjs.data');
let driver = readFileSync(temp + '/driver-original.mjs.data', 'utf8');
const edits = [];
const replace = (from, to) => {
  assert.equal(driver.split(from).length, 2, from);
  driver = driver.replace(from, to);
  edits.push({ from, to });
};
replace('safe-bash-owned-output-streaming-execution-[^/]+$', 'safe-bash-owned-output-streaming-fixture-replay-[^/]+$');
replace("assert.match(candidatePhysical, /^\\/(?:private\\/)?tmp\\/safe-bash-owned-output-streaming-execution-[^/]+\\//, 'candidate copy must be task TMP, not live product or root dist');", "assert.equal(candidatePhysical, await realpath(config.authenticatedReadOnlyCandidateEntry), 'exact authenticated read-only S1 compiled candidate; no live source fallback');");
replace("  const config = JSON.parse(await readFile(configPath, 'utf8'));", "  assert.equal(process.env.TSX_DISABLE_CACHE, '1');\n  assert.equal(await realpath(process.env.TMPDIR), join(physicalDirectory, 'tmp'));\n  const config = JSON.parse(await readFile(configPath, 'utf8'));\n  await verifiedArtifact(config.importClosureProof, 'pre-acceptance complete selected fixture import proof');");
replace("  const child = spawn(process.execPath, argumentsList, { stdio: ['ignore', 'pipe', 'pipe'], detached: process.platform !== 'win32', cwd: directory });", "  const child = spawn(process.execPath, argumentsList, { stdio: ['ignore', 'pipe', 'pipe'], detached: process.platform !== 'win32', cwd: directory, env: { ...process.env, TSX_DISABLE_CACHE: '1', TMPDIR: join(directory, 'tmp'), TMP: join(directory, 'tmp'), TEMP: join(directory, 'tmp'), TSX_CACHE_DIR: join(directory, 'tmp', 'tsx') } });");
replace(`    let received = 0;
    request.on('data', chunk => {
      received += chunk.length;
      if (received > outputLimitBytes) {
        failures.push(new Error('bounded loopback request exceeded 1 MiB'));
        request.destroy();
      }
    });
    const task = Promise.resolve().then(() => handler(request, response)).catch(error => {`, `    let received = 0;
    const body = { first: gate(), complete: gate(), chunks: [] };
    request.on('data', chunk => {
      received += chunk.length;
      if (received > outputLimitBytes) {
        const error = new Error('bounded loopback request exceeded 1 MiB');
        failures.push(error);
        body.first.reject(error);
        body.complete.reject(error);
        request.destroy();
        return;
      }
      body.chunks.push(Buffer.from(chunk));
      scope.event('fixture.capture.data', { bytes: chunk.length, total: received, dataListeners: request.listenerCount('data') });
      body.first.resolve();
    });
    request.once('end', () => {
      scope.event('fixture.capture.end', { bytes: received });
      body.complete.resolve(body.chunks);
    });
    const rejectBody = error => { body.first.reject(error); body.complete.reject(error); };
    request.once('aborted', () => rejectBody(new Error('fixture upload aborted before data/end')));
    request.once('error', rejectBody);
    scope.event('fixture.capture.installed', { dataListeners: request.listenerCount('data') });
    const task = Promise.resolve().then(() => handler(request, response, body)).catch(error => {`);
replace(`  const fixture = await loopback(scope, async (request, response) => {
    assert.equal(request.method, 'PUT');
    for await (const chunk of request) {
      uploaded.push(Buffer.from(chunk));
      scope.event('server.body.bytes', { bytes: chunk.length, eof });
      serverBytes.resolve();
    }`, `  const fixture = await loopback(scope, async (request, response, body) => {
    assert.equal(request.method, 'PUT');
    await body.first.promise;
    scope.event('server.body.bytes', { bytes: body.chunks[0].length, eof });
    serverBytes.resolve();
    uploaded.push(...await body.complete.promise);`);
replace(`  const fixture = await loopback(scope, async (request, response) => {
    response.once('close', () => serverClosed.resolve());
    if (upload) {
      await new Promise((resolveData, rejectData) => {
        request.once('data', () => { scope.event('server.upload.bytes'); resolveData(); });
        request.once('aborted', () => rejectData(new Error('fixture upload aborted before data')));
      });
    }`, `  const fixture = await loopback(scope, async (request, response, body) => {
    response.once('close', () => serverClosed.resolve());
    if (upload) {
      await body.first.promise;
      scope.event('server.upload.bytes');
    }`);
replace("      if (bodyFile) assert.equal(text(await fs.readFile('/body', { signal: context.signal })), 'required-body\\n');", "      if (bodyFile) result.bodyFileObservation = text(await fs.readFile('/body', { signal: context.signal }));\n      if (bodyFile) assert.equal(text(await fs.readFile('/body', { signal: context.signal })), 'required-body\\n');");
put(temp + '/driver-r1.mjs', driver);
json(temp + '/edits-r1.json', edits);
const toolFiles = new Map();
for (const entry of immutableFiles.filter(entry => entry.path.includes('/node_modules/') || entry.path === process.execPath)) toolFiles.set(entry.path, artifact(entry.path));
const versions = { node: process.version };
for (const name of ['tsx', 'esbuild', 'typescript', '@esbuild/darwin-arm64']) {
  const path = root + '/node_modules/' + name;
  versions[name] = readJson(path + '/package.json').version;
  for (const file of walk(path)) toolFiles.set(file, artifact(file));
}
json(temp + '/tool-manifest.json', { versions, files: [...toolFiles.values()], environment: Object.fromEntries(['TMPDIR', 'TMP', 'TEMP', 'TSX_DISABLE_CACHE', 'TSX_CACHE_DIR'].map(name => [name, process.env[name]])) });
json(temp + '/pre-import-inputs.json', { at: new Date().toISOString(), candidate, historyCount: history.manifest.length, history: history.manifest, plan: artifact(owned + '/PLAN.md'), driver: artifact(temp + '/driver-r1.mjs'), edits: artifact(temp + '/edits-r1.json'), tools: artifact(temp + '/tool-manifest.json'), mapping: artifact(temp + '/binding-map.json'), profiles: artifact(temp + '/public-profiles.json'), facade: ['index.ts', 'fs/webdav/resource-id.ts'].map(path => artifact(temp + '/historical/src/' + path)), oldClosureClaimRetracted: true, originalConfig: artifact(first + '/artifacts/execution-inputs-r2.json') });
console.log(JSON.stringify({ prepared: true, temp, versions, source: 213, tests: 15, compiled: 708, compilerInputs: 358, historicalInputs: history.manifest.length, edits: edits.length, noProductReplayYet: true }));
