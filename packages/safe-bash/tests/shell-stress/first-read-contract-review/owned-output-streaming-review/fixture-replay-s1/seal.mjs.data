import assert from 'node:assert/strict';
import { readFileSync, writeFileSync, readdirSync, statSync } from 'node:fs';
import { dirname, join } from 'node:path';
import { fileURLToPath } from 'node:url';
import { createHash } from 'node:crypto';
import { spawnSync, execFileSync } from 'node:child_process';
const root = '/Users/kjopek/Workspace/safe-bash';
const owned = root + '/tests/shell-stress/first-read-contract-review/owned-output-streaming-review/fixture-replay-s1';
const temp = dirname(fileURLToPath(import.meta.url));
const hash = content => createHash('sha256').update(content).digest('hex');
const artifact = path => ({ path, sha256: hash(readFileSync(path)) });
const readJson = path => JSON.parse(readFileSync(path));
const auth = readJson(temp + '/authentication-before.json');
for (const section of ['candidateFiles', 'immutableFiles', 'protectedFiles']) for (const entry of auth[section]) assert.equal(artifact(entry.path).sha256, entry.sha256, entry.path);
const liveRootDrift = [];
for (const entry of auth.liveFiles) {
  const actual = artifact(entry.path).sha256;
  if (actual === entry.sha256) continue;
  assert.ok([root + '/package.json', root + '/tsconfig.json'].includes(entry.path), 'unexpected change outside the two observed concurrent root configs');
  const relative = entry.path.slice(root.length + 1);
  const frozenBytes = execFileSync('git', ['show', '9e6c5e2394d5d36df42529d74d1dd21301ddeab6:' + relative], { cwd: root });
  assert.equal(hash(frozenBytes), entry.sha256);
  writeFileSync(owned + '/round1/foreign-' + relative + '.before.data', frozenBytes);
  const currentBytes = readFileSync(entry.path);
  assert.equal(hash(currentBytes), actual);
  writeFileSync(owned + '/round1/foreign-' + relative + '.after.data', currentBytes);
  writeFileSync(owned + '/round1/foreign-' + relative + '.patch-data', execFileSync('git', ['diff', '9e6c5e2394d5d36df42529d74d1dd21301ddeab6', '--', relative], { cwd: root }));
  liveRootDrift.push({ path: entry.path, before: entry.sha256, current: actual, classification: 'concurrent foreign live root-config change; not candidate config, not changed by this leaf; preserved without reverting' });
}
writeFileSync(owned + '/round1/foreign-root-drift.json', JSON.stringify({ at: new Date().toISOString(), files: liveRootDrift, noProductReplayAfterDrift: true, candidateAndCandidateConfigsUnchanged: true, liveSourceFilesUnchanged: true }, null, 2) + '\n');
for (const manifest of ['pre-replay-seal.json', 'tool-manifest.json', 'import-closure-proof.json']) for (const entry of readJson(temp + '/' + manifest).files) assert.equal(artifact(entry.path).sha256, entry.sha256, entry.path);
const authored = readdirSync(owned).filter(name => name.endsWith('.mjs.data') || name.endsWith('.md'));
const validation = [];
for (const name of authored) {
  if (name.endsWith('.mjs.data')) {
    const result = spawnSync(process.execPath, ['--input-type=module', '--check'], { input: readFileSync(owned + '/' + name), encoding: 'utf8', env: process.env, timeout: 3000 });
    assert.equal(result.status, 0, result.stderr);
    validation.push({ name, check: 'syntax-only; not execution', exitCode: result.status, stdout: result.stdout, stderr: result.stderr });
  }
  const whitespace = spawnSync('git', ['diff', '--no-index', '--check', '/dev/null', owned + '/' + name], { cwd: root, encoding: 'utf8', timeout: 3000 });
  assert.equal(whitespace.stdout, '', whitespace.stdout);
  assert.equal(whitespace.stderr, '', whitespace.stderr);
  validation.push({ name, check: 'authored-only whitespace, raw historical inputs not normalized', exitCode: whitespace.status, stdout: whitespace.stdout, stderr: whitespace.stderr });
}
const frozenCommit = '9e6c5e2394d5d36df42529d74d1dd21301ddeab6';
const frozen = execFileSync('git', ['diff-tree', '--no-commit-id', '--name-only', '-r', frozenCommit], { cwd: root, encoding: 'utf8' }).trim().split('\n');
for (const path of frozen) assert.equal(artifact(root + '/' + path).sha256, hash(execFileSync('git', ['show', frozenCommit + ':' + path], { cwd: root, maxBuffer: 4194304 })), path);
const closure = readJson(temp + '/closure.json');
for (const child of [...closure.childChecks, ...closure.supervisors]) {
  assert.throws(() => process.kill(-child.pid, 0), { code: 'ESRCH' });
}
writeFileSync(owned + '/VALIDATION.json', JSON.stringify({ at: new Date().toISOString(), validation, candidateInputsToolsAndPriorEvidenceStillUnchanged: true, liveSourceFilesUnchanged: true, liveRootConfigDrift: liveRootDrift, prereplayFilesStillUnchanged: frozen.length, all28RecordedChildAndSupervisorGroupsAbsent: true, noFullSuiteOrBuild: true }, null, 2) + '\n');
const walk = directory => readdirSync(directory, { withFileTypes: true }).flatMap(entry => entry.isDirectory() ? walk(join(directory, entry.name)) : [join(directory, entry.name)]);
const paths = walk(owned).filter(path => path !== owned + '/SEAL.json');
assert.equal(paths.filter(path => /\.(?:ts|tsx|mjs|js)$/.test(path)).length, 0, 'repository captures remain inert');
const results = readJson(temp + '/results.json');
const seal = { at: new Date().toISOString(), evidenceInterval: { from: readJson(temp + '/authentication-first-preparation.json').at, to: new Date().toISOString(), scope: 'recorded finite task activity, not continuous-work or72h attestation' }, prereplayCommit: frozenCommit, authorSeal: 'c1985fd5ef365312a098148528cee517064cfaa9', firstIndependentExecution: 'c8178bb482e49d824cc96cccc781b81ef4be9014', sourceIdentity: results.sourceIdentity, fixtureExecutionCorrectionRounds: 1, sourceFixCount: 0, genuineSourceBugsEstablished: 0, independentAcceptanceComplete: false, parameterCounts: results.corrected.parameters, logicalCounts: results.corrected.logical, historicalFive: results.originalFive.parameters, unchanged57Plus9NotRerun: true, files: paths.map(path => ({ path: path.slice(owned.length + 1), bytes: statSync(path).size, sha256: artifact(path).sha256 })), actualLeafExit: 'not attested; root must observe normal exit after handoff' };
writeFileSync(owned + '/SEAL.json', JSON.stringify(seal, null, 2) + '\n');
console.log(JSON.stringify({ sealedFiles: paths.length, seal: artifact(owned + '/SEAL.json'), validation: artifact(owned + '/VALIDATION.json'), parameterCounts: results.corrected.parameters, logicalCounts: results.corrected.logical, currentLeafExitNotAttested: true }));
