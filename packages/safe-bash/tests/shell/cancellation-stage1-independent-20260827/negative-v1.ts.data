const textSignal: CancellationInvokeOptions = { signal: 'abort' };
const structuralSignal: CancellationInvokeOptions = { signal: { aborted: false, reason: undefined } };
const numericSignal: CancellationInvokeOptions = { signal: 0 };
void nullSignal; void controllerSignal; void promisedSignal; void textSignal; void structuralSignal; void numericSignal;
