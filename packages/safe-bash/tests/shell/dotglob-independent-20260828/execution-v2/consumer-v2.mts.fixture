import { Shell, MemoryFileSystem, agentCommands } from 'virtual-bash';
import type { ShellCommandContext, ShellOptions, ShellResult } from 'virtual-bash';
const options: ShellOptions = { fs: new MemoryFileSystem(), env: { LC_ALL: 'C' } };
const shell = new Shell(options).use(agentCommands());
shell.register({ name: 'relay', async execute(context) {
  if (typeof context.invoke !== 'function') throw new Error('Shell invocation hook required');
  const shellContext: ShellCommandContext = { ...context, invoke: context.invoke };
  return shellContext.invoke('shopt', ['-q', 'dotglob'], { signal: shellContext.signal });
} });
const result: ShellResult = await shell.exec('shopt -s dotglob; shopt -q dotglob');
const status: number = result.exitCode;
void status;
await shell.dispose();
