    "rows": [
      {
        "id": "N01",
        "question": "Does an already-exported scalar convert to indexed, and how do native declaration/export listings represent it?",
        "script": "export a=scalar\na=([2]=two)\nprintf 'assignment=%s\\n' \"$?\"\ndeclare -p a\nexport -p\n",
        "PROJECTcandidate": "Reject indexed conversion of exported scalar before RHS, status 1; preserve scalar and export membership. Deliberately stricter than any unobserved native behavior.",
        "nativeexpected": null,
        "qualification": "Native declaration/export listing only; not external-process environment proof.",
        "nestedChildContextsUpperBound": 0
      },
      {
        "id": "N02",
        "question": "What does native export of an existing array do, including empty elements and attribute display?",
        "script": "a=([2]=two [9]='')\nexport a\nprintf 'export=%s\\n' \"$?\"\ndeclare -p a\nexport -p\n",
        "PROJECTcandidate": "Reject export a with status 1, preserve unexported indexed binding; do not serialize zero or JSON. Product export-p remains unsupported.",
        "nativeexpected": null,
        "qualification": "No child exec and no inferred array environment encoding.",
        "nestedChildContextsUpperBound": 0
      },
      {
        "id": "N03",
        "question": "How do declare +a and whole-variable unset differ for conversion back to scalar?",
        "script": "a=([3]=three)\ndeclare +a a\nprintf 'plus_a=%s\\n' \"$?\"\ndeclare -p a\nunset a\na=scalar\ndeclare -p a\n",
        "PROJECTcandidate": "declare +a is future/unsupported, no success stub; unset a followed by assignment creates scalar without inherited export/readonly attributes.",
        "nativeexpected": null,
        "qualification": "Native declaration attribute behavior remains unknown until GO.",
        "nestedChildContextsUpperBound": 0
      },
      {
        "id": "N04",
        "question": "How are a readonly empty array and failed unset displayed?",
        "script": "a=()\nreadonly a\ndeclare -p a\nreadonly -p\nunset a\nprintf 'unset=%s\\n' \"$?\"\ndeclare -p a\n",
        "PROJECTcandidate": "Empty array is present; readonly freezes the binding and blocks unset. Product readonly listing encountering array refuses status 2 with no stdout until accurate formatter is separately authorized.",
        "nativeexpected": null,
        "qualification": "GNU may list unrelated startup readonly names; retain bounded exact output without assuming a line count.",
        "nestedChildContextsUpperBound": 0
      },
      {
        "id": "N05",
        "question": "Does local a retain indexed kind without values, and does local a=value restore outer sparse contents on return?",
        "script": "a=([2]=outer [7]='')\nf() { local a; declare -p a; local a=inner; declare -p a; return 7; }\nf\nprintf 'function=%s\\n' \"$?\"\ndeclare -p a\n",
        "PROJECTcandidate": "Save whole typed outer once; local indexed shadow starts empty, initializer writes zero; restore outer on return including empty element.",
        "nativeexpected": null,
        "qualification": "Native local inheritance tuple not yet observed; candidate is explicit profile policy.",
        "nestedChildContextsUpperBound": 0
      },
      {
        "id": "N06",
        "question": "Does unsetting local array expose outer immediately, and what kind is a subsequent local assignment?",
        "script": "a=([2]=outer)\nf() { local a=inner; unset a; declare -p a; a=scalar; declare -p a; }\nf\ndeclare -p a\n",
        "PROJECTcandidate": "Unset retains an absent local shadow; next assignment creates scalar. Outer typed snapshot restores only on function exit.",
        "nativeexpected": null,
        "qualification": "Nonzero declaration status inside function is an observation, no set-e.",
        "nestedChildContextsUpperBound": 0
      },
      {
        "id": "N07",
        "question": "Can local shadow readonly outer indexed binding with or without initializer?",
        "script": "a=([2]=outer)\nreadonly a\nf() { local a; printf 'local=%s\\n' \"$?\"; local a=inner; printf 'initialized=%s\\n' \"$?\"; declare -p a; }\nf\ndeclare -p a\n",
        "PROJECTcandidate": "Reject both local operations status 1 after declaration argument expansion, before snapshot/publication; preserve outer readonly array.",
        "nativeexpected": null,
        "qualification": "Keeps accepted scalar readonly-shadow rule; no claimed GNU diagnostic parity.",
        "nestedChildContextsUpperBound": 0
      },
      {
        "id": "N08",
        "question": "Which export/readonly attributes survive local creation, local unset and return?",
        "script": "export a=outer\nf() { local a; declare -p a; unset a; a=inner; readonly a; declare -p a; return 4; }\nf\nprintf 'function=%s\\n' \"$?\"\ndeclare -p a\nexport -p\n",
        "PROJECTcandidate": "Scalar local creation preserves accepted export membership; unset removes it; local readonly changes are removed on return and whole exported outer restored. Indexed local snapshots follow the same full-attribute discipline.",
        "nativeexpected": null,
        "qualification": "Focused scalar-attribute boundary companion, not a new scalar implementation or passing array case.",
        "nestedChildContextsUpperBound": 0
      },
      {
        "id": "N09",
