INTERNAL PREPARE/DISCARD
1230:
1231:  async assignVariable(state: State, name: string, value: string, origin: "assignment" | "getopts" = "assignment"): Promise<void> {
1232:    if (!arrayStore(state)?.get(name)) { this.writeVariable(state, name, value, origin); return; }
1233:    await this.arrayZero(state, name, async () => value);
1234:  }
1235:
1236:  async prepareVariable(state: State, name: string, saved: SavedVariable, scalarLegacy = false): Promise<void> {
1237:    const store = requireArrays(state);
1238:    const owner = ArrayOwner.create(store.owner.ledger, store.owner);
1239:    const holding = store.owner.hold();
1240:    let binding: IndexedBinding | undefined;
1241:    try {
1242:      const watch = await store.watch(name, owner, this.signal);
1243:      const tickets = owner.reserve({ generation: true, version: true, epoch: true, slots: 1, metadata: 64, work: 14 });
1244:      const token = await textToken(owner, name, this.signal);
1245:      const admission = owner.reserve({ slots: 1, metadata: 32, work: 5 });
1246:      if (saved.value !== undefined) await textToken(owner, saved.value, this.signal);
1247:      if (!watch.valid()) throw new ArrayFailure("stale binding");
1248:      binding = scalarLegacy ? undefined : store.get(name)?.retain();
1249:      typedSavedVariables.set(saved, { owner, binding, tickets, prepared: { name: token, admission }, watch, scalarLegacy });
1250:      tickets.cleanup = () => { typedSavedVariables.delete(saved); };
1251:    } catch (error) { await binding?.release(); await owner.close(); throw error; }
1252:    finally { holding.release(); }
1253:  }
1254:
1255:  async prepareArrayObservers(state: State, owner: ArrayOwner): Promise<void> {
1256:    owner.reserve({ metadata: 128, work: 6 });
1257:    for (const frame of state.locals) for (const [name, saved] of frame) {
1258:      if (!typedSavedVariables.has(saved)) await this.prepareVariable(state, name, saved);
1259:      await owner.ledger.checkpoint(this.signal);
1260:    }
1261:    for (const frame of stateMonitor(state)!.overlayFrames()) for (const [name, record] of frame) {
1262:      const saved = record as SavedVariable;
1263:      if (!saved.superseded && !typedSavedVariables.has(saved)) await this.prepareVariable(state, name, saved, true);
1264:      await owner.ledger.checkpoint(this.signal);
1265:    }
1266:  }
1267:
1268:  async discardVariable(saved: SavedVariable): Promise<void> {
1269:    const typed = typedSavedVariables.get(saved);
1270:    if (!typed) return;
1271:    typedSavedVariables.delete(saved);
1272:    typed.watch.close();
1273:    await typed.binding?.release();
1274:    await typed.owner.close();
1275:  }
