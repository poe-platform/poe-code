  rmdir(filename) { const record = directories.find(item => item.path === filename && item.acquired && !item.removed); assert.ok(record); assert.equal(port.stat(filename).identity, record.identity); port.rmdir(filename); record.removed = true; event('rmdir', { path: filename }); },
