    assert.equal(spec.executable, manifest.binary.path); assertOwnData(spec.args, ['--noprofile','--norc','-c',current.script,'mapfile-design-v1']);
    assert.equal(spec.cwd, `${current.outputRoot}/fixture`); assert.equal(Buffer.from(spec.stdin).toString('hex'), current.stdinHex);
    assertOwnData(spec.env, { PATH:'', ENV:'', BASH_ENV:'', HOME:`${spec.cwd}/home`, TMPDIR:`${spec.cwd}/tmp`, LANG:'C', LC_ALL:'C', TZ:'UTC' });
    const invocation = current;
