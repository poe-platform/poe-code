    const row = { id:'N01', expectation:null, script:item.script ?? ':', stdinHex:item.stdinHex ?? '' };
    row.scriptSha256 = digest(Buffer.from(row.script)); row.stdinSha256 = digest(Buffer.from(row.stdinHex, 'hex'));
    const recipeSha256 = digest(Buffer.from(JSON.stringify([row]))), authorizationPath = path.join(go.evidenceRoot, `authorization-${item.id}.json`);
    const authority = { kind:item.id === 'D01' ? 'NOT_GO' : 'ROOT_NATIVE_GO', runtime:manifest.runtime, moduleSealSha256:manifest.moduleSealSha256, recipeSha256, outputRoot:current.outputRoot, rowIds:['N01'] };
