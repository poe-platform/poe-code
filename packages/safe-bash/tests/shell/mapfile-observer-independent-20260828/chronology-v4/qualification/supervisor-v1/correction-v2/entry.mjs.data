assert.ok(go.approvedAtMs <= Date.now() && Date.now() < go.expiresAtMs && go.expiresAtMs - go.approvedAtMs <= 3600000);
assert.match(go.evidenceRoot, /^\/private\/tmp\/mapfile-observer-hq-[A-Za-z0-9-]{1,48}$/u);
