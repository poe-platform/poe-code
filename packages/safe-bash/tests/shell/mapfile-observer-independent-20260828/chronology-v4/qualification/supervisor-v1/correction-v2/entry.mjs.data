let sourceReadBytes = 0;
const originalReadSync = fs.readSync.bind(fs);
fs.readSync = (...args) => { const count=originalReadSync(...args); sourceReadBytes+=count; assert.ok(sourceReadBytes<=8589934592,'entry source read ceiling'); return count; };
const permittedBuiltins = new Set(['node:assert/strict','node:fs','node:path','node:crypto','node:child_process','node:perf_hooks','node:util/types','node:url']);
const loaded = new Map();
const hooks = registerHooks({ load(url, context, nextLoad) {
  if (url === 'node:child_process') return { format:'module',source:'export const spawn = globalThis.__qualificationBridge.spawn;',shortCircuit:true };
  if (url.startsWith('node:')) { assert.ok(permittedBuiltins.has(url)); return nextLoad(url, context); }
  const filename = fileURLToPath(url); assert.ok(filename.startsWith(moduleRoot + '/') && filename.endsWith('.mjs'));
  assert.notEqual(path.basename(filename), 'synthetic.mjs'); const binding = archiveFiles.get(filename); assert.ok(binding);
  const result = nextLoad(url, context); assert.equal(digest(Buffer.from(result.source)), binding.sha256); loaded.set(filename, binding.sha256); return result;
} });
const { runObserver } = await import(pathToFileURL(path.join(moduleRoot, 'observer.mjs')).href);
const { nodePort } = await import(pathToFileURL(path.join(moduleRoot, 'node-driver.mjs')).href);
const port = nodePort('ROOT_NATIVE_GO');
const startAt = performance.now(), trace = [], directories = [], files = [], children = [], reports = [];
let fileBytes = 0, starts = 0, current, watchdogFired = false, failed = false, failure;
function event(name, details = {}) { assert.ok(trace.length < 16384); trace.push({ name, at: performance.now() - startAt, ...details }); }
function checkTime() { assert.ok(!watchdogFired && performance.now() - startAt < 60000 && Date.now() < go.expiresAtMs); }
function identity(stat) { return `${stat.dev}:${stat.ino}`; }
function writeOwned(filename, bytes, mode = 0o600) {
  assert.ok(filename.startsWith(go.evidenceRoot) && Buffer.isBuffer(bytes)); assert.ok(files.length < 256 && fileBytes + bytes.length <= 8388608);
  const record = { path: filename, planned: true, written: false, bytes: bytes.length, mode, sha256: digest(bytes) }; files.push(record); fileBytes += bytes.length;
  fs.writeFileSync(filename, bytes, { flag: 'wx', mode }); record.written = true; record.identity = identity(fs.lstatSync(filename));
}
function mkdirOwned(filename) {
  assert.ok(filename === go.evidenceRoot || go.caseIds.some(id => filename === `${go.evidenceRoot}-${id}` || filename.startsWith(`${go.evidenceRoot}-${id}/`)));
  assert.ok(directories.length < 96); const record = { path: filename, planned: true, acquired: false, identity: null, removed: false }; directories.push(record);
  event('mkdir-registered', { path: filename }); fs.mkdirSync(filename, { mode: 0o700 }); record.acquired = true;
  const stat = fs.lstatSync(filename); record.identity = identity(stat); assert.ok(stat.isDirectory()); assert.equal(stat.mode & 0o7777, 0o700); event('mkdir-acquired', { path: filename });
}
function toolAudit() {
  for (const tool of [manifest.runtime, manifest.binary]) { const stat = port.stat(tool.path); assert.equal(stat.kind, 'file'); assert.equal(stat.bytes, tool.bytes); assert.equal(stat.mode, tool.mode); assert.equal(port.canonical(tool.path), tool.path); assert.equal(port.hash(tool.path, tool.bytes), tool.sha256); }
}
function ownedAudit() {
  for (const record of files.filter(item => item.written)) { const bytes = boundedRead(record.path, 4194304, record.mode); assert.equal(bytes.length, record.bytes); assert.equal(digest(bytes), record.sha256); assert.equal(identity(fs.lstatSync(record.path)), record.identity); }
  for (const record of directories.filter(item => item.acquired && !item.removed)) {
