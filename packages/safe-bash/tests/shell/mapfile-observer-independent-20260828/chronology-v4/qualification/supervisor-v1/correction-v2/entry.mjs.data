const archiveDirectories = new Set([archiveRoot]);
for (const filename of archiveFiles.keys()) { let directory = path.dirname(filename); while (directory !== archiveRoot) { archiveDirectories.add(directory); directory = path.dirname(directory); } }
function auditArchive() {
  assert.equal(digest(boundedRead(goPath)), expectedGoHash);
  for (const [filename, binding] of archiveFiles) { const bytes = boundedRead(filename, 16777216, binding.mode); assert.equal(bytes.length, binding.bytes); assert.equal(digest(bytes), binding.sha256); }
  for (const directory of archiveDirectories) {
    assert.equal(fs.realpathSync(directory), directory); const stat = fs.lstatSync(directory); assert.ok(stat.isDirectory()); assert.equal(stat.mode & 0o7777, 0o700);
    const expected = [...archiveFiles.keys(), ...archiveDirectories].filter(filename => filename !== directory && path.dirname(filename) === directory).map(filename => path.basename(filename)).sort();
