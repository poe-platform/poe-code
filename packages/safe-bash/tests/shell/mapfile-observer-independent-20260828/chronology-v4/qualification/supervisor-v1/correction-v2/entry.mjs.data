  }
}
auditArchive();
const cases = JSON.parse(boundedRead(path.join(archiveRoot, 'qualification/CASES.json')));
assertOwnData(go.caseIds, [...cases.preflight, ...cases.children].map(item => item.id));
const controls = path.join(archiveRoot, 'controls'), moduleRoot = path.join(controls, 'observer-v1/modules');
const moduleSealPath = path.join(controls, 'observer-v1/MODULE-SEAL.json');
const seal = JSON.parse(boundedRead(moduleSealPath)); assert.equal(digest(boundedRead(moduleSealPath)), manifest.moduleSealSha256);
assertOwnData(seal.moduleFiles, manifest.moduleFiles);
assert.match(brokerToken, /^[a-f0-9]{64}$/u); assert.equal(digest(Buffer.from(brokerToken)), go.tokenSha256);
const bridgePath = path.join(archiveRoot, 'supervisor/bridge.mjs.data'), bridgeBytes = boundedRead(bridgePath); assert.equal(digest(bridgeBytes), archiveFiles.get(bridgePath).sha256);
