assertOwnData(Object.keys(go).sort(), ['kind','qualificationCommit','manifestSha256','parentSha256','archiveRoot','evidenceRoot','runId','rootPid','tokenSha256','caseIds','runtime','binary','approvedAtMs','expiresAtMs','zeroNetwork','archiveAuthenticatedAgainstCommit','externalWatchdog','limits'].sort());
assert.equal(go.kind, 'ROOT_HARMLESS_OBSERVER_SUPERVISOR_GO');
assert.match(go.qualificationCommit, /^[a-f0-9]{40}$/u); assert.match(go.manifestSha256, /^[a-f0-9]{64}$/u);
