assert.equal(digest(manifestBytes), go.manifestSha256); const manifest = JSON.parse(manifestBytes);
assert.equal(manifest.candidate, '3d3a0371729b88ced47b6e37376676746b638ad9');
assertOwnData(go.runtime, manifest.runtime); assertOwnData(go.binary, manifest.binary);
assert.equal(process.execPath, manifest.runtime.path); assert.equal(process.version, manifest.runtime.version);
assert.equal(process.platform, manifest.runtime.platform); assert.equal(process.arch, manifest.runtime.arch);
assertOwnData(process.env, { PATH:'', ENV:'', BASH_ENV:'', NODE_OPTIONS:'', NODE_PATH:'', HOME:go.evidenceRoot, TMPDIR:go.evidenceRoot, LANG:'C', LC_ALL:'C', TZ:'UTC' });
const archiveFiles = new Map(Object.entries(manifest.files).map(([relative, binding]) => {
