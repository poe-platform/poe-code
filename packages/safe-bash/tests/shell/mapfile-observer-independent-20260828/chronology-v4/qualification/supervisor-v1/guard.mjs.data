    if (JSON.stringify(entries.sort()) !== JSON.stringify(expected)) throw new Error('producer census');
    for (const record of directories.values()) { const stat = fs.lstatSync(record.path); if (!stat.isDirectory() || identity(stat) !== record.identity || (stat.mode & 4095) !== 0o700 || fs.realpathSync(record.path) !== record.path) throw new Error('directory identity'); }
    for (const record of files.values()) if (record.acquired) { const bytes = readBound(record.path, 5242880, record.mode); if (identity(fs.lstatSync(record.path)) !== record.identity || bytes.length !== record.bytes || hash(bytes) !== record.digest.copy().digest('hex')) throw new Error('producer hash/identity'); }
