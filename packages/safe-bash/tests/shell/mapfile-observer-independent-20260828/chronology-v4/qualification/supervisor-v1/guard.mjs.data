      directories.set(root, { path: root, acquired: false, identity: null }); fs.mkdirSync(root, { mode: 0o700 }); const record = directories.get(root); record.acquired = true; record.identity = identity(fs.lstatSync(root)); journal({ kind: 'root-acquired', identity: record.identity });
    } catch (reason) { close(); throw reason; }
  }
