    const payload = Buffer.from(JSON.stringify({ sequence, previous, run, value })); if (payload.length > 16384 || journalBytes + payload.length + 4 > 2097152) throw new Error('journal size ceiling');
    const frame = Buffer.alloc(payload.length + 4); frame.writeUInt32BE(payload.length); payload.copy(frame, 4); append(journalFd, frame); fs.fsyncSync(journalFd.fd); journalBytes += frame.length; previous = hash(frame); sequence++;
  }
