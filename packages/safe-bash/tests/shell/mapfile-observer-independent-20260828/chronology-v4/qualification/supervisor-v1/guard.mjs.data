import fs from 'node:fs';
import path from 'node:path';
import { createHash } from 'node:crypto';

export const hash = bytes => createHash('sha256').update(bytes).digest('hex');
export const identity = stat => `${stat.dev}:${stat.ino}`;
const same = (first, second) => ['dev','ino','size','mode','mtimeMs','ctimeMs'].every(key => first[key] === second[key]);
let toolReadBytes = 0;
export function readBound(filename, maximum, mode, expectedHash) {
  if (!path.isAbsolute(filename) || fs.realpathSync(filename) !== filename) throw new Error('noncanonical input');
  const before = fs.lstatSync(filename);
  if (!before.isFile() || before.size > maximum || (before.mode & 4095) !== mode) throw new Error('input type/size/mode');
