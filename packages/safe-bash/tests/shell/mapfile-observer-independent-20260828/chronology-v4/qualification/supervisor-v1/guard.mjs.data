    return { total, sequence, files: [...files.values()].map(({ fd, digest, ...record }) => ({ ...record, sha256: digest.copy().digest('hex') })), directories: [...directories.values()] };
  }
  function close() { for (const record of files.values()) if (record.fd !== null) { fs.closeSync(record.fd); record.fd = null; } }
  return { initialize, journal, open, append, audit, close, write(filename, bytes) { const record = open(filename, 0o600); append(record, bytes); return record; } };
}
export function validateJournal(bytes, run) {
  if (bytes.length > 2097152) throw new Error('journal total');
  let offset = 0, sequence = 0, previous = '0'.repeat(64);
  while (offset < bytes.length) {
    if (sequence >= 8192 || bytes.length - offset < 4) throw new Error('partial journal header');
    const length = bytes.readUInt32BE(offset); if (length > 16384 || length < 2 || offset + 4 + length > bytes.length) throw new Error('partial/oversize journal frame');
    const frame = bytes.subarray(offset, offset + 4 + length), record = JSON.parse(frame.subarray(4));
    if (JSON.stringify(Object.keys(record).sort()) !== JSON.stringify(['previous','run','sequence','value']) || record.sequence !== sequence || record.previous !== previous || JSON.stringify(record.run) !== JSON.stringify(run)) throw new Error('journal identity/chain');
    previous = hash(frame); sequence++; offset += frame.length;
  }
  if (!sequence) throw new Error('empty journal'); return { sequence, previous };
}
