    while (offset < bytes.length) { const count = fs.readSync(descriptor, scratch, 0, Math.min(scratch.length, bytes.length - offset), null); if (!count) throw new Error('short input'); scratch.copy(bytes, offset, 0, count); offset += count; }
    if (fs.readSync(descriptor, scratch, 0, 1, null) || !same(before, fs.fstatSync(descriptor)) || !same(before, fs.lstatSync(filename))) throw new Error('changed input');
    if (expectedHash && hash(bytes) !== expectedHash) throw new Error('input hash');
    return bytes;
  } finally { fs.closeSync(descriptor); }
}
export function hashTool(tool) {
  toolReadBytes += tool.bytes; if (toolReadBytes > 4294967296) throw new Error('aggregate parent tool read ceiling');
  const before = fs.lstatSync(tool.path);
  if (fs.realpathSync(tool.path) !== tool.path || !before.isFile() || before.size !== tool.bytes || (before.mode & 4095) !== tool.mode || tool.bytes > 268435456) throw new Error('tool metadata');
  const descriptor = fs.openSync(tool.path, fs.constants.O_RDONLY | fs.constants.O_NOFOLLOW), scratch = Buffer.alloc(65536), digest = createHash('sha256');
  try {
    if (!same(before, fs.fstatSync(descriptor))) throw new Error('tool FD identity');
    let offset = 0;
    while (offset < tool.bytes) { const count = fs.readSync(descriptor, scratch, 0, Math.min(65536, tool.bytes - offset), null); if (!count) throw new Error('short tool'); digest.update(scratch.subarray(0, count)); offset += count; }
    if (fs.readSync(descriptor, scratch, 0, 1, null) || !same(before, fs.fstatSync(descriptor)) || !same(before, fs.lstatSync(tool.path)) || digest.digest('hex') !== tool.sha256) throw new Error('tool change/hash');
    return { path: tool.path, identity: identity(before), mode: tool.mode, bytes: tool.bytes, sha256: tool.sha256 };
  } finally { fs.closeSync(descriptor); }
}
export function createStore(root, guardPath, run, maximum = 16777216) {
  const files = new Map(), directories = new Map(); let total = 0, sequence = 0, previous = '0'.repeat(64), journalFd, journalBytes = 0;
  function plan(filename, mode = 0o600) {
    if (files.has(filename) || files.size >= 32 || !(filename === guardPath || path.dirname(filename) === root)) throw new Error('producer path/count');
    const record = { path: filename, mode, acquired: false, identity: null, bytes: 0, digest: createHash('sha256'), fd: null }; files.set(filename, record); return record;
  }
  function open(filename, mode) {
    const record = plan(filename, mode); record.fd = fs.openSync(filename, fs.constants.O_WRONLY | fs.constants.O_CREAT | fs.constants.O_EXCL | fs.constants.O_NOFOLLOW, record.mode); record.acquired = true;
    const stat = fs.fstatSync(record.fd); record.identity = identity(stat); if (!stat.isFile() || (stat.mode & 4095) !== record.mode) throw new Error('producer identity/mode'); return record;
  }
  function append(record, bytes) {
    if (!Buffer.isBuffer(bytes) || total + bytes.length > maximum || record.bytes + bytes.length > 5242880) throw new Error('storage ceiling');
    const stat = fs.fstatSync(record.fd), pathname = fs.lstatSync(record.path);
