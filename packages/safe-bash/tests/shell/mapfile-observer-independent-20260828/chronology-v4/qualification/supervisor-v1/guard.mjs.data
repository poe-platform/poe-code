    total += bytes.length;
    let offset = 0; while (offset < bytes.length) { const count = fs.writeSync(record.fd, bytes, offset, bytes.length - offset); if (!count) throw new Error('short producer write'); offset += count; }
    record.bytes += bytes.length; record.digest.update(bytes);
  }
