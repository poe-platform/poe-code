}
sourceFiles.set('supervisor/COMBINED.json',manifestBytes);
let safetyAttempts = 0;
const deny = () => { safetyAttempts++; throw new Error('SAFETY_STOP_REAL_CAPABILITY'); };
for(const key of ['spawn','spawnSync','exec','execSync','execFile','execFileSync','fork'])childProcess[key]=deny;
