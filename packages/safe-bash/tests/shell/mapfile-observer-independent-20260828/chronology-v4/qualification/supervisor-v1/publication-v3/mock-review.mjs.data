      if(control.variant==='accessor-hole-extra'){for(const value of [Object.defineProperty({},'a',{get(){invoked++;return 1;}}),[,1],Object.assign([1],{extra:2}),{a:1,toJSON(){invoked++;return{};}}])assert.throws(()=>ownData.assertOwnData(value,{a:1}));assert.equal(invoked,0);}
