import childProcess from 'node:child_process';
import { syncBuiltinESMExports } from 'node:module';

const root = 'tests/shell/mapfile-observer-independent-20260828/chronology-v4/qualification/supervisor-v1';
const sha = bytes => crypto.createHash('sha256').update(bytes).digest('hex');
const controls = JSON.parse(fs.readFileSync(`${root}/publication-v3/CONTROLS.json`));
const revision = `${root}/publication-v3`;
const manifestBytes = fs.readFileSync(`${revision}/COMBINED.json`), manifest = JSON.parse(manifestBytes);
assert.equal(crypto.createHash('sha256').update(manifestBytes).digest('hex'),process.env.EXPECTED_MANIFEST_SHA256);
const hostDeadline=setTimeout(()=>{process.stderr.write('PREP_HOST_TIMEOUT\n');process.exit(124);},180000);
const payloads = JSON.parse(fs.readFileSync(`${root}/PAYLOADS.json`));
const sourceFiles = new Map();
