      if(control.variant==='tamper'){const store=createStore('/owned/root','/owned/guard',run);store.initialize();model.get('/owned/guard').bytes[5]^=1;assert.throws(()=>store.audit());store.close();assert.equal(model.descriptors.size,0);}
