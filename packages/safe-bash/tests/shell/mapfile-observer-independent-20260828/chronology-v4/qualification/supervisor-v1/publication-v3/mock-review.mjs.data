assert.equal(safetyAttempts,0);
const result={classification:'SYNTHETIC_MOCK_OS_ONLY',controlsSha256:sha(fs.readFileSync(`${root}/publication-v3/CONTROLS.json`)),manifestSha256:sha(manifestBytes),pass:results.filter(item=>item.pass).length,fail:results.filter(item=>!item.pass).length,executed:results.length,planned:controls.cases.length,safetyAttempts,realQualificationChildren:0,realQualificationEntries:0,results};
