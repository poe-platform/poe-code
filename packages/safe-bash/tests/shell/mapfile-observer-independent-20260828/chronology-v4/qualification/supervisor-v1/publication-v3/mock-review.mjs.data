      const owner=createOwner({now:()=>now,journal:value=>{if(journalFault)throw reason;journal.push(value);},describe:()=>[],capture(){},deliver(){},signal:(handle,pid,signal)=>signals.push({pid,signal}),groupExists:()=>control.variant==='post-exit-signal',release:()=>{releases++;}},limits);
      const child=new EventEmitter();Object.assign(child,{pid:567,stdout:new EventEmitter(),stderr:new EventEmitter()});
      if(control.variant==='journal-before-acquire'){journalFault=true;assert.throws(()=>owner.acquire('H01','harmless',()=>{spawns++;return child;}),value=>value===reason);assert.equal(spawns,0);assert.equal(owner.status().failure,reason);}
      else{
        owner.acquire('H01','harmless',()=>{spawns++;return child;});child.emit('spawn');
        if(control.variant==='unknown-pid'){assert.throws(()=>owner.requestSignal('567','SIGKILL'));assert.equal(signals.length,0);}
        if(control.variant==='reason-identity'){owner.fail(reason);owner.fail(undefined);assert.equal(owner.status().failure,reason);const other=createOwner({now:()=>0},limits);other.fail(undefined);other.fail(reason);assert.equal(other.status().failure,undefined);assert.equal(other.status().failed,true);}
        child.emit('exit',0,null);
        if(control.variant==='post-exit-signal'){owner.requestSignal('H01','SIGKILL');now=4000;owner.tick();now=5100;owner.tick();assert.equal(signals.length,0);assert.equal(owner.status().settled,false);}
        else{child.emit('close',0,null);if(control.variant==='duplicate-close'){child.emit('close',0,null);assert.equal(owner.status().failed,true);}owner.tick();owner.tick();assert.equal(releases,1);}
      }
