const gitBytes = childProcess.execFileSync('/usr/bin/git', ['ls-tree', '-r', freeze, '--', path.relative(root, owned)], { cwd: root, timeout: 10000, maxBuffer: 65536 }).toString();
const frozenTree = gitBytes.trim().split('\n').map(line => {
