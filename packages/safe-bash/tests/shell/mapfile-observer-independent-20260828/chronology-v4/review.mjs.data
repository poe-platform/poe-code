assert.equal(digest(inputs.get(`${packet}/observer-v1/MODULE-SEAL.json`)), manifest.moduleSealSha256);
for (const [name, expected] of Object.entries(seal.artifacts)) assert.equal(digest(inputs.get(`${packet}/${name}`)), expected);
