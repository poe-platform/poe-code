assert.equal(rows.length, 43); assert.equal(digest(JSON.stringify(rows)), seal.combinedRecipeSha256);
const moduleBytes = new Map(seal.moduleFiles.map(name => [name, inputs.get(`${packet}/observer-v1/modules/${name}`)]));
