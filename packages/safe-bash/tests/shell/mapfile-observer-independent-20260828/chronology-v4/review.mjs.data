    assert.equal(JSON.stringify(options.env), JSON.stringify({ PATH: '', ENV: '', BASH_ENV: '', HOME: '/owned/fixture/home', TMPDIR: '/owned/fixture/tmp', LANG: 'C', LC_ALL: 'C', TZ: 'UTC' }));
    if (this.scenario === 'sync-spawn-throw' || this.scenario === 'host-reason-identity') throw this.reason;
    const child = { ...this.emitter('child'), pid: this.scenario === 'async-no-process' ? undefined : 9001, stdin: this.emitter('stdin'), stdout: this.emitter('stdout'), stderr: this.emitter('stderr'), unref: () => { this.log('unref'); this.releases++; } };
    this.child = child; this.alive = true;
    if (installV4(this, child)) return child;
