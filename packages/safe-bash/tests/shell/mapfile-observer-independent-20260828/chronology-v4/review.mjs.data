  [workers, ['Worker']], [net, ['connect', 'createConnection', 'createServer', 'Socket', 'Server']],
  [tls, ['connect', 'createServer', 'TLSSocket']], [http, ['request', 'get', 'createServer']],
  [https, ['request', 'get', 'createServer']], [http2, ['connect', 'createServer', 'createSecureServer']],
