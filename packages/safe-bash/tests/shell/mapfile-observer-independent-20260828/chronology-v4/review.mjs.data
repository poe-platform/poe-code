syncBuiltinESMExports();
const watchdog = setTimeout(() => { writeHost(path.join(owned, 'RECEIPT-01.json'), JSON.stringify({ status: 'SAFETY_STOP_WALL', freeze }), { flag: 'wx' }); process.exit(90); }, 60000);
let active;
const current = () => { if (!active) stop('adapter used without owned active case'); return active; };
const fakeFs = new Proxy({ constants: fs.constants }, { get(target, name) {
  if (name === 'constants') return target.constants;
