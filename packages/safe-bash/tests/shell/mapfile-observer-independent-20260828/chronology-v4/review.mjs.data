  ['node:crypto', { createHash }], ['node:fs', { default: fakeFs }],
  ['node:child_process', { spawn: (...args) => current().spawn(...args) }],
  ['node:perf_hooks', { performance: { now: () => current().clock } }],
  ['node:util/types', { isUint8Array: (await import('node:util/types')).isUint8Array }],
  ['node:url', { fileURLToPath: (await import('node:url')).fileURLToPath }],
