    assert.equal(this.starts, 1, 'no hidden retry/second launch in finite case');
    assert.equal(executable, '/controls/bash'); assert.equal(args[0], '--noprofile'); assert.equal(args[1], '--norc'); assert.equal(args[2], '-c');
    assert.equal(args[3], rows[0].script); assert.equal(args[4], 'mapfile-design-v1'); assert.equal(args.length, 5);
    assert.equal(options.cwd, '/owned/fixture'); assert.equal(options.detached, true);
