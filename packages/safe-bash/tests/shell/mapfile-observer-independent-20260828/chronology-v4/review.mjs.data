    if (rejected) throw reason; return value;
  }
  cleanup() {
    if (this.tasks.size || this.descriptors.size || effects.length) stop('synthetic resources/integrity not clean');
    const summary = { starts: this.starts, releases: this.releases, events: this.events, clock: this.clock, maximumTasks: this.maximumTasks, pending: this.tasks.size, descriptors: this.descriptors.size, signals: this.signals, virtualGroupAlive: this.alive, discardedEntries: this.files.size, coercions: this.coercions, callbackExceptions: this.hostCallbackExceptions };
    this.files.clear(); this.child = null; this.finishChild = null; this.alive = false; return summary;
  }
}

function configFor(model) {
  const runtime = { path: '/controls/node', version: 'MODEL', platform: 'synthetic', arch: 'synthetic', bytes: model.files.get('/controls/node').bytes.length, sha256: digest(model.files.get('/controls/node').bytes), mode: 0o755 };
  const config = { schema: 'mapfile-observer-v1', mode: 'synthetic', runtime, protected: {}, protectedModes: {}, moduleRoot: '/controls/modules', moduleFiles: seal.moduleFiles, moduleSealSha256: manifest.moduleSealSha256, authorizationPath: '/controls/auth', recipeSha256: seal.combinedRecipeSha256, rows, rowIds: ['N01'], outputRoot: '/owned', binary: '/controls/bash', binaryBytes: model.files.get('/controls/bash').bytes.length, binaryMode: 0o755, binarySha256: digest(model.files.get('/controls/bash').bytes) };
  if (['missing-close', 'group-survives', 'route-reordered-ids'].includes(model.scenario)) config.rowIds = ['N01', 'N02'];
  const authority = { kind: model.scenario === 'route-native-kind' ? 'ROOT_NATIVE_GO' : 'SYNTHETIC_ONLY', runtime, moduleSealSha256: config.moduleSealSha256, recipeSha256: config.recipeSha256, outputRoot: config.outputRoot, rowIds: model.scenario === 'route-reordered-ids' ? ['N02', 'N01'] : config.rowIds };
  model.put('/controls/auth', 'file', Buffer.from(JSON.stringify(authority))); config.authorizationSha256 = digest(model.files.get('/controls/auth').bytes);
  for (const [filename, item] of model.files) if (item.kind === 'file' && !['/controls/node', '/controls/bash'].includes(filename)) { config.protected[filename] = digest(item.bytes); config.protectedModes[filename] = 0o644; }
  if (model.scenario === 'module-mode-only') model.files.get('/controls/modules/admission.mjs').mode = 0o777;
  if (model.scenario === 'native-not-executable') model.files.get('/controls/bash').mode = 0o644;
  if (model.scenario === 'runtime-not-executable') model.files.get('/controls/node').mode = 0o644;
  if (model.scenario === 'vm-runtime-extra' || model.scenario === 'vm-runtime-accessor') {
    model.port.runtimeIdentity = () => {
      const value = realm('({path:"/controls/node",version:"MODEL",platform:"synthetic",arch:"synthetic"})');
      if (model.scenario === 'vm-runtime-extra') value.extra = true;
      else Object.defineProperty(value, 'version', { get() { model.coercions++; return 'MODEL'; }, enumerable: true });
      return value;
    };
  }
  if (!model.scenario.startsWith('vm-config') && !model.scenario.startsWith('vm-rowids')) return config;
  const other = realm(`(${JSON.stringify(config)})`); assert.notEqual(Object.getPrototypeOf(other), Object.getPrototypeOf(config));
  if (model.scenario === 'vm-config-extra') other.extra = true;
  if (model.scenario === 'vm-rowids-hole') delete other.rowIds[0];
  if (model.scenario === 'vm-rowids-extra') other.rowIds.extra = true;
  return other;
}
function verifyObserver(model, report, expected) {
  assert.equal(report.success, expected);
  assert.equal(model.hostCallbackExceptions.length, 0, 'no escaped driver event callback');
  const scenario = model.scenario;
  if (['module-mode-only', 'native-not-executable', 'runtime-not-executable', 'deadline-crossed-during-auth', 'deadline-during-attempt', 'deadline-final-admission', 'post-mkdir-stat-fails', 'vm-config-extra', 'vm-runtime-extra', 'vm-runtime-accessor', 'route-native-kind', 'route-reordered-ids'].includes(scenario)) assert.equal(model.starts, 0);
  if (scenario === 'final-mode-only' || scenario.startsWith('final-control:') || scenario === 'final-new-module') assert.ok(report.failures.some(item => item.phase === 'post-persistence-integrity'));
  if (scenario === 'final-new-receipt') assert.ok(report.failures.some(item => item.phase === 'post-persistence-storage'));
  if (scenario === 'post-mkdir-stat-fails') { assert.equal(report.directories[0].planned, true); assert.equal(report.directories[0].acquired, true); assert.equal(report.directories[0].identity, null); assert.equal(model.files.has('/owned'), true); }
  if (['spawn-publication-fails', 'row-publication-fails', 'final-publication-fails'].includes(scenario)) {
    assert.equal(report.launched, 1); assert.equal(report.actualCloseEvents, 1); assert.equal(model.releases, 1); assert.equal(report.remaining.length, 0);
    assert.ok(report.failures.some(item => item.reason === model.reason));
    if (scenario === 'final-publication-fails') assert.ok(report.failures.some(item => item.phase === 'final-persistence'));
  }
  if (['missing-close', 'group-survives', 'forged-child-flags'].includes(scenario)) { assert.equal(report.rows[0].terminal, 'terminal-cleanup-uncertain'); assert.equal(report.cleanupUncertain, true); assert.equal(report.rows[0].elapsed, 3000); assert.equal(model.starts, 1); }
  if (['sync-spawn-throw', 'async-no-process', 'host-reason-identity'].includes(scenario)) { assert.equal(report.launched, 0); assert.equal(report.actualCloseEvents, 0); assert.equal(report.rows[0].failureReason, model.reason); assert.equal(report.failureReason, model.reason); }
  if (scenario === 'close-without-spawn') { assert.equal(report.launched, 0); assert.equal(report.actualCloseEvents, 1); assert.equal(report.rows[0].terminal, 'inconsistent-driver-completion'); }
  if (scenario === 'positive') { assert.equal(Buffer.from(report.rows[0].stdoutBase64, 'base64').toString(), 'owned\n'); assert.equal(Buffer.from(report.rows[0].stderrBase64, 'base64').toString(), 'note\n'); }
  assert.equal(model.coercions, 0);
}

async function direct(name, model, record) {
  const data = api['data.mjs'];
  if (name === 'ownership-before-mkdir') { model.ownership = new api['storage.mjs'].OwnedStorage(model.port, '/owned'); model.ownership.acquire('/owned'); assert.ok(model.trace.some(item => item.operation === 'ownership-before-mkdir')); }
  else if (name === 'hash-descriptor-finally') { let reason; try { model.port.hash('/controls/bash', model.files.get('/controls/bash').bytes.length); } catch (error) { reason = error; } assert.equal(reason, model.reason); assert.equal(model.descriptors.size, 0); }
  else if (name === 'cli-absent-admission') { await assert.rejects(api['cli.mjs'].main([])); assert.equal(model.trace.length, 0); }
  else if (name === 'vm-own-data-positive' || name === 'vm-null-prototype-positive') {
    const value = realm(name === 'vm-own-data-positive' ? '({a:[null,true,1,"x"],b:{z:0}})' : 'Object.assign(Object.create(null),{a:Object.setPrototypeOf([null,true,1,"x"],null),b:Object.assign(Object.create(null),{z:0})})');
    assert.notEqual(Object.getPrototypeOf(value), Object.prototype); data.assertOwnData(value, { a: [null, true, 1, 'x'], b: { z: 0 } });
  } else if (name === 'vm-rejection-matrix') {
    record.probes = [];
    for (const [id, expression, expected, mismatch] of [
      ['hole', '[1,,3]'], ['array-extra', 'Object.assign([1],{extra:2})'],
      ['array-symbol', 'Object.assign([1],{[Symbol("x")]:2})'],
      ['accessor', 'Object.defineProperty({},"x",{get(){hit();return 1},enumerable:true})'],
      ['array-accessor', 'Object.defineProperty([1],"0",{get(){hit();return 1}})'],
      ['toJSON', '({toJSON(){hit();return {} }})'], ['toPrimitive', '({[Symbol.toPrimitive](){hit();return "x"}})'],
      ['nonfinite', '({x:Infinity})'], ['undefined', '({x:undefined})'], ['type', '({x:"1"})', { x: 1 }, true],
      ['sequence', '[2,1]', [1, 2], true], ['extra-record', '({x:1,y:2})', { x: 1 }, true],
      ['nonenumerable-extra', 'Object.defineProperty({x:1},"hidden",{value:2})', { x: 1 }, true],
    ]) {
      const value = vm.runInNewContext(expression, { hit: () => { model.coercions++; } }, { timeout: 1000 });
      let refused = false; try { if (mismatch) data.assertOwnData(value, expected); else data.snapshotOwnData(value); } catch { refused = true; }
      assert.equal(refused, true, id); assert.equal(model.coercions, 0); record.probes.push({ id, refused, coercions: model.coercions });
    }
  } else if (name === 'host-proxy-reason-identity') {
    for (const trap of ['ownKeys', 'getOwnPropertyDescriptor']) {
      const value = new Proxy({ x: 1 }, { [trap]() { throw model.reason; } }); let actual;
      try { data.snapshotOwnData(value); } catch (error) { actual = error; } assert.equal(actual, model.reason);
    }
    record.referenceIdentity = true;
  } else if (name === 'stat-mode-projection') { model.files.get('/controls/bash').mode = 0o6755; const actual = model.port.stat('/controls/bash'); assert.equal(actual.mode, 0o6755); data.assertOwnData(Object.keys(actual).sort(), ['bytes', 'identity', 'kind', 'mode']); }
  else stop(`undeclared direct control ${name}`);
}
function integrity() {
  assert.deepEqual(listHost(path.dirname(owned)).sort(), [...bundle.history.map(item => path.basename(item.path)), 'chronology-v4'].sort());
  for (const item of bundle.history) { assert.equal(digest(readHost(path.join(root, item.path))), item.sha256); assert.equal(statHost(path.join(root, item.path)).mode & 0o7777, item.mode); }
  assert.deepEqual(listHost(owned).sort(), frozenFiles);
  for (const [name, bytes] of bytesByName) { assert.equal(realpathHost(path.join(owned, name)), path.join(owned, name)); assert.ok(statHost(path.join(owned, name)).isFile()); assert.equal(statHost(path.join(owned, name)).mode & 0o7777, 0o644); assert.equal(digest(readHost(path.join(owned, name))), digest(bytes)); }
  for (const [name, bytes] of moduleBytes) assert.equal(digest(bytes), seal.artifacts[`observer-v1/modules/${name}`]);
  assert.equal(effects.length, 0);
}
let safetyFailure;
try {
  integrity();
  assert.ok(cases.observer.length + cases.direct.length <= 100);
  for (const [scenario, expected] of cases.observer) {
    active = new Model(scenario); const result = { scenario, expected, pass: false }; const config = configFor(active);
    try {
      const report = await active.drive(api['observer.mjs'].runObserver(active.port, config)); result.report = report;
      result.reasonIdentity = { row: report.rows[0]?.failureReason === active.reason, report: report.failureReason === active.reason, phases: report.failures.filter(item => item.reason === active.reason).map(item => item.phase) };
      verifyObserver(active, report, expected); verifyV4(active, report); result.pass = true;
    } catch (error) {
      if (error instanceof SafetyStop) throw error;
      if (['vm-rowids-hole', 'vm-rowids-extra'].includes(scenario) && !result.report) { assert.equal(active.starts, 0); result.pass = true; result.rejectedBeforeReport = true; }
      else result.failure = { name: error?.name ?? 'opaque', message: String(error?.message ?? error).slice(0, 32768), stack: String(error?.stack ?? '').slice(0, 32768) };
    }
    result.trace = active.trace; result.model = active.cleanup(); integrity(); results.push(result);
    if (!result.pass) process.stdout.write(`FRAMEWORK_DEFECT ${scenario}: ${result.failure?.message}\n`);
    active = undefined;
  }
  for (const name of cases.direct) {
    active = new Model(name); const result = { scenario: name, direct: true, pass: false };
    try { await direct(name, active, result); result.pass = true; } catch (error) { if (error instanceof SafetyStop) throw error; result.failure = { name: error?.name, message: String(error?.message ?? error).slice(0, 32768), stack: String(error?.stack ?? '').slice(0, 32768) }; }
    result.trace = active.trace; result.model = active.cleanup(); integrity(); results.push(result); active = undefined;
    if (!result.pass) process.stdout.write(`FRAMEWORK_DEFECT ${name}: ${result.failure?.message}\n`);
  }
} catch (error) { safetyFailure = { name: error?.name, message: String(error?.message ?? error).slice(0, 32768) }; }
clearTimeout(watchdog);
const capture = { schema: 'independent-chronology-v4-whole-module', replayIdentity: cases.replayIdentity, closure: { moduleFiles: seal.moduleFiles, artifacts: seal.artifacts, modes: seal.artifactModes }, history: bundle.history, freeze, candidate: bundle.candidate, evidence: bundle.evidence, moduleSealSha256: manifest.moduleSealSha256, frozenTree, loaded: loads, moduleEvaluations: Object.fromEntries([...modules].map(([name, module]) => [name, module.status])), injectedBuiltins: [...builtins.keys()], sourceTransform: 'none; exact complete source bytes; builtin imports and process/timers intercepted', results, passed: results.filter(item => item.pass).length, total: results.length, declared: cases.observer.length + cases.direct.length, originalSix: cases.originalSix.map(name => ({ name, pass: results.find(item => item.scenario === name)?.pass ?? false })), forbiddenHostEffects: effects, safetyFailure, realObserverChildren: 0, productExecutions: 0, nativeRecipesExecuted: 0, physicalEffects: 'exclusive sidecar capture/receipt only; all candidate FS/descriptors/children/signals/streams are virtual', node: manifest.node, elapsedHostMs: nowHost() - beganHost };
const text = JSON.stringify(capture) + '\n'; assert.ok(Buffer.byteLength(text) <= 4194304);
if (!safetyFailure) integrity();
writeHost(path.join(owned, 'CAPTURE-01.json'), text, { flag: 'wx', mode: 0o644 });
const exitCode = safetyFailure ? 90 : capture.passed === capture.declared ? 0 : 1;
const receipt = { freeze, captureSha256: digest(text), captureBytes: Buffer.byteLength(text), passed: capture.passed, total: capture.total, declared: capture.declared, exitCode, realObserverChildren: 0, beforeAfterOriginalHashesAndNewEntryCensus: !safetyFailure, safetyFailure };
writeHost(path.join(owned, 'RECEIPT-01.json'), JSON.stringify(receipt, null, 2) + '\n', { flag: 'wx', mode: 0o644 });
assert.deepEqual(listHost(owned).sort(), [...frozenFiles, 'CAPTURE-01.json', 'RECEIPT-01.json'].sort());
process.stdout.write(JSON.stringify(receipt) + '\n'); process.exitCode = exitCode;

