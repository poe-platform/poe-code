if(process.argv[1]===fileURLToPath(import.meta.url)){
  const seal=JSON.parse(readPinned(process.env.PIPE_SEAL,{bytes:Number(process.env.PIPE_SEAL_BYTES),sha256:process.env.PIPE_SEAL_SHA256},2097152));
