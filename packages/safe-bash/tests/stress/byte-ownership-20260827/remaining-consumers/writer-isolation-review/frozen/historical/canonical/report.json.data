          "poe-safejs": "dist/cli.js"
        },
        "exports": {
          ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
          },
          "./core": {
            "types": "./dist/core.d.ts",
            "import": "./dist/core.js"
          },
          "./cli": {
            "types": "./dist/cli.d.ts",
            "import": "./dist/cli.js"
          }
        },
