          "@poe-code/agent-spawn": "*",
          "@poe-code/frontmatter": "*"
        },
        "scripts": {
          "build": "node ../../scripts/guard-package-dist.mjs && tsc",
          "example:experiment": "tsx src/cli.ts examples/experiment.md",
          "example:pipeline": "tsx src/cli.ts examples/pipeline.md",
          "example:superintendent": "tsx src/cli.ts examples/superintendent.md",
          "test": "cd ../.. && vitest run packages/safejs/src packages/safejs/test",
          "test:unit": "cd ../.. && vitest run packages/safejs/src packages/safejs/test",
          "test:adversarial": "cd ../.. && vitest run packages/safejs/test/adversarial",
          "test:adversarial:slow": "cd ../.. && SAFEJS_ADVERSARIAL_SLOW=1 SAFEJS_PARSE_FUZZ=1 vitest run packages/safejs/test/adversarial packages/safejs/src/parse/fuzz.test.ts"
        },
        "files": [
          "dist",
          "examples"
        ]
      },
