{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": [
    "src/**/*.ts",
    "src/commands/bytes/compression/native/generated/bz2.d.mts",
    "src/commands/bytes/compression/native/generated/xz.d.mts",
    "src/commands/bytes/compression/native/generated/zstd.d.mts"
  ],
  "exclude": [
    "tests",
    "dist",
    "node_modules",
    "src/commands/xan/argv.ts",
    "src/commands/xan/budget.ts",
    "src/commands/xan/commands.ts",
    "src/commands/xan/csv.ts",
    "src/commands/xan/index.ts",
    "src/commands/xan/io.ts",
    "src/commands/xan/options.ts",
    "src/commands/xan/selector.ts",
    "src/commands/xan/sort.ts",
    "src/commands/xan/writer.ts"
  ]
}
