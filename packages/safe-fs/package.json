{
  "name": "@poe-code/safe-fs",
  "version": "0.0.0-dev",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "imports": {
    "#safe-fs-native-seek": {
      "types": "./src/native/loader.d.ts",
      "workerd": "./src/node/native-seek-unavailable.ts",
      "browser": null,
      "worker": null,
      "default": "./dist/native/fs-seek/loader.mjs"
    },
    "#safe-fs-platform": {
      "types": {
        "workerd": "./src/platform/browser.ts",
        "browser": "./src/platform/browser.ts",
        "worker": "./src/platform/browser.ts",
        "default": "./src/platform/node.ts"
      },
      "workerd": "./dist/platform/browser.js",
      "browser": "./dist/platform/browser.js",
      "worker": "./dist/platform/browser.js",
      "default": "./dist/platform/node.js"
    },
    "#safe-fs-platform-path": {
      "types": {
        "workerd": "./src/platform/browser-path.ts",
        "browser": "./src/platform/browser-path.ts",
        "worker": "./src/platform/browser-path.ts",
        "default": "./src/platform/node-path.ts"
      },
      "workerd": "./dist/platform/browser-path.js",
      "browser": "./dist/platform/browser-path.js",
      "worker": "./dist/platform/browser-path.js",
      "default": "./dist/platform/node-path.js"
    },
    "#safe-fs-s3-request": {
      "types": "./src/fs/s3/http/request-node.ts",
      "workerd": "./dist/fs/s3/http/request-fetch.js",
      "browser": "./dist/fs/s3/http/request-fetch.js",
      "worker": "./dist/fs/s3/http/request-fetch.js",
      "default": "./dist/fs/s3/http/request-node.js"
    }
  },
  "exports": {
    ".": {
      "types": {
        "workerd": "./dist/core.d.ts",
        "browser": "./dist/core.d.ts",
        "worker": "./dist/core.d.ts",
        "default": "./dist/index.d.ts"
      },
      "workerd": "./dist/core.js",
      "browser": "./dist/core.js",
      "worker": "./dist/core.js",
      "import": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "import": "./dist/contracts/index.js"
    },
    "./xml": {
      "types": "./dist/xml.d.ts",
      "import": "./dist/xml.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./testing/atomic": {
      "types": "./dist/testing/atomic-filesystem.d.ts",
      "workerd": "./dist/testing/atomic-filesystem.js",
      "browser": "./dist/testing/atomic-filesystem.js",
      "worker": "./dist/testing/atomic-filesystem.js",
      "import": "./dist/testing/atomic-filesystem.js"
    },
    "./testing/object-publication": {
      "types": "./dist/testing/object-publication.d.ts",
      "workerd": "./dist/testing/object-publication.js",
      "browser": "./dist/testing/object-publication.js",
      "worker": "./dist/testing/object-publication.js",
      "import": "./dist/testing/object-publication.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.js"
    },
    "./node/filesystem": {
      "types": {
        "workerd": "./dist/node-unavailable.d.ts",
        "browser": "./dist/node-unavailable.d.ts",
        "worker": "./dist/node-unavailable.d.ts",
        "default": "./dist/node/filesystem.d.ts"
      },
      "workerd": null,
      "browser": null,
      "worker": null,
      "import": "./dist/node/filesystem.js"
    },
    "./fs/memory": {
      "types": "./dist/fs/memory/index.d.ts",
      "import": "./dist/fs/memory/index.js"
    },
    "./fs/real": {
      "types": "./dist/fs/real/index.d.ts",
      "import": "./dist/fs/real/index.js"
    },
    "./fs/s3/http": {
      "types": "./dist/fs/s3/http/index.d.ts",
      "import": "./dist/fs/s3/http/index.js"
    },
    "./fs/s3": {
      "types": "./dist/fs/s3/index.d.ts",
      "import": "./dist/fs/s3/index.js"
    },
    "./fs/webdav": {
      "types": "./dist/fs/webdav/index.d.ts",
      "import": "./dist/fs/webdav/index.js"
    },
    "./fs/readonly": {
      "types": "./dist/fs/readonly/index.d.ts",
      "import": "./dist/fs/readonly/index.js"
    },
    "./fs/mount": {
      "types": "./dist/fs/mount/index.d.ts",
      "import": "./dist/fs/mount/index.js"
    },
    "./fs/overlay": {
      "types": "./dist/fs/overlay/index.d.ts",
      "import": "./dist/fs/overlay/index.js"
    },
    "./fs/quota": {
      "types": "./dist/fs/quota/index.d.ts",
      "import": "./dist/fs/quota/index.js"
    },
    "./contracts/object": {
      "types": "./dist/contracts/object.d.ts",
      "import": "./dist/contracts/object.js"
    },
    "./contracts/errors": {
      "types": "./dist/contracts/errors.d.ts",
      "import": "./dist/contracts/errors.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "PROVENANCE.json",
    "LICENSE"
  ],
  "devDependencies": {
    "node-api-headers": "1.9.0"
  },
  "scripts": {
    "build": "node ../../scripts/guard-package-dist.mjs && tsc -p tsconfig.json && node scripts/native-assets.mjs",
    "build:portable": "node ../../scripts/guard-package-dist.mjs && tsc -p tsconfig.json && node scripts/native-assets.mjs --portable",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:tests": "tsc -p tsconfig.tests.json --noEmit",
    "test:staging-native": "node --import tsx --test tests/integration/real-staging-hardlinks.test.mjs",
    "test:unit": "cd ../.. && vitest run packages/safe-fs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/poe-platform/poe-code.git",
    "directory": "packages/safe-fs"
  },
  "dependencies": {
    "@poe-code/xml-ast": "0.0.1",
    "@noble/hashes": "2.4.0"
  },
  "license": "MIT"
}
