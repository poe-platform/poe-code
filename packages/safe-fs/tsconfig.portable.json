{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "customConditions": ["browser"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": false,
    "noEmit": true,
    "types": []
  },
  "include": ["src/core.ts", "tests/helpers/*.ts", "tests/types/portable-policy.mts", "tests/types/portable-bridge.mts"]
}
