{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "../..",
    "baseUrl": ".",
    "noEmit": true,
    "lib": ["ES2024", "DOM", "DOM.Iterable", "DOM.AsyncIterable"],
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "types": ["node", "vitest/globals"],
    "paths": {
      "@poe-code/safe-fs": ["src/index.ts"],
      "@poe-code/safe-fs/*": ["src/*.ts", "src/*/index.ts"],
      "poe-code/safe-fs": ["src/index.ts"],
      "poe-code/safe-fs/core": ["src/core.ts"],
      "poe-code/safe-fs/node/filesystem": ["src/node/filesystem.ts"],
      "poe-code/safe-js/core": ["../safe-js/dist/core.d.ts"],
      "safe-bash-contracts": ["../safe-bash-contracts/src/index.ts"],
      "safe-bash-contracts/*": ["../safe-bash-contracts/src/*.ts", "../safe-bash-contracts/src/*"],
      "safe-bash-regex-engine": ["../safe-bash-regex-engine/src/index.ts"],
      "safe-bash-regex-engine/*": ["../safe-bash-regex-engine/src/*.ts", "../safe-bash-regex-engine/src/*"]
    }
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"],
  "exclude": []
}
