{
  "name": "@poe-code/safe-js",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "imports": {
    "#safe-fs-native-seek": {
      "types": "./dist/native/fs-seek/loader.d.ts",
      "workerd": null,
      "browser": null,
      "worker": null,
      "default": "./dist/native/fs-seek/loader.mjs"
    },
    "#safe-js-platform": {
      "types": {
        "workerd": "./dist/platform/workerd.d.ts",
        "browser": "./dist/platform/workerd.d.ts",
        "worker": "./dist/platform/workerd.d.ts",
        "default": "./dist/platform/node.d.ts"
      },
      "workerd": "./dist/platform/workerd.js",
      "browser": "./dist/platform/workerd.js",
      "worker": "./dist/platform/workerd.js",
      "default": "./dist/platform/node.js"
    },
    "#safe-js-atomic-wait": {
      "workerd": "./dist/platform/atomic-wait-workerd.js",
      "browser": "./dist/platform/atomic-wait-workerd.js",
      "worker": "./dist/platform/atomic-wait-workerd.js",
      "default": "./dist/platform/atomic-wait-node.js"
    }
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "poe-safejs": "dist/cli.js",
    "poe-safe-js": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": {
        "workerd": "./dist/workerd.d.ts",
        "browser": "./dist/core.d.ts",
        "worker": "./dist/core.d.ts",
        "default": "./dist/index.d.ts"
      },
      "workerd": "./dist/workerd.js",
      "browser": "./dist/core.js",
      "worker": "./dist/core.js",
      "poe-code-source": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "workerd": null,
      "browser": null,
      "import": "./dist/cli.js"
    },
    "./workerd": {
      "types": {
        "workerd": "./dist/workerd.d.ts",
        "browser": "./dist/node-unavailable.d.ts",
        "worker": "./dist/node-unavailable.d.ts",
        "default": "./dist/workerd.d.ts"
      },
      "workerd": "./dist/workerd.js",
      "browser": null,
      "worker": null,
      "import": "./dist/workerd.js"
    },
    "./modules/fs": {
      "types": "./dist/modules/fs.d.ts",
      "import": "./dist/modules/fs.js"
    }
  },
  "dependencies": {
    "@formatjs/bigdecimal": "0.2.7",
    "@formatjs/intl-durationformat": "0.10.18",
    "@formatjs/intl-localematcher": "0.8.13",
    "@formatjs/intl-numberformat": "9.4.0",
    "@formatjs/intl-pluralrules": "6.3.13",
    "@noble/hashes": "2.4.0",
    "@petamoriken/float16": "^3.9.3",
    "@poe-code/agent-spawn": "*",
    "@poe-code/frontmatter": "*",
    "@poe-code/safe-fs": "*",
    "temporal-polyfill": "1.0.4",
    "tiny-mcp-client": "*"
  },
  "scripts": {
    "build": "node ../../scripts/guard-package-dist.mjs && node scripts/numberformat-data.mjs && rm -rf dist && tsc && node scripts/numberformat-data.mjs --copy && node ../../scripts/set-bin-executable.mjs",
    "postbuild": "node --test scripts/built-imports.test.mjs",
    "example:experiment": "tsx src/cli.ts examples/experiment.md",
    "example:pipeline": "tsx src/cli.ts examples/pipeline.md",
    "example:superintendent": "tsx src/cli.ts examples/superintendent.md",
    "pretest": "node scripts/numberformat-data.mjs && npm run typecheck:fs",
    "test": "cd ../.. && vitest run packages/safe-js/src packages/safe-js/test",
    "pretest:unit": "node scripts/numberformat-data.mjs && npm run typecheck:fs && node scripts/run-sharded-unit-tests.mjs",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:adversarial": "cd ../.. && vitest run packages/safe-js/test/adversarial",
    "test:adversarial:slow": "cd ../.. && SAFEJS_ADVERSARIAL_SLOW=1 SAFEJS_PARSE_FUZZ=1 vitest run packages/safe-js/test/adversarial packages/safe-js/src/parse/fuzz.test.ts",
    "typecheck:contracts": "node scripts/check-fs-type-contract.mjs",
    "test:conformance": "tsx test/conformance/command.ts",
    "typecheck:fs": "node scripts/fs-type-contract.mjs",
    "test:workerd": "node --test scripts/workerd.test.mjs"
  },
  "files": [
    "dist",
    "examples"
  ],
  "devDependencies": {
    "cldr-units-full": "48.2.0"
  }
}
