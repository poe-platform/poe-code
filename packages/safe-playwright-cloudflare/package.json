{
  "name": "@poe-code/safe-playwright-cloudflare",
  "version": "0.0.0-dev",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../scripts/guard-package-dist.mjs && node --import tsx scripts/build-browser-run-code-guest.ts && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest:unit": "node --import tsx scripts/build-browser-run-code-guest.ts",
    "test:unit": "vitest run --config vitest.config.ts",
    "test": "npm run test:unit",
    "test:native": "vitest run --config vitest.native.config.ts",
    "test:workers": "vitest run --config vitest.workers.config.ts"
  },
  "devDependencies": {
    "@cloudflare/playwright": "1.3.6",
    "@cloudflare/vitest-pool-workers": "0.19.0",
    "@cloudflare/workers-types": "4.20260415.1",
    "@poe-platform/safe-bash": "*",
    "miniflare": "4.20260708.1"
  },
  "peerDependencies": {
    "@cloudflare/playwright": "1.3.6"
  },
  "peerDependenciesMeta": {
    "@cloudflare/playwright": {
      "optional": true
    }
  },
  "poeCode": {
    "safeLibraryNotices": {
      "safe-bash": ["./third-party/playwright/LICENSE", "./third-party/playwright/NOTICE"]
    },
    "safeLibraryExports": {
      "safe-bash": {
        "./playwright/cloudflare": "."
      }
    }
  }
}
