{
  "name": "@poe-code/safe-playwright-cloudflare",
  "version": "0.0.0-dev",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "workerd": "./dist/index.js",
      "browser": null,
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../scripts/guard-package-dist.mjs && node --import tsx scripts/build-browser-run-code-guest.ts && tsc -p tsconfig.json && cp src/browser-provider.generated.d.ts dist/browser-provider.generated.d.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest:unit": "node --import tsx scripts/build-browser-run-code-guest.ts",
    "test:unit": "vitest run --config vitest.config.ts",
    "test": "npm run test:unit",
    "test:native": "vitest run --config vitest.native.config.ts",
    "test:workers": "vitest run --config vitest.workers.config.ts"
  },
  "devDependencies": {
    "@cloudflare/playwright": "1.3.6",
    "@cloudflare/vitest-pool-workers": "0.19.0",
    "@cloudflare/workers-types": "4.20260415.1",
    "@poe-code/office-package": "*",
    "@poe-code/safe-fs": "*",
    "@poe-platform/safe-bash": "*",
    "miniflare": "4.20260708.1",
    "@jspm/core": "2.1.0",
    "memfs": "4.56.10"
  },
  "peerDependencies": {
    "@cloudflare/playwright": "1.3.6"
  },
  "peerDependenciesMeta": {
    "@cloudflare/playwright": {
      "optional": true
    }
  },
  "poeCode": {
    "safeLibraryNotices": {
      "safe-bash": [
        "./third-party/glob-to-regex.js/LICENSE",
        "./third-party/glob-to-regex.js/NOTICE",
        "./third-party/jsonjoy.com-base64/LICENSE",
        "./third-party/jsonjoy.com-base64/NOTICE",
        "./third-party/jsonjoy.com-buffers/LICENSE",
        "./third-party/jsonjoy.com-buffers/NOTICE",
        "./third-party/jsonjoy.com-fs-core/LICENSE",
        "./third-party/jsonjoy.com-fs-core/NOTICE",
        "./third-party/jsonjoy.com-fs-node/LICENSE",
        "./third-party/jsonjoy.com-fs-node/NOTICE",
        "./third-party/jsonjoy.com-fs-node-builtins/LICENSE",
        "./third-party/jsonjoy.com-fs-node-builtins/NOTICE",
        "./third-party/jsonjoy.com-fs-node-utils/LICENSE",
        "./third-party/jsonjoy.com-fs-node-utils/NOTICE",
        "./third-party/jsonjoy.com-fs-print/LICENSE",
        "./third-party/jsonjoy.com-fs-print/NOTICE",
        "./third-party/jsonjoy.com-fs-snapshot/LICENSE",
        "./third-party/jsonjoy.com-fs-snapshot/NOTICE",
        "./third-party/jsonjoy.com-json-pack/LICENSE",
        "./third-party/jsonjoy.com-json-pack/NOTICE",
        "./third-party/jspm-core/LICENSE",
        "./third-party/jspm-core/NOTICE",
        "./third-party/memfs/LICENSE",
        "./third-party/memfs/NOTICE",
        "./third-party/playwright/LICENSE",
        "./third-party/playwright/NOTICE",
        "./third-party/thingies/LICENSE",
        "./third-party/thingies/NOTICE",
        "./third-party/tree-dump/LICENSE",
        "./third-party/tree-dump/NOTICE",
        "./third-party/tslib/CopyrightNotice.txt",
        "./third-party/tslib/LICENSE.txt",
        "./third-party/tslib/NOTICE"
      ]
    },
    "safeLibraryExports": {
      "safe-bash": {
        "./playwright/cloudflare": "."
      }
    }
  },
  "imports": {
    "#safe-playwright-provider": {
      "types": "./dist/browser-provider.generated.d.ts",
      "workerd": "./dist/browser-provider.generated.js",
      "browser": "./dist/browser-provider.generated.js",
      "default": "./dist/browser-provider.generated.js"
    }
  }
}
