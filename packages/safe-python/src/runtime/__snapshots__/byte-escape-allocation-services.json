  "oracleDriver": "import sys, unicodedata, platform, warnings, io, contextlib, json\nsource = sys.stdin.read()\noutput = io.StringIO()\nwith warnings.catch_warnings(record=True) as caught, contextlib.redirect_stdout(output):\n    warnings.simplefilter('always')\n    exec(compile(source, 'escape-warning.py', 'exec'), {'__name__':'__main__'})\nprint(json.dumps({'reference': {'version':sys.version,'unicode':unicodedata.unidata_version,'platform':platform.platform(),'byteorder':sys.byteorder},'stdout':output.getvalue(),'warnings':[{'category':w.category.__name__,'message':str(w.message),'filename':w.filename,'line':w.lineno} for w in caught]}))\n",
  "adapter": "Explicit fs.writeSync complete writes and fs.fsyncSync output/warning adapters. Temporary descriptors closed and files removed in finally. Guest receives no filesystem capability.",
  "driver": "import {readFileSync, writeFileSync, openSync, closeSync, writeSync, fsyncSync, mkdtempSync, rmSync} from 'node:fs';\nimport {tmpdir} from 'node:os';\nimport {join} from 'node:path';\nimport {spawnSync} from 'node:child_process';\nimport assert from 'node:assert/strict';\nimport {PythonSession} from '/Users/kjopek/Workspace/poe-code-3/packages/safe-python/src/index.ts';\nconst root='/Users/kjopek/Workspace/poe-code-3/packages/safe-python/src/runtime/__snapshots__/';\nconst reference=JSON.parse(readFileSync(root+'byte-escape-warning-services.json','utf8'));\nconst cases=[];\nfor(const row of reference.cases){\n const response=spawnSync('/opt/homebrew/bin/python3.14',['-I','-c',reference.oracleDriver],{input:row.source,encoding:'utf8'});\n assert.equal(response.status,0);assert.equal(response.stderr,'');\n const oracle=JSON.parse(response.stdout);assert.deepEqual(oracle,row.oracle);\n const runs=[];\n for(const mode of ['normal','cancel-return','cancel-throw']){\n  const directory=mkdtempSync(join(tmpdir(),'codec-byte-adapter-'));\n  const outputPath=join(directory,'output'),warningPath=join(directory,'warning');\n  const output=openSync(outputPath,'w'),warning=openSync(warningPath,'w');\n  const controller=new AbortController();let writes=0,warnings=0,flushes=0;\n  const write=(fd:number,text:string)=>{const data=Buffer.from(text);let offset=0;while(offset<data.length){const count=writeSync(fd,data,offset,data.length-offset);assert.ok(count>0);offset+=count;}};\n  try{\n   const session=new PythonSession({hashSeed:[1n,2n],signal:controller.signal,\n    limits:{maxSteps:1000000,maxAllocatedBytes:16000000,maxDepth:100},\n    warning(value){warnings++;write(warning,JSON.stringify({category:value.category,message:value.message,filename:value.filename,line:value.position?.line})+'\\n');fsyncSync(warning);\n     if(mode!=='normal'){controller.abort();if(mode==='cancel-throw')throw Error('warning adapter cancelled');}},\n    output:{write(text){writes++;write(output,text);},flush(){flushes++;fsyncSync(output);}}\n   });\n   const result=session.exec(row.source,{filename:'escape-warning.py'});\n   const counts={writes,warnings,flushes};\n   let retries;\n   if(mode==='normal')assert.deepEqual(result,{status:'ok'});\n   else{\n    assert.equal(result.status,'terminated');assert.equal((result as any).reason,'cancelled');\n    const exec=session.exec(\"print('resumed')\"),evaluation=session.eval('1');\n    assert.equal(exec,result);assert.equal(evaluation,result);\n    assert.deepEqual({writes,warnings,flushes},counts);\n    assert.equal(warnings,1);assert.equal(writes,0);\n    retries={exec,evaluation,identical:true};\n   }\n   fsyncSync(output);\n   const stdout=readFileSync(outputPath,'utf8');\n   const recordedWarnings=readFileSync(warningPath,'utf8').trim().split('\\n').filter(Boolean).map(line=>JSON.parse(line));\n   if(mode==='normal'){assert.equal(stdout,oracle.stdout);assert.deepEqual(recordedWarnings,oracle.warnings);}\n   runs.push({mode,result,stdout,warnings:recordedWarnings,counts,retries});\n  }finally{closeSync(output);closeSync(warning);rmSync(directory,{recursive:true});}\n }\n cases.push({...row,oracle,runs});\n}\nwriteFileSync(root+'byte-escape-allocation-services.json',JSON.stringify({recordedAt:new Date().toISOString(),node:process.version,oracleDriver:reference.oracleDriver,adapter:'Explicit fs.writeSync complete writes and fs.fsyncSync output/warning adapters. Temporary descriptors closed and files removed in finally. Guest receives no filesystem capability.',driver:readFileSync('/tmp/codec-byte-allocation-services.ts','utf8'),cases},null,2)+'\\n');\nconsole.log(JSON.stringify({cases:cases.length,runs:cases.reduce((n,row)=>n+row.runs.length,0)}));\n",
