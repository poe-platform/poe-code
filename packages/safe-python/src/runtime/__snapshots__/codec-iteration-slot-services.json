  "driver": "import {readFileSync,writeFileSync,openSync,closeSync,readSync,writeSync,fsyncSync,mkdtempSync,rmSync} from 'node:fs';\nimport {tmpdir} from 'node:os';\nimport {join} from 'node:path';\nimport {createHash} from 'node:crypto';\nimport {PythonSession} from '/Users/kjopek/Workspace/poe-code-3/packages/safe-python/src/index.ts';\nimport {codecIterationSlotCases} from '/Users/kjopek/Workspace/poe-code-3/packages/safe-python/src/codec-iteration-slot-cases.ts';\nconst root='/Users/kjopek/Workspace/poe-code-3/packages/safe-python/src/';\nconst raw=readFileSync(root+'runtime/__snapshots__/codec-iteration-slot-oracle.json','utf8'),oracle=JSON.parse(raw);\nconst dir=mkdtempSync(join(tmpdir(),'codec-iteration-'));\nconst rows=[],cancelled=[]; let reads=0,writes=0,flushes=0;\ntry {\nfor(const row of codecIterationSlotCases){\n const expected=oracle.rows.find(item=>item.name===row.name);\n writeFileSync(join(dir,'in'),'ready\\n');\n const input=openSync(join(dir,'in'),'r'),output=openSync(join(dir,'out'),'w');\n const session=new PythonSession({limits:{maxSteps:1000000,maxAllocatedBytes:16000000,maxDepth:100},hashSeed:[1n,2n],\n  input:{readLine(){reads++;const data=Buffer.alloc(64);return data.subarray(0,readSync(input,data)).toString('utf8');}},\n  output:{write(text){writes++;writeSync(output,text);},flush(){flushes++;fsyncSync(output);}}});\n let outcome;\n try{outcome=session.exec(row.source);}finally{closeSync(input);closeSync(output);}\n const stdout=readFileSync(join(dir,'out'),'utf8');\n const match=outcome.status==='ok'&&stdout===expected.stdout&&row.source===expected.source;\n rows.push({name:row.name,sourceSha256:createHash('sha256').update(row.source).digest('hex'),outcome,stdout,usage:session.usage,match});\n}\nfor(const row of codecIterationSlotCases.slice(-2))for(const throws of [false,true]){\n writeFileSync(join(dir,'in'),'ready\\n');const input=openSync(join(dir,'in'),'r'),output=openSync(join(dir,'out'),'w');\n const controller=new AbortController