  "driver": "import {execFileSync} from 'node:child_process';\nimport {writeFileSync} from 'node:fs';\nimport {decodePunycode,encodePunycode} from '/Users/kjopek/Workspace/poe-code-3/packages/safe-python/src/runtime/punycode.ts';\nimport {CodePointString} from '/Users/kjopek/Workspace/poe-code-3/packages/safe-python/src/runtime/code-point-string.ts';\nconst rows:any[]=[];let seed=147;\nconst next=()=>{seed^=seed<<13;seed^=seed>>>17;seed^=seed<<5;return seed>>>=0;};\nconst alphabet=[0,9,10,13,32,45,47,48,57,65,90,97,122,127,128,255];\nfor(let i=0;i<20000;i++){const data=[];for(let j=0;j<i%40;j++)data.push(i%2?next()%256:alphabet[next()%alphabet.length]);rows.push(['decode',data,['strict','replace','ignore'][i%3]]);}\nfor(let i=0;i<10000;i++){const points=[];for(let j=0;j<i%30;j++)points.push(i%3===0?[0,45,65,127,128,255,0xd800,0xdfff,0xffff,0x10000,0x10ffff][next()%11]:i%3===1?next()%256:next()%0x110000);rows.push(['encode',points,'strict']);}\nconst program=`import codecs,json,sys,unicodedata\nassert sys.version_info[:3]==(3,14,7)\nassert unicodedata.unidata_version=='16.0.0'\nrows=json.load(sys.stdin);out=[]\nfor op,data,policy in rows:\n try:\n  r=codecs.decode(bytes(data),'punycode',policy) if op=='decode' else codecs.encode(''.join(map(chr,data)),'punycode')\n  out.append(['ok',list(map(ord,r)) if op=='decode' else list(r)])\n except UnicodeDecodeError as e:out.append(['decode',e.encoding,list(e.object),str(e.start),str(e.end),e.reason])\n except Exception as e:out.append([type(e).__name__,str(e)])\nprint(json.dumps({'oracle':sys.version,'unicode':unicodedata.unidata_version,'platform':sys.platform,'out':out}))`;\nconst reference=JSON.parse(execFileSync('/opt/homebrew/bin/python3.14',['-c',program],{input:JSON.stringify(rows),encoding:'utf8',maxBuffer:30*1024*1024}));\nlet failures=0;\nfor(let i=0;i<rows.length;i++){const [op,data,policy]=rows[i];let actual;\ntry{actual=['ok',[...(op==='decode'?decodePunycode(Uint8Array.from(data),policy):encodePunycode(new CodePointString(Uint32Array.from(data))))]];}\ncatch(e:any){actual=e.encoding?['decode',e.encoding,[...e.object],String(e.start),String(e.end),e.reason]:[e.pythonType??e.name,e.message];}\nif(JSON.stringify(actual)!==JSON.stringify(reference.out[i])){if(failures++<10)console.log(JSON.stringify({i,row:rows[i],actual,expected:reference.out[i]}));}}\nconsole.log({cases:rows.length,failures,oracle:reference.oracle});\nwriteFileSync('/tmp/codec-punycode-user-reference.json',JSON.stringify({program,rows,...reference}));\n"
