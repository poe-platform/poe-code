  "driver": "import {spawnSync} from 'node:child_process';\nimport {writeFileSync,readFileSync} from 'node:fs';\nimport {decodeUtf7} from '/Users/kjopek/Workspace/poe-code-3/packages/safe-python/src/runtime/utf7.ts';\nimport {CodePointString} from '/Users/kjopek/Workspace/poe-code-3/packages/safe-python/src/runtime/code-point-string.ts';\nimport {PythonDecodeError} from '/Users/kjopek/Workspace/poe-code-3/packages/safe-python/src/runtime/decode-error.ts';\nlet state=13147;const random=()=>{state^=state<<13;state^=state>>>17;state^=state<<5;return state>>>0;};\nconst alphabet=[43,45,65,66,47,90,97,32,0,128,255];\nconst cases=Array.from({length:10000},(_,i)=>({final:!!(i%2),input:Array.from({length:random()%20},()=>alphabet[random()%alphabet.length]),replacement:Array.from({length:random()%20},()=>alphabet[random()%alphabet.length]),position:0}));\nfor(const [i,c] of cases.entries()){c.position=random()%(c.replacement.length+1);if(i%2&&c.position<c.replacement.length)c.position-=c.replacement.length;}\nconst source=`import sys,json,_codecs,unicodedata\nassert sys.version_info[:3]==(3,14,7)\nassert unicodedata.unidata_version=='16.0.0'\nfor c in json.load(sys.stdin):\n events=[]\n def recover(e):\n  events.append([e.encoding,list(e.object),e.start,e.end,e.reason])\n  if len(events)>1: raise e\n  e.object=bytes(c['replacement'])\n  return ('?',c['position'])\n _codecs.register_error('review',recover)\n try:\n  t,n=_codecs.utf_7_decode(bytes(c['input']),'review',c['final'])\n  r={'result':[list(map(ord,t)),n]}\n except UnicodeDecodeError as e:r={'error':[e.encoding,list(e.object),e.start,e.end,e.reason]}\n r['events']=events\n print(json.dumps(r))\n`;\nconst p=spawnSync('/opt/homebrew/bin/python3.14',['-I','-c',source],{input:JSON.stringify(cases),encoding:'utf8',maxBuffer:32000000});if(p.status)throw Error(p.stderr);\nconst expected=p.stdout.trim().split('\\n').map(line=>JSON.parse(line)),failures=[];\nfor(const [i,c] of cases.entries()){const events=[];let actual;const