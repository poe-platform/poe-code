  "oracleSource": "import codecs, hashlib, json, struct, sys, unicodedata\nassert sys.version_info[:3] == (3, 14, 7)\nassert unicodedata.unidata_version == '16.0.0'\nassert sys.platform == 'darwin' and sys.byteorder == 'little'\n\ndef digest(rows):\n    h = hashlib.sha256()\n    for row in rows:\n        h.update((json.dumps(row, separators=(',', ':'), ensure_ascii=True) + '\\n').encode())\n    return h.hexdigest()\n\ndef failure(e):\n    return ['error', e.encoding, list(e.object), e.start, e.end, e.reason]\n\ndef encodings(start=0, end=0x110000):\n    for point in range(start, end):\n        try:\n            yield ['ok', list(chr(point).encode('euc_kr'))]\n        except UnicodeEncodeError as e:\n            yield ['error', e.encoding, list(map(ord,e.object)), e.start, e.end, e.reason]\nplanes=[];whole=hashlib.sha256()\nfor plane in range(17):\n h=hashlib.sha256();partitions=[]\n for block in range(16):\n  part=hashlib.sha256();count=0\n  for row in encodings(plane*0x10000+block*4096,plane*0x10000+(block+1)*4096):\n   data=(json.dumps(row,separators=(',',':'),ensure_ascii=True)+'\\n').encode()\n   whole.update(data);h.update(data);part.update(data);count+=1\n  partitions.append(dict(block=block,records=count,sha256=part.hexdigest()))\n planes.append(dict(plane=plane,sha256=h.hexdigest(),partitions=partitions))\nprint(json.dumps(dict(reference=dict(version=sys.version,unicode=unicodedata.unidata_version,platform=sys.platform,byteorder=sys.byteorder),records=0x110000,sha256=whole.hexdigest(),planes=planes),indent=2))\n"
