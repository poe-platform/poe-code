  "oracleSource": "import codecs,sys,unicodedata,hashlib,json,itertools,platform\nassert sys.version_info[:3] == (3,14,7)\nassert unicodedata.unidata_version == '16.0.0'\ndef attempt(f):\n try:\n  result=f()\n  return ['ok', list(result) if isinstance(result,bytes) else list(map(ord,result))]\n except (UnicodeEncodeError,UnicodeDecodeError) as e:\n  return ['error', list(e.object) if isinstance(e.object,bytes) else list(map(ord,e.object)),e.start,e.end,e.reason]\ndef add(h,row): h.update((json.dumps(row,separators=(',',':'),ensure_ascii=True)+'\\n').encode('ascii'))\nresults=[]\nfor policy in ('strict','ignore','replace'):\n for mode in (0,1,2):\n  whole=hashlib.sha256();partitions=[]\n  for block in range(16):\n   h=hashlib.sha256();count=0\n   for a in range(block*16,(block+1)*16):\n    for b in range(256):\n     d=codecs.getincrementaldecoder('hz')(policy);d.setstate((b'',0x123400+mode))\n     row=[]\n     for chunk,final in [(bytes([a]),False),(bytes([b]),False),(b'',True),(b'~}A',True)]:\n      row.append(attempt(lambda:d.decode(chunk,final)))\n      pending,state=d.getstate();row.append([list(pending),str(state)])\n     add(h,row);add(whole,row);count+=1\n   partitions.append(dict(block=block,count=count,digest=h.hexdigest()))\n  results.append(dict(kind='decode',policy=policy,mode=mode,count=sum(part['count'] for part in partitions),digest=whole.hexdigest(),partitions=partitions))\nprint(json.dumps(dict(reference=dict(version=sys.version,unicode=unicodedata.unidata_version,byteorder=sys.byteorder),results=results),indent=2))\n"
