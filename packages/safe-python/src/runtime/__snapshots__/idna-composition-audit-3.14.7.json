  "source": "import sys,json,unicodedata,encodings.idna as codec\nassert sys.version_info[:3] == (3,14,7)\nassert unicodedata.unidata_version == '16.0.0'\nseed=0x147160\nstate=seed\ndef random():\n global state\n state ^= (state << 13) & 0xffffffff\n state ^= state >> 17\n state ^= (state << 5) & 0xffffffff\n state &= 0xffffffff\n return state\nfragments=[[65],[97],[46],[0x3002],[0xff0e],[0xff61],[0xad],[0xdf],[0x130],[0x1e9e],[0x5d0],[0x627],[0x301],[0x323],[0x345],[0x200c],[0x200d],[0x202e],[0xd800],[0xdc00],[0x1f600],[0x10ffff],[0x212b],[0x338],[0x034f],[0x1d400],[0x3164],[0x115f],[0x1100],[0x1161],[0x11a8],[0x33c6],[120,110,45,45],[98,99,104,101,114,45,107,118,97]]\ndef fault(e):\n r={'name':type(e).__name__,'message':str(e),'suppressContext':e.__suppress_context__}\n if isinstance(e,(UnicodeEncodeError,UnicodeDecodeError)):\n  r.update(encoding=e.encoding,object=list(map(ord,e.object)) if isinstance(e.object,str) else list(e.object),start=str(e.start),end=str(e.end),reason=e.reason)\n if e.__context__ is not None:r['context']=fault(e.__context__)\n return r\nrows=[]\nfor i in range(1000):\n points=[]\n for j in range(random()%8):points.extend(fragments[random()%len(fragments)])\n text=''.join(map(chr,points))\n for op in ['prepare','label','domain','buffer_false','buffer_true','unicode']:\n  row={'operation':op,'input':points}\n  try:\n   if op=='prepare':result=codec.nameprep(text)\n   elif op=='label':result=codec.ToASCII(text)\n   elif op=='domain':result,consumed=codec.Codec().encode(text)\n   elif op=='unicode':result=codec.ToUnicode(text)\n   else:result,consumed=codec.IncrementalEncoder()._buffer_encode(text,'strict',op=='buffer_true')\n   row['result']=list(map(ord,result)) if isinstance(result,str) else list(result)\n   if op in ['domain','buffer_false','buffer_true']:row['consumed']=consumed\n  except Exception as e:row['error']=fault(e)\n  rows.append(row)\nprint(json.dumps({'oracle':{'version':sys.version,'unicode':unicodedata.unidata_version,'platform':sys.platform,'byteorder':sys.byteorder},'seed':seed,'fragments':fragments,'cases':rows},ensure_ascii=True))\n",
