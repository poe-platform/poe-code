  "oracleSource": "import hashlib\nimport json\nfrom pathlib import Path\n\nbase = Path('packages/safe-python/src/runtime/__snapshots__')\noracle = json.loads((base / 'johab-kernel-oracle.json').read_text())\nnamespace = {}\nexec(oracle['oracleSource'].split('\\nresult = {', 1)[0], namespace)\nreference = namespace['sys']\nresult = {'reference': {'version': reference.version, 'unicode': namespace['unicodedata'].unidata_version,\n                        'platform': reference.platform, 'byteorder': reference.byteorder}, 'incremental': {}}\nfor errors in ('strict', 'ignore', 'replace'):\n    total = hashlib.sha256()\n    parts = []\n    for block in range(16):\n        part = hashlib.sha256()\n        count = 0\n        for first in range(block * 16, (block + 1) * 16):\n            for second in range(256):\n                for final in (False, True):\n                    row = namespace['split_row'](bytes([first, second]), 1, final, errors)\n                    data = (json.dumps(row, separators=(',', ':'), ensure_ascii=True) + '\\n').encode()\n                    total.update(data)\n                    part.update(data)\n                    count += 1\n        parts.append({'block': block, 'records': count, 'sha256': part.hexdigest()})\n    assert total.hexdigest() == oracle['incremental'][errors]['sha256']\n    assert sum(part['records'] for part in parts) == oracle['incremental'][errors]['records']\n    result['incremental'][errors] = {**oracle['incremental'][errors], 'partitions': parts}\nresult['oracleSource'] = Path(__file__).read_text()\n(base / 'johab-incremental-partitions-3.14.7.json').write_text(json.dumps(result, indent=2) + '\\n')\n"
