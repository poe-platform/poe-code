  "driver": "import builtins, codecs, json, platform, sys, unicodedata\nassert sys.version_info[:3] == (3,14,7)\nassert unicodedata.unidata_version == '16.0.0'\nactive = None\ndef decode(data, errors='strict'):\n    if isinstance(active, str):\n        codecs.lookup_error(active)\n    raise active\ndef search(name):\n    if name == 'native_fault':\n        return codecs.CodecInfo(name=name, encode=None, decode=decode)\ncodecs.register(search)\ncases=[]\nfor name in ['ValueError','UnicodeError','LookupError','IndexError','KeyError','TypeError','RuntimeError','OverflowError','MemoryError','OSError']:\n    for message in [None, '', 'decoder fault', \"a'b\\\"c\\\\\\n\\x00\", '\u00e9\ud83d\ude00\\ud800\\u200b']:\n        for mode in ['exec','eval']:\n            active=getattr(builtins,name)(*(() if message is None else (message,)))\n            try:\n                compile(b'# coding: native-fault\\n1', 'native-fault.py', mode)\n            except BaseException as error:\n                expected={'type':type(error).__name__, 'message':error.msg if isinstance(error,SyntaxError) else str(error)}\n                if isinstance(error,SyntaxError):\n                    expected.update(filename=error.filename,line=error.lineno,column=error.offset-1,endLine=error.end_lineno,endColumn=error.end_offset,text=error.text)\n                cases.append(dict(name=name,message=message,mode=mode,expected=expected))\nfor handler in ['', 'missing-source-handler', \"missing'handler\", '\u00e9\ud83d\ude00']:\n    for mode in ['exec', 'eval']:\n        active=handler\n        try:\n            compile(b'# coding: native-fault\\n1', 'native-fault.py', mode)\n        except SyntaxError as error:\n            cases.append(dict(name='handler', message=handler, mode=mode, expected=dict(type='SyntaxError',message=error.msg,filename=error.filename,line=error.lineno,column=error.offset-1,endLine=error.end_lineno,endColumn=error.end_offset,text=error.text)))\nprint(json.dumps(dict(version=sys.version,unicode=unicodedata.unidata_version,platform=platform.platform(),driver=open(__file__).read(),cases=cases),ensure_ascii=True,indent=2))\n",
