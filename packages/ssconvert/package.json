{
  "name": "@poe-code/ssconvert",
  "version": "0.0.1",
  "private": true,
  "license": "GPL-2.0-or-later",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "src/encoding/LGPL-2.1.txt",
    "src/encoding/NOTICE.md",
    "src/encoding/tables.ts",
    "src/encoding/transliteration-tables.ts",
    "src/encoding/target-transliteration-tables.ts",
    "src/encoding/ucs2-transliteration-tables.ts",
    "src/codecs/html-NOTICE.md",
    "src/codecs/legacy-binary-NOTICE.md",
    "src/rendering/print/NOTICE.md",
    "src/formulas/functions/captured-acos-NOTICE.md",
    "src/formulas/functions/captured-acos.ts",
    "src/formulas/functions/captured-acos-profile.ts"
  ],
  "scripts": {
    "build": "node scripts/generate-providers.mjs && node ../../scripts/guard-package-dist.mjs && tsc && node scripts/bundle.mjs",
    "test:unit": "node scripts/generate-providers.mjs && cd ../.. && vitest run packages/ssconvert/src",
    "test": "node scripts/generate-providers.mjs && cd ../.. && vitest run packages/ssconvert/src",
    "lint": "node scripts/generate-providers.mjs && eslint src && tsc --noEmit && tsc -p tsconfig.test.json && tsc -p tsconfig.consumer.json"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "@pdf-lib/fontkit": "1.1.1",
    "@poe-code/office-package": "*",
    "@poe-code/pdf": "*",
    "@poe-code/safe-fs": "*",
    "htmlparser2": "^10.0.0",
    "jpeg-js": "0.4.4",
    "pdf-lib": "1.17.1"
  }
}
