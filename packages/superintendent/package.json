{
  "name": "@poe-code/superintendent",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "poe-superintendent-mcp": "dist/mcp.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "import": "./dist/mcp.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/guard-package-dist.mjs && tsc && node scripts/copy-templates.mjs",
    "test": "cd ../.. && vitest run packages/superintendent/src/",
    "test:unit": "cd ../.. && vitest run packages/superintendent/src/"
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@poe-code/frontmatter": "*",
    "@poe-code/agent-defs": "*",
    "@poe-code/agent-harness-tools": "*",
    "@poe-code/agent-skill-config": "*",
    "@poe-code/agent-spawn": "*",
    "@poe-code/braintrust": "*",
    "@poe-code/config-extends": "*",
    "toolcraft": "*",
    "toolcraft-design": "*",
    "@poe-code/poe-agent": "*",
    "@poe-code/poe-code-config": "*",
    "@poe-code/worktree": "*"
  }
}
