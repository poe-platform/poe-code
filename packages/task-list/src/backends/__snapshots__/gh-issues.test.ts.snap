exports[`ghIssuesBackend > get("404") throws TaskNotFoundError when the issue does not exist 1`] = `
{
  "query": "query Issue($owner: String!, $repo: String!, $number: Int!) {
  repository(owner: $owner, name: $repo) {
    issue(number: $number) {
      number
      title
      body
      url
      createdAt
      labels(first: 50) { nodes { name } }
      assignees(first: 20) { nodes { login } }
      milestone { title }
      projectItems(first: 10) {
        nodes {
          id
          project { id }
          fieldValueByName(name: "Status") {
            ... on ProjectV2ItemFieldSingleSelectValue {
              name
            }
          }
        }
      }
    }
  }
}",
  "variables": {
    "number": 404,
    "owner": "octo",
    "repo": "repo",
  },
}
`;

