exports[`ghIssuesBackend > create fetches the repository id lazily and caches it for later creates 1`] = `
[
  {
    "query": "mutation CreateIssue($input: CreateIssueInput!) {
  createIssue(input: $input) {
    issue {
      id
      number
    }
  }
}",
    "variables": {
      "input": {
        "body": "",
        "repositoryId": "repo-node",
        "title": "First issue",
      },
    },
  },
  {
    "query": "mutation AddProjectItem($input: AddProjectV2ItemByIdInput!) {
  addProjectV2ItemById(input: $input) {
    item {
      id
    }
  }
}",
    "variables": {
      "input": {
        "contentId": "issue-node-101",
        "projectId": "project-id",
      },
    },
  },
  {
    "query": "mutation UpdateProjectItemStatus($input: UpdateProjectV2ItemFieldValueInput!) {
  updateProjectV2ItemFieldValue(input: $input) {
    projectV2Item {
      id
    }
  }
}",
    "variables": {
      "input": {
        "fieldId": "status-field",
        "itemId": "item-101",
        "projectId": "project-id",
        "value": {
          "singleSelectOptionId": "status-todo",
        },
      },
    },
  },
  {
    "query": "mutation CreateIssue($input: CreateIssueInput!) {
  createIssue(input: $input) {
    issue {
      id
      number
    }
  }
}",
    "variables": {
      "input": {
        "body": "",
        "repositoryId": "repo-node",
        "title": "Second issue",
      },
    },
  },
  {
    "query": "mutation AddProjectItem($input: AddProjectV2ItemByIdInput!) {
  addProjectV2ItemById(input: $input) {
    item {
      id
    }
  }
}",
    "variables": {
      "input": {
        "contentId": "issue-node-102",
        "projectId": "project-id",
      },
    },
  },
  {
    "query": "mutation UpdateProjectItemStatus($input: UpdateProjectV2ItemFieldValueInput!) {
  updateProjectV2ItemFieldValue(input: $input) {
    projectV2Item {
      id
    }
  }
}",
    "variables": {
      "input": {
        "fieldId": "status-field",
        "itemId": "item-102",
        "projectId": "project-id",
        "value": {
          "singleSelectOptionId": "status-todo",
        },
      },
    },
  },
]
`;

