exports[`ghIssuesBackend > keeps the project GraphQL request wire shape stable 1`] = `
{
  "query": "query Project($owner: String!, $number: Int!) {
  organization(login: $owner) {
    projectV2(number: $number) {
      id
      title
      field(name: "Status") {
        ... on ProjectV2SingleSelectField {
          id
          options { id name }
        }
      }
    }
  }
}",
  "variables": {
    "number": 7,
    "owner": "octo-org",
  },
}
`;

exports[`ghIssuesBackend > update uses the issue id cached by create 1`] = `
[
  {
    "query": "mutation CreateIssue($input: CreateIssueInput!) {
  createIssue(input: $input) {
    issue {
      id
      number
    }
  }
}",
    "variables": {
      "input": {
        "body": "",
        "repositoryId": "repo-node",
        "title": "Original",
      },
    },
  },
  {
    "query": "mutation AddProjectItem($input: AddProjectV2ItemByIdInput!) {
  addProjectV2ItemById(input: $input) {
    item {
      id
    }
  }
}",
    "variables": {
      "input": {
        "contentId": "issue-node-573",
        "projectId": "project-id",
      },
    },
  },
  {
    "query": "mutation UpdateProjectItemStatus($input: UpdateProjectV2ItemFieldValueInput!) {
  updateProjectV2ItemFieldValue(input: $input) {
    projectV2Item {
      id
    }
  }
}",
    "variables": {
      "input": {
        "fieldId": "status-field",
        "itemId": "item-573",
        "projectId": "project-id",
        "value": {
          "singleSelectOptionId": "status-todo",
        },
      },
    },
  },
  {
    "query": "mutation UpdateIssue($input: UpdateIssueInput!) {
  updateIssue(input: $input) {
    issue {
      id
    }
  }
}",
    "variables": {
      "input": {
        "id": "issue-node-573",
        "title": "Renamed",
      },
    },
  },
]
`;

