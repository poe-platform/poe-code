{
  "name": "terminal-pilot-mcp",
  "version": "0.0.1",
  "description": "MCP server that exposes terminal pilot automation as tools.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "terminal-pilot-mcp": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
