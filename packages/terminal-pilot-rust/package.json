{
  "name": "terminal-pilot-rust",
  "version": "0.1.0",
  "private": true,
  "description": "Portable Rust terminal display and automation with native Node bindings",
  "type": "module",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./commands": {
      "types": "./dist/commands.d.ts",
      "import": "./dist/commands.js"
    }
  },
  "scripts": {
    "build": "node scripts/prepare-host.mjs && node ../mcp-protocol-rust/scripts/cargo.mjs build",
    "test:unit": "node scripts/prepare-host.mjs && node ../mcp-protocol-rust/scripts/cargo.mjs test && tsc --project tsconfig.types.json && cd ../.. && vitest run --config packages/terminal-pilot-rust/vitest.sdk.config.mjs",
    "lint": "node ../mcp-protocol-rust/scripts/cargo.mjs lint"
  },
  "devDependencies": {
    "@napi-rs/cli": "3.10.4",
    "mcp-protocol-rust": "*",
    "terminal-png-rust": "*",
    "terminal-pilot": "*",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "terminal-pilot-mcp": "*",
    "toolcraft-schema-rust": "*"
  },
  "files": [
    "dist",
    "LICENSE",
    "LICENSE.FONT",
    "LICENSE.UNICODE"
  ],
  "engines": {
    "node": ">=18.18"
  },
  "napi": {
    "binaryName": "terminal-pilot-rust"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/poe-platform/poe-code.git",
    "directory": "packages/terminal-pilot-rust"
  }
}
