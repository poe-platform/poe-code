    {
      "kind": "command",
      "name": "wait-for",
      "description": "Wait for terminal output to match a pattern",
      "hidden": false,
      "examples": [],
      "aliases": [],
      "positional": [
        "pattern"
      ],
      "params": {
        "kind": "object",
        "shape": {
          "pattern": {
            "kind": "string",
            "description": "Regular expression pattern to wait for",
            "minLength": 1,
            "pattern": "\\S"
          },
          "session": {
            "kind": "optional",
            "inner": {
              "kind": "string",
              "short": "s",
              "description": "Session name",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "timeout": {
            "kind": "optional",
            "inner": {
              "kind": "number",
              "short": "t",
              "description": "Maximum wait time in milliseconds",
              "minimum": 0
            }
          },
          "scope": {
            "kind": "optional",
            "inner": {
              "kind": "enum",
              "values": [
                "history",
                "screen"
              ],
              "description": "Search all captured output or only the current visible screen"
            }
          },
          "literal": {
            "kind": "optional",
            "inner": {
              "kind": "boolean",
              "short": "l",
              "description": "When true, treat pattern as a literal string instead of a regex"
            }
          }
        }
