{
  "name": "terminal-pilot",
  "version": "0.0.1",
  "description": "Playwright-like SDK and CLI for automating interactive CLI apps through a real PTY",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "terminal-pilot": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    },
    "./commands": {
      "types": "./dist/commands/index.d.ts",
      "import": "./dist/commands/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc --emitDeclarationOnly && node scripts/build.mjs",
    "prepack": "node ../../scripts/set-bin-executable.mjs && node ../../scripts/manage-bundled-workspace-deps.mjs prepare . @poe-code/agent-skill-config @poe-code/agent-defs @poe-code/config-mutations @poe-code/user-error toolcraft-design @poe-code/frontmatter fast-string-width fast-wrap-ansi jsonc-parser sisteransi smol-toml yaml",
    "postpack": "node ../../scripts/manage-bundled-workspace-deps.mjs cleanup . @poe-code/agent-skill-config @poe-code/agent-defs @poe-code/config-mutations @poe-code/user-error toolcraft-design @poe-code/frontmatter fast-string-width fast-wrap-ansi jsonc-parser sisteransi smol-toml yaml",
    "test": "cd ../.. && vitest run packages/terminal-pilot/src/",
    "test:unit": "cd ../.. && vitest run packages/terminal-pilot/src/",
    "qa:cli": "cd ../.. && tsx packages/terminal-pilot/src/testing/qa-cli.ts",
    "prepublishOnly": "rm -rf dist && tsc --emitDeclarationOnly && node scripts/build.mjs",
    "install-local-package": "TMPD=$(mktemp -d) && npm pack --pack-destination $TMPD && npm install -g $TMPD/terminal-pilot-*.tgz && rm -rf $TMPD",
    "smoke": "cd ../.. && tsx packages/terminal-pilot/scripts/smoke-test.ts",
    "smoke:verbose": "cd ../.. && tsx packages/terminal-pilot/scripts/smoke-test.ts --verbose"
  },
  "files": [
    "LICENSE",
    "dist",
    "assets"
  ],
  "engines": {
    "node": ">=18.18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/poe-platform/poe-code.git",
    "directory": "packages/terminal-pilot"
  },
  "license": "MIT",
  "keywords": [
    "terminal",
    "pty",
    "headless"
  ],
  "dependencies": {
    "@poe-code/agent-skill-config": "*",
    "@resvg/resvg-js": "^2.6.2",
    "commander": "^13.1.0",
    "fast-string-width": "^3.0.2",
    "fast-wrap-ansi": "^0.2.0",
    "jetbrains-mono": "^1.0.6",
    "jose": "^6.1.2",
    "jsonc-parser": "^3.3.1",
    "node-pty": "^1.1.0",
    "sisteransi": "^1.0.5",
    "smol-toml": "^1.6.0",
    "terminal-png": "^0.1.0",
    "toolcraft": "^0.0.51",
    "yaml": "^2.8.2"
  },
  "bundleDependencies": [
    "@poe-code/agent-skill-config",
    "@poe-code/agent-defs",
    "@poe-code/config-mutations",
    "@poe-code/user-error",
    "toolcraft-design",
    "@poe-code/frontmatter",
    "fast-string-width",
    "fast-wrap-ansi",
    "jsonc-parser",
    "sisteransi",
    "smol-toml",
    "yaml"
  ],
  "optionalDependencies": {
    "@poe-code/agent-defs": "*",
    "@poe-code/config-mutations": "*",
    "@poe-code/user-error": "*",
    "toolcraft-design": "*",
    "@poe-code/frontmatter": "*"
  },
  "devDependencies": {
    "toolcraft-schema": "*"
  }
}
