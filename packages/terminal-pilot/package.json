{
  "name": "terminal-pilot",
  "version": "0.0.1",
  "description": "Playwright-like SDK for automating interactive CLI apps through a real PTY",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "tsc",
    "install-local-package": "TMPD=$(mktemp -d) && npm pack --pack-destination $TMPD && npm install -g $TMPD/terminal-pilot-*.tgz && rm -rf $TMPD"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/poe-platform/poe-code.git",
    "directory": "packages/terminal-pilot"
  },
  "license": "MIT",
  "keywords": [
    "terminal",
    "pty",
    "headless"
  ],
  "dependencies": {
    "node-pty": "^1.1.0"
  },
  "devDependencies": {}
}
