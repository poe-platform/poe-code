{
  "name": "terminal-png-mcp-rust",
  "version": "0.1.0",
  "private": true,
  "description": "Independent Rust MCP terminal PNG tool with a standalone native addon",
  "type": "module",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    }
  },
  "bin": {
    "terminal-png-mcp-rust": "dist/cli.js"
  },
  "scripts": {
    "build": "node scripts/prepare-host.mjs && node ../mcp-protocol-rust/scripts/cargo.mjs build",
    "test:unit": "node scripts/prepare-host.mjs && node ../mcp-protocol-rust/scripts/cargo.mjs test && tsc --project tsconfig.types.json && cd ../.. && vitest run --config packages/terminal-png-mcp-rust/vitest.sdk.config.mjs",
    "lint": "node ../mcp-protocol-rust/scripts/cargo.mjs lint",
    "prepack": "node ../../scripts/set-bin-executable.mjs"
  },
  "devDependencies": {
    "@napi-rs/cli": "3.10.4",
    "mcp-protocol-rust": "*",
    "tiny-stdio-mcp-server-rust": "*",
    "terminal-png-rust": "*",
    "terminal-png-mcp": "*",
    "tiny-stdio-mcp-server": "*",
    "@modelcontextprotocol/sdk": "1.29.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "files": [
    "dist",
    "LICENSE",
    "LICENSE.FONT",
    "LICENSE.UNICODE"
  ],
  "engines": {
    "node": ">=18.18"
  },
  "napi": {
    "binaryName": "terminal-png-mcp-rust"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/poe-platform/poe-code.git",
    "directory": "packages/terminal-png-mcp-rust"
  }
}
