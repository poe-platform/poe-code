  "description": "Render PNG images from ANSI terminal output.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": "./dist/index.js",
  "bin": {
    "terminal-png": "./bin/terminal-png"
  },
  "scripts": {
    "build": "node ../../scripts/guard-package-dist.mjs && tsc -p tsconfig.build.json",
