{
  "name": "tiny-http-mcp-server-rust",
  "version": "0.1.0",
  "private": true,
  "description": "Independent Rust streamable HTTP MCP server with native Node bindings",
  "type": "module",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./test-support": {
      "types": "./dist/test-support.d.ts",
      "import": "./dist/test-support.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    }
  },
  "scripts": {
    "prepack": "node ../../scripts/set-bin-executable.mjs",
    "build": "node scripts/prepare-host.mjs && node ../mcp-protocol-rust/scripts/cargo.mjs build",
    "test:unit": "node scripts/prepare-host.mjs && node ../mcp-protocol-rust/scripts/cargo.mjs test && vitest run --config vitest.reference.config.ts && tsc --project tsconfig.types.json",
    "lint": "node ../mcp-protocol-rust/scripts/cargo.mjs lint"
  },
  "devDependencies": {
    "@napi-rs/cli": "3.10.4",
    "mcp-protocol-rust": "*",
    "tiny-stdio-mcp-server-rust": "*",
    "tiny-http-mcp-server": "*",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "mcp-oauth-rust": "*",
    "jose": "6.2.3",
    "tiny-mcp-client": "*",
    "@modelcontextprotocol/sdk": "1.29.0",
    "auth-store-rust": "*"
  },
  "files": [
    "dist",
    "LICENSE",
    "UNICODE-LICENSE.txt",
    "MCP-LICENSE.txt"
  ],
  "engines": {
    "node": ">=18.18"
  },
  "napi": {
    "binaryName": "tiny-http-mcp-server-rust"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/poe-platform/poe-code.git",
    "directory": "packages/tiny-http-mcp-server-rust"
  },
  "bin": {
    "tiny-http-mcp-server-rust": "dist/cli.js"
  }
}
