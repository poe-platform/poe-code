{
  "name": "tiny-mcp-client-rust",
  "version": "0.1.0",
  "private": true,
  "description": "Independent Rust MCP client with native Node bindings",
  "type": "module",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node scripts/cargo.mjs build",
    "test:unit": "node scripts/cargo.mjs test && vitest run --config vitest.reference.config.ts && tsc --project tsconfig.types.json",
    "lint": "node scripts/cargo.mjs lint"
  },
  "devDependencies": {
    "@napi-rs/cli": "3.10.4",
    "@modelcontextprotocol/sdk": "1.29.0",
    "mcp-protocol-rust": "*",
    "tiny-mcp-client": "*",
    "tiny-stdio-mcp-server-rust": "*",
    "tsx": ">=4.21.0",
    "typescript": "5.9.3",
    "mcp-oauth-rust": "*",
    "auth-store-rust": "*",
    "vitest": "4.1.11",
    "tiny-http-mcp-server": "*",
    "tiny-http-mcp-server-rust": "*",
    "tiny-http-mcp-oauth-test-server": "*"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.18"
  },
  "napi": {
    "binaryName": "tiny-mcp-client-rust"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/poe-platform/poe-code.git",
    "directory": "packages/tiny-mcp-client-rust"
  }
}
