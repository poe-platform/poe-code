{
  "name": "toolcraft-design-rust",
  "version": "0.1.0",
  "private": true,
  "description": "Additive Rust template parsing, composition and rendering with zero npm runtime dependencies",
  "type": "module",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    "./explorer/render/text": {
      "types": "./dist/explorer-text.d.ts",
      "import": "./dist/explorer-text.js"
    },
    "./dashboard/terminal-width": {
      "types": "./dist/terminal-width.d.ts",
      "import": "./dist/terminal-width.js"
    },
    "./command-registry": {
      "types": "./dist/command-registry.d.ts",
      "import": "./dist/command-registry.js"
    },
    "./overlay-manager": {
      "types": "./dist/overlay-manager.d.ts",
      "import": "./dist/overlay-manager.js"
    },
    "./viewport": {
      "types": "./dist/viewport.d.ts",
      "import": "./dist/viewport.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./render-table": {
      "types": "./dist/render-table.d.ts",
      "import": "./dist/render-table.js"
    },
    "./components/table": {
      "types": "./dist/table.d.ts",
      "import": "./dist/table.js"
    },
    "./components/command-errors": {
      "types": "./dist/command-errors.d.ts",
      "import": "./dist/command-errors.js"
    },
    "./components/file-changes": {
      "types": "./dist/file-changes.d.ts",
      "import": "./dist/file-changes.js"
    },
    "./components/help-formatter": {
      "types": "./dist/help-formatter.d.ts",
      "import": "./dist/help-formatter.js"
    },
    "./components/help-formatter-plain": {
      "types": "./dist/help-formatter-plain.d.ts",
      "import": "./dist/help-formatter-plain.js"
    },
    "./components/catalog": {
      "types": "./dist/catalog.d.ts",
      "import": "./dist/catalog.js"
    },
    "./components/detail-card": {
      "types": "./dist/detail-card.d.ts",
      "import": "./dist/detail-card.js"
    },
    "./components/inspector-card": {
      "types": "./dist/inspector-card.d.ts",
      "import": "./dist/inspector-card.js"
    },
    "./components/resource-browser": {
      "types": "./dist/resource-browser.d.ts",
      "import": "./dist/resource-browser.js"
    },
    "./components/symbols": {
      "types": "./dist/symbols.d.ts",
      "import": "./dist/symbols.js"
    },
    "./tokens/index": {
      "types": "./dist/tokens.d.ts",
      "import": "./dist/tokens.js"
    },
    "./tokens/colors": {
      "types": "./dist/tokens-colors.d.ts",
      "import": "./dist/tokens-colors.js"
    },
    "./tokens/brand": {
      "types": "./dist/tokens-brand.d.ts",
      "import": "./dist/tokens-brand.js"
    },
    "./tokens/spacing": {
      "types": "./dist/spacing.d.ts",
      "import": "./dist/spacing.js"
    },
    "./tokens/widths": {
      "types": "./dist/widths.d.ts",
      "import": "./dist/widths.js"
    },
    "./tokens/typography": {
      "types": "./dist/typography.d.ts",
      "import": "./dist/typography.js"
    },
    "./inline-notice": {
      "types": "./dist/inline-notice.d.ts",
      "import": "./dist/inline-notice.js"
    },
    "./metric": {
      "types": "./dist/metric.d.ts",
      "import": "./dist/metric.js"
    },
    "./progress-group": {
      "types": "./dist/progress-group.d.ts",
      "import": "./dist/progress-group.js"
    },
    "./event-groups": {
      "types": "./dist/event-groups.d.ts",
      "import": "./dist/event-groups.js"
    },
    "./task-tree": {
      "types": "./dist/task-tree.d.ts",
      "import": "./dist/task-tree.js"
    }
  },
  "scripts": {
    "build": "node ../mcp-protocol-rust/scripts/cargo.mjs build && cp src/*.d.ts dist/",
    "test:unit": "node ../mcp-protocol-rust/scripts/cargo.mjs test && cp src/*.d.ts dist/ && tsc --project tsconfig.types.json && cd ../.. && vitest run --config packages/toolcraft-design-rust/vitest.sdk.config.mjs",
    "lint": "node ../mcp-protocol-rust/scripts/cargo.mjs lint && node scripts/lint-bindings.mjs"
  },
  "devDependencies": {
    "@napi-rs/cli": "3.10.4",
    "mcp-protocol-rust": "*",
    "toolcraft-design": "*",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.18"
  },
  "napi": {
    "binaryName": "toolcraft-design-rust"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/poe-platform/poe-code.git",
    "directory": "packages/toolcraft-design-rust"
  }
}
