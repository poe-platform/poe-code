{
  "name": "toolcraft-design",
  "version": "0.0.2",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "node ../../scripts/guard-package-dist.mjs && tsc",
    "postbuild": "node scripts/smoke-built-exports.mjs",
    "lint": "cd ../.. && eslint packages/toolcraft-design --ext ts && tsc -p packages/toolcraft-design/tsconfig.json --noEmit",
    "test": "cd ../.. && vitest run $(rg --files packages/toolcraft-design/src -g '*.test.ts' | sort | tr '\\n' ' ')",
    "demo": "tsx scripts/demo.ts",
    "generate:docs": "tsx scripts/generate-docs.ts all",
    "generate:design-docs:markdown": "tsx scripts/generate-docs.ts markdown",
    "generate:design-docs:json": "tsx scripts/generate-docs.ts json",
    "generate:design-docs:all": "tsx scripts/generate-docs.ts all"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@poe-code/frontmatter": "*",
    "fast-string-width": "^3.0.2",
    "fast-wrap-ansi": "^0.2.0",
    "sisteransi": "^1.0.5"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./render-markdown-plaintext": {
      "types": "./dist/render-markdown-plaintext.d.ts",
      "import": "./dist/render-markdown-plaintext.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "engines": {
    "node": ">=18.18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/poe-platform/poe-code.git",
    "directory": "packages/toolcraft-design"
  },
  "publishConfig": {
    "access": "public"
  }
}
