{
  "name": "toolcraft-openapi",
  "version": "0.0.1",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./mock": {
      "types": "./dist/mock.d.ts",
      "import": "./dist/mock.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc",
    "test": "cd ../.. && vitest run packages/toolcraft-openapi/src",
    "test:unit": "cd ../.. && vitest run packages/toolcraft-openapi/src",
    "prepack": "node ../../scripts/set-bin-executable.mjs && node ../../scripts/manage-bundled-workspace-deps.mjs prepare . toolcraft-design auth-store",
    "postpack": "node ../../scripts/manage-bundled-workspace-deps.mjs cleanup . toolcraft-design auth-store"
  },
  "files": [
    "dist"
  ],
  "bin": {
    "toolcraft-openapi-generate": "dist/bin/generate.js"
  },
  "dependencies": {
    "toolcraft": "^0.0.4",
    "auth-store": "^0.0.1",
    "yaml": "^2.8.2"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/poe-platform/poe-code.git",
    "directory": "packages/toolcraft-openapi"
  },
  "optionalDependencies": {
    "toolcraft-design": "^0.0.2"
  },
  "bundleDependencies": [
    "toolcraft-design",
    "auth-store"
  ]
}
