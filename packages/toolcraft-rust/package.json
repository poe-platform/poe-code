{
  "name": "toolcraft-rust",
  "version": "0.1.0",
  "private": true,
  "description": "Additive Rust implementation of Toolcraft with compatible Node adapters",
  "type": "module",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./source-snippet": {
      "types": "./dist/source-snippet.d.ts",
      "import": "./dist/source-snippet.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js"
    },
    "./sdk": {
      "types": "./dist/sdk.d.ts",
      "import": "./dist/sdk.js"
    }
  },
  "scripts": {
    "build": "node ../mcp-protocol-rust/scripts/cargo.mjs build && cp src/*.d.ts dist/",
    "test:unit": "node ../mcp-protocol-rust/scripts/cargo.mjs test && cp src/*.d.ts dist/ && vitest run --config vitest.reference.config.mjs && tsc --project tsconfig.types.json",
    "lint": "node ../mcp-protocol-rust/scripts/cargo.mjs lint"
  },
  "devDependencies": {
    "@napi-rs/cli": "3.10.4",
    "mcp-protocol-rust": "*",
    "toolcraft": "*",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "tsx": "*",
    "@poe-code/agent-mcp-config": "*",
    "toolcraft-schema": "*",
    "toolcraft-design": "*",
    "memfs": "4.56.10",
    "tiny-stdio-mcp-server-rust": "*"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.18"
  },
  "napi": {
    "binaryName": "toolcraft-rust"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/poe-platform/poe-code.git",
    "directory": "packages/toolcraft-rust"
  },
  "dependencies": {
    "toolcraft-design-rust": "*",
    "toolcraft-schema-rust": "*",
    "commander": "^13.1.0",
    "tiny-mcp-client-rust": "*",
    "@poe-code/task-list-rust": "*"
  }
}
