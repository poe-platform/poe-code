{
  "name": "toolcraft-schema-rust",
  "version": "0.1.0",
  "private": true,
  "description": "Additive Rust schema builders, validation and JSON Schema compiler with native Node bindings",
  "type": "module",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node ../mcp-protocol-rust/scripts/cargo.mjs build && cp src/*.d.ts dist/",
    "test:unit": "node ../mcp-protocol-rust/scripts/cargo.mjs test && cp src/*.d.ts dist/ && (cd ../.. && vitest run --config packages/toolcraft-schema-rust/vitest.reference.config.mjs) && tsc --project tsconfig.types.json && node tests/reference-types.mjs",
    "lint": "node ../mcp-protocol-rust/scripts/cargo.mjs lint"
  },
  "devDependencies": {
    "@napi-rs/cli": "3.10.4",
    "mcp-protocol-rust": "*",
    "toolcraft-schema": "*",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "files": [
    "dist",
    "LICENSE",
    "UNICODE-LICENSE.txt"
  ],
  "engines": {
    "node": ">=18.18"
  },
  "napi": {
    "binaryName": "toolcraft-schema-rust"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/poe-platform/poe-code.git",
    "directory": "packages/toolcraft-schema-rust"
  }
}
