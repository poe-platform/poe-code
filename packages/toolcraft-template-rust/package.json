{
  "name": "toolcraft-template-rust",
  "version": "0.1.0",
  "private": true,
  "description": "Own Rust template rendering and partial composition with zero npm runtime dependencies",
  "type": "module",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node ../mcp-protocol-rust/scripts/cargo.mjs build",
    "test:unit": "node ../mcp-protocol-rust/scripts/cargo.mjs test",
    "lint": "node ../mcp-protocol-rust/scripts/cargo.mjs lint && node scripts/lint-bindings.mjs"
  },
  "devDependencies": {
    "@napi-rs/cli": "3.10.4",
    "mcp-protocol-rust": "*",
    "toolcraft-design": "*"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.18"
  },
  "napi": {
    "binaryName": "toolcraft-template-rust"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/poe-platform/poe-code.git",
    "directory": "packages/toolcraft-template-rust"
  }
}
