{
  "name": "toolcraft",
  "version": "0.0.1",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "import": "./dist/mcp.js"
    },
    "./mcp-proxy": {
      "types": "./dist/mcp-proxy.d.ts",
      "import": "./dist/mcp-proxy.js"
    },
    "./sdk": {
      "types": "./dist/sdk.d.ts",
      "import": "./dist/sdk.js"
    },
    "./human-in-loop": {
      "types": "./dist/human-in-loop/index.d.ts",
      "import": "./dist/human-in-loop/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc",
    "test": "cd ../.. && vitest run packages/toolcraft/src",
    "test:unit": "cd ../.. && vitest run packages/toolcraft/src",
    "lint": "cd ../.. && eslint packages/toolcraft/src --ext ts && tsc -p packages/toolcraft/tsconfig.json --noEmit",
    "prepack": "node ../../scripts/manage-bundled-workspace-deps.mjs prepare . @poe-code/design-system @poe-code/agent-mcp-config",
    "postpack": "node ../../scripts/manage-bundled-workspace-deps.mjs cleanup . @poe-code/design-system @poe-code/agent-mcp-config"
  },
  "dependencies": {
    "@clack/core": "^1.0.0",
    "@clack/prompts": "^1.0.0",
    "@poe-code/agent-mcp-config": "*",
    "@poe-code/design-system": "^0.0.1",
    "@poe-code/task-list": "*",
    "toolcraft-schema": "^0.0.1",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "console-table-printer": "^2.15.0",
    "tiny-mcp-client": "*",
    "tiny-stdio-mcp-server": "^0.1.0"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/poe-platform/poe-code.git",
    "directory": "packages/toolcraft"
  },
  "bundleDependencies": [
    "@poe-code/design-system",
    "@poe-code/agent-mcp-config"
  ]
}
