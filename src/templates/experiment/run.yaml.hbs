# Edit this file to control the experiment context sent to the agent each iteration.
# General instructions (commit, journal logging) are always appended automatically.
#
# Available variables:
#   {{body}}                 — experiment doc body (markdown below the frontmatter)
#   {{journal}}              — formatted journal of prior attempts
#   {{metrics}}              — metric definitions with direction and baseline scores
#   {{experiment_index}}     — current experiment number (1-based)
#
# The agent receives the result of replacing variables in the prompt template below,
# followed by the general instructions.

prompt: |
  {{body}}

  ## Metrics

  {{metrics}}

  ## Journal

  {{journal}}
