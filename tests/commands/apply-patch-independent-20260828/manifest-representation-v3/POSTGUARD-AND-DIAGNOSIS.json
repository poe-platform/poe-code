    "sourceExcerpts": [
      {
        "line": 2,
        "text": "import { sha } from './common.mjs';"
      },
      {
        "line": 4,
        "text": "export function replaceOnce(body, needle, replacement) {"
      },
      {
        "line": 6,
        "text": "  return body.replace(needle, replacement);"
      },
      {
        "line": 11,
        "text": "  const witness = marker => `(globalThis.reviewMarkers.includes(${JSON.stringify(marker)}) || globalThis.reviewMarkers.push(${JSON.stringify(marker)}))`;"
      },
      {
        "line": 13,
        "text": "    ['M01', 'apply.js', 'const text = context.args[0];', marker => `const text = (${marker}, context.args[0]);`, marker => `const text = (${marker}, context.stdin[Symbol.asyncIterator](), context.args[0]);`, 'P02'],"
      },
      {
        "line": 14,
        "text": "    ['M03', 'matcher.js', 'work.equal(lines[candidate + offset].text, pattern[offset])', marker => `(${marker}, work.equal(lines[candidate + offset].text, pattern[offset]))`, marker => `(${marker}, work.equal(lines[candidate + offset].text.trim(), pattern[offset].trim()))`, 'P18'],"
      },
      {
        "line": 15,
        "text": "    ['M04', 'matcher.js', 'const first = eof ? last : start;', marker => `const first = (${marker}, eof ? last : start);`, marker => `const first = (${marker}, start);`, 'P16'],"
      },
      {
        "line": 16,
        "text": "    ['M09', 'apply.js', 'flag: \"wx\"', marker => `flag: (${marker}, \"wx\")`, marker => `flag: (${marker}, \"w\")`, 'S40'],"
      },
      {
        "line": 17,
        "text": "    ['M12', 'apply.js', 'chunks.push(await work.copy(chunk));', marker => `chunks.push((${marker}, await work.copy(chunk)));`, marker => `chunks.push((${marker}, chunk));`, 'S49'],"
      },
      {
        "line": 18,
        "text": "    ['M18', 'apply.js', 'work.count(\"maxInputChunks\", 1);', marker => `(${marker}, work.count(\"maxInputChunks\", 1));`, marker => `(${marker}, chunk.byteLength && work.count(\"maxInputChunks\", 1));`, 'L10'],"
      },
      {
        "line": 20,
        "text": "  for (const [id, name, needle, positive, mutant, caseId] of definitions) for (const phase of ['before', 'mutant', 'restored']) {"
      },
      {
        "line": 21,
        "text": "    const marker = `AP753:${id}:${phase}`;"
      },
      {
        "line": 22,
        "text": "    const body = replaceOnce(original(name), needle, (phase === 'mutant' ? mutant : positive)(witness(marker)));"
      },
      {
        "line": 23,
        "text": "    output.push({ id: `${id}-${phase}`, phase, family: id, marker, caseId, changes: { [`dist/commands/apply-patch/${name}`]: body },"
      },
      {
        "line": 24,
        "text": "      migration: id === 'M12' ? 'v2 applicability-only: old new Uint8Array(chunk) site became await work.copy(chunk); unchanged S49 borrowing challenge, retained-view mutant and phase semantics' : 'original mutation operation and fixture unchanged' });"
      },
      {
        "line": 26,
        "text": "  const instrument = (marker, mutation, family) => {"
      },
      {
        "line": 27,
        "text": "    let shared = original('shared.js'); let matcher = original('matcher.js');"
      },
      {
        "line": 28,
        "text": "    shared = replaceOnce(shared, 'target.set(bytes.subarray(offset, offset + count), start + offset);', 'globalThis.s54Hooks.record({ kind: \"copy\", count, units: this.units, nextYield: this.nextYield });\\n            target.set(bytes.subarray(offset, offset + count), start + offset);');"
      },
      {
        "line": 29,
        "text": "    shared = replaceOnce(shared, 'const encoded = encoder.encodeInto(chunk, target.subarray(offset, offset + bytes));', 'globalThis.s54Hooks.record({ kind: \"encode\", units: chunk.length, danglingHigh: chunk.charCodeAt(chunk.length - 1) >= 0xd800 && chunk.charCodeAt(chunk.length - 1) <= 0xdbff });\\n            const encoded = encoder.encodeInto(chunk, target.subarray(offset, offset + bytes));');"
      },
      {
        "line": 30,
        "text": "    matcher = replaceOnce(matcher, 'work.admit(units * 2 + bytes);', 'globalThis.s54Hooks.record({ kind: \"stage-admit\", bytes, units });\\n    work.admit(units * 2 + bytes);');"
      },
      {
        "line": 31,
        "text": "    matcher = replaceOnce(matcher, 'const result = new Uint8Array(bytes);', 'globalThis.s54Hooks.record({ kind: \"stage-allocation\", bytes });\\n    const result = new Uint8Array(bytes);');"
      },
      {
        "line": 32,
        "text": "    if (mutation === 'bulk-copy') shared = replaceOnce(shared, 'const count = Math.min(bytes.length - offset, this.nextYield - this.units);', 'const count = bytes.length - offset;');"
      },
      {
        "line": 33,
        "text": "    if (mutation === 'skip-interval') shared = replaceOnce(shared, 'this.nextYield += 4096;', 'this.nextYield = this.units + 4096;');"
      },
      {
        "line": 34,
        "text": "    if (mutation === 'bulk-encode') shared = replaceOnce(shared, 'let end = Math.min(text.length, index + 1024);', 'let end = text.length;');"
      },
      {
        "line": 35,
        "text": "    if (mutation === 'stage-admit') matcher = replaceOnce(matcher, 'work.admit(units * 2 + bytes);', 'void 0;');"
      },
      {
        "line": 36,
        "text": "    if (family === 'bulk-copy') shared = replaceOnce(shared, 'let offset = 0;\\n        while (offset < bytes.length)', `${witness(marker)};\\n        let offset = 0;\\n        while (offset < bytes.length)`);"
      },
      {
        "line": 37,
        "text": "    if (family === 'skip-interval') shared = replaceOnce(shared, 'if (this.units >= this.nextYield) {', `if (this.units >= this.nextYield) {\\n            ${witness(marker)};`);"
      },
      {
        "line": 38,
        "text": "    if (family === 'bulk-encode') shared = replaceOnce(shared, 'const encoder = new TextEncoder();', `${witness(marker)};\\n        const encoder = new TextEncoder();`);"
      },
      {
        "line": 39,
        "text": "    if (family === 'stage-admit') matcher = replaceOnce(matcher, 'globalThis.s54Hooks.record({ kind: \"stage-admit\", bytes, units });', `${witness(marker)};\\n    globalThis.s54Hooks.record({ kind: \"stage-admit\", bytes, units });`);"
      },
      {
        "line": 40,
        "text": "    return { 'dist/commands/apply-patch/shared.js': shared, 'dist/commands/apply-patch/matcher.js': matcher };"
      },
      {
        "line": 43,
        "text": "  for (const [family, killedBy] of families) for (const phase of ['before', 'mutant', 'restored']) {"
      },
      {
        "line": 44,
        "text": "    const id = `S54-${family}-${phase}`; const marker = `AP753:${id}`;"
      },
      {
        "line": 45,
        "text": "    output.push({ id, phase, family, instrumented: true, mutant: phase === 'mutant' ? family : null, killedBy, marker, changes: instrument(marker, phase === 'mutant' ? family : null, family) });"
      },
