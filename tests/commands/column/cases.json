  { "id": "empty-explicit-fields", "profile": "qualified", "qualification": "BSD collapses repeated delimiters; virtual profile preserves fields following util-linux >=2.23 documented behavior.", "args": ["-t", "-s", ":"], "input": "a:b:c\n1::3\n", "stdout": "a  b  c\n1     3\n", "status": 0 },
  { "id": "leading-trailing-empty-fields", "profile": "qualified", "qualification": "BSD omits empty fields and emits (null) for a delimiter-only record; virtual profile retains empty cells.", "args": ["-t", "-s", ":"], "input": ":a:\n::\n", "stdout": "  a  \n     \n", "status": 0 },
  { "id": "retained-tab-table", "profile": "qualified", "qualification": "Virtual expands a retained tab to spaces; BSD retains tab bytes.", "args": ["-t", "-s", ":"], "input": "a\tq:z\nxx:y\n", "stdout": "a       q  z\nxx         y\n", "status": 0 },
