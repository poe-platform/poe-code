sqlite.writeUInt32BE(1, 56);
sqlite.writeUInt32BE(1, 92);
sqlite.writeUInt32BE(3041000, 96);
sqlite[100] = 13;
sqlite.writeUInt16BE(512, 105);
const memberName = text('message.txt');
const memberData = text('sealed archive member\n');
const local = Buffer.alloc(30);
local.writeUInt32LE(0x04034b50);
local.writeUInt16LE(20, 4);
local.writeUInt32LE(crc32(memberData), 14);
local.writeUInt32LE(memberData.length, 18);
local.writeUInt32LE(memberData.length, 22);
local.writeUInt16LE(memberName.length, 26);
const central = Buffer.alloc(46);
central.writeUInt32LE(0x02014b50);
central.writeUInt16LE(20, 4);
central.writeUInt16LE(20, 6);
central.writeUInt32LE(crc32(memberData), 16);
central.writeUInt32LE(memberData.length, 20);
central.writeUInt32LE(memberData.length, 24);
central.writeUInt16LE(memberName.length, 28);
const zipEnd = Buffer.alloc(22);
zipEnd.writeUInt32LE(0x06054b50);
zipEnd.writeUInt16LE(1, 8);
zipEnd.writeUInt16LE(1, 10);
zipEnd.writeUInt32LE(central.length + memberName.length, 12);
zipEnd.writeUInt32LE(local.length + memberName.length + memberData.length, 16);
const zip = Buffer.concat([local, memberName, memberData, central, memberName, zipEnd]);

