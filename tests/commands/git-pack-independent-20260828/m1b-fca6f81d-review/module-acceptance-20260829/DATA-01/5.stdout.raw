        "GFP-37"
      ],
      "variant": "sidecar-metadata-change",
      "spec": {
        "packs": [
          {
            "frozen": "P04"
          }
        ],
        "extra": [
          {
            "path": "@PACK@.keep",
            "body": {
              "text": "A"
            }
          }
        ],
        "actor": "sidecar-stat"
      },
      "expected": {
        "exitCode": 128,
        "stdoutText": "",
        "stderrText": "git: Git pack/sidecar observations changed before output\n"
      },
      "control": {
        "packs": [
          {
            "build": {
              "entries": [
                {
                  "body": {
                    "text": "A"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    {
