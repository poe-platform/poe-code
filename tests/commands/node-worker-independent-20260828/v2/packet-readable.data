        "reservedZero17",
        "reservedZero18",
        "reservedZero19",
        "reservedZero20",
        "reservedZero21",
        "reservedZero22"
      ],
      "version": 2,
      "initialization": "Parent initializes once before Worker admission: stop/epoch/allocator=0, positive session, version2, slots FREE with other words/payload zero. Slots1/2 remain zero/inactive; any attempted use is protocol failure. No grow, transfer, additional SAB or guest reference.",
      "session": "Parent-owned lifetime-unique positive signed32 session, refuse exhaustion; channel ownership authenticates authority, not number secrecy."
    },
    "states": {
      "FREE": 0,
      "WORKER_OWNED": 1,
      "REQUEST": 2,
      "PARENT_OWNED": 3,
      "RESPONSE": 4,
      "ACK": 5,
      "RETIRED": 6
    },
    "phases": {
      "NONE": 0,
      "HEADER": 1,
      "UPLOAD_CREDIT": 2,
      "UPLOAD_DATA": 3,
      "RESULT_META": 4,
      "RESULT_DATA": 5,
      "META_ACK": 6,
      "DATA_ACK": 7,
      "FINAL_ACK": 8
    },
    "resultTags": {
      "NONE": 0,
      "UPLOAD": 1,
      "TEXT": 2,
      "VOID": 3,
      "FS_ERROR": 4,
      "UNSUPPORTED": 5,
      "DENIED": 6
    },
    "counters": {
      "operationSequence": "Worker allocates1..128 once per header including denied calls/cache authorization/primitive print; no retry, queue overflow or wrap. No new seq until prior final ACK and FREE. Source acquisition is not a guest operation.",
      "frame": "Both trusted peers use checked CAS on global frameAllocator to reserve1..4096 BEFORE frame encoding/copy. Reserved but unpublished frames burn capacity. Every REQUEST, RESPONSE or ACK is a frame, including empty credits/ACKs. No slot-state acquisition/FREE/RETIRE is a frame.",
      "predecessor": "Each publication names exact last committed frame of that slot, including across reuse. Parent and Worker retain per-slot last state/phase/seq/frame plus bounded seen-frame bitsets. No repeated frame; no skipped per-slot predecessor. Global allocation order is NOT delivery order. No global largest-seen rejection across slots; inactive slots still refuse in this profile.",
      "admissionOrdinal": "Parent-only1..129: at most128 admitted operations plus exactly one cutoff. Not a wire frame/sequence/wake counter. Denied/staged records consume seq but no effect ordinal.",
      "wakeEpoch": "Parent-only checked increments1..8192 for response/FREE/stop notifications; no wrap. Reserve final emergency wake capacity while OPEN; reject further service before exhausting it. Permanent stop check prevents waiting at exhaustion.",
      "control": "One unacknowledged Worker doorbell per slot, discharged by parent ownership CAS; at most4096 frame doorbells plus one READY and one terminal record (4098). Each encoded control <=256 bytes; control records carry no guest payload/raw reasons. Source/context bootstrap has its own reserved <=64KiB context and <=256KiB source, not a control bypass.",
      "source": "One entry acquisition; <=256KiB UTF8. Source stream/fragments and their EOF are fully checked before guest run, with distinct sourceRead/stdinRead authority. No RPC grant turns source into data authority."
    },
    "validation": {
      "ownData": "Trusted sender checks exact finite own data descriptors before serialization; receiver checks again after decoding. No prototype-identity gate, inherited fields, symbols, accessors, sparse sequences, extras, undefined or coercion. Canonical UTF8 JSON with exact schema key order, no whitespace/duplicate keys/noncanonical numeric spellings; binary chunks are owned bytes, not JSON arrays.",
      "numbers": "Safe integer within field range; reject -0, NaN and infinities. Session1..2147483647, seq1..128, frame1..4096, predecessor0..4096, offset/total0..1048576, payloadLength0..65536.",
      "headers": "Read header only after acquiring matching atomic state. Validate session/version/slot/reserved words, phase/tag, seq and predecessor before payload copy. Metadata <=8192 bytes; precharge fixed header/full frame/decode storage before reading. After cancel/exit do not inspect a peer-owned mutable payload.",
      "invalid": "Any unexpected wire state/phase/tag/length/duplicate/stale/wrong-session/inactive slot closes admission as protocol failure and drains existing owners; do not attempt a corrective write or synthetic ACK. An inert old doorbell never grants authority."
    },
    "request": {
      "keys": [
        "v",
        "session",
        "slot",
        "seq",
        "op",
        "authority",
        "path",
        "flag",
        "totalBytes",
        "moduleKey"
      ],
      "v": 2,
      "slot": 0,
      "ops": [
        [
          "readText",
          "data|json",
          "absolute virtual path",
          "r",
          null,
          null
        ],
        [
          "readText",
          "stdin",
          null,
          "r",
          null,
          null
        ],
        [
          "writeText",
          "data",
          "absolute virtual path",
          "w|wx",
          "exact UTF8 count",
          null
        ],
        [
          "writeOutput",
          "stdout|stderr",
          null,
          null,
          "exact UTF8 count",
          null
        ],
        [
          "authorizeJson",
          "json",
          "absolute canonical virtual path",
          "r",
          0,
          null
        ],
        [
          "authorizeModule",
          "module",
          null,
          null,
          0,
          "fs|path|process"
        ]
      ],
      "rules": "Path<=1024 UTF8 bytes, no NUL. Nonapplicable fields exactly null. Resolve namespace/path authority truthfully; lexical normalization is not confinement or symlink identity. JSON read/hit needs jsonModules AND dataRead. Module authorization validates fixed inventory only; write/read/output grants remain separate. Header-only requests have no upload."
    },
    "response": {
      "metadataKeys": [
        "kind",
        "totalBytes",
        "error",
        "cacheKey"
      ],
      "variants": [
        {
          "kind": "text",
          "totalBytes": "0..1048576 exact raw result UTF8 bytes",
          "error": null
        },
        {
          "kind": "void",
          "totalBytes": 0,
          "error": null
        },
        {
          "kind": "fsError",
          "totalBytes": 0,
          "error": "ERRORS.json FsErrorDTO"
        },
        {
          "kind": "unsupported",
          "totalBytes": 0,
          "error": "ERRORS.json unsupported DTO"
        },
        {
          "kind": "denied",
          "totalBytes": 0,
          "error": "ERRORS.json denied DTO"
        }
      ],
      "rule": "One terminal result only. Read consumes its full bounded source to EOF and flushes decoder before response metadata; failure sends no success prefix. Re-encoded replacement UTF8 response also <=1MiB, separately checked; raw cumulative read bytes are not replaced by encoded result length. Void only after actual write/output settlement. Parent operation cleanup may finish later. authorizeJson succeeds with void plus cacheKey; readText-json succeeds with text plus cacheKey established on that same operation. Guest hidden facade checks returned key on miss again before cache insertion; changed namespace authority refuses rather than installing under earlier key. Ordinary textfs never receives this private envelope.",
      "cacheKey": "Exactly null except successful authorizeJson/readText-json: own-data {namespace,path}, namespace is a bounded parent-issued handle truthfully bound to the invocation actual VFS namespace, path the authorized canonical virtual filename<=1024 UTF8 bytes. Entire metadata including key<=8192. Handle is NOT FileStat.identityScope or a disjoint-storage assertion; different clients do not prove distinct namespaces."
    },
    "transitions": [
      {
        "from": "FREE",
        "actor": "Worker",
        "to": "WORKER_OWNED",
        "action": "CAS FREE; allocate seq, precharge all request metadata/frame/write-string copies, then reserve frame; preserve previous committed frame. No concurrent publisher."
      },
      {
        "from": "WORKER_OWNED",
        "actor": "Worker",
        "to": "REQUEST/HEADER",
        "action": "Encode validated header only; publish fields then Atomics.store state REQUEST; send bounded doorbell. Header is not payload body or effect admission."
      },
      {
        "from": "REQUEST/HEADER",
        "actor": "parent",
        "to": "PARENT_OWNED",
        "action": "CAS before copying; validate and reserve complete staging/result allowance and cleanup record. Invalid semantic grant yields denied without effect; malformed wire stops. For zero-byte writes skip upload, but still validate exact source encoding and enroll effect before mutation."
      },
      {
        "from": "PARENT_OWNED",
        "actor": "parent",
        "to": "RESPONSE/UPLOAD_CREDIT",
        "action": "Only writes/output with remaining bytes. Reserve frame, empty payload, UPLOAD tag; offset equals bytes already copied, total equals header total. Implicit credit=min(65536,total-offset), always positive. Publish then notify independently of Worker callbacks."
      },
      {
        "from": "RESPONSE/UPLOAD_CREDIT",
        "actor": "Worker",
        "to": "WORKER_OWNED",
        "action": "CAS before checking credit, validate predecessor/seq/offset and empty payload. Precharged original primitive string and encoding/staging remain owned; no VFS effect."
      },
      {
        "from": "WORKER_OWNED",
        "actor": "Worker",
        "to": "ACK/UPLOAD_DATA",
        "action": "Reserve frame before encoding/copy. Fill exactly credited positive byte length, total/offset unchanged, UPLOAD tag; chunks may split UTF8 sequences. Publish ACK and doorbell. No zero nonterminal chunks, overlap, overshoot or concurrent payload writer."
      },
      {
        "from": "ACK/UPLOAD_DATA",
        "actor": "parent",
        "to": "PARENT_OWNED",
        "action": "CAS then copy into precharged parent staging before next credit. Validate chunk and cumulative exact length; on final byte validate full UTF8 encoding/source and all route/grant/limits, then synchronously OPEN-check/enroll effect with immutable bytes. Incomplete/invalid/cutoff staging never calls VFS, even for wx or empty truncation. Read/hit operations validate complete header before their admission."
      },
      {
        "from": "PARENT_OWNED",
        "actor": "parent",
        "to": "RESPONSE/RESULT_META",
        "action": "Only after full operation outcome or pre-effect semantic refusal. Validate/encode finite response in precharged <=8192 metadata; result total is separate from request upload total. Awaited sinks/stream completion are not inferred from transfer. Publish only if original ownership and OPEN gate still permit it."
      },
      {
        "from": "RESPONSE/RESULT_META",
        "actor": "Worker",
        "to": "WORKER_OWNED",
        "action": "CAS, precharge/result capacity already reserved, copy/validate full metadata. Zero text/void/error requires FINAL_ACK; positive text requires META_ACK."
      },
      {
        "from": "WORKER_OWNED",
        "actor": "Worker",
        "to": "ACK/META_ACK",
        "action": "Positive-text only, empty payload, result tag/total and offset0; reserve frame and publish. No upload bytes allowed in response ACKs."
      },
      {
        "from": "ACK/META_ACK|ACK/DATA_ACK",
        "actor": "parent",
        "to": "PARENT_OWNED -> RESPONSE/RESULT_DATA",
        "action": "CAS before validating ACK; copy next min(65536,remaining) positive response bytes, exact offset/total/tag and predecessor. No wait for guest microtask. Parent prebuffers bounded read result or independent producer completion; never holds a service lock across Worker ACK."
      },
      {
        "from": "RESPONSE/RESULT_DATA",
        "actor": "Worker",
        "to": "WORKER_OWNED -> ACK/DATA_ACK|ACK/FINAL_ACK",
        "action": "CAS then copy into precharged private assembly before ACK. Require positive exact expected length and full total before FINAL_ACK, else DATA_ACK. Reserve ACK frame; zero payload. Final decode/length/schema validation completes before FINAL_ACK; no bridge delivery assertion."
      },
      {
        "from": "ACK/FINAL_ACK",
        "actor": "parent",
        "to": "PARENT_OWNED -> FREE",
        "action": "CAS and validate empty ACK; FREE only after actual operation settlement AND cooperative per-operation cleanup. Maintain outcome/handoff record outside slot. Worker may now return copied primitive/throw reconstructed local FS error; callback return itself still crosses bridge. Cleanup failure closes gate instead of FREE."
      },
      {
        "from": "any live state",
        "actor": "parent",
        "to": "logical CLOSED; then RETIRED only after exit",
        "action": "Serialize cutoff; independent stop/wake when cancel/failure, never overwrite payload/state owned by Worker. Normal cutoff ceases service without aborting admitted VFS work. Confirm actual exit before transport retirement; await parent cleanup separately; no ACK required or invented, no session reuse."
      }
    ],
    "wait": "Worker samples wakeEpoch, checks stop and exact expected state/seq/phase, then Atomics.wait on sampled epoch; recheck after every outcome/timeout. Parent notification is independent of blocked Worker listeners. Deadline remaining applies while OPEN; normal cutoff closes timer, not caller cancellation. Parent must never wait on an ACK to start/cancel other owned work; slots1/2 are refused, not serviced async. Worker rechecks permanent stop before payload encoding/copy, publication and return; a concurrent stop may race that local check, but parent CLOSED gate still forbids effects. Do not infer which cross-thread observation happened first. Cooperative parent operation/cleanup MUST NOT depend on guest progress, callback return or receiving a Worker ACK; otherwise this provider cannot qualify and ownership remains unsettled.",
    "handoff": {
      "facts": [
        "parent outcome observed",
        "final transport ACK",
        "per-operation cleanup closed",
        "bridge delivered",
        "terminal observed",
        "parent cutoff committed",
        "Worker exit observed",
        "parent cleanup closed"
      ],
      "separation": "Only first three permit slot FREE. They do not establish bridge delivered. Retain known rejection even after FREE in a bounded seq-indexed parent record.",
      "candidate": "For sync slice only: a later genuine single-run normal settlement terminal, with lastSeq/finalFrame checked against every parent final ACK, could witness earlier ordinary callbacks unwound. Qualification MUST prove original result/error copy actually completed, including caught copy/conversion failures; terminal order alone is insufficient. No actual hook/receipt is supplied here.",
      "blocker": "Without independently source-bound legitimate post-copy/error handoff evidence, delivered remains unknown and known rejection is retained as escaping undelivered failure, preventing clean0. Never mark from ACK, reason equality or an unauthenticated boolean. Async/explicit-exit inference is expressly invalid.",
      "terminal": {
        "keys": [
          "v",
          "session",
          "kind",
          "lastSeq",
          "finalFrame"
        ],
        "kind": "entryReturned|guestFailure",
        "lastSeq": "0..128",
        "finalFrame": "0..4096",
        "limit": 256,
        "rule": "Trusted controller only; closes local guest gate after actual bound run settlement. Primitive print is a separately reserved controller output operation completed before terminal. Parent validates existing handoff evidence, then commits cutoff in one serialized turn; terminal message grants no delivery fact."
      }
    },
    "reconciliation": "Parent admitted=settled+active; closed<=settled; keep exact output committed bytes and staged-discarded bytes. Termination/exit/close are separate flags. A late job checks original session/slot/seq/record and CLOSED before any SAB publication; always observe result/cleanup even when publication forbidden. No real operation or rejection erased by transport retirement.",
    "phaseHeaders": [
      {
        "phase": "HEADER",
        "state": "REQUEST",
        "tag": "NONE",
