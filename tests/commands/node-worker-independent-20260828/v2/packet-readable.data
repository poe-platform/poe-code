      ],
      "slotHeaderBytes": 128,
      "slotPayloadBytes": 65536,
      "slotInt32Words": [
        "state",
        "seq",
        "phase",
        "frame",
        "predecessor",
        "payloadLength",
        "totalBytes",
        "resultTag",
        "offset",
        "reservedZero0",
