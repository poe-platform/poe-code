        "codeRangeSizeMb": 8,
        "stackSizeMb": 4
      },
      "executionAdmissionMs": 5000,
      "cooperativeStopGraceMsMax": 0,
      "engineStepsMax": 100000,
      "guestCallDepthMax": 128,
      "parserTokensMax": 65536,
      "parserDepthMax": 128,
      "activeSlots": 1
    },
    "limitsNote": "Three physical slots remain. Active slot0 only; zero grace supersedes historical maximum100ms without increasing any cap. V8 limits are independent knobs, not an additive heap/RSS/whole-guest bound.",
    "accounting": {
      "units": "Bytes actual allocated backing capacity, strings2*UTF16 code units, named metadata256 bytes per record plus separately charged strings/arrays. Logical accounting is not measured VM object overhead.",
      "arithmetic": "Checked safe-integer add/multiply before allocation, UTF8 encode, decode, clone, retained copy or resource admission. Failure closes private admission without that allocation/effect; earlier effects survive. Never copy then test length.",
      "utf8": "Scan bounded primitive UTF16 without allocating encoded output; paired surrogates4 bytes, lone surrogate replacement3, other scalar UTF8 width. Check source<=256KiB, path<=1024, message<=1024, per-operation input and re-encoded result<=1MiB, metadata escaped UTF8<=8192. Wire metadata must be canonical valid UTF8; data/source decoding uses replacement and the inherited BOM policy. No JS string.length-as-byte bound.",
      "ownership": "Count simultaneous original+encoded+staged+decoded+return copies; a view never releases its backing store. Reserve worst-case at header, not each chunk only. Transfer reservation on genuine move of ownership; otherwise retain both. Release only after verified last reference/resource closure. ByteSource retained fragments copied before next/finalize; transient awaited sink writes do not require an extra copy by default.",
      "privateCounters": "Transport frames, control records, operation sequences, parent ordinals, source bytes, raw-read bytes, staged-write bytes, output bytes, cache inputs and live reservations are distinct. No public shared-Budget API or per-RPC command tick. Existing Shell dispatch/sinks/shared limits apply unchanged; smaller inherited limits win.",
      "cumulative": "Reserve full write/output request length before encoding/staging; count once, no refund/replenishment from ACK/cutoff/retry. Raw read bytes count on acquisition before decode, including discarded overlimit outcome; never retain an overlimit producer chunk. Source is independently capped; no source/data replay or grant mixing. Result re-encoding/transport counted as copies, not duplicate physical write bytes.",
      "capacity": "Maxima are ceilings, not a guarantee that all maximum-sized live copies fit simultaneously. Reject before allocation when the16MiB ledger is insufficient; disclose usable guest source remainder after trusted scaffold. No silent overflow, post-allocation checks or runtime compatibility claim."
    },
    "reservations": [
      {
        "id": "owner-controls",
        "precharge": "Before enrollment-owned resource acquisition: one256-byte owner,128*256-byte operation/outcome records, fixed per-slot bookkeeping,2*512-byte frame bitsets; retained error/path strings separate. Source/startup has a separately precharged ownership record and source counter, not an extra guest-operation ordinal; all startup acquisitions still require the owner OPEN check and explicit grants.",
        "release": "Owner/control records only after exit and parent cleanup; seq records retained for handoff/outcome even after slot FREE."
      },
      {
        "id": "SAB",
        "precharge": 197056,
        "release": "Only confirmed exit and no parent publisher/reader; never reuse session."
      },
      {
        "id": "full-frame-scratch",
        "precharge": "Four fixed65536-byte scratch backing stores: Worker send/receive and parent send/receive. Inactive slots get no extra scratch. This262144 is additional to SAB, not a replacement for its charge.",
        "release": "Each endpoint only after no in-flight access/clone. Subarray copy retaining whole buffer still costs65536."
      },
      {
        "id": "metadata-controls",
        "precharge": "Before serialization, bound canonical encoded metadata<=8192 and decoded strings<=16384 per live copy plus256 per record; charge sender and receiver at overlap. Each control<=256 encoded bytes, plus decoded copy/record; at most one outstanding doorbell per active slot. Reserve READY+terminal separately.",
        "release": "Doorbell after observed ownership CAS; metadata only after all consumers done. No unbounded port queue."
      },
      {
        "id": "source-context",
        "precharge": "Bound complete guest+trusted interpreted input to256KiB UTF8, plus each raw staging buffer, decoded UTF16<=524288 and simultaneous Worker/engine return/injection copies. Context encoded<=65536 with decoded/copy bound per actual finite schema. Trusted scaffold counts in combined input cap; guest usable remainder must be disclosed.",
        "release": "Byte input after complete owned handoff; strings/journal references only after their owner closes. Parser/AST allocation is separately qualified, not silently released."
      },
      {
        "id": "write-output",
        "precharge": "Before bridge admission require primitive string bounds; before encode reserve original retained string2*units, full encoded bytes N, parent staging N, each simultaneous transfer copy and frame scratch. N<=1048576; stage ALL N before effect. Output includes LF/console formatting bytes and awaits sink publication.",
        "release": "No early ACK-based release of source/staging; release after producer no longer references and actual operation+cleanup closed. Partial staging at cutoff is discarded without VFS/sink call."
      },
      {
        "id": "read-result",
        "precharge": "At header reserve full raw result allowance<=1048576, decoded UTF16 worst-case2*1048576, encoded result<=1048576, Worker assembly<=1048576, Worker decoded string<=2*1048576 and all bridge/journal simultaneous copies. Sum against current live16MiB before acquisition, refuse if insufficient.",
        "release": "Borrowed fragment copied before advance; assembled parent result after last transport read/retirement; Worker decoded/return references after qualified handoff and engine owner retirement. UTF8 replacement expansion exceeding response cap is a profile failure, not truncation."
      },
      {
        "id": "cache",
        "precharge": "Up to32 JSON entries, cumulative successful input<=1048576 raw UTF8; each256-byte root record, canonical key string, retained decoded text/copy charged while live. Up to4 fixed module root records; only fs/path/process selected. Cache hits consume authorization seq/ordinal but no extra JSON read or fresh cached graph.",
        "release": "No invalidation on VFS write and no mid-invocation root eviction to replenish quota. Release cache roots only after actual Worker exit. Mutated guest graph remains engine-accounted/qualified, not estimated from original JSON text."
      },
      {
        "id": "errors-capture",
        "precharge": "One bounded outcome record per seq, each permitted field charged before encoding/copy; each finite error<=8192 metadata, message/path/dest<=1024 UTF8. Trusted Worker native stdout/stderr separately captured with fixed pre-reserved capacities, aggregate within existing1MiB output cap as a conservative private charge, not ambient guest output authority.",
        "release": "Known undelivered failures survive ACK/FREE. Raw parent reason stored by reference outside DTO; identity never copied/serialized. Capture closes after actual exit; all cleanup errors retained."
      }
    ],
    "boundaries": [
      {
        "id": "B-memory",
        "limit": "16MiB bounds named logical command-owned reservations ONLY. Preexisting caller/error graphs, engine object overhead, native allocations/external memory, parser graphs, host journals and bridge clone machinery are not proven bounded by this ledger.",
        "required": "Seal actual overlap/lifetime accounting and enforceable precharge hooks or truthful admitted bounds for command-owned bridge/journal/clone allocations; otherwise provider qualification blocked. Never charge an unknown allocation as0."
      },
      {
        "id": "B-producer",
        "limit": "A producer may allocate/yield an oversized chunk before consumer rejection. Consumers can bound retained copies, not arbitrary producer allocation.",
        "required": "Qualification must bind cooperative producer chunk/ownership and cleanup limits plus sink behavior. No universal real-adapter exclusion or acceptance claimed."
      },
      {
        "id": "B-launch",
        "limit": "Worker old32/young8/code8/stack4MiB are not wholeguest8MiB/RSS or OS isolation.",
        "required": "Pin static parent/Worker entry and entire legitimate public dependency closure, launch flags and native environment, tools and parent containment. Explicit eval:false, no loaders/preloads/guest NODE_OPTIONS, no child Worker; bounded separate trusted-runtime stdio. Parent launch overrides and host uncooperative behavior remain unqualified. Worker launch explicitly uses execArgv:[] and native env:{}; modeled guest env stays injected data, not native launch configuration. Do not read ambient credentials/environment data or forward guest loader/V8 settings. Clearing Worker options does not qualify parent V8 launch overrides."
      }
    ],
    "deadline": {
      "start": "5000ms from command ownership enrollment, includes startup/source preparation",
      "normalCutoff": "Close admission timer; do not abort preadmitted VFS work or reset counters. Zero deliberate postcutoff guest service.",
      "failureOrCancellation": "Latch stop/wake and REQUEST termination immediately, zero grace; cancel cooperative parent work with authenticated provenance; await actual exit and registered cleanup.",
      "drain": "No5s completion bound, fresh grace or100ms clean receipt. Caller cancellation remains active until public settlement; unknown exit/unclosed parent work remains owned/unsettled."
    }
  },
