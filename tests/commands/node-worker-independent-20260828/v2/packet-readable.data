      "ENOTSUP",
      "EOPNOTSUPP",
      "EPERM",
      "EPIPE",
      "EROFS",
      "ETIMEDOUT",
      "EXDEV"
    ],
    "FsErrorDTO": {
      "requiredKeys": [
        "name",
        "code",
        "message",
        "errno",
        "path",
        "syscall",
        "dest"
      ],
      "name": "FsError",
      "code": "exact member of fsCodes",
      "message": "actual authorized own string <=1024 UTF8 bytes",
      "errno": "actual own finite safe integer; reject -0; no invented platform-independent mapping",
      "path": "null if absent; otherwise actual authorized own virtual-path string <=1024 UTF8 bytes",
      "syscall": "null if absent; otherwise actual own string <=1024 UTF8 bytes",
      "dest": "null if absent; otherwise actual authorized own virtual-destination string <=1024 UTF8 bytes",
      "wire": "Encoded together within8192 metadata bytes, including all escaping and envelope. Source absent optional property maps to null sentinel; receiver omits it. Present undefined/null/nonstring/accessor is not absent and fails profile extraction. No stack,cause,prototype,arbitrary properties or host object references."
    },
    "extraction": [
      "Capture parent thrown value and actual route/provenance before inspecting error metadata. Root caller/control, sink and cleanup failures never become ordinary FS errors by matching code or reason equality. Preserve false/undefined/object identity in parent-owned records with explicit presence.",
      "Recognize ordinary FS failure only on the enrolled FS operation route with legitimate contract authority: existing parent-local isFsError for actual FsError, or an explicitly trusted truthful adapter attestation for cross-realm typed errors. The latter is a qualification obligation, not a new brand/API. Generic {code:...}, Error.code or toFsError coercion cannot authenticate typed origin.",
      "Extract own data descriptors only; do not call getters/coerce values. Exact finite wire schema is independent of realm prototype identity. Parent Error may possess stack/cause internally: never serialize them; retain original parent value. Check available own name/code/message/errno and optional path/syscall/dest against authorized bounds before metadata encoding.",
      "All28 codes, including ECANCELED/ELOOP/ENAMETOOLONG, remain ordinary FS errors when actually typed and no authenticated cancellation provenance exists. EOPNOTSUPP retains its code and supplied errno even if the host constructor maps its numeric errno via ENOTSUP. No portable errno numbers are guessed.",
      "Unknown code, missing/invalid required field, unsupported typed origin, overlimit/unauthorized metadata or arbitrary host throw: retain exact original as escaping parent failure and record private-profile classification. Do not synthesize ENOENT/EIO/denial, successful undefined or a forged code-bearing guest error. No arbitrary host-error object escape; no diagnostic if authority/bounds absent."
    ],
    "guestReconstruction": "For valid DTO construct a Worker-local ordinary error with own finite metadata, never parent identity; null sentinel omits optional field. Qualify actual bridge name/code/message/errno/path/syscall/dest preservation before promising corresponding guest fields. Pinned bridge selectively copies own typed metadata, but this is not a runtime field-completeness pass. If required name/field cannot survive, provider remains unqualified; do not silently delete it.",
    "routes": [
      {
        "route": "facade arity/type/encoding or computed unsupported target",
        "result": {
          "name": "Error",
          "code": "ERR_VNODE_UNSUPPORTED",
          "message": "bounded authorized profile diagnostic"
        },
        "semantics": "Catchable guest refusal before that operation; earlier effects retained. Literal unsupported syntax/require and entry usage fail preflight/profile instead."
      },
      {
        "route": "valid request without required grant",
        "result": {
          "name": "Error",
          "code": "ERR_VNODE_DENIED",
          "message": "bounded authorized grant diagnostic"
        },
        "semantics": "No FS/sink admission; ordinary guest denial, not fabricated EACCES/EROFS. Source grant refusal is terminal profile2 after cleanup."
      },
      {
        "route": "real typed FS failure",
        "result": "FsErrorDTO",
        "semantics": "No successful prefix; actual partial write effects retained. Only qualified delivery before cutoff permits guest handling without automatic escaping parent failure."
      },
      {
        "route": "wire protocol or private limit/deadline failure",
        "result": "private-profile-failure",
        "semantics": "Close admission, stop/wake and request termination; no new response service/effect. Raw classification separately retained; numeric2 only after actual exit/cleanup and only if no higher-priority actual failure."
      },
      {
        "route": "guest evaluation failure",
        "result": "guest-error",
        "semantics": "Bounded diagnostic only with explicit stderr authority and budget; failed diagnostic is an actual sink failure, not masked by1."
      },
      {
        "route": "parent caller/control/sink/cleanup/arbitrary host rejection",
        "result": "actual parent presence/value/provenance plus retained secondary records, never wire DTO",
        "semantics": "Preserve bound priority and existing Shell mapping after cleanup. No code-name/identity-equality inference or conversion to clean numeric2."
      }
    ],
    "outcomes": {
      "raw": "intentional-retirement|guest-error|private-profile-failure|control|escaping-parent-failure; unresolved ownership is pending, not a settled result",
      "mapping": "0/1/2 respectively for first three only with confirmed Worker exit AND parent cleanup and no overriding actual failure. Unknown guest jobs remain unknown; known undelivered parent rejection prevents clean0.",
      "priority": "src/contracts/command.md and live AGENTS: root caller > escaping execution/control > local cancellation; exact selected execution rejection unchanged. Cleanup-only single failure unchanged, multiple failures AggregateError as bound. Preserve all secondaries without mutating/replacing primary; no ordering invented among same-tier failures.",
      "mappingGap": "Exact future provider-to-actual-Shell implementation/source/public-consumer witness is still required; this data creates no new Shell Budget, status-based provenance or public error API."
    },
    "realmRule": "Validate finite own data, exact keys/types/order, no holes/accessors/extras/coercion/prototype equality. Trusted local FsError origin recognition is not a cross-realm DTO validator. Host proxies cannot be safely assumed absent or introspection-free; admission requires trusted host contract, not sandbox claims."
  },
