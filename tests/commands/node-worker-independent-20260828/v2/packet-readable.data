  "ERRORS.json": {
    "schema": "WRQ-errors-v2",
    "status": "Complete pinned typed-code vocabulary; guest reconstruction and host mapping qualification pending",
    "binding": {
      "commit": "700651e5ec6f50435a0298845c411a8f2a5a386f",
      "path": "src/contracts/errors.ts",
      "codes": 28,
      "source": "Existing FsError/isFsError contract, not copied host shapes or toFsError fallback"
    },
    "fsCodes": [
      "EACCES",
      "EAGAIN",
      "EBADF",
      "EBUSY",
      "ECANCELED",
      "EEXIST",
      "EFBIG",
      "EINTR",
