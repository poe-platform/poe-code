      "errorMessageUtf8BytesMax": 1024,
      "operationTextBytesMax": 1048576,
      "readBytesCumulativeMax": 4194304,
      "writeBytesCumulativeMax": 4194304,
      "outputBytesCumulativeMax": 1048576,
      "commandOwnedLiveReservedBytesMax": 16777216,
      "sourceUtf8BytesMax": 262144,
      "contextEncodedBytesMax": 65536,
