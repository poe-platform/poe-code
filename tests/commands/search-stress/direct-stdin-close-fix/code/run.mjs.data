import { spawn, execFileSync } from 'node:child_process';
import { writeFileSync, readFileSync } from 'node:fs';
import { join } from 'node:path';
import { loadavg } from 'node:os';
import { createHash } from 'node:crypto';

const task = '/tmp/safe-bash-search-stdin-close-fix-20260827';
const [label, candidate, ...args] = process.argv.slice(2);
const env = { ...process.env, PATH: `${task}/native-bin:/Users/kjopek/.nvm/versions/node/v22.22.2/bin:/usr/bin:/bin`, HOME: `${task}/home`, TMPDIR: `${task}/tmp`, TMP: `${task}/tmp`, TEMP: `${task}/tmp`, TSX_CACHE_DIR: `${task}/tmp/tsx`, TSX_DISABLE_CACHE: '1', LANG: 'C', LC_ALL: 'C', TZ: 'UTC', RIPGREP_CONFIG_PATH: '', NO_COLOR: '1' };
delete env.NODE_OPTIONS; delete env.NODE_TEST_CONTEXT;
const start = Date.now();
const record = { label, cwd: join(task,candidate), executable: process.execPath, args, startedAt: new Date().toISOString(), loadavg: loadavg(), env, candidateManifestSha256: createHash('sha256').update(readFileSync(join(task, candidate === 'before' ? 'qualification.json' : 'candidate.json'))).digest('hex'), signals: [] };
const child = spawn(process.execPath, args, {cwd: record.cwd, env, detached:true, stdio:['ignore','pipe','pipe']});
record.pid = child.pid;
const stdout = []; const stderr = [];
child.stdout.on('data', chunk => stdout.push(chunk)); child.stderr.on('data', chunk => stderr.push(chunk));
const watchdog = setTimeout(() => { record.signals.push('SIGTERM watchdog'); process.kill(-child.pid,'SIGTERM'); }, 60000);
const killguard = setTimeout(() => { record.signals.push('SIGKILL watchdog'); process.kill(-child.pid,'SIGKILL'); }, 65000);
await new Promise((resolve,reject) => { child.on('error',reject); child.on('close',(status,signal) => {record.status=status; record.signal=signal; resolve();}); });
clearTimeout(watchdog); clearTimeout(killguard);
record.endedAt = new Date().toISOString(); record.elapsedMs = Date.now()-start; record.closed = true;
const processes = execFileSync('/bin/ps',['-axo','pid=,ppid=,pgid=,comm='],{env}).toString();
record.survivors = processes.split('\n').filter(line => Number(line.trim().split(/\s+/)[2]) === child.pid);
writeFileSync(join(task,'logs',label+'.process-final.data'), processes);
writeFileSync(join(task,'logs',label+'.stdout.data'),Buffer.concat(stdout));
writeFileSync(join(task,'logs',label+'.stderr.data'),Buffer.concat(stderr));
writeFileSync(join(task,'logs',label+'.json'),JSON.stringify(record,null,2)+'\n');
console.log(JSON.stringify({ label, status:record.status, signal:record.signal, elapsedMs:record.elapsedMs, survivors:record.survivors, signals:record.signals }));
console.log(Buffer.concat(stdout).toString()); console.error(Buffer.concat(stderr).toString());
process.exitCode = record.status ?? 1;
