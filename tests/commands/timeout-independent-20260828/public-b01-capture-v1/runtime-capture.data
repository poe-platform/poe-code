      const rawProbe=rawInputProbe(),originalDefinition=aggregate({scheduler:timing.scheduler});
      let capturedAcquisitionReason;const captureOrder=[];
      const definition=config.boundaryControl?.id==='B01'?{...originalDefinition,execute(context){return captureBeforeRethrow(()=>{captureOrder.push('invoke');context.stdin[Symbol.asyncIterator]();return originalDefinition.execute(context);},reason=>{capturedAcquisitionReason=reason;captureOrder.push('capture');preserveDiagnostic('R12-raw-before-assertion',{vectorIndex,argv:vector.argv,counts:structuredClone(rawProbe.counts),outcome:diagnosticOutcome({status:'rejected',reason},reason),capturePhase:'before-rethrow',captureOrder:[...captureOrder]});});}}:originalDefinition;
      let raw;
      try{raw=await direct(definition,vector.argv,{stdin:rawProbe.source,invoke:()=>{counts.rawInvoke++;assert.fail('invalid invoke');}});}catch(reason){captureOrder.push('rethrow-observed');preserveDiagnostic('B01-rethrow-identity',{vectorIndex,counts:structuredClone(rawProbe.counts),sameReason:Object.is(reason,capturedAcquisitionReason),outcome:diagnosticOutcome({status:'rejected',reason},capturedAcquisitionReason),captureOrder:[...captureOrder]});throw reason;}
