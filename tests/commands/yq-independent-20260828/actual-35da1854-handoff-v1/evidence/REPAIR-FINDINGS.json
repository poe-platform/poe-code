        {
          "source": {
            "artifact": "selected:src/commands/yq/parser.ts",
            "pointer": ""
          },
          "blob": "be98c79b3987267545e80b132496afdb72319206",
          "sha256": "ec3c47823eca85730af613f460bf98d28182ea28a68473eb7e596dc780334a79",
          "firstLine": 855,
          "lastLine": 863,
          "text": "function rawLines(text: string): SourceLine[] {\n  const normalized = text.replace(/\\r\\n|\\r/gu, \"\\n\");\n  const finalBreak = normalized.endsWith(\"\\n\");\n  const pieces = normalized.split(\"\\n\");\n  if (pieces[pieces.length - 1] === \"\") pieces.pop();\n  return pieces.map((line, index) => {\n    const hadBreak = index < pieces.length - 1 || finalBreak;\n    return { text: line, number: index + 1, rawBytes: Buffer.byteLength(line) + (hadBreak ? 1 : 0), hadBreak };\n  });"
        },
        {
          "source": {
            "artifact": "selected:src/commands/yq/parser.ts",
            "pointer": ""
          },
          "blob": "be98c79b3987267545e80b132496afdb72319206",
          "sha256": "ec3c47823eca85730af613f460bf98d28182ea28a68473eb7e596dc780334a79",
          "firstLine": 935,
          "lastLine": 938,
          "text": "export async function* parseYamlDocuments(text: string, work: YqOwnedWork, ledger: YqLedger): AsyncGenerator<Json> {\n  if (!wellFormed(text)) throw new YqError(\"input\", \"INPUT_INVALID_UTF8\", 5);\n  for (const document of documents(text)) {\n    ledger.beginDocument(document.rawBytes);"
        }
