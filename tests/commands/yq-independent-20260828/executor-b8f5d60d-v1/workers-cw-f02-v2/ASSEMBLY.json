    },
    {
      "before": "    status = projection.status === 'BOUND_PROJECTION_ONLY' && baselineMatches(facts, witness) ? 'PASS' : 'FAIL';\n    classification = status === 'PASS' ? 'ACTUAL_PRISTINE_LOAD_AND_WITNESS' : 'PRISTINE_WITNESS_FAILURE';\n    baseline = { projection };\n",
