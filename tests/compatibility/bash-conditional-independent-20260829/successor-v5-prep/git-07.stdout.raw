  receipt.pid = child.pid;
  done = new Promise(resolve => { child.once('error', error => { receipt.spawnError = String(error); }); child.once('close', (code, signal) => { receipt.closed = true; receipt.code = code; receipt.signal = signal; resolve(); }); });
