  const denied = shellFor(memory, { git: { discoveryBoundary: '/repo/sub' } }, '/repo/sub'); const bad = await denied.exec('git rev-parse HEAD'); assert.equal(bad.exitCode, 128); assert.equal(bad.stdout, ''); assert.ok(bad.stderr.length > 0);
});
