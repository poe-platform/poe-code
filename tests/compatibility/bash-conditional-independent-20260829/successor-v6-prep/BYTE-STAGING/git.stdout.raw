    {"id":"U07","program":"set -u; set -o; printf '%s\\n' after","question":"Missing o operand/listing remains explicit supported-profile gap","basis":"OUTSIDE-P1"},
    {"id":"U08","program":"set -eu; printf '%s\\n' \"$-\"; set +u; printf '%s\\n' \"$-\"","question":"Actual e/u visibility; native extra flags retained as differences","basis":"P1"},
    {"id":"U09","program":"printf '<%s>\\n' \"$missing\"","question":"Default nounset off","basis":"ROOT"},
    {"id":"U10","program":"set -u; printf '<%s>\\n' \"$missing\"; printf '%s\\n' after","question":"Fatal unguarded scalar expansion and no later statement","basis":"G1/P4"},
    {"id":"U11","program":"set -u; empty=; printf '<%s>\\n' \"$empty\"","question":"Empty value is set","basis":"G2"},
    {"id":"U12","program":"set -u; empty=; printf '%s|%s|%s|%s\\n' \"${missing-default}\" \"${missing:-default}\" \"${empty-default}\" \"${empty:-default}\"","question":"Unset versus empty colon tests","basis":"G2"},
    {"id":"U13","program":"set -u; empty=; printf '<%s>|<%s>|<%s>|<%s>\\n' \"${missing+yes}\" \"${missing:+yes}\" \"${empty+yes}\" \"${empty:+yes}\"","question":"Alternative presence tests without eager read failure","basis":"G2"},
    {"id":"U14","program":"set -u; printf '%s\\n' \"${missing:=ok}\"; printf '%s\\n' \"$missing\"","question":"Guarded assignment creates value","basis":"G2"},
