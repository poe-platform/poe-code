100:     const build = await child('strict-build', [compiler, ...seal.tscFlags, '--typeRoots', typeRoots, '--declaration', '--outDir', emitted, ...seal.sources.map(entry => join(source, basename(entry.path)))], work, 120000);
101:     if (build.code !== 0) throw new Error('ORDINARY compiler failure; dependent product loads withheld');
102:     await writeFile(join(emitted, 'package.json'), '{"type":"module","private":true}\n'); const emittedBindings = await census(emitted);
103:     const rows = []; const types = [];
104:     async function runCases(role, directory, target = false, selection = 'all', mutated = null) {
105:       const script = target ? join(own, 'checkpoints.mjs') : join(author, 'suite.mjs');
106:       const args = target ? [script,directory,selection] : [script,directory,join(author,'cases.json')];
107:       const result = await child(role,args,work);
108:       const records = result.stdout.trim().split('\n').map(line => JSON.parse(line));
109:       const observed = records.find(record => record.event === 'results'); const loaded = records.find(record => record.event === 'loaded');
110:       if (!observed || !loaded || observed.rows.length === 0 || result.code !== (observed.fail ? 1 : 0)) throw new Error('SAFETY result/exit/capture mismatch');
111:       assert.equal(loaded.execPath, seal.node.path, 'SAFETY child binary');
112:       for (const [name, entry] of Object.entries(loaded.files)) {
113:         const expected = emittedBindings.find(item => basename(item.path) === `${name}.js`);
114:         const actual = await hash(join(directory, `${name}.js`)); assert.equal(entry.sha256, actual.sha256, 'SAFETY loaded witness');
115:         if (name === mutated) assert.notEqual(entry.sha256, expected.sha256); else assert.equal(entry.sha256, expected.sha256, 'SAFETY artifact member binding');
116:       }
117:       rows.push({ role, mutated, exitCode: result.code, observed, loaded }); return observed;
118:     }
119:     const app = join(work,'installed-app'); await mkdir(join(app,'artifact'),{recursive:true}); await writeFile(join(app,'package.json'),'{"type":"module"}\n');
120:     for (const entry of emittedBindings) await copyFile(entry.path,join(app,'artifact',basename(entry.path)));
