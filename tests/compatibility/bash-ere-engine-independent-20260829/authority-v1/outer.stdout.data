{"source":"f97fd06024cb63edfd01873d81d84576a22189db","inputs":[{"path":"engine/2.data","bytes":8470,"mode":384,"sha256":"d9eb7ec7b18648ddcbd853085aef6972cd5938d3817df458796b0a7354b0abeb"},{"path":"design/2.data","bytes":19409,"mode":384,"sha256":"7fb1f7348ba43c9e036ed71806061206d8be45ec77f3853fb89425bc0719b615"},{"path":"witnesses/cases.json.data","bytes":4114,"mode":384,"sha256":"c19afeb49fc6f830aeeafcd6464fe9bb30da1504d9964ac3f2f7d2e7f5bc919b"},{"path":"SUMMARY.json","bytes":34683,"mode":384,"sha256":"c4cbd72d05136a8a7432a2c4600d7922c9efe23a8bab24cbf5f776fde090a9c8"}],"failures":[{"layout":"source","ids":["I01-parent-optional-reset","I02-parent-alternative-reset","I03-nested-parent-reset","I04-manual-example","I05-finite-parent-reset","I06-parent-zero-iteration","I23-finite-reset-property"]},{"layout":"installed","ids":["I01-parent-optional-reset","I02-parent-alternative-reset","I03-nested-parent-reset","I04-manual-example","I05-finite-parent-reset","I06-parent-zero-iteration","I23-finite-reset-property"]},{"layout":"moved","ids":["I01-parent-optional-reset","I02-parent-alternative-reset","I03-nested-parent-reset","I04-manual-example","I05-finite-parent-reset","I06-parent-zero-iteration","I23-finite-reset-property"]}],"authorE12":{"id":"E12","pattern":"(a(b)?)+","subject":"aba","values":["aba","a","b"],"spans":[[0,3],[2,3],[1,2]]},"designLines":[{"line":87,"text":"   subject search, not whole-string matching; anchors refer to original endpoints,"},{"line":88,"text":"   not each suffix. With the source's no-REG_NEWLINE flag, newline is not secretly"},{"line":89,"text":"   line-delimited. Empty matches are real matches, including end-of-input."},{"line":90,"text":"3. Return every group in the admitted grammar, including overall0, unambiguously"},{"line":91,"text":"   distinguishing nonparticipation from a zero-length span internally. Publish"},{"line":92,"text":"   every index0..N on success (empty strings for unmatched captures, pending pinned"},{"line":93,"text":"   confirmation), not a one-group limit or dropped trailing empties. Group cap32"},{"line":94,"text":"   is an explicit grammar boundary; cap excess is never silent truncation."},{"line":95,"text":"4. Refuse reached ERE backreferences initially (BRE support does not establish an"},{"line":96,"text":"   ERE extension), lookaround, named/noncapturing groups, collating/equivalence"},{"line":97,"text":"   elements, locale-dependent non-ASCII classes and ambiguous extension escapes."},{"line":98,"text":"   Do not mark quoted lookalikes unsupported. Refuse stacked/shortest modifiers in"},{"line":99,"text":"   this first profile. POSIX-undefined constructs require a documented choice,"},{"line":100,"text":"   not invented native goldens."},{"line":101,"text":"5. Captured nullable repetition is the highest algorithmic risk. Recommend first"},{"line":102,"text":"   refusing a repetition with maximum>1 whose nullable operand contains captures,"},{"line":103,"text":"   until reset/history/zero-progress proof is supplied. Ordinary nonnullable"},{"line":104,"text":"   captured repetition must still implement last-iteration/nested participation"},{"line":105,"text":"   correctly; `(a(b)?)+` cannot reuse stale inner capture state by assumption."},{"line":106,"text":"   Refusal is profile2, not false. This is a useful subset with complete captures,"},{"line":107,"text":"   **not full POSIX ERE**. ROOT may instead fund the larger tagged-history engine."}],"cooperativeDesignLines":[{"line":156,"text":"cleanup precedence and raw reason identity, including falsy reasons."},{"line":157,"text":""},{"line":158,"text":"Alternative: a new cooperative main-thread interpreter avoids Worker transport,"},{"line":159,"text":"but requires awaited checkpoints in parser/compiler/search/tag-comparison loops"},{"line":160,"text":"and explicit ownership of its async task. Merely removing expr's isMainThread"},{"line":161,"text":"guard or wrapping its synchronous50M-step loop in a Promise is unacceptable."}],"historyOrder":[{"line":29,"text":""},{"line":30,"text":"async function historyOrder(left: History | null, right: History | null, ledger: EreLedger, signal?: AbortSignal): Promise<number> {"},{"line":31,"text":"  const leftCount = left?.count ?? 0;"},{"line":32,"text":"  const rightCount = right?.count ?? 0;"},{"line":33,"text":"  for (let ordinal = 1; ordinal <= Math.min(leftCount, rightCount); ordinal++) {"},{"line":34,"text":"    ledger.charge(\"work\", 1, signal);"},{"line":35,"text":"    let leftEntry = left!;"},{"line":36,"text":"    let rightEntry = right!;"},{"line":37,"text":"    for (let remaining = leftCount; remaining > ordinal; remaining--) {"},{"line":38,"text":"      ledger.charge(\"work\", 1, signal);"},{"line":39,"text":"      if (remaining % 256 === 0) await ledger.checkpoint(signal);"},{"line":40,"text":"      leftEntry = leftEntry.previous!;"},{"line":41,"text":"    }"},{"line":42,"text":"    for (let remaining = rightCount; remaining > ordinal; remaining--) {"},{"line":43,"text":"      ledger.charge(\"work\", 1, signal);"},{"line":44,"text":"      if (remaining % 256 === 0) await ledger.checkpoint(signal);"},{"line":45,"text":"      rightEntry = rightEntry.previous!;"},{"line":46,"text":"    }"},{"line":47,"text":"    const compared = spanOrder(leftEntry.span, rightEntry.span);"},{"line":48,"text":"    if (compared !== 0) return compared;"},{"line":49,"text":"  }"},{"line":50,"text":"  return leftCount - rightCount;"},{"line":51,"text":"}"},{"line":52,"text":""},{"line":53,"text":"async function preferred(candidate: State, incumbent: State, ledger: EreLedger, signal?: AbortSignal): Promise<boolean> {"},{"line":54,"text":"  if (candidate.position !== incumbent.position) return candidate.position > incumbent.position;"},{"line":55,"text":"  for (let group = 1; group < candidate.captures.length; group++) {"},{"line":56,"text":"    ledger.charge(\"work\", 1, signal);"},{"line":57,"text":"    const compared = await historyOrder(candidate.histories[group]!, incumbent.histories[group]!, ledger, signal);"},{"line":58,"text":"    if (compared !== 0) return compared > 0;"},{"line":59,"text":"  }"},{"line":60,"text":"  return false;"},{"line":61,"text":"}"}],"groupEntry":[{"line":145,"text":"        case \"group\": {"},{"line":146,"text":"          const close = task(() => ({ kind: \"close\", group: node.index, start: state.position, next: current.next }));"},{"line":147,"text":"          push(state.position, task(() => ({ kind: \"node\", node: node.child, next: close })), state.captures, state.histories);"},{"line":148,"text":"          break;"},{"line":149,"text":"        }"},{"line":150,"text":"        case \"repeat\":"}],"arithmetic":{"entries":255,"units":65025,"checkpoints":0,"role":"finite DATA arithmetic; no matcher call"},"native":"UNRUN","newProductLoads":0,"elapsedMs":153}
