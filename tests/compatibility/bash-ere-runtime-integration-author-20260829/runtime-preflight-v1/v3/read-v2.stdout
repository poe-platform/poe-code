5: export class InvocationScope {
6:   readonly #children = new Set<InvocationScope>();
7:   readonly #callbacks: InvocationCleanup[] = [];
8:   readonly #controller = new AbortController();
9:   #closed = false;
10:   #drain: Promise<void> | undefined;
11: 
12:   constructor(
13:     readonly callerSignal?: AbortSignal,
14:     readonly failures: unknown[] = [],
15:     readonly parent?: InvocationScope,
16:   ) {}
17: 
18:   get signal(): AbortSignal { return this.#controller.signal; }
19: 
20:   assertOpen(): void {
21:     this.callerSignal?.throwIfAborted();
22:     if (this.#closed) throw this.signal.reason;
23:     this.parent?.assertOpen();
24:   }
25: 
26:   child(): InvocationScope {
27:     this.assertOpen();
28:     const child = new InvocationScope(this.callerSignal, this.failures, this);
29:     this.#children.add(child);
30:     return child;
31:   }
32: 
33:   register(cleanup: InvocationCleanup): void {
34:     this.assertOpen();
35:     if (typeof cleanup !== "function") throw new TypeError("Cleanup must be callable");
36:     this.#callbacks.push(cleanup);
37:   }
38: 
39:   #seal(): void {
40:     if (this.#closed) return;
41:     this.#closed = true;
42:     for (const child of this.#children) child.#seal();
43:     this.#controller.abort(new Error("Invocation is closed"));
44:   }
45: 
46:   close(): Promise<void> {
47:     if (!this.#drain) {
48:       this.#drain = Promise.resolve().then(async () => {
49:         await Promise.all([
50:           ...this.#callbacks.map(async (cleanup) => {
51:             try { await cleanup(); } catch (error) { this.failures.push(error); }
52:           }),
53:           ...[...this.#children].map((child) => child.close()),
54:         ]);
55:       });
56:       this.#seal();
57:     }
58:     return this.#drain;
59:   }
60: }
61: 
62: export function throwCleanupFailures(failures: readonly unknown[]): void {
63:   if (failures.length === 1) throw failures[0];
64:   if (failures.length) throw new AggregateError(failures, "Invocation cleanup failed");
65: }
