1: import { Worker } from "node:worker_threads";
2: import type { Readable } from "node:stream";
3: import type { TransportAccounting } from "./accounting.js";
4: import { EreTransportError, operation } from "./protocol.js";
5: import type { EreTransportRequest } from "./protocol.js";
6: import { record } from "./validation.js";
7: 
8: interface Pending {
9:   readonly resolve: (value: unknown) => void;
10:   readonly reject: (reason: unknown) => void;
11:   readonly timer: ReturnType<typeof setTimeout>;
12: }
13: 
14: export class EreWorkerOwner {
15:   #worker: Worker | undefined;
16:   #exited: Promise<void> | undefined;
17:   #exitResolve: (() => void) | undefined;
18:   #ready: Promise<void> | undefined;
19:   #readyResolve: (() => void) | undefined;
20:   #readyReject: ((reason: unknown) => void) | undefined;
21:   #startupTimer: ReturnType<typeof setTimeout> | undefined;
22:   #pending: Pending | undefined;
23:   #request: Promise<unknown> | undefined;
24:   #stdout: Promise<void> | undefined;
25:   #stderr: Promise<void> | undefined;
26:   #closing: Promise<void> | undefined;
27:   #failed = false;
28:   #failure: unknown;
29:   #readySeen = false;
30:   #exitListenerInstalled = false;
31:   #notificationFailed = false;
32:   #notificationFailure: unknown;
33:   constructor(readonly onFailure: (reason: unknown) => void, readonly transport: TransportAccounting) {}
34: 
35:   #settle(reason: unknown): void {
36:     clearTimeout(this.#startupTimer); this.#startupTimer = undefined;
37:     this.#readyReject?.(reason);
38:     this.#readyReject = undefined; this.#readyResolve = undefined;
39:     const pending = this.#pending; this.#pending = undefined;
40:     if (pending) { clearTimeout(pending.timer); pending.reject(reason); }
41:   }
42: 
43:   #fail(reason: unknown): void {
44:     if (this.#failed) return;
45:     this.#failed = true; this.#failure = reason;
46:     this.#settle(reason);
47:     try { this.onFailure(reason); }
48:     catch (notificationFailure) { this.#notificationFailed = true; this.#notificationFailure = notificationFailure; }
49:     void this.close().catch(() => {});
50:   }
51: 
52:   #stream(stream: Readable): Promise<void> {
53:     const ended = new Promise<void>(resolve => {
54:       stream.once("end", resolve); stream.once("close", resolve);
55:       stream.on("error", (reason: unknown) => this.#fail(reason));
56:       stream.on("data", () => this.#fail(new EreTransportError("PROTOCOL", "unexpected ERE Worker output")));
57:       if (stream.readableEnded || stream.closed) resolve();
58:     });
59:     return ended;
60:   }
61: 
62:   start(): Promise<void> {
63:     if (this.#failed) return Promise.reject(this.#failure);
64:     if (this.#closing) return Promise.reject(new EreTransportError("CLOSED", "ERE Worker is closing"));
65:     if (!this.#ready) {
66:       this.#ready = new Promise<void>((resolve, reject) => { this.#readyResolve = resolve; this.#readyReject = reject; });
67:       void this.#ready.catch(() => {});
68:       this.#exited = new Promise<void>(resolve => { this.#exitResolve = resolve; });
69:       try {
70:         const worker = new Worker(new URL("./worker-entry.js", import.meta.url), {
71:           workerData: { operation, version: 1 }, env: {}, execArgv: [], stdout: true, stderr: true,
72:           resourceLimits: { maxOldGenerationSizeMb: 128, stackSizeMb: 4 },
73:         });
74:         this.#worker = worker;
75:         worker.once("exit", () => {
76:           this.#exitResolve?.();
77:           if (!this.#closing) this.#fail(new EreTransportError("WORKER_EXIT", "owned ERE Worker exited"));
78:         });
79:         this.#exitListenerInstalled = true;
80:         worker.on("error", (reason: unknown) => this.#fail(reason));
81:         worker.on("messageerror", (reason: unknown) => this.#fail(reason));
82:         this.#stdout = this.#stream(worker.stdout);
83:         this.#stderr = this.#stream(worker.stderr);
84:         worker.on("message", (message: unknown) => {
85:           if (this.#closing || this.#failed) return;
86:           try {
87:             if (!this.#readySeen) {
88:               const ready = record(message, ["version", "operation", "kind"], units => this.transport.visit(units), this.transport);
89:               if (ready.version !== 1 || ready.operation !== operation || ready.kind !== "ready") throw new EreTransportError("PROTOCOL", "invalid ERE startup frame");
90:               this.transport.visit(14);
91:               this.#readySeen = true; clearTimeout(this.#startupTimer); this.#startupTimer = undefined;
92:               this.#readyResolve?.(); this.#readyResolve = undefined; this.#readyReject = undefined; return;
93:             }
94:             const pending = this.#pending;
95:             if (!pending) throw new EreTransportError("PROTOCOL", "unsolicited ERE frame");
96:             this.#pending = undefined; clearTimeout(pending.timer); pending.resolve(message);
97:           } catch (reason) { this.#fail(reason); }
98:         });
99:         this.#startupTimer = setTimeout(() => this.#fail(new EreTransportError("STARTUP_TIMEOUT", "ERE startup timeout")), 3000);
100:       } catch (reason) {
101:         if (!this.#worker) this.#exitResolve?.();
102:         this.#fail(reason);
103:       }
104:     }
105:     return this.#ready;
106:   }
