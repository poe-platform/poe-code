35: export class EreLedger {
36:   readonly limits: EreLimits;
37:   #usage: Record<EreResource, number> = {
38:     patternBytes: 0, subjectBytes: 0, work: 0, states: 0, allocationUnits: 0, captureBytes: 0, captureSlots: 0,
39:   };
40:   #poison: EreUsageUnknownError | undefined;
41:   #lastYield = 0;
42: 
43:   constructor(bounds: EreExpansionBounds, lowering: Partial<EreLimits> = {}) {
44:     const limits = { ...deriveEreLimits(bounds) };
45:     for (const resource of Object.keys(lowering)) {
46:       if (!resources.includes(resource as EreResource)) throw new TypeError("unknown ERE limit");
47:       const key = resource as EreResource;
48:       const value = lowering[key];
49:       if (value === undefined) throw new TypeError("undefined ERE limit");
50:       integer(value);
51:       if (value > limits[key]) throw new RangeError("ERE limits may only be lowered");
52:       limits[key] = value;
53:     }
54:     this.limits = Object.freeze(limits);
55:   }
56: 
57:   get usage(): EreUsage { return Object.freeze({ ...this.#usage }); }
58: 
59:   check(signal?: AbortSignal): void {
60:     if (signal?.aborted) throw signal.reason;
61:     if (this.#poison) throw this.#poison;
62:   }
63: 
64:   charge(resource: EreResource, amount: number, signal?: AbortSignal): void {
65:     this.check(signal);
66:     integer(amount);
67:     if (amount > this.limits[resource] - this.#usage[resource]) {
68:       throw new EreProfileLimitError(resource, this.limits[resource]);
69:     }
70:     this.#usage[resource] += amount;
71:   }
72: 
73:   admitInput(resource: "patternBytes" | "subjectBytes", length: number, signal?: AbortSignal): void {
74:     this.check(signal);
75:     integer(length);
76:     if (length > this.limits[resource]) throw new EreProfileLimitError(resource, this.limits[resource]);
77:     this.#usage[resource] = Math.max(this.#usage[resource], length);
78:   }
79: 
80:   async checkpoint(signal?: AbortSignal): Promise<void> {
81:     this.check(signal);
82:     if (this.#usage.work - this.#lastYield >= 256) {
83:       this.#lastYield = this.#usage.work;
84:       await setImmediate();
85:       this.check(signal);
86:     }
87:   }
88: 
89:   markUnknownUsage(reason: unknown): void {
90:     this.#poison ??= new EreUsageUnknownError(reason);
91:   }
92: }
