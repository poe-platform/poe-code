161:       if (this.groups >= 32) throw new EreUnsupportedError("32-group grammar ceiling", begin);
162:       const index = ++this.groups;
163:       const child = await this.expression(depth + 1);
164:       if (!this.at(")")) throw new EreSyntaxError("unclosed group", begin);
165:       this.offset++;
166:       return this.node(() => ({ kind: "group", index, child, nullable: child.nullable, captured: true }));
167:     }
168:     if (character === "[") return this.set(begin);
169:     if (character === "\\") {
170:       const escaped = this.pattern[this.offset++];
171:       if (escaped === undefined) throw new EreSyntaxError("trailing escape", begin);
172:       if (!special.includes(escaped)) throw new EreUnsupportedError("backreference or escape extension", begin);
173:       return this.node(() => ({ kind: "literal", code: escaped.charCodeAt(0), nullable: false, captured: false }));
174:     }
175:     if (character === "*" || character === "+" || character === "?" || character === "{") throw new EreSyntaxError("repetition without operand", begin);
176:     if (character === ".") return this.node(() => ({ kind: "dot", nullable: false, captured: false }));
177:     if (character === "^") return this.node(() => ({ kind: "start", nullable: true, captured: false }));
178:     if (character === "$") return this.node(() => ({ kind: "end", nullable: true, captured: false }));
179:     return this.node(() => ({ kind: "literal", code: character.charCodeAt(0), nullable: false, captured: false }));
180:   }
