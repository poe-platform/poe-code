26: export class Admission implements Tickets {
27:   previous: Admission | undefined;
28:   next: Admission | undefined;
29:   owner: ArrayOwner | undefined;
30:   released = false;
31:   cleanup: (() => void) | undefined;
32:   restorationReferences = 0;
33: 
34:   constructor(
35:     readonly ledger: ArrayLedger,
36:     readonly wrappers: number,
37:     readonly slots: number,
38:     readonly payload: number,
39:     readonly metadata: number,
40:     readonly generation: number,
41:     readonly version: number,
42:     readonly epoch: number,
43:   ) {}
44: 
45:   release(): void {
46:     if (this.released) return;
47:     this.released = true;
48:     this.cleanup?.();
49:     this.owner?.detach(this);
50:     this.ledger.release(this);
51:   }
52: }
