8: export class OwnedText {
9:   references = 1;
10: 
11:   constructor(readonly value: string, readonly bytes: number, readonly admission: Admission) {}
12: 
13:   retain(): this {
14:     if (this.references === Number.MAX_SAFE_INTEGER) throw new ArrayFailure("reference capacity is not representable");
15:     this.references++;
16:     return this;
17:   }
18: 
19:   release(): void {
20:     if (--this.references === 0) this.admission.release();
21:   }
22: }
23: 
24: export async function textToken(owner: ArrayOwner, value: string, signal: AbortSignal): Promise<OwnedText> {
25:   let bytes = 0;
26:   for (let offset = 0; offset < value.length;) {
27:     const end = Math.min(value.length, offset + 64);
28:     owner.reserve({ work: end - offset }).release();
29:     while (offset < end) {
30:       const code = value.codePointAt(offset)!;
31:       bytes = exactSum(bytes, code <= 0x7f ? 1 : code <= 0x7ff ? 2 : code <= 0xffff ? 3 : 4);
32:       offset += code > 0xffff ? 2 : 1;
33:     }
34:     await owner.ledger.checkpoint(signal, 64);
35:   }
36:   const admission = owner.reserve({ payload: bytes, metadata: 32, work: 4 });
37:   return new OwnedText(value, bytes, admission);
38: }
39: 
40: export interface Element {
41:   readonly text: OwnedText;
42:   readonly slot: Admission;
43: }
44: 
45: export class IndexedBinding {
46:   readonly values = new Map<number, Element>();
47:   maximum = -1;
48:   generation = 0;
49:   version = 0;
50:   references = 1;
51: 
52:   private constructor(readonly owner: ArrayOwner) {}
53: 
54:   static create(parent: ArrayOwner): IndexedBinding {
55:     const owner = ArrayOwner.create(parent.ledger, parent);
56:     try {
57:       owner.reserve({ wrappers: 1, metadata: 128, work: 7 });
58:       return new IndexedBinding(owner);
59:     } catch (error) {
60:       void owner.close();
61:       throw error;
62:     }
63:   }
64: 
65:   get(index: number): string | undefined { return this.values.get(index)?.text.value; }
66: 
67:   retain(): this {
68:     if (this.references === Number.MAX_SAFE_INTEGER) throw new ArrayFailure("reference capacity is not representable");
69:     this.references++;
70:     return this;
71:   }
72: 
73:   release(): Promise<void> | undefined {
74:     if (--this.references === 0) return this.owner.close();
75:     return undefined;
76:   }
77: 
78:   insert(index: number, text: OwnedText): void {
79:     const slot = this.owner.reserve({ slots: 1, metadata: 32, work: 5 });
80:     const previous = this.values.get(index);
81:     const element = { text, slot };
82:     slot.cleanup = () => {
83:       if (this.values.get(index) === element) this.values.delete(index);
84:       text.release();
85:     };
86:     this.values.set(index, element);
87:     if (index > this.maximum) this.maximum = index;
88:     previous?.slot.release();
89:   }
90: 
91:   async copy(signal: AbortSignal): Promise<IndexedBinding> {
92:     const copy = IndexedBinding.create(this.owner.parent!);
93:     this.retain();
94:     try {
95:       for (const [index, element] of this.values) {
96:         copy.owner.reserve({ work: 2 }).release();
97:         const slot = copy.owner.reserve({ slots: 1, metadata: 32, work: 5 });
98:         const text = element.text.retain();
99:         const cloned = { text, slot };
100:         slot.cleanup = () => { if (copy.values.get(index) === cloned) copy.values.delete(index); text.release(); };
101:         copy.values.set(index, cloned);
102:         if (index > copy.maximum) copy.maximum = index;
103:         await copy.owner.ledger.checkpoint(signal, 2);
104:       }
105:       return copy;
106:     } catch (error) { await copy.release(); throw error; }
107:     finally { await this.release(); }
108:   }
109: 
110:   async indices(owner: ArrayOwner, signal: AbortSignal): Promise<number[]> {
111:     const size = this.values.size;
112:     owner.reserve({ metadata: exactSum(128, size * 64), allocatedSlots: size * 2, work: size * 4 + 6 });
113:     let indices: number[] = [];
114:     let scratch: number[] = [];
115:     for (const index of this.values.keys()) {
116:       indices.push(index);
117:       await owner.ledger.checkpoint(signal);
118:     }
119:     for (let width = 1; width < size; width *= 2) {
120:       for (let start = 0; start < size; start += width * 2) {
121:         let left = start;
122:         let right = Math.min(size, start + width);
123:         const leftEnd = right;
124:         const rightEnd = Math.min(size, start + width * 2);
125:         for (let destination = start; destination < rightEnd; destination++) {
126:           owner.reserve({ work: 2 }).release();
127:           scratch[destination] = left < leftEnd && (right >= rightEnd || indices[left]! <= indices[right]!) ? indices[left++]! : indices[right++]!;
128:           await owner.ledger.checkpoint(signal, 2);
129:         }
130:       }
131:       const temporary = indices;
132:       indices = scratch;
133:       scratch = temporary;
134:     }
135:     return indices;
136:   }
137: }
