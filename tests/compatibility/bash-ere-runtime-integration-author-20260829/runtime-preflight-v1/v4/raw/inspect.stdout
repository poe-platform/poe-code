148: export class BindingWatch {
149:   #closed = false;
150:   readonly generation: number;
151:   readonly version: number;
152:   readonly typedVersion: number;
153: 
154:   constructor(readonly store: BindingStore, readonly name: string, readonly watch: Watch, readonly admission: Admission) {
155:     this.generation = watch.generation;
156:     this.version = watch.version;
157:     this.typedVersion = watch.typedVersion;
158:   }
159: 
160:   valid(): boolean { return this.watch.generation === this.generation && this.watch.version === this.version; }
161: 
162:   close(): void {
163:     if (this.#closed) return;
164:     this.#closed = true;
165:     this.store.retire(this.name, this.watch);
166:     this.admission.release();
167:   }
168: }
