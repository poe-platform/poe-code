54: export class ArrayLedger {
55:   #caps: Counters | undefined;
56:   #used: Counters = [0, 0, 0, 0, 0, 0, 0];
57:   #lastIssued = 0;
58:   #checkpoint = 0;
59: 
60:   constructor(readonly bytes: number, readonly fields: number, initialTicket = 0) {
61:     if (!Number.isSafeInteger(initialTicket) || initialTicket < 0) throw new RangeError("Invalid private initial ticket");
62:     this.#lastIssued = initialTicket;
63:   }
64: 
65:   get active(): boolean { return this.#caps !== undefined; }
66: 
67:   snapshot(): { readonly caps: readonly number[] | undefined; readonly used: readonly number[]; readonly lastIssued: number } {
68:     return { caps: this.#caps?.slice(), used: this.#used.slice(), lastIssued: this.#lastIssued };
69:   }
70: 
71:   reserve(charge: Charge = {}): Admission {
72:     const caps = this.#caps ?? this.derive();
73:     let cursor = this.#lastIssued;
74:     const ticket = (requested: boolean | number | undefined, label: string): number => {
75:       if (!requested) return 0;
76:       const count = requested === true ? 1 : requested;
77:       if (!Number.isSafeInteger(count) || count < 0 || count > Number.MAX_SAFE_INTEGER - cursor) throw new ArrayFailure(`private ${label} capacity exhausted`);
78:       cursor += count;
79:       return cursor;
80:     };
81:     const generation = ticket(charge.generation, "generation");
82:     const version = ticket(charge.version, "version");
83:     const epoch = ticket(charge.epoch, "epoch");
84:     const wrappers = charge.wrappers ?? 0;
85:     const slots = charge.slots ?? 0;
86:     const payload = charge.payload ?? 0;
87:     const metadataRequest = BigInt(charge.metadata ?? 0) + 64n;
88:     const allocatedSlots = charge.allocatedSlots ?? slots;
89:     const work = BigInt(charge.work ?? 0) + 15n;
90:     const requested = [BigInt(wrappers), BigInt(slots), BigInt(payload), metadataRequest, BigInt(payload) + metadataRequest, BigInt(allocatedSlots), work];
91:     for (let index = 0; index < requested.length; index++) {
92:       const amount = requested[index]!;
93:       if (amount < 0n || amount > BigInt(caps[index]! - this.#used[index]!)) {
94:         throw new ArrayFailure(`private ${labels[index]} limit exceeded`);
95:       }
96:     }
97:     this.#caps = caps;
98:     this.#lastIssued = cursor;
99:     for (let index = 0; index < requested.length; index++) this.#used[index]! += Number(requested[index]!);
100:     return new Admission(this, wrappers, slots, payload, Number(metadataRequest), generation, version, epoch);
101:   }
102: 
103:   private derive(): Counters {
104:     const bytes = BigInt(this.bytes);
105:     const fields = BigInt(this.fields);
106:     const values = [fields, fields, bytes, 128n * fields, 8n * bytes + 512n * fields, 8n * fields, 32n * bytes + 256n * fields];
107:     const result: Counters = [0, 0, 0, 0, 0, 0, 0];
108:     for (let index = 0; index < values.length; index++) {
109:       const value = values[index]!;
110:       if (value < 0n || value > BigInt(Number.MAX_SAFE_INTEGER)) throw new ArrayFailure(`private ${labels[index]} capacity is not representable`);
111:       result[index] = Number(value);
112:     }
113:     return result;
114:   }
115: 
116:   release(admission: Admission): void {
117:     this.#used[0] -= admission.wrappers;
118:     this.#used[1] -= admission.slots;
119:     this.#used[2] -= admission.payload;
120:     this.#used[3] -= admission.metadata;
121:   }
122: 
123:   checkpoint(signal?: AbortSignal, units = 1): Promise<void> | undefined {
124:     signal?.throwIfAborted();
125:     this.#checkpoint += units;
126:     if (this.#checkpoint >= 128) {
127:       this.#checkpoint %= 128;
128:       return new Promise<void>((resolve, reject) => setImmediate(() => {
129:         try { signal?.throwIfAborted(); resolve(); }
130:         catch (error) { reject(error); }
131:       }));
132:     }
133:   }
134: }
135: 
136: export function exactSum(left: number, right: number): number {
137:   if (!Number.isSafeInteger(left) || !Number.isSafeInteger(right) || left < 0 || right < 0 || left > Number.MAX_SAFE_INTEGER - right) {
138:     throw new ArrayFailure("private allocated byte capacity is not representable");
139:   }
140:   return left + right;
141: }
