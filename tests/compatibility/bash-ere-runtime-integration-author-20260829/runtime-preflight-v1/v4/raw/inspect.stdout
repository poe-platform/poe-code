143: export class ArrayOwner {
144:   #head: Admission | undefined;
145:   #firstChild: ArrayOwner | undefined;
146:   #nextSibling: ArrayOwner | undefined;
147:   #previousSibling: ArrayOwner | undefined;
148:   #closed = false;
149:   #started = false;
150:   #resolve!: () => void;
151:   #reject!: (error: unknown) => void;
152:   #holds = 0;
153:   #resolveIdle!: () => void;
154:   readonly #idle: Promise<void>;
155:   #releasing = false;
156:   readonly completion: Promise<void>;
157: 
158:   private constructor(readonly ledger: ArrayLedger, readonly parent: ArrayOwner | undefined, readonly header: Admission) {
159:     this.completion = new Promise<void>((resolve, reject) => { this.#resolve = resolve; this.#reject = reject; });
160:     this.#idle = new Promise<void>(resolve => { this.#resolveIdle = resolve; });
161:     void this.completion.catch(() => undefined);
162:   }
163: 
164:   static create(ledger: ArrayLedger, parent?: ArrayOwner): ArrayOwner {
165:     parent?.assertOpen();
166:     const header = ledger.reserve({ metadata: 64, work: 9 });
167:     const owner = new ArrayOwner(ledger, parent, header);
168:     if (parent) {
169:       owner.#nextSibling = parent.#firstChild;
170:       if (parent.#firstChild) parent.#firstChild.#previousSibling = owner;
171:       parent.#firstChild = owner;
172:     }
173:     return owner;
174:   }
175: 
176:   assertOpen(): void {
177:     if (this.#closed) throw new ArrayFailure("ownership admission is closed");
178:     this.parent?.assertOpen();
179:   }
180: 
181:   reserve(charge: Charge): Admission {
182:     this.assertOpen();
183:     return this.adopt(this.ledger.reserve(charge));
184:   }
185: 
186:   adopt(admission: Admission, prepaid = false): Admission {
187:     const root = this.root();
188:     if (!prepaid || !root.#holds || root.#releasing) this.assertOpen();
189:     if (admission.released || admission.ledger !== this.ledger) throw new Error("Invalid indexed-array ownership transfer");
190:     admission.owner?.detach(admission);
191:     admission.owner = this;
192:     admission.previous = undefined;
193:     admission.next = this.#head;
194:     if (this.#head) this.#head.previous = admission;
195:     this.#head = admission;
196:     return admission;
197:   }
198: 
199:   private root(): ArrayOwner {
200:     let root: ArrayOwner = this;
201:     while (root.parent) root = root.parent;
202:     return root;
203:   }
204: 
205:   hold(): Admission {
206:     this.assertOpen();
207:     const root = this.root();
208:     if (root.#holds === Number.MAX_SAFE_INTEGER) throw new ArrayFailure("resource capacity exhausted");
209:     const admission = this.reserve({ metadata: 64, work: 5 });
210:     root.#holds++;
211:     admission.cleanup = () => {
212:       root.#holds--;
213:       if (!root.#holds && root.#closed) root.#resolveIdle();
214:     };
215:     return admission;
216:   }
217: 
218:   detach(admission: Admission): void {
219:     if (admission.previous) admission.previous.next = admission.next;
220:     else this.#head = admission.next;
221:     if (admission.next) admission.next.previous = admission.previous;
222:     admission.owner = undefined;
223:     admission.previous = undefined;
224:     admission.next = undefined;
225:   }
226: 
227:   close(): Promise<void> {
228:     if (!this.#started) {
229:       this.#started = true;
230:       this.#closed = true;
231:       void this.drain().then(this.#resolve, this.#reject);
232:     }
233:     return this.completion;
234:   }
235: 
236:   private async drain(): Promise<void> {
237:     if (!this.parent) {
238:       if (this.#holds) await this.#idle;
239:       this.#releasing = true;
240:     }
241:     while (this.#firstChild) {
242:       await this.#firstChild.close();
243:       const checkpoint = this.ledger.checkpoint();
244:       if (checkpoint) await checkpoint;
245:     }
246:     while (this.#head) {
247:       this.#head.release();
248:       const checkpoint = this.ledger.checkpoint();
249:       if (checkpoint) await checkpoint;
250:     }
251:     if (this.parent) {
252:       if (this.#previousSibling) this.#previousSibling.#nextSibling = this.#nextSibling;
253:       else this.parent.#firstChild = this.#nextSibling;
254:       if (this.#nextSibling) this.#nextSibling.#previousSibling = this.#previousSibling;
255:     }
256:     this.header.release();
257:   }
258: }
