1: import { isMainThread, parentPort, workerData } from "node:worker_threads";
2: import { operation, EreTransportError } from "./protocol.js";
3: import { record } from "./validation.js";
4: import { executeWireRequest } from "./wire-engine.js";
5: import { add, integer } from "./accounting.js";
6: 
7: if (isMainThread || !parentPort) throw new EreTransportError("PROTOCOL", "ERE entry requires its owned Worker");
8: let startupWork = 0;
9: const data = record(workerData, ["operation", "version"], units => { startupWork = add(startupWork, units); });
10: if (data.operation !== operation || data.version !== 1) throw new EreTransportError("PROTOCOL", "invalid ERE Worker data");
11: const port = parentPort;
12: let busy = false;
13: let lastId = 0;
14: port.on("message", (message: unknown) => {
15:   if (busy) throw new EreTransportError("PROTOCOL", "concurrent ERE Worker request");
16:   let entryWork = startupWork;
17:   const frame = record(message, ["version", "operation", "id", "grantId", "profile", "bounds", "allowance", "pattern", "subject"], units => { entryWork = add(entryWork, units); });
18:   integer(frame.id);
19:   if (frame.id <= lastId) throw new EreTransportError("PROTOCOL", "replayed ERE request");
20:   lastId = frame.id;
21:   busy = true;
22:   startupWork = 0;
23:   void executeWireRequest(message, entryWork).then(reply => {
24:     port.postMessage(reply);
25:     busy = false;
26:   }).catch(error => { queueMicrotask(() => { throw error; }); });
27: });
28: port.postMessage({ version: 1, operation, kind: "ready" });
