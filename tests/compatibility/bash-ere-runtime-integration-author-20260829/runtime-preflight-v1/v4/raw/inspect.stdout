5: const resources: readonly EreResource[] = Object.freeze([
6:   "patternBytes", "subjectBytes", "work", "states", "allocationUnits", "captureBytes", "captureSlots",
7: ]);
8: 
9: function integer(value: number): void {
10:   if (!Number.isSafeInteger(value) || value < 0) throw new TypeError("ERE bounds must be nonnegative safe integers");
11: }
12: 
13: function multiply(value: number, factor: number, ceiling: number): number {
14:   return value > Math.floor(ceiling / factor) ? ceiling : value * factor;
15: }
16: 
17: export function deriveEreLimits(bounds: EreExpansionBounds): EreLimits {
18:   integer(bounds.maxExpansionBytes);
19:   integer(bounds.maxExpansionFields);
20:   const bytes = bounds.maxExpansionBytes;
21:   const fields = bounds.maxExpansionFields;
22:   const byteUnits = multiply(bytes, 8, 4_000_000);
23:   const fieldUnits = multiply(fields, 128, 4_000_000);
24:   return Object.freeze({
25:     patternBytes: Math.min(bytes, 65_536),
26:     subjectBytes: Math.min(bytes, 1_048_576),
27:     work: multiply(bytes, 32, 50_000_000),
28:     states: multiply(fields, 8, 65_536),
29:     allocationUnits: byteUnits >= 4_000_000 - fieldUnits ? 4_000_000 : byteUnits + fieldUnits,
30:     captureBytes: bytes,
31:     captureSlots: fields,
32:   });
33: }
