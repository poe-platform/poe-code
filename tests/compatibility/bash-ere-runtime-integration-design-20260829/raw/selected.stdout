{"copy":"selected/transport-accounting.data","methods":[{"line":5,"text":"export function integer(value: unknown): asserts value is number {"},{"line":9,"text":"export function add(left: number, right: number): number {"},{"line":10,"text":"  integer(left); integer(right);"},{"line":15,"text":"export function multiply(value: number, factor: number): number {"},{"line":16,"text":"  integer(value); integer(factor);"},{"line":25,"text":"export class EngineAccounting {"},{"line":26,"text":"  readonly limits: EreLimits;"},{"line":30,"text":"  constructor(bounds: EreExpansionBounds) { this.limits = deriveEreLimits(bounds); }"},{"line":32,"text":"  reserve(patternBytes: number, subjectBytes: number): EreLimits {"},{"line":43,"text":"  commit(allowance: EreLimits, usage: EreUsage): void {"},{"line":52,"text":"  abandon(allowance: EreLimits, sent: boolean): void {"},{"line":62,"text":"export class StorageReservation {"},{"line":66,"text":"  constructor(readonly ledger: TransportAccounting, units: number) { this.#remaining = units; }"},{"line":67,"text":"  consume(units: number): void {"},{"line":74,"text":"  settle(actual: number): void { this.consume(actual); this.releaseUnused(); }"},{"line":75,"text":"  unknown(): void { this.consume(this.#remaining); this.releaseUnused(); }"},{"line":76,"text":"  releaseUnused(): void {"},{"line":82,"text":"  retire(): void {"},{"line":88,"text":"export class TransportAccounting {"},{"line":89,"text":"  readonly storageLimit: number;"},{"line":90,"text":"  readonly workLimit: number;"},{"line":95,"text":"  constructor(limits: EreLimits) { this.storageLimit = limits.allocationUnits; this.workLimit = limits.work; }"},{"line":98,"text":"  visit(units: number): void {"},{"line":103,"text":"  metadata(fields: number): StorageReservation {"},{"line":110,"text":"  reserve(units: number): StorageReservation {"},{"line":119,"text":"  spend(units: number): void {"},{"line":123,"text":"  unreserve(units: number): void { if (units > this.#reserved) throw new EreTransportError(\"PROTOCOL\", \"transport reservation underflow\"); this.#reserved -= units; }"},{"line":124,"text":"  retire(units: number): void { if (units > this.#live) throw new EreTransportError(\"PROTOCOL\", \"transport ownership underflow\"); this.#live -= units; }"}]}
