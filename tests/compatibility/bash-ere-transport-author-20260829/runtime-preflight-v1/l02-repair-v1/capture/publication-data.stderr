const root=process.argv[2];if(root!==new URL('.',import.meta.url).pathname.slice(0,-1))throw Error('exact owned root');const started=Date.now();const rows=[];let total=0;async function visit(dir){for(const name of readdirSync(dir).sort()){if(Date.now()-started>20000)throw Error('publication data clock');const path=join(dir,name);const stat=lstatSync(path);if(stat.isSymbolicLink())throw Error('symlink');if(stat.isDirectory()){await visit(path);continue;}if(!stat.isFile()||stat.size>128*1024*1024)throw Error('bounded regular file');total+=stat.size;if(total>384*1024*1024||rows.length>=1200)throw Error('census bound');const digest=createHash('sha256');let size=0;for await(const part of createReadStream(path,{highWaterMark:65536})){size+=part.length;if(size>stat.size)throw Error('read drift');digest.update(part);}if(size!==stat.size)throw Error('short read');rows.push({path:relative(root,path),size,sha256:digest.digest('hex')});}}await visit(root);const hash=bytes=>createHash('sha256').update(bytes).digest('hex');const archiveRows=[];for(const row of rows){if(row.path.startsWith('BUILD/work/node_modules/')||row.path.startsWith('capture/publication-data.')||row.path.endsWith('.patch.data'))continue;if(row.size>500000)throw Error('archive row cap');const bytes=readFileSync(join(root,row.path));if(bytes.length!==row.size||hash(bytes)!==row.sha256)throw Error('archive read drift');archiveRows.push({...row,base64:bytes.toString('base64')});}const body=Buffer.from(JSON.stringify({schema:1,entries:archiveRows}));if(body.length>8*1024*1024)throw Error('archive bound');const compressed=gzipSync(body,{level:9});writeFileSync(join(root,'EVIDENCE.gz.data'),compressed,{flag:'wx'});const channels=rows.filter(row=>/\.(stdout|stderr)$/.test(row.path));const receipt={schema:1,role:'owned subtree DATA census only; no product or matching imports',rows,files:rows.length,workingBytes:total,uniqueCaptureBytes:channels.reduce((n,r)=>n+r.size,0),captureFiles:channels.length,archive:{file:'EVIDENCE.gz.data',size:compressed.length,sha256:hash(compressed),decodedBytes:body.length,decodedSha256:hash(body),entries:archiveRows.length,excluded:'241 authenticated copied compiler tools are bound in census/preseal, not vendored in evidence archive; raw current publication stdout/stderr archived separately after close; patch transfer copies excluded'},newEntriesAfterSnapshot:'publication outputs and final Git raw captures are later append-only publication, not included in this snapshot',elapsedMilliseconds:Date.now()-started,actualWorkers:0};writeFileSync(join(root,'PUBLICATION-RECEIPT.json'),JSON.stringify(receipt,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({files:rows.length,workingBytes:total,captureBytes:receipt.uniqueCaptureBytes,archiveBytes:compressed.length,archiveSha256:receipt.archive.sha256}));
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            

