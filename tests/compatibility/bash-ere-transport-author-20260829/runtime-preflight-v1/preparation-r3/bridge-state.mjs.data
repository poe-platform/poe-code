export const state={mode:'',expectedURL:'',records:[],handles:[],errors:[],messages:0,postCount:0,posted:0,attempts:0,constructed:0,rescues:0,captureFault:{present:false},afterValidation:null,firstPost:null,resolvePost:null,replyGate:null,resolveReplies:null};
state.firstPost=new Promise(resolve=>{state.resolvePost=resolve});state.replyGate=new Promise(resolve=>{state.resolveReplies=resolve});
export function record(value){try{const text=JSON.stringify(value);if(Buffer.byteLength(text)>256||state.records.length>=512)throw Error('trace cap');state.records.push({seq:state.records.length+1,at:Math.floor(performance.now()*1000),...value});}catch(reason){if(!state.captureFault.present)state.captureFault={present:true,value:reason};}}
export async function joinWorkers(){await Promise.all(state.handles.flatMap(row=>[row.exited,row.stdoutDone,row.stderrDone]));for(const row of state.handles){if(!row.retired&&row.closed&&row.stdoutClosed&&row.stderrClosed){row.retired=true;record({kind:'retired'});}}if(state.captureFault.present)throw state.captureFault.value;}
