import {workerData} from 'node:worker_threads';
import {openSync,writeSync,closeSync,readFileSync,lstatSync} from 'node:fs';import {createHash} from 'node:crypto';import {registerHooks} from 'node:module';import {fileURLToPath} from 'node:url';import {dirname,relative,resolve} from 'node:path';
const own=dirname(fileURLToPath(import.meta.url));const root=resolve(own,'..');const fd=openSync(resolve(own,'child-loads.jsonl'),'wx');let written=0;process.once('exit',()=>closeSync(fd));const hash=bytes=>createHash('sha256').update(bytes).digest('hex');function read(path,max){const stat=lstatSync(path);if(!stat.isFile()||stat.isSymbolicLink()||stat.size>max)throw Error('child input admission');return readFileSync(path);}const manifest=JSON.parse(read(resolve(own,'child-loads-manifest.json'),65536));const builtinEdges={'limits.js':['node:timers/promises'],'transport/validation.js':['node:util'],'transport/worker-entry.actual.js':['node:worker_threads']};registerHooks({resolve(specifier,context,next){if(specifier.startsWith('node:')){const importer=relative(root,fileURLToPath(context.parentURL));if(!builtinEdges[importer]?.includes(specifier))throw Error('child builtin edge');}return next(specifier,context);},load(url,context,next){if(url.startsWith('node:'))return next(url,context);const path=fileURLToPath(url);const name=relative(root,path);const expected=manifest.find(row=>row.name===name);if(!expected)throw Error('child module edge');const bytes=read(path,65536);if(bytes.length!==expected.size||hash(bytes)!==expected.sha256)throw Error('child module binding');const result=next(url,context);if(hash(Buffer.from(result.source))!==expected.sha256)throw Error('actual child load bytes');const line=Buffer.from(JSON.stringify({name,sha256:expected.sha256})+'\n');if(written+line.length>65536)throw Error('child capture cap');let offset=0;while(offset<line.length){const count=writeSync(fd,line,offset,line.length-offset);if(count<=0)throw Error('child capture write');offset+=count;}written+=line.length;return result;}});const envKeys=Reflect.ownKeys(process.env);if(envKeys.length>16||envKeys.some(key=>typeof key!=='string'||key.length>128))throw Error('effective env shape');if(process.argv.length!==2||process.argv.some(value=>typeof value!=='string'||value.length>1024)||process.execArgv.length>8||process.execArgv.some(value=>typeof value!=='string'||value.length>128))throw Error('effective argv shape');const identity={schema:1,entry:import.meta.url,argv:[...process.argv],execArgv:[...process.execArgv],envKeys,workerData:{operation:workerData.operation,version:workerData.version}};const identityBytes=Buffer.from(JSON.stringify(identity)+'\n');if(identityBytes.length>8192)throw Error('identity cap');const identityFd=openSync(resolve(own,'child-identity.json'),'wx');try{let offset=0;while(offset<identityBytes.length){const count=writeSync(identityFd,identityBytes,offset,identityBytes.length-offset);if(count<=0)throw Error('identity write');offset+=count;}}finally{closeSync(identityFd);}await import('./worker-entry.actual.js');
