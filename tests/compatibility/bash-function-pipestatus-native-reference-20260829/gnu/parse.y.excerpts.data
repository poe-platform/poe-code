6930: /************************************************
6931:  *						*
6932:  *		EOF HANDLING			*
6933:  *						*
6934:  ************************************************/
6935: 
6936: /* Do that silly `type "bye" to exit' stuff.  You know, "ignoreeof". */
6937: 
6938: /* A flag denoting whether or not ignoreeof is set. */
6939: int ignoreeof = 0;
6940: 
6941: /* The number of times that we have encountered an EOF character without
6942:    another character intervening.  When this gets above the limit, the
6943:    shell terminates. */
6944: int eof_encountered = 0;
6945: 
6946: /* The limit for eof_encountered. */
6947: int eof_encountered_limit = 10;
6948: 
6949: int
6950: handle_ignoreeof (int reset_prompt)
6951: {
6952:   if (eof_encountered < eof_encountered_limit)
7301: 
7302:   prompt_string_pointer = ps->prompt_string_pointer;
7303: 
7304:   current_command_line_count = ps->current_command_line_count;
7305: 
7306: #if defined (HISTORY)
7307:   remember_on_history = ps->remember_on_history;
7308: #  if defined (BANG_HISTORY)
7309:   history_expansion_inhibited = ps->history_expansion_inhibited;
7310: #  endif
7311: #endif
7312: 
7313:   last_command_exit_value = ps->last_command_exit_value;
7314: #if defined (ARRAY_VARS)
7315:   restore_pipestatus_array (ps->pipestatus);
7316: #endif
7317: 
7318:   last_shell_builtin = ps->last_shell_builtin;
7319:   this_shell_builtin = ps->this_shell_builtin;
7320: 
7321:   expand_aliases = ps->expand_aliases;
7322:   echo_input_at_read = ps->echo_input_at_read;
7323:   need_here_doc = ps->need_here_doc;
7324:   here_doc_first_line = ps->here_doc_first_line;
7325: 
7326:   esacs_needed_count = ps->esacs_needed;
7327:   expecting_in_token = ps->expecting_in;
7328:   expecting_in_command = ps->incmd;
7329: 
7330: #if 0
7331:   for (i = 0; i < HEREDOC_MAX; i++)
7332:     redir_stack[i] = ps->redir_stack[i];
7333: #else
7334:   if (need_here_doc == 0)
7335:     redir_stack[0] = 0;
7336:   else
7337:     memcpy (redir_stack, ps->redir_stack, sizeof (redir_stack[0]) * HEREDOC_MAX);
7338: #endif
7339: 
7340: #if defined (ALIAS) || defined (DPAREN_ARITHMETIC)
7341:   pushed_string_list = (STRING_SAVER *)ps->pushed_strings;
7342: #endif
7343: 
7344:   FREE (token);
7345:   token = ps->token;
7346:   token_buffer_size = ps->token_buffer_size;
7347:   shell_eof_token = ps->eof_token;
7348: }
