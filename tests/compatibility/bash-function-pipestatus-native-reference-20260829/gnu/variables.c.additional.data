2452: /* Look up the function entry whose name matches STRING.
2453:    Returns the entry or NULL. */
2454: SHELL_VAR *
2455: find_function (const char *name)
2456: {
2457:   return (hash_lookup (name, shell_functions));
2458: }
2459: 
2460: /* Find the function definition for the shell function named NAME.  Returns
2461:    the entry or NULL. */
2462: FUNCTION_DEF *
2463: find_function_def (const char *name)
2464: {
2465: #if defined (DEBUGGER)
2466:   return ((FUNCTION_DEF *)hash_lookup (name, shell_function_defs));
2467: #else
2468:   return ((FUNCTION_DEF *)0);
2469: #endif
2470: }
2471: 
2472: /* Return the value of VAR.  VAR is assumed to have been the result of a
2473:    lookup without any subscript, if arrays are compiled into the shell. */
2474: char *
2475: get_variable_value (SHELL_VAR *var)
2476: {
2477:   if (var == 0)
2478:     return ((char *)NULL);
2479: #if defined (ARRAY_VARS)
2480:   else if (array_p (var))
2481:     return (array_reference (array_cell (var), 0));
2482:   else if (assoc_p (var))
2483:     return (assoc_reference (assoc_cell (var), "0"));
2484: #endif
2485:   else
2486:     return (value_cell (var));
2487: }
2488: 
2489: /* Return the string value of a variable.  Return NULL if the variable
2490:    doesn't exist.  Don't cons a new string.  This is a potential memory
2491:    leak if the variable is found in the temporary environment, but doesn't
2492:    leak in practice.  Since functions and variables have separate name
2493:    spaces, returns NULL if var_name is a shell function only. */
2494: char *
2495: get_string_value (const char *name)
2496: {
2497:   SHELL_VAR *var;
2498: 
2499:   var = find_variable (name);
2500:   return ((var) ? get_variable_value (var) : (char *)NULL);
2501: }
2502: 
2503: /* This is present for use by the tilde and readline libraries. */
2504: char *
2505: sh_get_env_value (const char *v)
2506: {
2507:   return get_string_value (v);
2508: }
2509: 
2510: /* **************************************************************** */
2511: /*								    */
2512: /*		  Creating and setting variables		    */
2513: /*								    */
2514: /* **************************************************************** */
2515: 
2516: static inline int
2517: var_sametype (SHELL_VAR *v1, SHELL_VAR *v2)
2518: {
2519:   if (v1 == 0 || v2 == 0)
2520:     return 0;
2521: #if defined (ARRAY_VARS)
2522:   else if (assoc_p (v1) && assoc_p (v2))
2523:     return 1;
2524:   else if (array_p (v1) && array_p (v2))
2525:     return 1;
2526:   else if (array_p (v1) || array_p (v2))
2527:     return 0;
2574:   return (v);
2575: }
2576: 
2577: /* Create a local variable referenced by NAME. */
2578: SHELL_VAR *
2579: make_local_variable (const char *name, int flags)
2580: {
2581:   SHELL_VAR *new_var, *old_var, *old_ref;
2582:   VAR_CONTEXT *vc;
2583:   int was_tmpvar;
2584:   char *old_value;
2585: 
2586:   /* We don't want to follow the nameref chain when making local variables; we
2587:      just want to create them. */
2588:   old_ref = find_variable_noref (name);
2589:   if (old_ref && nameref_p (old_ref) == 0)
2590:     old_ref = 0;
2591:   /* local foo; local foo;  is a no-op. */
2592:   old_var = find_variable (name);
2593:   if (old_ref == 0 && old_var && local_p (old_var) && old_var->context == variable_context)
2594:     return (old_var);
2595: 
2596:   /* local -n foo; local -n foo;  is a no-op. */
2597:   if (old_ref && local_p (old_ref) && old_ref->context == variable_context)
2598:     return (old_ref);
2599: 
2600:   /* From here on, we want to use the refvar, not the variable it references */
2601:   if (old_ref)
2602:     old_var = old_ref;
2603: 
2604:   was_tmpvar = old_var && tempvar_p (old_var);
2605:   /* If we're making a local variable in a shell function, the temporary env
2606:      has already been merged into the function's variable context stack.  We
2607:      can assume that a temporary var in the same context appears in the same
2608:      VAR_CONTEXT and can safely be returned without creating a new variable
2609:      (which results in duplicate names in the same VAR_CONTEXT->table */
2610:   /* We can't just test tmpvar_p because variables in the temporary env given
2611:      to a shell function appear in the function's local variable VAR_CONTEXT
2612:      but retain their tempvar attribute.  We want temporary variables that are
2613:      found in temporary_env, hence the test for last_table_searched, which is
2614:      set in hash_lookup and only (so far) checked here. */
2615:   if (was_tmpvar && old_var->context == variable_context && last_table_searched != temporary_env)
2616:     {
2617:       VUNSETATTR (old_var, att_invisible);	/* XXX */
2618:       /* We still want to flag this variable as local, though, and set things
2619:          up so that it gets treated as a local variable. */
2620:       new_var = old_var;
2621:       /* Since we found the variable in a temporary environment, this will
2622: 	 succeed. */
2623:       for (vc = shell_variables; vc; vc = vc->down)
2624: 	if (vc_isfuncenv (vc) && vc->scope == variable_context)
2625: 	  break;
2626:       goto set_local_var_flags;
2627: 
2628:       return (old_var);
2629:     }
2630: 
2631:   /* If we want to change to "inherit the old variable's value" semantics,
2632:      here is where to save the old value. */
2633:   old_value = was_tmpvar ? value_cell (old_var) : (char *)NULL;
2634: 
2635:   for (vc = shell_variables; vc; vc = vc->down)
2636:     if (vc_isfuncenv (vc) && vc->scope == variable_context)
2637:       break;
2638: 
2639:   if (vc == 0)
2640:     {
2641:       internal_error (_("make_local_variable: no function context at current scope"));
2642:       return ((SHELL_VAR *)NULL);
2643:     }
2644:   else if (vc->table == 0)
2645:     vc->table = hash_create (TEMPENV_HASH_BUCKETS);
2646: 
2647:   /* Since this is called only from the local/declare/typeset code, we can
2648:      call builtin_error here without worry (of course, it will also work
2649:      for anything that sets this_command_name).  Variables with the `noassign'
2650:      attribute may not be made local.  The test against old_var's context
2651:      level is to disallow local copies of readonly global variables (since I
2652:      believe that this could be a security hole).  Readonly copies of calling
2653:      function local variables are OK. */
2654:   if (old_var && (noassign_p (old_var) ||
2655: 		 (readonly_p (old_var) && old_var->context == 0)))
2656:     {
2657:       if (readonly_p (old_var))
2658: 	sh_readonly (name);
2815:   ARRAY *array;
2816:   int assoc_ok;
2817: 
2818:   assoc_ok = flags & MKLOC_ASSOCOK;
2819: 
2820:   var = make_local_variable (name, flags & MKLOC_INHERIT);	/* XXX for now */
2821:   /* If ASSOC_OK is non-zero, assume that we are ok with letting an assoc
2822:      variable return to the caller without converting it. The caller will
2823:      either flag an error or do the conversion itself. */
2824:   if (var == 0 || array_p (var) || (assoc_ok && assoc_p (var)))
2825:     return var;
2826: 
2827:   /* Validate any value we inherited from a variable instance at a previous
2828:      scope and discard anything that's invalid. */
2829:   if (localvar_inherit && assoc_p (var))
2830:     {
2831:       internal_warning (_("%s: cannot inherit value from incompatible type"), name);
2832:       VUNSETATTR (var, att_assoc);
2833:       dispose_variable_value (var);
2834:       array = array_create ();
2835:       var_setarray (var, array);
2836:     }
2837:   else if (localvar_inherit)
2838:     var = convert_var_to_array (var);		/* XXX */
2839:   else
2840:     {
2841:       dispose_variable_value (var);
2842:       array = array_create ();
2843:       var_setarray (var, array);
2844:     }
2845: 
2846:   VSETATTR (var, att_array);
2847:   return var;
2848: }
2849: 
2850: SHELL_VAR *
2851: make_new_assoc_variable (const char *name)
2852: {
2853:   SHELL_VAR *entry;
2854:   HASH_TABLE *hash;
2855: 
2856:   entry = make_new_variable (name, global_variables->table);
2857:   hash = assoc_create (ASSOC_HASH_BUCKETS);
2858: 
2859:   var_setassoc (entry, hash);
2860:   VSETATTR (entry, att_assoc);
2861:   return entry;
2862: }
2863: 
2864: SHELL_VAR *
2865: make_local_assoc_variable (const char *name, int flags)
2866: {
2867:   SHELL_VAR *var;
2868:   HASH_TABLE *hash;
2869:   int array_ok;
2870: 
2871:   array_ok = flags & MKLOC_ARRAYOK;
2872: 
2873:   var = make_local_variable (name, flags & MKLOC_INHERIT);	/* XXX for now */
2874:   /* If ARRAY_OK is non-zero, assume that we are ok with letting an array
2875:      variable return to the caller without converting it. The caller will
2876:      either flag an error or do the conversion itself. */
2877:   if (var == 0 || assoc_p (var) || (array_ok && array_p (var)))
2878:     return var;
2879: 
2880:   /* Validate any value we inherited from a variable instance at a previous
2881:      scope and discard anything that's invalid. */
2882:   if (localvar_inherit && array_p (var))
2883:     {
2884:       internal_warning (_("%s: cannot inherit value from incompatible type"), name);
2885:       VUNSETATTR (var, att_array);
2886:       dispose_variable_value (var);
2887:       hash = assoc_create (ASSOC_HASH_BUCKETS);
2888:       var_setassoc (var, hash);
2889:     }
2890:   else if (localvar_inherit)
2891:     var = convert_var_to_assoc (var);		/* XXX */
2892:   else
2893:     {
2894:       dispose_variable_value (var);
2895:       hash = assoc_create (ASSOC_HASH_BUCKETS);
2896:       var_setassoc (var, hash);
2897:     }
2898: 
2899:   VSETATTR (var, att_assoc);
2900:   return var;
2901: }
2902: #endif
2903: 
2904: char *
2905: make_variable_value (SHELL_VAR *var, const char *value, int flags)
2906: {
2907:   char *retval, *oval;
2908:   intmax_t lval, rval;
2909:   int expok, op;
2910:   size_t olen;
2911: 
2912:   /* If this variable has had its type set to integer (via `declare -i'),
2913:      then do expression evaluation on it and store the result.  The
2914:      functions in expr.c (evalexp()) and bind_int_variable() are responsible
2915:      for turning off the integer flag if they don't want further
2916:      evaluation done.  Callers that find it inconvenient to do this can set
2917:      the ASS_NOEVAL flag.  For the special case of arithmetic expression
2918:      evaluation, the caller can set ASS_NOLONGJMP to avoid jumping out to
2919:      top_level. */
2920:   if ((flags & ASS_NOEVAL) == 0 && integer_p (var))
2921:     {
2922:       if (flags & ASS_APPEND)
2923: 	{
2924: 	  oval = value_cell (var);
2925: 	  lval = evalexp (oval, 0, &expok);	/* ksh93 seems to do this */
2926: 	  if (expok == 0)
2927: 	    {
2928: 	      if (flags & ASS_NOLONGJMP)
2929: 		goto make_value;
2930: 	      else
2931: 		{
2932: 		  top_level_cleanup ();
2933: 		  jump_to_top_level (DISCARD);
2934: 		}
2935: 	    }
2936: 	}
2937:       rval = evalexp (value, 0, &expok);
2938:       if (expok == 0)
2939: 	{
2940: 	  if (flags & ASS_NOLONGJMP)
2941: 	    goto make_value;
2942: 	  else
2943: 	    {
2944: 	      top_level_cleanup ();
2945: 	      jump_to_top_level (DISCARD);
2946: 	    }
2947: 	}
2948:       /* This can be fooled if the variable's value changes while evaluating
2949: 	 `rval'.  We can change it if we move the evaluation of lval to here. */
2950:       if (flags & ASS_APPEND)
2951: 	rval += lval;
2952:       retval = itos (rval);
6286: #endif
6287: }
6288: 
6289: #if defined (ARRAY_VARS)
6290: void
6291: set_pipestatus_array (int *ps, int nproc)
6292: {
6293:   SHELL_VAR *v;
6294:   ARRAY *a;
6295:   ARRAY_ELEMENT *ae;
6296:   register int i;
6297:   char *t, tbuf[INT_STRLEN_BOUND(int) + 1];
6298: 
6299:   v = find_variable ("PIPESTATUS");
6300:   if (v == 0)
6301:     v = make_new_array_variable ("PIPESTATUS");
6302:   if (array_p (v) == 0)
6303:     return;		/* Do nothing if not an array variable. */
6304:   a = array_cell (v);
6305: 
6306:   if (a == 0 || array_num_elements (a) == 0)
6307:     {
6308:       for (i = 0; i < nproc; i++)	/* was ps[i] != -1, not i < nproc */
6309: 	{
6310: 	  t = inttostr (ps[i], tbuf, sizeof (tbuf));
6311: 	  array_insert (a, i, t);
6312: 	}
6313:       return;
6314:     }
6315: 
6316:   /* Fast case */
6317:   if (array_num_elements (a) == nproc && nproc == 1)
6318:     {
6319: #ifndef ALT_ARRAY_IMPLEMENTATION
6320:       ae = element_forw (a->head);
6321: #else
6322:       ae = a->elements[0];
6323: #endif
6324:       ARRAY_ELEMENT_REPLACE (ae, itos (ps[0]));
6325:     }
6326:   else if (array_num_elements (a) <= nproc)
6327:     {
6328:       /* modify in array_num_elements members in place, then add */
6329: #ifndef ALT_ARRAY_IMPLEMENTATION
6330:       ae = a->head;
6331: #endif
6332:       for (i = 0; i < array_num_elements (a); i++)
6333: 	{
6334: #ifndef ALT_ARRAY_IMPLEMENTATION
6335: 	  ae = element_forw (ae);
6336: #else
6337: 	  ae = a->elements[i];
6338: #endif
6339: 	  ARRAY_ELEMENT_REPLACE (ae, itos (ps[i]));
6340: 	}
6341:       /* add any more */
6342:       for ( ; i < nproc; i++)
6343: 	{
6344: 	  t = inttostr (ps[i], tbuf, sizeof (tbuf));
6345: 	  array_insert (a, i, t);
6346: 	}
6347:     }
6348:   else
6349:     {
6350: #ifndef ALT_ARRAY_IMPLEMENTATION
6351:       /* deleting elements.  it's faster to rebuild the array. */	  
6352:       array_flush (a);
6353:       for (i = 0; i < nproc; i++)
6354: 	{
6355: 	  t = inttostr (ps[i], tbuf, sizeof (tbuf));
6356: 	  array_insert (a, i, t);
6357: 	}
6358: #else
6359:       /* deleting elements. replace the first NPROC, free the rest */
6360:       for (i = 0; i < nproc; i++)
6361: 	{
6362: 	  ae = a->elements[i];
6363: 	  ARRAY_ELEMENT_REPLACE (ae, itos (ps[i]));
6364: 	}
6365:       for ( ; i <= array_max_index (a); i++)
6366: 	{
6367: 	  array_dispose_element (a->elements[i]);
6368: 	  a->elements[i] = (ARRAY_ELEMENT *)NULL;
6369: 	}
6370: 
6414: {
6415: #if defined (ARRAY_VARS)
6416:   static int v[2] = { 0, -1 };
6417: 
6418:   v[0] = s;
6419:   set_pipestatus_array (v, 1);
6420: #endif
6421: }
