6423: void
6424: sv_xtracefd (const char *name)
6425: {
6426:   SHELL_VAR *v;
6427:   char *t, *e;
6428:   int fd;
6429:   FILE *fp;
6430: 
6431:   v = find_variable (name);
6432:   if (v == 0)
6433:     {
6434:       xtrace_reset ();
6435:       return;
6436:     }
6437: 
6438:   t = value_cell (v);
6439:   if (t == 0 || *t == 0)
6440:     xtrace_reset ();
6441:   else
6442:     {
6443:       fd = (int)strtol (t, &e, 10);
6444:       if (e != t && *e == '\0' && sh_validfd (fd))
6445: 	{
6446: 	  fp = fdopen (fd, "w");
6447: 	  if (fp == 0)
6448: 	    internal_error (_("%s: %s: cannot open as FILE"), name, value_cell (v));
6449: 	  else
6450: 	    xtrace_set (fd, fp);
6451: 	}
6452:       else
6453: 	internal_error (_("%s: %s: invalid value for trace file descriptor"), name, value_cell (v));
6454:     }
6455: }
6456: 
6457: #define MIN_COMPAT_LEVEL 31
6458: 
6459: void
6460: sv_shcompat (const char *name)
6461: {
6462:   SHELL_VAR *v;
6463:   char *val;
6464:   int tens, ones, compatval;
6465: 
6466:   v = find_variable (name);
6467:   if (v == 0)
6468:     {
6469:       shell_compatibility_level = default_compatibility_level;
6470:       set_compatibility_opts ();
6471:       return;
6472:     }
6473:   val = value_cell (v);
6474:   if (val == 0 || *val == '\0')
6475:     {
6476:       shell_compatibility_level = default_compatibility_level;
6477:       set_compatibility_opts ();
6478:       return;
6479:     }
6480:   /* Handle decimal-like compatibility version specifications: 4.2 */
6481:   if (ISDIGIT (val[0]) && val[1] == '.' && ISDIGIT (val[2]) && val[3] == 0)
6482:     {
6483:       tens = val[0] - '0';
6484:       ones = val[2] - '0';
6485:       compatval = tens*10 + ones;
6486:     }
6487:   /* Handle integer-like compatibility version specifications: 42 */
6488:   else if (ISDIGIT (val[0]) && ISDIGIT (val[1]) && val[2] == 0)
6489:     {
6490:       tens = val[0] - '0';
6491:       ones = val[1] - '0';
6492:       compatval = tens*10 + ones;
6493:     }
6494:   else
6495:     {
6496: compat_error:
6497:       internal_error (_("%s: %s: compatibility value out of range"), name, val);
6498:       shell_compatibility_level = default_compatibility_level;
