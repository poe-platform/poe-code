2439: SHELL_VAR *
2440: find_variable_noref (const char *name)
2441: {
2442:   SHELL_VAR *v;
2443:   int flags;
2444: 
2445:   flags = 0;
2446:   if (expanding_redir == 0 && (assigning_in_environment || executing_builtin))
2447:     flags |= FV_FORCETEMPENV;
2448:   v = find_variable_internal (name, flags);
2449:   return v;
