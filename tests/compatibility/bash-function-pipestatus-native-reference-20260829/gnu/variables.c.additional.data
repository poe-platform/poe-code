345: static void
346: create_variable_tables (void)
347: {
348:   if (shell_variables == 0)
349:     {
350:       shell_variables = global_variables = new_var_context ((char *)NULL, 0);
351:       shell_variables->scope = 0;
352:       shell_variables->table = hash_create (VARIABLES_HASH_BUCKETS);
353:     }
354: 
355:   if (shell_functions == 0)
356:     shell_functions = hash_create (FUNCTIONS_HASH_BUCKETS);
357: 
358: #if defined (DEBUGGER)
359:   if (shell_function_defs == 0)
360:     shell_function_defs = hash_create (FUNCTIONS_HASH_BUCKETS);
361: #endif
362: }
363: 
364: /* Initialize the shell variables from the current environment.
365:    If PRIVMODE is nonzero, don't import functions from ENV or
366:    parse $SHELLOPTS. */
367: void
368: initialize_shell_variables (char **env, int privmode)
369: {
370:   char *name, *string, *temp_string;
371:   int c, char_index, string_index, string_length, ro;
372:   SHELL_VAR *temp_var;
373: 
374:   create_variable_tables ();
375: 
376:   for (string_index = 0; env && (string = env[string_index++]); )
377:     {
378:       char_index = 0;
379:       name = string;
380:       while ((c = *string++) && c != '=')
381: 	;
382:       if (string[-1] == '=')
383: 	char_index = string - name - 1;
384: 
385:       /* If there are weird things in the environment, like `=xxx' or a
386: 	 string without an `=', just skip them. */
387:       if (char_index == 0)
388: 	continue;
389: 
390:       /* ASSERT(name[char_index] == '=') */
391:       name[char_index] = '\0';
392:       /* Now, name = env variable name, string = env variable value, and
1958: 	temporary_env
1959: 	shell_variables list
1960: */
1961: 
1962: SHELL_VAR *
1963: find_variable_internal (const char *name, int flags)
1964: {
1965:   SHELL_VAR *var;
1966:   int search_tempenv, force_tempenv;
1967:   VAR_CONTEXT *vc;
1968: 
1969:   var = (SHELL_VAR *)NULL;
1970: 
1971:   force_tempenv = (flags & FV_FORCETEMPENV);
1972: 
1973:   /* If explicitly requested, first look in the temporary environment for
1974:      the variable.  This allows constructs such as "foo=x eval 'echo $foo'"
1975:      to get the `exported' value of $foo.  This happens if we are executing
1976:      a function or builtin, or if we are looking up a variable in a
1977:      "subshell environment". */
1978:   search_tempenv = force_tempenv || (expanding_redir == 0 && subshell_environment);
1979: 
1980:   if (search_tempenv && temporary_env)		
1981:     var = hash_lookup (name, temporary_env);
1982: 
1983:   if (var == 0)
1984:     {
1985:       if ((flags & FV_SKIPINVISIBLE) == 0)
1986: 	var = var_lookup (name, shell_variables);
1987:       else
1988: 	{
1989: 	  /* essentially var_lookup expanded inline so we can check for
1990: 	     att_invisible */
1991: 	  for (vc = shell_variables; vc; vc = vc->down)
1992: 	    {
1993: 	      var = hash_lookup (name, vc->table);
1994: 	      if (var && invisible_p (var))
1995: 		var = 0;
1996: 	      if (var)
1997: 		break;
1998: 	    }
1999: 	}
2000:     }
2001: 
2002:   if (var == 0)
2003:     return ((SHELL_VAR *)NULL);
2004: 
2005:   return (var->dynamic_value ? (*(var->dynamic_value)) (var) : var);
2006: }
2007: 
2008: /* Look up and resolve the chain of nameref variables starting at V all the
2009:    way to NULL or non-nameref. */
2010: SHELL_VAR *
2011: find_variable_nameref (SHELL_VAR *v)
2012: {
2013:   int level, flags;
2014:   char *newname;
2015:   SHELL_VAR *orig, *oldv;
2016: 
2017:   level = 0;
2018:   orig = v;
2019:   while (v && nameref_p (v))
2020:     {
2021:       level++;
2022:       if (level > NAMEREF_MAX)
2023: 	return (&nameref_maxloop_value);
2024:       newname = nameref_cell (v);
2025:       if (newname == 0 || *newname == '\0')
2026: 	return ((SHELL_VAR *)0);
2027:       oldv = v;
2028:       flags = 0;
2029:       if (expanding_redir == 0 && (assigning_in_environment || executing_builtin))
2030: 	flags |= FV_FORCETEMPENV;
2031:       /* We don't handle array subscripts here. */
2032:       v = find_variable_internal (newname, flags);
2033:       if (v == orig || v == oldv)
2034: 	{
2035: 	  internal_warning (_("%s: circular name reference"), orig->name);
2036: #if 1
2037: 	  /* XXX - provisional change - circular refs go to
2038: 	     global scope for resolution, without namerefs. */
2039: 	  if (variable_context && v->context)
2040: 	    return (find_global_variable_noref (v->name));
2041: 	  else
2042: #endif
2043: 	  return ((SHELL_VAR *)0);
2044: 	}
2045:     }
2046:   return v;
2047: }
2048: 
2049: /* Resolve the chain of nameref variables for NAME.  XXX - could change later */
2050: SHELL_VAR *
2051: find_variable_last_nameref (const char *name, int vflags)
2052: {
2053:   SHELL_VAR *v, *nv;
2054:   char *newname;
2055:   int level, flags;
2056: 
2057:   nv = v = find_variable_noref (name);
2058:   level = 0;
2059:   while (v && nameref_p (v))
2060:     {
2061:       level++;
2062:       if (level > NAMEREF_MAX)
2063:         return ((SHELL_VAR *)0);	/* error message here? */
2064:       newname = nameref_cell (v);
2065:       if (newname == 0 || *newname == '\0')
2066: 	return ((vflags && invisible_p (v)) ? v : (SHELL_VAR *)0);
2067:       nv = v;
2068:       flags = 0;
2069:       if (expanding_redir == 0 && (assigning_in_environment || executing_builtin))
2070: 	flags |= FV_FORCETEMPENV;
2071:       /* We don't accommodate array subscripts here. */
2072:       v = find_variable_internal (newname, flags);
2073:     }
2074:   return nv;
2075: }
2076: 
2077: /* Resolve the chain of nameref variables for NAME.  XXX - could change later */
2078: SHELL_VAR *
2079: find_global_variable_last_nameref (const char *name, int vflags)
2080: {
2081:   SHELL_VAR *v, *nv;
2082:   char *newname;
2083:   int level;
2084: 
2085:   nv = v = find_global_variable_noref (name);
2086:   level = 0;
2087:   while (v && nameref_p (v))
2088:     {
2089:       level++;
2090:       if (level > NAMEREF_MAX)
2091:         return ((SHELL_VAR *)0);	/* error message here? */
2092:       newname = nameref_cell (v);
2093:       if (newname == 0 || *newname == '\0')
2094: 	return ((vflags && invisible_p (v)) ? v : (SHELL_VAR *)0);
2095:       nv = v;
2096:       /* We don't accommodate array subscripts here. */
2097:       v = find_global_variable_noref (newname);
2098:     }
2099:   return nv;
2100: }
2101: 
2102: static SHELL_VAR *
2103: find_nameref_at_context (SHELL_VAR *v, VAR_CONTEXT *vc)
2104: {
2105:   SHELL_VAR *nv, *nv2;
2106:   char *newname;
2107:   int level;
2108: 
2109:   nv = v;
2110:   level = 1;
2111:   while (nv && nameref_p (nv))
2112:     {
2113:       level++;
2114:       if (level > NAMEREF_MAX)
2115:         return (&nameref_maxloop_value);
2116:       newname = nameref_cell (nv);
2117:       if (newname == 0 || *newname == '\0')
2118:         return ((SHELL_VAR *)NULL);      
2119:       nv2 = hash_lookup (newname, vc->table);
2120:       if (nv2 == 0)
2121:         break;
2122:       nv = nv2;
2123:     }
2124:   return nv;
2125: }
2126: 
2127: /* Do nameref resolution from the VC, which is the local context for some
2128:    function or builtin, `up' the chain to the global variables context.  If
2129:    NVCP is not NULL, return the variable context where we finally ended the
2130:    nameref resolution (so the bind_variable_internal can use the correct
2131:    variable context and hash table). */
2132: static SHELL_VAR *
2133: find_variable_nameref_context (SHELL_VAR *v, VAR_CONTEXT *vc, VAR_CONTEXT **nvcp)
2134: {
2135:   SHELL_VAR *nv, *nv2;
2136:   VAR_CONTEXT *nvc;
2137: 
2138:   /* Look starting at the current context all the way `up' */
2139:   for (nv = v, nvc = vc; nvc; nvc = nvc->down)
2140:     {
2141:       nv2 = find_nameref_at_context (nv, nvc);
2142:       if (nv2 == &nameref_maxloop_value)
2143: 	return (nv2);			/* XXX */
2144:       if (nv2 == 0)
2145:         continue;
2146:       nv = nv2;
2147:       if (*nvcp)
2148:         *nvcp = nvc;
2149:       if (nameref_p (nv) == 0)
2150:         break;
2151:     }
2267: SHELL_VAR *
2268: find_variable_tempenv (const char *name)
2269: {
2270:   SHELL_VAR *var;
2271: 
2272:   var = find_variable_internal (name, FV_FORCETEMPENV);
2273:   if (var && nameref_p (var))
2274:     {
2275:       var = find_variable_nameref (var);
2276:       if (var == &nameref_maxloop_value)
2277: 	{
2278: 	  internal_warning (_("%s: maximum nameref depth (%d) exceeded"), name, NAMEREF_MAX);
2279: 	  return (0);
2280: 	}
2281:     }
2282:   return (var);
2283: }
2284: 
2285: /* Find a variable, not forcing a search of the temporary environment first */
2286: SHELL_VAR *
2287: find_variable_notempenv (const char *name)
2288: {
2289:   SHELL_VAR *var;
2290: 
2291:   var = find_variable_internal (name, 0);
2292:   if (var && nameref_p (var))
2293:     {
2294:       var = find_variable_nameref (var);
2295:       if (var == &nameref_maxloop_value)
2296: 	{
2297: 	  internal_warning (_("%s: maximum nameref depth (%d) exceeded"), name, NAMEREF_MAX);
2298: 	  return (0);
2299: 	}
2300:     }
2301:   return (var);
2302: }
2303: 
2304: SHELL_VAR *
2305: find_global_variable (const char *name)
2306: {
2307:   SHELL_VAR *var;
2308: 
2309:   var = var_lookup (name, global_variables);
2310:   if (var && nameref_p (var))
2311:     {
2312:       var = find_variable_nameref (var);	/* XXX - find_global_variable_noref? */
2313:       if (var == &nameref_maxloop_value)
2314: 	{
2315: 	  internal_warning (_("%s: maximum nameref depth (%d) exceeded"), name, NAMEREF_MAX);
2316: 	  return ((SHELL_VAR *)NULL);
2317: 	}
2318:     }      
2319: 
2320:   if (var == 0)
2321:     return ((SHELL_VAR *)NULL);
2322: 
2323:   return (var->dynamic_value ? (*(var->dynamic_value)) (var) : var);
2324: }
2325: 
2326: SHELL_VAR *
2327: find_global_variable_noref (const char *name)
2328: {
2329:   SHELL_VAR *var;
2330: 
2331:   var = var_lookup (name, global_variables);
2332: 
2333:   if (var == 0)
2334:     return ((SHELL_VAR *)NULL);
2335: 
2336:   return (var->dynamic_value ? (*(var->dynamic_value)) (var) : var);
2337: }
2338: 
2339: SHELL_VAR *
2340: find_shell_variable (const char *name)
2341: {
2342:   SHELL_VAR *var;
2343: 
2344:   var = var_lookup (name, shell_variables);
2345:   if (var && nameref_p (var))
2346:     {
2347:       var = find_variable_nameref (var);
2348:       if (var == &nameref_maxloop_value)
2349: 	{
2350: 	  internal_warning (_("%s: maximum nameref depth (%d) exceeded"), name, NAMEREF_MAX);
2351: 	  return ((SHELL_VAR *)NULL);
2352: 	}
2353:     }
2354: 
2355:   if (var == 0)
2356:     return ((SHELL_VAR *)NULL);
2357: 
2358:   return (var->dynamic_value ? (*(var->dynamic_value)) (var) : var);
2359: }
2360: 
2361: /* Look up the variable entry named NAME.  Returns the entry or NULL. */
2362: SHELL_VAR *
2363: find_variable (const char *name)
2364: {
2365:   SHELL_VAR *v;
2366:   int flags;
2367: 
2368:   last_table_searched = 0;
2369:   flags = 0;
2370:   if (expanding_redir == 0 && (assigning_in_environment || executing_builtin))
2371:     flags |= FV_FORCETEMPENV;
2372:   v = find_variable_internal (name, flags);
2373:   if (v && nameref_p (v))
2374:     {
2375:       v = find_variable_nameref (v);
2376:       if (v == &nameref_maxloop_value)
2377: 	{
2378: 	  internal_warning (_("%s: maximum nameref depth (%d) exceeded"), name, NAMEREF_MAX);
2379: 	  return (0);
2380: 	}
2381:     }
2382: 
2383:   return v;
2384: }
2385: 
2386: /* Find the first instance of NAME in the variable context chain; return first
2387:    one found without att_invisible set; return 0 if no non-invisible instances
2388:    found. */
2389: SHELL_VAR *
2390: find_variable_no_invisible (const char *name)
2391: {
2392:   SHELL_VAR *v;
2393:   int flags;
2394: 
2395:   last_table_searched = 0;
2396:   flags = FV_SKIPINVISIBLE;
2397:   if (expanding_redir == 0 && (assigning_in_environment || executing_builtin))
2398:     flags |= FV_FORCETEMPENV;
2399:   v = find_variable_internal (name, flags);
2400:   if (v && nameref_p (v))
2401:     {
2402:       v = find_variable_nameref (v);
2403:       if (v == &nameref_maxloop_value)
2404: 	{
2405: 	  internal_warning (_("%s: maximum nameref depth (%d) exceeded"), name, NAMEREF_MAX);
2406: 	  return (0);
2407: 	}
2408:     }
2409: 
2410:   return v;
2411: }
2412: 
2413: /* Find the first instance of NAME in the variable context chain; return first
2414:    one found even if att_invisible set. */
2415: SHELL_VAR *
2416: find_variable_for_assignment (const char *name)
2417: {
2418:   SHELL_VAR *v;
2419:   int flags;
2420: 
2421:   last_table_searched = 0;
2422:   flags = 0;
2423:   if (expanding_redir == 0 && (assigning_in_environment || executing_builtin))
2424:     flags |= FV_FORCETEMPENV;
2425:   v = find_variable_internal (name, flags);
2426:   if (v && nameref_p (v))
2427:     {
2428:       v = find_variable_nameref (v);
2429:       if (v == &nameref_maxloop_value)
2430: 	{
2431: 	  internal_warning (_("%s: maximum nameref depth (%d) exceeded"), name, NAMEREF_MAX);
2432: 	  return (0);
2433: 	}
2434:     }
2435: 
2436:   return v;
2437: }
