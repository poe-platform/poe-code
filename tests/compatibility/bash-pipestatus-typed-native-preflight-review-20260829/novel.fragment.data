 test('N01',()=>{for(const value of [null,true,'0',NaN,Infinity,now+0.5])reject(()=>admission.validateGrant({...goodGrant,issuedEpochMs:value},now));reject(()=>admission.validateGrant({...goodGrant,issuedEpochMs:now+1,deadlineEpochMs:now+2700001},now));});
 test('N02',()=>{for(const names of [['function'],['__surface_missing_command__'],null])reject(()=>admission.validateGrant({...goodGrant,failedLookupNames:names},now));for(const key of ['BASH_ENV','ENV','BASH_FUNC_f%%']){const rows=clone();rows[0].environment[key]='injected';reject(()=>admission.validateCohort(cohort,rows,actualRoot));}});
 test('N03',()=>{for(let index=0;index<6;index++){const rows=clone();rows[index].argv[3]='true; '+rows[index].argv[3];reject(()=>admission.validateCohort(cohort,rows,actualRoot));}verify(cohort.cases[0].program==='declare -p PIPESTATUS');});
 test('N04',()=>{let getterCalls=0;const object={};Object.defineProperty(object,'a',{enumerable:true,get(){getterCalls++;throw Error('getter');}});reject(()=>admission.exactKeys(object,['a']));verify(getterCalls===0);reject(()=>admission.validateGrant({...goodGrant,extra:1},now));reject(()=>admission.validateGrant({...goodGrant,schema:'function-pipestatus-root-grant-v2'},now));});
 test('N05',()=>{const item=(name,bytes)=>({name,flush:true,size:true,hash:true,close:true,bytes:bytes.length,sha256:hash(bytes),base64:bytes.toString('base64')});const bytes=Buffer.from([0,255,13,10]),row={id:'P24',status:127,capture:[item('stdout',bytes),item('stderr',Buffer.alloc(0))],filesVerified:true,filesBefore:[],filesAfter:[]};const fields=observation.encodeObservation(row).toString().split('\0');verify(fields[2]==='127'&&Buffer.from(fields[4],'base64').equals(bytes));for(const status of ['0',NaN,-1])reject(()=>observation.encodeObservation({...row,status}));const bad=structuredClone(row);bad.capture[0].bytes++;reject(()=>observation.encodeObservation(bad));});
 test('N06',()=>{const item=(name,bytes)=>({name,flush:true,size:true,hash:true,close:true,bytes:bytes.length,sha256:hash(bytes),base64:bytes.toString('base64')});const row={id:'P19',status:0,capture:[item('stdout',Buffer.alloc(65536,255)),item('stderr',Buffer.alloc(0))],filesVerified:true,filesBefore:[],filesAfter:[]};verify(observation.encodeObservation(row).length<262144);row.capture[0]=item('stdout',Buffer.alloc(65537));reject(()=>observation.encodeObservation(row));});
 test('N07',()=>{const before=[{path:'work',type:'directory',mode:448}];for(const literal of cohort.cases){reject(()=>observation.validateEffects(literal.id,before,[{...before[0],mode:511}]));reject(()=>observation.validateEffects(literal.id,before,[...before,{path:'work/out',type:'file',mode:420,base64:''}]));}verify(cohort.failedLookups.length===0);});
 test('N08',()=>{const current=decode(read(materialized+'/entry.mjs')),parent=decode(read(inputs.parentRoot+'/materialized/entry.mjs'));verify(current.slice(current.lastIndexOf('}catch(error)'))===parent.slice(parent.lastIndexOf('}catch(error)')));verify(current.indexOf('validateOuter(root,name,fd)')<current.indexOf("event:'AUTHENTICATED_START'"));verify(current.indexOf("'GRANT_LIMITS'")<current.indexOf('await runManaged('));verify(delta.filter(row=>!row.changed).every(row=>hash(read(inputs.parentRoot+'/materialized/'+row.path))===hash(read(materialized+'/'+row.path))));});
