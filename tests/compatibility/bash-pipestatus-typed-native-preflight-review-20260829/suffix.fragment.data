 authenticate();await authenticateTools();
 const counts={retainedPass:results.slice(0,12).filter(row=>row.status==='PASS').length,retainedAssertions,novelPass:results.slice(12).filter(row=>row.status==='PASS').length,novelAssertions:assertions-retainedAssertions,pass:results.filter(row=>row.status==='PASS').length,fail:results.filter(row=>row.status==='FAIL').length,assertions};
