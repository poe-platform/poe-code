### direct-child.mjs
1: import fs from 'node:fs';
2: import {spawn} from 'node:child_process';
3: import {hash,errorRecord,Primary,pinExecutable} from './auth.mjs';
4: const pause = ms => new Promise(resolve => setTimeout(resolve,ms));
5: export const qualifyDirect = row => !row.primaryPresent && !row.forced && row.exit && row.close && row.stdoutEOF && row.stderrEOF && row.capturesQualified && row.knownOutstanding === 0;
6: export async function runDirect(spec,ledger) {
7:   if (ledger.stopped || ledger.active || ledger.starts >= ledger.maximum || Date.now() >= spec.bodyDeadline) throw Error('CHILD_ADMISSION');
8:   pinExecutable(spec.node);
9:   const primary = new Primary();
10:   const row = {id:spec.id,events:[],exit:false,close:false,stdoutEOF:false,stderrEOF:false,captures:[],signals:[],forced:false,capturesQualified:false,knownOutstanding:1};
11:   const event = name => row.events.push({name,at:Date.now()});
12:   let stdoutFd, stderrFd;
13:   try {stdoutFd = fs.openSync(spec.capture + '.stdout','wx+',384); stderrFd = fs.openSync(spec.capture + '.stderr','wx+',384);} catch(reason) {if(stdoutFd!==undefined)fs.closeSync(stdoutFd);throw reason;}
14:   event('capture-open');
15:   ledger.starts++;ledger.active++;
16:   let child,settle;
17:   const wake = new Promise(resolve => {settle = resolve;});
18:   const fail = reason => {primary.fail(reason);settle();};
19:   let stdoutBytes=0,stderrBytes=0;
20:   try {
21:     child=spawn(spec.node.path,spec.args,{cwd:spec.cwd,env:spec.env,shell:false,detached:false,stdio:['ignore','pipe','pipe']});
22:     row.pid=child.pid;
23:     child.on('spawn',()=>event('spawn'));
24:     child.on('error',reason=>{event('error');fail(reason);});
25:     child.on('exit',(status,signal)=>{row.exit=true;row.status=status;row.signal=signal;event('exit');});
26:     child.on('close',()=>{row.close=true;event('close');settle();});
27:     const consume = (descriptor,kind) => bytes => {
28:       if (primary.present) return;
29:       if ((kind==='stdout'?stdoutBytes:stderrBytes)+bytes.length>65536 || ledger.captureBytes+bytes.length>ledger.captureMaximum) {fail(Error('CAPTURE_LIMIT'));return;}
30:       try {fs.writeFileSync(descriptor,bytes);ledger.captureBytes+=bytes.length;if(kind==='stdout')stdoutBytes+=bytes.length;else stderrBytes+=bytes.length;} catch(reason){fail(reason);}
31:     };
32:     child.stdout.on('data',consume(stdoutFd,'stdout'));child.stderr.on('data',consume(stderrFd,'stderr'));
33:     child.stdout.on('end',()=>{row.stdoutEOF=true;event('stdout-end');});child.stderr.on('end',()=>{row.stderrEOF=true;event('stderr-end');});
34:     child.stdout.on('error',fail);child.stderr.on('error',fail);event('listeners-enrolled');
35:     const timer=setTimeout(()=>fail(Error('CHILD_DEADLINE')),Math.max(1,Math.min(spec.timeoutMs ?? 3000,spec.bodyDeadline-Date.now())));
36:     await wake;clearTimeout(timer);
37:     if(!row.close){
38:       row.forced=true;
39:       for(const [signal,grace] of [['SIGTERM',2000],['SIGKILL',1000]]){
40:         if(row.close)break;
41:         try{row.signals.push({signal,at:Date.now(),returned:child.kill(signal)});}catch(reason){primary.fail(reason);}
42:         const until=Date.now()+grace;while(!row.close&&Date.now()<until)await pause(10);
43:       }
44:     }
45:     if(!row.close||!row.exit||!row.stdoutEOF||!row.stderrEOF)primary.fail(Error('DIRECT_RETIREMENT_UNKNOWN'));
46:   }catch(reason){primary.fail(reason);}
47:   finally {
48:     for(const [kind,descriptor,expected]of [['stdout',stdoutFd,stdoutBytes],['stderr',stderrFd,stderrBytes]]){
49:       let capture,closed=false;
50:       try {fs.fsyncSync(descriptor);const stat=fs.fstatSync(descriptor);if(stat.size!==expected)throw Error('CAPTURE_SIZE');const bytes=Buffer.alloc(expected);let offset=0;while(offset<bytes.length){const count=fs.readSync(descriptor,bytes,offset,bytes.length-offset,offset);if(!count)throw Error('CAPTURE_SHORT');offset+=count;}capture={kind,bytes:expected,sha256:hash(bytes),base64:bytes.toString('base64'),flushed:true};}catch(reason){primary.fail(reason);}
51:       finally{try{fs.closeSync(descriptor);closed=true;}catch(reason){primary.fail(reason);}}
52:       if(capture)row.captures.push({...capture,closed});
53:     }
54:     row.capturesQualified=row.captures.length===2&&row.captures.every(capture=>capture.closed&&capture.flushed);
55:     if(Date.now()>=spec.finalDeadline)primary.fail(Error('FINAL_DEADLINE'));
56:     row.primaryPresent=primary.present;row.primary=primary.present?errorRecord(primary.reason):undefined;row.secondary=primary.secondary;
57:     row.knownOutstanding=row.close&&row.exit?0:1;
58:     row.qualified=qualifyDirect(row);
59:     row.finished=Date.now();ledger.rows.push(row);ledger.active--;if(!row.qualified)ledger.stopped=true;
60:   }
61:   return {row,primary};
62: }
