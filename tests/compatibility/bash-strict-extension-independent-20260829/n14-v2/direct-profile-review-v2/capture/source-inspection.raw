### case-launch.mjs
1: import fs from 'node:fs';
2: import {readPinned,hash} from './auth.mjs';
3: import {PROFILE,caseArguments,validateArguments,completion} from './profile.mjs';
4: import {runDirect} from './direct-child.mjs';
5: export async function launchProductCase(spec,ledger) {
6:   const closure=JSON.parse(readPinned(spec.closurePath,spec.closurePin,2097152));
7:   if(closure.decision!=='ACCEPT'||closure.candidate!=='bf079ada185a79aec864b068f3738ddc5520822e'||closure.identityKind!=='DERIVED_COMPOSITION_NOT_GIT_OBJECT'||closure.profile!==PROFILE||!spec.rootGrant||spec.rootGrant.decision!=='GO'||spec.rootGrant.closureSha256!==spec.closurePin.sha256)throw Error('PRODUCT_CLOSURE_OR_GRANT_HOLD');
8:   if(spec.role.kind!=='product-case')throw Error('PRODUCT_ROLE');
9:   for(const [filename,pin]of Object.entries(spec.role.files))readPinned(filename,pin);
10:   const roleBytes=readPinned(spec.role.rolePath,spec.rolePin,2097152);
11:   if(JSON.stringify(JSON.parse(roleBytes))!==JSON.stringify(spec.role))throw Error('ROLE_OBJECT_BINDING');
12:   const env={HOME:spec.home,TMPDIR:spec.tmp,PATH:spec.emptyPath,LC_ALL:'C',LANG:'C',TZ:'UTC',SURFACE_ROLE:spec.role.rolePath,SURFACE_ROLE_BYTES:String(roleBytes.length),SURFACE_ROLE_SHA256:hash(roleBytes)};
13:   const args=caseArguments(spec.role);validateArguments(spec.role,args,env);
14:   const result=await runDirect({...spec,args,env,cwd:spec.role.app,id:spec.role.id,timeoutMs:8000},ledger);
15:   if(!result.row.qualified||result.row.status!==0)throw Error('PRODUCT_DIRECT_CHILD_UNQUALIFIED');
16:   const output=result.row.captures.find(capture=>capture.kind==='stdout');
17:   const receipt=JSON.parse(Buffer.from(output.base64,'base64'));
18:   if(!completion(receipt,result.row)||receipt.caseId!==spec.role.caseId||receipt.layout!==spec.role.layout)throw Error('PRODUCT_PUBLIC_SETTLEMENT_RECEIPT');
19:   const traceStat=fs.lstatSync(spec.role.trace);if(!traceStat.isFile()||traceStat.isSymbolicLink()||traceStat.size>524288)throw Error('PRODUCT_TRACE_TYPE_SIZE');
20:   const trace=fs.readFileSync(spec.role.trace);ledger.captureBytes+=trace.length;if(ledger.captureBytes>ledger.captureMaximum)throw Error('PRODUCT_TRACE_CAPTURE_LIMIT');
21:   const rows=trace.toString().trim().split('\n').filter(Boolean).map(line=>JSON.parse(line));
22:   if(rows.filter(row=>row.event==='permission-admitted').length!==1||rows.filter(row=>row.event==='synchronous-hooks-installed').length!==1||rows.some(row=>row.profile!==PROFILE||row.role!==spec.role.id))throw Error('PRODUCT_TRACE_AUTHORITY');
23:   return {receipt,lifecycle:result.row,loadTrace:{bytes:trace.length,sha256:hash(trace),base64:trace.toString('base64')},qualification:'Public exec/dispose settlement contract and direct-child observations, no private job census/group absence/OS containment'};
24: }
