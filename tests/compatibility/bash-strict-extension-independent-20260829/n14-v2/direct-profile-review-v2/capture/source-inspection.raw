### guard.mjs
1: import fs from 'node:fs';
2: import {registerHooks} from 'node:module';
3: import {fileURLToPath} from 'node:url';
4: import {hash,readPinned} from './auth.mjs';
5: import {PROFILE,validateRole,validateArguments} from './profile.mjs';
6: const roleName = process.env.SURFACE_ROLE;
7: const roleSize = Number(process.env.SURFACE_ROLE_BYTES);
8: const raw = readPinned(roleName,{bytes:roleSize,sha256:process.env.SURFACE_ROLE_SHA256},2097152);
9: const role = validateRole(JSON.parse(raw));
10: if (roleName !== role.rolePath || process.execPath !== role.nodePath) throw Error('CHILD_IDENTITY');
11: validateArguments(role,[...process.execArgv,process.argv[1]],process.env);
12: if (!process.permission || ['child','worker','addon','wasi','inspector'].some(scope => process.permission.has(scope))) throw Error('PERMISSION_NOT_DENIED');
13: let traceBytes = 0;
14: function trace(event) {
15:   const bytes = Buffer.from(JSON.stringify({...event,profile:PROFILE,role:role.id}) + '\n');
16:   traceBytes += bytes.length;
17:   if (traceBytes > 524288) throw Error('TRACE_LIMIT');
18:   fs.appendFileSync(role.trace,bytes);
19: }
20: trace({event:'permission-admitted',child:false,worker:false,loaderThreads:0});
21: registerHooks({
22:   resolve(specifier,context,nextResolve) {
23:     if (context.parentURL?.startsWith('file:')) {
24:       const parent = fileURLToPath(context.parentURL);
25:       if (!role.edges[parent]?.includes(specifier)) throw Error('EDGE_REFUSED');
26:     }
27:     if (specifier.startsWith('node:')) {
28:       if (!role.builtins.includes(specifier)) throw Error('BUILTIN_REFUSED');
29:       return nextResolve(specifier,context);
30:     }
31:     const resolved = nextResolve(specifier,context);
32:     if (!resolved.url.startsWith('file:') || !Object.hasOwn(role.files,fileURLToPath(resolved.url))) throw Error('LOAD_BINDING_REFUSED');
33:     return resolved;
34:   },
35:   load(url,context,nextLoad) {
36:     if (url.startsWith('node:')) return nextLoad(url,context);
37:     const filename = fileURLToPath(url), pin = role.files[filename];
38:     if (!pin) throw Error('LOAD_BINDING_REFUSED');
39:     const bytes = readPinned(filename,pin);
40:     trace({event:'module-loaded',url,bytes:bytes.length,sha256:hash(bytes)});
41:     return {format:'module',source:bytes,shortCircuit:true};
42:   }
43: });
44: trace({event:'synchronous-hooks-installed',loaderThreads:0});
