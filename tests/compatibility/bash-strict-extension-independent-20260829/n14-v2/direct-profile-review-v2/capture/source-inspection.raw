### case-driver.mjs
1: import fs from 'node:fs';
2: import {pathToFileURL} from 'node:url';
3: import {PROFILE} from './profile.mjs';
4: import {runCase} from './case-adapter.mjs';
5: import {compareRaw,validateMatrix} from './data.mjs';
6: const role=JSON.parse(fs.readFileSync(process.env.SURFACE_ROLE));const matrix=JSON.parse(fs.readFileSync(role.matrix));validateMatrix(matrix);const row=matrix.cases.find(value=>value.id===role.caseId);if(!row)throw Error('CASE_MEMBERSHIP');
7: const api=role.layout==='source-built'?await import(pathToFileURL(role.productEntry)):await import('virtual-bash');
8: const controller=new AbortController();const timer=setTimeout(()=>controller.abort(Error('CASE_EXEC_DEADLINE')),3000);
9: let result;try{result=await runCase(api,row,matrix.fixtures,controller.signal);}finally{clearTimeout(timer);}
10: if(controller.signal.aborted)throw controller.signal.reason;
11: const clean={...result};delete clean.primary;delete clean.cleanupError;
12: if(result.hasPrimary&&result.primary instanceof Error&&/ADAPTER_CAPTURE|CAPTURE_RESULT|SNAPSHOT/.test(result.primary.message))throw result.primary;
13: if(result.hasCleanupError)throw Error('CASE_CLEANUP_REJECTED');
14: const output={profile:PROFILE,publicSettlement:result.publicSettlement,caseId:row.id,layout:role.layout,observation:clean,rawComparison:compareRaw(row.nativeObservation,clean),interpretation:row.comparison.semanticTags,qualification:'Bash3.2 raw observation comparison; no automatic GNU5.3 parity or normalized pass'};
15: process.stdout.write(JSON.stringify(output)+'\n');
