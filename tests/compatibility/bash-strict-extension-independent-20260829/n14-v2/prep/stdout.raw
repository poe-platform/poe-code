await record('N08-pipefail-boundary',async row=>{const actual=await create().exec('set -uo pipefail; let absent | cat; printf "status:%s" "$?"');result(row,actual,0,'status:1');fatal(actual,'absent');});
await record('N09-substring-length-read',async row=>{const actual=await create().exec('set -u; word=abcdef; printf "%s" "${word:1:absent}"; printf forbidden');result(row,actual,1,'');fatal(actual,'absent');assert.doesNotMatch(actual.stderr,/word: absent/);});
await record('N10-invalid-tail-positionals',async row=>{const actual=await create().exec('set -- one two; set -uz three; printf "tail:%s:%s\n" "$#" "$1"; printf "%s" "$absent"');result(row,actual,1,'tail:2:one\n');fatal(actual,'absent');assert.equal(actual.stderr.split('unsupported shell option').length-1,1);});
