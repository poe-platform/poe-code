function create(){const owner=new api.Shell({fs:new api.MemoryFileSystem(),cwd:'/'}).use(api.agentCommands());shells.add(owner);return owner;}
async function record(id,body){
 const row={id,role:'INDEPENDENT_RATIFIED_PRODUCT_PROFILE_NOT_NATIVE',pass:false};
 const timer=setTimeout(()=>{console.error('INDEPENDENT_CASE_DEADLINE',id);process.exit(78);},30000);
