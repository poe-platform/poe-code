 finally{for(const release of releases)release();releases.clear();const settled=await Promise.allSettled([...shells].map(owner=>owner.dispose()));row.created=shells.size;row.disposed=settled.filter(item=>item.status==='fulfilled').length;row.cleanupFailure=row.created!==row.disposed;row.cleanupReasons=settled.filter(item=>item.status==='rejected').map(item=>({type:typeof item.reason,text:String(item.reason)}));shells.clear();await turn();clearTimeout(timer);}
 rows.push(row);console.log(JSON.stringify(row));if(row.cleanupFailure||unhandled.length)process.exit(78);
}
function result(row,actual,status,stdout){row.actual=actual;assert.equal(actual.exitCode,status);assert.equal(actual.stdout,stdout);}
function fatal(actual,name){assert.equal(actual.stderr.split(name+': unbound variable').length-1,1);assert.doesNotMatch(actual.stderr,/let:|\(\(:|NounsetFailure|NounsetDiagnosticFailure/);}
await record('N01-write-only-empty',async row=>{const actual=await create().exec('set -u; empty=; (( target = empty + 4 )); printf "%s:%s" "$target" "$((empty))"');result(row,actual,0,'4:0');assert.equal(actual.stderr,'');});
await record('N02-rhs-before-publication',async row=>{const actual=await create().exec('readonly target=9; set -u; (( target = absent + 1 )); printf forbidden');result(row,actual,1,'');fatal(actual,'absent');assert.doesNotMatch(actual.stderr,/readonly variable/);});
