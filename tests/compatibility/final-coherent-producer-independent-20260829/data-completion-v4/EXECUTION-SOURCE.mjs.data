function read(filename,expected={}){const stat=fs.lstatSync(filename);assert(stat.isFile()&&!stat.isSymbolicLink()&&stat.size<=16777216);if(expected.bytes!==undefined)assert.equal(stat.size,expected.bytes);if(expected.size!==undefined)assert.equal(stat.size,expected.size);if(expected.mode!==undefined)assert.equal(stat.mode&511,typeof expected.mode==='string'?parseInt(expected.mode,8)&511:expected.mode);const bytes=fs.readFileSync(filename);assert.equal(bytes.length,stat.size);if(expected.sha256)assert.equal(sha(bytes),expected.sha256);if(expected.blob)assert.equal(blob(bytes),expected.blob);bound.push({path:filename,bytes:bytes.length,sha256:sha(bytes),mode:stat.mode&511});return bytes;}
