+import { forwardOwnedWebDavFetch, registerMockWebDavFetch, registerOwnedResourceResponse } from "../../../src/fs/webdav/resource-id.js";
+
+function resourceMap() {
+  const files = new Map<string, Uint8Array | null>();
+  const identities = new Map<string, { readonly identifier: string }>();
+  Object.defineProperties(files, {
+    set: { configurable: true, writable: true, value(path: string, value: Uint8Array | null) {
+      if (!files.has(path)) identities.set(path, Object.freeze({ identifier: `urn:uuid:${randomUUID()}` }));
+      Map.prototype.set.call(files, path, value);
+      return files;
+    } },
+    delete: { configurable: true, writable: true, value(path: string) {
+      identities.delete(path);
+      return Map.prototype.delete.call(files, path);
+    } },
+    clear: { configurable: true, writable: true, value() { identities.clear(); Map.prototype.clear.call(files); } },
+  });
+  return {
+    files,
+    identity(path: string) { return identities.get(path); },
+    restoreIdentity(path: string, identity: { readonly identifier: string }): void {
+      identities.set(path, identity);
+    },
+    preserveIdentity(source: string, destination: string) {
+      const identity = identities.get(source);
+      if (identity) identities.set(destination, identity);
+    },
+  };
+}
 
