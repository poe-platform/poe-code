{"location":"retained/5","path":"tests/compatibility/bash-conditional-author-20260829/conditional-v4.mjs","bytes":14524,"sha256":"0c8216e79aeaadd22bededaf2cc72a8daf83e296584c4b31efa2fed0b5c917e7","selected":[{"line":1,"text":"import assert from 'node:assert/strict';"},{"line":2,"text":"import * as api from 'virtual-bash';"},{"line":12,"text":"  finally { const disposed = await Promise.allSettled([...shells].map(shell => shell.dispose())); row.created = shells.size; row.disposed = disposed.filter(item => item.status === 'fulfilled').length; row.cleanupFailure = row.created !== row.disposed; shells.clear(); clearTimeout(timer); }"},{"line":127,"text":"console.log(JSON.stringify({ summary: { cases: rows.length, pass: rows.filter(row => row.pass).length, fail: rows.filter(row => !row.pass).length, native: 0 } }));"}]}
