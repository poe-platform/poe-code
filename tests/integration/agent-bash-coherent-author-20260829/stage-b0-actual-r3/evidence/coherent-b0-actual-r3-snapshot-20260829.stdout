SEALED_SOURCE_REFERENCE run.mjs import fs from 'node:fs';import path from 'node:path';import assert from 'node:assert/strict';import {pathToFileURL} from 'node:url';import {gunzipSync} from 'node:zlib';
import {read,sha,streamed,inventory,json,supervisor,safe,reasonRecord} from './owner.mjs';
const here=import.meta.dirname,base=path.dirname(here),repo='/Users/kjopek/Workspace/safe-bash';
