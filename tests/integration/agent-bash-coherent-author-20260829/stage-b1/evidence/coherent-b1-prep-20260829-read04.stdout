35:    "commit": "4a0268f2561d3b2aabf7511656baad968ee64986",
36:    "path": "tests/compatibility/bash-strict-mode-design-20260829/CASES.json",
37:    "blob": "4d0fe40653cf150cf790dacf0418da8b15072eba",
38:    "bytes": 9222,
39:    "sha256": "99468cfc96e56130fa65ce12835f4d8a3740002ec9519ea306d4e120cbe5adff",
40:    "text": "{\n  \"schema\": \"bash-strict-mode-proposed-identities-v1\",\n  \"date\": \"2026-08-29\",\n  \"candidate\": \"c83f352f057c64917f219eb938f54aa42cdab829\",\n  \"execution\": \"UNRUN\",\n  \"expectedRuntimeForEveryCase\": null,\n  \"rule\": \"Questions and proposed invariants are not observed outputs or native goldens. No product/native/compiler/worker execution authorized.\",\n  \"cases\": [\n    {\"id\":\"U01\",\"program\":\"set -euo pipefail; printf '%s\\\\n' ready\",\"question\":\"Common header accepts clusters; existing e/pipefail unchanged\",\"basis\":\"P1/G1\"},\n    {\"id\":\"U02\",\"program\":\"set -eu; set +ue; printf '<%s>\\\\n' \\\"$missing\\\"\",\"question\":\"Both bits disable; missing value after+u\",\"basis\":\"P1/G1\"},\n    {\"id\":\"U03\",\"program\":\"set -o nounset; set +o nounset; printf '<%s>\\\\n' \\\"$missing\\\"\",\"question\":\"Named on/off agrees with short forms\",\"basis\":\"P1/G1\"},\n    {\"id\":\"U04\",\"program\":\"set -u -- -x ''; printf '%s|<%s>|<%s>\\\\n' \\\"$#\\\" \\\"$1\\\" \\\"$2\\\"; set --; printf '%s\\\\n' \\\"$#\\\"\",\"question\":\"-- replaces/clears positionals and preserves empty\",\"basis\":\"G1/P1\"},\n    {\"id\":\"U05\",\"program\":\"set -- a b; set -; printf '%s:%s\\\\n' \\\"$#\\\" \\\"$1\\\"; set - c; printf '%s:%s\\\\n' \\\"$#\\\" \\\"$1\\\"\",\"question\":\"Lone- positional behavior\",\"basis\":\"P1\"},\n    {\"id\":\"U06\",\"program\":\"set -uz; printf '%s\\\\n' after\",\"question\":\"Invalid-tail status/termination/partial mutation must be qualified\",\"basis\":\"OPEN-P1\"},\n    {\"id\":\"U07\",\"program\":\"set -u; set -o; printf '%s\\\\n' after\",\"question\":\"Missing o operand/listing remains explicit supported-profile gap\",\"basis\":\"OUTSIDE-P1\"},\n    {\"id\":\"U08\",\"program\":\"set -eu; printf '%s\\\\n' \\\"$-\\\"; set +u; printf '%s\\\\n' \\\"$-\\\"\",\"question\":\"Actual e/u visibility; native extra flags retained as differences\",\"basis\":\"P1\"},\n    {\"id\":\"U09\",\"program\":\"printf '<%s>\\\\n' \\\"$missing\\\"\",\"question\":\"Default nounset off\",\"basis\":\"ROOT\"},\n    {\"id\":\"U10\",\"program\":\"set -u; printf '<%s>\\\\n' \\\"$missing\\\"; printf '%s\\\\n' after\",\"question\":\"Fatal unguarded scalar expansion and no later statement\",\"basis\":\"G1/P4\"},\n    {\"id\":\"U11\",\"program\":\"set -u; empty=; printf '<%s>\\\\n' \\\"$empty\\\"\",\"question\":\"Empty value is set\",\"basis\":\"G2\"},\n    {\"id\":\"U12\",\"program\":\"set -u; empty=; printf '%s|%s|%s|%s\\\\n' \\\"${missing-default}\\\" \\\"${missing:-default}\\\" \\\"${empty-default}\\\" \\\"${empty:-default}\\\"\",\"question\":\"Unset versus empty colon tests\",\"basis\":\"G2\"},\n    {\"id\":\"U13\",\"program\":\"set -u; empty=; printf '<%s>|<%s>|<%s>|<%s>\\\\n' \\\"${missing+yes}\\\" \\\"${missing:+yes}\\\" \\\"${empty+yes}\\\" \\\"${empty:+yes}\\\"\",\"question\":\"Alternative presence tests without eager read failure\",\"basis\":\"G2\"},\n    {\"id\":\"U14\",\"program\":\"set -u; printf '%s\\\\n' \\\"${missing:=ok}\\\"; printf '%s\\\\n' \\\"$missing\\\"\",\"question\":\"Guarded assignment creates value\",\"basis\":\"G2\"},\n    {\"id\":\"U15\",\"program\":\"set -u; value=ok; printf '%s|<%s>\\\\n' \\\"${value:-$missing}\\\" \\\"${absent:+$missing}\\\"\",\"question\":\"Unselected alternates not expanded\",\"basis\":\"G2/P2\"},\n    {\"id\":\"U16\",\"program\":\"set -u; printf '%s\\\\n' \\\"${absent:-$missing}\\\"; printf '%s\\\\n' after\",\"question\":\"Selected alternate missing read fails\",\"basis\":\"G2/P2\"},\n    {\"id\":\"U17\",\"program\":\"set -u; printf '%s\\\\n' \\\"${missing:?required}\\\"; printf '%s\\\\n' after\",\"question\":\"Existing explicit-error behavior separate from new nounset mapping\",\"basis\":\"G2/KNOWN-PROFILE\"},\n    {\"id\":\"U18\",\"program\":\"set -u; set --; printf '<%s>\\\\n' \\\"$1\\\"; printf '%s\\\\n' after\",\"question\":\"Missing positional error\",\"basis\":\"G1\"},\n    {\"id\":\"U19\",\"program\":\"set -u; set -- ''; printf '<%s>|%s\\\\n' \\\"$1\\\" \\\"${10-default}\\\"\",\"question\":\"Present empty and guarded multi-digit positional\",\"basis\":\"G2\"},\n    {\"id\":\"U20\",\"program\":\"set -u; set --; printf 'n=%s\\\\n' \\\"$#\\\"; printf '<%s>\\\\n' \\\"$@\\\"; printf '<%s>\\\\n' \\\"$*\\\"\",\"question\":\"Zero positionals @/* exceptions and word counts\",\"basis\":\"G1\"},\n    {\"id\":\"U21\",\"program\":\"set -u; set -- a '' b; IFS=:; printf '<%s>\\\\n' \\\"$@\\\"; printf '<%s>\\\\n' \\\"$*\\\"\",\"question\":\"Exceptions preserve joins and empty members\",\"basis\":\"G1/G2\"},\n    {\"id\":\"U22\",\"program\":\"set -u; printf '<%s>\\\\n' \\\"${a[@]}\\\"; printf '<%s>\\\\n' \\\"${a[*]}\\\"\",\"question\":\"Unset array member expansion exemption\",\"basis\":\"G1\"},\n    {\"id\":\"U23\",\"program\":\"set -u; a=(); printf '<%s>\\\\n' \\\"${a[@]}\\\"; printf '<%s>\\\\n' \\\"${a[*]}\\\"\",\"question\":\"Present empty array member exemption\",\"basis\":\"G1/G4\"},\n    {\"id\":\"U24\",\"program\":\"set -u; a=([2]=''); printf '<%s>\\\\n' \\\"${a[2]}\\\"; printf '<%s>\\\\n' \\\"${a[1]}\\\"\",\"question\":\"Sparse missing versus present empty element\",\"basis\":\"G4/P2\"},\n    {\"id\":\"U25\",\"program\":\"set -u; a=([2]=x); printf '<%s>\\\\n' \\\"$a\\\"\",\"question\":\"Bare sparse array reads element0 not any-member existence\",\"basis\":\"G4/P2\"},\n    {\"id\":\"U26\",\"program\":\"set -u; a=; printf '<%s>\\\\n' \\\"${a[0]}\\\"; printf '<%s>\\\\n' \\\"${a[1]}\\\"\",\"question\":\"Scalar-as-array zero versus missing nonzero\",\"basis\":\"P2\"},\n    {\"id\":\"U27\",\"program\":\"set -u; printf '%s\\\\n' \\\"${#a[@]}\\\"\",\"question\":\"Unset array count exception: exact GNU5.3 rule unresolved\",\"basis\":\"OPEN-P2\"},\n    {\"id\":\"U28\",\"program\":\"set -u; a=(); printf '%s|%s\\\\n' \\\"${#a[@]}\\\" \\\"${#a[*]}\\\"\",\"question\":\"Empty array count: exact GNU5.3 rule unresolved\",\"basis\":\"OPEN-P2\"},\n    {\"id\":\"U29\",\"program\":\"set -u; printf '%s\\\\n' \\\"${#missing}\\\"\",\"question\":\"Scalar length consumes missing value\",\"basis\":\"P2\"},\n    {\"id\":\"U30\",\"program\":\"set -u; printf '%s\\\\n' \\\"${missing#x}\\\"\",\"question\":\"Pattern removal consumes missing value\",\"basis\":\"P2\"},\n    {\"id\":\"U31\",\"program\":\"set -u; printf '%s\\\\n' \\\"$((missing+1))\\\"; printf '%s\\\\n' after\",\"question\":\"Arithmetic bare read nounset override needs primary/native qualification\",\"basis\":\"OPEN-P3\"},\n    {\"id\":\"U32\",\"program\":\"set -u; ((missing=2)); printf '%s\\\\n' \\\"$missing\\\"\",\"question\":\"Pure assignment LHS not read\",\"basis\":\"P3\"},\n    {\"id\":\"U33\",\"program\":\"set -u; ((missing+=2)); printf '%s\\\\n' after\",\"question\":\"Compound LHS read and fatal scope\",\"basis\":\"OPEN-P3\"},\n    {\"id\":\"U34\",\"program\":\"set -u; let 'missing++'; printf '%s\\\\n' after\",\"question\":\"LET increment read/control preservation\",\"basis\":\"OPEN-P3\"},\n    {\"id\":\"U35\",\"program\":\"set -u; empty=; printf '%s\\\\n' \\\"$((empty+1))\\\"; printf '%s\\\\n' \\\"$((1 || missing))\\\"; printf '%s\\\\n' \\\"$((0 ? missing : 4))\\\"\",\"question\":\"Empty zero and unvisited branches\",\"basis\":\"G3/P3\"},\n    {\"id\":\"U36\",\"program\":\"set -u; value=missing; let 'value+1'; printf '%s\\\\n' after\",\"question\":\"Recursive arithmetic missing-name diagnostic/termination\",\"basis\":\"OPEN-P3\"},\n    {\"id\":\"U37\",\"program\":\"set -u; printf '%s\\\\n' \\\"$(printf '%s' \\\"$missing\\\"; printf '%s' child-after)\\\"; printf '%s\\\\n' parent-after\",\"question\":\"Substitution child terminates; outer command status not forcibly replaced\",\"basis\":\"G5/P4\"},\n    {\"id\":\"U38\",\"program\":\"set -u; value=$(printf '%s' \\\"$missing\\\"); printf 'parent:%s\\\\n' \\\"$?\\\"\",\"question\":\"Assignment-only substitution status without-e\",\"basis\":\"G5/P4\"},\n    {\"id\":\"U39\",\"program\":\"set -u; f() { printf '%s\\\\n' \\\"$missing\\\"; }; f || printf '%s\\\\n' caught; printf '%s\\\\n' after\",\"question\":\"Function/current-scope nounset versus errexit suppression\",\"basis\":\"P4\"},\n    {\"id\":\"U40\",\"program\":\"set -u; source ./unit2-source.sh; printf '%s\\\\n' after\",\"files\":{\"unit2-source.sh\":\"printf '%s\\\\n' \\\"$missing\\\"\\nprintf '%s\\\\n' source-after\\n\"},\"question\":\"Sourced fatal scope and exact source line\",\"basis\":\"G5/P4\"},\n    {\"id\":\"U41\",\"program\":\"set -u; eval 'printf \\\"%s\\\\n\\\" \\\"$missing\\\"'; printf '%s\\\\n' after\",\"question\":\"Eval current fatal scope/source attribution\",\"basis\":\"P4\"},\n    {\"id\":\"U42\",\"program\":\"set -u; (printf '%s\\\\n' \\\"$missing\\\"); printf 'parent:%s\\\\n' \\\"$?\\\"\",\"question\":\"Subshell isolation and parent status\",\"basis\":\"G5/P4\"},\n    {\"id\":\"U43\",\"program\":\"set -u -o pipefail; printf '%s\\\\n' \\\"$missing\\\" | cat; printf 'pipeline:%s\\\\n' \\\"$?\\\"\",\"question\":\"Pipeline child failure through unchanged pipefail\",\"basis\":\"G1/G5/P4\"},\n    {\"id\":\"U44\",\"program\":\"set -euo pipefail; if false; then printf bad; fi; false || printf '%s\\\\n' guarded; printf '%s\\\\n' done\",\"question\":\"Existing errexit exemptions remain unchanged\",\"basis\":\"G1/P1\"},\n    {\"id\":\"U45\",\"protocol\":\"PUBLIC_REUSE\",\"question\":\"Exec set-u fatal then fresh exec missing expansion on same Shell; options reset, original stdin/shared budgets not leaked\"},\n    {\"id\":\"U46\",\"protocol\":\"NESTED_INVOKE\",\"question\":\"Literal registered command invokes current function under copied nounset; no environment/local promotion; sibling and parent option isolation\"},\n    {\"id\":\"U47\",\"protocol\":\"CALLER_PRECEDENCE\",\"question\":\"Controlled caller abort during blocked diagnostic; exact caller reason including falsy sentinel, owned cleanup completed before settlement\"},\n    {\"id\":\"U48\",\"protocol\":\"LIMIT_PRECEDENCE\",\"question\":\"Exact existing ShellLimitError from diagnostic budget is not swallowed/recast as nounset status or duplicate diagnostic\"},\n    {\"id\":\"U49\",\"protocol\":\"SINK_REJECTION\",\"question\":\"Diagnostic sink throws distinct object/undefined in predeclared separate control roles; exact escaping reason, no fallback message or success\"},\n    {\"id\":\"U50\",\"protocol\":\"UNWIND_RESOURCES\",\"question\":\"Controlled source/function/array/input owners unwind once on nounset; required cleanup awaited; failures retained, sibling lease untouched; no opaque host preemption\"}\n  ]\n}\n"
