64:    "text": "{\n  \"schema\": \"strict-extension-design-v1\",\n  \"original\": 11,\n  \"inheritedProbes\": 7,\n  \"newPrograms\": 5,\n  \"hostProtocols\": 5,\n  \"identities\": 28,\n  \"nativeExecutions\": 0,\n  \"cases\": [\n    {\n      \"id\": \"U06\",\n      \"program\": \"set -uz; printf '%s\\\\n' after\",\n      \"question\": \"Invalid-tail status/termination/partial mutation must be qualified\",\n      \"basis\": \"OPEN-P1\",\n      \"version\": \"ORIGINAL_UNCHANGED\",\n      \"expectedRuntime\": null,\n      \"execution\": \"UNRUN\",\n      \"invocationProfile\": \"GNU53_DEFAULT_ONESHOT_C\",\n      \"expectedNativeRuntime\": null,\n      \"role\": \"UNCHANGED_SOURCE_REFERENCE_PROGRAM_UNRUN\"\n    },\n    {\n      \"id\": \"U07\",\n      \"program\": \"set -u; set -o; printf '%s\\\\n' after\",\n      \"question\": \"Missing o operand/listing remains explicit supported-profile gap\",\n      \"basis\": \"OUTSIDE-P1\",\n      \"version\": \"ORIGINAL_UNCHANGED\",\n      \"expectedRuntime\": null,\n      \"execution\": \"UNRUN\",\n      \"invocationProfile\": \"GNU53_DEFAULT_ONESHOT_C\",\n      \"expectedNativeRuntime\": null,\n      \"role\": \"UNCHANGED_SOURCE_REFERENCE_PROGRAM_UNRUN\"\n    },\n    {\n      \"id\": \"U17\",\n      \"program\": \"set -u; printf '%s\\\\n' \\\"${missing:?required}\\\"; printf '%s\\\\n' after\",\n      \"question\": \"Existing explicit-error behavior separate from new nounset mapping\",\n      \"basis\": \"G2/KNOWN-PROFILE\",\n      \"version\": \"ORIGINAL_UNCHANGED\",\n      \"expectedRuntime\": null,\n      \"execution\": \"UNRUN\",\n      \"invocationProfile\": \"GNU53_DEFAULT_ONESHOT_C\",\n      \"expectedNativeRuntime\": null,\n      \"role\": \"UNCHANGED_SOURCE_REFERENCE_PROGRAM_UNRUN\"\n    },\n    {\n      \"id\": \"U27\",\n      \"program\": \"set -u; printf '%s\\\\n' \\\"${#a[@]}\\\"\",\n      \"question\": \"Unset array count exception: exact GNU5.3 rule unresolved\",\n      \"basis\": \"OPEN-P2\",\n      \"version\": \"ORIGINAL_UNCHANGED\",\n      \"expectedRuntime\": null,\n      \"execution\": \"UNRUN\",\n      \"invocationProfile\": \"GNU53_DEFAULT_ONESHOT_C\",\n      \"expectedNativeRuntime\": null,\n      \"role\": \"UNCHANGED_SOURCE_REFERENCE_PROGRAM_UNRUN\"\n    },\n    {\n      \"id\": \"U28\",\n      \"program\": \"set -u; a=(); printf '%s|%s\\\\n' \\\"${#a[@]}\\\" \\\"${#a[*]}\\\"\",\n      \"question\": \"Empty array count: exact GNU5.3 rule unresolved\",\n      \"basis\": \"OPEN-P2\",\n      \"version\": \"ORIGINAL_UNCHANGED\",\n      \"expectedRuntime\": null,\n      \"execution\": \"UNRUN\",\n      \"invocationProfile\": \"GNU53_DEFAULT_ONESHOT_C\",\n      \"expectedNativeRuntime\": null,\n      \"role\": \"UNCHANGED_SOURCE_REFERENCE_PROGRAM_UNRUN\"\n    },\n    {\n      \"id\": \"U31\",\n      \"program\": \"set -u; printf '%s\\\\n' \\\"$((missing+1))\\\"; printf '%s\\\\n' after\",\n      \"question\": \"Arithmetic bare read nounset override needs primary/native qualification\",\n      \"basis\": \"OPEN-P3\",\n      \"version\": \"ORIGINAL_UNCHANGED\",\n      \"expectedRuntime\": null,\n      \"execution\": \"UNRUN\",\n      \"invocationProfile\": \"GNU53_DEFAULT_ONESHOT_C\",\n      \"expectedNativeRuntime\": null,\n      \"role\": \"UNCHANGED_SOURCE_REFERENCE_PROGRAM_UNRUN\"\n    },\n    {\n      \"id\": \"U32\",\n      \"program\": \"set -u; ((missing=2)); printf '%s\\\\n' \\\"$missing\\\"\",\n      \"question\": \"Pure assignment LHS not read\",\n      \"basis\": \"P3\",\n      \"version\": \"ORIGINAL_UNCHANGED\",\n      \"expectedRuntime\": null,\n      \"execution\": \"UNRUN\",\n      \"invocationProfile\": \"GNU53_DEFAULT_ONESHOT_C\",\n      \"expectedNativeRuntime\": null,\n      \"role\": \"UNCHANGED_SOURCE_REFERENCE_PROGRAM_UNRUN\"\n    },\n    {\n      \"id\": \"U33\",\n      \"program\": \"set -u; ((missing+=2)); printf '%s\\\\n' after\",\n      \"question\": \"Compound LHS read and fatal scope\",\n      \"basis\": \"OPEN-P3\",\n      \"version\": \"ORIGINAL_UNCHANGED\",\n      \"expectedRuntime\": null,\n      \"execution\": \"UNRUN\",\n      \"invocationProfile\": \"GNU53_DEFAULT_ONESHOT_C\",\n      \"expectedNativeRuntime\": null,\n      \"role\": \"UNCHANGED_SOURCE_REFERENCE_PROGRAM_UNRUN\"\n    },\n    {\n      \"id\": \"U34\",\n      \"program\": \"set -u; let 'missing++'; printf '%s\\\\n' after\",\n      \"question\": \"LET increment read/control preservation\",\n      \"basis\": \"OPEN-P3\",\n      \"version\": \"ORIGINAL_UNCHANGED\",\n      \"expectedRuntime\": null,\n      \"execution\": \"UNRUN\",\n      \"invocationProfile\": \"GNU53_DEFAULT_ONESHOT_C\",\n      \"expectedNativeRuntime\": null,\n      \"role\": \"UNCHANGED_SOURCE_REFERENCE_PROGRAM_UNRUN\"\n    },\n    {\n      \"id\": \"U35\",\n      \"program\": \"set -u; empty=; printf '%s\\\\n' \\\"$((empty+1))\\\"; printf '%s\\\\n' \\\"$((1 || missing))\\\"; printf '%s\\\\n' \\\"$((0 ? missing : 4))\\\"\",\n      \"question\": \"Empty zero and unvisited branches\",\n      \"basis\": \"G3/P3\",\n      \"version\": \"ORIGINAL_UNCHANGED\",\n      \"expectedRuntime\": null,\n      \"execution\": \"UNRUN\",\n      \"invocationProfile\": \"GNU53_DEFAULT_ONESHOT_C\",\n      \"expectedNativeRuntime\": null,\n      \"role\": \"UNCHANGED_SOURCE_REFERENCE_PROGRAM_UNRUN\"\n    },\n    {\n      \"id\": \"U36\",\n      \"program\": \"set -u; value=missing; let 'value+1'; printf '%s\\\\n' after\",\n      \"question\": \"Recursive arithmetic missing-name diagnostic/termination\",\n      \"basis\": \"OPEN-P3\",\n      \"version\": \"ORIGINAL_UNCHANGED\",\n      \"expectedRuntime\": null,\n      \"execution\": \"UNRUN\",\n      \"invocationProfile\": \"GNU53_DEFAULT_ONESHOT_C\",\n      \"expectedNativeRuntime\": null,\n      \"role\": \"UNCHANGED_SOURCE_REFERENCE_PROGRAM_UNRUN\"\n    },\n    {\n      \"id\": \"S-U06-PARTIAL-v1\",\n      \"program\": \"set -uz; printf \\\"set-status:%s\\\\n\\\" \\\"$?\\\"; printf \\\"%s\\\\n\\\" \\\"$missing\\\"; printf \\\"after\\\\n\\\"\",\n      \"question\": \"Observe incremental u mutation separately from invalid-tail status and subsequent fatal read.\",\n      \"version\": \"SOURCE_PROPOSED_V1\",\n      \"expectedRuntime\": null,\n      \"execution\": \"UNRUN\",\n      \"invocationProfile\": \"GNU53_DEFAULT_ONESHOT_C\",\n      \"expectedNativeRuntime\": null,\n      \"role\": \"UNCHANGED_SOURCE_REFERENCE_PROGRAM_UNRUN\"\n    },\n    {\n      \"id\": \"S-U07-LIST-STATUS-v1\",\n      \"program\": \"set -u; set -o; printf \\\"list-status:%s\\\\n\\\" \\\"$?\\\"; printf \\\"after\\\\n\\\"\",\n      \"question\": \"Preserve complete raw listing and subsequent status; no output filtering or invented option labels.\",\n      \"version\": \"SOURCE_PROPOSED_V1\",\n      \"expectedRuntime\": null,\n      \"execution\": \"UNRUN\",\n      \"invocationProfile\": \"GNU53_DEFAULT_ONESHOT_C\",\n      \"expectedNativeRuntime\": null,\n      \"role\": \"UNCHANGED_SOURCE_REFERENCE_PROGRAM_UNRUN\"\n    },\n    {\n      \"id\": \"S-U27-INPUT-UNIT-v1\",\n      \"program\": \"set -u; printf \\\"%s\\\\n\\\" \\\"${#a[@]}\\\"; printf \\\"same-unit\\\\n\\\"\\nprintf \\\"next-unit:%s\\\\n\\\" \\\"$?\\\"\\n\",\n      \"question\": \"Distinguish nonfatal DISCARD from FORCE_EOF and same-line versus next parsed unit.\",\n      \"version\": \"SOURCE_PROPOSED_V1\",\n      \"expectedRuntime\": null,\n      \"execution\": \"UNRUN\",\n      \"invocationProfile\": \"GNU53_DEFAULT_ONESHOT_C\",\n      \"expectedNativeRuntime\": null,\n      \"role\": \"UNCHANGED_SOURCE_REFERENCE_PROGRAM_UNRUN\"\n    },\n    {\n      \"id\": \"S-U28-PRESENCE-v1\",\n      \"program\": \"set -u; a=(); printf \\\"len:%s|guard:%s\\\\n\\\" \\\"${#a[@]}\\\" \\\"${a[@]+present}\\\"\",\n      \"question\": \"Do not collapse existing empty array object/length with aggregate expansion presence; presence tuple unmeasured.\",\n      \"version\": \"SOURCE_PROPOSED_V1\",\n      \"expectedRuntime\": null,\n      \"execution\": \"UNRUN\",\n      \"invocationProfile\": \"GNU53_DEFAULT_ONESHOT_C\",\n      \"expectedNativeRuntime\": null,\n      \"role\": \"UNCHANGED_SOURCE_REFERENCE_PROGRAM_UNRUN\"\n    },\n    {\n      \"id\": \"S-ARITH-SUBSHELL-v1\",\n      \"program\": \"(set -u; let \\\"missing++\\\"; printf \\\"child-after\\\\n\\\")\\nprintf \\\"parent:%s\\\\n\\\" \\\"$?\\\"\\n\",\n      \"question\": \"Record actual isolated fatal status and parent continuation; no inherited root-status golden.\",\n      \"version\": \"SOURCE_PROPOSED_V1\",\n      \"expectedRuntime\": null,\n      \"execution\": \"UNRUN\",\n      \"invocationProfile\": \"GNU53_DEFAULT_ONESHOT_C\",\n      \"expectedNativeRuntime\": null,\n      \"role\": \"UNCHANGED_SOURCE_REFERENCE_PROGRAM_UNRUN\"\n    },\n    {\n      \"id\": \"S-ARITH-SUBSTITUTION-v1\",\n      \"program\": \"set -u; result=$(let \\\"missing++\\\"); printf \\\"status:%s|result:%s\\\\n\\\" \\\"$?\\\" \\\"$result\\\"\",\n      \"question\": \"Record assignment substitution status and parent continuation without -e.\",\n      \"version\": \"SOURCE_PROPOSED_V1\",\n      \"expectedRuntime\": null,\n      \"execution\": \"UNRUN\",\n      \"invocationProfile\": \"GNU53_DEFAULT_ONESHOT_C\",\n      \"expectedNativeRuntime\": null,\n      \"role\": \"UNCHANGED_SOURCE_REFERENCE_PROGRAM_UNRUN\"\n    },\n    {\n      \"id\": \"S-U31-STDIN-v1\",\n      \"program\": \"set -u; printf '%s\\\\n' \\\"$((missing+1))\\\"; printf '%s\\\\n' after\",\n      \"invocationProfile\": \"GNU53_NONINTERACTIVE_STDIN\",\n      \"question\": \"Same literal source through reader loop rather than ONESHOT -c; preserve both raw profiles.\",\n      \"version\": \"SOURCE_PROPOSED_V1\",\n      \"expectedRuntime\": null,\n      \"execution\": \"UNRUN\",\n      \"expectedNativeRuntime\": null,\n      \"role\": \"UNCHANGED_SOURCE_REFERENCE_PROGRAM_UNRUN\"\n    },\n    {\n      \"id\": \"E19-plus-tail\",\n      \"program\": \"set -u; set +uz; printf \\\"set:%s|flags:%s\\\\n\\\" \\\"$?\\\" \\\"$-\\\"; printf \\\"%s\\\\n\\\" \\\"$missing\\\"\",\n      \"question\": \"Partial +u mutation survives invalid tail; distinguish command status from final script status.\",\n      \"version\": \"EXTENSION_DESIGN_V1\",\n      \"role\": \"NEIGHBOR_PROGRAM_POLICY_OR_REFERENCE_OPEN\",\n      \"execution\": \"UNRUN\",\n      \"expectedRuntime\": null,\n      \"expectedNativeRuntime\": null,\n      \"invocationProfile\": \"GNU53_DEFAULT_ONESHOT_C\"\n    },\n    {\n      \"id\": \"E20-subset-listing\",\n      \"program\": \"set -- one two; set -u; set +o; printf \\\"count:%s|first:%s\\\\n\\\" \\\"$#\\\" \\\"$1\\\"\",\n      \"question\": \"Capture exact truthful proposed subset listing and positional preservation; ROOT listing policy required.\",\n      \"version\": \"EXTENSION_DESIGN_V1\",\n      \"role\": \"NEIGHBOR_PROGRAM_POLICY_OR_REFERENCE_OPEN\",\n      \"execution\": \"UNRUN\",\n      \"expectedRuntime\": null,\n      \"expectedNativeRuntime\": null,\n      \"invocationProfile\": \"GNU53_DEFAULT_ONESHOT_C\"\n    },\n    {\n      \"id\": \"E21-write-only-chain\",\n      \"program\": \"set -u; ((outer=(inner=2))); printf \\\"%s|%s\\\\n\\\" \\\"$outer\\\" \\\"$inner\\\"\",\n      \"question\": \"No fabricated LHS read in nested direct assignments; preserve signed64 publication rules.\",\n      \"version\": \"EXTENSION_DESIGN_V1\",\n      \"role\": \"NEIGHBOR_PROGRAM_POLICY_OR_REFERENCE_OPEN\",\n      \"execution\": \"UNRUN\",\n      \"expectedRuntime\": null,\n      \"expectedNativeRuntime\": null,\n      \"invocationProfile\": \"GNU53_DEFAULT_ONESHOT_C\"\n    },\n    {\n      \"id\": \"E22-function-fatal\",\n      \"program\": \"set -u; f() { let \\\"missing++\\\"; printf \\\"function-after\\\\n\\\"; }; f; printf \\\"caller-after\\\\n\\\"\",\n      \"question\": \"Typed fatal control must not become a LET status or a local function return; native final tuple open.\",\n      \"version\": \"EXTENSION_DESIGN_V1\",\n      \"role\": \"NEIGHBOR_PROGRAM_POLICY_OR_REFERENCE_OPEN\",\n      \"execution\": \"UNRUN\",\n      \"expectedRuntime\": null,\n      \"expectedNativeRuntime\": null,\n      \"invocationProfile\": \"GNU53_DEFAULT_ONESHOT_C\"\n    },\n    {\n      \"id\": \"E23-source-discard\",\n      \"program\": \"set -u; . ./missing-length.sh; printf \\\"caller-after\\\\n\\\"\\nprintf \\\"next:%s\\\\n\\\" \\\"$?\\\"\\n\",\n      \"files\": {\n        \"missing-length.sh\": \"printf \\\"%s\\\\n\\\" \\\"${#a[@]}\\\"; printf \\\"source-same\\\\n\\\"\\nprintf \\\"source-next\\\\n\\\"\\n\"\n      },\n      \"question\": \"Root/caller versus sourced reader continuation boundary; explicit HOLD pending policy/native evidence, not guessed golden.\",\n      \"version\": \"EXTENSION_DESIGN_V1\",\n      \"role\": \"NEIGHBOR_PROGRAM_POLICY_OR_REFERENCE_OPEN\",\n      \"execution\": \"UNRUN\",\n      \"expectedRuntime\": null,\n      \"expectedNativeRuntime\": null,\n      \"invocationProfile\": \"GNU53_DEFAULT_ONESHOT_C\"\n    },\n    {\n      \"id\": \"H24-preabort\",\n      \"program\": \"set -u; let \\\"missing++\\\"\",\n      \"protocol\": \"Preaborted public caller with exact frozen object reason; no command/diagnostic work. Capture rejection separately from mapped shell status.\",\n      \"variants\": [\n        \"object-reason\"\n      ],\n      \"version\": \"EXTENSION_DESIGN_V1\",\n      \"role\": \"PUBLIC_HOST_CONTRACT_PROPOSAL\",\n      \"execution\": \"UNRUN\",\n      \"expectedRuntime\": null,\n      \"expectedNativeRuntime\": null,\n      \"invocationProfile\": \"PRODUCT_PUBLIC_API_ONLY_NO_NATIVE_EQUIVALENCE\"\n    },\n    {\n      \"id\": \"H25-falsy-sink\",\n      \"program\": \"set -u; let \\\"missing++\\\"\",\n      \"protocol\": \"Original caller stderr rejects a tagged falsy value during strict diagnostic; retain exact thrown value and observe completion/cleanup. Do not use truthiness to detect rejection.\",\n      \"variants\": [\n        \"undefined\",\n        \"null\",\n        \"false\",\n        \"zero\",\n        \"empty-string\"\n      ],\n      \"version\": \"EXTENSION_DESIGN_V1\",\n      \"role\": \"PUBLIC_HOST_CONTRACT_PROPOSAL\",\n      \"execution\": \"UNRUN\",\n      \"expectedRuntime\": null,\n      \"expectedNativeRuntime\": null,\n      \"invocationProfile\": \"PRODUCT_PUBLIC_API_ONLY_NO_NATIVE_EQUIVALENCE\"\n    },\n    {\n      \"id\": \"H26-read-budget\",\n      \"program\": \"set -u; let value\",\n      \"protocol\": \"Supply a scalar arithmetic expression exceeding existing maxExpansionBytes through explicit env, with a short argument. Confirm existing read-size admission precedes recursive parse/growth and genuine ShellLimitError escapes unchanged; no new limit API.\",\n      \"variants\": [\n        \"maxExpansionBytes32-value64bytes\"\n      ],\n      \"version\": \"EXTENSION_DESIGN_V1\",\n      \"role\": \"PUBLIC_HOST_CONTRACT_PROPOSAL\",\n      \"execution\": \"UNRUN\",\n      \"expectedRuntime\": null,\n      \"expectedNativeRuntime\": null,\n      \"invocationProfile\": \"PRODUCT_PUBLIC_API_ONLY_NO_NATIVE_EQUIVALENCE\"\n    },\n    {\n      \"id\": \"H27-registered-cleanup\",\n      \"program\": \"f() { set -u; let \\\"missing++\\\"; }; guard\",\n      \"protocol\": \"Public registered command guard registers cooperative cleanup before context.invoke(f). Hold/release cleanup explicitly, observe public settlement; compare successful cleanup with cleanup rejection after a mapped nonzero result. No opaque-provider promise or test-only hook.\",\n      \"variants\": [\n        \"held-cleanup-fulfills\",\n        \"held-cleanup-rejects-object\"\n      ],\n      \"version\": \"EXTENSION_DESIGN_V1\",\n      \"role\": \"PUBLIC_HOST_CONTRACT_PROPOSAL\",\n      \"execution\": \"UNRUN\",\n      \"expectedRuntime\": null,\n      \"expectedNativeRuntime\": null,\n      \"invocationProfile\": \"PRODUCT_PUBLIC_API_ONLY_NO_NATIVE_EQUIVALENCE\"\n    },\n    {\n      \"id\": \"H28-caller-during-diagnostic\",\n      \"program\": \"f() { set -u; let \\\"missing++\\\"; }; guard\",\n      \"protocol\": \"Use the same existing registered cooperative cleanup scope with a controlled diagnostic sink; request caller abort only after sink entry, explicitly release owned cleanup and preserve exact caller reason ahead of escaping/cleanup outcomes. Record events, not timing-only absence claims.\",\n      \"variants\": [\n        \"caller-and-cleanup-rejection\"\n      ],\n      \"version\": \"EXTENSION_DESIGN_V1\",\n      \"role\": \"PUBLIC_HOST_CONTRACT_PROPOSAL\",\n      \"execution\": \"UNRUN\",\n      \"expectedRuntime\": null,\n      \"expectedNativeRuntime\": null,\n      \"invocationProfile\": \"PRODUCT_PUBLIC_API_ONLY_NO_NATIVE_EQUIVALENCE\"\n    }\n  ]\n}\n"
