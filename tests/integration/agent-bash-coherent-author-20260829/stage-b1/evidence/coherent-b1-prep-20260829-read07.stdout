24:  const inert = { profile: nodeApi.NODE_PROFILE, identity: 'coherent-never-started-provider', prepare() { prepares++; throw new Error('unexpected provider preparation'); } };
25:  const make = (filesystem = memory, cwd = '/') => { const shell = new api.Shell({ fs: filesystem, cwd, env: {} }); shell.use(api.agentCommands()); shells.push(shell); return shell; };
