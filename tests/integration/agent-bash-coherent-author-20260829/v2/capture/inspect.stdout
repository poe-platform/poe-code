NODE_PUBLIC_FIXTURE
import assert from 'node:assert/strict';
import { pathToFileURL } from 'node:url';
import * as api from 'virtual-bash';
import * as nodeApi from 'virtual-bash/commands/node';
import { runWorkerCase } from './workers-v5.mjs';
const symbols=['createNodeCommand','createNodeCommands','nodeCommands','createNodeWorkerProvider','NODE_PROFILE','NODE_ENGINE_ABI','nodeLimits','NodeProfileError','NodeUsageError'].sort();
const defaultNames=["[","apply_patch","awk","base32","base64","basename","cat","chmod","cksum","column","comm","cp","cut","date","diff","dirname","du","echo","egrep","env","expand","expr","false","fgrep","file","find","fold","git","grep","gunzip","gzip","head","html-to-markdown","join","jq","ln","ls","md5sum","mkdir","mktemp","mv","nl","od","paste","patch","printenv","printf","pwd","readlink","realpath","rev","rg","rm","rmdir","sed","seq","sha1sum","sha256sum","sleep","sort","split","stat","strings","tac","tail","tar","tee","test","timeout","touch","tr","tree","true","unexpand","uniq","wc","which","xargs","xxd","zcat"];
const bytes=text=>new TextEncoder().encode(text);
const capture=promise=>promise.then(value=>({kind:'return',value}),reason=>({kind:'throw',reason}));
const turn=()=>new Promise(resolve=>setImmediate(resolve));
export async function runPublic(input,id,publish){
 const owners=[],events=[],facts={};let cleanupError=false;
 const memory=new api.MemoryFileSystem();
 const provider=(identity='author-public-bb23-node-adapter-v1',observe)=>nodeApi.createNodeWorkerProvider({entry:pathToFileURL(input.adapter).href,identity,observe:event=>{events.push(event);return observe?.(event);}});
 const shell=(grants={stdoutWrite:true,stderrWrite:true},options={})=>{const owner=new api.Shell({fs:options.fs??memory,cwd:'/',env:{MARK:'bound'}});owners.push(owner);if(options.aggregate!==false)owner.use(api.agentCommands());owner.use(nodeApi.nodeCommands({provider:options.provider??provider(),grants,...(options.replace===undefined?{}:{replace:options.replace})}));return owner;};
 const expect=async(owner,program,stdout,status=0,options)=>{const result=await owner.exec(program,options);facts.results??=[];facts.results.push({exitCode:result.exitCode,stdout:result.stdout,stderr:result.stderr,stdoutHex:Buffer.from(result.stdoutBytes).toString('hex'),stderrHex:Buffer.from(result.stderrBytes).toString('hex')});assert.equal(result.exitCode,status);assert.equal(result.stdout,stdout);if(status===0)assert.equal(result.stderr,'');return result;};
 let failure;
 try{
  if(id==='P01'){const names=api.createAgentCommands().map(item=>item.name).sort();assert.deepEqual(names,defaultNames);for(const name of ['node','npm','npx','curl'])assert(!names.includes(name));facts.names=names;}
  else if(id==='P02'){assert.deepEqual(Object.keys(nodeApi).sort(),symbols);for(const name of symbols)assert.equal(api[name],nodeApi[name]);assert.equal(nodeApi.NODE_PROFILE,'NP1-CJS-WRQ-L-SYNC-1');assert.equal(Object.keys(nodeApi.nodeLimits).length,24);assert(Object.isFrozen(nodeApi.nodeLimits));}
  else if(id==='P03'){const definitions=nodeApi.createNodeCommands({provider:provider()});assert.equal(definitions.length,1);assert.equal(definitions[0].name,'node');const owner=shell({}, {aggregate:false});await owner.exec('true').catch(()=>{});assert.deepEqual(owner.commands.list().map(item=>item.name),['node']);}
  else if(id==='P04'){const owner=shell();await expect(owner,'true','');assert.equal(owner.commands.list().length,81);assert(owner.commands.has('node'));assert(!owner.commands.has('npm'));assert(!owner.commands.has('curl'));}
  else if(id==='P05'){let invoked=0;const prepared={profile:nodeApi.NODE_PROFILE,identity:'inert-validation',prepare(){invoked++;throw Error('unexpected');}};for(const options of [{},{provider:null},{provider:prepared,replace:'yes'},{provider:prepared,limits:{}},{provider:prepared,grants:{stdoutWrite:1}}])assert.throws(()=>nodeApi.nodeCommands(options));const accessor={};Object.defineProperty(accessor,'provider',{get(){invoked++;return prepared;},enumerable:true});assert.throws(()=>nodeApi.nodeCommands(accessor));assert.equal(invoked,0);facts.rejections=6;}
  else if(id==='P06'){let actual;const inert={profile:nodeApi.NODE_PROFILE,identity:'grant-inspection',prepare(request){actual=request.grants;return{async start(){return{kind:'entryReturned',observation:{state:'unknown',fault:false,name:null,message:null,code:null}}},cancel(){},async retire(){return{acquisition:'none',exitCode:null}}}}};const definition=nodeApi.createNodeCommand({provider:inert});const owner=new api.Shell({fs:memory});owners.push(owner);owner.register(definition);await expect(owner,'node -e ""','');assert.deepEqual(Object.keys(actual).sort(),['dataRead','dataWrite','jsonModules','sourceRead','stderrWrite','stdinRead','stdoutWrite'].sort());assert(Object.values(actual).every(value=>value===false));facts.role='trusted-provider-protocol-not-engine';}
  else if(id==='P07'){const owner=new api.Shell({fs:memory});owners.push(owner);let executed=0;const original={name:'node',execute(){executed++;return{exitCode:0}}};owner.register(original);owner.use(nodeApi.nodeCommands({provider:provider()}));const outcome=await capture(owner.exec('node -e ""'));assert.equal(outcome.kind,'throw');assert.equal(outcome.reason.message,'Command already registered: node');assert.equal(owner.commands.get('node'),original);assert.equal(executed,0);facts.setupRejected=true;}
  else if(id==='P08'){const options={provider:provider(),grants:{stdoutWrite:true,stderrWrite:true},replace:true};const plugin=nodeApi.nodeCommands(options);options.replace=false;options.provider=null;options.grants.stdoutWrite=false;const owner=new api.Shell({fs:memory});owners.push(owner);let oldCalls=0;owner.register({name:'node',execute(){oldCalls++;return{exitCode:99}}});owner.use(plugin);await expect(owner,"node -p '8'",'8\n');assert.equal(oldCalls,0);}
  else if(id==='P09'){const owner=shell();await expect(owner,"node -e 'console.log(2);'",'2\n');await expect(owner,"node -p '1+2'",'3\n');assert.equal(events.filter(event=>event.kind==='guestEntry').length,2);}
  else if(id==='P10'){await memory.writeFile('/entry.cjs',bytes('console.log(process.argv[2],process.env.MARK,__dirname);'));await expect(shell({sourceRead:true,stdoutWrite:true,stderrWrite:true}),'node /entry.cjs tail','tail bound /\n');}
  else if(id==='P11'){await expect(shell({sourceRead:true,stdinRead:true,stdoutWrite:true,stderrWrite:true}),'node','stdin-bom\n',0,{stdin:{async *[Symbol.asyncIterator](){yield bytes('\ufeffconsole.log("stdin-bom");')}}});}
  else if(id==='P12'){await memory.writeFile('/data.json',bytes('{"n":1}'));await expect(shell({dataRead:true,dataWrite:true,jsonModules:true,stdoutWrite:true,stderrWrite:true}),`node -e 'const fs=require("fs");fs.writeFileSync("/copy","owned",{encoding:"utf8",flag:"wx"});console.log(require("./data.json").n,fs.readFileSync("/copy","utf8"));'`,'1 owned\n');assert.equal(Buffer.from(await memory.readFile('/copy')).toString(),'owned');}
  else if(id==='P13'){for(const workerId of ['W28','W29']){const result=await runWorkerCase(input,workerId,async row=>{facts[workerId]=row;});assert(result.clean);assert(result.pass);}}
  else if(id==='P14'){const owner=shell();let calls=0;owner.use(async(context,next)=>{if(context.command==='node')calls++;return next();});await expect(owner,"node -p '2+3' | cat",'5\n');assert.equal(calls,1);}
  else if(id==='P15'){await memory.writeFile('/program.sh',bytes("set -u; node -p '6'; printf '%s' \"${missing:-ok}\""));await expect(shell(),'. /program.sh','6\nok');}
  else if(id==='P16'){assert.throws(()=>nodeApi.createNodeWorkerProvider({entry:'https://invalid.example/adapter',identity:'wrong'}));await expect(shell(undefined,{provider:provider('wrong-identity')}),'node -e ""','',2);assert.equal(events.filter(event=>event.kind==='guestEntry').length,0);}
  else if(id==='P17'){let prepared=0,started=0,retired=0;const fixture={profile:nodeApi.NODE_PROFILE,identity:'inert-contract',prepare(){prepared++;assert.equal(started,0);return{async start(){started++;return{kind:'entryReturned',observation:{state:'unknown',fault:false,name:null,message:null,code:null}}},cancel(){},async retire(){retired++;return{acquisition:'none',exitCode:null}}}}};const plugin=nodeApi.nodeCommands({provider:fixture});assert.equal(prepared,0);const owner=new api.Shell({fs:memory});owners.push(owner);owner.use(plugin);assert.equal(prepared,0);await expect(owner,'node -e ""','');assert.deepEqual([prepared,started,retired],[1,1,1]);facts.role='trusted-provider-protocol-not-engine';}
  else if(id==='P18'){const controller=new AbortController();const reason=false;let closed=false;memory.readFile=async(name,options)=>new Promise((resolve,reject)=>{const abort=()=>{closed=true;reject(options.signal.reason)};options.signal.addEventListener('abort',abort,{once:true});controller.abort(reason);if(options.signal.aborted&&!closed)abort();});const outcome=await capture(shell({dataRead:true,stdoutWrite:true,stderrWrite:true}).exec(`node -e 'require("fs").readFileSync("/held","utf8");'`,{signal:controller.signal}));assert.equal(outcome.kind,'throw');assert.equal(outcome.reason,reason);assert(closed);facts.sameReason=true;}
  else if(id==='P19'){await expect(shell(),`node -e 'Promise.race([]);console.log("entry-return");'`,'entry-return\n');assert.equal(events.filter(event=>event.kind==='retired').length,1);}
  else if(id==='P20'){assert.equal(nodeApi.nodeLimits.memoryBytes,16777216);assert.throws(()=>nodeApi.nodeCommands({provider:provider(),limits:{memoryBytes:1}}));let writes=0;const result=await capture(shell().exec("node -p '3'",{limits:{maxOutputBytes:0},stdout:{async write(){writes++;}}}));assert.equal(result.kind,'throw');assert(result.reason instanceof api.ShellLimitError);assert.equal(result.reason.limit,'maxOutputBytes');assert.equal(writes,0);}
  else if(id==='P21'){const owner=shell();for(const program of ['node /unsupported.js','node --input-type=module -e ""','node --require x -e ""']){const result=await owner.exec(program);assert.equal(result.exitCode,2);assert.equal(result.stdout,'');}assert.equal(events.length,0);}
  else if(id==='P22'){await expect(shell(),"node -p '22'",'22\n');facts.packageRoot=input.packageRoot;assert.equal(events.filter(event=>event.kind==='guestEntry').length,1);}
  else if(id==='P23'){assert.throws(()=>nodeApi.nodeCommands({}));const owner=new api.Shell({fs:memory}).use(api.agentCommands());owners.push(owner);await expect(owner,'printf usable','usable');assert(!owner.commands.has('node'));facts.role='configuration-refusal-no-engine-fallback';}
  else if(id==='P24'){const owner=shell();await expect(owner,`node -e 'throw new Error("guest-failure");'`,'',1);await expect(owner,"node -p '24'",'24\n');assert.equal(events.filter(event=>event.kind==='retired').length,2);}
  else throw Error('unknown public identity');
 }catch(reason){failure=reason;facts.error=String(reason?.stack??reason);}
 finally{for(const owner of owners){try{await owner.dispose();}catch(reason){if(id==='P07'&&reason?.message==='Command already registered: node'){facts.repeatedSetupError=true;}else{cleanupError=true;facts.cleanupError=String(reason);}}}await turn();}
 const births=events.filter(event=>event.kind==='workerCreated').length,exits=events.filter(event=>event.kind==='workerExit').length,retired=events.filter(event=>event.kind==='retired').length;
 const clean=!cleanupError&&births===exits&&exits===retired;
 const row={id,role:'public-node-integration',pass:failure===undefined&&clean,clean,workers:births,exits,retired,guestEntries:events.filter(event=>event.kind==='guestEntry').length,events,facts};await publish(row);return row;
}

