import fs from 'node:fs';
import crypto from 'node:crypto';
import path from 'node:path';
import assert from 'node:assert/strict';
import {spawnSync} from 'node:child_process';
import {fileURLToPath} from 'node:url';
const own=fileURLToPath(new URL('.',import.meta.url)),phase=process.argv[2];
const out=fs.openSync(own+phase+'.stdout','wx',384),err=fs.openSync(own+phase+'.stderr','wx',384),log=fs.openSync(own+phase+'.jsonl','wx',384);
const record=value=>fs.writeSync(log,JSON.stringify(value)+'\n');record({phase,pid:process.pid,utc:new Date().toISOString()});
const base=process.cwd()+'/tests/integration/agent-bash-coherent-b2-preflight-20260829/completion-r6/';
const sha=bytes=>crypto.createHash('sha256').update(bytes).digest('hex');
function read(filename,max=2097152){const st=fs.lstatSync(filename);assert(st.isFile()&&st.size<=max);const bytes=fs.readFileSync(filename);return {bytes,sha256:sha(bytes),mode:st.mode&4095};}
function json(filename){return JSON.parse(new TextDecoder('utf8',{fatal:true}).decode(read(filename).bytes));}
function write(name,value){fs.writeFileSync(own+name,JSON.stringify(value,null,2)+'\n',{flag:'wx',mode:384});}
function stream(pin){const st=fs.lstatSync(pin.filename);assert(st.isFile()&&st.size===pin.bytes);const fd=fs.openSync(pin.filename,fs.constants.O_RDONLY|fs.constants.O_NOFOLLOW),hash=crypto.createHash('sha256'),buf=Buffer.alloc(65536);let total=0;try{for(;;){const count=fs.readSync(fd,buf,0,buf.length,null);if(!count)break;total+=count;assert(total<=pin.bytes);hash.update(buf.subarray(0,count));}}finally{fs.closeSync(fd);}assert.equal(total,pin.bytes);assert.equal(hash.digest('hex'),pin.sha256);}
try{
 if(phase==='prepare'){
  const raw=read(own+'inventory.stdout').bytes;assert.equal(raw.at(-1),0);const gitRows=new Map();for(const record of raw.subarray(0,-1).toString().split('\0')){const tab=record.indexOf('\t'),[mode,type,oid]=record.slice(0,tab).split(' '),filename=record.slice(tab+1);assert(tab>0&&type==='blob'&&!gitRows.has(filename));gitRows.set(filename,{mode:parseInt(mode,8)&4095,oid});}
  const bindings=[];function admit(relative){const filename=base+relative,file=read(filename),git=gitRows.get(path.relative(process.cwd(),filename));assert(git);assert.equal(file.mode,git.mode);assert.equal(crypto.createHash('sha1').update(Buffer.from('blob '+file.bytes.length+'\0')).update(file.bytes).digest('hex'),git.oid);bindings.push({path:filename,bytes:file.bytes.length,sha256:file.sha256,mode:file.mode,oid:git.oid});return file;}
  const packetFile=admit('staged/PACKET.json');assert.equal(packetFile.bytes.length,6222);assert.equal(packetFile.sha256,'a2a5a6a23f4c30bd490b3a1db29f0cdc6e4e57a4f179ba0368489af7652fb554');const packet=JSON.parse(packetFile.bytes);assert.equal(packet.files.length,30);const receipt=admit('RECEIPT.json');assert.equal(receipt.sha256,'1d93a608b41334b3f9582512ce08c609f7113bd81194998fc28d41a73550d81d');
  for(const row of packet.files){const file=admit('staged/'+row.path);assert.equal(file.bytes.length,row.bytes);assert.equal(file.sha256,row.sha256);const destination=own+'frozen/'+row.path;fs.mkdirSync(path.dirname(destination),{recursive:true});fs.writeFileSync(destination,file.bytes,{flag:'wx',mode:384});}
  const qualification=JSON.parse(admit('SOURCE-QUALIFICATION.json').bytes);const origins=new Map();for(const fixture of qualification.fixtureOrigins){const row=packet.files.find(row=>row.path===fixture.stagedPath);assert(row);assert.equal(row.sha256,fixture.origin.sha256);assert.equal(row.bytes,fixture.origin.bytes);const original=read(own+'frozen/'+fixture.stagedPath);assert.equal(crypto.createHash('sha1').update(Buffer.from('blob '+original.bytes.length+'\0')).update(original.bytes).digest('hex'),fixture.origin.blob);origins.set(fixture.origin.originalPath,fixture.origin);}
  for(const pin of qualification.consumed)stream(pin);
  const recipe=json(own+'frozen/metadata/RECIPE.json');assert.equal(recipe.roles.length,41);assert.equal(recipe.roles.filter(row=>row.kind==='retained').reduce((sum,row)=>sum+row.ids.length,0),672);assert.equal(recipe.roles.filter(row=>row.kind==='type').length,6);assert.equal(recipe.expectedDiagnostics.length*3,24);assert.equal(recipe.roles.filter(row=>row.kind==='mutant').length,7);assert.equal(recipe.roles.filter(row=>row.kind==='restore').length,7);assert.equal(recipe.roles.filter(row=>row.kind==='binding').length,2);assert.equal(recipe.roles.filter(row=>!['type','install'].includes(row.kind)).length,34);
  const node={filename:'/Users/kjopek/.nvm/versions/node/v22.22.2/bin/node',bytes:112989184,sha256:'5c899797c4eb8f1db5563eea56538342ddb3e9276ee1b04a5a1f0f1023d2b011'};stream(node);
  const work=fs.mkdtempSync('/private/tmp/b2-r6-independent-');fs.mkdirSync(work+'/children');fs.mkdirSync(work+'/fixture');const fixtureSource=read(own+'fixture.mjs').bytes;fs.writeFileSync(work+'/fixture/fixture.mjs',fixtureSource,{flag:'wx',mode:384});for(const name of ['loader.mjs','support.mjs'])fs.writeFileSync(work+'/fixture/'+name,read(own+'frozen/new/'+name).bytes,{flag:'wx',mode:384});
  const locals={};for(const name of ['review.mjs','controls.mjs','fixture.mjs']){const file=read(own+name);locals[name]={bytes:file.bytes.length,sha256:file.sha256};}write('PRESEAL.json',{source:'0d452e85cbbac6358d76d791f035e5d16a9e223a',packetSha256:packetFile.sha256,bindings,locals,node,work,fixtureSourceSha256:sha(fixtureSource),originCount:origins.size,fixtureOrigins:qualification.fixtureOrigins.length,consumedPins:qualification.consumed.length,controls:['N01-diagnostic-code','N02-diagnostic-path-and-exit','N03-mutant-missing-load','N04-mutant-wrong-hash','N05-restore-status','N06-falsy-cleanup-presence','N07-grant-time-and-caps','N08-raw-falsy-publication','N09-partial-open-primary','N10-auth-before-decode'],harmless:['H01-moved-loader-body','H02-missing-binding','H03-changed-binding','H04-type-diagnostic'],pureHelpers:1,harmlessChildren:4,parentTimeoutMs:90000,childSeconds:10,captureBytes:1048576,qualification:'Actual exported loader bodies called directly; no --loader, loader Worker, product module or compiler. Prior snapshots/source origins not a whole HEAD census.'});record({prepared:true,work,bindings:bindings.length,fixtureOrigins:qualification.fixtureOrigins.length,originCount:origins.size});
 }else if(phase==='run'){
  const seal=json(own+'PRESEAL.json');for(const [name,pin]of Object.entries(seal.locals)){const file=read(own+name);assert.equal(file.bytes.length,pin.bytes);assert.equal(file.sha256,pin.sha256);}for(const pin of seal.bindings)assert.equal(read(pin.path).sha256,pin.sha256);
  const child=spawnSync(seal.node.filename,[own+'controls.mjs'],{stdio:['ignore',out,err],timeout:90000,killSignal:'SIGKILL',env:{PATH:'',LANG:'C',LC_ALL:'C',TZ:'UTC'}});record({pid:child.pid,status:child.status,signal:child.signal,error:child.error?.message,returned:true});assert.equal(child.error,undefined);assert.equal(child.signal,null);assert.equal(child.status,0);assert(fs.fstatSync(out).size+fs.fstatSync(err).size<=1048576);
  for(const pin of seal.bindings)assert.equal(read(pin.path).sha256,pin.sha256);const files=[];let total=0;function archive(directory){for(const name of fs.readdirSync(directory)){const filename=path.join(directory,name),st=fs.lstatSync(filename);assert(!st.isSymbolicLink());if(st.isDirectory())archive(filename);else{assert(st.isFile()&&st.size<=1048576);const bytes=fs.readFileSync(filename);total+=bytes.length;assert(total<=8388608);files.push({path:path.relative(seal.work,filename),bytes:bytes.length,sha256:sha(bytes),base64:bytes.toString('base64')});}}}archive(seal.work);write('FIXTURE-ARCHIVE.json',{totalBytes:total,files});fs.rmSync(seal.work,{recursive:true});record({postguards:seal.bindings.length,archiveBytes:total,files:files.length,ownedWorkRemoved:true,stdout:fs.fstatSync(out).size,stderr:fs.fstatSync(err).size});
 }else throw Error('phase');
}catch(reason){record({failed:true,error:String(reason)});fs.writeSync(err,String(reason.stack??reason)+'\n');process.exitCode=1;}
finally{for(const fd of [out,err,log]){fs.fsyncSync(fd);fs.closeSync(fd);}}
