```sh
/bin/zsh /Users/kjopek/Workspace/safe-bash/tests/integration/agent-bash-coherent-b2-preflight-20260829/completion-r7/staged/new/launch.sh /private/tmp/B2-R7-ROOT-GO.json 6519
