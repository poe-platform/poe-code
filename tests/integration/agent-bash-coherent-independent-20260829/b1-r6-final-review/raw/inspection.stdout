  if (auth.action !== 'ROOT_B1_PUBLIC15_ACTUAL' || auth.bindingSha256 !== bindingHash || !auth.authorization || !Number.isSafeInteger(auth.knownStartsBeforePublication) || auth.knownStartsBeforePublication !== auth.ownerAdmission?.knownStartsBeforePublication || auth.knownStartsBeforePublication > 32) throw Error('Fresh root/count authority');
  publisherStart = admitPublisher(auth.ownerAdmission, { parentPid: process.ppid, selfPid: process.pid, startedUTC: new Date().toISOString() });
