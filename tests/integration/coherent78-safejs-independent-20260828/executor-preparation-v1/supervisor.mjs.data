  guard('before-installer-child');
  const installArgs = ['--permission', '--allow-fs-read=' + scratch, ...['consumer', 'cache', 'home', 'tmp', 'logs'].map(name => '--allow-fs-write=' + path.join(scratch, name)), '--import', path.join(scratch, 'tools/loader.mjs'), path.join(scratch, 'tools/npm/bin/npm-cli.js'), 'install', '--offline', '--ignore-scripts', '--no-audit', '--no-fund', '--package-lock=false', '--no-save', '--bin-links=false', '--update-notifier=false', '--prefix=' + consumer, '--userconfig=' + path.join(scratch, 'user.npmrc'), '--globalconfig=' + path.join(scratch, 'global.npmrc'), '--cache=' + path.join(scratch, 'cache'), path.join(scratch, 'package.tgz')];
  const installation = await child(path.join(scratch, 'tools/node'), installArgs, { role: 'installer', label: installLabel, cwd: consumer, timeoutMs: limits.installerTimeoutMs, env: environment(installAdmission, installLabel) });
  guard('after-installer-child'); immutable('after-installer');
  assert.equal(installation.row.status, 0, 'OFFLINE_INSTALL_FAILED_NO_FETCH_OR_RETRY'); evidence.installs++;
  evidence.installerLoads = loadAudit(installLabel, installAdmission, false);
  assert.equal(fs.readFileSync(path.join(consumer, 'package.json'), 'utf8'), control.generated.consumerPackage);
  assert.deepEqual(tree(path.join(consumer, 'node_modules/virtual-bash')).entries, expectedProduct);
  assert.ok(fs.readdirSync(path.join(consumer, 'node_modules')).every(name => ['virtual-bash', '.package-lock.json'].includes(name)), 'UNEXPECTED_INSTALLED_DEPENDENCY');
  guard('before-engine-and-consumer-copy');
  for (const row of engine.files) copy(path.join(engine.root, row.path), 'consumer/node_modules/engine/' + safe(row.path), row);
  evidence.engineCopies = 63; write('consumer/node_modules/engine/package.json', engine.generatedPackage);
  for (const [relative, mode, bytes, sha256] of tools.compiler.files) copy(path.join(tools.compiler.origin, relative), 'consumer/node_modules/typescript/' + safe(relative), { mode, bytes, sha256 });
  for (const name of ['CASES.json', 'RECIPE.json', 'g01.mjs.data', 'g02.mjs.data', 'g03.mjs.data']) copy(path.join(priorRoot, name), 'consumer/harness/' + name, priorManifest.files.find(row => row.path === name));
  const childRow = manifest.files.find(row => row.path === 'child.mjs.data'); copy(path.join(own, childRow.path), 'consumer/harness/child.mjs', childRow);
  expectedConsumer = tree(consumer).entries; guard('after-engine-and-consumer-copy'); immutable('ready');
  for (const layout of ['installed', 'moved']) {
    if (layout === 'moved') {
      guard('before-physical-move'); immutable('before-move');
      const old = consumer; consumer = path.join(scratch, 'physically moved consumer');
      assert.ok(!fs.existsSync(consumer)); fs.renameSync(old, consumer); assert.ok(!fs.existsSync(old));
      evidence.move = { old, current: consumer, oldAbsent: true }; immutable('after-move'); guard('after-physical-move');
    }
    for (const id of ['G01', 'G02', 'G03']) {
      const label = layout + '-' + id; guard('before-child-' + label); immutable('before-child-' + label);
      fs.mkdirSync(path.join(scratch, 'logs', label));
      const admitted = admission('workflow', label);
      const env = { ...environment(admitted, label), C78_CASE: id, C78_LAYOUT: layout, C78_RESULT: path.join(scratch, 'logs', label, 'receipt.json') };
      const args = ['--permission', '--allow-fs-read=' + scratch, '--allow-fs-write=' + path.join(scratch, 'logs', label), '--import', path.join(scratch, 'tools/loader.mjs'), path.join(consumer, 'harness/child.mjs')];
      const result = await child(path.join(scratch, 'tools/node'), args, { role: 'workflow', label, cwd: consumer, timeoutMs: limits.workflowContainmentMs, env });
      guard('after-child-' + label); immutable('after-child-' + label);
      const loadResult = loadAudit(label, admitted, true);
      const receiptBytes = readLimited(env.C78_RESULT, limits.receiptBytesPerChild);
      const receipt = JSON.parse(receiptBytes); const terminal = JSON.parse(result.stdout.toString());
      assert.equal(receipt.case, id); assert.equal(receipt.layout, layout); assert.equal(terminal.classification, receipt.classification);
      assert.equal(receipt.clean, true, 'RESOURCE_LEAK_STOP'); assert.ok(['PASS', 'ASSERTION_FAILURE_CLEAN'].includes(receipt.classification), 'CHILD_SAFETY_STOP');
      assert.equal(result.row.status, receipt.classification === 'PASS' ? 0 : 1, 'CHILD_STATUS_DISAGREEMENT');
      for (const key of ['wrapperEntered', 'wrapperSettled', 'actualRunInvoked', 'actualRunSettled', 'guestEntries', 'bridgeEntered', 'literalInvokes', 'bridgeSettled', 'shellsCreated', 'shellsDisposed', 'publicExecs']) assert.equal(receipt.counters[key], 1, 'ACTUAL_ADMISSION_COUNT:' + key);
      evidence.observations.push({ label, status: result.row.status, receiptSha256: sha(receiptBytes), classification: receipt.classification, counters: receipt.counters, loads: loadResult });
    }
  }
  assert.equal(evidence.observations.length, 6);
  for (const key of ['wrapperEntered', 'wrapperSettled', 'actualRunInvoked', 'actualRunSettled', 'guestEntries', 'bridgeEntered', 'literalInvokes', 'bridgeSettled', 'shellsCreated', 'shellsDisposed', 'publicExecs']) assert.equal(evidence.observations.reduce((sum, row) => sum + row.counters[key], 0), 6, key);
  remaining(); evidence.allPass = evidence.observations.every(row => row.status === 0 && row.classification === 'PASS');
} catch (error) { evidence.safetyStops.push(errorData(error)); evidence.allPass = false; integrity = false; }
finally {
  if (created) {
    try {
      assert.ok(!activeChild, 'ACTIVE_CHILD_RETAIN_SCRATCH'); if (evidence.allPass) remaining();
      guard('before-archive'); if (expectedTools) immutable('before-archive');
      const logs = tree(path.join(scratch, 'logs'), 128, limits.totalEvidenceBytes);
      const payloads = {};
      for (const [relative, row] of Object.entries(logs.entries)) if (row.kind === 'file') payloads[relative] = fs.readFileSync(path.join(scratch, 'logs', relative)).toString('base64');
      evidence.originalBefore = originalBaseline; evidence.originalAfter = lastOriginals;
      evidence.finalScratch = census('final-census'); evidence.integrity = integrity;
      evidence.directChildren = childCount; evidence.gitChildren = gitCount; evidence.totalProcessesIncludingSupervisor = childCount + 1;
      evidence.payloads = payloads; evidence.privateGuardQualification = control.originalGuardScope;
      const bytes = Buffer.from(JSON.stringify(evidence)); assert.ok(bytes.length <= limits.totalEvidenceBytes, 'EVIDENCE_BOUND');
      const compressed = gzipSync(bytes, { level: 9 }); const archive = Buffer.from(compressed.toString('base64') + '\n');
      assert.ok(archive.length <= limits.totalEvidenceBytes);
      const destination = path.join(runRoot, 'RESULT.json.gz.base64'); fs.writeFileSync(destination, archive, { flag: 'wx', mode: 0o600 });
      assert.deepEqual(gunzipSync(Buffer.from(fs.readFileSync(destination, 'utf8').trim(), 'base64'), { maxOutputLength: limits.totalEvidenceBytes }), bytes);
      const closure = { archiveSha256: sha(archive), rawSha256: sha(bytes), allPass: evidence.allPass, removedScratch: false, scope: control.originalGuardScope };
      if (integrity) {
        guard('immediately-before-cleanup'); immutable('immediately-before-cleanup');
        fs.rmSync(scratch, { recursive: true }); assert.ok(!fs.existsSync(scratch)); closure.removedScratch = true;
        guard('after-owned-scratch-cleanup');
      }
      closure.finalOriginalGuardSha256 = sha(JSON.stringify(lastOriginals));
      fs.writeFileSync(path.join(runRoot, 'CLOSURE.json'), JSON.stringify(closure, null, 2) + '\n', { flag: 'wx', mode: 0o600 });
      console.log(JSON.stringify({ allPass: evidence.allPass, archiveSha256: closure.archiveSha256, removedScratch: closure.removedScratch, runRoot, directChildren: childCount, guestEvaluations: evidence.observations.reduce((sum, row) => sum + row.counters.actualRunInvoked, 0) }));
    } catch (error) {
      evidence.allPass = false;
      const failure = { error: errorData(error), safetyStops: evidence.safetyStops, scratchRetained: fs.existsSync(scratch), activeChild: activeChild?.pid, phase: 'ARCHIVE_OR_CLEANUP_STOP' };
      const filename = path.join(runRoot, 'STOP.json'); if (!fs.existsSync(filename)) fs.writeFileSync(filename, JSON.stringify(failure, null, 2) + '\n', { flag: 'wx', mode: 0o600 });
      console.error(JSON.stringify(failure));
    }
  } else console.error(JSON.stringify({ allPass: false, materialized: false, safetyStops: evidence.safetyStops }));
}
process.exitCode = evidence.allPass ? 0 : 1;
