const npm = path.join(tools, 'npm/bin/npm-cli.js');
const environment = { PATH: `${tools}:/usr/bin:/bin`, HOME: path.join(scratch, 'home'), TMPDIR: path.join(scratch, 'tmp'), npm_config_cache: path.join(scratch, 'cache'), npm_config_userconfig: path.join(scratch, 'npmrc'), npm_config_globalconfig: path.join(scratch, 'global-npmrc'), npm_config_offline: 'true', npm_config_audit: 'false', npm_config_fund: 'false', npm_config_update_notifier: 'false', NO_COLOR: '1' };
let childCount = 0;
let protectedRoots = [];
function inventory(root) {
