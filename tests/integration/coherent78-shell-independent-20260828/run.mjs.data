    const name = prefix + entry.name;
    if (overrides.has(name)) return { ...entry, oid: overrides.get(name) };
    if (entry.mode === '40000' && [...overrides.keys()].some(key => key.startsWith(name + '/'))) return { ...entry, oid: overlay(entry.oid, overrides, name + '/') };
