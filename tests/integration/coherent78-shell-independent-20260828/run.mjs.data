  const walk = relative => { for (const name of fs.readdirSync(path.join(root, relative)).sort()) { const key = relative ? `${relative}/${name}` : name, filename = path.join(root, key), stat = fs.lstatSync(filename); if (stat.isDirectory()) walk(key); else if (stat.isSymbolicLink()) rows.push([key, 'SYMLINK', fs.readlinkSync(filename)]); else { assert.ok(stat.isFile()); const bytes = fs.readFileSync(filename); rows.push([key, stat.mode & 511, bytes.length, sha(bytes)]); } } };
