  const movedAdmission = layout('physically-moved', moved, product);
  const runtimeFile = path.join(product, 'dist/shell/runtime.js'), runtimeOriginal = fs.readFileSync(runtimeFile);
  fs.appendFileSync(runtimeFile, '\n');
  try { const control = runtime('K2', moved, product, 'C01', movedAdmission, 'control'); const pass = control.status !== 0 && control.stderr.includes('LOAD_HASH_REFUSED:') && !control.records.some(row => row.id); evidence.controls.push({ id: 'K2', role: 'artifact-tamper refusal', pass, child: control.child }); assert.ok(pass); }
  finally { fs.writeFileSync(runtimeFile, runtimeOriginal); }
  assert.deepEqual(inventory(product), evidence.fullInstalledBefore);
  const fallback = runtime('K3', moved, product, 'C01', movedAdmission, 'control', 'fallback.mjs');
  const fallbackPass = fallback.status !== 0 && /SOURCE_FALLBACK_REFUSED|OUTSIDE_ADMISSION/u.test(fallback.stderr); evidence.controls.push({ id: 'K3', role: 'source-fallback refusal', pass: fallbackPass, child: fallback.child }); assert.ok(fallbackPass);
  const timeoutEntry = path.join(product, 'dist/commands/timeout/index.js'), held = path.join(scratch, 'held-timeout.js'); fs.renameSync(timeoutEntry, held);
  try { const control = runtime('K4', moved, product, 'C01', movedAdmission, 'control'); const pass = control.status !== 0 && control.stderr.includes('ERR_MODULE_NOT_FOUND') && !control.records.some(row => row.id); evidence.controls.push({ id: 'K4', role: 'import refusal', pass, child: control.child }); assert.ok(pass); }
  finally { fs.renameSync(held, timeoutEntry); }
  assert.deepEqual(inventory(product), evidence.fullInstalledBefore);
  const preload = path.join(outside, 'all-pass-exit7.mjs'); fs.writeFileSync(preload, "console.log(JSON.stringify({summary:{pass:29,cases:29,created:1,disposed:1}}));process.exit(7);\n");
  const nonzero = command('K5-preload-admission', ['--import', preload, '--input-type=module', '-e', "throw new Error('must not execute');"]);
  assert.equal(nonzero.status, 7); assert.ok(nonzero.stdout.includes('"pass":29')); assert.throws(() => success(nonzero)); evidence.controls.push({ id: 'K5', role: 'admission only; not mutation', pass: true, child: nonzero.child });
  const mutant = path.join(scratch, 'mutant-source'); fs.mkdirSync(mutant);
  for (const [relative, bytes] of selected) { const target = path.join(mutant, relative); fs.mkdirSync(path.dirname(target), { recursive: true }); fs.writeFileSync(target, bytes); }
  const mutationPath = path.join(mutant, 'src/commands/structured/interpreter.ts');
  const original = fs.readFileSync(mutationPath, 'utf8'); const needle = '        let length = 0;\n        for (const _ of input) length++;\n        yield length;';
  assert.equal(original.split(needle).length, 2, 'MUTANT_SETUP_NEEDLE'); const mutated = original.replace(needle, '        yield input.length;'); fs.writeFileSync(mutationPath, mutated);
  evidence.mutation = { path: 'src/commands/structured/interpreter.ts', before: sha(original), after: sha(mutated), needle, replacement: '        yield input.length;', sourceBase64: Buffer.from(mutated).toString('base64') };
  installTypes(mutant); success(command('M1-valid-mutant-build', [compiler, '-p', path.join(mutant, 'tsconfig.build.json')], mutant));
  harness(mutant); protectedRoots.push(mutant); const mutantAdmission = admission(mutant, mutant, 'mutant');
  const killed = runtime('M1', mutant, mutant, 'H10', mutantAdmission, 'control');
  const mutantObservation = killed.records.find(row => row.id === 'H10'), mutantLoad = killed.loads.find(row => row.relative === 'dist/commands/structured/interpreter.js');
  const semanticPass = killed.status === 1 && mutantObservation?.error?.code === 'ERR_ASSERTION' && mutantObservation?.detail?.result?.stdout === '[2,2,5,1]\n' && mutantObservation?.clean === true && Boolean(mutantLoad) && mutantLoad.sha256 !== evidence.source.emitted['commands/structured/interpreter.js'].sha256;
  evidence.controls.push({ id: 'M1', role: 'valid actual semantic mutant', pass: semanticPass, child: killed.child, loaded: mutantLoad, observed: mutantObservation, admittedMutantHash: sha(JSON.stringify(inventory(mutant))) }); assert.ok(semanticPass, 'MUTANT_NOT_SEMANTICALLY_KILLED');
  assert.deepEqual(inventory(product), evidence.fullInstalledBefore); assert.equal(fs.existsSync(consumer), false);
  for (const [name, bytes] of selected) assert.deepEqual(fs.readFileSync(path.join(source, name)), bytes);
  evidence.finishedAt = new Date().toISOString(); evidence.status = evidence.failures.length ? 'scoped-defects' : 'coherent-scoped-acceptance';
} catch (error) {
  evidence.safetyStops.push({ name: error?.name, code: error?.code, message: error?.message, stack: error?.stack }); evidence.status = 'stopped-safety-or-setup-blocker';
  console.log(JSON.stringify({ ROOT_SAFETY_STOP: evidence.safetyStops.at(-1) }));
} finally {
  evidence.childCount = childCount; evidence.elapsedMs = Date.now() - startedAt;
  evidence.foreignIndexAfter = git('diff', '--cached', '--name-status').toString();
  evidence.foreignIndexUnchanged = evidence.foreignIndexAfter === beforeIndex;
  evidence.cleanup.before = inventory(scratch); evidence.cleanup.bytes = diskUsage(scratch);
  evidence.cleanup.enumeratedRoot = scratch;
  evidence.cleanup.archivePolicy = 'Raw outcomes, selected original inputs, full original npm tarball, mutant source, source/tree/tool/load/declaration receipts archived. Audited regular tool copies are reconstructible from pinned original inventories; no authored original or raw outcome is discarded. No general descendant or opaque-work claim.';
  evidence.cleanup.originals = {};
  for (const [relative, entry] of Object.entries(evidence.cleanup.before)) {
    if (entry.kind !== 'file') continue;
    if (relative.startsWith('receipts/') || relative.startsWith('admissions/') || relative.startsWith('logs/') || relative.endsWith('.mjs') && !relative.includes('/node_modules/') && !relative.startsWith('tools/') && !relative.includes('/dist/')) evidence.cleanup.originals[relative] = fs.readFileSync(path.join(scratch, relative)).toString('base64');
  }
  const archive = path.join(own, 'RAW-v1.json.gz.base64');
  const compressed = gzipSync(Buffer.from(JSON.stringify(evidence)), { level: 9 }); fs.writeFileSync(archive, compressed.toString('base64') + '\n', { flag: 'wx' });
  const verified = Buffer.from(fs.readFileSync(archive, 'utf8').trim(), 'base64'); assert.deepEqual(verified, compressed); assert.deepEqual(JSON.parse(gunzipSync(verified)), JSON.parse(JSON.stringify(evidence)));
  assert.deepEqual(inventory(scratch), evidence.cleanup.before, 'PRE_REMOVAL_APPEND_DETECTING_INTEGRITY');
  const summary = { version: 1, status: evidence.status, candidate: preseal.candidate, presealCommit: executor.presealCommit, executorCommit: git('log', '-1', '--format=%H', '--', 'tests/integration/coherent78-shell-independent-20260828/EXECUTOR.json').toString().trim(), rawArchive: 'RAW-v1.json.gz.base64', archiveSha256: sha(fs.readFileSync(archive)), decodedGzipSha256: sha(compressed), children: childCount, naturallyReaped: evidence.commands.filter(row => row.naturallyReaped).length, layouts: evidence.layouts, typeExecutions: evidence.types.length, typeMatched: evidence.types.filter(row => row.matched).length, controlResults: evidence.controls, failures: evidence.failures, safetyStops: evidence.safetyStops, components: evidence.source.componentTable, package: evidence.pack ? { bytes: packageBytes.length, sha256: sha(packageBytes), files: evidence.pack.files.length, installedManifestSha256: evidence.installedManifestSha256 } : null, elapsedMs: evidence.elapsedMs, foreignIndexUnchanged: evidence.foreignIndexUnchanged, cleanup: { explicitlyEnumeratedRoot: scratch, archivedBeforeRemoval: true, appendDetectingPrecheck: true, bytes: evidence.cleanup.bytes, policy: evidence.cleanup.archivePolicy } };
  fs.rmSync(scratch, { recursive: true }); summary.cleanup.removed = !fs.existsSync(scratch);
  writeJson(path.join(own, 'REVIEW-v1.json'), summary);
  console.log(JSON.stringify({ final: { status: summary.status, children: summary.children, types: summary.typeMatched, failures: summary.failures.length, safetyStops: summary.safetyStops.length, cleanup: summary.cleanup.removed } }));
  if (evidence.safetyStops.length || evidence.failures.length) process.exitCode = 1;
}
