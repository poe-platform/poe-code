{
  "gitLines": [
    "  const blobs = await child('development-blobs', '/usr/bin/git', ['cat-file', '--batch'], repo, { GIT_OPTIONAL_LOCKS: '0', PATH: '/usr/bin' }, manifest.inputs.map(row => row.blob).join('\\n') + '\\n');"
  ]
}
{
  "consumerLines": [
    [
      1,
      "import { Shell, MemoryFileSystem, agentCommands, createAgentCommands, createGitCommand, createGitCommands, gitCommands, type AgentCommandsOptions, type GitCommandsOptions } from \"virtual-bash\";"
    ],
    [
      2,
      "import { createGitCommand as subpath, type GitCommandsOptions as LeafOptions } from \"virtual-bash/commands/git\";"
    ],
    [
      3,
      "const direct: GitCommandsOptions = { replace: true, discoveryBoundary: \"/repo\" };"
    ],
    [
      4,
      "const leaf: LeafOptions = direct;"
    ],
    [
      5,
      "const aggregate: AgentCommandsOptions = { git: { discoveryBoundary: \"/repo\" }, replace: true };"
    ],
    [
      6,
      "new Shell({ fs: new MemoryFileSystem() }).use(agentCommands(aggregate));"
    ],
    [
      7,
      "createAgentCommands(aggregate); createGitCommand(direct); createGitCommands(leaf); gitCommands(direct); subpath(leaf);"
    ],
    [
      8,
      "// @ts-expect-error aggregate replacement belongs to the top-level policy"
    ],
    [
      9,
      "agentCommands({ git: { replace: true } });"
    ],
    [
      10,
      "// @ts-expect-error there are no numeric Git limit overrides"
    ],
    [
      11,
      "gitCommands({ limits: { maxReadBytes: 1 } });"
    ],
    [
      12,
      "// @ts-expect-error discovery is a VFS pathname"
    ],
    [
      13,
      "createGitCommand({ discoveryBoundary: 3 });"
    ],
    [
      14,
      "// @ts-expect-error native process fallback is absent"
    ],
    [
      15,
      "createGitCommands({ spawn: true });"
    ],
    [
      16,
      "// @ts-expect-error aggregate limits cannot be added"
    ],
    [
      17,
      "createAgentCommands({ git: { maxPackBytes: 100 } });"
    ],
    [
      18,
      "// @ts-expect-error full host Git is not an injected command option"
    ],
    [
      19,
      "gitCommands({ executable: \"/usr/bin/git\" });"
    ]
  ]
}
{
  "path": "dist/contracts/command.d.ts",
  "content": "import type { FileSystem } from \"./filesystem.js\";\nimport type { ByteSink, ByteSource } from \"./io.js\";\nexport interface CommandInvokeOptions {\n    readonly signal?: AbortSignal | undefined;\n    readonly stdin?: ByteSource;\n    readonly stdinIsDefault?: boolean;\n    readonly stdout?: ByteSink;\n    readonly stderr?: ByteSink;\n    readonly cwd?: string;\n    readonly env?: Readonly<Record<string, string>>;\n    readonly replaceEnv?: boolean;\n}\nexport type CommandInvoker = (command: string, args: readonly string[], options?: CommandInvokeOptions) => Promise<CommandResult>;\nexport type InvocationCleanup = () => void | Promise<void>;\nexport interface CommandContext {\n    readonly command: string;\n    readonly args: readonly string[];\n    readonly stdin: ByteSource;\n    readonly stdinIsDefault?: boolean;\n    readonly stdout: ByteSink;\n    readonly stderr: ByteSink;\n    cwd: string;\n    env: Record<string, string>;\n    readonly fs: FileSystem;\n    readonly signal: AbortSignal;\n    readonly invoke?: CommandInvoker;\n    readonly registerCleanup?: (cleanup: InvocationCleanup) => void;\n}\nexport interface CommandResult {\n    readonly exitCode: number;\n}\nexport type CommandHandler = (context: CommandContext) => CommandResult | Promise<CommandResult>;\nexport type AsyncCommandHandler = (context: CommandContext) => Promise<CommandResult>;\nexport interface CommandDefinition {\n    readonly name: string;\n    readonly description?: string;\n    readonly execute: CommandHandler;\n}\nexport interface RegisterCommandOptions {\n    readonly replace?: boolean;\n}\nexport declare class CommandRegistry {\n    #private;\n    constructor(commands?: Iterable<CommandDefinition>);\n    register(command: CommandDefinition, options?: RegisterCommandOptions): this;\n    get(name: string): CommandDefinition | undefined;\n    has(name: string): boolean;\n    unregister(name: string): boolean;\n    list(): readonly CommandDefinition[];\n}\nexport declare function validateExitCode(exitCode: number): number;\n//# sourceMappingURL=command.d.ts.map"
}
{
  "path": "dist/contracts/output.d.ts",
  "content": "import type { CommandContext, InvocationCleanup } from \"./command.js\";\nimport { type ByteSink } from \"./io.js\";\nexport interface OutputOperation {\n    readonly signal: AbortSignal;\n    readonly output: ByteSink;\n    child(destination: ByteSink): OutputOperation;\n    registerCleanup(cleanup: InvocationCleanup): void;\n    acquire<Value>(start: (signal: AbortSignal) => Value | Promise<Value>, release: (resource: Value) => void | Promise<void>): Promise<Value>;\n    close(): Promise<void>;\n}\nexport declare function createOutputOperation(context: Pick<CommandContext, \"signal\" | \"registerCleanup\">, destination: ByteSink): OutputOperation;\n//# sourceMappingURL=output.d.ts.map"
}
{
  "path": "dist/contracts/plugin.d.ts",
  "content": "import type { AsyncCommandHandler, CommandContext, CommandHandler, CommandRegistry, CommandResult } from \"./command.js\";\nimport type { FileSystemFactory } from \"./filesystem.js\";\nexport type Next = () => Promise<CommandResult>;\nexport type Middleware = (context: CommandContext, next: Next) => CommandResult | Promise<CommandResult>;\nexport interface PluginHost {\n    readonly commands: CommandRegistry;\n    use(middleware: Middleware): void;\n    registerFileSystem(scheme: string, factory: FileSystemFactory): void;\n}\nexport interface VirtualShellPlugin {\n    readonly name: string;\n    setup(host: PluginHost): void | Promise<void>;\n    dispose?(): void | Promise<void>;\n}\nexport declare function composeMiddleware(middleware: readonly Middleware[], terminal: CommandHandler): AsyncCommandHandler;\n//# sourceMappingURL=plugin.d.ts.map"
}
