import datetime
import hashlib
import io
import json
import os
from pathlib import Path
import re
import shutil
import signal
import stat
import subprocess
import tarfile
import tempfile
import time

REPOSITORY = Path("/Users/kjopek/Workspace/safe-bash")
OWNER = Path("tests/integration/owned-output-production-rebase/author/committed-legacy-followup")
PREVIOUS = "tests/integration/owned-output-production-rebase/author/"
CANDIDATE = "eba049535d154f4e028f57ffd8efd7622b2239ca"
TREE = "62d75ef09e89d4d3b6afc032c518d2846dcd03b7"
EVIDENCE = "f27b7b595c529d26161a21cf86d2a86fc0d2cee3"
BASELINE = "a03b9288a6f4b652387be9fefa8faf17ef58b9e7"
SOURCE_ID = "40914b93fe1a1a82d9abdcdf4f4cc4360ab6e85ab16b5d9f75768e00c73213ec"
PATCH_ID = "83b339002970df881efb56cc50fa0e0e74f1f832edb6c8706287827a3dc5e4ad"
RUNS = [("core", "legacy-core-final-02", 505), ("state", "legacy-state-final", 203),
        ("focused-types", "focused-types-final-02", None), ("source-types", "source-types-final-02", None)]
PACKAGES = ["tsx", "typescript", "@types/node", "esbuild", "@esbuild/darwin-arm64", "undici-types", "fsevents"]


def now():
    return datetime.datetime.now(datetime.timezone.utc).isoformat()


def sha(data):
    return hashlib.sha256(data).hexdigest()


def encoded(value):
    return json.dumps(value, separators=(",", ":"), ensure_ascii=False).encode()


def git(*arguments):
    return subprocess.check_output(["git", *arguments], cwd=REPOSITORY)


def save(name, content):
    target = OWNER / name
    assert not target.exists(), f"Refusing to replace evidence: {target}"
    text = content if isinstance(content, str) else json.dumps(content, indent=2) + "\n"
    subprocess.run(["apply_patch", "*** Begin Patch\n*** Add File: " + str(target) + "\n" +
                    "".join("+" + line + "\n" for line in text.splitlines()) + "*** End Patch\n"],
                   cwd=REPOSITORY, check=True, stdout=subprocess.DEVNULL)


def file_record(path, relative):
    details = path.lstat()
    assert stat.S_ISREG(details.st_mode), f"Expected regular file: {path}"
    return {"path": relative, "kind": "file", "mode": stat.S_IMODE(details.st_mode),
            "bytes": details.st_size, "sha256": sha(path.read_bytes())}


def inventory(root):
    assert root.is_dir() and not root.is_symlink()
    result = []
    for path in sorted(root.rglob("*")):
        details = path.lstat()
        relative = path.relative_to(root).as_posix()
        if stat.S_ISDIR(details.st_mode):
            result.append({"path": relative, "kind": "directory", "mode": stat.S_IMODE(details.st_mode)})
        else:
            result.append(file_record(path, relative))
    return result


def installed_inventory():
    return {package: inventory(REPOSITORY / "node_modules" / package) for package in PACKAGES}


def external_inventory(paths):
    return [file_record(Path(path), path) for path in paths]


def counts(text):
    return {key: int(match[1]) for key in ("tests", "pass", "fail", "cancelled", "skipped", "todo")
            if (match := re.search(r"^# " + key + r" (\d+)$", text, re.MULTILINE))}


assert Path.cwd() == REPOSITORY
assert not (OWNER / "PREFLIGHT.json").exists()
assert git("rev-parse", CANDIDATE + "^{tree}").decode().strip() == TREE
assert git("rev-parse", "--show-toplevel").decode().strip() == str(REPOSITORY)
source_receipt = json.loads(git("show", EVIDENCE + ":" + PREVIOUS + "SOURCE-CANDIDATE.json"))
owned_paths = [row["path"] for row in source_receipt["sourcePaths"]]
assert sha(git("diff", "--binary", BASELINE, CANDIDATE, "--", *owned_paths)) == PATCH_ID
commands = {}
receipts = []
for name, historical, expected_count in RUNS:
    receipt_path = PREVIOUS + "runs/" + historical + "/RUN.json"
    payload = git("show", EVIDENCE + ":" + receipt_path)
    commands[name] = json.loads(payload)["command"]
    receipts.append({"name": name, "path": receipt_path, "commit": EVIDENCE,
                     "sha256": sha(payload), "command": commands[name], "expectedTests": expected_count})
assert len([value for value in commands["core"] if value.endswith(".test.ts")]) == 27
assert len([value for value in commands["state"] if value.endswith(".test.ts")]) == 6
assert "--noEmit" in commands["focused-types"] and "--noEmit" in commands["source-types"]

author_inputs = [value for value in commands["focused-types"] if value.startswith("tests/")]
selection = ["src", "package.json", "package-lock.json", "tsconfig.json", "tsconfig.build.json",
             "tests/contracts", "tests/shell", "tests/commands/network", "tests/commands/network-zero-caps-review",
             "tests/commands/helpers.ts", "tests/commands/streams.test.ts", "tests/commands/pipelines.test.ts", *author_inputs]
archive = git("archive", CANDIDATE, *selection)
expected = {}
source_rows = []
with tarfile.open(fileobj=io.BytesIO(archive)) as bundle:
    for member in bundle.getmembers():
        assert not member.name.startswith("/") and ".." not in member.name.split("/")
        assert member.isdir() or member.isfile(), member.name
        if member.isfile():
            payload = bundle.extractfile(member).read()
            expected[member.name] = {"path": member.name, "bytes": len(payload), "sha256": sha(payload)}
            if member.name.startswith("src/"):
                source_rows.append(expected[member.name])
source_rows.sort(key=lambda row: row["path"])
assert sha(encoded(source_rows)) == SOURCE_ID
for command in commands.values():
    for argument in command:
        if argument.startswith("tests/"):
            assert argument in expected, argument

node = json.loads(subprocess.check_output(["node", "-p", "JSON.stringify({path:process.execPath,version:process.version,platform:process.platform,arch:process.arch})"]))
assert node["platform"] == "darwin" and node["arch"] == "arm64"
external_paths = [str(Path(node["path"]).resolve()), "/bin/bash", "/usr/bin/curl"]
external_before = external_inventory(external_paths)
installed_before = installed_inventory()
lock = json.loads(git("show", CANDIDATE + ":package-lock.json"))
versions = {}
for package in PACKAGES:
    package_data = json.loads((REPOSITORY / "node_modules" / package / "package.json").read_text())
    assert package_data["version"] == lock["packages"]["node_modules/" + package]["version"]
    versions[package] = {"version": package_data["version"], "dependencies": package_data.get("dependencies", {}),
                         "optionalDependencies": package_data.get("optionalDependencies", {})}
versions["node"] = node
versions["bash"] = subprocess.check_output(["/bin/bash", "--version"]).decode()
versions["curl"] = subprocess.check_output(["/usr/bin/curl", "--version"]).decode()

temporary = Path(tempfile.mkdtemp(prefix="safe-bash-owned-output-committed-legacy-", dir="/tmp"))
snapshot = temporary / "candidate"
snapshot.mkdir()
subprocess.run(["tar", "-xf", "-", "-C", str(snapshot)], input=archive, check=True)
original = inventory(snapshot)
actual_files = {row["path"]: {key: row[key] for key in ("path", "bytes", "sha256")}
                for row in original if row["kind"] == "file"}
assert actual_files == expected
for package in PACKAGES:
    target = snapshot / "node_modules" / package
    target.parent.mkdir(parents=True, exist_ok=True)
    shutil.copytree(REPOSITORY / "node_modules" / package, target)
    assert inventory(target) == installed_before[package]
assert installed_inventory() == installed_before
before = inventory(snapshot)
preflight = {"candidate": CANDIDATE, "tree": TREE, "sourceManifestSha256": SOURCE_ID, "sourcePatchSha256": PATCH_ID,
             "started": now(), "liveHeadObservationOnly": git("rev-parse", "HEAD").decode().strip(),
             "foreignStatusObservationOnly": git("status", "--short").decode(), "receipts": receipts,
             "selection": selection, "archiveSha256": sha(archive), "archiveBytes": len(archive),
             "archiveFiles": sorted(expected.values(), key=lambda row: row["path"]),
             "sourceEntries": len(source_rows), "snapshot": str(snapshot), "temporaryRoot": str(temporary),
             "versions": versions, "installedToolRoots": [str(REPOSITORY / "node_modules" / package) for package in PACKAGES],
             "installedToolsBefore": installed_before, "externalToolsBefore": external_before,
             "snapshotBefore": before, "snapshotBeforeSha256": sha(encoded(before)),
             "networkProfile": "Only unchanged test-owned explicit loopback/native-oracle work; no dependency/service network introduced; no syscall firewall claim",
             "noBuildNoPackNoInstallNoPrivate": True,
             "integrityScope": "Recursive regular-file bytes/modes and directory names/modes; added files/directories detected; symlinks/special nodes rejected; no mtime/ctime/atime/xattr or external OS-library closure claim"}
save("PREFLIGHT.json", preflight)
results = []
failed = False
try:
    for name, historical, expected_count in RUNS:
        print("START", name, flush=True)
        scratch = temporary / (name + "-scratch")
        scratch.mkdir()
        home = scratch / "home"
        home.mkdir()
        temp = scratch / "tmp"
        temp.mkdir()
        environment = {"PATH": str(Path(node["path"]).parent) + ":/usr/bin:/bin:/usr/sbin:/sbin",
                       "HOME": str(home), "TMPDIR": str(temp), "TMP": str(temp), "TEMP": str(temp),
                       "LANG": "C", "LC_ALL": "C", "TZ": "UTC", "TSX_DISABLE_CACHE": "1"}
        assert shutil.which("node", path=environment["PATH"]) == node["path"]
        inputs_before = inventory(snapshot)
        tools_before = installed_inventory()
        binaries_before = external_inventory(external_paths)
        assert inputs_before == before and tools_before == installed_before and binaries_before == external_before
        started = now()
        clock = time.monotonic()
        process = subprocess.Popen(commands[name], cwd=snapshot, env=environment,
                                   stdout=subprocess.PIPE, stderr=subprocess.PIPE, start_new_session=True)
        timed_out = False
        killed = False
        try:
            stdout, stderr = process.communicate(timeout=300)
        except subprocess.TimeoutExpired:
            timed_out = True
            os.killpg(process.pid, signal.SIGTERM)
            try:
                stdout, stderr = process.communicate(timeout=5)
            except subprocess.TimeoutExpired:
                killed = True
                os.killpg(process.pid, signal.SIGKILL)
                stdout, stderr = process.communicate()
        elapsed = time.monotonic() - clock
        inputs_after = inventory(snapshot)
        tools_after = installed_inventory()
        binaries_after = external_inventory(external_paths)
        observed_counts = counts(stdout.decode())
        expected_counts = {"tests": expected_count, "pass": expected_count, "fail": 0, "cancelled": 0, "skipped": 0, "todo": 0}
        count_match = expected_count is None or observed_counts == expected_counts
        integrity = inputs_after == before and tools_after == installed_before and binaries_after == external_before
        passed = process.returncode == 0 and not timed_out and count_match and integrity
        report = {"candidate": CANDIDATE, "name": name, "command": commands[name], "cwd": str(snapshot),
                  "environment": environment, "started": started, "finished": now(), "elapsedSeconds": elapsed,
                  "pid": process.pid, "exitCode": process.returncode, "outerTimeout": timed_out, "outerKill": killed,
                  "counts": observed_counts, "expectedTests": expected_count, "countMatch": count_match, "passed": passed,
                  "snapshotBefore": inputs_before, "snapshotAfter": inputs_after,
                  "snapshotBeforeSha256": sha(encoded(inputs_before)), "snapshotAfterSha256": sha(encoded(inputs_after)),
                  "installedToolsBeforeSha256": sha(encoded(tools_before)), "installedToolsAfterSha256": sha(encoded(tools_after)),
                  "externalToolsBefore": binaries_before, "externalToolsAfter": binaries_after,
                  "sourceTestsConfigToolsAndDirectoryEntriesUnchanged": integrity,
                  "scratchAfter": inventory(scratch), "privateQueries": 0}
        save("runs/" + name + "/stdout.txt", stdout.decode())
        save("runs/" + name + "/stderr.txt", stderr.decode())
        save("runs/" + name + "/RUN.json", report)
        results.append({key: report[key] for key in ("name", "exitCode", "elapsedSeconds", "counts", "passed", "sourceTestsConfigToolsAndDirectoryEntriesUnchanged")})
        print("RESULT", json.dumps(results[-1]), flush=True)
        if not passed:
            failed = True
            break
finally:
    closing_inventory = inventory(snapshot)
    closing_tools = installed_inventory()
    closing_binaries = external_inventory(external_paths)
    closure = {"candidate": CANDIDATE, "finished": now(), "results": results,
               "notRun": [name for name, _, _ in RUNS if name not in [result["name"] for result in results]],
               "snapshotFinalSha256": sha(encoded(closing_inventory)), "snapshotUnchangedIncludingEntries": closing_inventory == before,
               "installedToolsAfter": closing_tools, "installedToolsUnchangedIncludingEntries": closing_tools == installed_before,
               "externalToolsAfter": closing_binaries, "externalToolsUnchanged": closing_binaries == external_before,
               "noDistCreated": not (snapshot / "dist").exists(), "privateQueries": 0,
               "snapshotRetention": "Retained only in this author's unique regular TMP; location in PREFLIGHT.json. No other worker inputs accessed.",
               "outerSupervisionLimit": "Own command process group bounded; not a host-wide detached-process or syscall audit."}
    save("CLOSURE.json", closure)
if failed:
    raise SystemExit(1)
