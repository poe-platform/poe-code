+const messages = [];
+let workerError = null;
+worker.on("message", message => { messages.push(message); });
+worker.on("error", error => {
+  workerError = { name: error.name, message: error.message };
+  console.error(error);
 });
+worker.on("exit", workerExitCode => {
+  const readyObserved = messages.length === 2 && messages[0]?.ready === true;
