                else {
                  const magnitude = token.replace(/^[+-]/u, "");
                  if (!/^(?:0[xX][0-9a-fA-F]+|0[0-7]*|[1-9][0-9]*)$/u.test(magnitude)) throw new Error("invalid integer");
