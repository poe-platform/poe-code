};
assert.equal(git('rev-parse', '--show-toplevel').toString().trim(), repository);
for (const [name, digest] of Object.entries(executor.artifacts)) assert.equal(sha(fs.readFileSync(path.join(own, name))), digest, name);
assert.deepEqual(git('show', `${executor.presealCommit}:tests/integration/coherent78-shell-independent-20260828/PRESEAL.json`), fs.readFileSync(path.join(own, 'PRESEAL.json')));
const priorBytes = fs.readFileSync(path.join(own, 'RAW-v1.json.gz.base64'));
assert.equal(sha(priorBytes), executor.previousArchiveSha256);
