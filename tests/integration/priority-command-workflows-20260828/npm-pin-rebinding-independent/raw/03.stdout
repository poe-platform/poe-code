  "date": "2026-08-28",
  "role": "Finite metadata validator contract, not a shell parser, command evaluator, runtime proof or general JSON Schema implementation",
  "files": [
    "READY.md",
    "CASES.json",
    "FIXTURES.json",
    "SCHEMA.json",
    "BINDINGS.json",
    "EXECUTION-RECIPE.md",
    "verify.mjs",
    "MANIFEST.json"
  ],
  "fixedIds": {
    "workflows": [
      "P01",
      "P02",
      "P03",
      "P04",
      "P05",
      "P06",
      "P07",
      "P08",
      "P09",
      "P10",
