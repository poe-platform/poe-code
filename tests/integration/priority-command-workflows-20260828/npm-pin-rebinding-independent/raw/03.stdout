        const record = { method: name, paths: args.filter(argument => typeof argument === 'string'), success: false };
        trace.calls.push(record);
        if (name === 'readStream') {
          const counts = { iterators: 0, next: 0, return: 0, pending: 0 };
          record.stream = counts;
