const beforeIndex = git('diff', '--cached', '--name-status').toString();
evidence.foreignIndexBefore = beforeIndex;
const directories = ['tools', 'source', 'outside', 'home', 'tmp', 'cache', 'receipts', 'admissions', 'logs', 'packs'];
for (const name of directories) fs.mkdirSync(path.join(scratch, name));
for (const name of ['npmrc', 'global-npmrc']) fs.writeFileSync(path.join(scratch, name), '');
const source = path.join(scratch, 'source');
const outside = path.join(scratch, 'outside');
const tools = path.join(scratch, 'tools');
const node = path.join(tools, 'node');
const compiler = path.join(tools, 'typescript/bin/tsc');
const npm = path.join(tools, 'npm/bin/npm-cli.js');
const environment = { PATH: `${tools}:/usr/bin:/bin`, HOME: path.join(scratch, 'home'), TMPDIR: path.join(scratch, 'tmp'), npm_config_cache: path.join(scratch, 'cache'), npm_config_userconfig: path.join(scratch, 'npmrc'), npm_config_globalconfig: path.join(scratch, 'global-npmrc'), npm_config_offline: 'true', npm_config_audit: 'false', npm_config_fund: 'false', npm_config_update_notifier: 'false', NO_COLOR: '1' };
let childCount = prior.childCount;
evidence.priorReview = { archiveSha256: executor.previousArchiveSha256, children: prior.childCount, status: prior.status, elapsedMs: prior.elapsedMs };
let protectedRoots = [];
function inventory(root) {
  const output = {};
  const walk = relative => {
    for (const name of fs.readdirSync(path.join(root, relative)).sort()) {
      const key = relative ? `${relative}/${name}` : name, filename = path.join(root, key), stat = fs.lstatSync(filename);
      assert.ok(!stat.isSymbolicLink(), `SYMLINK:${filename}`);
      if (stat.isDirectory()) { output[key + '/'] = { kind: 'directory', mode: stat.mode & 511 }; walk(key); }
      else { assert.ok(stat.isFile()); const bytes = fs.readFileSync(filename); output[key] = { kind: 'file', bytes: bytes.length, mode: stat.mode & 511, sha256: sha(bytes) }; }
    }
  };
  walk(''); return output;
}
function diskUsage(root) {
