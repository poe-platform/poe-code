}

export function makeSafeJsFsModule<Module>(
  makeFsModule: (options: { fs: SafeJsFsImplementation }) => Module,
  fs: FileSystem,
  options: NodeFsBridgeOptions = {},
): Module {
  return makeFsModule({ fs: createNodeFsBridge(fs, options) });
}

