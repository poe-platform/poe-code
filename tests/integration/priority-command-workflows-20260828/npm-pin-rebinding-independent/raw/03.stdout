        } catch (error) {
          context.signal.throwIfAborted();
          if (error instanceof OutputClosed) return { exitCode: 0 };
          if (args?.messages !== false) await diagnostic(context, error);
          return { exitCode: 2 };
        }
      });
    },
  };
}

