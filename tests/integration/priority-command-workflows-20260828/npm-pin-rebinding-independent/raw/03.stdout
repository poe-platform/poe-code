assert.ok(prior.commands.every(row => row.naturallyReaped));
const scratch = path.join(own, '.scratch-review-v2');
assert.equal(fs.existsSync(scratch), false, 'Existing owned execution must not be duplicated');
assert.equal(fs.existsSync(path.join(own, 'REVIEW-v2.json')), false, 'Completed review must not be repeated');
