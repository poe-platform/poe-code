  walk(root); return total;
}
function command(label, args, cwd = outside, extraEnv = {}, mutates = []) {
  assert.ok(++childCount <= preseal.execution.bounds.maxChildren, 'CHILD_BOUND');
  assert.ok(Date.now() - startedAt + prior.elapsedMs < preseal.execution.bounds.maxWholeReviewMs, 'WHOLE_TIME_BOUND');
  assert.ok(diskUsage(scratch) < preseal.execution.bounds.maxOwnedScratchBytes, 'SCRATCH_BOUND');
