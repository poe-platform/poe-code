  if (iso) {
    const fields: CalendarFields = { year: Number(iso[1]), month: Number(iso[2]), day: Number(iso[3]), hour: Number(iso[4] ?? 0),
      minute: Number(iso[5] ?? 0), second: Number(iso[6] ?? 0) };
