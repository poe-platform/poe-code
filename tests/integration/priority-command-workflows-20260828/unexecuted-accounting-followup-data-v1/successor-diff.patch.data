 export function reserveWorkerStarts(remaining, tag) {
   assert.ok(remaining.workerStarts >= bounds.workerStartsPerChild, 'WORKER_RESERVATION_EXHAUSTED');
   remaining.workerStarts -= bounds.workerStartsPerChild;
-  return { tag, reserved: bounds.workerStartsPerChild, charged: bounds.workerStartsPerChild, accounting: 'unknown', attempts: null, starts: null };
+  return { tag, reserved: bounds.workerStartsPerChild, charged: bounds.workerStartsPerChild, accounting: 'unknown', attempts: null, starts: null, observedAttempts: null, observedStarts: null };
+}
+
+export function observeWorkerStarts(reservation, events, pid) {
+  if (events === null) return;
+  for (const row of events) { assert.equal(row.event, 'worker-parent'); assert.equal(row.pid, pid, 'WORKER_OBSERVATION_PID_DRIFT'); }
+  const starts = events.filter(row => row.action === 'start');
+  const attempts = events.filter(row => row.action === 'constructor-attempt');
+  for (const start of starts) { assert.equal(typeof start.token, 'string'); assert.ok(Number.isInteger(start.threadId) && start.threadId > 0); }
+  assert.equal(new Set(starts.map(row => row.token)).size, starts.length, 'DUPLICATE_OBSERVED_WORKER_START');
+  assert.ok(starts.length <= reservation.reserved && attempts.length <= reservation.reserved, 'WORKER_OBSERVATION_BOUND');
+  reservation.observedStarts = starts.length; reservation.observedAttempts = attempts.length;
+}
+
+export function workerStartSummary(reservations) {
+  return {
+    productWorkerStartsKnown: reservations.reduce((sum, row) => sum + (row.observedStarts ?? row.starts ?? 0), 0),
+    productWorkerStarts: reservations.some(row => row.accounting === 'unknown') ? null : reservations.reduce((sum, row) => sum + row.starts, 0),
+    workerStartsWithheld: reservations.filter(row => row.accounting === 'unknown').reduce((sum, row) => sum + row.charged, 0),
+    workerStartObservationsUnavailable: reservations.filter(row => row.observedStarts === null && row.starts === null).length,
+  };
 }
 
 export function settleWorkerStarts(remaining, reservation, events, rows) {
