import assert from "node:assert/strict";
import test from "node:test";
import {
  Shell, agentCommands, createAgentCommands, createMemoryFileSystem, networkCommands,
  type HttpResponse, type HttpTransport,
} from "virtual-bash";
import { networkCommands as subpathNetworkCommands } from "virtual-bash/commands/network";

const encode = (text: string) => new TextEncoder().encode(text);
const response = (bytes: Uint8Array, status = 200, headers: HttpResponse["headers"] = []): HttpResponse => ({
  status, statusText: status === 200 ? "OK" : "Found", headers,
  body: (async function* () { yield bytes; })(),
  async dispose() {},
});

await test("network stays opt-in; root and explicit subpath agree", async () => {
  assert.equal(networkCommands, subpathNetworkCommands);
  const names = createAgentCommands().map(command => command.name);
  assert.equal(names.length, 77);
  assert.equal(new Set(names).size, 77);
  for (const name of ["curl", "safejs", "getopts"]) assert.equal(names.includes(name), false);
  assert.equal(names.includes("which"), true);
  const shell = new Shell({ fs: createMemoryFileSystem() }).use(agentCommands());
  try {
    const result = await shell.exec("curl https://docs.example.test/");
    assert.equal(result.exitCode, 127);
    assert.match(result.stderr, /curl.*command not found/);
    assert.equal(result.stdout, "");
  } finally { await shell.dispose(); }
});

await test("authorized mock redirects, VFS output and stdin upload preserve bytes", async () => {
  const fs = createMemoryFileSystem();
  const bytes = Uint8Array.of(0, 255, 13, 10, 195, 169);
  const authorization: string[] = [];
  const requests: string[] = [];
  let disposals = 0;
  const transport: HttpTransport = async request => {
    requests.push(request.url);
    const reply = request.url.endsWith("/start")
      ? response(new Uint8Array(), 302, [["location", "/bytes"]])
      : response(bytes);
    if (request.method === "POST") {
      const chunks: number[] = [];
      assert.ok(request.body);
      for await (const chunk of request.body) chunks.push(...chunk);
      assert.deepEqual(Uint8Array.from(chunks), bytes);
    }
    return { ...reply, async dispose() { disposals++; } };
  };
  const shell = new Shell({ fs }).use(agentCommands()).use(networkCommands({
    transport,
    authorize(request) {
      authorization.push(request.url);
      return new URL(request.url).origin === "https://docs.example.test";
    },
  }));
  try {
    const download = await shell.exec("curl -fSL https://docs.example.test/start -o /bytes");
    assert.equal(download.exitCode, 0);
    assert.equal(download.stdout, "");
    assert.equal(download.stderr, "");
    assert.deepEqual(await fs.readFile("/bytes"), bytes);
    for (const [data, stdin] of [["@-", bytes], ["@/bytes", undefined]] as const) {
      const upload = await shell.exec(`curl --data-binary ${data} https://docs.example.test/echo`,
        stdin === undefined ? {} : { stdin });
      assert.equal(upload.exitCode, 0);
      assert.equal(upload.stderr, "");
      assert.deepEqual(upload.stdoutBytes, bytes);
    }
    assert.deepEqual(requests, authorization);
    assert.equal(requests.length, 4);
    assert.equal(disposals, 4);
  } finally { await shell.dispose(); }
});

await test("redirect authorization denies before the second transport call", async () => {
  const urls: string[] = [];
  let calls = 0;
  let disposals = 0;
  const shell = new Shell({ fs: createMemoryFileSystem() }).use(networkCommands({
    authorize(request) { urls.push(request.url); return new URL(request.url).origin === "https://docs.example.test"; },
    transport: async () => {
      calls++;
      return { ...response(new Uint8Array(), 302, [["location", "https://denied.example.test/"]]), async dispose() { disposals++; } };
    },
  }));
  try {
    const result = await shell.exec("curl -L https://docs.example.test/");
    assert.equal(result.exitCode, 7);
    assert.equal(result.stdout, "");
    assert.match(result.stderr, /Network access denied by host policy/);
    assert.deepEqual(urls, ["https://docs.example.test/", "https://denied.example.test/"]);
    assert.equal(calls, 1);
    assert.equal(disposals, 1);
  } finally { await shell.dispose(); }
});

await test("HTML README pipeline uses an explicitly injected mock, not external HTTP", async () => {
  const fs = createMemoryFileSystem();
  let disposed = false;
  const shell = new Shell({ fs })
    .use(agentCommands({ htmlToMarkdown: { limits: { maxInputBytes: 1024 * 1024 } } }))
    .use(networkCommands({
      authorize: request => new URL(request.url).origin === "https://docs.example.com",
      transport: async () => ({ ...response(encode("<h1>Guide</h1><p>Read <strong>this</strong>.</p>")), async dispose() { disposed = true; } }),
    }));
  try {
    const result = await shell.exec("curl https://docs.example.com/page | html-to-markdown > /page.md");
    assert.equal(result.exitCode, 0);
    assert.equal(result.stderr, "");
    assert.equal(result.stdout, "");
    assert.equal(new TextDecoder().decode(await fs.readFile("/page.md")), "# Guide\n\nRead **this**.\n");
    assert.equal(disposed, true);
  } finally { await shell.dispose(); }
});

await test("README table-text fragment with declared VFS input files", async () => {
  const fs = createMemoryFileSystem();
  await fs.writeFile("/names", encode("1 Ada\n2 Lin\n"));
  await fs.writeFile("/colors", encode("1 blue\n2 green\n"));
  const shell = new Shell({ fs, env: { LC_ALL: "C" } }).use(agentCommands());
  try {
    const result = await shell.exec("join names colors | cut -d ' ' -f2,3 | paste -sd, -");
    assert.equal(result.exitCode, 0);
    assert.equal(result.stderr, "");
    assert.equal(result.stdout, "Ada blue,Lin green\n");
  } finally { await shell.dispose(); }
});

await test("README tar fragment preserves explicit VFS bytes through a pipe", async () => {
  const fs = createMemoryFileSystem();
  await fs.mkdir("/input");
  await fs.mkdir("/output");
  const bytes = Uint8Array.of(0, 255, 13, 10, 195, 169);
  await fs.writeFile("/input/data", bytes);
  const shell = new Shell({ fs }).use(agentCommands());
  try {
    const result = await shell.exec("tar -cf - -C /input . | tar -xf - -C /output");
    assert.equal(result.exitCode, 0);
    assert.equal(result.stderr, "");
    assert.equal(result.stdout, "");
    assert.deepEqual(await fs.readFile("/output/data"), bytes);
  } finally { await shell.dispose(); }
});
