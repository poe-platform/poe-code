+      } catch (reason) {
+        record.engineOutcome = {
+          kind: callReturned ? "await-rejected" : "call-threw",
+          reasonType: typeof reason,
+          reasonIsNull: reason === null,
+        };
+        record.events.push(callReturned ? "actual-engine-run-rejected" : "actual-engine-run-threw");
+        throw reason;
+      }
