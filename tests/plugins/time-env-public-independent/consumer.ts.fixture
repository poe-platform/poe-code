import assert from 'node:assert/strict';
import test from 'node:test';
import { Shell, MemoryFileSystem, CommandRegistry, agentCommands, createAgentCommands,
  createTimeEnvCommands, timeEnvCommands, type AgentCommandsOptions,
  type TimeEnvCommandsOptions, type TimeEnvLimits, type SleepScheduler } from 'virtual-bash';
import { createTimeEnvCommands as leaf, timeEnvCommands as plugin,
  type TimeEnvCommandsOptions as LeafOptions, type TimeEnvLimits as LeafLimits,
  type SleepScheduler as LeafScheduler } from 'virtual-bash/commands/time-env';

const names = '[ awk base32 base64 basename cat chmod cksum comm cp cut date diff dirname echo env expand false find fold grep gunzip gzip head join jq ln ls md5sum mkdir mktemp mv nl od paste patch printenv printf pwd readlink realpath rev rg rm rmdir sed seq sha1sum sha256sum sleep sort split stat strings tac tail tar tee test touch tr true unexpand uniq wc xargs xxd zcat'.split(' ');
const clock = () => 42000;
const options: LeafOptions = { clock } satisfies TimeEnvCommandsOptions;
const limits: LeafLimits = {} as TimeEnvLimits;
const schedulerType: LeafScheduler | undefined = undefined as SleepScheduler | undefined;
const excluded: 'replace' extends keyof NonNullable<AgentCommandsOptions['timeEnv']> ? false : true = true;
void limits; void schedulerType;
async function using(settings: AgentCommandsOptions, action: (shell: Shell) => Promise<void>) {
  const shell = new Shell({ fs: new MemoryFileSystem() }).use(agentCommands(settings));
  try { await action(shell); } finally { await shell.dispose(); }
}

test('same exported factories; three leaf definitions versus exact68 aggregate', () => {
  assert.equal(leaf, createTimeEnvCommands); assert.equal(plugin, timeEnvCommands); assert.equal(excluded, true);
  assert.deepEqual(leaf(options).map(entry => entry.name), ['date', 'sleep', 'printenv']);
  assert.equal(names.length, 68); assert.equal(new Set(names).size, 68);
  assert.deepEqual(createAgentCommands().map(entry => entry.name).sort(), names);
});
test('aggregate defaults dispatch three additions, not optional capabilities', async () => {
  await using({ timeEnv: options }, async shell => {
    const result = await shell.exec('sleep 0; date +%s; printenv INTEGRATION', { env: { INTEGRATION: 'wired' } });
    assert.equal(result.exitCode, 0, result.stderr); assert.equal(result.stdout, '42\nwired\n');
    assert.deepEqual(shell.commands.list().map(entry => entry.name).sort(), names);
    assert.equal(shell.commands.has('curl'), false); assert.equal(shell.commands.has('safejs'), false);
  });
});
test('factory forwards clock/timezone without sharing settings across instances', async () => {
  await using({ timeEnv: { clock: () => 0, defaultTimeZone: 'UTC-03' } }, async first => {
    await using({ timeEnv: options }, async second => {
      assert.equal((await first.exec('date +%H:%M')).stdout, '03:00\n');
      assert.equal((await second.exec('date +%s')).stdout, '42\n');
      assert.equal((await first.exec('date +%H:%M', { env: { TZ: 'UTC' } })).stdout, '00:00\n');
    });
  });
});
for (const name of ['date', 'sleep', 'printenv']) test(`nested replace cannot bypass atomic aggregate collision: ${name}`, async () => {
  const registry = new CommandRegistry([{ name, execute: () => ({ exitCode: 29 }) }]);
  const before = registry.get(name);
  const shell = new Shell({ fs: new MemoryFileSystem(), commands: registry })
    .use(agentCommands({ timeEnv: { replace: true } } as unknown as AgentCommandsOptions));
  try { await assert.rejects(shell.exec(':'), /already registered/); assert.equal(registry.get(name), before); assert.equal(registry.list().length, 1); }
  finally { await shell.dispose(); }
});
test('aggregate replacement overrides nested false, preserves unrelated definition', async () => {
  const registry = new CommandRegistry([{ name: 'date', execute: () => ({ exitCode: 29 }) }, { name: 'keeper', execute: () => ({ exitCode: 31 }) }]);
  const keeper = registry.get('keeper');
  const shell = new Shell({ fs: new MemoryFileSystem(), commands: registry }).use(agentCommands({ replace: true, timeEnv: { ...options, replace: false } } as AgentCommandsOptions));
  try { assert.equal((await shell.exec('date +%s')).stdout, '42\n'); assert.equal(registry.list().length, 69); assert.equal(registry.get('keeper'), keeper); }
  finally { await shell.dispose(); }
});
test('aggregate forwards family limits before stdout publication', async () => {
  await using({ timeEnv: { clock, limits: { maxOutputBytes: 2 } } }, async shell => {
    const result = await shell.exec('date +%s');
    assert.equal(result.exitCode, 1); assert.equal(result.stdout, ''); assert.match(result.stderr, /output limit/);
  });
  assert.throws(() => createAgentCommands({ timeEnv: { limits: { maxFormatWidth: 0 } } }), RangeError);
});
test('aggregate forwards scheduler and timer chunk bound', async () => {
  let now = 0; const delays: number[] = []; const pending = new Set<object>();
  const scheduler: SleepScheduler = { now: () => now, setTimeout(callback, delay) {
    const handle = {}; pending.add(handle); delays.push(delay);
    queueMicrotask(() => { if (pending.delete(handle)) { now += delay; callback(); } }); return handle;
  }, clearTimeout(handle) { pending.delete(handle as object); } };
  await using({ timeEnv: { scheduler, maxTimerMilliseconds: 3 } }, async shell => {
    assert.equal((await shell.exec('sleep .008')).exitCode, 0);
    assert.deepEqual(delays, [3, 3, 2]); assert.equal(pending.size, 0);
  });
});
test('abort reaches forwarded scheduler and preserves reason', async () => {
  let entered!: () => void; const admission = new Promise<void>(resolve => { entered = resolve; });
  const handles = new Set<object>();
  const scheduler: SleepScheduler = { now: () => 0, setTimeout() { const handle = {}; handles.add(handle); entered(); return handle; }, clearTimeout(handle) { assert.ok(handles.delete(handle as object)); } };
  await using({ timeEnv: { scheduler } }, async shell => {
    const controller = new AbortController(); const reason = Object.freeze({ integration: true });
    const rejected = assert.rejects(shell.exec('sleep 100', { signal: controller.signal }), error => error === reason);
    await admission; controller.abort(reason); await rejected; assert.equal(handles.size, 0);
  });
});
