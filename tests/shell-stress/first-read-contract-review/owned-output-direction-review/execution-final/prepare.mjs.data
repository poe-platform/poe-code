import assert from 'node:assert/strict';
import {readFileSync, readdirSync, symlinkSync, existsSync} from 'node:fs';
import {createHash} from 'node:crypto';
import {execFileSync, spawnSync} from 'node:child_process';
import {resolve, relative} from 'node:path';
const root = process.cwd(), temp = process.argv[2];
assert.equal(root, '/Users/kjopek/Workspace/safe-bash'); assert.ok(temp.startsWith('/tmp/safe-bash-owned-output-direction-review-final-'));
const base = 'tests/shell-stress/first-read-contract-review';
const own = `${base}/owned-output-direction-review/execution-final`, parent = `${base}/owned-output-direction-review`, author = `${base}/owned-output-direction-prototype`, old = `${base}/owned-output-prototype-review/execution-r1`;
const hash = value => createHash('sha256').update(value).digest('hex');
const put = (path, value) => execFileSync('apply_patch', [], {input: `*** Begin Patch\n*** Add File: ${path}\n${value.replace(/\n$/, '').split('\n').map(line => '+' + line).join('\n')}\n*** End Patch\n`, encoding: 'utf8'});
const read = path => readFileSync(path, 'utf8');
const checks = [];
const verify = (path, sha) => {assert.equal(hash(readFileSync(path)), sha, path); checks.push({path, sha256: sha});};
verify(`${author}/handoff.json`, 'fb04617552411603080dc4ab0bd34388576b8a1e523c31d0b410f11f7f3c1299');
verify(`${author}/source-v1-to-v2-r1.patch-data`, 'c38b2327df4baea4df3ff8ec7186e797ce79d9f6da18a32da402cd967dd00b2c');
verify(`${parent}/freeze.json`, 'eb2fde0beb13aeb738019309c6db9ec8aa4ab9694a82d3f35efc1cbfae0527ae');
verify(`${parent}/execution-v2/binding-seal.json`, '0f3c413909419b2aa9aa2af85f896ca7d6ce8a4b023f48c5b01f786669b394aa');
for (const entry of JSON.parse(read(`${parent}/freeze.json`)).files) verify(entry.path, entry.sha256);
const handoff = JSON.parse(read(`${author}/handoff.json`));
const walk = path => readdirSync(path, {withFileTypes: true}).flatMap(entry => entry.isDirectory() ? walk(`${path}/${entry.name}`) : entry.isFile() ? [`${path}/${entry.name}`] : []).sort();
const inventory = path => walk(`${temp}/candidate/${path}`).map(file => ({path: relative(`${temp}/candidate`, file), bytes: readFileSync(file).length, sha256: hash(readFileSync(file))}));
for (const [path, expected] of [['src', handoff.sourceManifestSha256], ['tests', handoff.testManifestSha256], ['dist', handoff.compiledManifestSha256]]) assert.equal(hash(JSON.stringify(inventory(path))), expected);
const patchAtFreeze = execFileSync('git', ['show', `630bf76f:${author}/source-v1-to-v2-r1.patch-data`]); assert.equal(hash(patchAtFreeze), handoff.sourcePatchSha256);
const originalCase = execFileSync('git', ['show', `eb78897:${parent}/cases.json`]); assert.equal(hash(originalCase), hash(readFileSync(`${parent}/cases.json`)));
const authorCaseAtFreeze = execFileSync('git', ['show', `630bf76f:${author}/${handoff.authorFixture}`]); assert.equal(hash(authorCaseAtFreeze), handoff.authorFixtureSha256);
const chronology = execFileSync('git', ['show', '-s', '--format=%H %cI %s', '630bf76f'], {encoding: 'utf8'}).trim();
const oldManifest = JSON.parse(read(`${old}/artifacts.json`));
for (const entry of oldManifest.files) verify(`${old}/${entry.path}`, entry.sha256);
verify(`${old}/holdouts.mjs.data`, '89e7126e946dd8eee07e547891bd83ba5db15a28f22890bbce6fa31e99a1fd98');
verify(`${old}/bound/holdouts-r1.mjs.data`, 'c8a139b02533c8c964fef8eea829532a528fe85cbfa7d660bc8109e0c17ddd09');
const oldSeal = JSON.parse(read(`${old}/binding-seal.json`));
for (const entry of oldSeal.files.filter(entry => ['support.mjs', 'binding.mjs'].includes(entry.path))) verify(`${base}/owned-output-prototype-review/${entry.path}`, entry.sha256);
const copies = [];
const copy = (source, target, transform = value => value) => {const original = read(source), content = transform(original); put(`${temp}/${target}`, content); copies.push({source, target, sourceSha256: hash(original), boundSha256: hash(content), identical: original === content});};
for (const name of ['driver.mjs', 'supervisor.mjs', 'api-binding.ts']) copy(`${own}/${name}.data`, name);
for (const name of ['inputs.json', 'cases.json']) copy(`${parent}/${name}`, name);
for (const name of ['support.mjs', 'binding.mjs']) copy(`${base}/owned-output-prototype-review/${name}`, name);
copy(`${old}/holdouts.mjs.data`, 'holdouts.mjs');
copy(`${old}/bound/holdouts-r1.mjs.data`, 'holdouts-r1.mjs');
for (const path of walk(`${old}/bound`)) {
  const name = relative(`${old}/bound`, path).replace(/\.data$/, '');
  if (['supervisor.mjs', 'holdouts-r1.mjs', 'run-existing.mjs', 'run-controls.mjs', 'native.mjs'].includes(name)) continue;
  copy(path, name.startsWith('tests/') || ['package.json', 'tsconfig.json'].includes(name) ? `bound/${name}` : name);
}
const declarationFiles = walk(`${temp}/candidate/dist`).filter(path => path.endsWith('.d.ts'));
const declarations = declarationFiles.map(path => ({path: relative(`${temp}/candidate`, path), sha256: hash(readFileSync(path))}));
put(`${temp}/package.json`, '{"type":"module"}\n');
if (!existsSync(`${temp}/node_modules`)) symlinkSync(`${root}/node_modules`, `${temp}/node_modules`, 'dir');
put(`${temp}/api-tsconfig.json`, JSON.stringify({compilerOptions: {target: 'ES2022', module: 'NodeNext', moduleResolution: 'NodeNext', strict: true, noEmit: true, skipLibCheck: false, types: ['node']}, files: ['api-binding.ts']}, null, 2) + '\n');
const auth = {authenticatedAt: new Date().toISOString(), temp, checks, source: inventory('src'), tests: inventory('tests'), compiled: inventory('dist'), declarations, chronology, exposureQualification: 'Root reports private relocation 2026-08-27 05:16:22 America/Chicago. Final patch was committed at 05:13:42-05:00 and exact author fixture/source hashes match. Author says no independent-body reads; no guaranteed blindness or root proof of unobserved activity.', copies, reconstruction: JSON.parse(read(`${temp}/reconstruction-proof.json`))};
put(`${temp}/authentication.json`, JSON.stringify(auth, null, 2) + '\n');
const freeze = {sealedAt: new Date().toISOString(), beforeFirstProductExecution: true, cases: 7, d07Subruns: 4, noExpectationChanges: true, branch: 'opaque-no-lease-no-handback', sourceManifestSha256: handoff.sourceManifestSha256, testManifestSha256: handoff.testManifestSha256, compiledManifestSha256: handoff.compiledManifestSha256, files: [...copies.map(entry => ({path: entry.target, sha256: entry.boundSha256})), ...['api-tsconfig.json', 'package.json'].map(path => ({path, sha256: hash(readFileSync(`${temp}/${path}`))})), {path: 'BINDING.md', sha256: hash(readFileSync(`${own}/BINDING.md`))}]};
put(`${temp}/execution-seal.json`, JSON.stringify(freeze, null, 2) + '\n');
put(`${own}/authentication.json`, JSON.stringify(auth, null, 2) + '\n'); put(`${own}/execution-seal.json`, JSON.stringify(freeze, null, 2) + '\n');
put(`${own}/reconstruction-proof.json`, read(`${temp}/reconstruction-proof.json`));
for (const name of ['prototype', 'old16-execution']) {const path = name === 'prototype' ? '/tmp/safe-bash-owned-output-direction-prototype.ready' : '/tmp/safe-bash-owned-output-old16-execution.ready'; put(`${own}/${name}.ready.data`, read(path));}
console.log(JSON.stringify({temp, sealedAt: freeze.sealedAt, executionSealSha256: hash(JSON.stringify(freeze, null, 2) + '\n'), authenticated: checks.length, executableCopies: copies.length}));
