import assert from 'node:assert/strict';
import {readFileSync, readdirSync} from 'node:fs';
import {createHash} from 'node:crypto';
import {execFileSync, spawnSync} from 'node:child_process';
const scope = 'tests/shell-stress/first-read-contract-review/owned-output-direction-review/execution-final';
const sha = value => createHash('sha256').update(value).digest('hex');
const walk = path => readdirSync(path, {withFileTypes: true}).flatMap(entry => entry.isDirectory() ? walk(`${path}/${entry.name}`) : entry.isFile() ? [`${path}/${entry.name}`] : []).sort();
const put = (path, value) => execFileSync('apply_patch', [], {input: `*** Begin Patch\n*** Add File: ${path}\n${value.replace(/\n$/, '').split('\n').map(line => '+' + line).join('\n')}\n*** End Patch\n`, encoding: 'utf8'});
const json = path => JSON.parse(readFileSync(path, 'utf8'));
const beforeIndex = execFileSync('git', ['diff', '--cached', '--name-only'], {encoding: 'utf8'}).trim().split('\n').filter(Boolean);
for (const path of walk(scope)) assert.ok(/\.(json|md|data|patch-data)$/.test(path), `Unexpected executable discovery path: ${path}`);
let jsonFiles = 0;
for (const path of walk(scope).filter(path => path.endsWith('.json'))) {json(path); jsonFiles++;}
const results = json(`${scope}/results.json`);
assert.equal(results.new7.executed, 7); assert.equal(results.new7.pass, 3); assert.equal(results.new7.fail, 4);
assert.deepEqual(results.old16.map(profile => profile.pass), [15, 16]); assert.equal(results.original5.pass, 1); assert.equal(results.adapted5.pass, 5); assert.equal(results.legacy57.pass, 57); assert.equal(results.controls9.pass, 9);
assert.equal(results.d07Subruns.length, 4); assert.ok(results.d07Subruns.every(subrun => subrun.pass === false));
for (const file of walk(`${scope}/raw`)) {const raw = json(file); const run = json(`${scope}/runs/${raw.label}.json`); for (const stream of ['stdout', 'stderr']) {const bytes = Buffer.from(raw[stream].base64, 'base64'); assert.equal(sha(bytes), raw[stream].sha256); assert.equal(bytes.length, raw[stream].bytes); assert.equal(bytes.toString(), run[stream]);} assert.equal(run.status, raw.status);}
for (const entry of json(`${scope}/authentication.json`).copies) assert.equal(sha(readFileSync(`${scope}/bound/${entry.target}.data`)), entry.boundSha256);
const restorationDiff = spawnSync('git', ['diff', '--no-index', '--', 'tests/shell-stress/first-read-contract-review/owned-output-direction-prototype/restore-v2.mjs.data', `${scope}/restore.mjs.data`], {encoding: 'utf8'});
assert.equal(restorationDiff.status, 1); put(`${scope}/restoration-delta.patch-data`, restorationDiff.stdout);
let paths = walk(scope);
execFileSync('git', ['add', '-f', '--', ...paths]);
const allWhitespace = spawnSync('git', ['diff', '--cached', '--check', '--', ...paths], {encoding: 'utf8'});
const preservedPatch = `${scope}/historical/v1-binding-delta.patch-data`;
const originalPatch = 'tests/shell-stress/first-read-contract-review/owned-output-prototype-review/execution-r1/binding-r0-to-r1.patch-data';
assert.equal(sha(readFileSync(preservedPatch)), sha(readFileSync(originalPatch)));
const canonicalPaths = paths.filter(path => path !== preservedPatch);
const whitespace = spawnSync('git', ['diff', '--cached', '--check', '--', ...canonicalPaths], {encoding: 'utf8'});
assert.equal(whitespace.status, 0, whitespace.stdout + whitespace.stderr);
put(`${scope}/whitespace-preserved-data.json`, JSON.stringify({allPathsStatus: allWhitespace.status, stdout: allWhitespace.stdout, stderr: allWhitespace.stderr, exactDataClassification: {path: preservedPatch, original: originalPatch, sha256: sha(readFileSync(preservedPatch)), reason: 'Immutable historical diff line13 is a context prefix followed by an empty line. Preserve exact patch bytes; this is inert captured data, not canonical source or a blanket test exclusion.'}, canonicalPathsStatus: whitespace.status, canonicalCoverage: 'Every owned path except that single authenticated historical patch; no source/test/helper exclusions.'}, null, 2) + '\n');
const validation = {validatedAt: new Date().toISOString(), scope, jsonFilesParsed: jsonFiles, allRepositoryExecutablePayloadsInert: true, exactRawStreamsVerified: true, boundExecutableHashesVerified: true, resultsAndDenominatorsVerified: true, whitespaceStatus: whitespace.status, whitespaceOutput: whitespace.stdout + whitespace.stderr, restorationDeltaSha256: sha(restorationDiff.stdout), initialForeignIndex: beforeIndex.filter(path => !path.startsWith(scope + '/')), stagePolicy: 'git add with individual explicit owned file paths only; no foreign paths', commitPolicy: 'git commit --only with these explicit owned file paths', closure: json(`${scope}/closure.json`), note: 'Precommit validation; final owned clean status and commit identity are recorded in the final temp result handoff.'};
put(`${scope}/validation.json`, JSON.stringify(validation, null, 2) + '\n');
const artifacts = {sealedAt: new Date().toISOString(), classification: 'final-independent-execution-fail-partial-not-production', selfExcluded: 'artifacts.json', files: walk(scope).filter(path => !path.endsWith('/artifacts.json')).map(path => ({path: path.slice(scope.length + 1), bytes: readFileSync(path).length, sha256: sha(readFileSync(path))}))};
put(`${scope}/artifacts.json`, JSON.stringify(artifacts, null, 2) + '\n');
paths = walk(scope); execFileSync('git', ['add', '-f', '--', ...paths]);
assert.equal(spawnSync('git', ['diff', '--cached', '--check', '--', ...paths.filter(path => path !== preservedPatch)], {encoding: 'utf8'}).status, 0);
console.log(JSON.stringify({files: paths.length, artifactManifestSha256: sha(readFileSync(`${scope}/artifacts.json`)), validation: 'PASS', readyForExplicitOnlyCommit: true}));
