import assert from 'node:assert/strict';
import {readFileSync, readdirSync} from 'node:fs';
import {execFileSync, spawnSync} from 'node:child_process';
import {createHash} from 'node:crypto';
import {resolve, relative} from 'node:path';
const root = process.cwd();
const temp = process.argv[2]; assert.ok(temp?.startsWith('/tmp/safe-bash-owned-output-prototype-review-execution-'));
const candidate = `${temp}/candidate`;
const parent = `${root}/tests/shell-stress/first-read-contract-review/owned-output-prototype-review`;
const author = `${root}/tests/shell-stress/first-read-contract-review/owned-output-prototype`;
const sha = value => createHash('sha256').update(value).digest('hex');
const add = (path, value) => execFileSync('apply_patch', [], {input: `*** Begin Patch\n*** Add File: ${path}\n${value.replace(/\n$/, '').split('\n').map(line => '+' + line).join('\n')}\n*** End Patch\n`, encoding: 'utf8'});
const handoff = JSON.parse(readFileSync(`${author}/handoff.json`));
for (const entry of handoff.originalInputsVerified) assert.equal(sha(readFileSync(`${candidate}/${entry.path}`)), entry.sha256, entry.path);
for (const name of ['support.mjs', 'binding.mjs']) add(`${temp}/${name}`, readFileSync(`${parent}/${name}`, 'utf8'));
add(`${temp}/holdouts.mjs`, readFileSync(`${parent}/execution-r1/holdouts.mjs.data`, 'utf8'));
const helperOriginal = readFileSync(`${candidate}/tests/stress/remote-cancellation/helpers.ts`, 'utf8');
add(`${temp}/bound/tests/stress/remote-cancellation/helpers.ts`, helperOriginal.replaceAll('../../../src/', '../../../../candidate/dist/'));
const mockOriginal = readFileSync(`${candidate}/tests/fs/webdav/mock.ts`, 'utf8');
add(`${temp}/bound/tests/fs/webdav/mock.ts`, mockOriginal.replaceAll('../../../src/', '../../../../candidate/dist/'));
const adaptedOriginal = readFileSync(`${candidate}/tests/shell/adapted-first-read-probe.ts`, 'utf8');
const adapted = adaptedOriginal.replaceAll('../../src/', '../../../candidate/dist/');
add(`${temp}/bound/tests/shell/adapted-first-read-probe.ts`, adapted);
const original = readFileSync(`${candidate}/tests/shell/first-read-probe.ts`, 'utf8');
let diagnostic = original.replaceAll('../../src/', '../../../candidate/dist/');
diagnostic = diagnostic.replace('let url: string | undefined;', 'let ioSignal: AbortSignal | undefined;\nlet stageSignal: AbortSignal | undefined;\nlet firstWrites = 0;\nlet stageAbortedAtIoClose: boolean | undefined;\nlet callerAbortedAtIoClose: boolean | undefined;\nconst observeIo = (signal?: AbortSignal) => { ioSignal = signal; signal?.addEventListener("abort", () => { stageAbortedAtIoClose = stageSignal?.aborted; callerAbortedAtIoClose = trace.controller.signal.aborted; trace.event("diagnostic.io.abort"); }, { once: true }); };\nlet url: string | undefined;');
diagnostic = diagnostic.replace('  observed = signal;', '  observed = signal; observeIo(signal);');
diagnostic = diagnostic.replace('  const shell = new Shell({ fs });', '  if (fs.readStream) { const stream = fs.readStream.bind(fs); fs.readStream = (path, options) => { observeIo(options?.signal); return stream(path, options); }; }\n  const shell = new Shell({ fs });');
diagnostic = diagnostic.replace('authorize: request => request.url === url && request.method === "GET"', 'authorize: request => { observeIo(request.signal); return request.url === url && request.method === "GET"; }');
diagnostic = diagnostic.replace('  shell.use(async (context, next) => {', '  shell.use(async (context, next) => {\n    if (["pending-stream", "cat", "curl"].includes(context.command)) {\n      stageSignal = context.signal;\n      const plain = context.stdout.write.bind(context.stdout); context.stdout.write = async chunk => { firstWrites++; await plain(chunk); };\n      const owned = context.stdout.ownedOutput; if (owned) { const write = owned.write.bind(owned); owned.write = async chunk => { firstWrites++; await write(chunk); }; }\n    }');
const assertions = original.split('\n').filter(line => /^\s*assert\./.test(line));
for (const assertion of assertions) assert.ok(diagnostic.includes(assertion), `Original assertion preserved: ${assertion}`);
diagnostic = diagnostic.split('\n').flatMap((line, index) => /^\s*assert\./.test(line) ? [`    trace.event(${JSON.stringify(`assertion.before:${line.trim()}`)});`, line] : [line]).join('\n');
diagnostic = diagnostic.replace('  console.log(JSON.stringify({ scenario, active, reads, returned, abortedBeforeTeardown:', '  console.log(JSON.stringify({ diagnostic: true, originalObservedAborted: observed?.aborted, ioAborted: ioSignal?.aborted, ioReasonCode: (ioSignal?.reason as {code?: string} | undefined)?.code, stageAborted: stageSignal?.aborted, stageAbortedAtIoClose, callerAbortedAtIoClose, firstWrites, scenario, active, reads, returned, abortedBeforeTeardown:');
diagnostic = diagnostic.replace('  process.removeListener("unhandledRejection", onUnhandled);', '  console.log(JSON.stringify({ diagnosticAfterTeardown: true, scenario, reads, returned, active, unhandled: unhandled.length, callerAborted: trace.controller.signal.aborted }));\n  process.removeListener("unhandledRejection", onUnhandled);');
add(`${temp}/bound/tests/shell/diagnostic-first-read-probe.ts`, diagnostic);
add(`${temp}/bound/package.json`, '{"type":"module"}\n');
add(`${temp}/bound/tsconfig.json`, JSON.stringify({compilerOptions: {target: 'ES2023', module: 'NodeNext', moduleResolution: 'NodeNext', strict: true, noUncheckedIndexedAccess: true, exactOptionalPropertyTypes: true, skipLibCheck: true, types: ['node'], typeRoots: [`${root}/node_modules/@types`]}, include: ['tests/**/*.ts']}, null, 2));
const delta = spawnSync('git', ['diff', '--no-index', '--', `${candidate}/tests/shell/first-read-probe.ts`, `${temp}/bound/tests/shell/adapted-first-read-probe.ts`], {encoding: 'utf8'});
assert.equal(delta.status, 1); add(`${temp}/old-to-bound-adapted.patch-data`, delta.stdout);
const instrumentation = spawnSync('git', ['diff', '--no-index', '--', `${candidate}/tests/shell/first-read-probe.ts`, `${temp}/bound/tests/shell/diagnostic-first-read-probe.ts`], {encoding: 'utf8'});
assert.equal(instrumentation.status, 1); add(`${temp}/old-to-diagnostic.patch-data`, instrumentation.stdout);
const files = ['holdouts.mjs', 'support.mjs', 'binding.mjs', 'old-to-bound-adapted.patch-data', 'old-to-diagnostic.patch-data', 'bound/package.json', 'bound/tsconfig.json', 'bound/tests/shell/adapted-first-read-probe.ts', 'bound/tests/shell/diagnostic-first-read-probe.ts', 'bound/tests/stress/remote-cancellation/helpers.ts', 'bound/tests/fs/webdav/mock.ts', 'supervisor.mjs', 'run-existing.mjs', 'run-controls.mjs', 'controls.mjs', 'native.mjs'];
const manifest = files.map(path => ({path, bytes: readFileSync(`${temp}/${path}`).length, sha256: sha(readFileSync(`${temp}/${path}`))}));
add(`${temp}/binding-seal.json`, JSON.stringify({sealedAt: new Date().toISOString(), productExecuted: false, intentionsUnchanged: true, sourceManifestSha256: handoff.sourceManifestSha256, compiledManifestSha256: handoff.compiledManifestSha256, bindingDelta: 'Import actual compiled v1, use independently reviewed exact author adaptation for original-five plus frozen separate H01 effect probe. Helpers/MockDav import compiled v1. Diagnostic copy retains every original assertion and adds passive observations. H06-H16 executable realization in holdouts.mjs; no new v2 cases.', mixedPolicyBeforeExecution: 'Authenticated v1 API says EPIPE maps to 141; preserved frozen admissible set {0,141}, compare default and pipefail after required files complete; no suppression of unexpected stderr.', originalAssertions: assertions, originalInputsVerified: handoff.originalInputsVerified, executableInputManifestSha256: sha(JSON.stringify(manifest)), files: manifest}, null, 2));
console.log(JSON.stringify({temp, boundInputs: manifest.length, executableInputManifestSha256: sha(JSON.stringify(manifest)), sealSha256: sha(readFileSync(`${temp}/binding-seal.json`))}));
