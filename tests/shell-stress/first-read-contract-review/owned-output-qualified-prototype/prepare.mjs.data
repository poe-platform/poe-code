import assert from 'node:assert/strict';
import { readFileSync, readdirSync, mkdirSync, copyFileSync, cpSync, statSync, realpathSync, symlinkSync, writeFileSync } from 'node:fs';
import { createHash } from 'node:crypto';
import { resolve, relative } from 'node:path';
import { spawnSync } from 'node:child_process';
const root = '/Users/kjopek/Workspace/safe-bash';
const task = '/tmp/safe-bash-owned-output-qualified-prototype-C5XVrA';
const old = resolve(root, 'tests/shell-stress/first-read-contract-review/owned-output-streaming-prototype');
const original = resolve(root, 'tests/shell-stress/first-read-contract-review/owned-output-prototype');
const restored = '/tmp/safe-bash-owned-output-streaming-execution-restore-J93UJO/candidate';
const hash = bytes => createHash('sha256').update(bytes).digest('hex');
const walk = directory => readdirSync(directory, { withFileTypes: true }).flatMap(entry => entry.isDirectory() ? walk(resolve(directory, entry.name)) : entry.isFile() ? [resolve(directory, entry.name)] : []).sort();
const inventory = (base, dir) => walk(resolve(base, dir)).map(path => ({ path: relative(base, path), bytes: readFileSync(path).length, sha256: hash(readFileSync(path)) }));
const manifest = JSON.parse(readFileSync(resolve(old, 'tested-manifest.json')));
const children = [];
const run = (command, args, cwd = task) => {
  const result = spawnSync(command, args, { cwd, encoding: 'utf8', timeout: 45000, maxBuffer: 16 * 1024 * 1024 });
  children.push({ command, args, pid: result.pid, status: result.status, signal: result.signal, stdout: result.stdout, stderr: result.stderr });
  assert.equal(result.error, undefined); assert.equal(result.status, 0, result.stdout + result.stderr);
  assert.throws(() => process.kill(result.pid, 0), { code: 'ESRCH' });
  return result.stdout;
};
const startedAt = new Date().toISOString();
const source = inventory(restored, 'src');
const tests = inventory(restored, 'tests');
const compiled = inventory(restored, 'dist');
assert.equal(hash(JSON.stringify(source)), manifest.sourceManifestSha256);
assert.equal(hash(JSON.stringify(tests)), manifest.testManifestSha256);
assert.equal(hash(JSON.stringify(compiled)), manifest.compiledManifestSha256);
for (const entry of [...manifest.config, ...manifest.restoreInputs, ...manifest.tooling]) {
  const base = manifest.config.includes(entry) ? restored : root;
  assert.equal(hash(readFileSync(resolve(base, entry.path))), entry.sha256, entry.path);
}
assert.equal(hash(readFileSync(process.execPath)), manifest.tools.node.sha256);
for (const entry of manifest.tools.compiler) assert.equal(hash(readFileSync(entry.path)), entry.sha256);
for (const entry of manifest.compilerInputs) {
  const path = entry.normalizedPath.startsWith('CANDIDATE/') ? resolve(restored, entry.normalizedPath.slice(10)) : entry.path;
  assert.equal(hash(readFileSync(path)), entry.sha256, path);
}
assert.ok([...walk(resolve(restored, 'src')), ...walk(resolve(restored, 'tests')), ...walk(resolve(restored, 'dist'))].every(path => (statSync(path).mode & 0o222) === 0));
const configs = ['package.json', 'package-lock.json', 'tsconfig.json', 'tsconfig.build.json'];
const currentInventory = () => [...inventory(root, 'src'), ...configs.map(path => ({ path, bytes: readFileSync(resolve(root, path)).length, sha256: hash(readFileSync(resolve(root, path))) }))];
const beforeHead = run('/usr/bin/git', ['rev-parse', 'HEAD'], root).trim();
const beforeStatus = run('/usr/bin/git', ['status', '--porcelain=v1'], root);
const before = currentInventory();
const current = resolve(task, 'current-capture'); mkdirSync(current);
cpSync(resolve(root, 'src'), resolve(current, 'src'), { recursive: true });
for (const path of configs) copyFileSync(resolve(root, path), resolve(current, path));
const after = currentInventory();
assert.deepEqual(after, before, 'Current source/config changed during capture; fail rather than silently rebase');
for (const entry of before) assert.equal(hash(readFileSync(resolve(current, entry.path))), entry.sha256);
const afterHead = run('/usr/bin/git', ['rev-parse', 'HEAD'], root).trim();
const afterStatus = run('/usr/bin/git', ['status', '--porcelain=v1'], root);
const candidate = resolve(task, 'candidate'); mkdirSync(candidate);
for (const dir of ['src', 'tests']) cpSync(resolve(restored, dir), resolve(candidate, dir), { recursive: true });
for (const path of configs) copyFileSync(resolve(restored, path), resolve(candidate, path));
const preoperation = resolve(task, 'original-preoperation'); mkdirSync(preoperation);
const archive = resolve(original, 'baseline.tar.gz.data');
const archiveNames = run('/usr/bin/tar', ['-tzf', archive]).trim().split('\n');
assert.ok(archiveNames.every(name => !name.startsWith('/') && !name.split('/').includes('..')));
run('/usr/bin/tar', ['-xzf', archive, '-C', preoperation]);
const originalManifest = JSON.parse(readFileSync(resolve(original, 'reconstruction.json')));
for (const entry of originalManifest.files) assert.equal(hash(readFileSync(resolve(preoperation, entry.path))), entry.sha256, entry.path);
const relevant = ['src/contracts/command.ts', 'src/contracts/command.md', 'src/contracts/io.ts', 'src/shell/cleanup.ts', 'src/shell/runtime.ts', 'src/shell/input.ts', 'src/shell/shell.ts', 'src/commands/network/curl.ts', 'src/commands/network/transport.ts'];
const drift = relevant.map(path => ({ path, original: hash(readFileSync(resolve(preoperation, path))), s1: hash(readFileSync(resolve(candidate, path))), current: hash(readFileSync(resolve(current, path))) }));
for (const base of [candidate, current, preoperation]) symlinkSync(resolve(root, 'node_modules'), resolve(base, 'node_modules'), 'dir');
const snapshot = { startedAt, completedAt: new Date().toISOString(), beforeHead, afterHead, beforeStatus, afterStatus, authenticatedS1: { source: manifest.sourceManifestSha256, tests: manifest.testManifestSha256, compiled: manifest.compiledManifestSha256, compilerInputs: manifest.compilerInputs.length }, originalPreoperation: { baselineHead: originalManifest.baselineHead, archiveSha256: hash(readFileSync(archive)), source: inventory(preoperation, 'src') }, current: { qualification: 'Time-qualified captured bytes only; dirty checkout, no current release freeze', before, after, id: hash(JSON.stringify(before)) }, drift, tooling: manifest.tools, compilerInputs: manifest.compilerInputs, children };
writeFileSync(resolve(task, 'baseline-snapshot.json'), JSON.stringify(snapshot, null, 2) + '\n');
console.log(JSON.stringify({ startedAt, completedAt: snapshot.completedAt, s1: snapshot.authenticatedS1, currentId: snapshot.current.id, beforeHead, afterHead, drift }, null, 2));
