writeFileSync(resolve(task,'expected-profiles.json'),JSON.stringify({frozenBeforeExecution:true,authority:'User decisions; exact original/current curl source and unchanged public command cleanup contract; original frozen scripts. Candidate control flow inspected for binding only, not empirical expected-value discovery.',profiles,comparison:{publicPipeStatus:[0,141],genuineWriteoutStatus:23,nativeDifference:'Native writeout-only error status0/bodypipe23 in author profiles, independently replayed, not product policy',missing:'Product PIPESTATUS unavailable; four original/current nested returns can be absent. Compare only Shell result plus exact stdout/stderr/effects; NEVER manufacture nested equality.',requiredEffects:'Candidate required body/header and independent file/stderr finish; intentionally not byteidentical old canceled-stage effects.'}},null,2)+'\n');
const auth=JSON.parse(readFileSync(resolve(task,'authentication-before.json')));
const walk=base=>readdirSync(base,{withFileTypes:true}).flatMap(entry=>entry.isDirectory()?walk(resolve(base,entry.name)):entry.isFile()?[resolve(base,entry.name)]:[]);
const executionPaths=[...auth.selectedCompiledClosure,...walk(resolve(task,'historical')),...['driver.mjs','qualified-criteria.mjs','lifetime.mjs','controls.mjs','native-helper.mjs','binding-map.json','expected-profiles.json','tsconfig.json'].map(path=>resolve(task,path)),...auth.files.filter(entry=>entry.path.includes('/node_modules/tsx/')||entry.path.includes('/node_modules/esbuild/')||entry.path.includes('/node_modules/@esbuild/')).map(entry=>entry.path)];
const config={bindingVersion:'Q1-independent-pre-run',sourceIdentity:auth.sourceId,writeoutTripletBound:true,ready:file('/tmp/safe-bash-owned-output-qualified-prototype.ready'),authentication:file(resolve(task,'authentication-before.json')),executionFiles:[...new Set(executionPaths)].map(file),candidateEntry:file(resolve(task,'candidate/dist/index.js')),historicalHelper:file(resolve(task,'historical/tests/stress/remote-cancellation/helpers.ts')),historicalProbe:file(resolve(task,'historical/tests/shell/first-read-probe.ts')),historicalFacade:file(resolve(task,'historical/src/index.ts')),tsxImport:file(resolve(root,'node_modules/tsx/dist/loader.mjs')),publicProfiles:file(resolve(task,'expected-profiles.json'))};
writeFileSync(resolve(task,'config.json'),JSON.stringify(config,null,2)+'\n');
for(const name of ['driver.mjs','qualified-criteria.mjs','lifetime.mjs','controls.mjs','native-helper.mjs','authenticate.mjs','prepare.mjs'])copy(resolve(task,name),resolve(owned,name+'.data'));
for(const name of ['config.json','authentication-before.json','binding-map.json','expected-profiles.json'])copy(resolve(task,name),resolve(owned,name));
for(const path of walk(resolve(task,'historical')))copy(path,resolve(owned,'historical',path.slice(resolve(task,'historical').length+1)+'.data'));
const files=walk(owned).filter(path=>!path.endsWith('pre-run-seal.json')).map(file);
writeFileSync(resolve(owned,'pre-run-seal.json'),JSON.stringify({at:new Date().toISOString(),productImports:0,productExecutions:0,driverSha256:file(resolve(task,'driver.mjs')).sha256,logical:12,parameters:32,files},null,2)+'\n');
