const hash=bytes=>createHash('sha256').update(bytes).digest('hex');
const file=path=>({path,sha256:hash(readFileSync(path))});
const copy=(from,to)=>{mkdirSync(dirname(to),{recursive:true});if(existsSync(to)&&hash(readFileSync(from))===hash(readFileSync(to)))return;if(existsSync(to))chmodSync(to,0o644);copyFileSync(from,to);assert.equal(hash(readFileSync(from)),hash(readFileSync(to)));};
