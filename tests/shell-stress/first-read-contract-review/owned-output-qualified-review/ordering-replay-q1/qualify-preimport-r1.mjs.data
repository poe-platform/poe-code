import assert from 'node:assert/strict';
import { readFileSync, writeFileSync, copyFileSync } from 'node:fs';
import { createHash } from 'node:crypto';
import { spawnSync } from 'node:child_process';
import { resolve } from 'node:path';
const root='/Users/kjopek/Workspace/safe-bash';
const task='/tmp/safe-bash-owned-output-qualified-ordering-GTuQbL';
const owned=resolve(root,'tests/shell-stress/first-read-contract-review/owned-output-qualified-review/ordering-replay-q1');
const hash=bytes=>createHash('sha256').update(bytes).digest('hex');
writeFileSync(resolve(task,'package.json'),'{"type":"module"}\n');
copyFileSync(resolve(owned,'typed-signal.ts.data'),resolve(task,'typed-signal.ts'));
copyFileSync(resolve(owned,'owned-typed-tsconfig.json.data'),resolve(task,'typed-tsconfig.json'));
const env={...process.env,TSX_DISABLE_CACHE:'1',TMPDIR:resolve(task,'tmp'),TMP:resolve(task,'tmp'),TEMP:resolve(task,'tmp'),TSX_CACHE_DIR:resolve(task,'tmp/tsx')};
const args=[resolve(root,'node_modules/typescript/bin/tsc'),'-p',resolve(task,'typed-tsconfig.json'),'--listFiles'];
const child=spawnSync(process.execPath,args,{cwd:task,env,encoding:'utf8',timeout:30000,maxBuffer:2*1024*1024});
writeFileSync(resolve(owned,'typed-check.stdout.data'),child.stdout);
writeFileSync(resolve(owned,'typed-check.stderr.data'),child.stderr);
const inputs=child.stdout.trim().split('\n').filter(path=>path.startsWith('/')).map(path=>({path,sha256:hash(readFileSync(path))}));
const result={at:new Date().toISOString(),command:[process.execPath,...args],pid:child.pid,status:child.status,error:child.error??null,inputs,productImports:0,productExecutions:0};
writeFileSync(resolve(owned,'typed-check.json'),JSON.stringify(result,null,2)+'\n');
assert.equal(child.status,0,child.stdout+child.stderr);assert.throws(()=>process.kill(child.pid,0),{code:'ESRCH'});
const {createOwnedUndefinedController}=await import(resolve(task,'typed-dist/typed-signal.js'));
const caller=createOwnedUndefinedController();
assert.equal(caller.signal.aborted,false);assert.equal(caller.signal.reason,undefined);caller.signal.throwIfAborted();
const combined=AbortSignal.any([caller.signal,new AbortController().signal]);
const events=[];let onabort=0;
caller.signal.onabort=()=>{onabort++;};
caller.signal.addEventListener('abort',event=>events.push({targetSame:event.target===caller.signal,currentTargetSame:event.currentTarget===caller.signal,aborted:caller.signal.aborted,reasonUndefined:caller.signal.reason===undefined}),{once:true});
caller.abort();caller.abort();
let rejected=false,reason;
try{caller.signal.throwIfAborted();}catch(error){rejected=true;reason=error;}
assert.equal(events.length,1);assert.equal(onabort,1);assert.equal(combined.aborted,true);assert.equal(rejected,true);assert.equal(reason,undefined);
const native=new AbortController();let nativeCurrentTargetSame,nativeEvents=0;
native.signal.addEventListener('abort',event=>{nativeEvents++;nativeCurrentTargetSame=event.currentTarget===native.signal;});
native.abort(undefined);assert.notEqual(native.signal.reason,undefined);assert.equal(nativeEvents,1);
assert.deepEqual(events,[{targetSame:true,currentTargetSame:nativeCurrentTargetSame,aborted:true,reasonUndefined:true}]);
copyFileSync(resolve(task,'typed-dist/typed-signal.js'),resolve(owned,'typed-signal.js.data'));
writeFileSync(resolve(owned,'signal-host-qualification.json'),JSON.stringify({at:new Date().toISOString(),events,onabort,nativeEvents,nativeCurrentTargetSame,throwRejected:rejected,throwReason:{serializationTag:'undefined'},combinedAborted:combined.aborted,combinedReasonUndefined:combined.reason===undefined,combinedReasonName:combined.reason?.name,nativeDefaultReasonName:native.signal.reason.name,nativeDefaultIsNotUndefined:true,syntheticBinding:'Owned native-branded signal with per-instance public reason getter and throwIfAborted override; native events, not native literal-undefined abort support; no product/prototype/global mutation',productImports:0,productExecutions:0},null,2)+'\n');
console.log(JSON.stringify({typedStatus:child.status,inputs:inputs.length,hostLifecyclePassed:true,productExecutions:0}));
