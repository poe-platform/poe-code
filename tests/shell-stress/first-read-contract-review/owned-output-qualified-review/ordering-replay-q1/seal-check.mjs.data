import assert from 'node:assert/strict';
import { readFileSync,writeFileSync } from 'node:fs';
import { createHash } from 'node:crypto';
import { resolve } from 'node:path';
const owned='/Users/kjopek/Workspace/safe-bash/tests/shell-stress/first-read-contract-review/owned-output-qualified-review/ordering-replay-q1';
const task='/tmp/safe-bash-owned-output-qualified-ordering-GTuQbL';
const hash=bytes=>createHash('sha256').update(bytes).digest('hex');
const json=path=>JSON.parse(readFileSync(path));
const phase=process.argv[2];
assert.ok(['pre-execution','post-execution'].includes(phase));
const files=new Map();
const check=entry=>{assert.equal(hash(readFileSync(entry.path)),entry.sha256,entry.path);files.set(entry.path,entry);};
const seal=json(resolve(owned,'pre-run-seal.json'));
for(const entry of seal.files)check({...entry,path:resolve(owned,entry.path)});
for(const entry of json(resolve(owned,'authentication-before.json')).files)check(entry);
const config=json(resolve(owned,'config.json'));
for(const entry of config.executionFiles)check(entry);
check({path:resolve(task,'config.json'),sha256:seal.configSha256});
check({path:resolve(task,'driver.mjs'),sha256:seal.driverSha256});
check({path:resolve(task,'ordering-lifetime.mjs'),sha256:seal.orderingFixtureSha256});
writeFileSync(resolve(owned,`seal-check-${phase}.json`),JSON.stringify({at:new Date().toISOString(),phase,files:files.size,allUnchanged:true,sealSha256:hash(readFileSync(resolve(owned,'pre-run-seal.json'))),checkerSha256:hash(readFileSync(resolve(task,'seal-check.mjs')))},null,2)+'\n');
console.log(JSON.stringify({phase,files:files.size,allUnchanged:true}));
