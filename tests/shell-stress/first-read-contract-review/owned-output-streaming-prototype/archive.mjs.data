const inventory = directory => walk(resolve(candidate,directory)).map(path=>({path:relative(candidate,path),bytes:readFileSync(path).length,sha256:hash(readFileSync(path))}));
const frozen = JSON.parse(readFileSync(resolve(owned,'freeze-r1.json')));
