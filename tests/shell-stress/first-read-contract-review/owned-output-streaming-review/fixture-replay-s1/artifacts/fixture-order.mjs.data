import assert from 'node:assert/strict';
import { readFileSync, writeFileSync } from 'node:fs';
import { dirname } from 'node:path';
import { fileURLToPath, pathToFileURL } from 'node:url';
import { request as makeRequest } from 'node:http';
import { execFileSync } from 'node:child_process';
const temp = dirname(fileURLToPath(import.meta.url));
const put = (path, content) => execFileSync('apply_patch', [], { input: `*** Begin Patch\n*** Add File: ${path}\n${content.replace(/\n$/, '').split('\n').map(line => '+' + line).join('\n')}\n*** End Patch\n` });
const records = [];
for (const version of ['original', 'r1']) {
  const input = readFileSync(temp + (version === 'original' ? '/driver-original.mjs.data' : '/driver-r1.mjs'), 'utf8');
  let prefix = input.slice(0, input.indexOf('function makeShell('));
  if (version === 'original') {
    prefix = prefix.replace('      received += chunk.length;', "      received += chunk.length;\n      scope.event('witness.original.guard.data', { bytes: chunk.length, dataListeners: request.listenerCount('data') });");
  }
  prefix += '\nexport { Scope, loopback };\n';
  const modulePath = temp + '/fixture-' + version + '.mjs';
  put(modulePath, prefix);
  const { Scope, loopback } = await import(pathToFileURL(modulePath).href);
  const scope = new Scope();
  const captured = [];
  let receivedResponse;
  try {
    const fixture = await loopback(scope, async (request, response, body) => {
      scope.event('witness.handler.enter', { dataListeners: request.listenerCount('data') });
      if (version === 'original') {
        for await (const chunk of request) {
          scope.event('witness.late.collector.data', { bytes: chunk.length });
          captured.push(Buffer.from(chunk));
        }
      } else captured.push(...await body.complete.promise);
      response.end('witness-complete');
    });
    receivedResponse = await scope.bound(new Promise((resolveResponse, rejectResponse) => {
      const outgoing = makeRequest(fixture.url, { method: 'PUT' }, incoming => {
        const response = [];
        incoming.on('data', chunk => response.push(Buffer.from(chunk)));
        incoming.once('end', () => resolveResponse(Buffer.concat(response).toString()));
        incoming.once('error', rejectResponse);
      });
      outgoing.once('error', rejectResponse);
      outgoing.end('first-request-bytes');
    }), 'fixture-only event-order witness');
  } finally {
    records.push({ version, sent: 'first-request-bytes', captured: Buffer.concat(captured).toString(), receivedResponse, events: scope.events, teardown: await scope.teardown() });
  }
}
writeFileSync(temp + '/fixture-order-proof.json', JSON.stringify({ classification: 'fixture-only event instrumentation, not acceptance corpus or product execution', records }, null, 2) + '\n');
const old = records[0];
assert.ok(old.events.findIndex(event => event.name === 'witness.original.guard.data') < old.events.findIndex(event => event.name === 'witness.handler.enter'));
assert.equal(old.captured, '');
assert.equal(records[1].captured, records[1].sent);
for (const record of records) assert.deepEqual(record.teardown.failures, []);
console.log(JSON.stringify({ oldGuardConsumedBeforeLateHandler: true, originalCaptured: old.captured, correctedCaptured: records[1].captured, noProductImported: true, fixturesReaped: 2 }));
