import fs from 'node:fs';
import path from 'node:path';
import os from 'node:os';
import { spawn, execFileSync } from 'node:child_process';

const root = '/tmp/safe-bash-search-sidecar-review-tnXxyl';
const qualification = JSON.parse(fs.readFileSync(path.join(root, 'qualification.json')));
const evidence = '/Users/kjopek/Workspace/safe-bash/tests/shell-stress/first-read-contract-review/search-sidecar-review';
const label = process.argv[2];
if (!['original-safety', 'ownership-diagnostic'].includes(label)) throw new Error('Unknown bounded run');
const args = label === 'original-safety' ? qualification.commands.safety.slice(1) : ['--import', 'tsx', 'ownership-diagnostic.ts'];
const env = { ...process.env, ...qualification.env };
delete env.NODE_OPTIONS;
delete env.NODE_TEST_CONTEXT;
const started = performance.now();
const before = { at: new Date().toISOString(), loadavg: os.loadavg(), cpuCount: os.cpus().length, availableParallelism: os.availableParallelism() };
const ps = () => execFileSync('/bin/ps', ['-axo', 'pid=,ppid=,pgid=,stat=,%cpu=,time=,comm='], { encoding: 'utf8' });
const processBefore = ps();
const child = spawn('/usr/bin/time', ['-l', process.execPath, ...args], { cwd: qualification.source, env, detached: true, stdio: ['ignore', 'pipe', 'pipe'] });
const chunks = { stdout: [], stderr: [] };
let byteCount = 0;
const signals = [];
let timedOut = false;
const kill = reason => { signals.push({ reason, at: new Date().toISOString(), group: child.pid }); try { process.kill(-child.pid, 'SIGKILL'); } catch (error) { if (error.code !== 'ESRCH') throw error; } };
for (const name of ['stdout', 'stderr']) child[name].on('data', bytes => { chunks[name].push(Buffer.from(bytes)); byteCount += bytes.length; if (byteCount > 2 * 1024 * 1024) kill('output bound'); });
const timer = setTimeout(() => { timedOut = true; kill('20-second outer process guard, not fixture timeout change'); }, 20000);
const result = await new Promise((resolve, reject) => { child.on('error', reject); child.on('close', (status, signal) => resolve({ status, signal })); });
clearTimeout(timer);
const processAfter = ps();
const members = processAfter.split('\n').filter(line => line.trim().split(/\s+/)[2] === String(child.pid));
if (members.length) kill('remaining owned process-group members after leader close');
await new Promise(resolve => setTimeout(resolve, 100));
const processFinal = ps();
const survivors = processFinal.split('\n').filter(line => line.trim().split(/\s+/)[2] === String(child.pid));
const record = { label, candidate: qualification.candidate, executable: '/usr/bin/time', args: ['-l', process.execPath, ...args], cwd: qualification.source, env: qualification.env, pid: child.pid, ...result, closed: true, timedOut, elapsedMs: performance.now() - started, outputBytes: byteCount, before, after: { at: new Date().toISOString(), loadavg: os.loadavg() }, signals, membersAfterClose: members, survivors, concurrency: 'one sidecar test process at a time; original nested safety suite unchanged; external cohost work not controlled; process snapshots use executable names only' };
fs.mkdirSync(path.join(evidence, 'runs'), { recursive: true });
for (const name of ['stdout', 'stderr']) fs.writeFileSync(path.join(evidence, 'runs', `${label}.${name}.log.data`), Buffer.concat(chunks[name]));
for (const [name, value] of Object.entries({ before: processBefore, after: processAfter, final: processFinal })) fs.writeFileSync(path.join(evidence, 'runs', `${label}.process-${name}.data`), value);
fs.writeFileSync(path.join(evidence, 'runs', `${label}.json`), JSON.stringify(record, null, 2) + '\n');
console.log(JSON.stringify(record, null, 2));
console.log(Buffer.concat(chunks.stdout).toString().slice(-1400));
console.log(Buffer.concat(chunks.stderr).toString().slice(-1400));
if (survivors.length) process.exitCode = 2;
