148:export class BindingWatch {
149:  #closed = false;
150:  readonly generation: number;
151:  readonly version: number;
152:  readonly typedVersion: number;
153:
154:  constructor(readonly store: BindingStore, readonly name: string, readonly watch: Watch, readonly admission: Admission) {
155:    this.generation = watch.generation;
