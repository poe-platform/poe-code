+await check('public:ordinary-handler-throw-result-and-cleanup-identities', async () => {
+  const variants = [];
+  for (const errors of [0, 1, 2]) {
+    const instance = shell();
+    const primary = new Error('selected execution failure');
+    const failures = [new Error('secondary cleanup failure'), new Error('other secondary cleanup failure')];
+    const gate = deferred();
+    const started = deferred();
+    let cleanups = 0;
+    let stdout = '';
+    let stderr = '';
+    instance.register({ name: 'owned', execute(context) {
+      if (errors) context.registerCleanup(async () => { cleanups++; started.release(); await gate.promise; throw failures[0]; });
+      if (errors === 2) context.registerCleanup(() => { cleanups++; throw failures[1]; });
+      throw primary;
+    } });
+    const running = track(instance.exec('owned', errors ? {
+      stdout: { write(chunk) { stdout += new TextDecoder().decode(chunk); } },
+      stderr: { write(chunk) { stderr += new TextDecoder().decode(chunk); } },
+    } : {}));
+    if (errors) {
+      await within(started.promise);
+      await stillPending(running);
+      gate.release();
+    }
+    const result = await within(running);
+    assert.equal(result.resolved, errors === 0);
+    if (errors === 0) {
+      assert.equal(result.value.exitCode, 1);
+      assert.equal(result.value.stdout, '');
