{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test:unit": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "tests/**", "*.test.ts", "package.json", "tsconfig.json", "bunfig.toml"]
    },
    "lint": {
      "outputs": []
    },
    "lint:types": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "generate:docs": {
      "outputs": ["docs/**"]
    }
  }
}
