        "!src/commands/xan/design-evidence/**",
        "!src/commands/xan/design-evidence/migrated-source-docs/DESIGN.md",
        "!src/commands/xan/design-evidence/migrated-source-docs/README.md"
      ],
      "outputs": [],
      "cache": false
