{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "package.json",
    "tsconfig.json",
    "tsconfig.build.json",
    "packages/*/package.json",
    "packages/*/tsconfig.json"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "//#test:unit": {
      "inputs": [
        "src/**",
        "tests/**",
        "packages/**/*.test.ts",
        "package.json",
        "tsconfig.json",
        "vitest.config.ts"
      ]
    },
    "lint": {
      "outputs": []
    },
    "lint:types": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "generate:docs": {
      "outputs": ["docs/**"]
    }
  }
}
